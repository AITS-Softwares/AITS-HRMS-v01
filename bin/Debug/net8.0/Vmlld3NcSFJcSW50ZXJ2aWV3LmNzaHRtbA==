@model List<Erp_Aits.Models.Interview>
@{
    ViewBag.Title = "Interview";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Interview</h4>
    <a href="@Url.Action("CreateInterview", "HR")" class="btn btn-dark btn-sm">+ Add Interview</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="id" class="form-control form-control-sm" placeholder="ID" value="@ViewBag.IdFilter" />
    </div>
    <div class="col-auto">
        <input type="text" name="interviewRound" class="form-control form-control-sm" placeholder="Interview Round" value="@ViewBag.RoundFilter" />
    </div>
    <div class="col-auto">
        <input type="text" name="jobApplicant" class="form-control form-control-sm" placeholder="Job Applicant" value="@ViewBag.ApplicantFilter" />
    </div>
    <div class="col-auto">
        <input type="text" name="designation" class="form-control form-control-sm" placeholder="Designation" value="@ViewBag.DesignationFilter" />
    </div>
    <div class="col-auto">
        <select name="status" class="form-select form-select-sm">
            <option value="">Status</option>
            <option value="Pending" selected="@(ViewBag.StatusFilter == "Pending")">Pending</option>
            <option value="Under Review" selected="@(ViewBag.StatusFilter == "Under Review")">Under Review</option>
            <option value="Cleared" selected="@(ViewBag.StatusFilter == "Cleared")">Cleared</option>
            <option value="Rejected" selected="@(ViewBag.StatusFilter == "Rejected")">Rejected</option>
        </select>
    </div>
    <div class="col-auto">
        <input type="date" name="scheduledOn" class="form-control form-control-sm" value="@(ViewBag.ScheduledOnFilter as DateTime?)?.ToString(" yyyy-MM-dd")" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>Interview Round</th>
            <th>Job Applicant</th>
            <th>Status</th>
            <th>Scheduled On</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var iv in Model)
        {
            <tr style="cursor:pointer" onclick="window.location='@Url.Action("InterviewDetails", "HR", new { id = iv.Id })'">
                <td>@iv.Id</td>
                <td>@iv.InterviewRound</td>
                <td>@iv.JobApplicant</td>
                <td>@iv.Status</td>
                <td>@iv.ScheduledOn.ToString("dd-MM-yyyy")</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted text-center py-5">No interviews found with matching filters.</p>
}
