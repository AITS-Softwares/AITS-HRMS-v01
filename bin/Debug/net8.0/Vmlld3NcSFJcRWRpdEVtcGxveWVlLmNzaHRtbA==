@model Erp_Aits.Models.Employee

@{
    ViewBag.Title = "Edit Employee";
}

@* <form asp-action="EditEmployee" asp-controller="HR" method="post"> *@
<form asp-action="EditEmployee" asp-controller="HR" method="post" id="employeeEditForm" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="EmployeeCode" />
    <input type="hidden" asp-for="ErpNextId" />
    <input type="hidden" asp-for="FullName" />

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Edit Employee</h4>
        <button type="submit" class="btn btn-dark btn-sm px-4">Save</button>
    </div>

    @if (TempData["ErpNextError"] != null)
    {
        <div class="alert alert-warning">@TempData["ErpNextError"]</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <partial name="_EmployeeFormFields" model="Model" />
</form>


<script>
    document.getElementById("employeeEditForm")?.addEventListener("submit", function () {
        document.querySelectorAll(".tab-pane:not(.active) [required]").forEach(function (field) {
            field.removeAttribute("required");
        });
    });
</script>