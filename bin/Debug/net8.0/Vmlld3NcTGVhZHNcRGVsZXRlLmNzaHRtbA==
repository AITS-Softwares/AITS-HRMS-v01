@model Erp_Aits.Models.Lead
@{
    ViewData["Title"] = "Delete Lead";
    ViewData["Module"] = "CRM";
    ViewData["Icon"] = "trash";
}

<div class="content-card">
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-triangle"></i>
        <strong>Warning!</strong> Are you sure you want to delete this lead? This action cannot be undone.
    </div>

    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Full Name</dt>
                <dd class="col-sm-8">@Model.FullName</dd>

                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8">@Model.Email</dd>

                <dt class="col-sm-4">Mobile</dt>
                <dd class="col-sm-8">@Model.MobileNo</dd>

                <dt class="col-sm-4">Organization</dt>
                <dd class="col-sm-8">@Model.OrganizationName</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">@Model.Status</dd>
            </dl>
        </div>
    </div>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="form-actions">
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash"></i> Delete
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-times"></i> Cancel
            </a>
        </div>
    </form>
</div>