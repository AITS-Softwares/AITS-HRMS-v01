@model List<Erp_Aits.Models.VehicleLog>
@{
    ViewBag.Title = "Vehicle Log";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Vehicle Log</h4>
    <a href="/HR/CreateVehicleLog" class="btn btn-dark btn-sm">+ Add Vehicle Log</a>
</div>

<form method="get" action="/HR/VehicleLog" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="id" class="form-control form-control-sm" placeholder="ID" value="@ViewBag.IdFilter" />
    </div>
    <div class="col-auto">
        <input type="text" name="employee" class="form-control form-control-sm" placeholder="Employee" value="@ViewBag.EmployeeFilter" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
    </div>
</form>

@if (Model.Any())
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>License Plate</th>
                <th>Employee</th>
                <th>Odometer Date</th>
                <th>Current Odometer</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var v in Model)
            {
                <tr style="cursor:pointer" onclick="window.location='/HR/VehicleLogDetails/@v.Id'">
                    <td>@v.Id</td>
                    <td>@v.LicensePlate</td>
                    <td>@v.Employee</td>
                    <td>@(v.OdometerDate.HasValue? v.OdometerDate.Value.ToString("yyyy-MM-dd") : "")</td>
                    <td>@(v.CurrentOdometerValue.HasValue? v.CurrentOdometerValue.Value.ToString("0.00") : "")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted text-center py-5">No vehicle logs found.</p>
}
