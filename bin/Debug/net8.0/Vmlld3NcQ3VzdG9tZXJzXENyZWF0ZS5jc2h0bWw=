@model Erp_Aits.Models.Customer
@{
    ViewData["Title"] = "Create Customer";
    ViewData["Module"] = "CRM";
    ViewData["Icon"] = "user-plus";
}

<div class="content-card">
    <div class="card-header-custom">
        <h5>
            <i class="fas fa-user-plus text-primary"></i>
            Create New Customer
        </h5>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-secondary btn-sm">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle"></i>
                Please fix the following errors:
                <ul>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <div class="row">
            <div class="col-md-12 mb-3">
                <h6 class="border-bottom pb-2 text-primary"><i class="fas fa-info-circle"></i> Basic Information</h6>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="CustomerCode" class="form-label fw-semibold"></label>
                <input asp-for="CustomerCode" class="form-control" readonly />
                <small class="text-muted">Auto-generated</small>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="CustomerName" class="form-label fw-semibold"></label>
                <span class="text-danger">*</span>
                <input asp-for="CustomerName" class="form-control" />
                <span asp-validation-for="CustomerName" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="CustomerGroup" class="form-label fw-semibold"></label>
                <select asp-for="CustomerGroup" class="form-select">
                    <option value="">-- Select Group --</option>
                    <option value="Retail">Retail</option>
                    <option value="Wholesale">Wholesale</option>
                    <option value="Corporate">Corporate</option>
                    <option value="Government">Government</option>
                    <option value="Distributor">Distributor</option>
                    <option value="Dealer">Dealer</option>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="CustomerType" class="form-label fw-semibold"></label>
                <select asp-for="CustomerType" class="form-select">
                    <option value="">-- Select Type --</option>
                    <option value="Individual">Individual</option>
                    <option value="Company">Company</option>
                    <option value="Partnership">Partnership</option>
                    <option value="Trust">Trust</option>
                    <option value="Sole Proprietorship">Sole Proprietorship</option>
                    <option value="LLP">LLP</option>
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12 mb-3">
                <h6 class="border-bottom pb-2 text-success"><i class="fas fa-address-card"></i> Contact Information</h6>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="ContactPerson" class="form-label fw-semibold"></label>
                <span class="text-danger">*</span>
                <input asp-for="ContactPerson" class="form-control" />
                <span asp-validation-for="ContactPerson" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="MobileNumber" class="form-label fw-semibold"></label>
                <span class="text-danger">*</span>
                <input asp-for="MobileNumber" class="form-control" />
                <span asp-validation-for="MobileNumber" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="PrimaryEmail" class="form-label fw-semibold"></label>
                <input asp-for="PrimaryEmail" class="form-control" type="email" />
                <span asp-validation-for="PrimaryEmail" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="AdditionalEmail" class="form-label fw-semibold"></label>
                <input asp-for="AdditionalEmail" class="form-control" type="email" />
                <span asp-validation-for="AdditionalEmail" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Domain" class="form-label fw-semibold"></label>
                <input asp-for="Domain" class="form-control" placeholder="e.g. company.com" />
                <small class="text-muted">Website or domain name</small>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12 mb-3">
                <h6 class="border-bottom pb-2 text-warning"><i class="fas fa-building"></i> Organization Information</h6>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="OrganizationName" class="form-label fw-semibold"></label>
                <input asp-for="OrganizationName" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Address" class="form-label fw-semibold"></label>
                <input asp-for="Address" class="form-control" placeholder="Street address" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-3 mb-3">
                <label asp-for="City" class="form-label fw-semibold"></label>
                <input asp-for="City" class="form-control" />
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="State" class="form-label fw-semibold"></label>
                <input asp-for="State" class="form-control" />
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="Country" class="form-label fw-semibold"></label>
                <input asp-for="Country" class="form-control" />
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="PinCode" class="form-label fw-semibold"></label>
                <input asp-for="PinCode" class="form-control" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-12 mb-3">
                <h6 class="border-bottom pb-2 text-info"><i class="fas fa-tags"></i> Tax & Commission Information</h6>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="PanNumber" class="form-label fw-semibold"></label>
                <input asp-for="PanNumber" class="form-control" placeholder="e.g. ABCDE1234F" />
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="GstNumber" class="form-label fw-semibold"></label>
                <input asp-for="GstNumber" class="form-control" placeholder="e.g. 22ABCDE1234F1Z5" />
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="GstCategory" class="form-label fw-semibold"></label>
                <select asp-for="GstCategory" class="form-select">
                    <option value="">-- Select Category --</option>
                    <option value="Registered">Registered</option>
                    <option value="Composition">Composition</option>
                    <option value="Unregistered">Unregistered</option>
                    <option value="SEZ">SEZ</option>
                    <option value="Export">Export</option>
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="CommissionRate" class="form-label fw-semibold"></label>
                <input asp-for="CommissionRate" class="form-control" type="number" step="0.01" placeholder="0.00" />
                <span asp-validation-for="CommissionRate" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="AgentId" class="form-label fw-semibold"></label>
                <select asp-for="AgentId" class="form-select">
                    <option value="">-- Select Agent --</option>
                    @if (ViewBag.Users != null)
                    {
                        foreach (var user in ViewBag.Users)
                        {
                            <option value="@user.Id">@user.Name</option>
                        }
                    }
                </select>
            </div>
        </div>

        <input type="hidden" asp-for="LeadId" />

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Create Customer
            </button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

<style>
    .content-card {
        background: white;
        border-radius: 16px;
        padding: 24px;
        border: 1px solid #f0f2f5;
    }

    .card-header-custom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 16px;
        border-bottom: 2px solid #f4f6f9;
        flex-wrap: wrap;
        gap: 10px;
    }

        .card-header-custom h5 {
            margin: 0;
            font-weight: 600;
            color: #2c3e50;
            font-size: 18px;
        }

    .form-label {
        font-size: 14px;
        font-weight: 600;
        color: #1a1a2e;
    }

    .form-control, .form-select {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 14px;
        width: 100%;
    }

        .form-control:focus, .form-select:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 0.2rem rgba(79, 70, 229, 0.25);
        }

    h6 {
        font-weight: 600;
        margin-top: 10px;
    }

    .text-danger {
        color: #dc3545;
        font-size: 12px;
    }

    .text-muted {
        color: #6c757d;
        font-size: 12px;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}