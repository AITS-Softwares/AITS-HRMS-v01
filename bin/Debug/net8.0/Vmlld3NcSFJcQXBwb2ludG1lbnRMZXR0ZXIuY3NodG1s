@model List<Erp_Aits.Models.AppointmentLetter>
@{
    ViewBag.Title = "Appointment Letter";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Appointment Letter</h4>
    <a href="@Url.Action("CreateAppointmentLetter", "HR")" class="btn btn-dark btn-sm">+ Add Appointment Letter</a>
</div>

<form method="get" asp-action="AppointmentLetter" class="row g-2 mb-3">
    <div class="col-md-3">
        <input type="text" name="id" class="form-control form-control-sm" placeholder="ID" value="@ViewBag.IdFilter" />
    </div>
    <div class="col-md-3">
        <input type="text" name="applicantName" class="form-control form-control-sm" placeholder="Applicant Name" value="@ViewBag.ApplicantNameFilter" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-sm btn-outline-dark">Filter</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>Job Applicant</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var l in Model)
        {
            <tr style="cursor:pointer;" onclick="location.href='@Url.Action("AppointmentLetterDetails", "HR", new { id = l.Id })'">
                <td>@l.AppointmentLetterCode</td>
                <td>@l.JobApplicant</td>
            </tr>
        }
    </tbody>
</table>
@if (!Model.Any())
{
    <p class="text-muted">No appointment letters found.</p>
}
