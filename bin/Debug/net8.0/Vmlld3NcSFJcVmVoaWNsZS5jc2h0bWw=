@model List<Erp_Aits.Models.Vehicle>

@{
    ViewBag.Title = "Vehicle";
    var uoms = ViewBag.Uoms as List<string> ?? new List<string>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Vehicle</h4>

    <div>
        <a href="@Url.Action("SyncVehiclesFromErpNext", "HR")" class="btn btn-outline-primary btn-sm">
            Sync From ERPNext
        </a>

        <button type="button" class="btn btn-dark btn-sm" data-bs-toggle="modal" data-bs-target="#newVehicleModal">
            + Add Vehicle
        </button>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-danger">@TempData["ErpNextError"]</div>
}

<form method="get" asp-action="Vehicle" class="row g-2 mb-3">
    <div class="col-md-2">
        <input type="text" name="id" class="form-control form-control-sm" placeholder="ID" value="@ViewBag.IdFilter" />
    </div>

    <div class="col-md-2">
        <input type="text" name="model" class="form-control form-control-sm" placeholder="Model" value="@ViewBag.ModelFilter" />
    </div>

    <div class="col-md-2">
        <input type="text" name="employee" class="form-control form-control-sm" placeholder="Employee" value="@ViewBag.EmployeeFilter" />
    </div>

    <div class="col-md-2">
        <select name="fuelType" class="form-select form-select-sm">
            <option value="">Fuel Type</option>
            <option value="Diesel" selected="@("Diesel" == (string)ViewBag.FuelTypeFilter)">Diesel</option>
            <option value="Petrol" selected="@("Petrol" == (string)ViewBag.FuelTypeFilter)">Petrol</option>
            <option value="Natural Gas" selected="@("Natural Gas" == (string)ViewBag.FuelTypeFilter)">Natural Gas</option>
            <option value="Electric" selected="@("Electric" == (string)ViewBag.FuelTypeFilter)">Electric</option>
        </select>
    </div>

    <div class="col-md-2">
        <button type="submit" class="btn btn-sm btn-outline-dark">Filter</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>License Plate</th>
            <th>Model</th>
            <th>Employee</th>
            <th>Fuel Type</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var v in Model)
        {
            <tr style="cursor:pointer;" onclick="location.href='@Url.Action("VehicleDetails", "HR", new { id = v.Id })'">
                <td>@v.VehicleCode</td>
                <td>@v.LicensePlate</td>
                <td>@v.Model</td>
                <td>@v.Employee</td>
                <td>@v.FuelType</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No vehicles found.</p>
}

<div class="modal fade" id="newVehicleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="QuickCreateVehicle" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">New Vehicle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <label class="form-label">License Plate *</label>
                    <input type="text" name="LicensePlate" class="form-control mb-3" required />

                    <label class="form-label">Make *</label>
                    <input type="text" name="Make" class="form-control mb-3" required />

                    <label class="form-label">Model *</label>
                    <input type="text" name="Model" class="form-control mb-3" required />

                    <label class="form-label">Odometer Value (Last) *</label>
                    <input type="number" step="0.01" name="OdometerValueLast" class="form-control mb-3" required />

                    <label class="form-label">Fuel Type *</label>
                    <select name="FuelType" class="form-select mb-3" required>
                        <option value="Petrol">Petrol</option>
                        <option value="Diesel">Diesel</option>
                        <option value="Natural Gas">Natural Gas</option>
                        <option value="Electric">Electric</option>
                    </select>

                    <label class="form-label">Fuel UOM *</label>
                    <select name="FuelUOM" class="form-select" required>
                        <option value="">Select Fuel UOM</option>
                        @foreach (var uom in uoms)
                        {
                            <option value="@uom">@uom</option>
                        }
                    </select>
                </div>

                <div class="modal-footer justify-content-between">
                    <a href="@Url.Action("CreateVehicle", "HR")" class="btn btn-outline-secondary btn-sm">
                        Edit Full Form
                    </a>

                    <button type="submit" class="btn btn-dark btn-sm">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>