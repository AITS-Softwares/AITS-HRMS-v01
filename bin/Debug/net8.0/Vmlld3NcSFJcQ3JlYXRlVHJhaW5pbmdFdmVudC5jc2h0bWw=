@model Erp_Aits.Models.TrainingEvent
@{
    ViewBag.Title = "New Training Event";
}

<form asp-action="CreateTrainingEvent" method="post">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">New Training Event</h4>
        <button type="submit" class="btn btn-dark btn-sm">Save</button>
    </div>

    <div class="card p-4 mb-3">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Event Name *</label>
                <input asp-for="EventName" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">Type *</label>
                <select asp-for="Type" class="form-select" required>
                    <option>Theory</option>
                    <option>Workshop</option>
                    <option>Conference</option>
                    <option>Study</option>
                    <option>Exam</option>
                    <option>Internet</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Training Program</label>
                <input asp-for="TrainingProgram" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Level</label>
                <select asp-for="Level" class="form-select">
                    <option value="">Select</option>
                    <option>Beginner</option>
                    <option>Intermediate</option>
                    <option>Advance</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Event Status *</label>
                <select asp-for="EventStatus" class="form-select" required>
                    <option>Scheduled</option>
                    <option>Completed</option>
                    <option>Cancelled</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Company</label>
                <input asp-for="Company" class="form-control" value="AITS" />
            </div>
            <div class="col-md-6">
                <div class="form-check">
                    <input asp-for="HasCertificate" class="form-check-input" type="checkbox" />
                    <label class="form-check-label">Has Certificate</label>
                </div>
            </div>
        </div>
    </div>

    <div class="card p-4 mb-3">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Trainer Name</label>
                <input asp-for="TrainerName" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Supplier</label>
                <input asp-for="Supplier" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Trainer Email</label>
                <input asp-for="TrainerEmail" type="email" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Contact Number</label>
                <input asp-for="ContactNumber" class="form-control" />
            </div>
        </div>
    </div>

    <div class="card p-4 mb-3">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Course</label>
                <input asp-for="Course" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Start Time *</label>
                <input asp-for="StartTime" type="datetime-local" class="form-control" required />
                <small class="text-muted">Asia/Kolkata</small>
            </div>
            <div class="col-md-6">
                <label class="form-label">Location *</label>
                <input asp-for="Location" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">End Time *</label>
                <input asp-for="EndTime" type="datetime-local" class="form-control" required />
                <small class="text-muted">Asia/Kolkata</small>
            </div>
        </div>
    </div>

    <div class="card p-4">
        <label class="form-label">Introduction *</label>
        <textarea asp-for="Introduction" class="form-control" rows="10" required></textarea>
    </div>
</form>
