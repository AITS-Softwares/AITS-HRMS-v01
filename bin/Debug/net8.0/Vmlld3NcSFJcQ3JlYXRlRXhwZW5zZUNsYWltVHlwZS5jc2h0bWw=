@model Erp_Aits.Models.ExpenseClaimType

@{
    ViewBag.Title = "New Expense Claim Type";
}


@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">

        <strong>ERPNext Validation:</strong>
        @TempData["ErpNextError"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<!-- ============================================================= -->
<!-- ACCOUNT MASTER -->
<!-- Hidden source used by JS -->
<!-- ============================================================= -->

<select id="accountMaster"
        style="display:none;">

    @if (ViewBag.Accounts != null)
    {
        foreach (var acc in ViewBag.Accounts)
        {
            <option value="@acc.name"
                    data-company="@acc.company">

                @acc.name

            </option>
        }
    }

</select>


<form asp-action="CreateExpenseClaimType"
      asp-controller="HR"
      method="post"
      id="expenseClaimTypeForm">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>

            <h4 class="mb-0 d-inline">
                New Expense Claim Type
            </h4>

            <span class="badge bg-warning-subtle text-warning ms-2">
                Not Saved
            </span>

        </div>


        <button type="submit"
                class="btn btn-dark btn-sm px-4">

            Save

        </button>

    </div>


    <div class="card border rounded-3 p-4 mb-3">

        <div class="row g-3">


            <!-- EXPENSE CLAIM TYPE -->
            <div class="col-md-6">

                <label class="form-label">

                    Expense Claim Type

                    <span class="text-danger">*</span>

                </label>


                <input asp-for="Name"
                       class="form-control"
                       required
                       autofocus />

            </div>


            <!-- DEFERRED EXPENSE -->
            <div class="col-md-6">

                <label class="form-label d-block">
                    &nbsp;
                </label>


                <div class="form-check">

                    <input asp-for="DeferredExpenseAccount"
                           class="form-check-input"
                           type="checkbox" />


                    <label asp-for="DeferredExpenseAccount"
                           class="form-check-label">

                        Deferred Expense Account

                    </label>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- ACCOUNTS -->
    <!-- ========================================================= -->

    <div class="card border rounded-3 p-4 mb-3">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <h6 class="mb-0">
                Accounts
            </h6>


            <button type="button"
                    id="btnAddAccount"
                    class="btn btn-sm btn-outline-secondary">

                + Add Row

            </button>

        </div>


        <div class="table-responsive">

            <table class="table table-bordered align-middle"
                   id="accountsTable">

                <thead class="table-light">

                    <tr>

                        <th style="width:60px;">
                            No.
                        </th>

                        <th>
                            Company
                        </th>

                        <th>
                            Default Account
                            <span class="text-danger">*</span>
                        </th>

                        <th style="width:70px;">
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody id="accountsBody">

                    <tr id="noAccountsRow">

                        <td colspan="4"
                            class="text-center text-muted py-3">

                            No Data

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </div>


    <!-- DESCRIPTION -->
    <div class="card border rounded-3 p-4">

        <label class="form-label">
            Description
        </label>


        <textarea asp-for="Description"
                  class="form-control"
                  rows="5"></textarea>

    </div>

</form>


@section Scripts
{
    <script>

        let accountRowIndex = 0;


        // ============================================================
        // COMPANY OPTIONS
        // ============================================================

        function getCompanyOptions()
        {
            let html =
                '<option value="">-- Select Company --</option>';


            @if (ViewBag.Companies != null)
            {
                    foreach (var company in ViewBag.Companies)
                    {
                            <text>
                            html +=
                                '<option value="@Html.Raw(
                                                                 System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(
                                                                     company.name.ToString()
                                                                 )
                                                             )">@Html.Raw(
                                                System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(
                                                        company.name.ToString()
                                                )
                                        )</option>';
                </text>
                        }
            }


            return html;
        }


        // ============================================================
        // ACCOUNT OPTIONS BY COMPANY
        // ============================================================

        function getAccountOptions(company)
        {
            let html =
                '<option value="">-- Select Default Account --</option>';


            const source =
                document.getElementById(
                    'accountMaster'
                );


            Array.from(
                source.options
            ).forEach(
                function(option)
                {
                    const accountCompany =
                        option.getAttribute(
                            'data-company'
                        ) || '';


                    if (
                        !company ||
                        accountCompany === company
                    )
                    {
                        html +=
                            '<option value="'
                            + escapeHtml(option.value)
                            + '">'
                            + escapeHtml(option.textContent.trim())
                            + '</option>';
                    }
                }
            );


            return html;
        }


        // ============================================================
        // ADD ROW
        // ============================================================

        function addAccountRow(
            company = '',
            account = '')
        {
            const noData =
                document.getElementById(
                    'noAccountsRow'
                );


            if (noData)
                noData.remove();


            const tbody =
                document.getElementById(
                    'accountsBody'
                );


            const index =
                accountRowIndex++;


            const row =
                document.createElement(
                    'tr'
                );


            row.innerHTML = `

                <td class="row-number text-center">
                    ${index + 1}
                </td>


                <td>

                    <input name="Accounts[${index}].Company"
                           class="form-control form-control-sm company-input"
                           value="${escapeHtml(company)}" />

                </td>


                <td>

                    <select name="Accounts[${index}].DefaultAccount"
                            class="form-select form-select-sm account-select"
                            required>

                        ${getAccountOptions()}

                    </select>

                </td>


                <td class="text-center">

                    <button type="button"
                            class="btn btn-sm btn-outline-danger remove-account">

                        ×

                    </button>

                </td>
            `;


            tbody.appendChild(
                row
            );


            const accountSelect =
                row.querySelector(
                    '.account-select'
                );


            accountSelect.innerHTML =
                getAccountOptions();


            accountSelect.value =
                account;


            reindexRows();
        }


        // ============================================================
        // COMPANY CHANGE
        // Filter Account dropdown like ERP Link behavior.
        // ============================================================

        document.addEventListener(
            'change',
            function(event)
            {
                if (
                    event.target.classList.contains(
                        'company-select'
                    )
                )
                {
                    const row =
                        event.target.closest(
                            'tr'
                        );


                    const accountSelect =
                        row.querySelector(
                            '.account-select'
                        );


                    accountSelect.innerHTML =
                        getAccountOptions(
                            event.target.value
                        );


                    accountSelect.value =
                        '';
                }
            }
        );


        // ============================================================
        // ADD
        // ============================================================

        document.getElementById(
            'btnAddAccount'
        ).addEventListener(
            'click',
            function()
            {
                addAccountRow();
            }
        );


        // ============================================================
        // REMOVE
        // ============================================================

        document.addEventListener(
            'click',
            function(event)
            {
                if (
                    event.target.classList.contains(
                        'remove-account'
                    )
                )
                {
                    event.target
                        .closest('tr')
                        .remove();


                    reindexRows();


                    if (
                        document.querySelectorAll(
                            '#accountsBody tr'
                        ).length === 0
                    )
                    {
                        document.getElementById(
                            'accountsBody'
                        ).innerHTML = `

                            <tr id="noAccountsRow">

                                <td colspan="4"
                                    class="text-center text-muted py-3">

                                    No Data

                                </td>

                            </tr>
                        `;
                    }
                }
            }
        );


        // ============================================================
        // REINDEX
        // ============================================================

        function reindexRows()
        {
            const rows =
                document.querySelectorAll(
                    '#accountsBody tr:not(#noAccountsRow)'
                );


            rows.forEach(
                function(row, index)
                {
                    row.querySelector(
                        '.row-number'
                    ).textContent =
                        index + 1;

                    row.querySelector(
                        '.company-input'
                    ).name =
                        `Accounts[${index}].Company`;


                    row.querySelector(
                        '.account-select'
                    ).name =
                        `Accounts[${index}].DefaultAccount`;
                }
            );


            accountRowIndex =
                rows.length;
        }


        function escapeHtml(value)
        {
            const div =
                document.createElement(
                    'div'
                );

            div.textContent =
                value || '';

            return div.innerHTML;
        }

    </script>
}
