<div class="dept-list-wrapper">
    <div class="dept-accent-bar"></div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErpNextError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErpNextError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="page-header">
        <div class="page-title">
            <div class="eyebrow">HR &middot; Organization Setup</div>
            <h2>Department</h2>
            <p>Manage all departments in your organization</p>
        </div>

        <div>
            @* <form asp-action="SyncDepartmentsFromErpNext" asp-controller="HR" method="post" class="d-inline">
                <button type="submit" class="btn btn-outline-light btn-sm me-2" style="font-weight: 700; padding: 10px 18px; border-radius: 9px;">⚡ Sync from ERPNext</button>
            </form> *@
            <a href="@Url.Action("CreateDepartment", "HR")" class="btn-add">
                <i class="bi bi-plus-circle"></i> Add Department
            </a>
        </div>
    </div>

    <div class="table-card">
        <div class="table-toolbar">
            <input type="text" class="form-control search-box" placeholder="🔍 Search Department">
            <button class="btn-filter">
                <i class="bi bi-funnel"></i> Filter
            </button>
        </div>

        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>ID / Code</th>
                    <th>Status</th>
                    <th>Department</th>
                    <th>Parent Department</th>
                    <th>Is Group</th>
                    <th>Leave Block List</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var dep in Model)
                    {
                        <tr style="cursor:pointer;" onclick="location.href='@Url.Action("DepartmentDetails", "HR", new { id = dep.Id })'">
                            <td class="fw-semibold">
                                @(string.IsNullOrEmpty(dep.DepartmentCode) ? dep.Id.ToString() : dep.DepartmentCode)
                            </td>

                            <td>
                                @if (dep.Status == "Active")
                                {
                                    <span class="badge-active">Active</span>
                                }
                                else
                                {
                                    <span class="badge-disabled">@dep.Status</span>
                                }
                            </td>

                            <td>@dep.DepartmentName</td>
                            <td>@dep.ParentDepartment</td>

                            <td>
                                @if (dep.IsGroup)
                                {
                                    <input type="checkbox" class="form-check-input" checked disabled />
                                }
                                else
                                {
                                    <input type="checkbox" class="form-check-input" disabled />
                                }
                            </td>

                            <td>@dep.LeaveBlockList</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            <div class="empty-state">
                                <div class="empty-icon"><i class="bi bi-inbox"></i></div>
                                <h5>No Departments Found</h5>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>