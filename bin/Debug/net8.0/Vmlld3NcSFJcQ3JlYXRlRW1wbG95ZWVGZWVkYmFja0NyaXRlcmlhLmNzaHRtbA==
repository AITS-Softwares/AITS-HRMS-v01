@model Erp_Aits.Models.EmployeeFeedbackCriteria
@{
    ViewBag.Title = "New Employee Feedback Criteria";
}

<form asp-action="CreateEmployeeFeedbackCriteria" method="post">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">New Employee Feedback Criteria</h4>
        <button type="submit" class="btn btn-dark btn-sm">Save</button>
    </div>

    <div class="card p-4">
        <div class="row g-3">
            <div class="col-md-12">
                <label class="form-label">Criteria *</label>
                <input asp-for="Criteria" class="form-control" required />
            </div>
        </div>
    </div>
</form>
