@model Erp_Aits.Models.LeaveApplication
@{
    ViewBag.Title = "Leave Application Details";
    bool isEdit = ViewBag.IsEdit == true;
    bool isSubmitted = string.Equals(Model.Status, "Submitted", StringComparison.OrdinalIgnoreCase);
    bool isCancelled = string.Equals(Model.Status, "Cancelled", StringComparison.OrdinalIgnoreCase);
}

<datalist id="employeeList">
    @if (ViewBag.Employees != null)
    {
        foreach (var emp in ViewBag.Employees)
        {
            <option value="@emp.name" data-name="@emp.employee_name">@emp.employee_name</option>
        }
    }
</datalist>

<style>
    :root {
        --accent: #3b4b8c;
        --accent-light: #eef0fa;
    }

    body {
        background: linear-gradient(160deg, #eef1f8 0%, #e3e9f7 45%, #eef4f2 100%);
        min-height: 100vh;
    }

    .leave-form-wrapper {
        max-width: 1100px;
        margin: 0 auto;
        padding-top: 4px;
    }

        .leave-form-wrapper .form-header {
            background: linear-gradient(120deg, #1f2a44 0%, #34437a 55%, var(--accent) 100%);
            padding: 1.1rem 1.6rem;
            border-radius: 14px 14px 0 0;
            box-shadow: 0 8px 22px rgba(31, 42, 68, 0.28);
        }

        .leave-form-wrapper h4 {
            font-weight: 650;
            color: #ffffff;
            letter-spacing: 0.4px;
            margin: 0;
        }

        .leave-form-wrapper .btn-dark {
            background: linear-gradient(135deg, #f7b733 0%, #e8912a 100%);
            color: #1f2a44;
            border: none;
            padding: 0.5rem 1.6rem;
            font-weight: 600;
            letter-spacing: 0.3px;
            border-radius: 8px;
            box-shadow: 0 3px 10px rgba(232, 145, 42, 0.45);
            transition: all 0.2s ease-in-out;
        }

            .leave-form-wrapper .btn-dark:hover {
                background: linear-gradient(135deg, #ffc94d 0%, #f39d33 100%);
                box-shadow: 0 5px 14px rgba(232, 145, 42, 0.6);
                transform: translateY(-2px);
                color: #16203a;
            }

        .leave-form-wrapper .form-body {
            background: #ffffff;
            border-radius: 0 0 14px 14px;
            box-shadow: 0 10px 28px rgba(31, 42, 68, 0.12);
            overflow: hidden;
        }

        .leave-form-wrapper .section {
            padding: 1.75rem 2rem;
            border-left: 5px solid var(--accent);
            border-right: 5px solid var(--accent);
            border-bottom: 1px solid #eef0f6;
        }

            .leave-form-wrapper .section:last-child {
                border-bottom: none;
            }

            .leave-form-wrapper .section h6 {
                color: var(--accent);
                font-weight: 650;
                font-size: 1rem;
                letter-spacing: 0.2px;
                margin-bottom: 1.1rem;
            }

        .leave-form-wrapper .form-label {
            color: var(--accent);
            font-weight: 650;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 0.4px;
            display: inline-block;
        }

        .leave-form-wrapper .form-control,
        .leave-form-wrapper .form-select {
            border: 1.5px solid #dfe3f0;
            border-radius: 9px;
            background-color: var(--accent-light);
            padding: 0.6rem 0.9rem;
            font-size: 0.95rem;
            color: #26314f;
        }
</style>

<div class="leave-form-wrapper">
    <form asp-action="UpdateLeaveApplication" asp-controller="HR" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ErpNextId" />
        <input type="hidden" asp-for="LeaveApplicationCode" />

        <div class="form-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Leave Application (@Model.LeaveApplicationCode)</h4>
            <div class="d-flex gap-2 align-items-center">
                <a href="@Url.Action("LeaveApplications", "HR")" class="btn btn-outline-light btn-sm" style="border:1.5px solid rgba(255,255,255,0.7); color:#fff; font-weight:600;">Back</a>
                @if (isEdit)
                {
                    <a href="@Url.Action("LeaveApplicationDetails", "HR", new { id = Model.Id })" class="btn btn-outline-light btn-sm" style="border:1.5px solid rgba(255,255,255,0.7); color:#fff; font-weight:600;">Cancel</a>
                    <button type="submit" name="actionCommand" value="Save" class="btn btn-dark btn-sm">Save</button>
                }
                else
                {
                    @if (!isSubmitted && !isCancelled)
                    {
                        <a href="@Url.Action("LeaveApplicationDetails", "HR", new { id = Model.Id, edit = true })" class="btn btn-dark btn-sm">Edit</a>
                        <button type="submit" name="actionCommand" value="Submit" class="btn btn-dark btn-sm">Submit</button>
                        <button type="submit" form="deleteLeaveApplicationForm" class="btn btn-outline-light btn-sm" style="border:1.5px solid rgba(255,255,255,0.7); color:#fff; font-weight:600;" onclick="return confirm('Delete this Leave Application from ERPNext and HRMS?');">Delete</button>
                    }
                    @if (isSubmitted)
                    {
                        <button type="submit" name="actionCommand" value="Cancel" class="btn btn-outline-light btn-sm" style="border:1.5px solid rgba(255,255,255,0.7); color:#fff; font-weight:600;" onclick="return confirm('Cancel this Leave Application and any linked submitted Attendance in ERPNext and HRMS?');">Cancel All</button>
                    }
                }
            </div>
        </div>

        <div class="form-body">
            @if (TempData["ErpNextError"] != null)
            {
                <div class="alert alert-danger m-3">@TempData["ErpNextError"]</div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success m-3">@TempData["Success"]</div>
            }

            <fieldset disabled="@(!isEdit)">
            <div class="section">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Leave Type *</label>
                        <select asp-for="LeaveType" class="form-select" required>
                            <option value="">-- Select Leave Type --</option>
                            @if (ViewBag.LeaveTypes != null)
                            {
                                foreach (var lt in ViewBag.LeaveTypes)
                                {
                                    <option value="@lt.name">@lt.name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Employee *</label>
                        <input asp-for="Employee" id="employeeInput" list="employeeList" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Employee Name</label>
                        <input asp-for="EmployeeName" id="employeeNameInput" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Company *</label>
                        <input asp-for="Company" class="form-control" required />
                    </div>
                </div>
            </div>

            <div class="section">
                <h6 class="mb-3">Dates &amp; Reason</h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">From Date *</label>
                        <input asp-for="FromDate" type="date" class="form-control" value="@Model?.FromDate?.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Reason</label>
                        <textarea asp-for="Reason" class="form-control" rows="4"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">To Date *</label>
                        <input asp-for="ToDate" type="date" class="form-control" value="@Model?.ToDate?.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check">
                            <input asp-for="HalfDay" class="form-check-input" type="checkbox" />
                            <label class="form-check-label">Half Day</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="section">
                <h6 class="mb-3">Approval</h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Leave Approver *</label>
                        <select asp-for="LeaveApprover" class="form-select" required>
                            <option value="">-- Select Leave Approver --</option>
                            @if (ViewBag.LeaveApprovers != null)
                            {
                                foreach (var app in ViewBag.LeaveApprovers)
                                {
                                    <option value="@app.name">@app.email (@app.name)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Status *</label>
                        <select asp-for="Status" class="form-select">
                            <option>Open</option>
                            <option>Approved</option>
                            <option>Rejected</option>
                            <option>Submitted</option>
                            <option>Cancelled</option>
                        </select>
                    </div>
                </div>
            </div>
            </fieldset>
        </div>
    </form>
    <form id="deleteLeaveApplicationForm" method="post" action="@Url.Action("DeleteLeaveApplication", "HR", new { id = Model.Id })"></form>
</div>

@section Scripts {
    <script>
        document.getElementById('employeeInput').addEventListener('input', function() {
            let val = this.value;
            let options = document.querySelectorAll('#employeeList option');
            let nameField = document.getElementById('employeeNameInput');

            for (let opt of options) {
                if (opt.value === val) {
                    nameField.value = opt.getAttribute('data-name') || opt.innerText;
                    break;
                }
            }
        });
    </script>
}
