@functions {
    public string GetColor(string name)
    {
        if (string.IsNullOrEmpty(name)) return "#4f46e5";
        var colors = new[] { "#4f46e5", "#7c3aed", "#2563eb", "#0891b2", "#059669", "#d97706", "#dc2626", "#6b7280" };
        var index = Math.Abs(name.GetHashCode()) % colors.Length;
        return colors[index];
    }
}

@section Scripts {
    <script>
        // Auto-hide alerts after 5 seconds
        setTimeout(function() {
            var alerts = document.querySelectorAll('.alert');
            alerts.forEach(function(alert) {
                var closeButton = alert.querySelector('.btn-close');
                if (closeButton) {
                    closeButton.click();
                }
            });
        }, 5000);

        // Confirm before sending
        document.querySelectorAll('.send-form').forEach(function(form) {
            form.addEventListener('submit', function(e) {
                if (!confirm('Are you sure you want to send this campaign now?')) {
                    e.preventDefault();
                    return false;
                }
                // Show loading state
                var btn = this.querySelector('button[type="submit"]');
                if (btn) {
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
                    btn.disabled = true;
                }
                return true;
            });
        });

        // Confirm before delete
        document.querySelectorAll('.btn-danger').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                if (!confirm('Are you sure you want to delete this campaign? This action cannot be undone.')) {
                    e.preventDefault();
                    return false;
                }
                return true;
            });
        });

        console.log('Campaigns page loaded with @Model.Count() campaigns');
    </script>
} *@

@using Microsoft.Extensions.Configuration
@using Microsoft.Data.SqlClient
@using System.Collections.Generic
@using System.Data
@inject IConfiguration _configuration
@model IEnumerable<Erp_Aits.Models.Campaign>
@{
    ViewData["Title"] = "Campaigns";
    ViewData["Module"] = "CRM";
    ViewData["Icon"] = "bullhorn";
    var summary = ViewBag.Summary as Dictionary<string, int>;
    var loginType = Context.Session.GetString("LoginType") ?? "User";
    var userRole = Context.Session.GetString("UserRole") ?? "User";
    var userId = Context.Session.GetString("UserId");
    var isFullAccess = loginType == "Company" || userRole == "Admin";

    // Check specific page access from database
    var canCreateCampaign = false;
    var canEditCampaign = false;
    var canDeleteCampaign = false;

    if (!string.IsNullOrEmpty(userId))
    {
        try
        {
            var connectionString = _configuration.GetConnectionString("DefaultConnection");
            using (var conn = new SqlConnection(connectionString))
            {
                conn.Open();

                // Check Campaign Create access (PermissionId 18)
                string query = @"
                    SELECT CASE
                        WHEN EXISTS (
                            SELECT 1 FROM UserPermissions
                            WHERE UserId = @UserId
                            AND PermissionId = 18
                            AND CanCreate = 1
                        ) THEN 1
                        WHEN EXISTS (
                            SELECT 1 FROM RolePermissions rp
                            INNER JOIN Users u ON u.Role = rp.RoleName
                            WHERE u.Id = @UserId
                            AND rp.PermissionId = 18
                            AND rp.CanCreate = 1
                        ) THEN 1
                        ELSE 0
                    END AS HasAccess";

                using (var cmd = new SqlCommand(query, conn))
                {
                    cmd.Parameters.AddWithValue("@UserId", int.Parse(userId));
                    var result = cmd.ExecuteScalar();
                    canCreateCampaign = result != null && Convert.ToInt32(result) == 1;
                }

                // Check Campaign Edit access (PermissionId 19)
                query = @"
                    SELECT CASE
                        WHEN EXISTS (
                            SELECT 1 FROM UserPermissions
                            WHERE UserId = @UserId
                            AND PermissionId = 19
                            AND CanEdit = 1
                        ) THEN 1
                        WHEN EXISTS (
                            SELECT 1 FROM RolePermissions rp
                            INNER JOIN Users u ON u.Role = rp.RoleName
                            WHERE u.Id = @UserId
                            AND rp.PermissionId = 19
                            AND rp.CanEdit = 1
                        ) THEN 1
                        ELSE 0
                    END AS HasAccess";

                using (var cmd = new SqlCommand(query, conn))
                {
                    cmd.Parameters.AddWithValue("@UserId", int.Parse(userId));
                    var result = cmd.ExecuteScalar();
                    canEditCampaign = result != null && Convert.ToInt32(result) == 1;
                }

                // Check Campaign Delete access (PermissionId 20)
                query = @"
                    SELECT CASE
                        WHEN EXISTS (
                            SELECT 1 FROM UserPermissions
                            WHERE UserId = @UserId
                            AND PermissionId = 20
                            AND CanDelete = 1
                        ) THEN 1
                        WHEN EXISTS (
                            SELECT 1 FROM RolePermissions rp
                            INNER JOIN Users u ON u.Role = rp.RoleName
                            WHERE u.Id = @UserId
                            AND rp.PermissionId = 20
                            AND rp.CanDelete = 1
                        ) THEN 1
                        ELSE 0
                    END AS HasAccess";

                using (var cmd = new SqlCommand(query, conn))
                {
                    cmd.Parameters.AddWithValue("@UserId", int.Parse(userId));
                    var result = cmd.ExecuteScalar();
                    canDeleteCampaign = result != null && Convert.ToInt32(result) == 1;
                }
            }
        }
        catch (Exception ex)
        {
            // Fallback to role-based access
            canCreateCampaign = isFullAccess || userRole == "Manager";
            canEditCampaign = isFullAccess || userRole == "Manager";
            canDeleteCampaign = isFullAccess;
        }
    }
    else
    {
        canCreateCampaign = isFullAccess || userRole == "Manager";
        canEditCampaign = isFullAccess || userRole == "Manager";
        canDeleteCampaign = isFullAccess;
    }
}

