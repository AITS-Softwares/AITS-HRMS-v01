@* @model IEnumerable<Erp_Aits.Models.Campaign>
@{
    ViewData["Title"] = "Campaigns";
    ViewData["Module"] = "CRM";
    ViewData["Icon"] = "bullhorn";
    var summary = ViewBag.Summary as Dictionary<string, int>;
}

<!-- Stats Cards -->
<div class="stats-row">
    <div class="stat-card">
        <div class="stat-icon blue">
            <i class="fas fa-bullhorn"></i>
        </div>
        <div class="stat-info">
            <div class="stat-number">@(summary?.ContainsKey("Total") == true ? summary["Total"] : 0)</div>
            <div class="stat-label">Total Campaigns</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon orange">
            <i class="fas fa-clock"></i>
        </div>
        <div class="stat-info">
            <div class="stat-number">@(summary?.ContainsKey("Scheduled") == true ? summary["Scheduled"] : 0)</div>
            <div class="stat-label">Scheduled</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon green">
            <i class="fas fa-check-circle"></i>
        </div>
        <div class="stat-info">
            <div class="stat-number">@(summary?.ContainsKey("Sent") == true ? summary["Sent"] : 0)</div>
            <div class="stat-label">Sent</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon red">
            <i class="fas fa-times-circle"></i>
        </div>
        <div class="stat-info">
            <div class="stat-number">@(summary?.ContainsKey("Failed") == true ? summary["Failed"] : 0)</div>
            <div class="stat-label">Failed</div>
        </div>
    </div>
</div>

<div class="content-card">
    <div class="card-header-custom">
        <h5>
            <i class="fas fa-bullhorn"></i> Campaign List
            <span class="badge bg-primary ms-2">@Model.Count()</span>
        </h5>
        <div class="d-flex gap-2">
         
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="fas fa-plus"></i> New Campaign
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search / Filter -->
    <form method="get" class="row g-3 mb-4">
        <div class="col-md-3">
            <input type="text" name="searchTerm" class="form-control" placeholder="Search campaigns..." value="@ViewBag.SearchTerm" />
        </div>
        <div class="col-md-2">
            <select name="channel" class="form-control">
                <option value="">All Channels</option>
                <option value="email" selected="@(ViewBag.Channel == "email")">Email</option>
                <option value="whatsapp" selected="@(ViewBag.Channel == "whatsapp")">WhatsApp</option>
                <option value="both" selected="@(ViewBag.Channel == "both")">Both</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-control">
                <option value="">All Status</option>
                <option value="Scheduled" selected="@(ViewBag.Status == "Scheduled")">Scheduled</option>
                <option value="Sent" selected="@(ViewBag.Status == "Sent")">Sent</option>
                <option value="Failed" selected="@(ViewBag.Status == "Failed")">Failed</option>
            </select>
        </div>
        <div class="col-md-5">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-search"></i> Search
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-undo"></i> Reset
            </a>
        </div>
    </form>

    <!-- Table Container with Scroll -->
    <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
        <table class="table table-hover" id="campaignTable">
            <thead style="position: sticky; top: 0; z-index: 10;">
                <tr>
                    <th style="min-width: 180px;">Name</th>
                    <th style="min-width: 120px;">Channel</th>
                    <th style="min-width: 150px;">Scheduled</th>
                    <th style="min-width: 100px;">Status</th>
                    <th style="min-width: 80px;">Recipients</th>
                    <th style="min-width: 180px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar-sm me-2" style="background: @GetColor(item.CampaignName);">
                                        @item.CampaignName?.Substring(0, 1)
                                    </div>
                                    <div>
                                        <div class="fw-semibold">@item.CampaignName</div>
                                        <div class="text-muted small">@item.CampaignName</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (item.CampaignChannel == "email")
                                {
                                    <span class="badge bg-info"><i class="fas fa-envelope"></i> Email</span>
                                }
                                else if (item.CampaignChannel == "whatsapp")
                                {
                                    <span class="badge bg-success"><i class="fab fa-whatsapp"></i> WhatsApp</span>
                                }
                                else if (item.CampaignChannel == "both")
                                {
                                    <span class="badge bg-primary"><i class="fas fa-envelope"></i> <i class="fab fa-whatsapp"></i> Both</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.CampaignChannel</span>
                                }
                            </td>
                            <td>
                                @{
                                    var scheduledTime = item.ScheduledTime.HasValue
                                    ? item.ScheduledTime.Value.ToString("dd MMM yyyy HH:mm")
                                    : "N/A";
                                }
                                <span class="text-muted small">@scheduledTime</span>
                            </td>
                            <td>
                                <span class="badge bg-@(item.Status == "Sent" ? "success" : item.Status == "Scheduled" ? "warning" : "danger")">
                                    @item.Status
                                </span>
                            </td>
                            <td>
                                <span class="fw-bold">@item.RecipientCount</span>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info" title="View">
                                        <i class="fas fa-eye"></i>
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" title="Delete" onclick="return confirm('Are you sure you want to delete this campaign?');">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            <i class="fas fa-inbox fa-2x d-block mb-2"></i>
                            No campaigns found. Create your first campaign!
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Show count -->
    <div class="mt-3 text-muted small">
        Showing @Model.Count() campaign(s)
    </div>
</div>

