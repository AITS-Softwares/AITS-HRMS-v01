@model List<Erp_Aits.Models.TrainingEvent>
@{
    ViewBag.Title = "Training Event";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Training Event</h4>
    <a href="@Url.Action("CreateTrainingEvent", "HR")" class="btn btn-dark btn-sm">+ Add Training Event</a>
</div>

<form method="get" asp-action="TrainingEvent" class="row g-2 mb-3">
    <div class="col-md-2">
        <input type="text" name="id" class="form-control form-control-sm" placeholder="ID" value="@ViewBag.IdFilter" />
    </div>
    <div class="col-md-2">
        <input type="text" name="eventName" class="form-control form-control-sm" placeholder="Event Name" value="@ViewBag.EventNameFilter" />
    </div>
    <div class="col-md-2">
        <select name="eventStatus" class="form-select form-select-sm">
            <option value="">Event Status</option>
            <option value="Scheduled" selected="@("Scheduled" == (string)ViewBag.EventStatusFilter)">Scheduled</option>
            <option value="Completed" selected="@("Completed" == (string)ViewBag.EventStatusFilter)">Completed</option>
            <option value="Cancelled" selected="@("Cancelled" == (string)ViewBag.EventStatusFilter)">Cancelled</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="type" class="form-select form-select-sm">
            <option value="">Type</option>
            <option value="Seminar" selected="@("Seminar" == (string)ViewBag.TypeFilter)">Seminar</option>
            <option value="Theory" selected="@("Theory" == (string)ViewBag.TypeFilter)">Theory</option>
            <option value="Workshop" selected="@("Workshop" == (string)ViewBag.TypeFilter)">Workshop</option>
            <option value="Conference" selected="@("Conference" == (string)ViewBag.TypeFilter)">Conference</option>
            <option value="Exam" selected="@("Exam" == (string)ViewBag.TypeFilter)">Exam</option>
            <option value="Internet" selected="@("Internet" == (string)ViewBag.TypeFilter)">Internet</option>
            <option value="Self Study" selected="@("Self Study" == (string)ViewBag.TypeFilter)">Self Study</option>
        </select>
    </div>
    <div class="col-md-2">
        <input type="text" name="course" class="form-control form-control-sm" placeholder="Course" value="@ViewBag.CourseFilter" />
    </div>
    <div class="col-md-2">
        <input type="text" name="location" class="form-control form-control-sm" placeholder="Location" value="@ViewBag.LocationFilter" />
    </div>
    <div class="col-md-2 mt-2">
        <button type="submit" class="btn btn-sm btn-outline-dark">Filter</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>Event Name</th>
            <th>Status</th>
            <th>Type</th>
            <th>Course</th>
            <th>Location</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model)
        {
            <tr style="cursor:pointer;" onclick="location.href='@Url.Action("TrainingEventDetails", "HR", new { id = e.Id })'">
                <td>@e.TrainingEventCode</td>
                <td>@e.EventName</td>
                <td><span class="badge bg-secondary-subtle text-secondary">@e.EventStatus</span></td>
                <td>@e.Type</td>
                <td>@e.Course</td>
                <td>@e.Location</td>
            </tr>
        }
    </tbody>
</table>
@if (!Model.Any())
{
    <p class="text-muted">No training events found.</p>
}
