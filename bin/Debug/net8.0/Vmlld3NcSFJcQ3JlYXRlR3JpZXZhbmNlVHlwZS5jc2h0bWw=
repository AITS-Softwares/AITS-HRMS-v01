@model Erp_Aits.Models.GrievanceType
@{
    ViewBag.Title = "New Grievance Type";
}

<form asp-action="CreateGrievanceType" method="post">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0 d-inline-block me-2">New Grievance Type</h4>
            <span class="badge bg-warning-subtle text-warning">Not Saved</span>
        </div>

        <button type="submit" class="btn btn-dark btn-sm">Save</button>
    </div>

    <div class="card p-4">
        <div class="mb-3">
            <label class="form-label">Name <span class="text-danger">*</span></label>
            <input asp-for="Name" class="form-control" required autofocus />
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="8"></textarea>
        </div>
    </div>
</form>