@model Erp_Aits.Models.TrainingEvent
@{
    ViewBag.Title = Model.EventName;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0">@Model.EventName</h4>
        <small class="text-muted">@Model.TrainingEventCode</small>
    </div>
    <a href="@Url.Action("TrainingEvent", "HR")" class="btn btn-outline-dark btn-sm">Back to List</a>
</div>

<div class="card p-4 mb-3">
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">Event Name</label><div class="form-control bg-light">@Model.EventName</div></div>
        <div class="col-md-6"><label class="form-label">Type</label><div class="form-control bg-light">@Model.Type</div></div>
        <div class="col-md-6"><label class="form-label">Training Program</label><div class="form-control bg-light">@Model.TrainingProgram</div></div>
        <div class="col-md-6"><label class="form-label">Level</label><div class="form-control bg-light">@Model.Level</div></div>
        <div class="col-md-6"><label class="form-label">Event Status</label><div><span class="badge bg-secondary-subtle text-secondary">@Model.EventStatus</span></div></div>
        <div class="col-md-6"><label class="form-label">Company</label><div class="form-control bg-light">@Model.Company</div></div>
        <div class="col-md-6"><label class="form-label">Has Certificate</label><div class="form-control bg-light">@(Model.HasCertificate ? "Yes" : "No")</div></div>
    </div>
</div>

<div class="card p-4 mb-3">
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">Trainer Name</label><div class="form-control bg-light">@Model.TrainerName</div></div>
        <div class="col-md-6"><label class="form-label">Supplier</label><div class="form-control bg-light">@Model.Supplier</div></div>
        <div class="col-md-6"><label class="form-label">Trainer Email</label><div class="form-control bg-light">@Model.TrainerEmail</div></div>
        <div class="col-md-6"><label class="form-label">Contact Number</label><div class="form-control bg-light">@Model.ContactNumber</div></div>
    </div>
</div>

<div class="card p-4 mb-3">
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">Course</label><div class="form-control bg-light">@Model.Course</div></div>
        <div class="col-md-6"><label class="form-label">Start Time</label><div class="form-control bg-light">@(Model.StartTime?.ToString("dd-MM-yyyy HH:mm"))</div></div>
        <div class="col-md-6"><label class="form-label">Location</label><div class="form-control bg-light">@Model.Location</div></div>
        <div class="col-md-6"><label class="form-label">End Time</label><div class="form-control bg-light">@(Model.EndTime?.ToString("dd-MM-yyyy HH:mm"))</div></div>
    </div>
</div>

<div class="card p-4">
    <label class="form-label">Introduction</label>
    <div class="form-control bg-light" style="min-height:200px; white-space:pre-wrap;">@Model.Introduction</div>
</div>
