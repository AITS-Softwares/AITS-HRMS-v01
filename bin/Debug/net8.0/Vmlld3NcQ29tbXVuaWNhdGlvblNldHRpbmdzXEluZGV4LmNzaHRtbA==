    /* Custom Scrollbar */
    .table-responsive::-webkit-scrollbar {
        width: 4px;
        height: 4px;
    }

    .table-responsive::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 8px;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: #c1c7cd;
        border-radius: 8px;
    }

        .table-responsive::-webkit-scrollbar-thumb:hover {
            background: #a0a7ae;
        }
</style>

@section Scripts {
    <script>
        // ============================================
        // EMAIL FUNCTIONS
        // ============================================

        function openEmailModal() {
            $('#emailModalTitle').html('<i class="fas fa-envelope"></i> Add Email Setting');
            $('#emailId').val(0);
            $('#emailForm').attr('action', '@Url.Action("CreateEmail", "CommunicationSettings")');
            $('#emailForm')[0].reset();
            $('#emailIsActive').prop('checked', true);
            $('#emailModal').modal('show');
        }

        function editEmail(id) {
            $.ajax({
                url: '@Url.Action("GetEmail", "CommunicationSettings")',
                type: 'GET',
                data: { id: id },
                success: function(response) {
                    if (response.success) {
                        var data = response.data;
                        $('#emailModalTitle').html('<i class="fas fa-envelope"></i> Edit Email Setting');
                        $('#emailId').val(data.id);
                        $('#emailEmail').val(data.email);
                        $('#emailPurpose').val(data.purpose);
                        $('#emailService').val(data.service);
                        $('#emailRecovery').val(data.recoveryEmail);
                        $('#emailOwner').val(data.owner);
                        $('#emailMasked').val(data.maskedAppPassword);
                        $('#emailEncrypted').val(data.encryptedAppPassword);
                        $('#emailStatus').val(data.status);
                        $('#emailNotes').val(data.notes);
                        $('#emailIsActive').prop('checked', data.isActive);
                        $('#emailForm').attr('action', '@Url.Action("EditEmail", "CommunicationSettings")');
                        $('#emailModal').modal('show');
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function() {
                    alert('Error loading email data.');
                }
            });
        }

        function deleteEmail(id) {
            if (confirm('Are you sure you want to delete this email setting?')) {
                var form = document.createElement('form');
                form.method = 'post';
                form.action = '@Url.Action("DeleteEmail", "CommunicationSettings")';
                form.innerHTML = '@Html.AntiForgeryToken()';
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'id';
                input.value = id;
                form.appendChild(input);
                document.body.appendChild(form);
                form.submit();
            }
        }

        // ============================================
        // WHATSAPP FUNCTIONS
        // ============================================

        function openWhatsAppModal() {
            $('#whatsappModalTitle').html('<i class="fab fa-whatsapp"></i> Add WhatsApp Setting');
            $('#whatsappId').val(0);
            $('#whatsappForm').attr('action', '@Url.Action("CreateWhatsApp", "CommunicationSettings")');
            $('#whatsappForm')[0].reset();
            $('#whatsappIsActive').prop('checked', true);
            $('#whatsappModal').modal('show');
        }

        function editWhatsApp(id) {
            $.ajax({
                url: '@Url.Action("GetWhatsApp", "CommunicationSettings")',
                type: 'GET',
                data: { id: id },
                success: function(response) {
                    if (response.success) {
                        var data = response.data;
                        $('#whatsappModalTitle').html('<i class="fab fa-whatsapp"></i> Edit WhatsApp Setting');
                        $('#whatsappId').val(data.id);
                        $('#whatsappPhoneNumberId').val(data.phoneNumberId);
                        $('#whatsappBusinessAccountId').val(data.businessAccountId);
                        $('#whatsappAccessToken').val(data.accessToken);
                        $('#whatsappTestNumber').val(data.testNumber);
                        $('#whatsappPhoneNumber').val(data.phoneNumber);
                        $('#whatsappBusinessName').val(data.businessName);
                        $('#whatsappIsActive').prop('checked', data.isActive);
                        $('#whatsappForm').attr('action', '@Url.Action("EditWhatsApp", "CommunicationSettings")');
                        $('#whatsappModal').modal('show');
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function() {
                    alert('Error loading WhatsApp data.');
                }
            });
        }

        function testWhatsApp(id) {
            if (confirm('Send a test message to the configured test number?')) {
                $.ajax({
                    url: '@Url.Action("TestWhatsAppConnection", "CommunicationSettings")',
                    type: 'POST',
                    data: { id: id },
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            alert('✅ ' + response.message);
                        } else {
                            alert('❌ ' + response.message);
                        }
                    },
                    error: function() {
                        alert('Error testing connection.');
                    }
                });
            }
        }

        function deleteWhatsApp(id) {
            if (confirm('Are you sure you want to delete this WhatsApp setting?')) {
                var form = document.createElement('form');
                form.method = 'post';
                form.action = '@Url.Action("DeleteWhatsApp", "CommunicationSettings")';
                form.innerHTML = '@Html.AntiForgeryToken()';
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'id';
                input.value = id;
                form.appendChild(input);
                document.body.appendChild(form);
                form.submit();
            }
        }

        // Auto-hide alerts
        $(document).ready(function() {
            setTimeout(function() {
                $('.alert').fadeOut('slow');
            }, 5000);
        });
    </script>
}