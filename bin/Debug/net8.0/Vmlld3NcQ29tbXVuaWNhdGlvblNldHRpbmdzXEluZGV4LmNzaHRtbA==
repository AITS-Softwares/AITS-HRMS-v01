    }

    /* Modal */
    .modal-content {
        border-radius: 15px;
        border: none;
        box-shadow: 0 20px 60px rgba(0,0,0,0.15);
    }

    .modal-header {
        padding: 18px 24px;
        border-bottom: 1px solid #f0f2f5;
    }

    .modal-body {
        padding: 24px;
    }

    .modal-footer {
        padding: 16px 24px;
        border-top: 1px solid #f0f2f5;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .card-header-custom {
            flex-direction: column;
            align-items: flex-start;
        }

        .section-header {
            flex-wrap: wrap;
        }

            .section-header .btn {
                margin-left: auto !important;
            }

        .table th, .table td {
            padding: 6px 8px;
