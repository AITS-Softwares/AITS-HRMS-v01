                <label class="form-label">Shift Location</label>
                <input name="ShiftLocation" class="form-control" value="@Model.ShiftLocation" />
            </div>
            <div class="col-md-6">
                <label class="form-label">End Date</label>
                <input name="EndDate" type="date" class="form-control" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
            </div>

