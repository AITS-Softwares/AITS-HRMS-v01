@{
    ViewBag.Title = "Team Updates";
}

<div class="eas-wrap">

    <div class="eas-header">
        <h4 class="eas-title">Team Updates</h4>
        <div class="eas-header-actions" style="position: relative;">
            <button type="button" class="eas-btn eas-btn-light" id="teamUpdatesMenuBtn" onclick="toggleTeamUpdatesMenu()">
                <i class="fas fa-ellipsis-h"></i>
            </button>
            <div id="teamUpdatesMenu" class="eas-dropdown-menu">
                <a href="@Url.Action("DailyWorkSummaryGroup", "HR")" class="eas-dropdown-item">
                    Daily Work Summary Group
                </a>
            </div>
        </div>
    </div>

    <div class="eas-empty">
        <i class="fas fa-clipboard-list eas-empty-icon"></i>
        <div class="eas-empty-text">Nothing to show</div>
    </div>

</div>

<style>
    .eas-wrap {
        background: #fff;
        border-radius: 10px;
        padding: 20px 24px;
    }

    .eas-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

    .eas-title {
        margin: 0;
        font-weight: 700;
        font-size: 20px;
        color: #1a1a2e;
    }

    .eas-btn {
        border: 1px solid #d1d5db;
        background: #fff;
        border-radius: 8px;
        padding: 6px 12px;
        font-size: 13px;
        color: #374151;
        cursor: pointer;
    }

        .eas-btn:hover {
            background: #f3f4f6;
        }

    .eas-dropdown-menu {
        display: none;
        position: absolute;
        top: 40px;
        right: 0;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.08);
        min-width: 220px;
        z-index: 20;
        overflow: hidden;
    }

    .eas-dropdown-item {
        display: block;
        padding: 10px 16px;
        font-size: 13px;
        color: #374151;
        text-decoration: none;
        white-space: nowrap;
    }

        .eas-dropdown-item:hover {
            background: #f3f4f6;
            color: #1a1a2e;
        }

    .eas-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 90px 0;
        color: #94a3b8;
    }

    .eas-empty-icon {
        font-size: 34px;
        margin-bottom: 12px;
        opacity: 0.6;
    }

    .eas-empty-text {
        font-size: 14px;
    }
</style>

<script>
    function toggleTeamUpdatesMenu() {
        var menu = document.getElementById('teamUpdatesMenu');
        menu.style.display = (menu.style.display === 'block') ? 'none' : 'block';
    }

    document.addEventListener('click', function (e) {
        var btn = document.getElementById('teamUpdatesMenuBtn');
        var menu = document.getElementById('teamUpdatesMenu');
        if (btn && menu && !btn.contains(e.target) && !menu.contains(e.target)) {
            menu.style.display = 'none';
        }
    });
</script>
