@model List<Erp_Aits.Models.LeavePeriod>
@{
    ViewBag.Title = "Leave Period";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Leave Period</h4>
    <div>
        <a href="@Url.Action("CreateLeavePeriod", "HR")" class="btn btn-dark btn-sm">+ Add Leave Period</a>
    </div>
</div>

@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["ErpNextError"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-3">@TempData["Success"]</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <input type="text" name="id" value="@ViewBag.IdFilter" class="form-control form-control-sm" placeholder="Filter by Company" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Filter</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Company</th>
            <th>From Date</th>
            <th>To Date</th>
            <th>Is Active</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var lp in Model)
        {
            <tr style="cursor:pointer" onclick="location.href='@Url.Action("LeavePeriodDetails", "HR", new { id = lp.Id })'">
                <td>@lp.Company</td>
                <td>@lp.FromDate.ToString("dd-MM-yyyy")</td>
                <td>@lp.ToDate.ToString("dd-MM-yyyy")</td>
                <td>@(lp.IsActive ? "Yes" : "No")</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No leave periods found.</p>
}


