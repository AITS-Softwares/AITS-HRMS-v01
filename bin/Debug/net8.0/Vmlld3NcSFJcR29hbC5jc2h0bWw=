@model List<Erp_Aits.Models.Goal>
@{
    ViewBag.Title = "Goal";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @TempData["ErpNextError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Goal</h4>
    <div class="d-flex gap-2">
        <a href="@Url.Action("CreateGoal", "HR")" class="btn btn-dark btn-sm">+ Add Goal</a>
    </div>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="id" class="form-control form-control-sm" placeholder="ID" value="@ViewBag.IdFilter" />
    </div>
    <div class="col-auto">
        <input type="text" name="goalName" class="form-control form-control-sm" placeholder="Goal" value="@ViewBag.GoalNameFilter" />
    </div>
    <div class="col-auto">
        <select name="status" class="form-select form-select-sm">
            <option value="">Status</option>
            <option value="Pending" selected="@(ViewBag.StatusFilter == "Pending")">Pending</option>
            <option value="In Progress" selected="@(ViewBag.StatusFilter == "In Progress")">In Progress</option>
            <option value="Completed" selected="@(ViewBag.StatusFilter == "Completed")">Completed</option>
            <option value="Archived" selected="@(ViewBag.StatusFilter == "Archived")">Archived</option>
        </select>
    </div>
    <div class="col-auto">
        <input type="text" name="employee" class="form-control form-control-sm" placeholder="Employee" value="@ViewBag.EmployeeFilter" />
    </div>
    <div class="col-auto">
        <input type="date" name="startDate" class="form-control form-control-sm" value="@(ViewBag.StartDateFilter as DateTime?)?.ToString(" yyyy-MM-dd")" />
    </div>
    <div class="col-auto">
        <input type="date" name="endDate" class="form-control form-control-sm" value="@(ViewBag.EndDateFilter as DateTime?)?.ToString(" yyyy-MM-dd")" />
    </div>
    <div class="col-auto">
        <input type="text" name="appraisalCycle" class="form-control form-control-sm" placeholder="Appraisal Cycle" value="@ViewBag.AppraisalCycleFilter" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>ERPNext Ref</th>
            <th>Goal Name</th>
            <th>Status</th>
            <th>Employee</th>
            <th>Progress (%)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var g in Model)
        {
            <tr style="cursor:pointer" onclick="window.location='@Url.Action("GoalDetails", "HR", new { id = g.Id })'">
                <td><strong>@g.Id</strong></td>
                <td>
                    @if (!string.IsNullOrEmpty(g.ErpNextId))
                    {
                        <span class="badge bg-success-subtle text-success">@g.ErpNextId</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-muted">Not Synced</span>
                    }
                </td>
                <td>@g.GoalName</td>
                <td>@g.Status</td>
                <td>@g.Employee</td>
                <td>@(g.Progress.HasValue? g.Progress.Value.ToString("0.##") + "%" : "-")</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted text-center py-5">No goals found.</p>
}
