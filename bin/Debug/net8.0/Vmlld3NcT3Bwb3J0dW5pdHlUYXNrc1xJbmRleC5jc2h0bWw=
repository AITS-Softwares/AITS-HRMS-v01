@functions {
    public string GetColor(string name)
    {
        if (string.IsNullOrEmpty(name)) return "#4f46e5";
        var colors = new[] { "#4f46e5", "#7c3aed", "#2563eb", "#0891b2", "#059669", "#d97706", "#dc2626", "#6b7280" };
        var index = Math.Abs(name.GetHashCode()) % colors.Length;
        return colors[index];
    }
}

@section Scripts {
    <script>
        var opportunityId = @(opportunityId ?? 0);
        var users = @Html.Raw(Json.Serialize(ViewBag.UserList));

        $(document).ready(function() {
            if (opportunityId > 0) {
                loadTasks();
                // Set default date for create form
                var now = new Date();
                var formattedDate = now.toISOString().slice(0, 16);
                $('#createTaskDate').val(formattedDate);
            }
        });

        // ============================================================
        // LOAD TASKS
        // ============================================================
        function loadTasks() {
            var status = $('#filterStatus').val();
            var priority = $('#filterPriority').val();
            var search = $('#searchTask').val();

            $.ajax({
                url: '@Url.Action("GetOpportunityTasks", "OpportunityTasks")',
                type: 'GET',
                data: {
                    opportunityId: opportunityId,
                    status: status,
                    priority: priority,
                    search: search
                },
                success: function(data) {
                    var html = '';
                    var total = 0;

                    if (data && data.length > 0) {
                        total = data.length;
                        $('#taskCount').text(total);

                        $.each(data, function(i, task) {
                            var statusClass = task.status ? task.status.toLowerCase().replace(' ', '') : 'pending';
                            var priorityClass = task.priority ? task.priority.toLowerCase() : 'medium';

                            html += '<div class="task-card">';
                            html += '<div class="task-info">';
                            html += '<div class="task-title">' + task.summary + '</div>';
                            html += '<div class="task-meta">';
                            html += '<span><i class="fas fa-user"></i> ' + (task.assignedTo || 'Unassigned') + '</span>';
                            html += '<span><i class="fas fa-calendar"></i> ' + task.taskDate + '</span>';
                            html += '<span><span class="status-badge ' + statusClass + '">' + task.status + '</span></span>';
                            if (task.priority) {
                                html += '<span><span class="priority-badge ' + priorityClass + '">' + task.priority + '</span></span>';
                            }
                            if (task.attachmentPath) {
                                html += '<span><a href="' + task.attachmentPath + '" target="_blank" class="text-primary"><i class="fas fa-paperclip"></i> Attachment</a></span>';
                            }
                            html += '</div>';
                            html += '</div>';
                            html += '<div class="task-actions">';
                            html += '<button class="btn btn-warning btn-sm" onclick="openEditTaskModal(' + task.id + ')"><i class="fas fa-edit"></i></button>';
                            html += '<button class="btn btn-danger btn-sm" onclick="openDeleteTaskModal(' + task.id + ')"><i class="fas fa-trash"></i></button>';
                            html += '</div>';
                            html += '</div>';
                        });

                        $('#tasksList').html(html);
                    } else {
                        $('#taskCount').text(0);
                        $('#tasksList').html('<div class="text-center text-muted py-5"><i class="fas fa-inbox fa-3x d-block mb-3"></i><p>No tasks found for this opportunity.</p></div>');
                    }
                },
                error: function() {
                    $('#tasksList').html('<div class="text-center text-muted py-5"><i class="fas fa-exclamation-triangle fa-3x d-block mb-3"></i><p>Error loading tasks. Please try again.</p></div>');
                }
            });
        }

        function resetFilters() {
            $('#filterStatus').val('');
            $('#filterPriority').val('');
            $('#searchTask').val('');
            loadTasks();
        }

        // ============================================================
        // CREATE TASK
        // ============================================================
        function openCreateTaskModal() {
            if (opportunityId == 0 || opportunityId == null) {
                alert('Please select an opportunity first.');
                return;
            }
            $('#createTaskModal').modal('show');
        }

        function submitCreateTask() {
            var formData = {
                OpportunityId: opportunityId,
                AssignedTo: parseInt($('#createAssignedTo').val()) || null,
                TaskDate: $('#createTaskDate').val(),
                Summary: $('#createSummary').val(),
                Status: $('#createStatus').val(),
                Priority: $('#createPriority').val()
            };

            if (!formData.Summary) {
                alert('Summary is required.');
                return;
            }

            if (!formData.AssignedTo) {
                alert('Please select a user to assign this task.');
                return;
            }

            $.ajax({
                url: '@Url.Action("Create", "OpportunityTasks")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function(response) {
                    if (response.success) {
                        $('#createTaskModal').modal('hide');
                        $('#createSummary').val('');
                        loadTasks();
                        showSuccess('Task created successfully!');
                    } else {
                        alert(response.message || 'Error creating task.');
                    }
                },
                error: function() {
                    alert('Error creating task. Please try again.');
                }
            });
        }

        // ============================================================
        // EDIT TASK
        // ============================================================
        function openEditTaskModal(id) {
            $.ajax({
                url: '@Url.Action("GetTask", "OpportunityTasks")',
                type: 'GET',
                data: { id: id },
                success: function(response) {
                    if (response.success) {
                        var task = response.task;
                        $('#editTaskId').val(task.id);
                        $('#editOpportunityId').val(task.opportunityId);
                        $('#editTaskDate').val(task.taskDate);
                        $('#editSummary').val(task.summary);
                        $('#editAssignedTo').val(task.assignedTo);
                        $('#editStatus').val(task.status);
                        $('#editPriority').val(task.priority);
                        $('#editTaskModal').modal('show');
                    } else {
                        alert(response.message || 'Error loading task.');
                    }
                },
                error: function() {
                    alert('Error loading task. Please try again.');
                }
            });
        }

        function submitEditTask() {
            var formData = {
                Id: parseInt($('#editTaskId').val()),
                OpportunityId: parseInt($('#editOpportunityId').val()) || null,
                AssignedTo: parseInt($('#editAssignedTo').val()) || null,
                TaskDate: $('#editTaskDate').val(),
                Summary: $('#editSummary').val(),
                Status: $('#editStatus').val(),
                Priority: $('#editPriority').val()
            };

            if (!formData.Summary) {
                alert('Summary is required.');
                return;
            }

            if (!formData.AssignedTo) {
                alert('Please select a user to assign this task.');
                return;
            }

            $.ajax({
                url: '@Url.Action("Update", "OpportunityTasks")',
                type: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function(response) {
                    if (response.success) {
                        $('#editTaskModal').modal('hide');
                        loadTasks();
                        showSuccess('Task updated successfully!');
                    } else {
                        alert(response.message || 'Error updating task.');
                    }
                },
                error: function() {
                    alert('Error updating task. Please try again.');
                }
            });
        }

        // ============================================================
        // DELETE TASK
        // ============================================================
        function openDeleteTaskModal(id) {
            $('#deleteTaskId').val(id);
            $('#deleteTaskModal').modal('show');
        }

        function confirmDeleteTask() {
            var id = $('#deleteTaskId').val();

            $.ajax({
                url: '@Url.Action("Delete", "OpportunityTasks")',
                type: 'DELETE',
                data: { id: id },
                success: function(response) {
                    if (response.success) {
                        $('#deleteTaskModal').modal('hide');
                        loadTasks();
                        showSuccess('Task deleted successfully!');
                    } else {
                        alert(response.message || 'Error deleting task.');
                    }
                },
                error: function() {
                    alert('Error deleting task. Please try again.');
                }
            });
        }

        // ============================================================
        // SHOW SUCCESS MESSAGE
        // ============================================================
        function showSuccess(message) {
            var alertDiv = $('<div class="alert alert-success alert-dismissible fade show">' +
                '<i class="fas fa-check-circle"></i> ' + message +
                '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                '</div>');
            $('.card-header-custom').after(alertDiv);
            setTimeout(function() {
                alertDiv.fadeOut('slow', function() {
                    $(this).remove();
                });
            }, 5000);
        }

        // Make functions globally accessible
        window.loadTasks = loadTasks;
        window.resetFilters = resetFilters;
        window.openCreateTaskModal = openCreateTaskModal;
        window.submitCreateTask = submitCreateTask;
        window.openEditTaskModal = openEditTaskModal;
        window.submitEditTask = submitEditTask;
        window.openDeleteTaskModal = openDeleteTaskModal;
        window.confirmDeleteTask = confirmDeleteTask;
    </script>
} *@


@using Microsoft.Extensions.Configuration
@using Microsoft.Data.SqlClient
@using System.Collections.Generic
@using System.Data
@inject IConfiguration _configuration

@{
    ViewData["Title"] = "Opportunity Tasks";
    ViewData["Module"] = "Tasks";
    ViewData["Icon"] = "tasks";
    var opportunityId = ViewBag.OpportunityId as int?;
    var opportunityName = ViewBag.OpportunityName as string;
    var loginType = Context.Session.GetString("LoginType") ?? "User";
    var userRole = Context.Session.GetString("UserRole") ?? "User";
    var userId = Context.Session.GetString("UserId");
    var isFullAccess = loginType == "Company" || userRole == "Admin";

    // Check specific page access from database
    var canCreateTask = false;
    var canEditTask = false;
    var canDeleteTask = false;

    if (!string.IsNullOrEmpty(userId))
    {
        try
        {
            var connectionString = _configuration.GetConnectionString("DefaultConnection");
            using (var conn = new SqlConnection(connectionString))
            {
                conn.Open();

                // Check Task Create access (PermissionId 36)
                string query = @"
                    SELECT CASE
                        WHEN EXISTS (
                            SELECT 1 FROM UserPermissions
                            WHERE UserId = @UserId
                            AND PermissionId = 36
                            AND CanCreate = 1
                        ) THEN 1
                        WHEN EXISTS (
                            SELECT 1 FROM RolePermissions rp
                            INNER JOIN Users u ON u.Role = rp.RoleName
                            WHERE u.Id = @UserId
                            AND rp.PermissionId = 36
                            AND rp.CanCreate = 1
                        ) THEN 1
                        ELSE 0
                    END AS HasAccess";

                using (var cmd = new SqlCommand(query, conn))
                {
                    cmd.Parameters.AddWithValue("@UserId", int.Parse(userId));
                    var result = cmd.ExecuteScalar();
                    canCreateTask = result != null && Convert.ToInt32(result) == 1;
                }

                // Check Task Edit access (PermissionId 37)
                query = @"
                    SELECT CASE
                        WHEN EXISTS (
                            SELECT 1 FROM UserPermissions
                            WHERE UserId = @UserId
                            AND PermissionId = 37
                            AND CanEdit = 1
                        ) THEN 1
                        WHEN EXISTS (
                            SELECT 1 FROM RolePermissions rp
                            INNER JOIN Users u ON u.Role = rp.RoleName
                            WHERE u.Id = @UserId
                            AND rp.PermissionId = 37
                            AND rp.CanEdit = 1
                        ) THEN 1
                        ELSE 0
                    END AS HasAccess";

                using (var cmd = new SqlCommand(query, conn))
                {
                    cmd.Parameters.AddWithValue("@UserId", int.Parse(userId));
                    var result = cmd.ExecuteScalar();
                    canEditTask = result != null && Convert.ToInt32(result) == 1;
                }

                // Check Task Delete access (PermissionId 38)
                query = @"
                    SELECT CASE
                        WHEN EXISTS (
                            SELECT 1 FROM UserPermissions
                            WHERE UserId = @UserId
                            AND PermissionId = 38
                            AND CanDelete = 1
                        ) THEN 1
                        WHEN EXISTS (
                            SELECT 1 FROM RolePermissions rp
                            INNER JOIN Users u ON u.Role = rp.RoleName
                            WHERE u.Id = @UserId
                            AND rp.PermissionId = 38
                            AND rp.CanDelete = 1
                        ) THEN 1
                        ELSE 0
                    END AS HasAccess";

                using (var cmd = new SqlCommand(query, conn))
                {
                    cmd.Parameters.AddWithValue("@UserId", int.Parse(userId));
                    var result = cmd.ExecuteScalar();
                    canDeleteTask = result != null && Convert.ToInt32(result) == 1;
                }
            }
        }
        catch (Exception ex)
        {
            // Fallback to role-based access
            canCreateTask = isFullAccess || userRole == "Manager" || userRole == "User";
            canEditTask = isFullAccess || userRole == "Manager" || userRole == "User";
            canDeleteTask = isFullAccess;
        }
    }
    else
    {
        canCreateTask = isFullAccess || userRole == "Manager" || userRole == "User";
        canEditTask = isFullAccess || userRole == "Manager" || userRole == "User";
        canDeleteTask = isFullAccess;
    }
}


