@model Erp_Aits.Models.Department

@{
    ViewBag.Title = "Department Details";
    bool isEdit = ViewBag.IsEdit == true;
}

<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    body {
        background: radial-gradient(circle at top left, #f0fdfa 0%, #eef2f3 45%, #f4f7f6 100%);
        font-family: 'Inter', sans-serif;
    }

    .dept-wrapper {
        max-width: 1100px;
        margin: 0 auto;
        padding: 28px 16px 60px;
    }

    .dept-accent-bar {
        height: 5px;
        width: 100%;
        border-radius: 6px;
        background: linear-gradient(90deg, #0f766e 0%, #14b8a6 45%, #f59e0b 100%);
        margin-bottom: 22px;
    }

    .dept-panel {
        border-radius: 14px;
        box-shadow: 0 10px 30px rgba(20, 40, 40, 0.08);
        overflow: hidden;
        margin-bottom: 26px;
        background: #ffffff;
    }

    .dept-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 22px 28px;
        background: linear-gradient(120deg, #0f766e 0%, #0d9488 55%, #14b8a6 100%);
    }

        .dept-page-header h4 {
            font-family: 'Manrope', sans-serif;
            color: #ffffff;
            font-weight: 800;
            margin: 0;
            font-size: 24px;
        }

    .dept-eyebrow {
        color: rgba(255,255,255,0.75);
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .dept-card {
        background: #ffffff;
        padding: 30px;
        border-bottom: 1px solid #e6f5f3;
    }

        .dept-card h5 {
            font-family: 'Manrope', sans-serif;
            font-weight: 800;
            color: #111827;
            margin: 0;
        }

    .form-label {
        font-weight: 600;
        color: #111827;
        margin-bottom: 7px;
    }

    .form-control {
        border: 1px solid #d1d5db;
        border-radius: 6px;
        min-height: 39px;
        font-size: 14px;
    }

        .form-control:focus {
            border-color: #14b8a6;
            box-shadow: 0 0 0 0.15rem rgba(20,184,166,0.18);
        }

        .form-control[readonly] {
            background-color: #f9fafb;
            color: #111827;
        }

    .form-check-label {
        color: #374151;
        font-weight: 500;
    }

    .table {
        border: 1px solid #d9ece9;
        background: #ffffff;
    }

        .table thead th {
            background-color: #e6f8f5;
            color: #0f766e;
            font-weight: 700;
            font-size: 12px;
        }

    .btn-save {
        background: #ffffff;
        color: #0f766e;
        border: none;
        font-weight: 700;
        padding: 10px 26px;
        border-radius: 9px;
        cursor: pointer;
    }

        .btn-save:hover {
            background: #f59e0b;
            color: #ffffff;
        }

    .btn-back {
        background: rgba(255,255,255,0.18);
        color: #ffffff;
        border: 1px solid rgba(255,255,255,0.45);
        font-weight: 700;
        padding: 10px 18px;
        border-radius: 9px;
        text-decoration: none;
    }

        .btn-back:hover {
            background: #ffffff;
            color: #0f766e;
        }

    .btn-edit {
        background: #ffffff;
        color: #0f766e;
        border: none;
        font-weight: 700;
        padding: 10px 24px;
        border-radius: 9px;
        text-decoration: none;
    }

        .btn-edit:hover {
            background: #f59e0b;
            color: #ffffff;
        }

    .btn-delete {
        background: #dc3545;
        color: #ffffff;
        border: none;
        font-weight: 700;
        padding: 10px 22px;
        border-radius: 9px;
    }

        .btn-delete:hover {
            background: #bb2d3b;
            color: #ffffff;
        }

    .dept-actions {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .alert {
        border-radius: 10px;
        margin-bottom: 18px;
    }
</style>

<div class="dept-wrapper">
    <div class="dept-accent-bar"></div>

    <datalist id="companyList">
        @if (ViewBag.Companies != null)
        {
            foreach (var item in ViewBag.Companies)
            {
                string name = item.name?.ToString();
                string companyName = item.company_name?.ToString();
                <option value="@name">@companyName</option>
            }
        }
    </datalist>

    <datalist id="parentDepartmentList">
        @if (ViewBag.Departments != null)
        {
            foreach (var item in ViewBag.Departments)
            {
                string name = item.name?.ToString();
                string label = item.department_name?.ToString();
                <option value="@name">@label</option>
            }
        }
    </datalist>

    <datalist id="costCenterList">
        @if (ViewBag.CostCenters != null)
        {
            foreach (var item in ViewBag.CostCenters)
            {
                string name = item.name?.ToString();
                <option value="@name"></option>
            }
        }
    </datalist>

    <datalist id="leaveBlockList">
        @if (ViewBag.LeaveBlockLists != null)
        {
            foreach (var item in ViewBag.LeaveBlockLists)
            {
                string name = item.name?.ToString();
                <option value="@name"></option>
            }
        }
    </datalist>

    <datalist id="approverList">
        @if (ViewBag.Approvers != null)
        {
            foreach (var app in ViewBag.Approvers)
            {
                string name = app.name?.ToString();
                string fullName = app.full_name?.ToString();
                <option value="@name">@fullName (@name)</option>
            }
        }
    </datalist>

    @if (TempData["ErpNextError"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["ErpNextError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="dept-panel">
        <div class="dept-page-header">
            <div>
                <div class="dept-eyebrow">HR &middot; Organization Setup</div>
                <h4>Department Details</h4>
            </div>

            <div class="dept-actions">
                <a href="@Url.Action("Department", "HR")" class="btn-back">Back</a>

                @if (isEdit)
                {
                    <button type="submit" form="departmentUpdateForm" class="btn-save">Save Department</button>
                }
                else
                {
                    <a href="@Url.Action("DepartmentDetails", "HR", new { id = Model.Id, edit = true })" class="btn-edit">Edit</a>

                    <form asp-action="DeleteDepartment"
                          asp-controller="HR"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="d-inline"
                          onsubmit="return confirm('Are you sure you want to delete this Department from ERPNext and HRMS?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-delete">Delete</button>
                    </form>
                }
            </div>
        </div>

        <form id="departmentUpdateForm"
              asp-action="UpdateDepartment"
              asp-controller="HR"
              asp-route-id="@Model.Id"
              method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="DepartmentCode" />

            <div class="dept-card">
                <h5>Department Details</h5>
                <hr />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Department <span class="text-danger">*</span></label>
                        <input asp-for="DepartmentName"
                               class="form-control"
                               readonly="@(!isEdit)"
                               required
                               placeholder="Type department name..." />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Company <span class="text-danger">*</span></label>
                        <input asp-for="Company"
                               class="form-control"
                               list="companyList"
                               readonly="@(!isEdit)"
                               required
                               placeholder="Select or type company..." />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Parent Department</label>
                        <input asp-for="ParentDepartment"
                               class="form-control"
                               list="parentDepartmentList"
                               readonly="@(!isEdit)"
                               placeholder="Select or type parent department..." />
                    </div>

                    <div class="col-md-6 mt-4">
                        <div class="form-check">
                            <input asp-for="IsGroup"
                                   class="form-check-input"
                                   type="checkbox"
                                   disabled="@(!isEdit)" />
                            <label class="form-check-label">Is Group</label>
                        </div>

                        <div class="form-check">
                            <input asp-for="Disabled"
                                   class="form-check-input"
                                   type="checkbox"
                                   disabled="@(!isEdit)" />
                            <label class="form-check-label">Disabled</label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Payroll Cost Center</label>
                        <input asp-for="PayrollCostCenter"
                               class="form-control"
                               list="costCenterList"
                               readonly="@(!isEdit)"
                               placeholder="Select cost center..." />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Leave Block List</label>
                        <input asp-for="LeaveBlockList"
                               class="form-control"
                               list="leaveBlockList"
                               readonly="@(!isEdit)"
                               placeholder="Select leave block list..." />
                        <small class="text-muted">Days for which Holidays are blocked for this department.</small>
                    </div>

                    @* <div class="col-md-6">
                        <label class="form-label">ERPNext Ref</label>
                        <input asp-for="DepartmentCode"
                               class="form-control"
                               readonly />
                    </div> *@

                    <div class="col-md-6">
                        <label class="form-label">Status</label>
                        <input value="@Model.Status"
                               class="form-control"
                               readonly />
                    </div>
                </div>
            </div>

            <div class="dept-card">
                <h5>Approvers</h5>
                <small class="text-muted mb-3 d-block">
                    The first Approver in the list will be set as the default Approver.
                </small>

                <div class="mb-4">
                    <label class="form-label fw-bold">Shift Request Approver</label>
                    <table class="table table-bordered align-middle">
                        <thead>
                            <tr>
                                <th style="width:40px"><input type="checkbox" disabled /></th>
                                <th style="width:60px">No.</th>
                                <th>Approver <span class="text-danger">*</span></th>
                            </tr>
                        </thead>
                        <tbody id="shiftTableBody">
                            @if (Model.ShiftRequestApprovers != null && Model.ShiftRequestApprovers.Any())
                            {
                                for (int i = 0; i < Model.ShiftRequestApprovers.Count; i++)
                                {
                                    <tr>
                                        <td><input type="checkbox" disabled /></td>
                                        <td>@(i + 1)</td>
                                        <td>
                                            <input type="text"
                                                   name="ShiftApprovers"
                                                   class="form-control"
                                                   list="approverList"
                                                   value="@Model.ShiftRequestApprovers[i].Approver"
                                                   readonly="@(!isEdit)" />
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>

                    @if (isEdit)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addApproverRow('shiftTableBody', 'ShiftApprovers')">+ Add Row</button>
                    }
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Leave Approver</label>
                    <table class="table table-bordered align-middle">
                        <thead>
                            <tr>
                                <th style="width:40px"><input type="checkbox" disabled /></th>
                                <th style="width:60px">No.</th>
                                <th>Approver <span class="text-danger">*</span></th>
                            </tr>
                        </thead>
                        <tbody id="leaveTableBody">
                            @if (Model.LeaveApprovers != null && Model.LeaveApprovers.Any())
                            {
                                for (int i = 0; i < Model.LeaveApprovers.Count; i++)
                                {
                                    <tr>
                                        <td><input type="checkbox" disabled /></td>
                                        <td>@(i + 1)</td>
                                        <td>
                                            <input type="text"
                                                   name="LeaveApprovers"
                                                   class="form-control"
                                                   list="approverList"
                                                   value="@Model.LeaveApprovers[i].Approver"
                                                   readonly="@(!isEdit)" />
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>

                    @if (isEdit)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addApproverRow('leaveTableBody', 'LeaveApprovers')">+ Add Row</button>
                    }
                </div>

                <div>
                    <label class="form-label fw-bold">Expense Approver</label>
                    <table class="table table-bordered align-middle">
                        <thead>
                            <tr>
                                <th style="width:40px"><input type="checkbox" disabled /></th>
                                <th style="width:60px">No.</th>
                                <th>Approver <span class="text-danger">*</span></th>
                            </tr>
                        </thead>
                        <tbody id="expenseTableBody">
                            @if (Model.ExpenseApprovers != null && Model.ExpenseApprovers.Any())
                            {
                                for (int i = 0; i < Model.ExpenseApprovers.Count; i++)
                                {
                                    <tr>
                                        <td><input type="checkbox" disabled /></td>
                                        <td>@(i + 1)</td>
                                        <td>
                                            <input type="text"
                                                   name="ExpenseApprovers"
                                                   class="form-control"
                                                   list="approverList"
                                                   value="@Model.ExpenseApprovers[i].Approver"
                                                   readonly="@(!isEdit)" />
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>

                    @if (isEdit)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addApproverRow('expenseTableBody', 'ExpenseApprovers')">+ Add Row</button>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

@if (isEdit)
{
    <script>
        function addApproverRow(tbodyId, inputName) {
            const tbody = document.getElementById(tbodyId);
            const rowNo = tbody.rows.length + 1;

            const row = document.createElement("tr");
            row.innerHTML =
                '<td><input type="checkbox" disabled /></td>' +
                '<td>' + rowNo + '</td>' +
                '<td><input type="text" name="' + inputName + '" class="form-control" list="approverList" /></td>';

            tbody.appendChild(row);
        }
    </script>
}