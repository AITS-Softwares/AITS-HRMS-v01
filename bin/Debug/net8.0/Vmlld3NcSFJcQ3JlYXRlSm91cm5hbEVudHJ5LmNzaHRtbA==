@model Erp_Aits.Models.JournalEntry

@{
    ViewBag.Title = "New Journal Entry";

    var entryTypes = new[] {
        "Journal Entry", "Inter Company Journal Entry", "Bank Entry", "Cash Entry",
        "Credit Card Entry", "Debit Note", "Credit Note", "Contra Entry", "Excise Entry",
        "Write Off Entry", "Opening Entry", "Depreciation Entry", "Exchange Rate Revaluation",
        "Exchange Gain Or Loss", "Deferred Revenue"
    };

    var partyTypes = new[] {
        "", "Customer", "Supplier", "Employee", "Shareholder"
    };
}

<form asp-action="CreateJournalEntry" method="post">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0 d-inline">New Journal Entry</h4>
            <span class="badge bg-danger-subtle text-danger ms-2">Not Saved</span>
        </div>

        <button type="submit" class="btn btn-dark btn-sm">Save</button>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label">Entry Type <span class="text-danger">*</span></label>
            <select asp-for="EntryType" class="form-select" required>
                @foreach (var et in entryTypes)
                {
                    <option value="@et" selected="@(Model.EntryType == et)">@et</option>
                }
            </select>
        </div>

        <div class="col-md-6">
            <label class="form-label">From Template</label>
            <div class="erp-link-wrapper">
                <input asp-for="FromTemplate"
                       class="form-control"
                       placeholder="Select template"
                       autocomplete="off"
                       oninput="loadJournalLinkDropdown(this, 'Journal Entry Template')"
                       onfocus="loadJournalLinkDropdown(this, 'Journal Entry Template')" />
                <div class="erp-link-dropdown d-none"></div>
            </div>
        </div>

        <div class="col-md-6">
            <label class="form-label">Series <span class="text-danger">*</span></label>
            <input asp-for="Series" class="form-control" required />
        </div>

        <div class="col-md-6">
            <label class="form-label">Company <span class="text-danger">*</span></label>
            <div class="erp-link-wrapper">
                <input asp-for="Company"
                       id="Company"
                       class="form-control"
                       required
                       placeholder="Select company"
                       autocomplete="off"
                       oninput="loadJournalLinkDropdown(this, 'Company')"
                       onfocus="loadJournalLinkDropdown(this, 'Company')" />
                <div class="erp-link-dropdown d-none"></div>
            </div>

            <label class="form-label mt-3">Company GSTIN</label>
            <div class="erp-link-wrapper">
                <input asp-for="CompanyGstin"
                       id="CompanyGstin"
                       class="form-control"
                       placeholder="Select Company GSTIN"
                       autocomplete="off"
                       oninput="loadJournalLinkDropdown(this, 'Company GSTIN')"
                       onfocus="loadJournalLinkDropdown(this, 'Company GSTIN')" />
                <div class="erp-link-dropdown d-none"></div>
            </div>
        </div>

        <div class="col-md-6"></div>

        <div class="col-md-6">
            <label class="form-label">Posting Date <span class="text-danger">*</span></label>
            <input asp-for="PostingDate"
                   type="date"
                   class="form-control"
                   required
                   value="@Model.PostingDate.ToString("yyyy-MM-dd")" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Title</label>
            <input asp-for="Title" class="form-control" />
        </div>
    </div>

    <hr />

    <h6 class="mb-3">Accounting Entries</h6>

    <table class="table table-bordered align-middle mb-1" id="accountsTable">
        <thead>
            <tr>
                <th style="width:40px"><input type="checkbox" disabled /></th>
                <th style="width:50px">No.</th>
                <th>Account <span class="text-danger">*</span></th>
                <th>Party Type</th>
                <th>Party</th>
                <th>Mode of Payment</th>
                <th class="text-end">Debit</th>
                <th class="text-end">Credit</th>
            </tr>
        </thead>

        <tbody>
            <tr>
                <td><input type="checkbox" /></td>
                <td class="row-number">1</td>

                <td>
                    <div class="erp-link-wrapper">
                        <input type="text"
                               name="Accounts"
                               class="form-control form-control-sm border-0"
                               placeholder="Select account"
                               autocomplete="off"
                               oninput="loadJournalLinkDropdown(this, 'Account')"
                               onfocus="loadJournalLinkDropdown(this, 'Account')" />
                        <div class="erp-link-dropdown d-none"></div>
                    </div>
                </td>

                <td>
                    <select name="PartyTypes"
                            class="form-select form-select-sm border-0"
                            onchange="clearParty(this)">
                        @foreach (var pt in partyTypes)
                        {
                            <option value="@pt">@pt</option>
                        }
                    </select>
                </td>

                <td>
                    <div class="erp-link-wrapper">
                        <input type="text"
                               name="Parties"
                               class="form-control form-control-sm border-0"
                               placeholder="Select party"
                               autocomplete="off"
                               oninput="loadPartyDropdown(this)"
                               onfocus="loadPartyDropdown(this)" />
                        <div class="erp-link-dropdown d-none"></div>
                    </div>
                </td>

                <td>
                    <div class="erp-link-wrapper">
                        <input type="text"
                               name="ModeOfPayments"
                               class="form-control form-control-sm border-0"
                               placeholder="Select mode"
                               autocomplete="off"
                               oninput="loadJournalLinkDropdown(this, 'Mode of Payment')"
                               onfocus="loadJournalLinkDropdown(this, 'Mode of Payment')" />
                        <div class="erp-link-dropdown d-none"></div>
                    </div>
                </td>

                <td>
                    <input type="number"
                           step="0.01"
                           name="Debits"
                           class="form-control form-control-sm border-0 text-end debit-input"
                           value="0.00"
                           oninput="calculateJournalTotals()" />
                </td>

                <td>
                    <input type="number"
                           step="0.01"
                           name="Credits"
                           class="form-control form-control-sm border-0 text-end credit-input"
                           value="0.00"
                           oninput="calculateJournalTotals()" />
                </td>
            </tr>
        </tbody>
    </table>

    <div class="mb-4">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addAccountRow()">Add Row</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addAccountRow(); addAccountRow();">Add Multiple</button>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <label class="form-label">Reference Number</label>
            <input asp-for="ReferenceNumber" class="form-control" />

            <label class="form-label mt-3">Reference Date</label>
            <input asp-for="ReferenceDate" type="date" class="form-control" />

            <label class="form-label mt-3">User Remark</label>
            <textarea asp-for="UserRemark" class="form-control" rows="5"></textarea>
        </div>

        <div class="col-md-6">
            <label class="form-label">Total Debit</label>
            <input asp-for="TotalDebit"
                   id="TotalDebit"
                   class="form-control text-end"
                   value="0.00"
                   readonly />

            <label class="form-label mt-3">Total Credit</label>
            <input asp-for="TotalCredit"
                   id="TotalCredit"
                   class="form-control text-end"
                   value="0.00"
                   readonly />

            <label class="form-label mt-3">Difference (Dr - Cr)</label>
            <input asp-for="DifferenceAmount"
                   id="DifferenceAmount"
                   class="form-control text-end"
                   value="0.00"
                   readonly />

            <button type="button"
                    class="btn btn-sm btn-outline-secondary mt-3"
                    onclick="makeDifferenceEntry()">
                Make Difference Entry
            </button>

            <div class="form-check mt-3">
                <input asp-for="MultiCurrency" class="form-check-input" type="checkbox" />
                <label class="form-check-label" asp-for="MultiCurrency">Multi Currency</label>
            </div>
        </div>
    </div>

    <hr />

    <h6 class="mb-3">Reference</h6>

    <div class="row g-3 mb-4">
        <div class="col-md-6"></div>

        <div class="col-md-6">
            <label class="form-label">Bill No</label>
            <input asp-for="BillNo" class="form-control" />

            <label class="form-label mt-3">Bill Date</label>
            <input asp-for="BillDate" type="date" class="form-control" />

            <label class="form-label mt-3">Due Date</label>
            <input asp-for="DueDate" type="date" class="form-control" />
        </div>
    </div>

    <hr />

    <h6 class="mb-3">Printing Settings</h6>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <label class="form-label">Pay To / Recd From</label>
            <input asp-for="PayToRecdFrom" class="form-control" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Letter Head</label>
            <input asp-for="LetterHead" class="form-control" />

            <label class="form-label mt-3">Print Heading</label>
            <div class="erp-link-wrapper">
                <input asp-for="PrintHeading"
                       class="form-control"
                       placeholder="Select Print Heading"
                       autocomplete="off"
                       oninput="loadJournalLinkDropdown(this, 'Print Heading')"
                       onfocus="loadJournalLinkDropdown(this, 'Print Heading')" />
                <div class="erp-link-dropdown d-none"></div>
            </div>
        </div>
    </div>

    <hr />

    <h6 class="mb-3">More Information</h6>

    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Mode of Payment</label>
            <div class="erp-link-wrapper">
                <input asp-for="ModeOfPayment"
                       class="form-control"
                       placeholder="Select mode"
                       autocomplete="off"
                       oninput="loadJournalLinkDropdown(this, 'Mode of Payment')"
                       onfocus="loadJournalLinkDropdown(this, 'Mode of Payment')" />
                <div class="erp-link-dropdown d-none"></div>
            </div>
        </div>

        <div class="col-md-6">
            <label class="form-label">Is Opening</label>
            <select asp-for="IsOpening" class="form-select">
                <option value="No">No</option>
                <option value="Yes">Yes</option>
            </select>
        </div>
    </div>
</form>

<style>
    .erp-link-wrapper {
        position: relative;
    }

    .erp-link-dropdown {
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        z-index: 9999;
        background: #fff;
        border: 1px solid #d8dce0;
        border-radius: 8px;
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
        max-height: 260px;
        overflow-y: auto;
        padding: 6px;
    }

    .erp-link-option {
        display: block;
        width: 100%;
        border: 0;
        background: transparent;
        text-align: left;
        padding: 8px 10px;
        border-radius: 6px;
        font-size: 14px;
    }

        .erp-link-option:hover {
            background: #f1f5f9;
        }

    #accountsTable td {
        vertical-align: middle;
    }

    #accountsTable input,
    #accountsTable select {
        min-width: 130px;
    }
</style>

<script>
    let journalLinkTimer = null;

    async function fetchJsonSafe(url) {
        try {
            const response = await fetch(url, {
                headers: {
                    'Accept': 'application/json'
                }
            });

            if (!response.ok) {
                return [];
            }

            const text = await response.text();

            if (!text || !text.trim()) {
                return [];
            }

            return JSON.parse(text);
        } catch (e) {
            return [];
        }
    }

    function addAccountRow() {
        const tbody = document.querySelector('#accountsTable tbody');
        const rowNum = tbody.rows.length + 1;

        const row = document.createElement('tr');

        row.innerHTML = `
            <td><input type="checkbox" /></td>
            <td class="row-number">${rowNum}</td>

            <td>
                <div class="erp-link-wrapper">
                    <input type="text"
                           name="Accounts"
                           class="form-control form-control-sm border-0"
                           placeholder="Select account"
                           autocomplete="off"
                           oninput="loadJournalLinkDropdown(this, 'Account')"
                           onfocus="loadJournalLinkDropdown(this, 'Account')" />
                    <div class="erp-link-dropdown d-none"></div>
                </div>
            </td>

            <td>
                <select name="PartyTypes"
                        class="form-select form-select-sm border-0"
                        onchange="clearParty(this)">
                    <option value=""></option>
                    <option value="Customer">Customer</option>
                    <option value="Supplier">Supplier</option>
                    <option value="Employee">Employee</option>
                    <option value="Shareholder">Shareholder</option>
                </select>
            </td>

            <td>
                <div class="erp-link-wrapper">
                    <input type="text"
                           name="Parties"
                           class="form-control form-control-sm border-0"
                           placeholder="Select party"
                           autocomplete="off"
                           oninput="loadPartyDropdown(this)"
                           onfocus="loadPartyDropdown(this)" />
                    <div class="erp-link-dropdown d-none"></div>
                </div>
            </td>

            <td>
                <div class="erp-link-wrapper">
                    <input type="text"
                           name="ModeOfPayments"
                           class="form-control form-control-sm border-0"
                           placeholder="Select mode"
                           autocomplete="off"
                           oninput="loadJournalLinkDropdown(this, 'Mode of Payment')"
                           onfocus="loadJournalLinkDropdown(this, 'Mode of Payment')" />
                    <div class="erp-link-dropdown d-none"></div>
                </div>
            </td>

            <td>
                <input type="number"
                       step="0.01"
                       name="Debits"
                       class="form-control form-control-sm border-0 text-end debit-input"
                       value="0.00"
                       oninput="calculateJournalTotals()" />
            </td>

            <td>
                <input type="number"
                       step="0.01"
                       name="Credits"
                       class="form-control form-control-sm border-0 text-end credit-input"
                       value="0.00"
                       oninput="calculateJournalTotals()" />
            </td>`;

        tbody.appendChild(row);
        calculateJournalTotals();
    }

    function calculateJournalTotals() {
        let totalDebit = 0;
        let totalCredit = 0;

        document.querySelectorAll('.debit-input').forEach(input => {
            totalDebit += parseFloat(input.value || 0) || 0;
        });

        document.querySelectorAll('.credit-input').forEach(input => {
            totalCredit += parseFloat(input.value || 0) || 0;
        });

        document.getElementById('TotalDebit').value = totalDebit.toFixed(2);
        document.getElementById('TotalCredit').value = totalCredit.toFixed(2);
        document.getElementById('DifferenceAmount').value = (totalDebit - totalCredit).toFixed(2);
    }

    function makeDifferenceEntry() {
        const difference = parseFloat(document.getElementById('DifferenceAmount').value || 0) || 0;

        if (difference === 0) {
            return;
        }

        addAccountRow();

        const rows = document.querySelectorAll('#accountsTable tbody tr');
        const row = rows[rows.length - 1];

        const debitInput = row.querySelector('.debit-input');
        const creditInput = row.querySelector('.credit-input');

        if (difference > 0) {
            creditInput.value = Math.abs(difference).toFixed(2);
        } else {
            debitInput.value = Math.abs(difference).toFixed(2);
        }

        calculateJournalTotals();
    }

    function clearParty(select) {
        const row = select.closest('tr');
        const partyInput = row.querySelector('input[name="Parties"]');

        if (partyInput) {
            partyInput.value = '';
        }
    }

    function loadPartyDropdown(input) {
        const row = input.closest('tr');
        const partyType = row.querySelector('select[name="PartyTypes"]')?.value || '';

        if (!partyType) {
            hideDropdown(input);
            return;
        }

        loadJournalLinkDropdown(input, partyType);
    }

      function loadJournalLinkDropdown(input, doctype) {
        clearTimeout(journalLinkTimer);

        journalLinkTimer = setTimeout(async function () {
            const wrapper = input.closest('.erp-link-wrapper');
            const dropdown = wrapper?.querySelector('.erp-link-dropdown');

            if (!dropdown) return;

            const url =
                `/HR/SearchJournalEntryLink?doctype=${encodeURIComponent(doctype)}` +
                `&txt=${encodeURIComponent(input.value || '')}`;

            const rows = await fetchJsonSafe(url);

            dropdown.innerHTML = '';

            if (!rows || !rows.length) {
                dropdown.classList.add('d-none');
                return;
            }

            rows.forEach(row => {
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'erp-link-option';

                button.textContent = row.label && row.label !== row.name
                    ? `${row.name} - ${row.label}`
                    : row.name;

                button.onclick = async function () {
                    input.value = row.name || '';
                    dropdown.classList.add('d-none');

                    if (doctype === 'Company') {
                        await fillCompanyGstin(row.name);
                    }
                };

                dropdown.appendChild(button);
            });

            dropdown.classList.remove('d-none');
        }, 250);
    }
    async function fillCompanyGstin(companyName) {
        const gstinInput = document.getElementById('CompanyGstin');

        if (!gstinInput || !companyName) {
            return;
        }

        const data = await fetchJsonSafe(
            `/HR/GetJournalEntryCompanyDetails?company=${encodeURIComponent(companyName)}`
        );

        if (data && !Array.isArray(data)) {
            gstinInput.value = data.companyGstin || '';
        }
    }

    function hideDropdown(input) {
        const wrapper = input.closest('.erp-link-wrapper');
        const dropdown = wrapper?.querySelector('.erp-link-dropdown');

        if (dropdown) {
            dropdown.classList.add('d-none');
        }
    }

    document.addEventListener('click', function (event) {
        document.querySelectorAll('.erp-link-dropdown').forEach(dropdown => {
            const wrapper = dropdown.closest('.erp-link-wrapper');

            if (wrapper && !wrapper.contains(event.target)) {
                dropdown.classList.add('d-none');
            }
        });
    });


        function syncReferenceToBillFields() {
        const referenceNo = document.getElementById('ReferenceNumber');
        const billNo = document.getElementById('BillNo');

        const referenceDate = document.getElementById('ReferenceDate');
        const billDate = document.getElementById('BillDate');

        if (referenceNo && billNo) {
            referenceNo.addEventListener('input', function () {
                billNo.value = referenceNo.value;
            });
        }

        if (referenceDate && billDate) {
            referenceDate.addEventListener('input', function () {
                billDate.value = referenceDate.value;
            });
        }
    }


       document.addEventListener('DOMContentLoaded', function () {
        calculateJournalTotals();
        syncReferenceToBillFields();
    });
</script>