@{
    ViewBag.Title = "Bulk Salary Structure Assignment";
}

<style>
    .bulk-page {
        max-width: 945px;
        margin: 0 auto;
    }

    .bulk-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

    .bulk-title {
        font-size: 18px;
        font-weight: 700;
    }

    .assign-btn {
        background: #111;
        color: #fff;
        border: 0;
        border-radius: 8px;
        padding: 7px 14px;
        font-weight: 600;
    }

    .bulk-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        overflow: hidden;
    }

    .section {
        padding: 16px;
        border-bottom: 1px solid #e5e7eb;
    }

    .section-title {
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 16px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px 28px;
    }

    .field-label {
        display: block;
        font-size: 12px;
        margin-bottom: 7px;
        color: #374151;
    }

    .required {
        color: #dc2626;
    }

    .erp-input, .erp-select {
        width: 100%;
        height: 30px;
        border: 1px solid #e5e7eb;
        background: #f3f3f3;
        border-radius: 7px;
        padding: 5px 9px;
        font-size: 12px;
    }

    .invalid {
        border-color: #ef4444;
    }

    .filter-row {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 24px;
        gap: 10px;
        align-items: center;
        margin-bottom: 10px;
    }

    .filter-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 12px;
    }

    .link-btn {
        border: 0;
        background: transparent;
        color: #111827;
        font-size: 12px;
        padding: 4px 6px;
    }

    .employee-table {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid #e5e7eb;
    }

        .employee-table th {
            background: #f3f3f3;
            font-size: 12px;
            color: #374151;
            padding: 8px;
            text-align: left;
            border-bottom: 1px solid #e5e7eb;
        }

        .employee-table td {
            padding: 8px;
            border-bottom: 1px solid #e5e7eb;
            font-size: 12px;
        }

        .employee-table input {
            width: 100%;
            height: 28px;
            border: 1px solid #e5e7eb;
            background: #f3f3f3;
            border-radius: 6px;
            padding: 4px 7px;
        }

    .empty-message {
        height: 120px;
        text-align: center;
        color: #475569;
        vertical-align: middle;
    }
</style>

<div class="bulk-page">
    <form method="post" action="#">
        <div class="bulk-header">
            <div class="bulk-title">Bulk Salary Structure Assignment</div>
            <button type="submit" class="assign-btn">Assign Structure</button>
        </div>

        <div class="bulk-card">
            <div class="section">
                <div class="section-title">Set Assignment Details</div>

                <div class="form-grid">
                    <div>
                        <label class="field-label">Salary Structure <span class="required">*</span></label>
                        <input type="text" name="SalaryStructure" class="erp-input invalid" />
                    </div>

                    <div>
                        <label class="field-label">Company <span class="required">*</span></label>
                        <input type="text" name="Company" class="erp-input" value="Vinod Cookware India Private Limited" />
                    </div>

                    <div>
                        <label class="field-label">From Date <span class="required">*</span></label>
                        <input type="date" name="FromDate" class="erp-input invalid" />
                    </div>

                    <div>
                        <label class="field-label">Payroll Payable Account</label>
                        <input type="text" name="PayrollPayableAccount" class="erp-input" />
                    </div>
                </div>
            </div>

            <div class="section">
                <div class="section-title">Quick Filters <span style="font-size:12px;">^</span></div>

                <div class="form-grid">
                    <div>
                        <label class="field-label">Branch</label>
                        <input type="text" name="Branch" class="erp-input" />
                    </div>

                    <div>
                        <label class="field-label">Employee Grade</label>
                        <input type="text" name="EmployeeGrade" class="erp-input" />
                    </div>

                    <div>
                        <label class="field-label">Department</label>
                        <input type="text" name="Department" class="erp-input" />
                    </div>

                    <div>
                        <label class="field-label">Employment Type</label>
                        <input type="text" name="EmploymentType" class="erp-input" />
                    </div>

                    <div>
                        <label class="field-label">Designation</label>
                        <input type="text" name="Designation" class="erp-input" />
                    </div>
                </div>
            </div>

            <div class="section">
                <div class="section-title">Advanced Filters <span style="font-size:12px;">^</span></div>

                <div id="advancedFilters"></div>

                <div class="filter-actions">
                    <button type="button" class="link-btn" onclick="addAdvancedFilter()">+ Add a Filter</button>
                    <button type="button" class="link-btn" onclick="clearAdvancedFilters()">Clear Filters</button>
                </div>
            </div>

            <div class="section">
                <div class="section-title">Select Employees</div>

                <table class="employee-table">
                    <thead>
                        <tr>
                            <th style="width:35px;"><input type="checkbox" /></th>
                            <th>Employee</th>
                            <th>Name</th>
                            <th>Grade</th>
                            <th>Base</th>
                            <th>Variable</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><input type="checkbox" /></td>
                            <td><input type="text" /></td>
                            <td><input type="text" /></td>
                            <td><input type="text" /></td>
                            <td><input type="text" /></td>
                            <td><input type="text" /></td>
                        </tr>
                        <tr>
                            <td colspan="6" class="empty-message">Please<br />select<br />From<br />Date.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </form>
</div>

<script>
    function addAdvancedFilter() {
        const holder = document.getElementById('advancedFilters');

        if (holder.querySelector('.filter-row')) {
            return;
        }

        const row = document.createElement('div');
        row.className = 'filter-row';
        row.innerHTML = `
            <input type="text" name="FilterField" class="erp-input" value="ID" />
            <select name="FilterCondition" class="erp-select">
                <option selected>Equals</option>
                <option>Not Equals</option>
                <option>Like</option>
                <option>In</option>
            </select>
            <input type="text" name="FilterValue" class="erp-input" />
            <button type="button" class="link-btn" onclick="this.closest('.filter-row').remove()">x</button>
        `;

        holder.appendChild(row);
    }

    function clearAdvancedFilters() {
        document.getElementById('advancedFilters').innerHTML = '';
    }
</script>