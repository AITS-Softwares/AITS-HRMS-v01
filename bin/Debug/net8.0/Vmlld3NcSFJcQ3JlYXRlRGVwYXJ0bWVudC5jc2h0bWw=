@model Erp_Aits.Models.Department
@{
    ViewBag.Title = "New Department";
}

<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    body {
        background: radial-gradient(circle at top left, #f0fdfa 0%, #eef2f3 45%, #f4f7f6 100%);
        font-family: 'Inter', sans-serif;
    }

    .dept-wrapper {
        max-width: 1100px;
        margin: 0 auto;
        padding: 28px 16px 60px;
    }

    .dept-accent-bar {
        height: 5px;
        width: 100%;
        border-radius: 6px;
        background: linear-gradient(90deg, #0f766e 0%, #14b8a6 45%, #f59e0b 100%);
        margin-bottom: 22px;
    }

    .dept-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 22px 28px;
        background: linear-gradient(120deg, #0f766e 0%, #0d9488 55%, #14b8a6 100%);
        border-radius: 14px 14px 0 0;
    }

        .dept-page-header h4 {
            font-family: 'Manrope', sans-serif;
            color: #ffffff;
            font-weight: 800;
            margin: 0;
            font-size: 24px;
        }

    .btn-save {
        background: #ffffff;
        color: #0f766e;
        border: none;
        font-weight: 700;
        padding: 10px 26px;
        border-radius: 9px;
        cursor: pointer;
    }

        .btn-save:hover {
            background: #f59e0b;
            color: #ffffff;
        }

    .dept-panel {
        border-radius: 14px;
        box-shadow: 0 10px 30px rgba(20, 40, 40, 0.08);
        overflow: hidden;
        margin-bottom: 26px;
    }

    .dept-card {
        background: #ffffff;
        padding: 30px;
        border-bottom: 1px solid #e6f5f3;
    }

    .table {
        border: 1px solid #d9ece9;
        background: #ffffff;
    }

        .table thead th {
            background-color: #e6f8f5;
            color: #0f766e;
            font-weight: 700;
            font-size: 12px;
        }
</style>

<div class="dept-wrapper">
    <div class="dept-accent-bar"></div>

    <!-- Datalists for ERPNext Dropdowns -->
    <datalist id="companyList">
        @if (ViewBag.Companies != null)
        {
            foreach (var comp in ViewBag.Companies)
            {
                <option value="@comp.name">@comp.company_name</option>
            }
        }
    </datalist>

    <datalist id="parentDepartmentList">
        @if (ViewBag.Departments != null)
        {
            foreach (var d in ViewBag.Departments)
            {
                <option value="@d.name">@d.department_name</option>
            }
        }
    </datalist>

    <datalist id="costCenterList">
        @if (ViewBag.CostCenters != null)
        {
            foreach (var cc in ViewBag.CostCenters)
            {
                <option value="@cc.name"></option>
            }
        }
    </datalist>

    <datalist id="leaveBlockList">
        @if (ViewBag.LeaveBlockLists != null)
        {
            foreach (var lbl in ViewBag.LeaveBlockLists)
            {
                <option value="@lbl.name"></option>
            }
        }
    </datalist>

    <datalist id="approverList">
        @if (ViewBag.Approvers != null)
        {
            foreach (var app in ViewBag.Approvers)
            {
                @* <option value="@app.name">@app.employee_name</option> *@
                <option value="@app.name">@app.full_name (@app.name)</option>
            }
        }
    </datalist>

    <form action="@Url.Action("CreateDepartment", "HR")" method="post">
        <div class="dept-panel">
            <div class="dept-page-header">
                <div>
                    <div style="color: rgba(255,255,255,0.75); font-size: 12px; font-weight: 600; text-transform: uppercase;">HR &middot; Organization Setup</div>
                    <h4>New Department</h4>
                </div>
                <button type="submit" class="btn btn-save">Save Department</button>
            </div>

            <div class="dept-card">
                <h5>Department Details</h5>
                <hr />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Department *</label>
                        <input asp-for="DepartmentName" class="form-control" required placeholder="Type department name..." />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Company *</label>
                        <input asp-for="Company" class="form-control" list="companyList" required value="Vinod Cookware India Private Limited" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Parent Department</label>
                        <input asp-for="ParentDepartment" class="form-control" list="parentDepartmentList" placeholder="Select or type parent department..." />
                    </div>
                    <div class="col-md-6 mt-4">
                        <div class="form-check">
                            <input asp-for="IsGroup" class="form-check-input" type="checkbox" />
                            <label class="form-check-label">Is Group</label>
                        </div>
                        <div class="form-check">
                            <input asp-for="Disabled" class="form-check-input" type="checkbox" />
                            <label class="form-check-label">Disabled</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Payroll Cost Center</label>
                        <input asp-for="PayrollCostCenter" class="form-control" list="costCenterList" placeholder="Select cost center..." />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Leave Block List</label>
                        <input asp-for="LeaveBlockList" class="form-control" list="leaveBlockList" placeholder="Select leave block list..." />
                    </div>
                </div>
            </div>

            <div class="dept-card">
                <h5>Approvers</h5>
                <small class="text-muted mb-3 d-block">Add approvers for shift, leave, and expense requests.</small>

                <!-- Shift Request Approver -->
                <div class="mb-4">
                    <label class="form-label fw-bold">Shift Request Approver</label>
                    <table class="table table-bordered align-middle" id="shiftTable">
                        <thead>
                            <tr>
                                <th style="width:40px"><input type="checkbox" disabled /></th>
                                <th style="width:60px">No.</th>
                                <th>Approver *</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addApproverRow('shiftTable', 'ShiftApprovers')">+ Add Row</button>
                </div>

                <!-- Leave Approver -->
                <div class="mb-4">
                    <label class="form-label fw-bold">Leave Approver</label>
                    <table class="table table-bordered align-middle" id="leaveTable">
                        <thead>
                            <tr>
                                <th style="width:40px"><input type="checkbox" disabled /></th>
                                <th style="width:60px">No.</th>
                                <th>Approver *</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addApproverRow('leaveTable', 'LeaveApprovers')">+ Add Row</button>
                </div>

                <!-- Expense Approver -->
                <div>
                    <label class="form-label fw-bold">Expense Approver</label>
                    <table class="table table-bordered align-middle" id="expenseTable">
                        <thead>
                            <tr>
                                <th style="width:40px"><input type="checkbox" disabled /></th>
                                <th style="width:60px">No.</th>
                                <th>Approver *</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addApproverRow('expenseTable', 'ExpenseApprovers')">+ Add Row</button>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    function addApproverRow(tableId, inputName) {
        var tbody = document.getElementById(tableId).querySelector('tbody');
        var rowNum = tbody.rows.length + 1;

        var row = document.createElement('tr');
        row.innerHTML = `
            <td><input type="checkbox" /></td>
            <td>${rowNum}</td>
            <td><input type="text" name="${inputName}" list="approverList" class="form-control form-control-sm border-0" placeholder="Select approver..." required /></td>
        `;
        tbody.appendChild(row);
    }
</script>