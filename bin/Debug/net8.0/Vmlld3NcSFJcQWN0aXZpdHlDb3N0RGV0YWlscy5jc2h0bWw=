@model Erp_Aits.Models.ActivityCost
@{
    ViewBag.Title = "Activity Cost " + Model.Id;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Activity Cost #@Model.Id</h4>
    <div class="d-flex gap-2">
        <a href="/HR/ActivityCost" class="btn btn-outline-secondary btn-sm">Back</a>
        <form method="post" action="@Url.Action("DeleteActivityCost", "HR", new { id = Model.Id })" onsubmit="return confirm('Delete this Activity Cost from ERPNext and HRMS?');">
            <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
        </form>
    </div>
</div>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<form method="post" action="@Url.Action("UpdateActivityCost", "HR", new { id = Model.Id })">
    <input type="hidden" name="Id" value="@Model.Id" />
    <input type="hidden" name="ErpNextId" value="@Model.ErpNextId" />

    <div class="card p-4 mb-3">
        <label class="form-label">Activity Type</label>
        <select name="ActivityType" class="form-select mb-3" required>
            <option value="">Select Activity Type</option>
            @if (ViewBag.ActivityTypes != null)
            {
                foreach (var item in ViewBag.ActivityTypes)
                {
                    var name = item.name?.ToString();
                    <option value="@name" selected="@(Model.ActivityType == name)">@name</option>
                }
            }
        </select>

        <label class="form-label">Employee</label>
        <select name="Employee" class="form-select">
            <option value="">Select Employee</option>
            @if (ViewBag.Employees != null)
            {
                foreach (var item in ViewBag.Employees)
                {
                    var name = item.name?.ToString();
                    var employeeName = item.employee_name?.ToString();
                    <option value="@name" selected="@(Model.Employee == name)">@name - @employeeName</option>
                }
            }
        </select>
    </div>

    <div class="card p-4">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Billing Rate</label>
                <input name="BillingRate" type="number" step="0.01" class="form-control" value="@Model.BillingRate" />
                <small class="text-muted">per hour</small>
            </div>
            <div class="col-md-6">
                <label class="form-label">Costing Rate</label>
                <input name="CostingRate" type="number" step="0.01" class="form-control" value="@Model.CostingRate" />
                <small class="text-muted">per hour</small>
            </div>
        </div>
        <div class="d-flex justify-content-end mt-4">
            <button type="submit" class="btn btn-dark btn-sm">Save</button>
        </div>
    </div>
</form>
