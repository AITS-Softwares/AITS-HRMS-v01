@model List<Erp_Aits.Models.LeaveApplication>
@{
    ViewBag.Title = "Leave Applications";
}

<div class="leave-list-wrapper mt-4">
    <div class="list-header d-flex justify-content-between align-items-center bg-dark p-3 text-white rounded-top">
        <h4 class="mb-0">Leave Applications</h4>
        <div>
            <a href="@Url.Action("CreateLeave", "HR")" class="btn btn-warning btn-sm fw-bold">+ Add Leave Application</a>
        </div>
    </div>

    <div class="list-body bg-white p-4 border rounded-bottom shadow-sm">
        @if (TempData["ErpNextError"] != null)
        {
            <div class="alert alert-danger">@TempData["ErpNextError"]</div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>ID Code</th>
                    <th>Employee ID</th>
                    <th>Employee Name</th>
                    <th>Leave Type</th>
                    <th>Status</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var lv in Model)
                    {
                        <tr>
                            <td><strong>@lv.LeaveApplicationCode</strong></td>
                            <td>@lv.Employee</td>
                            <td>@lv.EmployeeName</td>
                            <td>@lv.LeaveType</td>
                            <td><span class="badge bg-secondary">@lv.Status</span></td>
                            <td class="text-center">
                                <a href="@Url.Action("LeaveApplicationDetails", "HR", new { id = lv.Id })" class="btn btn-sm btn-outline-dark">View</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-3">No leave applications found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
