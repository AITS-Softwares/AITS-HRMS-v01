@model Erp_Aits.Models.ErpNextCompanyFormViewModel
@{
    ViewBag.Title = Model.IsEdit ? "Company Details" : "New Company";
    string formAction = Model.IsEdit ? "UpdateCompany" : "CreateCompany";
}

@functions {
    private IEnumerable<string> OptionsWithCurrent(IEnumerable<string> options, string? current, params string[] fixedOptions)
    {
        var values = new List<string>();
        if (fixedOptions != null)
        {
            values.AddRange(fixedOptions);
        }

        values.AddRange(options ?? Enumerable.Empty<string>());

        if (!string.IsNullOrWhiteSpace(current))
        {
            values.Add(current);
        }

        return values
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(value => value);
    }
}

<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
