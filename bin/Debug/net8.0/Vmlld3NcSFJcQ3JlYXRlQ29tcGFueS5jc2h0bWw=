        overflow: hidden;
    }

    .company-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 20px 24px;
        background: linear-gradient(120deg, #0f766e 0%, #0d9488 55%, #14b8a6 100%);
    }

    .company-header h4 {
        color: #ffffff;
        font-family: 'Manrope', sans-serif;
        font-weight: 800;
        margin: 0;
    }

    .header-subtitle {
        color: rgba(255, 255, 255, 0.78);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.9px;
        text-transform: uppercase;
    }

    .btn-save {
        background: #ffffff;
        color: #0f766e;
        border: 0;
        border-radius: 9px;
        padding: 10px 24px;
        font-weight: 800;
    }

    .btn-save:hover {
        background: #f59e0b;
        color: #ffffff;
    }

    .tabs {
        display: flex;
        gap: 4px;
        overflow-x: auto;
        border-bottom: 1px solid #e5e7eb;
        padding: 0 20px;
        background: #ffffff;
    }

    .tab-button {
        border: 0;
        background: transparent;
        color: #475569;
        padding: 15px 14px 12px;
        font-weight: 700;
        white-space: nowrap;
        border-bottom: 2px solid transparent;
    }

    .tab-button.active {
        color: #111827;
        border-bottom-color: #111827;
    }

    .tab-pane {
        display: none;
        padding: 24px;
    }

    .tab-pane.active {
        display: block;
    }

    .section {
        border-bottom: 1px solid #e8f1ef;
        padding-bottom: 22px;
        margin-bottom: 22px;
    }

    .section:last-child {
        border-bottom: 0;
        margin-bottom: 0;
    }

    .section h5 {
        color: #0f172a;
        font-weight: 800;
        font-size: 16px;
        margin-bottom: 18px;
    }

    .form-label {
        font-weight: 600;
        color: #334155;
        font-size: 13px;
    }

    .form-control, .form-select {
        border: 1.5px solid #d9ece9;
        border-radius: 8px;
        min-height: 38px;
        font-size: 14px;
        background-color: #ffffff;
        color: #0f172a;
        color-scheme: light;
    }

    .form-select option {
        background: #ffffff;
        color: #0f172a;
    }

    .form-control:focus, .form-select:focus {
        border-color: #14b8a6;
        box-shadow: 0 0 0 4px rgba(20, 184, 166, 0.14);
    }

    .form-check-input:checked {
        background-color: #0f766e;
        border-color: #0f766e;
    }

    .help-text {
        color: #64748b;
        font-size: 13px;
        margin: 8px 0 12px;
    }

    .grid-table {
        border: 1px solid #d9ece9;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 12px;
    }

    .grid-table table {
        margin: 0;
    }

    .grid-table thead th {
        background: #f1f5f9;
        color: #64748b;
        font-size: 12px;
        font-weight: 700;
    }

    .btn-soft {
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        color: #0f172a;
        border-radius: 8px;
        padding: 7px 13px;
        font-weight: 700;
    }

    .danger-row {
        display: flex;
        justify-content: flex-end;
        padding: 0 24px 24px;
    }

    .missing-panel {
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
        border-radius: 10px;
        color: #64748b;
        padding: 24px;
    }

    @@media (max-width: 768px) {
        .company-header {
            align-items: flex-start;
            flex-direction: column;
        }
    }
