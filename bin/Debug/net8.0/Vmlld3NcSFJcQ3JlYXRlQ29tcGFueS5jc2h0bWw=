                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Default Operating Cost Account</label>
                            <select asp-for="DefaultOperatingCostAccount" class="form-select">
                                <option value="">Select</option>
                                @foreach (var option in OptionsWithCurrent(Model.Accounts, Model.DefaultOperatingCostAccount))
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="tab-pane" id="tab-print">
                <div class="section">
                    <div class="form-check">
                        <input asp-for="EnablePhysicalSignature" class="form-check-input" type="checkbox" />
                        <label class="form-check-label">Enable Physical Signature</label>
                    </div>
                </div>

                <div class="section">
                    <h5>Bank Details</h5>
                    <div class="grid-table">
                        <table class="table align-middle" id="bankDetailsTable">
                            <thead>
                                <tr>
                                    <th style="width:44px"><input type="checkbox" disabled /></th>
                                    <th style="width:70px">No.</th>
                                    <th>Print Label</th>
                                    <th>Print Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.BankDetails.Count; i++)
                                {
                                    <tr>
                                        <td><input type="checkbox" disabled /></td>
                                        <td class="row-number">@(i + 1)</td>
                                        <td>
                                            <select class="form-select" name="BankDetails[@i].PrintLabel">
                                                <option value="">Select</option>
                                                @foreach (var option in OptionsWithCurrent(Model.PrintLabelOptions, Model.BankDetails[i].PrintLabel))
                                                {
                                                    <option value="@option" selected="@(option.Equals(Model.BankDetails[i].PrintLabel, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@option</option>
                                                }
                                            </select>
                                        </td>
                                        <td><input class="form-control" name="BankDetails[@i].PrintValue" value="@Model.BankDetails[i].PrintValue" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <button type="button" class="btn-soft" onclick="addPrintRow('bankDetailsTable', 'BankDetails')">Add Row</button>
                </div>

                <div class="section">
                    <h5>Registration Details</h5>
                    <div class="grid-table">
                        <table class="table align-middle" id="registrationDetailsTable">
                            <thead>
                                <tr>
                                    <th style="width:44px"><input type="checkbox" disabled /></th>
                                    <th style="width:70px">No.</th>
                                    <th>Print Label</th>
                                    <th>Print Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.RegistrationDetails.Count; i++)
                                {
                                    <tr>
                                        <td><input type="checkbox" disabled /></td>
                                        <td class="row-number">@(i + 1)</td>
                                        <td>
                                            <select class="form-select" name="RegistrationDetails[@i].PrintLabel">
                                                <option value="">Select</option>
                                                @foreach (var option in OptionsWithCurrent(Model.PrintLabelOptions, Model.RegistrationDetails[i].PrintLabel))
                                                {
                                                    <option value="@option" selected="@(option.Equals(Model.RegistrationDetails[i].PrintLabel, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@option</option>
                                                }
                                            </select>
                                        </td>
                                        <td><input class="form-control" name="RegistrationDetails[@i].PrintValue" value="@Model.RegistrationDetails[i].PrintValue" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <button type="button" class="btn-soft" onclick="addPrintRow('registrationDetailsTable', 'RegistrationDetails')">Add Row</button>
                </div>
            </div>
        </div>
    </form>

    @if (Model.IsEdit)
    {
        <div class="danger-row">
            <form method="post" action="@Url.Action("DeleteCompany", "Company")" onsubmit="return confirm('Delete this company from ERPNext? ERPNext will stop this if the company is already used.');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="name" value="@Model.OriginalName" />
                <button type="submit" class="btn btn-outline-danger">Delete Company</button>
            </form>
        </div>
    }
</div>

<script>
    var printLabelOptions = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(OptionsWithCurrent(Model.PrintLabelOptions, string.Empty)));

    document.querySelectorAll('.tab-button').forEach(function (button) {
        button.addEventListener('click', function () {
            var tabName = button.getAttribute('data-tab');
            document.querySelectorAll('.tab-button').forEach(function (item) { item.classList.remove('active'); });
            document.querySelectorAll('.tab-pane').forEach(function (item) { item.classList.remove('active'); });
            button.classList.add('active');
            document.getElementById('tab-' + tabName).classList.add('active');
        });
    });

    function addPrintRow(tableId, prefix) {
        var tbody = document.querySelector('#' + tableId + ' tbody');
        var index = tbody.querySelectorAll('tr').length;
        var row = document.createElement('tr');
        var optionsHtml = '<option value="">Select</option>' + printLabelOptions.map(function (option) {
            return '<option value="' + escapeHtml(option) + '">' + escapeHtml(option) + '</option>';
        }).join('');

        row.innerHTML =
            '<td><input type="checkbox" disabled /></td>' +
            '<td class="row-number">' + (index + 1) + '</td>' +
            '<td><select class="form-select" name="' + prefix + '[' + index + '].PrintLabel">' + optionsHtml + '</select></td>' +
            '<td><input class="form-control" name="' + prefix + '[' + index + '].PrintValue" /></td>';
        tbody.appendChild(row);
    }

    function escapeHtml(value) {
        return String(value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }
</script>
