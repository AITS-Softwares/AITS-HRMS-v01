@model Erp_Aits.Models.EmployeeSkillMap
@using System.Collections.Generic
@using System.Linq

@{
    ViewBag.Title = "Employee Skill Map - " + Model.EmployeeName;

    bool editMode =
        ViewBag.EditMode == true ||
        string.Equals(Context.Request.Query["edit"], "true", StringComparison.OrdinalIgnoreCase);

    var skills = ViewBag.Skills;
    var trainings = ViewBag.Trainings;

    var skillNames = new List<string>();
    if (skills != null)
    {
        foreach (var s in skills)
        {
            skillNames.Add(s.name.ToString());
        }
    }

    var trainingNames = new List<string>();
    if (trainings != null)
    {
        foreach (var t in trainings)
        {
            trainingNames.Add(t.name.ToString());
        }
    }
}

<style>
    .rating-stars {
        display: flex;
        align-items: center;
        gap: 4px;
        min-height: 34px;
    }

    .rating-star {
        font-size: 22px;
        line-height: 1;
        cursor: pointer;
        color: #d1d5db;
        user-select: none;
    }

        .rating-star.active {
            color: #f4b400;
        }

    .rating-readonly {
        font-size: 22px;
        line-height: 1;
        color: #d1d5db;
    }

        .rating-readonly.active {
            color: #f4b400;
        }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Employee Skill Map</h4>

    <div class="d-flex gap-2">
        <a href="@Url.Action("EmployeeSkillMap", "HR")"
           class="btn btn-outline-secondary btn-sm">
            ← Back to List
        </a>

        @if (!editMode)
        {
            <a href="/HR/EmployeeSkillMapDetails/@Model.Id?edit=true"
               class="btn btn-dark btn-sm">
                Edit
            </a>

            <form method="post"
                  action="@Url.Action("DeleteEmployeeSkillMap", "HR", new { id = Model.Id })"
                  onsubmit="return confirm('Are you sure you want to delete this Employee Skill Map?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger btn-sm">
                    Delete
                </button>
            </form>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-3">@TempData["Success"]</div>
}

@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["ErpNextError"]</div>
}

<form method="post"
      action="@Url.Action("UpdateEmployeeSkillMap", "HR", new { id = Model.Id })">

    @Html.AntiForgeryToken()

    <div class="card border rounded-3 p-4 mb-3 shadow-sm">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Employee</label>
                <input class="form-control"
                       value="@Model.Employee"
                       readonly />
                <input type="hidden" name="Employee" value="@Model.Employee" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Employee Name</label>
                <input class="form-control"
                       value="@Model.EmployeeName"
                       readonly />
                <input type="hidden" name="EmployeeName" value="@Model.EmployeeName" />
            </div>
        </div>
    </div>

    <div class="card border rounded-3 p-4 mb-3 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h6 class="mb-1">Skills</h6>
                <small class="text-muted">Employee Skills</small>
            </div>

            @if (editMode)
            {
                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        onclick="addSkillRow('', 0, '')">
                    + Add Row
                </button>
            }
        </div>

        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width:60px;">No.</th>
                        <th>Skill</th>
                        <th>Proficiency</th>
                        <th>Evaluation Date</th>
                        @if (editMode)
                        {
                            <th style="width:80px;">Action</th>
                        }
                    </tr>
                </thead>

                <tbody id="skillsBody">
                    @if (Model.Skills != null && Model.Skills.Any())
                    {
                        int i = 0;

                        foreach (var skill in Model.Skills)
                        {
                            <tr>
                                <td class="skill-row-no">@(i + 1)</td>

                                <td>
                                    @if (editMode)
                                    {
                                        <select name="Skills[@i].Skill"
                                                class="form-select form-select-sm"
                                                required>
                                            <option value="">-- Select Skill --</option>
                                            @foreach (var skillName in skillNames)
                                            {
                                                <option value="@skillName" selected="@(skill.Skill == skillName)">
                                                    @skillName
                                                </option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        @skill.Skill
                                        <input type="hidden" name="Skills[@i].Skill" value="@skill.Skill" />
                                    }
                                </td>

                                <td>
                                    @if (editMode)
                                    {
                                        <div class="rating-stars">
                                            <input type="hidden"
                                                   name="Skills[@i].Proficiency"
                                                   class="proficiency-input"
                                                   value="@skill.Proficiency" />

                                            @for (int star = 1; star <= 5; star++)
                                            {
                                                <span class="rating-star @(star <= skill.Proficiency ? "active" : "")"
                                                      data-value="@star">
                                                    @(star <= skill.Proficiency ? "★" : "☆")
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        for (int star = 1; star <= 5; star++)
                                        {
                                            <span class="rating-readonly @(star <= skill.Proficiency ? "active" : "")">
                                                @(star <= skill.Proficiency ? "★" : "☆")
                                            </span>
                                        }

                                        <input type="hidden" name="Skills[@i].Proficiency" value="@skill.Proficiency" />
                                    }
                                </td>

                                <td>
                                    @if (editMode)
                                    {
                                        <input type="date"
                                               name="Skills[@i].EvaluationDate"
                                               class="form-control form-control-sm"
                                               value="@(skill.EvaluationDate?.ToString("yyyy-MM-dd"))" />
                                    }
                                    else
                                    {
                                        @(skill.EvaluationDate?.ToString("dd-MM-yyyy"))
                                        <input type="hidden"
                                               name="Skills[@i].EvaluationDate"
                                               value="@(skill.EvaluationDate?.ToString("yyyy-MM-dd"))" />
                                    }
                                </td>

                                @if (editMode)
                                {
                                    <td>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="removeRow(this)">
                                            ×
                                        </button>
                                    </td>
                                }
                            </tr>

                            i++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(editMode ? 5 : 4)"
                                class="text-center text-muted py-3">
                                No Skills
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card border rounded-3 p-4 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h6 class="mb-1">Trainings</h6>
                <small class="text-muted">Trainings</small>
            </div>

            @if (editMode)
            {
                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        onclick="addTrainingRow('', '')">
                    + Add Row
                </button>
            }
        </div>

        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width:60px;">No.</th>
                        <th>Training</th>
                        <th>Training Date</th>
                        @if (editMode)
                        {
                            <th style="width:80px;">Action</th>
                        }
                    </tr>
                </thead>

                <tbody id="trainingsBody">
                    @if (Model.Trainings != null && Model.Trainings.Any())
                    {
                        int i = 0;

                        foreach (var training in Model.Trainings)
                        {
                            <tr>
                                <td class="training-row-no">@(i + 1)</td>

                                <td>
                                    @if (editMode)
                                    {
                                        <select name="Trainings[@i].Training"
                                                class="form-select form-select-sm">
                                            <option value="">-- Select Training --</option>
                                            @foreach (var trainingName in trainingNames)
                                            {
                                                <option value="@trainingName" selected="@(training.Training == trainingName)">
                                                    @trainingName
                                                </option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        @training.Training
                                        <input type="hidden" name="Trainings[@i].Training" value="@training.Training" />
                                    }
                                </td>

                                <td>
                                    @if (editMode)
                                    {
                                        <input type="date"
                                               name="Trainings[@i].TrainingDate"
                                               class="form-control form-control-sm"
                                               value="@(training.TrainingDate?.ToString("yyyy-MM-dd"))" />
                                    }
                                    else
                                    {
                                        @(training.TrainingDate?.ToString("dd-MM-yyyy"))
                                        <input type="hidden"
                                               name="Trainings[@i].TrainingDate"
                                               value="@(training.TrainingDate?.ToString("yyyy-MM-dd"))" />
                                    }
                                </td>

                                @if (editMode)
                                {
                                    <td>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="removeRow(this)">
                                            ×
                                        </button>
                                    </td>
                                }
                            </tr>

                            i++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(editMode ? 4 : 3)"
                                class="text-center text-muted py-3">
                                No Trainings
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (editMode)
    {
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-dark">Save</button>
            <a href="/HR/EmployeeSkillMapDetails/@Model.Id"
               class="btn btn-outline-secondary">
                Cancel
            </a>
        </div>
    }
</form>

@if (editMode)
{
    <script>
        const skillOptions = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(skillNames));
        const trainingOptions = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(trainingNames));

        function getSkillOptions(selectedValue) {
            let html = '<option value="">-- Select Skill --</option>';

            skillOptions.forEach(function (name) {
                html += '<option value="' + name + '"' +
                    (selectedValue === name ? ' selected' : '') +
                    '>' + name + '</option>';
            });

            return html;
        }

        function getTrainingOptions(selectedValue) {
            let html = '<option value="">-- Select Training --</option>';

            trainingOptions.forEach(function (name) {
                html += '<option value="' + name + '"' +
                    (selectedValue === name ? ' selected' : '') +
                    '>' + name + '</option>';
            });

            return html;
        }

        function buildStarsHtml(index, rating) {
            rating = parseInt(rating || 0);

            let html = `
                <div class="rating-stars">
                    <input type="hidden"
                           name="Skills[${index}].Proficiency"
                           class="proficiency-input"
                           value="${rating}" />
            `;

            for (let star = 1; star <= 5; star++) {
                const active = star <= rating ? "active" : "";
                const symbol = star <= rating ? "★" : "☆";

                html += `
                    <span class="rating-star ${active}" data-value="${star}">
                        ${symbol}
                    </span>
                `;
            }

            html += `</div>`;

            return html;
        }

        function addSkillRow(skillValue, proficiencyValue, evaluationDateValue) {
            const tbody = document.getElementById("skillsBody");

            const emptyRow = tbody.querySelector("td.text-center");
            if (emptyRow) {
                tbody.innerHTML = "";
            }

            const index = tbody.querySelectorAll("tr").length;
            const today = new Date().toISOString().substring(0, 10);

            const row = document.createElement("tr");

            row.innerHTML = `
                <td class="skill-row-no">${index + 1}</td>
                <td>
                    <select name="Skills[${index}].Skill"
                            class="form-select form-select-sm"
                            required>
                        ${getSkillOptions(skillValue || "")}
                    </select>
                </td>
                <td>
                    ${buildStarsHtml(index, proficiencyValue || 0)}
                </td>
                <td>
                    <input type="date"
                           name="Skills[${index}].EvaluationDate"
                           class="form-control form-control-sm"
                           value="${evaluationDateValue || today}" />
                </td>
                <td>
                    <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            onclick="removeRow(this)">
                        ×
                    </button>
                </td>
            `;

            tbody.appendChild(row);
            reindexRows();
        }

        function addTrainingRow(trainingValue, trainingDateValue) {
            const tbody = document.getElementById("trainingsBody");

            const emptyRow = tbody.querySelector("td.text-center");
            if (emptyRow) {
                tbody.innerHTML = "";
            }

            const index = tbody.querySelectorAll("tr").length;
            const row = document.createElement("tr");

            row.innerHTML = `
                <td class="training-row-no">${index + 1}</td>
                <td>
                    <select name="Trainings[${index}].Training"
                            class="form-select form-select-sm">
                        ${getTrainingOptions(trainingValue || "")}
                    </select>
                </td>
                <td>
                    <input type="date"
                           name="Trainings[${index}].TrainingDate"
                           class="form-control form-control-sm"
                           value="${trainingDateValue || ""}" />
                </td>
                <td>
                    <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            onclick="removeRow(this)">
                        ×
                    </button>
                </td>
            `;

            tbody.appendChild(row);
            reindexRows();
        }

        function removeRow(button) {
            button.closest("tr").remove();
            reindexRows();
        }

        document.addEventListener("click", function (event) {
            if (event.target.classList.contains("rating-star")) {
                const container = event.target.closest(".rating-stars");
                const value = parseInt(event.target.getAttribute("data-value"));
                const input = container.querySelector(".proficiency-input");

                input.value = value;

                container.querySelectorAll(".rating-star").forEach(function (star) {
                    const starValue = parseInt(star.getAttribute("data-value"));

                    if (starValue <= value) {
                        star.classList.add("active");
                        star.innerHTML = "★";
                    } else {
                        star.classList.remove("active");
                        star.innerHTML = "☆";
                    }
                });
            }
        });

        function reindexRows() {
            document.querySelectorAll("#skillsBody tr").forEach(function (row, index) {
                const no = row.querySelector(".skill-row-no");
                if (no) no.innerText = index + 1;

                row.querySelectorAll("[name]").forEach(function (el) {
                    el.name = el.name.replace(/Skills\[\d+\]/, "Skills[" + index + "]");
                });
            });

            document.querySelectorAll("#trainingsBody tr").forEach(function (row, index) {
                const no = row.querySelector(".training-row-no");
                if (no) no.innerText = index + 1;

                row.querySelectorAll("[name]").forEach(function (el) {
                    el.name = el.name.replace(/Trainings\[\d+\]/, "Trainings[" + index + "]");
                });
            });
        }

        document.addEventListener("DOMContentLoaded", function () {
            reindexRows();
        });
    </script>
}