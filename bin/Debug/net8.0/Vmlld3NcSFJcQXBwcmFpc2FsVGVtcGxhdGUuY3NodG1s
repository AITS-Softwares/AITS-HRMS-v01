@model List<Erp_Aits.Models.AppraisalTemplateListRow>

@{
    ViewBag.Title = "Appraisal Template";
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <h4 class="mb-0">Appraisal Template</h4>

    <div class="d-flex gap-2">
        <a href="@Url.Action("CreateAppraisalTemplate", "HR")"
           class="btn btn-dark btn-sm">
            + Add Appraisal Template
        </a>

    </div>
</div>

<!-- Success Message -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close"></button>
    </div>
}

<!-- Error Message -->
@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErpNextError"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close"></button>
    </div>
}

<!-- Search -->
<form method="get"
      action="@Url.Action("AppraisalTemplate", "HR")"
      class="row g-2 mb-3">

    <div class="col-auto">
        <input type="text"
               name="id"
               class="form-control form-control-sm"
               placeholder="ID"
               value="@ViewBag.IdFilter" />
    </div>

    <div class="col-auto">
        <button type="submit"
                class="btn btn-sm btn-outline-secondary">
            Search
        </button>
    </div>

    <div class="col-auto">
        <a href="@Url.Action("AppraisalTemplate", "HR")"
           class="btn btn-sm btn-outline-secondary">
            Clear
        </a>
    </div>
</form>

<!-- Appraisal Template List -->
<div class="table-responsive">

    <table class="table table-hover align-middle">

        <thead>
            <tr>
                <th style="width:150px;">ID</th>
                <th>Appraisal Template Title</th>
            </tr>
        </thead>

        <tbody>

            @if (Model != null)
            {
                foreach (var t in Model)
                {
                    <tr style="cursor:pointer"
                        onclick="window.location='@Url.Action("AppraisalTemplateDetails", "HR", new { id = t.Id })'">

                        <td>@t.Id</td>

                        <td>@t.AppraisalTemplateTitle</td>

                    </tr>
                }
            }

        </tbody>

    </table>

</div>

@if (Model == null || !Model.Any())
{
    <p class="text-muted text-center py-5">
        No Appraisal Template found with matching filters.
    </p>
}
