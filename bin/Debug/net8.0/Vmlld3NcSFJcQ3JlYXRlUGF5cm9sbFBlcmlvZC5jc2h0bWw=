@{
    ViewBag.Title = "New Payroll Period";
}

<style>
    .erp-form-page {
        max-width: 1210px;
        margin: 0 auto;
    }

    .erp-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

    .erp-title {
        font-size: 22px;
        font-weight: 700;
    }

    .not-saved {
        color: #d9480f;
        background: #fff1e8;
        border-radius: 999px;
        padding: 3px 9px;
        font-size: 13px;
        margin-left: 8px;
    }

    .save-btn {
        background: #111;
        color: #fff;
        border: 0;
        border-radius: 8px;
        padding: 7px 16px;
        font-weight: 600;
    }

    .erp-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 18px 20px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px 28px;
    }

    .field-label {
        display: block;
        font-size: 14px;
        margin-bottom: 7px;
        color: #374151;
    }

    .required {
        color: #dc2626;
    }

    .erp-input {
        width: 100%;
        height: 34px;
        border: 1px solid #e5e7eb;
        background: #f3f3f3;
        border-radius: 8px;
        padding: 7px 10px;
        font-size: 14px;
    }

    @@media (max-width: 900px) {
        .form-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="erp-form-page">
    <form method="post" action="#">
        <div class="erp-header">
            <div>
                <span class="erp-title">New Payroll Period</span>
                <span class="not-saved">Not Saved</span>
            </div>

            <button type="submit" class="save-btn">Save</button>
        </div>

        <div class="erp-card">
            <div class="form-grid">
                <div>
                    <label class="field-label">Name <span class="required">*</span></label>
                    <input type="text" name="Name" class="erp-input" />
                </div>

                <div>
                    <label class="field-label">Start Date <span class="required">*</span></label>
                    <input type="date" name="StartDate" class="erp-input" />
                </div>

                <div>
                    <label class="field-label">Company <span class="required">*</span></label>
                    <input type="text" name="Company" class="erp-input" />
                </div>

                <div>
                    <label class="field-label">End Date <span class="required">*</span></label>
                    <input type="date" name="EndDate" class="erp-input" />
                </div>
            </div>
        </div>
    </form>
</div>