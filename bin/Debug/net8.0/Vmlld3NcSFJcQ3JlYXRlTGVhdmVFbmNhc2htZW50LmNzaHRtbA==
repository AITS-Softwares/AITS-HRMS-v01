@model Erp_Aits.Models.LeaveEncashment
@{
    ViewBag.Title = "New Leave Encashment";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">New Leave Encashment</h4>
    <a href="@Url.Action("LeaveEncashment", "HR")" class="btn btn-outline-secondary btn-sm">Back to List</a>
</div>

@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["ErpNextError"]</div>
}

<form asp-action="CreateLeaveEncashment" method="post">
    <div class="row g-3 mb-4">

        <!-- Employee Dropdown -->
        <div class="col-md-4">
            <label class="form-label">Employee <span class="text-danger">*</span></label>
            <select name="Employee" id="employeeSelect" class="form-select" required onchange="updateEmployeeName(this)">
                <option value="">-- Select Employee --</option>
                @if (ViewBag.EmployeesList != null)
                {
                    foreach (var emp in ViewBag.EmployeesList)
                    {
                        var empId = emp.GetType().GetProperty("EmployeeId")?.GetValue(emp, null)?.ToString();
                        var empName = emp.GetType().GetProperty("EmployeeName")?.GetValue(emp, null)?.ToString();
                        <option value="@empId" data-empname="@empName" selected="@(Model.Employee == empId)">@empId - @empName</option>
                    }
                }
            </select>
        </div>

        <!-- Employee Name (Auto-filled) -->
        <div class="col-md-4">
            <label class="form-label">Employee Name</label>
            <input type="text" name="EmployeeName" id="employeeNameInput" class="form-control" value="@Model.EmployeeName" readonly />
        </div>

        <!-- Leave Period Dropdown -->
        <div class="col-md-4">
            <label class="form-label">Leave Period <span class="text-danger">*</span></label>
            <select name="LeavePeriod" class="form-select" required>
                <option value="">-- Select Leave Period --</option>
                @if (ViewBag.LeavePeriods != null)
                {
                    foreach (var lp in (List<string>)ViewBag.LeavePeriods)
                    {
                        <option value="@lp" selected="@(Model.LeavePeriod == lp)">@lp</option>
                    }
                }
            </select>
        </div>

        <!-- Encashment Days -->
        <div class="col-md-4">
            <label class="form-label">Encashment Days <span class="text-danger">*</span></label>
            <input type="number" step="0.01" name="EncashmentDays" class="form-control" value="@Model.EncashmentDays" placeholder="Type number of days" required />
        </div>

        <!-- Company Dropdown -->
        <div class="col-md-4">
            <label class="form-label">Company <span class="text-danger">*</span></label>
            <select name="Company" class="form-select" required>
                <option value="">-- Select Company --</option>
                @if (ViewBag.Companies != null)
                {
                    foreach (var comp in (List<string>)ViewBag.Companies)
                    {
                        <option value="@comp" selected="@(Model.Company == comp)">@comp</option>
                    }
                }
            </select>
        </div>

        <!-- Leave Type Dropdown -->
        <div class="col-md-4">
            <label class="form-label">Leave Type <span class="text-danger">*</span></label>
            <select name="LeaveType" class="form-select" required>
                <option value="">-- Select Leave Type --</option>
                @if (ViewBag.LeaveTypes != null)
                {
                    foreach (var lt in (List<string>)ViewBag.LeaveTypes)
                    {
                        <option value="@lt" selected="@(Model.LeaveType == lt)">@lt</option>
                    }
                }
            </select>
        </div>
    </div>

    <hr />
    <h6 class="mb-2">Accounting</h6>
    <div class="form-check mb-1">
        <input class="form-check-input" type="checkbox" name="PayViaPaymentEntry" value="true" id="PayViaPaymentEntry" @(Model.PayViaPaymentEntry ? "checked" : "") />
        <label class="form-check-label" for="PayViaPaymentEntry">Pay Via Payment Entry</label>
    </div>
    <p class="text-muted small mb-4">Process leave encashment via a separate Payment Entry instead of Salary Slip</p>

    <hr />
    <h6 class="mb-2">Payroll</h6>
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <label class="form-label">Encashment Date</label>
            <input type="date" name="EncashmentDate" class="form-control" value="@Model.EncashmentDate.ToString("yyyy-MM-dd")" />
        </div>
    </div>

    <hr />
    <h6 class="mb-2">More Info</h6>
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <label class="form-label">Status</label>
            <select name="Status" class="form-select">
                <option value="Draft" selected="@(Model.Status == "Draft")">Draft</option>
                <option value="Submitted" selected="@(Model.Status == "Submitted")">Submitted</option>
                <option value="Approved" selected="@(Model.Status == "Approved")">Approved</option>
                <option value="Paid" selected="@(Model.Status == "Paid")">Paid</option>
            </select>
        </div>
    </div>

    <button type="submit" class="btn btn-dark">Save & Push to ERPNext</button>
</form>

<script>
    function updateEmployeeName(selectElement) {
        var selectedOption = selectElement.options[selectElement.selectedIndex];
        var empName = selectedOption.getAttribute("data-empname");
        document.getElementById("employeeNameInput").value = empName || "";
    }
</script>