@model Erp_Aits.Models.GrievanceType
@{
    ViewBag.Title = "Grievance Type " + Model.Name;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Grievance Type</h4>
    <a href="@Url.Action("GrievanceType", "HR")" class="btn btn-outline-secondary btn-sm">Back to List</a>
</div>

<div class="card p-4">
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input class="form-control" value="@Model.Name" readonly />
    </div>

    <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea class="form-control" rows="8" readonly>@Model.Description</textarea>
    </div>
</div>