late-columns:1.15fr .85fr}.dash-panel{background:#fff;border:1px solid #cae3eb;border-radius:13px;padding:22px;box-shadow:0 7px 22px rgba(21,78,98,.04)}.panel-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:18px}.panel-heading h2{font-size:18px;font-weight:800;margin:4px 0 0;color:#103b5c}.panel-heading a{font-size:12px;text-decoration:none;font-weight:800;color:#087c83;margin-top:7px}.attendance-body{display:flex;align-items:center;gap:28px}.attendance-ring{--size:132px;width:var(--size);height:var(--size);display:grid;place-items:center;border-radius:50%;background:conic-gradient(#07918a calc(var(--rate)*1%),#e3f1f2 0);position:relative;flex:0 0 auto}.attendance-ring:after{content:'';position:absolute;inset:10px;background:#fff;border-radius:50%}.attendance-ring div{position:relative;z-index:1;text-align:center}.attendance-ring strong{display:block;font-size:24px}.attendance-ring span{font-size:11px;color:#5d7786}.attendance-numbers{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;flex:1}.attendance-numbers div{border-left:1px solid #dfecef;padding-left:12px}.attendance-numbers b{display:block;font-size:21px}.attendance-numbers small{color:#668093;font-size:11px}.dot{display:block;width:8px;height:8px;border-radius:50%;margin-bottom:7px}.present{background:#10a88e}.absent{background:#ef6672}.late{background:#e8a321}.attendance-caption{font-size:11px;color:#7991a0;border-top:1px solid #e9f0f2;margin-top:17px;padding-top:13px}.snapshot-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.snapshot-grid div{border-radius:10px;background:#f0f9fa;padding:15px}.snapshot-grid i{color:#0b8983;margin-right:7px}.snapshot-grid b{font-size:22px;display:block;margin-top:7px}.snapshot-grid span{color:#668093;font-size:11px}.department-list,.activity-feed,.leave-list{display:grid;gap:13px}.department-name{display:flex;justify-content:space-between;font-size:13px;font-weight:700;margin-bottom:6px}.department-name span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:82%}.bar{height:7px;border-radius:10px;background:#e5f0f2;overflow:hidden}.bar i{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#19708a,#0aa294)}.pipeline{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.pipeline-item{padding:15px 10px;border-radius:10px}.pipeline-item i{font-size:16px;margin-bottom:11px}.pipeline-item b{font-size:23px;display:block}.pipeline-item span{font-size:11px;color:#567184}.pipeline-item.blue{background:#e9f2ff;color:#2561af}.pipeline-item.violet{background:#f0ebff;color:#7651d5}.pipeline-item.green{background:#e0f7ed;color:#078d69}.quick-links{display:flex;gap:9px;margin-top:16px}.quick-links a{font-size:12px;background:#edf7f6;color:#087c75;border-radius:7px;padding:8px 10px;text-decoration:none;font-weight:700}.activity-row,.leave-row{display:flex;align-items:center;gap:12px;border-bottom:1px solid #e9f0f2;padding-bottom:11px}.activity-row:last-child,.leave-row:last-child{border-bottom:0;padding-bottom:0}.activity-icon{width:35px;height:35px;border-radius:10px;display:grid;place-items:center;flex:0 0 auto}.activity-icon.teal{background:#d9f4ef;color:#078c7d}.activity-icon.violet{background:#ede7ff;color:#7450d4}.activity-icon.amber{background:#fff0d0;color:#c77b00}.activity-icon.blue{background:#e5f1ff;color:#2868b1}.activity-row div,.leave-row div{min-width:0;flex:1}.activity-row b,.leave-row b{display:block;font-size:13px}.activity-row span,.leave-row span{display:block;font-size:11px;color:#6d8494;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.activity-row time{font-size:10px;color:#8295a2;white-space:nowrap}.leave-date{width:36px;height:40px;border-radius:8px;background:#e4f5f3;color:#087e78;text-align:center;padding:4px}.leave-date b{font-size:15px;line-height:15px}.leave-date small{font-size:9px}.leave-row em{font-size:10px;font-style:normal;font-weight:800;background:#edf6ff;color:#3972a3;padding:4px 7px;border-radius:6px}.empty-state{min-height:150px;display:grid;place-content:center;text-align:center;color:#76909f;font-size:12px;gap:8px}.empty-state i{font-size:25px;color:#7acfc6}@media(max-width:1100px){.metric-grid{grid-template-columns:repeat(2,1fr)}.primary-grid,.content-grid,.bottom-grid{grid-template-columns:1fr}}@media(max-width:650px){.hr-hero{padding:22px;align-items:flex-start;flex-direction:column}.hero-actions{white-space:normal;flex-wrap:wrap}.metric-grid{grid-template-columns:1fr}.attendance-body{gap:18px}.attendance-numbers{gap:8px}.pipeline{grid-template-columns:1fr}.activity-row time{display:none}}
