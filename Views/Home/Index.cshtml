@model Erp_Aits.Controllers.HrmDashboardViewModel
@{
    ViewData["Title"] = "HRMS Dashboard";
    var maxDepartmentCount = Math.Max(1, Model.Departments.Count == 0 ? 1 : Model.Departments.Max(x => x.Count));
}

<section class="hr-dashboard">
    @if (!string.IsNullOrWhiteSpace(Model.DataMessage))
    {
        <div class="dashboard-data-notice @(Model.IsLive ? "" : "is-offline")"><i class="fa-solid fa-database"></i><span>@Model.DataMessage</span></div>
    }
    @if (!Model.IsLive && Model.LastUpdatedUtc == null)
    {
        <div class="dashboard-unavailable"><i class="fa-solid fa-server"></i><h2>Dashboard data is unavailable</h2><p>SQL Server did not respond, so no estimated or placeholder figures are being shown. Refresh once the database connection is restored.</p></div>
    }
    else
    {
    <div class="hr-hero">
        <div>
            <div class="eyebrow"><i class="fa-solid fa-sparkles"></i> HRMS / LIVE OVERVIEW</div>
            <h1>Workforce at a glance</h1>
            <p>Your ERP-synced people, attendance, leave, expenses and recruitment data—updated whenever the HRMS data changes.</p>
        </div>
        <div class="hero-actions">
            <span class="live-pill"><i class="fa-solid fa-circle"></i> @(Model.IsLive ? "Live data" : "Last synced data")</span>
            <a href="/HR/Employee" class="hero-action"><i class="fa-solid fa-users"></i> People directory</a>
        </div>
    </div>

    <div class="metric-grid">
        <a class="metric-card navy" href="/HR/Employee"><span class="metric-icon"><i class="fa-solid fa-users"></i></span><span><b>@Model.TotalEmployees</b><small>Total employees</small><em>@Model.ActiveEmployees active</em></span></a>
        <a class="metric-card teal" href="/HR/Attendance"><span class="metric-icon"><i class="fa-solid fa-calendar-check"></i></span><span><b>@Model.PresentToday</b><small>Present today</small><em>@Model.AttendanceRate% attendance rate</em></span></a>
        <a class="metric-card violet" href="/HR/Recruitment"><span class="metric-icon"><i class="fa-solid fa-briefcase"></i></span><span><b>@Model.OpenJobOpenings</b><small>Open job openings</small><em>@Model.OpenApplicants applicants in progress</em></span></a>
        <a class="metric-card amber" href="/HR/LeaveApplication"><span class="metric-icon"><i class="fa-solid fa-clock"></i></span><span><b>@(Model.PendingLeaves + Model.PendingExpenses)</b><small>Items requiring action</small><em>@Model.PendingLeaves leave · @Model.PendingExpenses expense</em></span></a>
    </div>

    <div class="dashboard-grid primary-grid">
        <article class="dash-panel attendance-panel">
            <div class="panel-heading"><div><span class="section-tag">WORKFORCE PULSE</span><h2>Today’s attendance</h2></div><a href="/HR/Attendance">Open attendance <i class="fa-solid fa-arrow-right"></i></a></div>
            <div class="attendance-body">
                <div class="attendance-ring" style="--rate:@Model.AttendanceRate"><div><strong>@Model.AttendanceRate%</strong><span>present</span></div></div>
                <div class="attendance-numbers"><div><span class="dot present"></span><b>@Model.PresentToday</b><small>Present</small></div><div><span class="dot absent"></span><b>@Model.AbsentToday</b><small>Absent</small></div><div><span class="dot late"></span><b>@Model.LateToday</b><small>Late entry</small></div></div>
            </div>
            <div class="attendance-caption">Based on today’s synced attendance records.</div>
        </article>

        <article class="dash-panel workforce-panel">
            <div class="panel-heading"><div><span class="section-tag">ORGANIZATION</span><h2>Workforce snapshot</h2></div></div>
            <div class="snapshot-grid"><div><i class="fa-solid fa-user-check"></i><b>@Model.ActiveEmployees</b><span>Active employees</span></div><div><i class="fa-solid fa-building"></i><b>@Model.ActiveDepartments</b><span>Departments</span></div><div><i class="fa-solid fa-business-time"></i><b>@Model.ActiveShiftTypes</b><span>Shift types</span></div><div><i class="fa-solid fa-file-signature"></i><b>@Model.AcceptedOffers</b><span>Accepted offers</span></div></div>
        </article>
    </div>

    <div class="dashboard-grid content-grid">
        <article class="dash-panel department-panel">
            <div class="panel-heading"><div><span class="section-tag">PEOPLE DISTRIBUTION</span><h2>Teams by headcount</h2></div><a href="/HR/Department">Departments <i class="fa-solid fa-arrow-right"></i></a></div>
            @if (Model.Departments.Any()) { <div class="department-list">@foreach (var department in Model.Departments) { var percent = department.Count * 100 / maxDepartmentCount; <div class="department-row"><div class="department-name"><span>@department.Name</span><b>@department.Count</b></div><div class="bar"><i style="width:@percent%"></i></div></div> }</div> }
            else { <div class="empty-state"><i class="fa-solid fa-building-circle-check"></i><span>Department information will appear here after sync.</span></div> }
        </article>

        <article class="dash-panel recruitment-panel">
            <div class="panel-heading"><div><span class="section-tag">RECRUITMENT</span><h2>Hiring pipeline</h2></div><a href="/HR/Recruitment">Open module <i class="fa-solid fa-arrow-right"></i></a></div>
            <div class="pipeline"><div class="pipeline-item blue"><i class="fa-solid fa-briefcase"></i><div><b>@Model.OpenJobOpenings</b><span>Open roles</span></div></div><div class="pipeline-item violet"><i class="fa-solid fa-user-clock"></i><div><b>@Model.OpenApplicants</b><span>Open applicants</span></div></div><div class="pipeline-item green"><i class="fa-solid fa-handshake"></i><div><b>@Model.AcceptedOffers</b><span>Accepted offers</span></div></div></div>
            <div class="quick-links"><a href="/HR/CreateJobOpening"><i class="fa-solid fa-plus"></i> Add job opening</a><a href="/HR/JobApplicant"><i class="fa-solid fa-arrow-up-right-from-square"></i> Review applicants</a></div>
        </article>
    </div>

    <div class="dashboard-grid bottom-grid">
        <article class="dash-panel activity-panel"><div class="panel-heading"><div><span class="section-tag">LATEST UPDATES</span><h2>HRMS activity</h2></div></div>
            @if (Model.Activities.Any()) { <div class="activity-feed">@foreach (var activity in Model.Activities) { <div class="activity-row"><span class="activity-icon @activity.Theme"><i class="fa-solid @activity.Icon"></i></span><div><b>@activity.Title</b><span>@activity.Detail</span></div><time>@activity.Date.ToString("dd MMM · hh:mm tt")</time></div> }</div> }
            else { <div class="empty-state"><i class="fa-solid fa-wave-square"></i><span>New HRMS activity will appear here.</span></div> }
        </article>
        <article class="dash-panel leave-panel"><div class="panel-heading"><div><span class="section-tag">SCHEDULE</span><h2>Upcoming leaves</h2></div><a href="/HR/LeaveApplication">View all <i class="fa-solid fa-arrow-right"></i></a></div>
            @if (Model.UpcomingLeaves.Any()) { <div class="leave-list">@foreach (var leave in Model.UpcomingLeaves) { <div class="leave-row"><span class="leave-date"><b>@(leave.FromDate?.ToString("dd") ?? "—")</b><small>@(leave.FromDate?.ToString("MMM") ?? "")</small></span><div><b>@leave.EmployeeName</b><span>@leave.LeaveType</span></div><em>@leave.Status</em></div> }</div> }
            else { <div class="empty-state"><i class="fa-solid fa-calendar-plus"></i><span>No upcoming leave requests.</span></div> }
        </article>
    </div>
    }
</section>

