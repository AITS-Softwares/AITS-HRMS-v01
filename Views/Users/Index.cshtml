@functions {
    public string GetColor(string name)
    {
        if (string.IsNullOrEmpty(name)) return "#4f46e5";
        var colors = new[] { "#4f46e5", "#7c3aed", "#2563eb", "#0891b2", "#059669", "#d97706", "#dc2626", "#6b7280" };
        var index = Math.Abs(name.GetHashCode()) % colors.Length;
        return colors[index];
    }
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Select All checkbox
            $('#selectAll').on('change', function() {
                $('.user-checkbox').prop('checked', $(this).prop('checked'));
            });

            // Auto-hide alerts
            setTimeout(function() {
                $('.alert').fadeOut('slow');
            }, 5000);
        });

        // Delete confirmation
        function confirmDelete(id, name) {
            $('#deleteUserId').val(id);
            $('#deleteUserName').text(name);
            $('#deleteModal').modal('show');
        }

        // Delete selected
        function deleteSelected() {
            var selected = $('.user-checkbox:checked');
            if (selected.length === 0) {
                alert('Please select at least one user to delete.');
                return;
            }
            if (confirm('Are you sure you want to delete ' + selected.length + ' selected user(s)?')) {
                var ids = [];
                selected.each(function() {
                    ids.push($(this).val());
                });
                $('#bulkDeleteForm input[name="ids"]').val(ids.join(','));
                $('#bulkDeleteForm').submit();
            }
        }

        // Toggle Active Status
        function toggleActive(id, name) {
            if (confirm('Are you sure you want to change the status of ' + name + '?')) {
                $.ajax({
                    url: '@Url.Action("ToggleActive", "Users")',
                    type: 'POST',
                    data: { id: id },
                    success: function(response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert(response.message || 'Error updating status.');
                        }
                    },
                    error: function() {
                        alert('Error updating status. Please try again.');
                    }
                });
            }
        }

        // Toggle Leave Status
        function toggleLeave(id, name) {
            if (confirm('Are you sure you want to change the leave status of ' + name + '?')) {
                $.ajax({
                    url: '@Url.Action("ToggleLeave", "Users")',
                    type: 'POST',
                    data: { id: id },
                    success: function(response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert(response.message || 'Error updating leave status.');
                        }
                    },
                    error: function() {
                        alert('Error updating leave status. Please try again.');
                    }
                });
            }
        }
    </script>
}