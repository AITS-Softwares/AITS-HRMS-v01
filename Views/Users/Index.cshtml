        padding: 6px 10px;
    }

    .table td:last-child {
        min-width: 160px;
    }

    }
</style>

@functions {
    public string GetColor(string name)
    {
        if (string.IsNullOrEmpty(name)) return "#4f46e5";
        var colors = new[] { "#4f46e5", "#7c3aed", "#2563eb", "#0891b2", "#059669", "#d97706", "#dc2626", "#6b7280" };
        var index = Math.Abs(name.GetHashCode()) % colors.Length;
        return colors[index];
    }
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Select All checkbox
            $('#selectAll').on('change', function() {
                $('.user-checkbox').prop('checked', $(this).prop('checked'));
            });

            // Auto-hide alerts
            setTimeout(function() {
                $('.alert').fadeOut('slow');
            }, 5000);
        });

        // Delete confirmation
        function confirmDelete(id, name) {
            $('#deleteUserId').val(id);
            $('#deleteUserName').text(name);
            $('#deleteModal').modal('show');
        }

        // Delete selected
        function deleteSelected() {
            var selected = $('.user-checkbox:checked');
            if (selected.length === 0) {
                alert('Please select at least one user to delete.');
                return;
            }
            if (confirm('Are you sure you want to delete ' + selected.length + ' selected user(s)?')) {
                var ids = [];
                selected.each(function() {
                    ids.push($(this).val());
                });
                $('#bulkDeleteForm input[name="ids"]').val(ids.join(','));
                $('#bulkDeleteForm').submit();
            }
        }

        // Toggle Active Status
        function toggleActive(id, name) {
            if (confirm('Are you sure you want to change the status of ' + name + '?')) {
                $.ajax({
                    url: '@Url.Action("ToggleActive", "Users")',
                    type: 'POST',
                    data: { id: id },
                    success: function(response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert(response.message || 'Error updating status.');
                        }
                    },
                    error: function() {
                        alert('Error updating status. Please try again.');
                    }
                });
            }
        }

        // Toggle Leave Status
        function toggleLeave(id, name) {
            if (confirm('Are you sure you want to change the leave status of ' + name + '?')) {
                $.ajax({
                    url: '@Url.Action("ToggleLeave", "Users")',
                    type: 'POST',
                    data: { id: id },
                    success: function(response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert(response.message || 'Error updating leave status.');
                        }
                    },
                    error: function() {
                        alert('Error updating leave status. Please try again.');
                    }
                });
            }
        }
    </script>
} *@

@model Erp_Aits.Models.UserViewModel
@{
    ViewData["Title"] = "Users";
    ViewData["Module"] = "Administration";
    ViewData["Icon"] = "users-gear";
    var users = ViewBag.Users as List<Erp_Aits.Models.User>;
    var search = ViewBag.SearchModel as Erp_Aits.Models.UserSearchModel;
    var loginType = Context.Session.GetString("LoginType") ?? "User";
    var userRole = Context.Session.GetString("UserRole") ?? "User";
    var isFullAccess = loginType == "Company" || userRole == "Admin";
}

<!-- Stats Cards -->
<div class="stats-row">
    <div class="stat-card">
        <div class="stat-icon blue">
            <i class="fas fa-users"></i>
        </div>
        <div class="stat-info">
            <div class="stat-number">@(users?.Count ?? 0)</div>
            <div class="stat-label">Total Users</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon green">
            <i class="fas fa-user-check"></i>
        </div>
        <div class="stat-info">
            <div class="stat-number">@(users?.Count(x => x.IsActive) ?? 0)</div>
            <div class="stat-label">Active Users</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon orange">
            <i class="fas fa-user-clock"></i>
        </div>
        <div class="stat-info">
            <div class="stat-number">@(users?.Count(x => x.OnLeave) ?? 0)</div>
            <div class="stat-label">On Leave</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon purple">
            <i class="fas fa-user-tie"></i>
        </div>
        <div class="stat-info">
            <div class="stat-number">@(users?.Count(x => x.Role == "Admin") ?? 0)</div>
            <div class="stat-label">Admins</div>
        </div>
    </div>
</div>

<div class="content-card">
    <div class="card-header-custom">
        <h5>
            <i class="fas fa-users"></i> User List
            <span class="badge-count primary">@(users?.Count ?? 0)</span>
        </h5>
        @if (isFullAccess)
        {
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="fas fa-user-plus"></i> Add User
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search / Filter -->
    <div class="search-filter-bar">
        <form asp-action="Index" method="get" class="row g-2">
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="fas fa-search text-muted"></i>
                    </span>
                    <input type="text" name="SearchTerm" class="form-control border-start-0"
                           placeholder="Search users..." value="@search?.SearchTerm" />
                </div>
            </div>
            <div class="col-md-2">
                <select name="Role" class="form-control">
                    <option value="">All Roles</option>
                    @foreach (var role in Model.RoleList)
                    {
                        <option value="@role" selected="@(search?.Role == role)">@role</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="IsActive" class="form-control">
                    <option value="">All Status</option>
                    <option value="true" selected="@(search?.IsActive == true)">Active</option>
                    <option value="false" selected="@(search?.IsActive == false)">Inactive</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="OnLeave" class="form-control">
                    <option value="">All Leave</option>
                    <option value="true" selected="@(search?.OnLeave == true)">On Leave</option>
                    <option value="false" selected="@(search?.OnLeave == false)">Not on Leave</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fas fa-search"></i> Search
                </button>
                <a asp-action="Index" class="btn btn-secondary btn-sm">
                    <i class="fas fa-undo"></i> Reset
                </a>
            </div>
        </form>
    </div>

    <!-- Table -->
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th style="width: 40px;">
                        @if (isFullAccess)
                        {
                            <input type="checkbox" id="selectAll" class="form-check-input" />
                        }
                    </th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Leave</th>
                    <th>Created</th>
                    <th style="min-width: 280px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (users != null && users.Any())
                {
                    @foreach (var item in users)
                    {
                        <tr>
                            <td>
                                @if (isFullAccess)
                                {
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input user-checkbox" value="@item.Id" />
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar-sm me-2" style="background: @GetColor(item.Name);">
                                        @item.Name?.Substring(0, 1)
                                    </div>
                                    <div>
                                        <div class="fw-semibold">@item.Name</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <a href="mailto:@item.Email" class="text-primary text-decoration-none">
                                    <i class="fas fa-envelope me-1"></i>
                                    @item.Email
                                </a>
                            </td>
                            <td>
                                <span class="badge bg-@(item.Role == "Admin" ? "danger" :
                                                                                                                                                                                               item.Role == "Manager" ? "warning" :
                                                                                                                                                                                               item.Role == "User" ? "info" : "secondary")">
                            @item.Role
                        </span>
                    </td>
                    <td>
                        <span class="status-badge @(item.IsActive ? "active" : "inactive")">
                            @(item.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td>
                        <span class="status-badge @(item.OnLeave ? "onleave" : "active")">
                            @(item.OnLeave ? "On Leave" : "Active")
                        </span>
                    </td>
                    <td>
                        <span class="text-muted small">@item.CreatedDate.ToString("dd MMM yyyy")</span>
                    </td>
                    <td>
                        <div class="action-buttons">
                            <!-- View Button - Always Visible -->
                            <a asp-action="Details" asp-route-id="@item.Id" class="action-btn view-btn" title="View">
                                <i class="fas fa-eye"></i>
                            </a>

                            @if (isFullAccess)
                                    {
                                        <!-- Edit Button -->
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn edit-btn" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        <!-- Toggle Active/Deactivate Button -->
                                        <button type="button" class="action-btn @(item.IsActive ? "deactivate-btn" : "activate-btn")"
                                                onclick="toggleActive(@item.Id, '@item.Name')" title="@(item.IsActive ? "Deactivate" : "Activate")">
                                            <i class="fas @(item.IsActive ? "fa-user-slash" : "fa-user-check")"></i>
                                        </button>

                                        <!-- Toggle Leave Button -->
                                        <button type="button" class="action-btn @(item.OnLeave ? "removeleave-btn" : "setleave-btn")"
                                                onclick="toggleLeave(@item.Id, '@item.Name')" title="@(item.OnLeave ? "Remove Leave" : "Set Leave")">
                                            <i class="fas fa-user-clock"></i>
                                        </button>

                                        <!-- Delete Button -->
                                        <button type="button" class="action-btn delete-btn" onclick="confirmDelete(@item.Id, '@item.Name')" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <!-- Disabled buttons for non-admin users -->
                                        <button type="button" class="action-btn edit-btn disabled" title="Edit (Permission Denied)" disabled>
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button type="button" class="action-btn deactivate-btn disabled" title="Deactivate (Permission Denied)" disabled>
                                            <i class="fas fa-user-slash"></i>
                                        </button>
                                        <button type="button" class="action-btn setleave-btn disabled" title="Set Leave (Permission Denied)" disabled>
                                            <i class="fas fa-user-clock"></i>
                                        </button>
                                        <button type="button" class="action-btn delete-btn disabled" title="Delete (Permission Denied)" disabled>
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4">
                            <div class="empty-state">
                                <i class="fas fa-users-slash fa-3x text-muted mb-3"></i>
                                <h6 class="text-muted">No users found</h6>
                                <p class="text-muted small">Create your first user to get started</p>
                                @if (isFullAccess)
                                {
                                    <a asp-action="Create" class="btn btn-primary btn-sm mt-2">
                                        <i class="fas fa-user-plus"></i> Add User
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Table Footer -->
    @if (users != null && users.Any() && isFullAccess)
    {
        <div class="table-footer">
            <div class="d-flex justify-content-between align-items-center">
                <div class="text-muted small">
                    Showing all <strong>@users.Count</strong> users
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary btn-sm" onclick="deleteSelected()">
                        <i class="fas fa-trash"></i> Delete Selected
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content" style="border-radius: 16px; border: none; box-shadow: 0 20px 60px rgba(0,0,0,0.15);">
            <div class="modal-header border-0" style="padding: 20px 24px 0;">
                <h5 class="modal-title text-danger">
                    <i class="fas fa-exclamation-triangle"></i> Delete User
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding: 16px 24px;">
                <p class="mb-0">Are you sure you want to delete <strong id="deleteUserName"></strong>?</p>
                <p class="text-muted small mb-0">This action cannot be undone.</p>
            </div>
            <div class="modal-footer border-0" style="padding: 0 24px 24px;">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <form id="deleteForm" method="post" asp-action="Delete">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteUserId" />
                    <button type="submit" class="btn btn-danger btn-sm">
                        <i class="fas fa-trash"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Bulk Delete Form -->
<form id="bulkDeleteForm" method="post" asp-action="BulkDelete" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="ids" />
</form>

