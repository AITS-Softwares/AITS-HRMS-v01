</style>

@functions {
    public string GetColor(string name)
    {
        if (string.IsNullOrEmpty(name)) return "#4f46e5";
        var colors = new[] { "#4f46e5", "#7c3aed", "#2563eb", "#0891b2", "#059669", "#d97706", "#dc2626", "#6b7280" };
        var index = Math.Abs(name.GetHashCode()) % colors.Length;
        return colors[index];
    }
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Load stats
            $.ajax({
                url: '@Url.Action("GetStats", "Opportunities")',
                type: 'GET',
                success: function(data) {
                    if (data) {
                        $('#totalOpportunities').text(data.total || 0);
                        $('#activeOpportunities').text(data.active || 0);
                        $('#negotiationOpportunities').text(data.negotiation || 0);
                        $('#closedWonOpportunities').text(data.closedWon || 0);
                    }
                },
                error: function(xhr, status, error) {
                    console.log("Error loading stats:", error);
                    $('#totalOpportunities').text('0');
                    $('#activeOpportunities').text('0');
                    $('#negotiationOpportunities').text('0');
                    $('#closedWonOpportunities').text('0');
                }
            });

            // Auto-hide alerts
            setTimeout(function() {
                $('.alert').fadeOut('slow');
            }, 5000);
        });

        function confirmDelete(id, name) {
            $('#deleteOpportunityId').val(id);
            $('#deleteOpportunityName').text(name);
            $('#deleteModal').modal('show');
        }

        function copyOpportunity(id) {
            if (confirm('Are you sure you want to duplicate this opportunity?')) {
                window.location.href = '@Url.Action("Create")?copyFrom=' + id;
            }
        }
    </script>
} *@

@using Microsoft.Extensions.Configuration
@using Microsoft.Data.SqlClient
@using System.Collections.Generic
@using System.Data
@inject IConfiguration _configuration

@model Erp_Aits.Models.OpportunityViewModel
@{
    ViewData["Title"] = "Opportunities";
    ViewData["Module"] = "CRM";
    ViewData["Icon"] = "rocket";
    var opportunities = ViewBag.Opportunities as List<Erp_Aits.Models.Opportunity>;
    var search = ViewBag.SearchModel as Erp_Aits.Models.OpportunitySearchModel;
    var loginType = Context.Session.GetString("LoginType") ?? "User";
    var userRole = Context.Session.GetString("UserRole") ?? "User";
    var userId = Context.Session.GetString("UserId");
    var isFullAccess = loginType == "Company" || userRole == "Admin";

    // Check specific page access from database
    var canCreateOpportunity = false;
    var canEditOpportunity = false;
    var canDeleteOpportunity = false;

    if (!string.IsNullOrEmpty(userId))
    {
        try
        {
            var connectionString = _configuration.GetConnectionString("DefaultConnection");
            using (var conn = new SqlConnection(connectionString))
            {
                conn.Open();

                // Check Opportunity Create access (PermissionId 14)
                string query = @"
                    SELECT CASE
                        WHEN EXISTS (
                            SELECT 1 FROM UserPermissions
                            WHERE UserId = @UserId
                            AND PermissionId = 14
                            AND CanCreate = 1
                        ) THEN 1
                        WHEN EXISTS (
                            SELECT 1 FROM RolePermissions rp
                            INNER JOIN Users u ON u.Role = rp.RoleName
                            WHERE u.Id = @UserId
                            AND rp.PermissionId = 14
                            AND rp.CanCreate = 1
                        ) THEN 1
                        ELSE 0
                    END AS HasAccess";

                using (var cmd = new SqlCommand(query, conn))
                {
                    cmd.Parameters.AddWithValue("@UserId", int.Parse(userId));
                    var result = cmd.ExecuteScalar();
                    canCreateOpportunity = result != null && Convert.ToInt32(result) == 1;
                }

                // Check Opportunity Edit access (PermissionId 15)
                query = @"
                    SELECT CASE
                        WHEN EXISTS (
                            SELECT 1 FROM UserPermissions
                            WHERE UserId = @UserId
                            AND PermissionId = 15
                            AND CanEdit = 1
                        ) THEN 1
                        WHEN EXISTS (
                            SELECT 1 FROM RolePermissions rp
                            INNER JOIN Users u ON u.Role = rp.RoleName
                            WHERE u.Id = @UserId
                            AND rp.PermissionId = 15
                            AND rp.CanEdit = 1
                        ) THEN 1
                        ELSE 0
                    END AS HasAccess";

                using (var cmd = new SqlCommand(query, conn))
                {
                    cmd.Parameters.AddWithValue("@UserId", int.Parse(userId));
                    var result = cmd.ExecuteScalar();
                    canEditOpportunity = result != null && Convert.ToInt32(result) == 1;
                }

                // Check Opportunity Delete access (PermissionId 16)
                query = @"
                    SELECT CASE
                        WHEN EXISTS (
                            SELECT 1 FROM UserPermissions
                            WHERE UserId = @UserId
                            AND PermissionId = 16
                            AND CanDelete = 1
                        ) THEN 1
                        WHEN EXISTS (
                            SELECT 1 FROM RolePermissions rp
                            INNER JOIN Users u ON u.Role = rp.RoleName
                            WHERE u.Id = @UserId
                            AND rp.PermissionId = 16
                            AND rp.CanDelete = 1
                        ) THEN 1
                        ELSE 0
                    END AS HasAccess";

                using (var cmd = new SqlCommand(query, conn))
                {
                    cmd.Parameters.AddWithValue("@UserId", int.Parse(userId));
                    var result = cmd.ExecuteScalar();
                    canDeleteOpportunity = result != null && Convert.ToInt32(result) == 1;
                }
            }
        }
        catch (Exception ex)
        {
            // Fallback to role-based access
            canCreateOpportunity = isFullAccess || userRole == "Manager" || userRole == "User";
            canEditOpportunity = isFullAccess || userRole == "Manager";
            canDeleteOpportunity = isFullAccess;
        }
    }
    else
    {
        canCreateOpportunity = isFullAccess || userRole == "Manager" || userRole == "User";
        canEditOpportunity = isFullAccess || userRole == "Manager";
        canDeleteOpportunity = isFullAccess;
    }
}

<div class="content-card">
    <div class="card-header-custom">
        <h5>
            <i class="fas fa-list"></i> Opportunity List
        </h5>
        <div class="d-flex gap-2">
            @if (canCreateOpportunity)
            {
                <a asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus"></i> Add Opportunity
                </a>
            }
            <a asp-controller="Leads" asp-action="Index" class="btn btn-secondary btn-sm">
                <i class="fas fa-arrow-left"></i> Back to Leads
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search / Filter -->
    <form asp-action="Index" method="get" class="row g-3 mb-4">
        <div class="col-md-3">
            <input type="text" name="SearchTerm" class="form-control" placeholder="Search opportunities..." value="@search?.SearchTerm" />
        </div>
        <div class="col-md-2">
            <select name="SalesStage" class="form-control">
                <option value="">All Stages</option>
                @if (Model.SalesStageList != null)
                {
                    @foreach (var stage in Model.SalesStageList)
                    {
                        <option value="@stage" selected="@(search?.SalesStage == stage)">@stage</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="OpportunityType" class="form-control">
                <option value="">All Types</option>
                @if (Model.OpportunityTypeList != null)
                {
                    @foreach (var type in Model.OpportunityTypeList)
                    {
                        <option value="@type" selected="@(search?.OpportunityType == type)">@type</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="Source" class="form-control">
                <option value="">All Sources</option>
                @if (Model.SourceList != null)
                {
                    @foreach (var source in Model.SourceList)
                    {
                        <option value="@source" selected="@(search?.Source == source)">@source</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <input type="text" name="Company" class="form-control" placeholder="Company..." value="@search?.Company" />
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-search"></i> Search
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-undo"></i> Reset
            </a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Company</th>
                    <th>Opportunity From</th>
                    <th>Type</th>
                    <th>Stage</th>
                    <th>Source</th>
                    <th>Amount</th>
                    <th>Probability</th>
                    <th>Expected Close</th>
                    <th style="min-width: 200px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (opportunities != null && opportunities.Any())
                {
                    @foreach (var item in opportunities)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar-sm me-2" style="background: @GetColor(item.Company);">
                                        @item.Company?.Substring(0, 1)
                                    </div>
                                    <div>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="company-link" title="View Details">
                                            @item.Company
                                        </a>
                                    </div>
                                </div>
                            </td>
                            <td>@item.OpportunityFrom</td>
                            <td>
                                <span class="type-badge">@item.OpportunityType</span>
                            </td>
                            <td>
                                <span class="badge bg-@(item.SalesStage?.ToLower()?.Contains("prospecting") == true ? "primary" :
                                                                                                                                       item.SalesStage?.ToLower()?.Contains("qualification") == true ? "info" :
                                                                                                                                       item.SalesStage?.ToLower()?.Contains("negotiation") == true ? "warning" :
                                                                                                                                       item.SalesStage?.ToLower()?.Contains("closed won") == true ? "success" :
                                                                                                                                       item.SalesStage?.ToLower()?.Contains("closed lost") == true ? "danger" : "secondary")">
                            @item.SalesStage
                        </span>
                    </td>
                    <td>
                        <span class="source-badge">
                            <i class="fas fa-globe me-1"></i> @item.Source
                        </span>
                    </td>
                    <td>
                        <span class="fw-semibold">@(item.Amount?.ToString("C") ?? "N/A")</span>
                        <div class="text-muted small">@item.Currency</div>
                    </td>
                    <td>
                        <div class="progress" style="height: 20px; width: 80px;">
                            <div class="progress-bar bg-@(item.Probability >= 70 ? "success" :
                                                                                                                                                                                           item.Probability >= 40 ? "warning" : "danger")"
                                 role="progressbar" style="width: @(item.Probability ?? 0)%">
                                @(item.Probability ?? 0)%
                            </div>
                        </div>
                    </td>
                    <td>@(item.ExpectedClosingDate?.ToString("dd MMM yyyy") ?? "N/A")</td>
                    <td>
                        <div class="btn-group btn-group-sm" role="group">
                            <!-- View Button - Always Visible -->
                            @* <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info" title="View">
                                <i class="fas fa-eye"></i>
                            </a> *@

                            @if (canEditOpportunity)
                                    {
                                        <!-- Edit Button -->
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-warning disabled" title="Edit (Permission Denied)" disabled>
                                            <i class="fas fa-edit"></i>
                                        </button>
                                    }

                                    <!-- Duplicate Button - Based on Create Permission -->
                                    @if (canCreateOpportunity)
                                    {
                                        <button type="button" class="btn btn-success" onclick="copyOpportunity(@item.Id)" title="Duplicate">
                                            <i class="fas fa-copy"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-success disabled" title="Duplicate (Permission Denied)" disabled>
                                            <i class="fas fa-copy"></i>
                                        </button>
                                    }

                                    @if (canDeleteOpportunity)
                                    {
                                        <!-- Delete Button -->
                                        <button type="button" class="btn btn-danger" onclick="confirmDelete(@item.Id, '@item.Company')" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-danger disabled" title="Delete (Permission Denied)" disabled>
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">
                            <i class="fas fa-inbox fa-2x d-block mb-2"></i>
                            No opportunities found. Create your first opportunity!
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header border-0" style="padding: 20px 24px 0;">
                <h5 class="modal-title text-danger">
                    <i class="fas fa-exclamation-triangle"></i> Delete Opportunity
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding: 16px 24px;">
                <p class="mb-0">Are you sure you want to delete <strong id="deleteOpportunityName"></strong>?</p>
                <p class="text-muted small mb-0">This action cannot be undone.</p>
            </div>
            <div class="modal-footer border-0" style="padding: 0 24px 24px;">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <form id="deleteForm" method="post" asp-action="Delete">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteOpportunityId" />
                    <button type="submit" class="btn btn-danger btn-sm">
                        <i class="fas fa-trash"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    /* ============================================
               OPPORTUNITIES PAGE - LEAD STYLE
               ============================================ */

    /* Company Link Style */
