            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        }

        .btn-group-sm .btn.disabled {
            opacity: 0.4;
            cursor: not-allowed;
            pointer-events: none;
        }

    .btn-info {
        background: #0dcaf0;
    }

        .btn-info:hover:not(.disabled) {
            background: #0bb5d8;
        }

    .btn-warning {
        background: #ffc107;
        color: #212529;
    }

        .btn-warning:hover:not(.disabled) {
            background: #e0a800;
            color: #212529;
        }

        .btn-warning.disabled {
            opacity: 0.4;
            cursor: not-allowed;
            pointer-events: none;
        }

    .btn-success {
        background: #198754;
    }

        .btn-success:hover:not(.disabled) {
            background: #157347;
        }

        .btn-success.disabled {
            opacity: 0.4;
            cursor: not-allowed;
            pointer-events: none;
        }

    .btn-danger {
