@functions {
    public string GetColor(string name)
    {
        if (string.IsNullOrEmpty(name)) return "#4f46e5";
        var colors = new[] { "#4f46e5", "#7c3aed", "#2563eb", "#0891b2", "#059669", "#d97706", "#dc2626", "#6b7280" };
        var index = Math.Abs(name.GetHashCode()) % colors.Length;
        return colors[index];
    }
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Load stats
            $.ajax({
                url: '@Url.Action("GetStats", "Opportunities")',
                type: 'GET',
                success: function(data) {
                    if (data) {
                        $('#totalOpportunities').text(data.total || 0);
                        $('#activeOpportunities').text(data.active || 0);
                        $('#negotiationOpportunities').text(data.negotiation || 0);
                        $('#closedWonOpportunities').text(data.closedWon || 0);
                    }
                },
                error: function(xhr, status, error) {
                    console.log("Error loading stats:", error);
                    $('#totalOpportunities').text('0');
                    $('#activeOpportunities').text('0');
                    $('#negotiationOpportunities').text('0');
                    $('#closedWonOpportunities').text('0');
                }
            });

            // Auto-hide alerts
            setTimeout(function() {
                $('.alert').fadeOut('slow');
            }, 5000);
        });

        function confirmDelete(id, name) {
            $('#deleteOpportunityId').val(id);
            $('#deleteOpportunityName').text(name);
            $('#deleteModal').modal('show');
        }

        function copyOpportunity(id) {
            if (confirm('Are you sure you want to duplicate this opportunity?')) {
                window.location.href = '@Url.Action("Create")?copyFrom=' + id;
            }
        }
    </script>
}