</style>

@section Scripts {
    <script>
        var opportunityId = @Model.Id;

        $(document).ready(function() {
            // Load tasks and events on page load
            loadTasks(opportunityId);
            loadEvents(opportunityId);

            // Auto-hide alerts
            setTimeout(function() {
                $('.alert').fadeOut('slow');
            }, 5000);

            // Delete button
            $('.btn-danger').on('click', function(e) {
                if (!confirm('Are you sure you want to delete this opportunity?')) {
                    e.preventDefault();
                }
            });
        });

        // ============================================
        // TASK FUNCTIONS
        // ============================================
        function openCreateTaskModal(oppId) {
            $.ajax({
                url: '@Url.Action("CreateTaskModal", "Tasks")',
                type: 'GET',
                data: { opportunityId: oppId },
                success: function(data) {
                    $('#createTaskModalContainer').html(data);
                    $('#createTaskModal').modal('show');
                },
                error: function() {
                    alert('Error loading task form.');
                }
            });
        }

        function loadTasks(oppId) {
            $.ajax({
                url: '@Url.Action("GetTasks", "Tasks")',
                type: 'GET',
                data: { opportunityId: oppId },
                success: function(data) {
                    var html = '';
                    if (data && data.length > 0) {
                        html += '<div class="table-responsive">';
                        html += '<table class="table table-hover">';
                        html += '<thead><tr><th>Assigned To</th><th>Date</th><th>Summary</th><th>Status</th><th>Priority</th></tr></thead>';
                        html += '<tbody>';
                        $.each(data, function(i, task) {
                            var statusColor = task.status == 'Completed' ? 'success' :
                                             task.status == 'In Progress' ? 'warning' :
                                             task.status == 'Cancelled' ? 'danger' : 'secondary';
                            var priorityColor = task.priority == 'Urgent' ? 'danger' :
                                               task.priority == 'High' ? 'warning' :
                                               task.priority == 'Low' ? 'secondary' : 'info';
                            html += '<tr>';
                            html += '<td>' + (task.assignedTo || 'Unassigned') + '</td>';
                            html += '<td>' + task.taskDate + '</td>';
                            html += '<td>' + task.summary + '</td>';
                            html += '<td><span class="badge bg-' + statusColor + '">' + task.status + '</span></td>';
                            html += '<td><span class="badge bg-' + priorityColor + '">' + (task.priority || 'N/A') + '</span></td>';
                            html += '</tr>';
                        });
                        html += '</tbody></table></div>';
                    } else {
                        html = '<div class="text-center text-muted py-3"><i class="fas fa-inbox fa-2x d-block mb-2"></i>No tasks found.</div>';
                    }
                    $('#tasksList').html(html);
                },
                error: function() {
                    $('#tasksList').html('<div class="text-center text-muted py-3">Error loading tasks.</div>');
                }
            });
        }

        // ============================================
        // EVENT FUNCTIONS
        // ============================================
        function openCreateEventModal(oppId) {
            $.ajax({
                url: '@Url.Action("CreateEventModal", "Events")',
                type: 'GET',
                data: { opportunityId: oppId },
                success: function(data) {
                    $('#createEventModalContainer').html(data);
                    $('#createEventModal').modal('show');
                },
                error: function() {
                    alert('Error loading event form.');
                }
            });
        }

        function loadEvents(oppId) {
            $.ajax({
                url: '@Url.Action("GetEvents", "Events")',
                type: 'GET',
                data: { opportunityId: oppId },
                success: function(data) {
                    var html = '';
                    if (data && data.length > 0) {
                        html += '<div class="table-responsive">';
                        html += '<table class="table table-hover">';
                        html += '<thead><tr><th>Type</th><th>Assigned To</th><th>Date</th><th>Summary</th><th>Status</th></tr></thead>';
                        html += '<tbody>';
                        $.each(data, function(i, event) {
                            var typeIcon = event.eventType == 'Call' ? 'fa-phone' :
                                          event.eventType == 'Email' ? 'fa-envelope' :
                                          event.eventType == 'Meeting' ? 'fa-handshake' :
                                          event.eventType == 'Demo' ? 'fa-laptop' : 'fa-calendar';
                            var statusColor = event.status == 'Completed' ? 'success' :
                                             event.status == 'Cancelled' ? 'danger' :
                                             event.status == 'Postponed' ? 'warning' : 'secondary';
                            html += '<tr>';
                            html += '<td><i class="fas ' + typeIcon + ' me-1"></i> ' + event.eventType + '</td>';
                            html += '<td>' + (event.assignedTo || 'Unassigned') + '</td>';
                            html += '<td>' + event.eventDate + '</td>';
                            html += '<td>' + event.summary + '</td>';
                            html += '<td><span class="badge bg-' + statusColor + '">' + event.status + '</span></td>';
                            html += '</tr>';
                        });
                        html += '</tbody></table></div>';
                    } else {
                        html = '<div class="text-center text-muted py-3"><i class="fas fa-calendar-times fa-2x d-block mb-2"></i>No events found.</div>';
                    }
                    $('#eventsList').html(html);
                },
                error: function() {
                    $('#eventsList').html('<div class="text-center text-muted py-3">Error loading events.</div>');
                }
            });
        }
    </script>
} *@

@using Microsoft.Extensions.Configuration
@using Microsoft.Data.SqlClient
@using System.Collections.Generic
@using System.Data
@inject IConfiguration _configuration
@model Erp_Aits.Models.Opportunity
@{
    ViewData["Title"] = "Opportunity Details";
    ViewData["Module"] = "CRM";
    ViewData["Icon"] = "rocket";
    var loginType = Context.Session.GetString("LoginType") ?? "User";
    var userRole = Context.Session.GetString("UserRole") ?? "User";
    var userId = Context.Session.GetString("UserId");
    var isFullAccess = loginType == "Company" || userRole == "Admin";

    // Check specific page access from database
    var canEditOpportunity = false;
    var canDeleteOpportunity = false;
    var canCreateTask = false;
    var canCreateEvent = false;

    if (!string.IsNullOrEmpty(userId))
    {
        try
        {
            var connectionString = _configuration.GetConnectionString("DefaultConnection");
            using (var conn = new SqlConnection(connectionString))
            {
                conn.Open();

                // Check Opportunity Edit access (PermissionId 15)
                string query = @"
                    SELECT CASE
                        WHEN EXISTS (
                            SELECT 1 FROM UserPermissions
                            WHERE UserId = @UserId
                            AND PermissionId = 15
                            AND CanEdit = 1
                        ) THEN 1
                        WHEN EXISTS (
                            SELECT 1 FROM RolePermissions rp
                            INNER JOIN Users u ON u.Role = rp.RoleName
                            WHERE u.Id = @UserId
                            AND rp.PermissionId = 15
                            AND rp.CanEdit = 1
                        ) THEN 1
                        ELSE 0
                    END AS HasAccess";

                using (var cmd = new SqlCommand(query, conn))
                {
                    cmd.Parameters.AddWithValue("@UserId", int.Parse(userId));
                    var result = cmd.ExecuteScalar();
                    canEditOpportunity = result != null && Convert.ToInt32(result) == 1;
                }

                // Check Opportunity Delete access (PermissionId 16)
                query = @"
                    SELECT CASE
                        WHEN EXISTS (
                            SELECT 1 FROM UserPermissions
                            WHERE UserId = @UserId
                            AND PermissionId = 16
                            AND CanDelete = 1
                        ) THEN 1
                        WHEN EXISTS (
                            SELECT 1 FROM RolePermissions rp
                            INNER JOIN Users u ON u.Role = rp.RoleName
                            WHERE u.Id = @UserId
                            AND rp.PermissionId = 16
                            AND rp.CanDelete = 1
                        ) THEN 1
                        ELSE 0
                    END AS HasAccess";

                using (var cmd = new SqlCommand(query, conn))
                {
                    cmd.Parameters.AddWithValue("@UserId", int.Parse(userId));
                    var result = cmd.ExecuteScalar();
                    canDeleteOpportunity = result != null && Convert.ToInt32(result) == 1;
                }

                // Check Task Create access (PermissionId 28)
                query = @"
                    SELECT CASE
                        WHEN EXISTS (
                            SELECT 1 FROM UserPermissions
                            WHERE UserId = @UserId
                            AND PermissionId = 28
                            AND CanCreate = 1
                        ) THEN 1
                        WHEN EXISTS (
                            SELECT 1 FROM RolePermissions rp
                            INNER JOIN Users u ON u.Role = rp.RoleName
                            WHERE u.Id = @UserId
                            AND rp.PermissionId = 28
                            AND rp.CanCreate = 1
                        ) THEN 1
                        ELSE 0
                    END AS HasAccess";

                using (var cmd = new SqlCommand(query, conn))
                {
                    cmd.Parameters.AddWithValue("@UserId", int.Parse(userId));
                    var result = cmd.ExecuteScalar();
                    canCreateTask = result != null && Convert.ToInt32(result) == 1;
                }

                // Check Event Create access (PermissionId 34)
                query = @"
                    SELECT CASE
                        WHEN EXISTS (
                            SELECT 1 FROM UserPermissions
                            WHERE UserId = @UserId
                            AND PermissionId = 34
                            AND CanCreate = 1
                        ) THEN 1
                        WHEN EXISTS (
                            SELECT 1 FROM RolePermissions rp
                            INNER JOIN Users u ON u.Role = rp.RoleName
                            WHERE u.Id = @UserId
                            AND rp.PermissionId = 34
                            AND rp.CanCreate = 1
                        ) THEN 1
                        ELSE 0
                    END AS HasAccess";

                using (var cmd = new SqlCommand(query, conn))
                {
                    cmd.Parameters.AddWithValue("@UserId", int.Parse(userId));
                    var result = cmd.ExecuteScalar();
                    canCreateEvent = result != null && Convert.ToInt32(result) == 1;
                }
            }
        }
        catch (Exception ex)
        {
            // Fallback to role-based access
            canEditOpportunity = isFullAccess || userRole == "Manager";
            canDeleteOpportunity = isFullAccess;
            canCreateTask = isFullAccess || userRole == "Manager" || userRole == "User";
            canCreateEvent = isFullAccess || userRole == "Manager" || userRole == "User";
        }
    }
    else
    {
        canEditOpportunity = isFullAccess || userRole == "Manager";
        canDeleteOpportunity = isFullAccess;
        canCreateTask = isFullAccess || userRole == "Manager" || userRole == "User";
        canCreateEvent = isFullAccess || userRole == "Manager" || userRole == "User";
    }
}

<div class="content-card">
