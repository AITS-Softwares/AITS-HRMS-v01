            color: #4f46e5;
        }

        .quick-stat-icon.green {
            background: #dcfce7;
            color: #16a34a;
        }

        .quick-stat-icon.orange {
            background: #fef3c7;
            color: #d97706;
        }

        .quick-stat-icon.purple {
            background: #f3e8ff;
            color: #7c3aed;
        }

    .quick-stat-info {
        display: flex;
        flex-direction: column;
        line-height: 1.3;
    }

    .quick-stat-label {
        font-size: 11px;
        color: #94a3b8;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .quick-stat-value {
        font-size: 14px;
        font-weight: 600;
