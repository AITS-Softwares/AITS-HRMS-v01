            }

    .content-card {
        padding: 16px;
    }

    .table thead th {
        font-size: 10px;
        padding: 6px 8px;
    }

    .table tbody td {
        padding: 6px 8px;
        font-size: 12px;
    }

    }

    @@media (max-width: 576px) {
        .quick-stats-row

    {
        grid-template-columns: 1fr 1fr;
    }

    .card-header-custom h5 {
        font-size: 15px;
    }

    .detail-value {
        font-size: 12px;
    }

    .card-header-custom .d-flex .btn {
        font-size: 11px;
        padding: 4px 10px;
    }

        .card-header-custom .d-flex .btn i {
            margin-right: 3px;
        }

