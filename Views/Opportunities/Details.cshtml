@* @model Erp_Aits.Models.Opportunity
@{
    ViewData["Title"] = "Opportunity Details";
    ViewData["Module"] = "CRM";
    ViewData["Icon"] = "rocket";
}

<div class="content-card">
    <div class="card-header-custom">
        <div class="d-flex align-items-center gap-3">
            <div class="status-indicator @(Model.SalesStage?.ToLower()?.Replace(" ", "") ?? "prospecting")"></div>
            <h5 class="mb-0">
                <i class="fas fa-rocket"></i>
                @Model.Company
                <span class="status-badge @(Model.SalesStage?.ToLower()?.Replace(" ", "") ?? "prospecting") ms-2">
                    @Model.SalesStage
                </span>
            </h5>
        </div>
        <div class="d-flex align-items-center gap-2">
            <!-- Create Task Button -->
            <button type="button" class="btn btn-primary btn-sm" onclick="openCreateTaskModal(@Model.Id)">
                <i class="fas fa-tasks"></i> Task
            </button>

            <!-- Create Event Button -->
            <button type="button" class="btn btn-info btn-sm" onclick="openCreateEventModal(@Model.Id)">
                <i class="fas fa-calendar-plus"></i> Event
            </button>

            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">
                <i class="fas fa-edit"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-secondary btn-sm">
                <i class="fas fa-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <!-- Quick Stats Row -->
    <div class="quick-stats-row">
        <div class="quick-stat-item">
            <div class="quick-stat-icon blue"><i class="fas fa-calendar"></i></div>
            <div class="quick-stat-info">
                <span class="quick-stat-label">Created</span>
                <span class="quick-stat-value">@Model.CreatedDate.ToString("dd MMM yyyy")</span>
            </div>
        </div>
        <div class="quick-stat-item">
            <div class="quick-stat-icon green"><i class="fas fa-dollar-sign"></i></div>
            <div class="quick-stat-info">
                <span class="quick-stat-label">Amount</span>
                <span class="quick-stat-value">@(Model.Amount?.ToString("C") ?? "N/A")</span>
            </div>
        </div>
        <div class="quick-stat-item">
            <div class="quick-stat-icon orange"><i class="fas fa-percentage"></i></div>
            <div class="quick-stat-info">
                <span class="quick-stat-label">Probability</span>
                <span class="quick-stat-value">@(Model.Probability ?? 0)%</span>
            </div>
        </div>
        <div class="quick-stat-item">
            <div class="quick-stat-icon purple"><i class="fas fa-user"></i></div>
            <div class="quick-stat-info">
                <span class="quick-stat-label">Source</span>
                <span class="quick-stat-value">@(Model.Source ?? "N/A")</span>
            </div>
        </div>
    </div>

    <!-- Main Details -->
    <div class="row mt-3">
        <!-- Left Column -->
        <div class="col-lg-6">
            <!-- Opportunity Details -->
            <div class="detail-section">
                <div class="detail-header">
                    <i class="fas fa-info-circle text-primary"></i>
                    <h6>Opportunity Details</h6>
                </div>
                <div class="detail-body">
                    <div class="detail-row">
                        <span class="detail-label">Opportunity From</span>
                        <span class="detail-value">@(Model.OpportunityFrom ?? "N/A")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Opportunity Type</span>
                        <span class="detail-value">@(Model.OpportunityType ?? "N/A")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Sales Stage</span>
                        <span class="detail-value">
                            <span class="status-badge @(Model.SalesStage?.ToLower()?.Replace(" ", "") ?? "prospecting")">
                                @Model.SalesStage
                            </span>
                        </span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Expected Closing Date</span>
                        <span class="detail-value">@(Model.ExpectedClosingDate?.ToString("dd MMM yyyy") ?? "N/A")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Probability</span>
                        <span class="detail-value">
                            <div class="progress" style="height: 20px; width: 150px;">
                                <div class="progress-bar bg-@(Model.Probability >= 70 ? "success" :
                                                                                                     Model.Probability >= 40 ? "warning" : "danger")"
                                     role="progressbar" style="width: @(Model.Probability ?? 0)%">
                                    @(Model.Probability ?? 0)%
                                </div>
                            </div>
                        </span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Source</span>
                        <span class="detail-value">@(Model.Source ?? "N/A")</span>
                    </div>
                </div>
            </div>

            <!-- Opportunity Value -->
            <div class="detail-section">
                <div class="detail-header">
                    <i class="fas fa-dollar-sign text-amber"></i>
                    <h6>Opportunity Value</h6>
                </div>
                <div class="detail-body">
                    <div class="detail-row">
                        <span class="detail-label">Currency</span>
                        <span class="detail-value">@(Model.Currency ?? "N/A")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Amount</span>
                        <span class="detail-value">@(Model.Amount?.ToString("C") ?? "N/A")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column -->
        <div class="col-lg-6">
            <!-- Organization -->
            <div class="detail-section">
                <div class="detail-header">
                    <i class="fas fa-building text-purple"></i>
                    <h6>Organization</h6>
                </div>
                <div class="detail-body">
                    <div class="detail-row">
                        <span class="detail-label">Company</span>
                        <span class="detail-value"><strong>@(Model.Company ?? "N/A")</strong></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Employees</span>
                        <span class="detail-value">@(Model.Employees?.ToString() ?? "N/A")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Industry</span>
                        <span class="detail-value">@(Model.Industry ?? "N/A")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">City</span>
                        <span class="detail-value">@(Model.City ?? "N/A")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">State</span>
                        <span class="detail-value">@(Model.State ?? "N/A")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Country</span>
                        <span class="detail-value">@(Model.Country ?? "N/A")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Annual Revenue</span>
                        <span class="detail-value">@(Model.AnnualRevenue?.ToString("C") ?? "N/A")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Market Segment</span>
                        <span class="detail-value">@(Model.MarketSegment ?? "N/A")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Website</span>
                        <span class="detail-value">
                            @if (!string.IsNullOrEmpty(Model.Website))
                            {
                                <a href="@Model.Website" target="_blank" class="text-decoration-none">
                                    <i class="fas fa-globe me-1"></i> @Model.Website
                                </a>
                            }
                            else
                            {
                                <span>N/A</span>
                            }
                        </span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Territory</span>
                        <span class="detail-value">@(Model.Territory ?? "N/A")</span>
                    </div>
                </div>
            </div>

            <!-- More Information -->
            <div class="detail-section">
                <div class="detail-header">
                    <i class="fas fa-info text-blue"></i>
                    <h6>More Information</h6>
                </div>
                <div class="detail-body">
                    <div class="detail-row">
                        <span class="detail-label">Opportunity Date</span>
                        <span class="detail-value">@(Model.OpportunityDate?.ToString("dd MMM yyyy") ?? "N/A")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Print Language</span>
                        <span class="detail-value">@(Model.PrintLanguage ?? "N/A")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- System Information -->
    <div class="row">
        <div class="col-12">
            <div class="detail-section">
                <div class="detail-header">
                    <i class="fas fa-clock text-info"></i>
                    <h6>System Information</h6>
                </div>
                <div class="detail-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="detail-row">
                                <span class="detail-label">Created Date</span>
                                <span class="detail-value">@Model.CreatedDate.ToString("dd MMM yyyy HH:mm")</span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="detail-row">
                                <span class="detail-label">Created By</span>
                                <span class="detail-value">@(Model.CreatedBy ?? "System")</span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="detail-row">
                                <span class="detail-label">Modified Date</span>
                                <span class="detail-value">@(Model.ModifiedDate?.ToString("dd MMM yyyy HH:mm") ?? "Never")</span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="detail-row">
                                <span class="detail-label">Modified By</span>
                                <span class="detail-value">@(Model.ModifiedBy ?? "Never")</span>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-md-12">
                            <div class="detail-row">
                                <span class="detail-label">Status</span>
                                <span class="detail-value">
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge bg-success"><i class="fas fa-check-circle"></i> Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="fas fa-times-circle"></i> Inactive</span>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================
    TASKS SECTION
    ============================================ -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="detail-section">
                <div class="detail-header">
                    <i class="fas fa-tasks text-primary"></i>
                    <h6>Tasks</h6>
                    <button type="button" class="btn btn-primary btn-sm ms-auto" onclick="openCreateTaskModal(@Model.Id)">
                        <i class="fas fa-plus"></i> Add Task
                    </button>
                </div>
                <div class="detail-body">
                    <div id="tasksList">
                        <div class="text-center text-muted py-3">
                            <i class="fas fa-spinner fa-spin"></i> Loading tasks...
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================
    EVENTS SECTION
    ============================================ -->
    <div class="row mt-3">
        <div class="col-12">
            <div class="detail-section">
                <div class="detail-header">
                    <i class="fas fa-calendar-alt text-success"></i>
                    <h6>Events</h6>
                    <button type="button" class="btn btn-success btn-sm ms-auto" onclick="openCreateEventModal(@Model.Id)">
                        <i class="fas fa-plus"></i> Add Event
                    </button>
                </div>
                <div class="detail-body">
                    <div id="eventsList">
                        <div class="text-center text-muted py-3">
                            <i class="fas fa-spinner fa-spin"></i> Loading events...
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content" style="border-radius: 16px; border: none; box-shadow: 0 20px 60px rgba(0,0,0,0.15);">
            <div class="modal-header border-0" style="padding: 20px 24px 0;">
                <h5 class="modal-title text-danger">
                    <i class="fas fa-exclamation-triangle"></i> Delete Opportunity
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding: 16px 24px;">
                <p class="mb-0">Are you sure you want to delete <strong>@Model.Company</strong>?</p>
                <p class="text-muted small mb-0">This action cannot be undone.</p>
            </div>
            <div class="modal-footer border-0" style="padding: 0 24px 24px;">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger btn-sm">
                        <i class="fas fa-trash"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Containers -->
<div id="createTaskModalContainer"></div>
<div id="createEventModalContainer"></div>

<style>
    .status-indicator {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
        flex-shrink: 0;
    }

        .status-indicator.prospecting {
            background: #4f46e5;
        }

        .status-indicator.qualification {
            background: #2563eb;
        }

        .status-indicator.negotiation {
            background: #d97706;
        }

        .status-indicator.closedwon {
            background: #16a34a;
        }

        .status-indicator.closedlost {
            background: #dc2626;
        }

    .quick-stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 12px;
        margin-bottom: 20px;
        padding: 16px 20px;
        background: #f8fafc;
        border-radius: 12px;
        border: 1px solid #f0f2f5;
    }

    .quick-stat-item {
        display: flex;
