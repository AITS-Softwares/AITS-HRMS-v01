            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-undo"></i> Reset
            </a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-hover" id="customerTable">
            <thead>
                <tr>
                    <th>Customer Code</th>
                    <th>Customer Name</th>
                    <th>Contact Person</th>
                    <th>Mobile</th>
