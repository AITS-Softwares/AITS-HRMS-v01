@using Microsoft.Extensions.Configuration
@using Microsoft.Data.SqlClient
@using System.Collections.Generic
@using System.Data
@inject IConfiguration _configuration
@model Erp_Aits.Models.Customer
@{
    ViewData["Title"] = "Customer Details";
    ViewData["Module"] = "CRM";
    ViewData["Icon"] = "user";
    var loginType = Context.Session.GetString("LoginType") ?? "User";
    var userRole = Context.Session.GetString("UserRole") ?? "User";
    var userId = Context.Session.GetString("UserId");

    // Default to false
    var canEditCustomer = false;
    var canDeleteCustomer = false;

    // Check based on role first
    if (loginType == "Company" || userRole == "Admin")
    {
        canEditCustomer = true;
        canDeleteCustomer = true;
    }
    else if (userRole == "Manager")
    {
        canEditCustomer = true;
        canDeleteCustomer = false;
    }
    else if (!string.IsNullOrEmpty(userId))
    {
        try
        {
            var connectionString = _configuration.GetConnectionString("DefaultConnection");
            using (var conn = new SqlConnection(connectionString))
            {
                conn.Open();

                // Check Customer Edit permission (PermissionId = 10)
                string query = @"
                    SELECT CanEdit
                    FROM UserPermissions
                    WHERE UserId = @UserId
                    AND PermissionId = 10";

                using (var cmd = new SqlCommand(query, conn))
                {
                    cmd.Parameters.AddWithValue("@UserId", int.Parse(userId));
                    var result = cmd.ExecuteScalar();
                    if (result != null && result != DBNull.Value)
                    {
                        canEditCustomer = Convert.ToBoolean(result);
                    }
                }

                // Check Customer Delete permission (PermissionId = 11)
                query = @"
                    SELECT CanDelete
                    FROM UserPermissions
                    WHERE UserId = @UserId
                    AND PermissionId = 11";

                using (var cmd = new SqlCommand(query, conn))
                {
                    cmd.Parameters.AddWithValue("@UserId", int.Parse(userId));
                    var result = cmd.ExecuteScalar();
                    if (result != null && result != DBNull.Value)
                    {
                        canDeleteCustomer = Convert.ToBoolean(result);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            // Fallback
            canEditCustomer = loginType == "Company" || userRole == "Admin" || userRole == "Manager";
            canDeleteCustomer = loginType == "Company" || userRole == "Admin";
        }
    }
}
