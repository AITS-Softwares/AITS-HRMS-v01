@model Erp_Aits.Models.Customer
@{
    ViewData["Title"] = "Delete Customer";
    ViewData["Module"] = "CRM";
    ViewData["Icon"] = "trash";
}

<div class="content-card">
    <div class="card-header-custom">
        <h5>
            <i class="fas fa-trash text-danger"></i>
            Delete Customer: @Model.CustomerCode
        </h5>
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="alert alert-danger">
        <i class="fas fa-exclamation-triangle"></i>
        <strong>Warning!</strong> Are you sure you want to delete this customer? This action cannot be undone.
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="detail-section">
                <div class="detail-header">
                    <i class="fas fa-info-circle text-primary"></i>
                    <h6>Customer Information</h6>
                </div>
                <div class="detail-body">
                    <div class="detail-row">
                        <span class="detail-label">Customer Code</span>
                        <span class="detail-value">
                            <span class="badge bg-primary">@Model.CustomerCode</span>
                        </span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Customer Name</span>
                        <span class="detail-value"><strong>@Model.CustomerName</strong></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Contact Person</span>
                        <span class="detail-value">@Model.ContactPerson</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Mobile Number</span>
                        <span class="detail-value">@Model.MobileNumber</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Email</span>
                        <span class="detail-value">@(Model.PrimaryEmail ?? "N/A")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Organization</span>
                        <span class="detail-value">@(Model.OrganizationName ?? "N/A")</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="detail-section">
                <div class="detail-header">
                    <i class="fas fa-clock text-info"></i>
                    <h6>System Information</h6>
                </div>
                <div class="detail-body">
                    <div class="detail-row">
                        <span class="detail-label">Created Date</span>
                        <span class="detail-value">@Model.CreatedDate.ToString("dd MMM yyyy HH:mm")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Created By</span>
                        <span class="detail-value">@(Model.CreatedBy ?? "System")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Status</span>
                        <span class="detail-value">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </span>
                    </div>
                    @if (Model.LeadId.HasValue)
                    {
                        <div class="detail-row">
                            <span class="detail-label">Lead Reference</span>
                            <span class="detail-value">
                                <span class="badge bg-secondary">Lead ID: @Model.LeadId</span>
                            </span>
                        </div>
                    }
                </div>
            </div>

            <div class="detail-section">
                <div class="detail-header">
                    <i class="fas fa-tags text-amber"></i>
                    <h6>Additional Information</h6>
                </div>
                <div class="detail-body">
                    <div class="detail-row">
                        <span class="detail-label">Customer Type</span>
                        <span class="detail-value">@(Model.CustomerType ?? "N/A")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Customer Group</span>
                        <span class="detail-value">@(Model.CustomerGroup ?? "N/A")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">GST Number</span>
                        <span class="detail-value">@(Model.GstNumber ?? "N/A")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Commission Rate</span>
                        <span class="detail-value">@(Model.CommissionRate?.ToString("0.00") ?? "N/A")%</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Agent</span>
                        <span class="detail-value">@(Model.AgentName ?? "Unassigned")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="mt-4">
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash"></i> Confirm Delete
            </button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

<style>
    .content-card {
        background: white;
        border-radius: 16px;
        padding: 24px;
        border: 1px solid #f0f2f5;
    }

    .card-header-custom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 16px;
        border-bottom: 2px solid #f4f6f9;
        flex-wrap: wrap;
        gap: 10px;
    }

        .card-header-custom h5 {
            margin: 0;
            font-weight: 600;
            color: #2c3e50;
            font-size: 18px;
        }

    .detail-section {
        background: white;
        border-radius: 12px;
        margin-bottom: 16px;
        border: 1px solid #f0f2f5;
        overflow: hidden;
    }

    .detail-header {
        padding: 12px 16px;
        background: #fafbfc;
        border-bottom: 1px solid #f0f2f5;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .detail-header h6 {
            margin: 0;
            font-weight: 600;
            font-size: 14px;
            color: #1a1a2e;
        }

    .detail-body {
        padding: 12px 16px;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 6px 0;
        border-bottom: 1px solid #f8f9fa;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        font-size: 13px;
        color: #94a3b8;
        font-weight: 500;
        flex: 0 0 40%;
    }

    .detail-value {
        font-size: 13px;
        color: #1a1a2e;
        font-weight: 500;
        text-align: right;
        flex: 1;
        word-break: break-word;
    }

    .badge {
        font-size: 12px;
        padding: 4px 10px;
    }

    .alert {
        border-radius: 12px;
    }
</style>