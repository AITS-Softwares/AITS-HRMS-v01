@model Erp_Aits.Models.AppointmentLetterTemplate
@{
    ViewBag.Title = "New Appointment Letter Template";
    var formAction = Model.Id > 0 ? "UpdateAppointmentLetterTemplate" : "CreateAppointmentLetterTemplate";
}

<form asp-action="@formAction" method="post">
    <input asp-for="Id" type="hidden" />
    <input asp-for="ErpNextId" type="hidden" />
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">@(Model.Id > 0 ? "Edit Appointment Letter Template" : "New Appointment Letter Template")</h4>
        <button type="submit" class="btn btn-dark btn-sm">Save</button>
    </div>

    <div class="card p-4">
        <div class="row g-3">
            <div class="col-md-12">
                <label class="form-label">Template Name *</label>
                <input asp-for="TemplateName" class="form-control" required />
            </div>

            <div class="col-md-12">
                <label class="form-label">Introduction *</label>
                <textarea asp-for="Introduction" class="form-control" rows="8" required></textarea>
            </div>

            <div class="col-md-12">
                <label class="form-label">Terms</label>
                <table class="table table-bordered" id="termsTable">
                    <thead>
                        <tr>
                            <th style="width:60px;">No.</th>
                            <th>Title *</th>
                            <th>Description *</th>
                            <th style="width:50px;"></th>
                        </tr>
                    </thead>
                    <tbody id="termsBody">
                        @for (var i = 0; i < Model.Terms.Count; i++) { <tr><td>@(i + 1)</td><td><input name="Terms[@i].Title" class="form-control form-control-sm" value="@Model.Terms[i].Title" required /></td><td><input name="Terms[@i].Description" class="form-control form-control-sm" value="@Model.Terms[i].Description" required /></td><td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove()">&times;</button></td></tr> }
                    </tbody>
                </table>
                <button type="button" class="btn btn-sm btn-outline-dark mb-3" onclick="addTermRow()">Add Row</button>
            </div>

            <div class="col-md-12">
                <label class="form-label">Closing Notes</label>
                <textarea asp-for="ClosingNotes" class="form-control" rows="8"></textarea>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        let termIdx = @Model.Terms.Count;

        function addTermRow() {
            const i = termIdx++;
            const row = `<tr>
                <td>${i + 1}</td>
                <td><input name="Terms[${i}].Title" class="form-control form-control-sm" required /></td>
                <td><input name="Terms[${i}].Description" class="form-control form-control-sm" required /></td>
                <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove()">&times;</button></td>
            </tr>`;
            document.getElementById('termsBody').insertAdjacentHTML('beforeend', row);
        }

        if (!document.querySelector('#termsBody tr')) addTermRow();
    </script>
}
