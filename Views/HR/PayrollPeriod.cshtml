@{
    ViewBag.Title = "Payroll Period";
}

<style>
    .erp-list-page {
        max-width: 1210px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 185px 1fr;
        gap: 22px;
    }

    .erp-title-row {
        grid-column: 1 / -1;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 4px;
    }

    .erp-title {
        font-size: 22px;
        font-weight: 700;
    }

    .erp-toolbar {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .erp-btn {
        border: 0;
        border-radius: 8px;
        padding: 7px 13px;
        font-size: 14px;
        text-decoration: none;
        display: inline-block;
    }

    .erp-btn-dark {
        background: #111;
        color: #fff;
    }

    .erp-btn-light {
        background: #f3f4f6;
        color: #111827;
    }

    .filter-sidebar {
        font-size: 13px;
        color: #111827;
    }

    .filter-title {
        color: #64748b;
        margin-bottom: 14px;
    }

    .filter-select,
    .filter-input {
        width: 100%;
        height: 34px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #f3f4f6;
        padding: 6px 10px;
        margin-bottom: 14px;
    }

    .filter-label {
        margin: 12px 0 8px;
    }

    .list-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        min-height: 650px;
        position: relative;
        overflow: hidden;
    }

    .list-filter-row {
        display: grid;
        grid-template-columns: 150px 1fr auto auto;
        gap: 8px;
        padding: 10px 12px;
        border-bottom: 1px solid #e5e7eb;
        align-items: center;
    }

    .erp-input {
        height: 34px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #f3f4f6;
        padding: 6px 10px;
        font-size: 14px;
    }

    .empty-state {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        color: #374151;
    }

    .empty-icon {
        width: 55px;
        height: 55px;
        margin: 0 auto 15px;
        border: 1px solid #9ca3af;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #94a3b8;
        font-size: 28px;
    }

    .empty-text {
        margin-bottom: 12px;
        font-size: 14px;
    }

    @@media (max-width: 900px) {
        .erp-list-page {
            grid-template-columns: 1fr;
        }

        .erp-title-row {
            grid-column: auto;
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }

        .list-filter-row {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="erp-list-page">
    <div class="erp-title-row">
        <div class="erp-title">Payroll Period</div>

        <div class="erp-toolbar">
            <button type="button" class="erp-btn erp-btn-light">☷ List View</button>
            <button type="button" class="erp-btn erp-btn-light">↻</button>
            <button type="button" class="erp-btn erp-btn-light">...</button>
            <a href="@Url.Action("CreatePayrollPeriod", "HR")" class="erp-btn erp-btn-dark">+ Add Payroll Period</a>
        </div>
    </div>

    <aside class="filter-sidebar">
        <div class="filter-title">Filter By</div>

        <select class="filter-select">
            <option>Assigned To</option>
        </select>

        <select class="filter-select">
            <option>Created By</option>
        </select>

        <div class="filter-label">Edit Filters</div>

        <select class="filter-select">
            <option>Tags</option>
        </select>

        <div class="filter-label">Show Tags</div>

        <div class="filter-label" style="margin-top:36px;">Save Filter</div>

        <input type="text" class="filter-input" placeholder="Filter Name" />
    </aside>

    <main class="list-card">
        <form method="get" class="list-filter-row">
            <input type="text" name="id" class="erp-input" placeholder="ID" value="@Context.Request.Query["id"]" />
            <div></div>
            <button type="submit" class="erp-btn erp-btn-light">Filter</button>
            <button type="button" class="erp-btn erp-btn-light">Created On</button>
        </form>

        <div class="empty-state">
            <div class="empty-icon">☷</div>
            <div class="empty-text">You haven't created a Payroll Period yet</div>
            <a href="@Url.Action("CreatePayrollPeriod", "HR")" class="erp-btn erp-btn-light">
                Create your first Payroll Period
            </a>
        </div>
    </main>
</div>