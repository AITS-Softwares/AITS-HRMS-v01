@model Erp_Aits.Models.EmployeeOnboardingTemplate

@{
    ViewBag.Title = "Employee Onboarding Template " + Model.Title;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErpNextError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-action="UpdateEmployeeOnboardingTemplate"
      asp-controller="HR"
      asp-route-id="@Model.Id"
      method="post"
      id="templateForm">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ErpNextId" />

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">@Model.Title</h4>

        <div class="d-flex gap-2">
            <a href="@Url.Action("EmployeeOnboardingTemplate", "HR")"
               class="btn btn-outline-secondary btn-sm">
                Back
            </a>

            <button type="button"
                    id="editBtn"
                    class="btn btn-outline-dark btn-sm px-4 fw-bold">
                Edit
            </button>

            <button type="submit"
                    id="updateBtn"
                    class="btn btn-dark btn-sm px-4 fw-bold d-none">
                Update Changes
            </button>
        </div>
    </div>

    <div class="card border rounded-3 p-4 mb-3 shadow-sm bg-white">
        <div class="row g-3">

            <div class="col-md-6">
                <label class="form-label">Title</label>
                <input asp-for="Title"
                       class="form-control template-field"
                       readonly
                       required />
            </div>

            <div class="col-md-6">
                <label class="form-label">Designation</label>
                <select asp-for="Designation"
                        class="form-select template-field"
                        disabled>
                    <option value="">-- Select Designation --</option>

                    @if (ViewBag.Designations != null)
                    {
                        foreach (var designation in ViewBag.Designations)
                        {
                            string designationName = designation.name?.ToString();

                            <option value="@designationName">@designationName</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Company</label>
                <select asp-for="Company"
                        class="form-select template-field"
                        disabled>
                    <option value="">-- Select Company --</option>

                    @if (ViewBag.Companies != null)
                    {
                        foreach (var company in ViewBag.Companies)
                        {
                            string companyName = company.name?.ToString();

                            <option value="@companyName">@companyName</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Employee Grade</label>
                <select asp-for="EmployeeGrade"
                        class="form-select template-field"
                        disabled>
                    <option value="">-- Select Employee Grade --</option>

                    @if (ViewBag.EmployeeGrades != null)
                    {
                        foreach (var grade in ViewBag.EmployeeGrades)
                        {
                            string gradeName = grade.name?.ToString();

                            <option value="@gradeName">@gradeName</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Department</label>
                <select asp-for="Department"
                        class="form-select template-field"
                        disabled>
                    <option value="">-- Select Department --</option>

                    @if (ViewBag.Departments != null)
                    {
                        foreach (var department in ViewBag.Departments)
                        {
                            string departmentName = department.name?.ToString();

                            <option value="@departmentName">@departmentName</option>
                        }
                    }
                </select>
            </div>

        </div>
    </div>

    <div class="card border rounded-3 p-4 shadow-sm bg-white">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold mb-0">Activities</h6>

            <button type="button"
                    id="addActivityBtn"
                    class="btn btn-sm btn-outline-secondary d-none">
                + Add Row
            </button>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered align-middle mb-0" id="activitiesTable">
                <thead class="table-light">
                    <tr>
                        <th style="width:60px;">No.</th>
                        <th>Activity Name</th>
                        <th>User</th>
                        <th style="width:160px;">Begin On (Days)</th>
                        <th style="width:160px;">Duration (Days)</th>
                        <th style="width:70px;" class="activity-action-col d-none"></th>
                    </tr>
                </thead>

                <tbody id="activitiesBody">
                    @if (Model.Activities != null && Model.Activities.Any())
                    {
                        for (int i = 0; i < Model.Activities.Count; i++)
                        {
                            <tr data-activity-row="true">
                                <td class="row-no">@(i + 1)</td>

                                <td>
                                    <input name="Activities[@i].ActivityName"
                                           data-field="ActivityName"
                                           value="@Model.Activities[i].ActivityName"
                                           class="form-control form-control-sm template-field activity-input"
                                           readonly />
                                </td>

                                <td>
                                    <select name="Activities[@i].UserName"
                                            data-field="UserName"
                                            class="form-select form-select-sm template-field activity-input"
                                            disabled>
                                        <option value="">-- Select User --</option>

                                        @if (ViewBag.Users != null)
                                        {
                                            foreach (var user in ViewBag.Users)
                                            {
                                                string userNameValue = user.name?.ToString();
                                                string fullNameValue = user.full_name?.ToString();

                                                bool isSelectedUser =
                                                string.Equals(
                                                Model.Activities[i].UserName,
                                                userNameValue,
                                                StringComparison.OrdinalIgnoreCase);

                                                <option value="@userNameValue" selected="@isSelectedUser">
                                                    @fullNameValue (@userNameValue)
                                                </option>
                                            }
                                        }
                                    </select>
                                </td>

                                <td>
                                    <input name="Activities[@i].BeginOnDays"
                                           data-field="BeginOnDays"
                                           value="@Model.Activities[i].BeginOnDays"
                                           type="number"
                                           class="form-control form-control-sm template-field activity-input"
                                           readonly />
                                </td>

                                <td>
                                    <input name="Activities[@i].DurationDays"
                                           data-field="DurationDays"
                                           value="@Model.Activities[i].DurationDays"
                                           type="number"
                                           class="form-control form-control-sm template-field activity-input"
                                           readonly />
                                </td>

                                <td class="text-center activity-action-col d-none">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger remove-activity-btn">
                                        ×
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="emptyActivitiesRow">
                            <td colspan="6"
                                class="text-center text-muted py-4">
                                No Activities Found
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</form>

<form asp-action="DeleteEmployeeOnboardingTemplate"
      asp-controller="HR"
      asp-route-id="@Model.Id"
      method="post"
      class="mt-3"
      onsubmit="return confirm('Are you sure you want to delete this Employee Onboarding Template?');">

    @Html.AntiForgeryToken()

    <button type="submit"
            class="btn btn-danger btn-sm fw-bold">
        Delete
    </button>
</form>

<script>
    const editBtn = document.getElementById("editBtn");
    const updateBtn = document.getElementById("updateBtn");
    const addActivityBtn = document.getElementById("addActivityBtn");
    const activitiesBody = document.getElementById("activitiesBody");

    const userOptionsHtml = `
        <option value="">-- Select User --</option>
        @if (ViewBag.Users != null)
        {
                foreach (var user in ViewBag.Users)
                {
                        string userNameValue = user.name?.ToString();
                        string fullNameValue = user.full_name?.ToString();

                        <text>
                            <option value="@userNameValue">@fullNameValue (@userNameValue)</option>
                        </text>
                }
        }
    `;

    function enableEditMode() {
        document.querySelectorAll(".template-field").forEach(function (field) {
            field.removeAttribute("readonly");
            field.removeAttribute("disabled");
        });

        document.querySelectorAll(".activity-action-col").forEach(function (col) {
            col.classList.remove("d-none");
        });

        editBtn.classList.add("d-none");
        updateBtn.classList.remove("d-none");
        addActivityBtn.classList.remove("d-none");
    }

    function renumberActivityRows() {
        const rows = activitiesBody.querySelectorAll("tr[data-activity-row='true']");

        rows.forEach(function (row, index) {
            row.querySelector(".row-no").innerText = index + 1;

            row.querySelectorAll("input, select").forEach(function (input) {
                const fieldName = input.getAttribute("data-field");

                if (fieldName) {
                    input.name = "Activities[" + index + "]." + fieldName;
                }
            });
        });
    }

    function addActivityRow() {
        const emptyRow = document.getElementById("emptyActivitiesRow");

        if (emptyRow) {
            emptyRow.remove();
        }

        const index =
            activitiesBody.querySelectorAll("tr[data-activity-row='true']").length;

        const row = document.createElement("tr");

        row.setAttribute("data-activity-row", "true");

        row.innerHTML = `
            <td class="row-no">${index + 1}</td>

            <td>
                <input name="Activities[${index}].ActivityName"
                       data-field="ActivityName"
                       class="form-control form-control-sm template-field activity-input"
                       required />
            </td>

            <td>
                <select name="Activities[${index}].UserName"
                        data-field="UserName"
                        class="form-select form-select-sm template-field activity-input">
                    ${userOptionsHtml}
                </select>
            </td>

            <td>
                <input name="Activities[${index}].BeginOnDays"
                       data-field="BeginOnDays"
                       type="number"
                       class="form-control form-control-sm template-field activity-input" />
            </td>

            <td>
                <input name="Activities[${index}].DurationDays"
                       data-field="DurationDays"
                       type="number"
                       class="form-control form-control-sm template-field activity-input" />
            </td>

            <td class="text-center activity-action-col">
                <button type="button"
                        class="btn btn-sm btn-outline-danger remove-activity-btn">
                    ×
                </button>
            </td>
        `;

        activitiesBody.appendChild(row);
        renumberActivityRows();
    }

    editBtn.addEventListener("click", enableEditMode);

    addActivityBtn.addEventListener("click", addActivityRow);

    document.addEventListener("click", function (event) {
        const removeBtn = event.target.closest(".remove-activity-btn");

        if (!removeBtn) {
            return;
        }

        removeBtn.closest("tr").remove();
        renumberActivityRows();
    });
</script>