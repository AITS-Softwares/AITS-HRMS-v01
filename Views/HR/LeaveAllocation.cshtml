@model List<Erp_Aits.Models.LeaveAllocation>
@{
    ViewBag.Title = "Leave Allocation";
}
<style>
 body{background:#f1fbfd}.allocation-shell{max-width:1500px;margin:24px auto;padding:0 18px}.allocation-hero{background:linear-gradient(110deg,#17486c,#008d88);border-radius:14px;padding:22px 26px;color:#fff;box-shadow:0 10px 24px rgba(10,72,100,.18)}.allocation-hero h4{margin:0;font-weight:700}.allocation-card{background:#fff;border:1px solid #cbe5ed;border-radius:14px;padding:20px;margin-top:18px;box-shadow:0 8px 20px rgba(11,80,101,.07)}.allocation-card .form-control{border-color:#b9dce5}.allocation-card thead th{background:#e7f5f8;color:#17486c;border-bottom:0}.allocation-card tbody tr{cursor:pointer}.allocation-card tbody tr:hover{background:#f1fbfd}.allocation-add{background:#fff;color:#0b5065;border:0;font-weight:700}.allocation-pages{display:flex;justify-content:flex-end;align-items:center;gap:6px;margin-top:16px}.allocation-pages button{border:1px solid #cbe5ed;background:#fff;color:#075d66;border-radius:7px;padding:5px 11px;font-weight:700}.allocation-pages button.active{background:#008d88;color:#fff}.allocation-summary{font-size:.85rem;color:#54717a;margin-right:auto}
</style>
<div class="allocation-shell">
<div class="allocation-hero d-flex justify-content-between align-items-center"><div><small class="text-white-50">LEAVE MANAGEMENT</small><h4>Leave Allocation</h4></div><a href="/HR/CreateLeaveAllocation" class="btn allocation-add btn-sm">+ Add Leave Allocation</a></div>

@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["ErpNextError"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-3">@TempData["Success"]</div>
}

<div class="allocation-card"><form method="get" action="/HR/LeaveAllocation" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="id" class="form-control form-control-sm" placeholder="ID" value="@ViewBag.IdFilter" />
    </div>
    <div class="col-auto">
        <input type="text" name="employee" class="form-control form-control-sm" placeholder="Employee" value="@ViewBag.EmployeeFilter" />
    </div>
    <div class="col-auto">
        <input type="text" name="employeeName" class="form-control form-control-sm" placeholder="Employee Name" value="@ViewBag.EmployeeNameFilter" />
    </div>
    <div class="col-auto">
        <input type="text" name="leaveType" class="form-control form-control-sm" placeholder="Leave Type" value="@ViewBag.LeaveTypeFilter" />
    </div>
    <div class="col-auto">
        <input type="text" name="leavePeriod" class="form-control form-control-sm" placeholder="Leave Period" value="@ViewBag.LeavePeriodFilter" />
    </div>
    <div class="col-auto">
        <input type="text" name="leavePolicy" class="form-control form-control-sm" placeholder="Leave Policy" value="@ViewBag.LeavePolicyFilter" />
    </div>
    <div class="col-auto form-check pt-2">
        <input type="checkbox" name="expired" value="true" class="form-check-input" id="expiredCheck" checked="@ViewBag.ExpiredFilter" />
        <label class="form-check-label" for="expiredCheck">Expired</label>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Filter</button>
    </div>
</form>

@if (Model.Any())
{
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>ID</th>
                <th>Employee</th>
                <th>Employee Name</th>
                <th>Leave Type</th>
                <th>From Date</th>
                <th>To Date</th>
            </tr>
        </thead>
        <tbody id="leaveAllocationRows">
            @foreach (var a in Model)
            {
                <tr data-allocation-id="@a.Id" onclick="window.location='/HR/LeaveAllocationDetails/@a.Id'">
                    <td>@a.Id</td>
                    <td>@a.Employee</td>
                    <td>@a.EmployeeName</td>
                    <td>@a.LeaveType</td>
                    <td>@a.FromDate.ToString("yyyy-MM-dd")</td>
                    <td>@a.ToDate.ToString("yyyy-MM-dd")</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="allocation-pages"><span id="allocationPageSummary" class="allocation-summary"></span><span>Show:</span><button type="button" data-size="20">20</button><button type="button" data-size="50">50</button><button type="button" data-size="100">100</button><button type="button" data-size="200">200</button><button type="button" data-size="500">500</button></div>
}
else
{
    <p class="text-muted text-center py-5">No leave allocations found.</p>
}
</div></div>
<script>
(() => { const body=document.getElementById('leaveAllocationRows'); if(!body)return; const rows=[...body.querySelectorAll('tr[data-allocation-id]')].sort((a,b)=>+b.dataset.allocationId-+a.dataset.allocationId); rows.forEach(r=>body.appendChild(r)); const buttons=[...document.querySelectorAll('[data-size]')],summary=document.getElementById('allocationPageSummary'); let size=+(sessionStorage.getItem('leaveAllocationPageSize')||20); const paint=()=>{rows.forEach((r,i)=>r.hidden=i>=size);buttons.forEach(b=>b.classList.toggle('active',+b.dataset.size===size));summary.textContent=`Showing ${Math.min(size,rows.length)} of ${rows.length}`};buttons.forEach(b=>b.addEventListener('click',()=>{size=+b.dataset.size;sessionStorage.setItem('leaveAllocationPageSize',size);paint()}));paint();})();
</script>
