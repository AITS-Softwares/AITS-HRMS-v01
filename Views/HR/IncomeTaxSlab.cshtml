@using Erp_Aits.Models
@{
    ViewBag.Title = "Income Tax Slab";
    var slabs = ViewBag.IncomeTaxSlabs as List<IncomeTaxSlabListItem> ?? new List<IncomeTaxSlabListItem>();
}
<style>
.payroll-list{max-width:1210px;margin:0 auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.list-head{display:flex;align-items:center;justify-content:space-between;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.list-head h1{font-size:22px;margin:0}.primary{display:inline-block;padding:9px 14px;background:#0f766e;color:#fff;border:0;border-radius:7px;text-decoration:none;font-weight:650}.filter{display:flex;gap:10px;padding:16px 20px;background:#f4f8fc;border-bottom:1px solid #dbe3ec}.filter input{width:280px;border:1px solid #b8c7d7;border-radius:7px;padding:8px 10px}.filter button{border:0;background:#dce8f1;border-radius:7px;padding:8px 14px;color:#172033}.list-card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.table{width:100%;border-collapse:collapse}.table th,.table td{padding:13px 16px;border-bottom:1px solid #e4eaf0;text-align:left;font-size:14px}.table th{background:#f4f8fc;color:#526375;font-weight:650}.table a{color:#0f766e;font-weight:650;text-decoration:none}.status{display:inline-block;padding:3px 8px;border-radius:999px;background:#e6f5ed;color:#147a49;font-size:12px}.status.off{background:#fff0eb;color:#b44827}.empty{padding:65px 16px;text-align:center;color:#64748b}@@media(max-width:800px){.list-head{align-items:flex-start;gap:12px;flex-direction:column}.table{min-width:700px}.list-card{overflow:auto}}
</style>
<div class="payroll-list"><header class="list-head"><h1>Income Tax Slab</h1><a class="primary" asp-action="CreateIncomeTaxSlab">Add Income Tax Slab</a></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}@if(TempData["Success"]!=null){<div class="alert alert-success mt-3">@TempData["Success"]</div>}<main class="list-card"><form class="filter" method="get"><input name="id" value="@Context.Request.Query["id"]" placeholder="Search Income Tax Slab"/><button type="submit">Search</button></form><table class="table"><thead><tr><th>Name</th><th>Effective From</th><th>Company</th><th>Currency</th><th>Status</th><th>Modified</th></tr></thead><tbody>@if(slabs.Any()){foreach(var item in slabs){<tr><td><a asp-action="IncomeTaxSlabDetails" asp-route-id="@item.Name">@item.Name</a></td><td>@item.EffectiveFrom</td><td>@item.Company</td><td>@item.Currency</td><td><span class="status @(item.Disabled ? "off" : "")">@(item.Disabled ? "Disabled" : "Enabled")</span></td><td>@item.Modified</td></tr>}}else{<tr><td colspan="6" class="empty">No Income Tax Slab found. Create one to get started.</td></tr>}</tbody></table></main></div>
