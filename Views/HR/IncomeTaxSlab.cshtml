@using Erp_Aits.Models
@{
    ViewBag.Title = "Income Tax Slab";
    var slabs = ViewBag.IncomeTaxSlabs as List<IncomeTaxSlabListItem> ?? new List<IncomeTaxSlabListItem>();
}
<style>
.payroll-list{max-width:1210px;margin:0 auto;padding:28px;background:#f1fbfd;border:1px solid #cbe5ed;border-radius:10px}.list-head{display:flex;align-items:center;justify-content:space-between;padding:23px 27px;background:linear-gradient(110deg,#17486c,#008d88);border-radius:9px;color:#fff;box-shadow:0 14px 26px rgba(13,83,104,.16)}.list-head h1{font-size:24px;margin:0;font-weight:750}.primary{display:inline-block;padding:10px 16px;background:#fff;color:#0b5065;border:0;border-radius:7px;text-decoration:none;font-weight:700}.filter{display:flex;gap:10px;padding:17px 20px;background:#fff;border-bottom:1px solid #d8ebf0}.filter input{width:280px;border:1px solid #b8d6df;border-radius:7px;padding:9px 11px}.filter button{border:0;background:#dff3f2;border-radius:7px;padding:9px 15px;color:#075d66;font-weight:650}.list-card{margin-top:20px;background:#fff;border:1px solid #c9e1e9;border-radius:9px;overflow:hidden;box-shadow:0 8px 22px rgba(26,85,107,.06)}.table{width:100%;border-collapse:collapse}.table th,.table td{padding:13px 16px;border-bottom:1px solid #e3eff2;text-align:left;font-size:14px}.table th{background:#e7f5f8;color:#17486c;font-weight:700}.table tr:hover td{background:#f6fcfd}.table a{color:#007f80;font-weight:700;text-decoration:none}.status{display:inline-block;padding:3px 9px;border-radius:999px;background:#dcf5ef;color:#087866;font-size:12px;font-weight:650}.status.off{background:#fff0eb;color:#b44827}.empty{padding:65px 16px;text-align:center;color:#64748b}@@media(max-width:800px){.payroll-list{padding:12px}.list-head{align-items:flex-start;gap:12px;flex-direction:column}.table{min-width:700px}.list-card{overflow:auto}}
</style>
<div class="payroll-list"><header class="list-head"><h1>Income Tax Slab</h1><a class="primary" asp-action="CreateIncomeTaxSlab">Add Income Tax Slab</a></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}@if(TempData["Success"]!=null){<div class="alert alert-success mt-3">@TempData["Success"]</div>}<main class="list-card"><form class="filter" method="get"><input name="id" value="@Context.Request.Query["id"]" placeholder="Search Income Tax Slab"/><button type="submit">Search</button></form><table class="table"><thead><tr><th>Name</th><th>Effective From</th><th>Company</th><th>Currency</th><th>Status</th><th>Modified</th></tr></thead><tbody>@if(slabs.Any()){foreach(var item in slabs){<tr><td><a asp-action="IncomeTaxSlabDetails" asp-route-id="@item.Name">@item.Name</a></td><td>@item.EffectiveFrom</td><td>@item.Company</td><td>@item.Currency</td><td><span class="status @(item.Disabled ? "off" : "")">@(item.Disabled ? "Disabled" : "Enabled")</span></td><td>@item.Modified</td></tr>}}else{<tr><td colspan="6" class="empty">No Income Tax Slab found. Create one to get started.</td></tr>}</tbody></table></main></div>
