@using Newtonsoft.Json.Linq
@{ ViewBag.Title="Salary Structure Details"; var doc=ViewBag.Document as JObject; string Value(string key)=>doc?[key]?.ToString()??""; bool Checked(string key)=>doc?[key]?.ToString()=="1"||doc?[key]?.ToString().Equals("Yes",StringComparison.OrdinalIgnoreCase)==true; var earnings=doc?["earnings"] as JArray??new JArray();var deductions=doc?["deductions"] as JArray??new JArray(); }
<style>
.payroll-form{max-width:1210px;margin:0 auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.payroll-head{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.payroll-head h1{font-size:22px;margin:0}.payroll-head a{color:#fff;text-decoration:none}.payroll-card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.tabs{display:flex;gap:28px;padding:0 20px;background:#f4f8fc;border-bottom:1px solid #dbe3ec}.tabs button{border:0;border-bottom:2px solid transparent;background:transparent;padding:13px 0;color:#374151}.tabs button.active{font-weight:700;color:#111827;border-color:#0f766e}.pane{display:none;padding:20px}.pane.active{display:block}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 28px}.field label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.value{min-height:34px;padding:8px 10px;border:1px solid #b8c7d7;border-radius:8px;background:#fbfdff;color:#172033}.check{display:flex;align-items:center;gap:8px;font-size:14px;margin:12px 0}.check input{accent-color:#0f766e}.tables{display:grid;grid-template-columns:1fr 1fr;gap:22px}.table{width:100%;border-collapse:collapse;border:1px solid #d7e0e9;border-radius:8px;overflow:hidden}.table th,.table td{padding:10px;border-bottom:1px solid #e5e7eb;text-align:left;font-size:13px}.table th{background:#f4f8fc;color:#526375}.table .empty{text-align:center;color:#64748b;height:54px}@@media(max-width:800px){.grid,.tables{grid-template-columns:1fr}.payroll-form{padding:12px}}
</style>
<div class="payroll-form"><header class="payroll-head"><h1>@(Value("name")==""?"Salary Structure":Value("name"))</h1><a asp-action="SalaryStructure">Back to Salary Structures</a></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}@if(doc!=null){<main class="payroll-card"><nav class="tabs"><button type="button" class="active" data-tab="details">Details</button><button type="button" data-tab="components">Earnings &amp; Deductions</button><button type="button" data-tab="account">Account</button></nav>
<section id="details" class="pane active"><div class="grid"><div class="field"><label>Name</label><div class="value">@Value("name")</div></div><div class="field"><label>Company</label><div class="value">@Value("company")</div></div><div class="field"><label>Letter Head</label><div class="value">@Value("letter_head")</div></div><div class="field"><label>Is Active</label><div class="value">@Value("is_active")</div></div><div class="field"><label>Currency</label><div class="value">@Value("currency")</div></div><div class="field"><label>Is Default</label><div class="value">@Value("is_default")</div></div><div class="field"><label>Leave Encashment Amount Per Day</label><div class="value">@Value("leave_encashment_amount_per_day")</div></div><div class="field"><label>Max Benefits Amount</label><div class="value">@Value("max_benefits")</div></div><div class="field"><label>Payroll Frequency</label><div class="value">@Value("payroll_frequency")</div></div><div class="field"><label>Salary Component</label><div class="value">@Value("salary_component")</div></div><div class="field"><label>Hour Rate</label><div class="value">@Value("hour_rate")</div></div><div class="field"><label>Amended From</label><div class="value">@Value("amended_from")</div></div></div><label class="check"><input type="checkbox" disabled checked="@Checked("salary_slip_based_on_timesheet")"/>Salary Slip Based on Timesheet</label></section>
<section id="components" class="pane"><div class="tables"><div><h3 style="font-size:16px">Earnings</h3><table class="table"><thead><tr><th>Component</th><th>Amount</th></tr></thead><tbody>@if(earnings.Any()){foreach(var row in earnings){<tr><td>@row["salary_component"]</td><td>@row["amount"]</td></tr>}}else{<tr><td colspan="2" class="empty">No earnings added</td></tr>}</tbody></table></div><div><h3 style="font-size:16px">Deductions</h3><table class="table"><thead><tr><th>Component</th><th>Amount</th></tr></thead><tbody>@if(deductions.Any()){foreach(var row in deductions){<tr><td>@row["salary_component"]</td><td>@row["amount"]</td></tr>}}else{<tr><td colspan="2" class="empty">No deductions added</td></tr>}</tbody></table></div></div><div class="grid" style="margin-top:22px"><div class="field"><label>Total Earning</label><div class="value">@Value("total_earning")</div></div><div class="field"><label>Total Deduction</label><div class="value">@Value("total_deduction")</div></div><div class="field"><label>Net Pay</label><div class="value">@Value("net_pay")</div></div></div></section>
<section id="account" class="pane"><div class="grid"><div class="field"><label>Mode of Payment</label><div class="value">@Value("mode_of_payment")</div></div><div class="field"><label>Payment Account</label><div class="value">@Value("payment_account")</div></div></div></section></main>}</div>
<script>document.querySelectorAll('.tabs button').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.tabs button,.pane').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.getElementById(b.dataset.tab).classList.add('active')}));</script>
