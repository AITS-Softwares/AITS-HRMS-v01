@using Erp_Aits.Models
@{ ViewBag.Title="Salary Withholding"; var rows=ViewBag.SalaryWithholdings as List<SalaryWithholdingListItem>??new List<SalaryWithholdingListItem>(); }
<style>.payroll-list{max-width:1210px;margin:0 auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.head{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.head h1{margin:0;font-size:22px}.primary{background:#0f766e;color:#fff;border-radius:7px;padding:9px 14px;text-decoration:none;font-weight:650}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.filter{display:flex;gap:10px;padding:16px 20px;background:#f4f8fc}.filter input{width:280px;border:1px solid #b8c7d7;border-radius:7px;padding:8px 10px}.filter button{border:0;background:#dce8f1;border-radius:7px;padding:8px 14px}.table{width:100%;border-collapse:collapse}.table th,.table td{padding:13px 16px;border-bottom:1px solid #e4eaf0;text-align:left;font-size:14px}.table th{background:#f4f8fc;color:#526375}.table a{color:#0f766e;text-decoration:none;font-weight:650}.status{border-radius:999px;padding:3px 8px;background:#edf2f7;color:#334155;font-size:12px}.empty{text-align:center;padding:65px;color:#64748b}@@media(max-width:800px){.head{align-items:flex-start;gap:12px;flex-direction:column}.card{overflow:auto}.table{min-width:750px}}</style>
<div class="payroll-list"><header class="head"><h1>Salary Withholding</h1><a class="primary" asp-action="CreateSalaryWithholding">Add Salary Withholding</a></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}@if(TempData["Success"]!=null){<div class="alert alert-success mt-3">@TempData["Success"]</div>}<main class="card"><form class="filter"><input name="id" value="@Context.Request.Query["id"]" placeholder="Search Salary Withholding"/><button>Search</button></form><table class="table"><thead><tr><th>ID</th><th>Employee</th><th>Employee Name</th><th>Payroll Frequency</th><th>Status</th><th>Modified</th></tr></thead><tbody>@if(rows.Any()){foreach(var row in rows){<tr><td><a asp-action="SalaryWithholdingDetails" asp-route-id="@row.Name">@row.Name</a></td><td>@row.Employee</td><td>@row.EmployeeName</td><td>@row.PayrollFrequency</td><td><span class="status">@row.Status</span></td><td>@row.Modified</td></tr>}}else{<tr><td colspan="6" class="empty">No Salary Withholding found. Create one to get started.</td></tr>}</tbody></table></main></div>
