@model Erp_Aits.Models.LeaveBlockList
@{
    ViewBag.Title = "New Leave Block List";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">New Leave Block List</h4>
    <div>
        <a href="@Url.Action("LeaveBlockList", "HR")" class="btn btn-outline-dark btn-sm">Back to List</a>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<form action="/HR/CreateLeaveBlockList" method="post" id="leaveBlockForm">

    <input type="hidden" name="SyncToErpNext" value="true" />

    <div class="row g-3 mb-2">
        <div class="col-md-6">
            <label class="form-label">Leave Block List Name <span class="text-danger">*</span></label>
            <input type="text" name="LeaveBlockListName" class="form-control" value="@Model.LeaveBlockListName" required />
        </div>

        <div class="col-md-6">
            <label class="form-label">Leave Type</label>
            <select name="LeaveType" class="form-control" onchange="if(this.value==='__CREATE_NEW__') location.href='@Url.Action("CreateLeaveType", "HR")';">
                <option value="">-- Select Leave Type --</option>
                @if (ViewBag.LeaveTypes != null)
                {
                    foreach (var lt in ViewBag.LeaveTypes)
                    {
                        <!option value="@lt" @(Model.LeaveType == lt ? "selected" : "")>@lt</!option>
                    }
                }
                <!option value="__CREATE_NEW__" class="fw-bold text-primary">+ Create New Leave Type</!option>
            </select>
        </div>

        <div class="col-md-6">
            <label class="form-label">Company <span class="text-danger">*</span></label>
            <input type="text" name="Company" class="form-control" value="@(string.IsNullOrEmpty(Model.Company) ? "AITS" : Model.Company)" required />
        </div>
    </div>

    <div class="form-check mb-1 mt-3">
        <input class="form-check-input" type="checkbox" name="AppliesToCompany" value="true" id="AppliesToCompany" @(Model.AppliesToCompany ? "checked" : "") />
        <label class="form-check-label" for="AppliesToCompany">Applies to Company</label>
    </div>

    <hr />
    <!-- Block Days Section -->
    <div class="mb-2">
        <h6 class="mb-1">Block Days</h6>
        <p class="text-muted small mb-1">Stop users from making Leave Applications on following days.</p>
        <button type="button" class="btn btn-link p-0 text-primary text-decoration-none fw-bold mb-2" data-bs-toggle="modal" data-bs-target="#addDayWiseModal">+ Add Day-wise Dates</button>
    </div>

    <p class="mb-2"><strong>Leave Block List Dates</strong></p>
    <table class="table table-bordered align-middle">
        <thead>
            <tr>
                <th style="width:40px">No.</th>
                <th>Block Date <span class="text-danger">*</span></th>
                <th>Reason <span class="text-danger">*</span></th>
                <th style="width:50px"></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.BlockDates != null && Model.BlockDates.Any())
            {
                int index = 0;
                foreach (var d in Model.BlockDates)
                {
                    <tr>
                        <td>@(index + 1)</td>
                        <td>
                            <input type="date" name="BlockDates[@index].BlockDate" class="form-control form-control-sm" value="@(d.BlockDate != default ? d.BlockDate.ToString("yyyy-MM-dd") : "")" required />
                        </td>
                        <td>
                            <input type="text" name="BlockDates[@index].Reason" class="form-control form-control-sm" value="@d.Reason" required />
                        </td>
                        <td class="text-center">
                            <button type="submit" formaction="@Url.Action("RemoveBlockDateRow", "HR", new { index = index })" class="btn btn-sm btn-outline-danger">&times;</button>
                        </td>
                    </tr>
                    index++;
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-muted text-center py-2">No block dates added yet.</td>
                </tr>
            }
        </tbody>
    </table>
    <button type="submit" formaction="@Url.Action("AddBlockDateRow", "HR")" class="btn btn-sm btn-outline-secondary mb-4">Add Row</button>

    <hr />
    <!-- Allow Users Section -->
    <div class="mb-2">
        <h6 class="mb-1">Allow Users</h6>
        <p class="text-muted small mb-2">Allow the following users to approve Leave Applications for block days.</p>
    </div>

    <p class="mb-2"><strong>Leave Block List Allowed</strong></p>
    <table class="table table-bordered align-middle">
        <thead>
            <tr>
                <th style="width:40px">No.</th>
                <th>Allow User <span class="text-danger">*</span></th>
                <th style="width:50px"></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.AllowedUsers != null && Model.AllowedUsers.Any())
            {
                int index = 0;
                foreach (var u in Model.AllowedUsers)
                {
                    <tr>
                        <td>@(index + 1)</td>
                        <td>
                            <select name="AllowedUsers[@index].AllowUser" class="form-control form-control-sm" required>
                                <option value="">-- Select Allow User --</option>
                                @if (ViewBag.AllowedUsersList != null)
                                {
                                    foreach (var usr in ViewBag.AllowedUsersList)
                                    {
                                        <!option value="@usr" @(u.AllowUser == usr ? "selected" : "")>@usr</!option>
                                    }
                                }
                            </select>
                        </td>
                        <td class="text-center">
                            <button type="submit" formaction="@Url.Action("RemoveAllowedUserRow", "HR", new { index = index })" class="btn btn-sm btn-outline-danger">&times;</button>
                        </td>
                    </tr>
                    index++;
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-muted text-center py-2">No allowed users added yet.</td>
                </tr>
            }
        </tbody>
    </table>
    <button type="submit" formaction="@Url.Action("AddAllowedUserRow", "HR")" class="btn btn-sm btn-outline-secondary mb-4">Add Row</button>

    <br />
    <button type="submit" formaction="@Url.Action("CreateLeaveBlockList", "HR")" class="btn btn-dark w-100 py-2">Save Leave Block List</button>
</form>

<!-- Modal: Add Day-wise Dates -->
<div class="modal fade" id="addDayWiseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content p-3">
            <div class="modal-header">
                <h5 class="modal-title">Add Leave Block Dates</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Start Date *</label>
                        <input type="date" id="modalStartDate" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">End Date *</label>
                        <input type="date" id="modalEndDate" class="form-control" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Select Weekdays</label>
                    <div class="row">
                        <div class="col-md-4"><div class="form-check"><input class="form-check-input weekday-chk" type="checkbox" value="1" id="chkMon"><label class="form-check-label" for="chkMon">Monday</label></div></div>
                        <div class="col-md-4"><div class="form-check"><input class="form-check-input weekday-chk" type="checkbox" value="2" id="chkTue"><label class="form-check-label" for="chkTue">Tuesday</label></div></div>
                        <div class="col-md-4"><div class="form-check"><input class="form-check-input weekday-chk" type="checkbox" value="3" id="chkWed"><label class="form-check-label" for="chkWed">Wednesday</label></div></div>
                        <div class="col-md-4"><div class="form-check"><input class="form-check-input weekday-chk" type="checkbox" value="4" id="chkThu"><label class="form-check-label" for="chkThu">Thursday</label></div></div>
                        <div class="col-md-4"><div class="form-check"><input class="form-check-input weekday-chk" type="checkbox" value="5" id="chkFri"><label class="form-check-label" for="chkFri">Friday</label></div></div>
                        <div class="col-md-4"><div class="form-check"><input class="form-check-input weekday-chk" type="checkbox" value="6" id="chkSat"><label class="form-check-label" for="chkSat">Saturday</label></div></div>
                        <div class="col-md-4"><div class="form-check"><input class="form-check-input weekday-chk" type="checkbox" value="0" id="chkSun"><label class="form-check-label" for="chkSun">Sunday</label></div></div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Reason *</label>
                    <textarea id="modalReason" class="form-control" rows="3" placeholder="Enter reason for block dates"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-dark" data-bs-dismiss="modal">Done</button>
            </div>
        </div>
    </div>
</div>