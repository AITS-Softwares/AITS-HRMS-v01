@model List<Erp_Aits.Models.HRShiftAssignment>
@{
    ViewBag.Title = "Shift Assignment";
    var page = (int)(ViewBag.Page ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 20);
    var totalRecords = (int)(ViewBag.TotalRecords ?? 0);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var pageSizes = new[] { 20, 50, 100, 200, 500 };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Shift Assignment</h4>
    <div class="d-flex gap-2">
        <div class="dropdown">
            <button class="btn btn-outline-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Shift Tool</button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                <li><a class="dropdown-item" href="@Url.Action("ShiftAssignmentTool", "HR")">Shift Assignment Tool</a></li>
                <li><a class="dropdown-item" href="@Url.Action("Roster", "HR")">Roster</a></li>
            </ul>
        </div>
        <a href="/HR/CreateShiftAssignment" class="btn btn-dark btn-sm">+ Add Shift Assignment</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-3">@TempData["Success"]</div>
}
@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["ErpNextError"]</div>
}

<form method="get" action="/HR/ShiftAssignment" class="row g-2 mb-3">
    <input type="hidden" name="pageSize" value="@pageSize" />
    <div class="col-auto">
        <input type="text" name="id" class="form-control form-control-sm" placeholder="ID" value="@ViewBag.IdFilter" />
    </div>
    <div class="col-auto">
        <input type="text" name="employee" class="form-control form-control-sm" placeholder="Employee" value="@ViewBag.EmployeeFilter" />
    </div>
    <div class="col-auto">
        <input type="text" name="employeeName" class="form-control form-control-sm" placeholder="Employee Name" value="@ViewBag.EmployeeNameFilter" />
    </div>
    <div class="col-auto">
        <input type="text" name="shiftType" class="form-control form-control-sm" placeholder="Shift Type" value="@ViewBag.ShiftTypeFilter" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>Employee</th>
            <th>Shift Type</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var s in Model)
            {
                <tr style="cursor:pointer" onclick="window.location='/HR/ShiftAssignmentDetails/@s.Id'">
                    <td>@s.Id</td>
                    <td>@s.Employee</td>
                    <td>@s.ShiftType</td>
                    <td>@s.Status</td>
                </tr>
            }
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted text-center py-5">No shift assignments found.</p>
}
@if (totalRecords > 0)
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3 schedule-pagination">
        <small class="text-muted">Showing @(((page - 1) * pageSize) + 1)-@Math.Min(page * pageSize, totalRecords) of @totalRecords</small>
        <div class="btn-group btn-group-sm" role="group" aria-label="Page size">
            @foreach (var size in pageSizes)
            {
                <a class="btn @(size == pageSize ? "btn-primary" : "btn-outline-primary")" href="@Url.Action("HRShiftAssignmentList", "HR", new { id = ViewBag.IdFilter, employee = ViewBag.EmployeeFilter, employeeName = ViewBag.EmployeeNameFilter, shiftType = ViewBag.ShiftTypeFilter, page = 1, pageSize = size })">@size</a>
            }
        </div>
        @if (totalPages > 1)
        {
            <div class="btn-group btn-group-sm">
                <a class="btn btn-outline-secondary @(page <= 1 ? "disabled" : "")" href="@Url.Action("HRShiftAssignmentList", "HR", new { id = ViewBag.IdFilter, employee = ViewBag.EmployeeFilter, employeeName = ViewBag.EmployeeNameFilter, shiftType = ViewBag.ShiftTypeFilter, page = page - 1, pageSize })">Previous</a>
                <span class="btn btn-outline-secondary disabled">Page @(page) / @(totalPages)</span>
                <a class="btn btn-outline-secondary @(page >= totalPages ? "disabled" : "")" href="@Url.Action("HRShiftAssignmentList", "HR", new { id = ViewBag.IdFilter, employee = ViewBag.EmployeeFilter, employeeName = ViewBag.EmployeeNameFilter, shiftType = ViewBag.ShiftTypeFilter, page = page + 1, pageSize })">Next</a>
            </div>
        }
    </div>
}
<partial name="_ShiftModuleUi" />
