@using System.Collections.Generic
@{ViewBag.Title="New Employee Tax Exemption Sub Category";var cats=ViewBag.TaxCategories as List<string>??new List<string>();}
<style>.p{max-width:1210px;margin:auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.h{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.h h1{margin:0;font-size:22px}.save{border:0;background:#0f766e;color:#fff;padding:9px 17px;border-radius:7px;font-weight:650}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px}.s{padding:20px}.g{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.f label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.i,.sel{box-sizing:border-box;width:100%;height:36px;border:1px solid #b8c7d7;border-radius:8px;padding:7px 10px;background:#fbfdff}.check{display:flex;gap:8px;align-items:center;padding-top:24px}.ss{position:relative}.sm{display:none;position:fixed;z-index:3000;max-height:260px;overflow:auto;background:#fff;border:1px solid #94a3b8}.sm button{display:block;width:100%;padding:8px;border:0;background:#fff;text-align:left}</style><div class="p"><form method="post" asp-action="CreateEmployeeTaxExemptionSubCategory">@Html.AntiForgeryToken()<header class="h"><h1>New Employee Tax Exemption Sub Category</h1><button class="save">Save</button></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}<main class="card"><section class="s"><div class="g"><div class="f"><label>Tax Exemption Category *</label><select name="ExemptionCategory" class="sel searchable" required><option value="">Select category</option>@foreach(var x in cats){<option value="@x">@x</option>}</select></div><div class="f"><label>Max Exemption Amount</label><input name="MaxAmount" type="number" step="0.01" class="i"/></div><label class="check"><input name="IsActive" type="checkbox" checked/> Is Active</label></div></section></main></form></div><script>document.querySelectorAll('select.searchable').forEach(s=>{if(s.options.length<=11)return;const w=document.createElement('div'),i=document.createElement('input'),m=document.createElement('div');w.className='ss';i.className='i';i.placeholder='Type to search';m.className='sm';s.parentNode.insertBefore(w,s);w.append(i,s,m);s.style.display='none';const draw=()=>{let q=i.value.toLowerCase(),a=[...s.options].filter(x=>x.value&&x.text.toLowerCase().startsWith(q)).slice(0,10);m.innerHTML='';a.forEach(x=>{let b=document.createElement('button');b.type='button';b.textContent=x.text;b.onclick=()=>{s.value=x.value;i.value=x.text;m.style.display='none'};m.appendChild(b)});let r=i.getBoundingClientRect();m.style.width=r.width+'px';m.style.left=r.left+'px';m.style.top=r.bottom+'px';m.style.display='block'};i.onfocus=draw;i.oninput=draw;document.addEventListener('click',e=>{if(!w.contains(e.target))m.style.display='none'})});</script>
