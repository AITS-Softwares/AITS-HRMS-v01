@model List<Erp_Aits.Models.EmployeeCheckin>

@{
    ViewBag.Title = "Employee Checkin";
}

<div class="workforce-ui checkin-list">

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErpNextError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Employee Checkin</h4>

    <a href="@Url.Action("CreateEmployeeCheckin", "HR")"
       class="btn btn-dark btn-sm">
        + Add Employee Checkin
    </a>
</div>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Employee Name</th>
            <th>Status</th>
            <th>Log Type</th>
            <th>Time</th>
            <th>ID</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var ec in Model)
            {
                <tr style="cursor:pointer;"
                    onclick="location.href='@Url.Action("EmployeeCheckinDetails", "HR", new { id = ec.Id })'">
                    <td>@ec.EmployeeName</td>
                    <td>
                        @if (ec.LogType == "IN")
                        {
                            <span class="badge bg-success-subtle text-success">● IN</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary">● OUT</span>
                        }
                    </td>
                    <td>@ec.LogType</td>
                    <td>@(ec.Time?.ToString("dd-MM-yyyy HH:mm:ss"))</td>
                    <td>@ec.EmployeeCheckinCode</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-muted py-4">
                    No employee checkins found.
                </td>
            </tr>
        }
    </tbody>
</table>

</div>

<style>
    .workforce-ui.checkin-list { max-width: 1480px; margin: 8px auto 40px; padding: 26px; border: 1px solid #c7daea; border-radius: 8px; background: #edf5fb; box-shadow: 0 16px 34px rgba(19,55,91,.10); }.workforce-ui.checkin-list > .d-flex { margin: -26px -26px 22px; padding: 20px 26px; background: #14365d; border-radius: 8px 8px 0 0; }.workforce-ui.checkin-list h4 { color: #fff; font-size: 27px; font-weight: 760; }.workforce-ui.checkin-list .btn-dark { border-color: #16a085; background: #108c77; border-radius: 6px; font-weight: 700; }.workforce-ui.checkin-list .table { overflow: hidden; margin: 0; border: 1px solid #c8ddec; border-radius: 8px; background: #fff; box-shadow: 0 8px 20px rgba(16,49,82,.07); }.workforce-ui.checkin-list .table thead th { padding: 14px 18px; border-color: #2a5a89; background: #1d4b7d; color: #fff; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }.workforce-ui.checkin-list .table tbody td { padding: 15px 18px; border-color: #e1ebf4; color: #31516f; }.workforce-ui.checkin-list .table tbody tr:nth-child(even) { background: #f4f9fd; }.workforce-ui.checkin-list .table tbody tr:hover { background: #e1f3ef; }.workforce-ui.checkin-list .badge { border-radius: 6px; }
</style>
