@model List<Erp_Aits.Models.EmployeeCheckin>

@{
    ViewBag.Title = "Employee Checkin";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErpNextError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Employee Checkin</h4>

    <a href="@Url.Action("CreateEmployeeCheckin", "HR")"
       class="btn btn-dark btn-sm">
        + Add Employee Checkin
    </a>
</div>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Employee Name</th>
            <th>Status</th>
            <th>Log Type</th>
            <th>Time</th>
            <th>ID</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var ec in Model)
            {
                <tr style="cursor:pointer;"
                    onclick="location.href='@Url.Action("EmployeeCheckinDetails", "HR", new { id = ec.Id })'">
                    <td>@ec.EmployeeName</td>
                    <td>
                        @if (ec.LogType == "IN")
                        {
                            <span class="badge bg-success-subtle text-success">● IN</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary">● OUT</span>
                        }
                    </td>
                    <td>@ec.LogType</td>
                    <td>@(ec.Time?.ToString("dd-MM-yyyy HH:mm:ss"))</td>
                    <td>@ec.EmployeeCheckinCode</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-muted py-4">
                    No employee checkins found.
                </td>
            </tr>
        }
    </tbody>
</table>