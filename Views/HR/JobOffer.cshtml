@model List<Erp_Aits.Models.JobOffer>
@{
    ViewBag.Title = "Job Offer";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Job Offer</h4>
    <a href="@Url.Action("CreateJobOffer", "HR")" class="btn btn-dark btn-sm">+ Add Job Offer</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="id" class="form-control form-control-sm" placeholder="ID" value="@ViewBag.IdFilter" />
    </div>
    <div class="col-auto">
        <input type="text" name="applicantName" class="form-control form-control-sm" placeholder="Applicant Name" value="@ViewBag.ApplicantNameFilter" />
    </div>
    <div class="col-auto">
        <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="Awaiting Response" selected="@(ViewBag.StatusFilter == "Awaiting Response")">Awaiting Response</option>
            <option value="Accepted" selected="@(ViewBag.StatusFilter == "Accepted")">Accepted</option>
            <option value="Rejected" selected="@(ViewBag.StatusFilter == "Rejected")">Rejected</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>Applicant Name</th>
            <th>Status</th>
            <th>Offer Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var o in Model)
        {
            <tr>
                <td>@o.Id</td>
                <td>@o.ApplicantName</td>
                <td>@o.Status</td>
                <td>@o.OfferDate.ToString("dd-MM-yyyy")</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <p>No Job Offer found with matching filters. Clear filters to see all Job Offer.</p>
        <a href="@Url.Action("CreateJobOffer", "HR")" class="btn btn-light btn-sm">Create a new Job Offer</a>
    </div>
}
