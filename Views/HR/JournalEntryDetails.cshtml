@using Newtonsoft.Json.Linq
@{ViewBag.Title="Journal Entry Details";var d=ViewBag.Document as JObject;string V(string key)=>d?[key]?.ToString()??"";bool B(string key)=>d?[key]?.Value<int>()==1;var fields=new[]{("Title","title"),("Entry Type","voucher_type"),("Reversal Type","ineligibility_reason"),("Series","naming_series"),("Finance Book","finance_book"),("Process Deferred Accounting","process_deferred_accounting"),("Reversal Of","reversal_of"),("Tax Withholding Category","tax_withholding_category"),("From Template","from_template"),("Company","company"),("Company GSTIN","company_gstin"),("Posting Date","posting_date"),("Reference Number","cheque_no"),("Reference Date","cheque_date"),("User Remark","user_remark"),("Total Debit","total_debit"),("Total Credit","total_credit"),("Difference (Dr - Cr)","difference"),("Total Amount Currency","total_amount_currency"),("Total Amount","total_amount"),("Total Amount in Words","total_amount_in_words"),("Clearance Date","clearance_date"),("Remark","remark"),("Paid Loan","paid_loan"),("Inter Company Journal Entry Reference","inter_company_journal_entry_reference"),("Bill No","bill_no"),("Bill Date","bill_date"),("Due Date","due_date"),("Write Off Based On","write_off_based_on"),("Write Off Amount","write_off_amount"),("Pay To / Recd From","pay_to_recd_from"),("Letter Head","letter_head"),("Print Heading","select_print_heading"),("Mode of Payment","mode_of_payment"),("Payment Order","payment_order"),("Is Opening","is_opening"),("Stock Entry","stock_entry"),("Auto Repeat","auto_repeat"),("Amended From","amended_from")};var rows=d?["accounts"] as JArray??new JArray();}
<style>.p{max-width:1210px;margin:auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.h{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.h h1{font-size:22px;margin:0}.back{color:#fff;text-decoration:none;border:1px solid #7890a8;border-radius:7px;padding:8px 13px}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.s{padding:20px;border-bottom:1px solid #dbe3ec}.s h2{font-size:17px;margin:0 0 16px}.g{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.f label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.v{min-height:36px;box-sizing:border-box;width:100%;border:1px solid #b8c7d7;border-radius:8px;padding:8px 10px;background:#f2f6f9;color:#526375;font-size:14px}.check{display:flex;align-items:center;gap:8px;padding-top:25px;font-size:14px}.check input{accent-color:#0f766e}.table{width:100%;border-collapse:collapse}.table th,.table td{padding:9px;border:1px solid #dbe3ec;text-align:left;font-size:14px}.table th{background:#f4f8fc;color:#526375}@@media(max-width:800px){.p{padding:12px}.g{grid-template-columns:1fr}.table{display:block;overflow:auto}}</style>
<div class="p"><header class="h"><h1>Journal Entry Details</h1><a class="back" asp-action="JournalEntry">Back to Journal Entries</a></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}<main class="card"><section class="s"><h2>Journal Entry</h2><div class="g"><label class="check"><input type="checkbox" disabled checked="@B("is_system_generated")"/> Is System Generated</label>@foreach(var x in fields.Take(13)){<div class="f"><label>@x.Item1</label><div class="v">@V(x.Item2)</div></div>}<label class="check"><input type="checkbox" disabled checked="@B("apply_tds")"/> Apply Tax Withholding Amount</label></div></section><section class="s"><h2>Accounting Entries</h2><table class="table"><thead><tr><th>Account</th><th>Party Type</th><th>Party</th><th>Debit</th><th>Credit</th></tr></thead><tbody>@if(rows.Any()){foreach(var r in rows){<tr><td>@r["account"]</td><td>@r["party_type"]</td><td>@r["party"]</td><td>@r["debit_in_account_currency"]</td><td>@r["credit_in_account_currency"]</td></tr>}}else{<tr><td colspan="5">No accounting entries.</td></tr>}</tbody></table></section><section class="s"><h2>Reference and Totals</h2><div class="g">@foreach(var x in fields.Skip(13).Take(17)){<div class="f"><label>@x.Item1</label><div class="v">@V(x.Item2)</div></div>}<label class="check"><input type="checkbox" disabled checked="@B("multi_currency")"/> Multi Currency</label></div></section><section class="s"><h2>Printing and More Information</h2><div class="g">@foreach(var x in fields.Skip(30)){<div class="f"><label>@x.Item1</label><div class="v">@V(x.Item2)</div></div>}<label class="check"><input type="checkbox" disabled checked="@B("party_not_required")"/> Party Not Required</label></div></section></main></div>
