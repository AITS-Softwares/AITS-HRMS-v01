@model Erp_Aits.Models.HRShiftScheduleAssignment
@{
    ViewBag.Title = "Shift Schedule Assignment " + Model.Id;
    bool isEdit = ViewBag.IsEdit == true;
    var employees = ViewBag.EmployeesList as List<object> ?? new List<object>();
    var companies = ViewBag.Companies as List<string> ?? new List<string>();
    var shiftSchedules = ViewBag.ShiftSchedules as List<string> ?? new List<string>();
    var shiftLocations = ViewBag.ShiftLocations as List<string> ?? new List<string>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Shift Schedule Assignment - @Model.Employee</h4>
    <div class="d-flex gap-2">
        <a href="@Url.Action("HRShiftScheduleAssignmentList", "HR")" class="btn btn-outline-secondary btn-sm">Back</a>
        @if (!isEdit)
        {
            <a href="@Url.Action("HRShiftScheduleAssignmentDetails", "HR", new { id = Model.Id, edit = true })" class="btn btn-dark btn-sm">Edit</a>
            <form method="post" action="@Url.Action("DeleteShiftScheduleAssignment", "HR", new { id = Model.Id })" onsubmit="return confirm('Delete this Shift Schedule Assignment from ERPNext and HRMS?');">
                <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
            </form>
        }
        else
        {
            <a href="@Url.Action("HRShiftScheduleAssignmentDetails", "HR", new { id = Model.Id })" class="btn btn-outline-secondary btn-sm">Cancel</a>
        }
    </div>
</div>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["ErpNextError"] != null) { <div class="alert alert-danger">@TempData["ErpNextError"]</div> }

<form method="post" action="@Url.Action("UpdateShiftScheduleAssignment", "HR", new { id = Model.Id })">
    <input type="hidden" name="Id" value="@Model.Id" />
    <input type="hidden" name="ErpNextId" value="@Model.ErpNextId" />
    <input type="hidden" name="EmployeeName" id="employeeNameInput" value="@Model.EmployeeName" />

    <div class="card p-4">
        <h6 class="mb-3">Employee Details</h6>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Employee</label>
                @if (isEdit)
                {
                    <select name="Employee" class="form-select" required onchange="document.getElementById('employeeNameInput').value = this.options[this.selectedIndex].getAttribute('data-empname') || '';">
                        <option value="">-- Select Employee --</option>
                        @foreach (var emp in employees)
                        {
                            var empId = emp.GetType().GetProperty("EmployeeId")?.GetValue(emp, null)?.ToString();
                            var empName = emp.GetType().GetProperty("EmployeeName")?.GetValue(emp, null)?.ToString();
                            <option value="@empId" data-empname="@empName" selected="@(Model.Employee == empId)">@empId - @empName</option>
                        }
                    </select>
                }
                else { <input class="form-control" value="@Model.Employee" readonly /> }
            </div>
            <div class="col-md-6">
                <label class="form-label">Company</label>
                @if (isEdit)
                {
                    <select name="Company" class="form-select" required>
                        <option value="">-- Select Company --</option>
                        @foreach (var comp in companies)
                        {
                            <option value="@comp" selected="@(Model.Company == comp)">@comp</option>
                        }
                    </select>
                }
                else { <input class="form-control" value="@Model.Company" readonly /> }
            </div>
        </div>

        <hr class="my-4" />
        <h6 class="mb-3">Shift Details</h6>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Shift Schedule</label>
                @if (isEdit)
                {
                    <select name="ShiftSchedule" class="form-select" required>
                        <option value="">-- Select Shift Schedule --</option>
                        @foreach (var sched in shiftSchedules)
                        {
                            <option value="@sched" selected="@(Model.ShiftSchedule == sched)">@sched</option>
                        }
                    </select>
                }
                else { <input class="form-control" value="@Model.ShiftSchedule" readonly /> }
            </div>
            <div class="col-md-6">
                <div class="form-check mt-4">
                    <input name="Enabled" class="form-check-input" type="checkbox" value="true" checked="@Model.Enabled" disabled="@(!isEdit)" />
                    <label class="form-check-label">Enabled</label>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">Shift Location</label>
                @if (isEdit)
                {
                    <select name="ShiftLocation" class="form-select">
                        <option value="">-- Select Shift Location --</option>
                        @foreach (var loc in shiftLocations)
                        {
                            <option value="@loc" selected="@(Model.ShiftLocation == loc)">@loc</option>
                        }
                    </select>
                }
                else { <input class="form-control" value="@Model.ShiftLocation" readonly /> }
            </div>
            <div class="col-md-6"><label class="form-label">Create Shifts After</label><input name="CreateShiftsAfter" type="date" class="form-control" value="@Model.CreateShiftsAfter.ToString("yyyy-MM-dd")" readonly="@(!isEdit)" required /></div>
            <div class="col-md-6">
                <label class="form-label">Shift Status</label>
                @if (isEdit)
                {
                    <select name="ShiftStatus" class="form-select">
                        <option value="Active" selected="@(Model.ShiftStatus == "Active")">Active</option>
                        <option value="Inactive" selected="@(Model.ShiftStatus == "Inactive")">Inactive</option>
                    </select>
                }
                else { <input class="form-control" value="@Model.ShiftStatus" readonly /> }
            </div>
        </div>
        @if (isEdit)
        {
            <div class="d-flex justify-content-end mt-4"><button type="submit" class="btn btn-dark btn-sm">Update Changes</button></div>
        }
    </div>
</form>
<partial name="_ShiftModuleUi" />
