@using Erp_Aits.Models
@{ViewBag.Title="New Employee Benefit Application";var employees=ViewBag.BenefitEmployees as List<PayrollEmployeeOption>??new List<PayrollEmployeeOption>();var periods=ViewBag.BenefitPeriods as List<string>??new List<string>();var currencies=ViewBag.BenefitCurrencies as List<string>??new List<string>();var components=ViewBag.BenefitComponents as List<string>??new List<string>();}
<style>.p{max-width:1210px;margin:auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.h{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.h h1{font-size:22px;margin:0}.save{border:0;background:#0f766e;color:#fff;padding:9px 17px;border-radius:7px;font-weight:650}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.s{padding:20px;border-bottom:1px solid #dbe3ec}.s h2{font-size:17px;margin:0 0 16px;color:#14253d}.g{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.f label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.i,.sel{box-sizing:border-box;width:100%;height:36px;border:1px solid #b8c7d7;border-radius:8px;padding:7px 10px;background:#fbfdff}.i[readonly]{background:#f2f6f9}.t{width:100%;border-collapse:collapse}.t th,.t td{padding:8px;border:1px solid #dbe3ec}.t th{background:#f4f8fc;color:#526375;text-align:left}.t select,.t input{width:100%;height:34px;box-sizing:border-box;border:1px solid #b8c7d7;border-radius:5px;padding:5px}.add{border:0;background:#dce8f1;border-radius:6px;padding:7px 12px;margin-top:10px}.sys{color:#64748b;font-size:12px;margin:0 0 12px}.s:nth-of-type(2){display:flex;flex-direction:column}.s:nth-of-type(2) h2{order:-2}.s:nth-of-type(2) .sys{order:-1}.s:nth-of-type(2) .g,.s:nth-of-type(2) .t,.s:nth-of-type(2) .add{order:0}</style>
<div class="p"><form method="post" asp-action="CreateEmployeeBenefitApplication">@Html.AntiForgeryToken()<header class="h"><h1>New Employee Benefit Application</h1><button class="save">Save</button></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}<main class="card"><section class="s"><h2>Employee</h2><div class="g"><div class="f"><label>Employee *</label><select name="Employee" id="e" class="sel" required><option value="">Select employee</option>@foreach(var x in employees){<option value="@x.Id" data-name="@x.EmployeeName" data-department="@x.Department" data-company="@x.Company">@x.Id</option>}</select></div><div class="f"><label>Employee Name</label><input id="n" class="i" readonly/></div><div class="f"><label>Department</label><input id="d" class="i" readonly/></div><div class="f"><label>Date *</label><input id="benefitDate" name="Date" class="i" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required/></div><div class="f"><label>Payroll Period *</label><select name="PayrollPeriod" class="sel" required><option value="">Select payroll period</option>@foreach(var x in periods){<option value="@x">@x</option>}</select></div><div class="f"><label>Company *</label><input id="co" name="Company" class="i" readonly required/></div><div class="f"><label>Amended From</label><input class="i" readonly/></div></div></section><section class="s"><h2>Benefits</h2><div class="g"><div class="f"><label>Currency *</label><select id="benefitCurrency" name="Currency" class="sel" required><option value="">Select currency</option>@foreach(var x in currencies){<option value="@x">@x</option>}</select></div><div class="f"><label>Max Benefits (Yearly)</label><input id="maxBenefits" name="MaxBenefits" class="i" readonly/></div><div class="f"><label>Remaining Benefits (Yearly)</label><input id="remainingBenefit" name="RemainingBenefit" class="i" readonly/></div></div><p class="sys">Limits and benefit components are loaded from the employee's submitted Salary Structure Assignment.</p><table class="t"><thead><tr><th>Earning Component</th><th>Max Benefit Amount</th><th>Amount</th></tr></thead><tbody id="rows"><tr class="benefit-row"><td><select name="EarningComponents" class="earning-component"><option value="">Select earning component</option>@foreach(var x in components){<option value="@x">@x</option>}</select></td><td><input name="BenefitMaxAmounts" class="benefit-max" readonly/></td><td><input name="BenefitAmounts" type="number" min="0" step="0.01"/></td></tr></tbody></table><button class="add" type="button" id="add">Add Row</button></section><section class="s"><h2>Totals</h2><div class="g"><div class="f"><label>Total Amount</label><input id="totalBenefitAmount" class="i" readonly/></div><div class="f"><label>Dispensed Amount (Pro-rated)</label><input class="i" readonly/></div></div></section></main></form></div><script>const toNumber=value=>Number.parseFloat(value)||0;e.onchange=async()=>{let o=e.options[e.selectedIndex];n.value=o.dataset.name||'';d.value=o.dataset.department||'';co.value=o.dataset.company||'';if(!e.value){maxBenefits.value='';remainingBenefit.value='';return}let response=await fetch('@Url.Action("BenefitApplicationEmployeeLimits","HR")?employee='+encodeURIComponent(e.value)+'&date='+encodeURIComponent(benefitDate.value)),data=await response.json();if(!response.ok||!data.success){alert(data.message||'Unable to load employee benefit limits.');maxBenefits.value='';remainingBenefit.value='';return}maxBenefits.value=data.maxBenefits||'0';remainingBenefit.value=data.remainingBenefit||'0';if(data.currency)benefitCurrency.value=data.currency;rows.innerHTML='';(data.benefits||[]).forEach(benefit=>{let r=document.createElement('tr');r.className='benefit-row';r.innerHTML=rows.dataset.template;r.querySelector('.earning-component').value=benefit.earningComponent;r.querySelector('.benefit-max').value=benefit.maxBenefitAmount||'0';rows.append(r)});if(!rows.children.length)add.onclick();calculateTotals()};benefitDate.onchange=()=>{if(e.value)e.onchange()};function calculateTotals(){let total=[...rows.querySelectorAll('[name="BenefitAmounts"]')].reduce((sum,input)=>sum+toNumber(input.value),0);totalBenefitAmount.value=total.toFixed(2);remainingBenefit.value=(toNumber(maxBenefits.value)-total).toFixed(2)}async function fillMax(row){let component=row.querySelector('.earning-component').value,max=row.querySelector('.benefit-max');max.value='';if(!component)return;let response=await fetch('@Url.Action("BenefitComponentMaxAmount","HR")?earningComponent='+encodeURIComponent(component)),data=await response.json();if(!response.ok||!data.success){alert(data.message||'Unable to load max benefit amount.');return}max.value=data.maxBenefitAmount||'0'}rows.dataset.template='<td><select name="EarningComponents" class="earning-component"><option value="">Select earning component</option>@foreach(var x in components){<option value="@x">@x</option>}</select></td><td><input name="BenefitMaxAmounts" class="benefit-max" readonly/></td><td><input name="BenefitAmounts" type="number" min="0" step="0.01"/></td>';rows.addEventListener('change',event=>{if(event.target.classList.contains('earning-component'))fillMax(event.target.closest('.benefit-row'));if(event.target.name==='BenefitAmounts')calculateTotals()});rows.addEventListener('input',event=>{if(event.target.name==='BenefitAmounts')calculateTotals()});add.onclick=()=>{let r=document.createElement('tr');r.className='benefit-row';r.innerHTML=rows.dataset.template;rows.append(r)};</script>
