@{
    ViewBag.Title = "Tax & Benefits";
}

<style>
    .workspace-shell {
        max-width: 980px;
        margin: 0 auto;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 22px;
        min-height: 650px;
        position: relative;
    }

    .workspace-title {
        font-size: 22px;
        font-weight: 700;
        margin-bottom: 24px;
    }

    .shortcut-row {
        display: grid;
        grid-template-columns: 1.2fr 1fr 1fr;
        gap: 24px;
        margin-bottom: 42px;
        align-items: center;
    }

    .workspace-link {
        color: #111827;
        text-decoration: none;
        font-size: 14px;
        display: inline-block;
        line-height: 1.6;
    }

        .workspace-link:hover {
            color: #2563eb;
            text-decoration: underline;
        }

    .external-arrow {
        color: #6b7280;
        font-size: 12px;
        margin-left: 4px;
    }

    .badge-soft {
        display: inline-block;
        margin-left: 6px;
        padding: 2px 8px;
        border-radius: 999px;
        background: #eef0f3;
        color: #4b5563;
        font-size: 12px;
        font-weight: 600;
    }

    .section-heading {
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 24px;
    }

    .workspace-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(210px, 1fr));
        column-gap: 64px;
        row-gap: 34px;
    }

    .workspace-group h6 {
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 14px;
    }

    .workspace-group ul {
        list-style: none;
        padding-left: 0;
        margin: 0;
    }

    .workspace-group li {
        margin-bottom: 11px;
    }

    .workspace-actions {
        position: absolute;
        right: 14px;
        bottom: 14px;
        display: flex;
        gap: 8px;
    }

        .workspace-actions a {
            border: 0;
            background: #f3f4f6;
            color: #111827;
            border-radius: 7px;
            padding: 6px 12px;
            font-size: 13px;
            text-decoration: none;
        }

            .workspace-actions a:hover {
                background: #e5e7eb;
            }

    @@media (max-width: 900px) {
        .shortcut-row,
        .workspace-grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .workspace-shell {
            padding: 16px;
        }

        .workspace-actions {
            position: static;
            margin-top: 30px;
        }
    }
</style>

<div class="workspace-shell">
    <h5 class="mb-4 fw-bold">Your Shortcuts</h5>

    <div class="shortcut-row">
        <a class="workspace-link" href="@Url.Action("EmployeeTaxExemptionDeclaration", "HR")">
            Employee Tax Exemption Declaration <span class="external-arrow">↗</span>
        </a>

        <a class="workspace-link" href="@Url.Action("AdditionalSalary", "HR")">
            Additional Salary <span class="external-arrow">↗</span>
            <span class="badge-soft">0</span>
        </a>

        <a class="workspace-link" href="@Url.Action("IncomeTaxComputation", "HR")">
            Income Tax Computation <span class="external-arrow">↗</span>
        </a>
    </div>

    <div class="section-heading">Masters &amp; Reports</div>

    <div class="workspace-grid">
        <div class="workspace-group">
            <h6>Tax Setup</h6>
            <ul>
                <li>
                    <a class="workspace-link" href="@Url.Action("IncomeTaxSlab", "HR")">
                        Income Tax Slab <span class="external-arrow">↗</span>
                    </a>
                </li>
                <li>
                    <a class="workspace-link" href="@Url.Action("EmployeeTaxExemptionCategory", "HR")">
                        Employee Tax Exemption Category <span class="external-arrow">↗</span>
                    </a>
                </li>
                <li>
                    <a class="workspace-link" href="@Url.Action("EmployeeTaxExemptionSubCategory", "HR")">
                        Employee Tax Exemption Sub Category <span class="external-arrow">↗</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="workspace-group">
            <h6>Exemption</h6>
            <ul>
                <li>
                    <a class="workspace-link" href="@Url.Action("EmployeeTaxExemptionDeclaration", "HR")">
                        Employee Tax Exemption Declaration <span class="external-arrow">↗</span>
                    </a>
                </li>
                <li>
                    <a class="workspace-link" href="@Url.Action("EmployeeTaxExemptionProofSubmission", "HR")">
                        Employee Tax Exemption Proof Submission <span class="external-arrow">↗</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="workspace-group">
            <h6>Benefits</h6>
            <ul>
                <li>
                    <a class="workspace-link" href="@Url.Action("EmployeeBenefitApplication", "HR")">
                        Employee Benefit Application <span class="external-arrow">↗</span>
                    </a>
                </li>
                <li>
                    <a class="workspace-link" href="@Url.Action("EmployeeBenefitClaim", "HR")">
                        Employee Benefit Claim <span class="external-arrow">↗</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="workspace-group">
            <h6>Reports</h6>
            <ul>
                <li>
                    <a class="workspace-link" href="@Url.Action("IncomeTaxComputation", "HR")">
                        Income Tax Computation <span class="external-arrow">↗</span>
                    </a>
                </li>
                <li>
                    <a class="workspace-link" href="@Url.Action("IncomeTaxDeductions", "HR")">
                        Income Tax Deductions <span class="external-arrow">↗</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <div class="workspace-actions">
        <a href="#">↗ Edit</a>
        <a href="#">+ New</a>
    </div>
</div>

<style>
    .workspace-shell { max-width: 1100px; margin: 0 auto; padding: 30px; border: 1px solid #e7e8f2; border-radius: 16px; box-shadow: 0 8px 26px rgba(20,41,68,.07); color:#17183b; }
    .workspace-shell > h5 { font-size: 24px; letter-spacing: -.02em; margin-bottom: 22px !important; }
    .shortcut-row { gap: 14px; margin-bottom: 34px; }
    .shortcut-row > a { display:flex; align-items:center; min-height:72px; padding: 16px 18px; border:1px solid #e7e8f2; border-radius:11px; background:#fbfaff; color:#42617f; text-decoration:none; font-weight:650; }
    .shortcut-row > a:hover { border-color:#9cc5dc; color:#142944; transform:translateY(-2px); box-shadow:0 7px 16px rgba(18,135,127,.12); }
    .workspace-link { color:#535775; font-size:14px; text-decoration:none; }
    .workspace-link:hover { color:#142944; }
    .external-arrow { color:#12877f; }
    .badge-soft { background:#eaf2f8; color:#142944; }
    .section-heading { color:#17183b; font-size:20px; margin-bottom:18px; }
    .workspace-grid { gap:16px; column-gap:16px; }
    .workspace-group { border:1px solid #e7e8f2; border-radius:12px; padding:20px; min-height:150px; background:#fff; transition:.18s ease; }
    .workspace-group:hover { border-color:#c4dbe8; box-shadow:0 7px 18px rgba(20,41,68,.08); }
    .workspace-group h6 { color:#17183b; font-size:15px; margin-bottom:15px; }
    .workspace-group li { margin-bottom:12px; }
    .workspace-actions { position:static; justify-content:flex-end; margin-top:24px; }
    .workspace-actions a { border:1px solid #d6e6ef; background:#fff; color:#142944; padding:9px 14px; }
    @@media(max-width:900px){.workspace-shell{padding:20px}.shortcut-row,.workspace-grid{grid-template-columns:1fr}.workspace-actions{justify-content:flex-start}}
</style>


