@model List<Erp_Aits.Models.EmployeeGrievance>
@{
    ViewBag.Title = "Employee Grievance";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @TempData["ErpNextError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Employee Grievance</h4>
    <div class="d-flex gap-2">
        <form action="/HR/SyncEmployeeGrievancesFromErpNext" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-primary btn-sm">⚡ Sync from ERPNext</button>
        </form>
        <a href="/HR/CreateEmployeeGrievance" class="btn btn-dark btn-sm">+ Add Employee Grievance</a>
    </div>
</div>

<form method="get" action="/HR/EmployeeGrievance" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="id" class="form-control form-control-sm" placeholder="ID" value="@ViewBag.IdFilter" />
    </div>
    <div class="col-auto">
        <input type="text" name="subject" class="form-control form-control-sm" placeholder="Subject" value="@ViewBag.SubjectFilter" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
    </div>
</form>

@if (Model.Any())
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>ERPNext Ref</th>
                <th>Subject</th>
                <th>Status</th>
                <th>Raised By</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var g in Model)
            {
                <tr style="cursor:pointer" onclick="window.location='/HR/EmployeeGrievanceDetails/@g.Id'">
                    <td><strong>@g.Id</strong></td>
                    <td><small class="text-muted">@(string.IsNullOrEmpty(g.ErpNextId) ? "-" : g.ErpNextId)</small></td>
                    <td>@g.Subject</td>
                    <td>
                        <span class="badge @(g.Status == "Resolved" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning")">
                            @g.Status
                        </span>
                    </td>
                    <td>@g.RaisedBy</td>
                    <td>@g.GrievanceDate.ToString("yyyy-MM-dd")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted text-center py-5">No employee grievances found.</p>
}