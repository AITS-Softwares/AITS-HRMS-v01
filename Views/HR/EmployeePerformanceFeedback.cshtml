@model List<Erp_Aits.Models.EmployeePerformanceFeedback>
@{
    ViewBag.Title = "Employee Performance Feedback";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @TempData["ErpNextError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Employee Performance Feedback</h4>
    <div class="d-flex gap-2">
        <a href="@Url.Action("CreateEmployeePerformanceFeedback", "HR")" class="btn btn-dark btn-sm">+ Add Employee Performance Feedback</a>
    </div>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="id" class="form-control form-control-sm" placeholder="ID" value="@ViewBag.IdFilter" />
    </div>
    <div class="col-auto">
        <input type="text" name="forEmployee" class="form-control form-control-sm" placeholder="For Employee" value="@ViewBag.ForEmployeeFilter" />
    </div>
    <div class="col-auto">
        <input type="text" name="employeeName" class="form-control form-control-sm" placeholder="Employee Name" value="@ViewBag.EmployeeNameFilter" />
    </div>
    <div class="col-auto">
        <input type="text" name="reviewer" class="form-control form-control-sm" placeholder="Reviewer" value="@ViewBag.ReviewerFilter" />
    </div>
    <div class="col-auto">
        <input type="text" name="Appraisal" class="form-control form-control-sm" placeholder="Appraisal Cycle" value="@ViewBag.AppraisalCycleFilter" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>ERPNext Ref</th>
            <th>For Employee</th>
            <th>Employee Name</th>
            <th>Reviewer</th>
            <th>Added On</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var f in Model)
        {
            <tr style="cursor:pointer" onclick="window.location='@Url.Action("EmployeePerformanceFeedbackDetails", "HR", new { id = f.Id })'">
                <td><strong>@f.Id</strong></td>
                <td>
                    @if (!string.IsNullOrEmpty(f.ErpNextId))
                    {
                        <span class="badge bg-success-subtle text-success">@f.ErpNextId</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-muted">Not Synced</span>
                    }
                </td>
                <td>@f.ForEmployee</td>
                <td>@f.EmployeeName</td>
                <td>@f.Reviewer</td>
                <td>@f.AddedOn.ToString("dd-MM-yyyy HH:mm")</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted text-center py-5">No feedback records found.</p>
}
