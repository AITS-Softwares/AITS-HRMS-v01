@model Erp_Aits.Models.EmployeeGrade
@{
    ViewBag.Title = "New Employee Grade";
}

<form asp-action="CreateEmployeeGrade" asp-controller="HR" method="post" class="employee-grade-form">
    @Html.AntiForgeryToken()

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">New Employee Grade</h4>

        <div class="d-flex gap-2">
            <a href="@Url.Action("EmployeeGrades", "HR")"
               class="btn btn-outline-secondary btn-sm">
                Back
            </a>

            <button type="submit" class="btn btn-dark btn-sm px-4">
                Save
            </button>
        </div>
    </div>

    @if (TempData["ErpNextError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErpNextError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card p-4 shadow-sm bg-white border">
        <div class="mb-3">
            <label class="form-label">
                Name <span class="text-danger">*</span>
            </label>

            <input asp-for="GradeName"
                   class="form-control"
                   required
                   autofocus
                   placeholder="Enter Grade Name" />
        </div>

        <div class="mb-3">
            <label class="form-label">
                Default Salary Structure
            </label>

            <input asp-for="DefaultSalaryStructure"
                   class="form-control"
                   list="salaryStructureList"
                   placeholder="Select or type salary structure" />

            <datalist id="salaryStructureList">
                @if (ViewBag.SalaryStructures != null)
                {
                    foreach (var ss in ViewBag.SalaryStructures)
                    {
                        <option value="@ss.name">@ss.name</option>
                    }
                }
            </datalist>
        </div>

        <div id="basePayBox" style="display:none;">
            <label class="form-label">
                Default Base Pay
            </label>

            <input asp-for="DefaultBasePay"
                   class="form-control"
                   type="number"
                   step="0.01"
                   placeholder="Enter Default Base Pay" />
        </div>
    </div>
</form>

<script>
    const salaryInput = document.querySelector('[name="DefaultSalaryStructure"]');
    const basePayBox = document.getElementById('basePayBox');

    function toggleBasePay() {
        if (!salaryInput || !basePayBox) {
            return;
        }

        basePayBox.style.display = salaryInput.value.trim() ? 'block' : 'none';
    }

    if (salaryInput) {
        salaryInput.addEventListener('input', toggleBasePay);
        salaryInput.addEventListener('change', toggleBasePay);
    }

    toggleBasePay();
</script>

<style>
    .employee-grade-form{max-width:1080px;margin:8px auto 40px;padding:26px;border:1px solid #c7daea;border-radius:8px;background:#edf5fb;box-shadow:0 16px 34px rgba(19,55,91,.10);color:#173555}.employee-grade-form> .d-flex:first-of-type{margin:-26px -26px 24px!important;padding:20px 26px;background:#14365d;border-radius:8px 8px 0 0}.employee-grade-form h4{color:#fff;font-weight:760}.employee-grade-form .btn{border-radius:6px;font-weight:700}.employee-grade-form .btn-dark{border-color:#16a085;background:#108c77;box-shadow:0 5px 12px rgba(16,140,119,.2)}.employee-grade-form .btn-dark:hover{background:#087361}.employee-grade-form .btn-outline-secondary{border-color:#91acc7;color:#e7f1fb}.employee-grade-form .btn-outline-secondary:hover{background:#fff;color:#163d64}.employee-grade-form .card{border:1px solid #c8ddec!important;border-radius:8px!important;background:#fff!important;box-shadow:0 8px 20px rgba(16,49,82,.07)!important}.employee-grade-form .form-label{color:#315879!important;font-weight:720!important}.employee-grade-form .form-control{min-height:42px;border-color:#b9cee2;border-radius:6px;color:#183b60}.employee-grade-form .form-control:focus{border-color:#159b84;box-shadow:0 0 0 3px rgba(21,155,132,.14)}
    @@media(max-width:640px){.employee-grade-form{padding:16px}.employee-grade-form> .d-flex:first-of-type{align-items:flex-start!important;flex-direction:column;margin:-16px -16px 18px!important;padding:18px}}
</style>
