@model Erp_Aits.Models.TravelRequest

@{
    ViewBag.Title = "Create Travel Request";

    var travelTypes = ViewBag.TravelTypes as IEnumerable<string>
        ?? Enumerable.Empty<string>();

    var travelFunding = ViewBag.TravelFunding as IEnumerable<string>
        ?? Enumerable.Empty<string>();

    var travelModes = ViewBag.ModesOfTravel as IEnumerable<string>
        ?? Enumerable.Empty<string>();
}

<style>
    .ea-form-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        gap: 12px;
    }

    .ea-detail-header-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .ea-back-btn {
        width: 38px;
        height: 38px;
        display: flex;
        justify-content: center;
        align-items: center;
        border: 1px solid #ddd;
        border-radius: 10px;
        background: white;
        text-decoration: none;
        color: #333;
        font-size: 22px;
    }

    .ea-breadcrumb {
        color: #9aa0a6;
        font-size: 12px;
        text-transform: uppercase;
    }

    .ea-section {
        background: white;
        padding: 24px;
        border-radius: 14px;
        margin-bottom: 18px;
        box-shadow: 0 2px 10px rgba(0,0,0,.05);
    }

    .ea-section-title {
        font-size: 16px;
        font-weight: 600;
        padding-bottom: 12px;
        margin-bottom: 18px;
        border-bottom: 1px solid #eee;
    }

    .ea-form-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 6px;
        color: #495057;
    }

    .ea-required {
        color: #dc3545;
    }

    .ea-input {
        width: 100%;
        padding: 9px 12px;
        border-radius: 8px;
        border: 1px solid #dfe2e6;
        background: white;
        font-size: 14px;
    }

        .ea-input:focus {
            outline: none;
            border-color: #495057;
            box-shadow: 0 0 0 3px rgba(73,80,87,.1);
        }

    .ea-readonly {
        background: #f8f9fa;
    }

    .ea-help {
        color: #6c757d;
        font-size: 12px;
        margin-top: 5px;
    }

    .ea-field-error {
        color: #dc3545;
        font-size: 12px;
        margin-top: 5px;
    }

    .ea-table-wrapper {
        overflow-x: auto;
    }

    .ea-mini-table {
        min-width: 900px;
    }

        .ea-mini-table th {
            background: #f8f9fa;
            color: #6c757d;
            white-space: nowrap;
            font-size: 12px;
            padding: 10px;
        }

        .ea-mini-table td {
            vertical-align: middle;
            padding: 8px;
        }

        .ea-mini-table input,
        .ea-mini-table select {
            min-width: 120px;
            font-size: 13px;
        }

    .ea-summary {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 14px;
        font-weight: 600;
        text-align: right;
    }

    .ea-submit-btn {
        font-weight: 600;
        padding: 12px;
        border-radius: 10px;
    }

    .ea-mobile-save {
        position: sticky;
        bottom: 0;
        background: #fff;
        padding: 12px 0;
        border-top: 1px solid #eee;
        z-index: 10;
    }

    .erp-link-wrapper {
        position: relative;
    }

    .erp-link-menu {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 1050;
        max-height: 220px;
        overflow-y: auto;
        background: #fff;
        border: 1px solid #dfe2e6;
        border-radius: 8px;
        box-shadow: 0 6px 18px rgba(0,0,0,.12);
        display: none;
    }

    .erp-link-option {
        display: block;
        width: 100%;
        text-align: left;
        border: 0;
        background: #fff;
        padding: 9px 12px;
        cursor: pointer;
        font-size: 13px;
    }

        .erp-link-option:hover {
            background: #f0f4ff;
        }

        .erp-link-option small {
            display: block;
            color: #6c757d;
            margin-top: 2px;
        }

    .erp-link-status {
        padding: 10px 12px;
        font-size: 12px;
        color: #6c757d;
    }

    @@media(max-width:767px) {
        .ea-section {
            padding: 16px;
        }
    }
</style>

<div class="ea-form-header">

    <div class="ea-detail-header-left">

        <a href="@Url.Action("TravelRequest", "HR")"
           class="ea-back-btn">←</a>

        <div>
            <div class="ea-breadcrumb">Travel Request</div>
            <h4 class="mb-0">Create Travel Request</h4>
        </div>

    </div>

    <span class="badge bg-warning text-dark">Not Saved</span>

</div>

@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErpNextError"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<div id="clientError"
     class="alert alert-danger d-none"></div>

<form id="travelRequestForm"
      method="post"
      action="@Url.Action("CreateTravelRequest", "HR")"
      enctype="multipart/form-data">

    @Html.AntiForgeryToken()

    <!-- GENERAL DETAILS -->

    <div class="ea-section">

        <div class="ea-section-title">
            🧭 General Details
        </div>

        <div class="row g-3">

            <div class="col-md-6">

                <label class="ea-form-label">
                    Travel Type <span class="ea-required">*</span>
                </label>

                <select asp-for="TravelType"
                        id="TravelType"
                        class="form-select ea-input"
                        required>

                    <option value="">-- Select Travel Type --</option>

                    @foreach (var item in travelTypes)
                    {
                        <option value="@item">@item</option>
                    }

                </select>

            </div>

            <div class="col-md-6">

                <label class="ea-form-label">
                    Purpose of Travel <span class="ea-required">*</span>
                </label>

                <div class="erp-link-wrapper">

                    <input asp-for="PurposeOfTravel"
                           id="PurposeOfTravel"
                           data-master="PurposeOfTravel"
                           class="form-control ea-input erp-link"
                           autocomplete="off"
                           placeholder="Search Purpose of Travel"
                           required />

                    <div class="erp-link-menu"></div>

                </div>

            </div>

            <div class="col-md-6">

                <label class="ea-form-label">
                    Travel Funding
                </label>

                <select asp-for="TravelFunding"
                        id="TravelFunding"
                        class="form-select ea-input">

                    <option value="">-- Select Travel Funding --</option>

                    @foreach (var item in travelFunding)
                    {
                        <option value="@item">@item</option>
                    }

                </select>

            </div>

            <div class="col-md-6">

                <label class="ea-form-label">
                    Details of Sponsor (Name, Location)
                </label>

                <input asp-for="DetailsOfSponsor"
                       class="form-control ea-input" />

            </div>

            <div class="col-md-6">

                <label class="ea-form-label">
                    Copy of Invitation/Announcement
                </label>

                <input asp-for="CopyOfInvitation"
                       id="CopyOfInvitation"
                       class="form-control ea-input"
                       placeholder="ERPNext attachment URL" />

                <div class="ea-help">
                    Enter an existing ERPNext-hosted file URL.
                    Uploading a new local file requires the separate
                    ERPNext upload_file integration.
                </div>

            </div>

        </div>

    </div>


    <!-- EMPLOYEE DETAILS -->

    <div class="ea-section">

        <div class="ea-section-title">
            👤 Employee Details
        </div>

        <div class="row g-3">

            <!-- EMPLOYEE DROPDOWN -->

            <div class="col-md-6">

                <label class="ea-form-label">
                    Employee <span class="ea-required">*</span>
                </label>

                <div class="erp-link-wrapper">

                    <input asp-for="Employee"
                           id="employeeSelect"
                           data-master="Employee"
                           class="form-control ea-input erp-link"
                           autocomplete="off"
                           placeholder="Search ERPNext Employee"
                           required />

                    <div class="erp-link-menu"></div>

                </div>

                <div id="employeeError"
                     class="ea-field-error"></div>

            </div>

            <div class="col-md-6">

                <label class="ea-form-label">Employee Name</label>

                <input asp-for="EmployeeName"
                       id="employeeNameInput"
                       class="form-control ea-input ea-readonly"
                       readonly />

            </div>

            <div class="col-md-6">

                <label class="ea-form-label">Date of Birth</label>

                <input type="date"
                       asp-for="DateOfBirth"
                       asp-format="{0:yyyy-MM-dd}"
                       id="DateOfBirth"
                       class="form-control ea-input ea-readonly"
                       readonly />

            </div>

            <!-- IDENTIFICATION DOCUMENT TYPE DROPDOWN -->

            <div class="col-md-6">

                <label class="ea-form-label">
                    Identification Document Type
                </label>

                <div class="erp-link-wrapper">

                    <input asp-for="IdentificationDocumentType"
                           id="IdentificationDocumentType"
                           data-master="IdentificationDocumentType"
                           class="form-control ea-input erp-link"
                           autocomplete="off"
                           placeholder="Search Document Type" />

                    <div class="erp-link-menu"></div>

                </div>

            </div>

            <div class="col-md-6">

                <label class="ea-form-label">
                    Identification Document Number
                </label>

                <input asp-for="IdentificationDocumentNumber"
                       class="form-control ea-input" />

            </div>

            <div class="col-md-6">

                <label class="ea-form-label">Contact Number</label>

                <input asp-for="ContactNumber"
                       id="ContactNumber"
                       class="form-control ea-input" />

            </div>

            <div class="col-md-6">

                <label class="ea-form-label">Contact Email</label>

                <input asp-for="ContactEmail"
                       type="email"
                       id="ContactEmail"
                       class="form-control ea-input" />

            </div>

            <div class="col-md-6">

                <label class="ea-form-label">Passport Number</label>

                <input asp-for="PassportNumber"
                       id="PassportNumber"
                       class="form-control ea-input" />

            </div>

            <!-- COMPANY DROPDOWN -->

            <div class="col-md-6">

                <label class="ea-form-label">
                    Company <span class="ea-required">*</span>
                </label>

                <div class="erp-link-wrapper">

                    <input asp-for="Company"
                           id="Company"
                           data-master="Company"
                           class="form-control ea-input erp-link"
                           autocomplete="off"
                           placeholder="Search ERPNext Company"
                           required />

                    <div class="erp-link-menu"></div>

                </div>

                <div class="ea-help">
                    Autofilled on Employee selection, but you can select
                    another Company from ERPNext.
                </div>

            </div>

        </div>

    </div>


    <!-- DESCRIPTION -->

    <div class="ea-section">

        <div class="ea-section-title">
            📝 Description
        </div>

        <label class="ea-form-label">
            Any other details
        </label>

        <textarea asp-for="OtherDetailsDescription"
                  class="form-control ea-input"
                  rows="3"></textarea>

    </div>


    <!-- TRAVEL ITINERARY -->

    <div class="ea-section">

        <div class="ea-section-title">
            🛫 Travel Itinerary
        </div>

        <div class="ea-table-wrapper">

            <table id="itineraryTable"
                   class="table table-bordered ea-mini-table">

                <thead>

                    <tr>
                        <th>No.</th>
                        <th>Travel From</th>
                        <th>Travel To</th>
                        <th>Mode of Travel</th>
                        <th>Departure Datetime</th>
                        <th>Action</th>
                    </tr>

                </thead>

                <tbody id="itineraryBody"></tbody>

            </table>

        </div>

        <button type="button"
                class="btn btn-outline-dark btn-sm mt-2"
                onclick="addItineraryRow()">

            + Add Itinerary

        </button>

    </div>


    <!-- COSTING DETAILS -->

    <div class="ea-section">

        <div class="ea-section-title">
            💰 Costing Details
        </div>

        <div class="ea-table-wrapper">

            <table id="costingTable"
                   class="table table-bordered ea-mini-table">

                <thead>

                    <tr>
                        <th>No.</th>
                        <th>Expense Type</th>
                        <th>Sponsored Amount</th>
                        <th>Funded Amount</th>
                        <th>Total Amount</th>
                        <th>Action</th>
                    </tr>

                </thead>

                <tbody id="costingBody"></tbody>

            </table>

        </div>

        <button type="button"
                class="btn btn-outline-dark btn-sm mt-2"
                onclick="addCostingRow()">

            + Add Costing

        </button>

        <div class="ea-summary mt-3">

            Total Estimated Cost:
            <span id="grandTotal">0.00</span>

        </div>

    </div>


    <!-- ACCOUNTING DIMENSIONS -->

    <div class="ea-section">

        <div class="ea-section-title">
            🗂️ Accounting Dimensions
        </div>

        <div class="row g-3">

            <!-- COST CENTER DROPDOWN -->

            <div class="col-md-6">

                <label class="ea-form-label">
                    Cost Center
                </label>

                <div class="erp-link-wrapper">

                    <input asp-for="CostCenter"
                           id="CostCenter"
                           data-master="CostCenter"
                           class="form-control ea-input erp-link"
                           autocomplete="off"
                           placeholder="Search ERPNext Cost Center" />

                    <div class="erp-link-menu"></div>

                </div>

            </div>

        </div>

    </div>


    <!-- EVENT DETAILS -->

    <div class="ea-section">

        <div class="ea-section-title">
            🎤 Event Details
        </div>

        <div class="row g-3">

            <div class="col-md-6">

                <label class="ea-form-label">
                    Name of Organizer
                </label>

                <input asp-for="NameOfOrganizer"
                       class="form-control ea-input" />

            </div>

            <div class="col-md-6">

                <label class="ea-form-label">
                    Address of Organizer
                </label>

                <input asp-for="AddressOfOrganizer"
                       class="form-control ea-input" />

            </div>

            <div class="col-md-12">

                <label class="ea-form-label">
                    Other Details
                </label>

                <textarea asp-for="EventOtherDetails"
                          class="form-control ea-input"
                          rows="3"></textarea>

            </div>

        </div>

    </div>


    <!-- SAVE -->

    <button type="submit"
            class="btn btn-dark w-100 ea-submit-btn d-none d-md-block">

        ✈️ Save &amp; Sync Travel Request

    </button>

    <div class="ea-mobile-save d-md-none">

        <button type="submit"
                class="btn btn-dark w-100 ea-submit-btn">

            ✈️ Save &amp; Sync

        </button>

    </div>

</form>


<script>

    // CONTROLLER URLS

    const ERP_SEARCH_URL =
        '@Url.Action("SearchTravelRequestMaster", "HR")';

    const EMPLOYEE_URL =
        '@Url.Action("GetTravelRequestEmployeeDetails", "HR")';

    // Only use actual values provided by your existing controller.

    const travelModes = @Html.Raw(
                Newtonsoft.Json.JsonConvert.SerializeObject(travelModes)
        );

    let itineraryIndex = 0;
    let costingIndex = 0;

    const linkTimers = new WeakMap();
    const linkVersions = new WeakMap();


    // SAFE STRING FOR DYNAMIC HTML

    function esc(value) {

        return String(value ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');

    }


    // DISPLAY ERROR

    function showError(message) {

        const box = document.getElementById('clientError');

        box.textContent = message;
        box.classList.remove('d-none');

        box.scrollIntoView({
            behavior: 'smooth',
            block: 'center'
        });

    }


    // CLOSE ALL OTHER LINK DROPDOWNS

    function closeLinkMenus(except = null) {

        document.querySelectorAll('.erp-link-menu')
            .forEach(function (menu) {

                if (menu !== except)
                    menu.style.display = 'none';

            });

    }


    // REAL ERP LINK SEARCH

    async function searchErpLink(input) {

        const master = input.dataset.master;

        const menu = input.parentElement.querySelector(
            '.erp-link-menu'
        );

        if (!master || !menu)
            return;

        const query = input.value.trim();

        const version = (linkVersions.get(input) || 0) + 1;

        linkVersions.set(input, version);

        closeLinkMenus(menu);

        menu.innerHTML =
            '<div class="erp-link-status">Loading ERPNext records...</div>';

        menu.style.display = 'block';

        try {

            const url =
                ERP_SEARCH_URL +
                '?master=' + encodeURIComponent(master) +
                '&search=' + encodeURIComponent(query);

            const response = await fetch(url, {
                credentials: 'same-origin'
            });

            if (!response.ok)
                throw new Error('HRMS search HTTP ' + response.status);

            const data = await response.json();

            if (!data.success)
                throw new Error(
                    data.message || 'ERPNext search failed.'
                );

            // Ignore outdated requests when user types quickly.

            if (linkVersions.get(input) !== version)
                return;

            menu.innerHTML = '';

            const items = data.items || [];

            if (!items.length) {

                menu.innerHTML =
                    '<div class="erp-link-status">No ERPNext records found.</div>';

                menu.style.display = 'block';

                return;

            }

            items.forEach(function (item) {

                const option = document.createElement('button');

                option.type = 'button';
                option.className = 'erp-link-option';

                const value = item.value || '';
                const description = item.description || '';

                const nameElement = document.createElement('span');

                nameElement.textContent = value;

                option.appendChild(nameElement);

                if (description) {

                    const descriptionElement =
                        document.createElement('small');

                    descriptionElement.textContent = description;

                    option.appendChild(descriptionElement);

                }

                option.addEventListener('click', function () {

                    input.value = value;

                    input.dataset.selectedValue = value;

                    menu.style.display = 'none';

                    input.dispatchEvent(
                        new Event('erp-link-selected', {
                            bubbles: true
                        })
                    );

                });

                menu.appendChild(option);

            });

            menu.style.display = 'block';

        } catch (error) {

            if (linkVersions.get(input) !== version)
                return;

            menu.innerHTML = '';

            const errorElement = document.createElement('div');

            errorElement.className = 'erp-link-status text-danger';

            errorElement.textContent =
                'Unable to load ERPNext records: ' + error.message;

            menu.appendChild(errorElement);

            menu.style.display = 'block';

            console.error(master, error);

        }

    }


    // ATTACH ERP SEARCH TO EACH LINK INPUT

    function attachErpLink(input) {

        if (!input || input.dataset.linkInitialized === '1')
            return;

        input.dataset.linkInitialized = '1';

        // A previously restored model value is not considered newly
        // validated; the server must still validate it on Save.

        input.addEventListener('focus', function () {

            searchErpLink(input);

        });

        input.addEventListener('input', function () {

            input.dataset.selectedValue = '';

            clearTimeout(linkTimers.get(input));

            const timer = setTimeout(function () {

                searchErpLink(input);

            }, 250);

            linkTimers.set(input, timer);

        });

    }


    // INITIALIZE ERP LINKS

    function initializeErpLinks(root = document) {

        root.querySelectorAll('.erp-link').forEach(function (input) {

            attachErpLink(input);

        });

    }


    // CLOSE WHEN CLICKING OUTSIDE

    document.addEventListener('click', function (event) {

        if (!event.target.closest('.erp-link-wrapper')) {

            closeLinkMenus();

        }

    });


    // EMPLOYEE AUTOFILL

    let employeeLookupVersion = 0;

    async function fillEmployeeDetails(input) {

        const employee = input.value.trim();

        const version = ++employeeLookupVersion;

        const errorBox =
            document.getElementById('employeeError');

        errorBox.textContent = '';

        const ids = [
            'employeeNameInput',
            'DateOfBirth',
            'ContactNumber',
            'ContactEmail',
            'PassportNumber',
            'Company'
        ];

        ids.forEach(function (id) {

            document.getElementById(id).value = '';

        });

        if (!employee)
            return;

        try {

            const url =
                EMPLOYEE_URL +
                '?employee=' + encodeURIComponent(employee);

            const response = await fetch(url, {
                credentials: 'same-origin'
            });

            if (!response.ok)
                throw new Error('Employee lookup HTTP ' + response.status);

            const data = await response.json();

            if (!data.success)
                throw new Error(
                    data.message || 'Employee not found in ERPNext.'
                );

            if (version !== employeeLookupVersion)
                return;

            if (input.value.trim() !== employee)
                return;

            document.getElementById('employeeNameInput').value =
                data.employeeName || '';

            document.getElementById('DateOfBirth').value =
                (data.dateOfBirth || '').substring(0, 10);

            document.getElementById('ContactNumber').value =
                data.contactNumber || '';

            document.getElementById('ContactEmail').value =
                data.contactEmail || '';

            document.getElementById('PassportNumber').value =
                data.passportNumber || '';

            // Company is autofilled, NOT made read-only.
            // User can still open the actual ERP Company dropdown.

            document.getElementById('Company').value =
                data.company || '';

        } catch (error) {

            if (version !== employeeLookupVersion)
                return;

            errorBox.textContent = error.message;

        }

    }


    // TRAVEL MODE OPTIONS

    function modeOptions(selected = '') {

        let html = '<option value="">-- Select Mode --</option>';

        travelModes.forEach(function (mode) {

            const isSelected =
                mode === selected ? ' selected' : '';

            html +=
                '<option value="' + esc(mode) + '"' +
                isSelected + '>' +
                esc(mode) +
                '</option>';

        });

        return html;

    }


    // ITINERARY ROWS

    function addItineraryRow(data = {}) {

        const index = itineraryIndex++;

        const row = document.createElement('tr');

        row.innerHTML = `

            <td class="row-number"></td>

            <td>
                <input name="Itineraries[${index}].TravelFrom"
                       class="form-control form-control-sm"
                       value="${esc(data.travelFrom || '')}" />
            </td>

            <td>
                <input name="Itineraries[${index}].TravelTo"
                       class="form-control form-control-sm"
                       value="${esc(data.travelTo || '')}" />
            </td>

            <td>
                <select name="Itineraries[${index}].ModeOfTravel"
                        class="form-select form-select-sm">
                    ${modeOptions(data.modeOfTravel || '')}
                </select>
            </td>

            <td>
                <input type="datetime-local"
                       name="Itineraries[${index}].DepartureDatetime"
                       class="form-control form-control-sm"
                       value="${esc(data.departureDatetime || '')}" />
            </td>

            <td>
                <button type="button"
                        class="btn btn-sm btn-outline-danger"
                        onclick="removeItineraryRow(this)">
                    ×
                </button>
            </td>

        `;

        document.getElementById('itineraryBody').appendChild(row);

        reindexItineraries();

    }


    function removeItineraryRow(button) {

        button.closest('tr').remove();

        reindexItineraries();

    }


    function reindexItineraries() {

        const rows =
            document.querySelectorAll('#itineraryBody tr');

        rows.forEach(function (row, index) {

            row.querySelector('.row-number').textContent = index + 1;

            row.querySelectorAll('[name]').forEach(function (field) {

                field.name = field.name.replace(
                    /Itineraries\[\d+\]/,
                    'Itineraries[' + index + ']'
                );

            });

        });

        itineraryIndex = rows.length;

    }


    // COSTING ROWS

    function addCostingRow(data = {}) {

        const index = costingIndex++;

        const row = document.createElement('tr');

        row.innerHTML = `

            <td class="row-number"></td>

            <td>

                <div class="erp-link-wrapper">

                    <input name="Costings[${index}].ExpenseType"
                           data-master="ExpenseType"
                           class="form-control form-control-sm erp-link"
                           autocomplete="off"
                           placeholder="Search Expense Type"
                           value="${esc(data.expenseType || '')}" />

                    <div class="erp-link-menu"></div>

                </div>

            </td>

            <td>
                <input type="number"
                       name="Costings[${index}].SponsoredAmount"
                       class="form-control form-control-sm sponsored-amount"
                       min="0"
                       step="0.01"
                       value="${esc(data.sponsoredAmount ?? 0)}"
                       oninput="calculateCosting(this)" />
            </td>

            <td>
                <input type="number"
                       name="Costings[${index}].FundedAmount"
                       class="form-control form-control-sm funded-amount"
                       min="0"
                       step="0.01"
                       value="${esc(data.fundedAmount ?? 0)}"
                       oninput="calculateCosting(this)" />
            </td>

            <td>
                <input type="number"
                       name="Costings[${index}].TotalAmount"
                       class="form-control form-control-sm total-amount"
                       step="0.01"
                       readonly />
            </td>

            <td>
                <button type="button"
                        class="btn btn-sm btn-outline-danger"
                        onclick="removeCostingRow(this)">
                    ×
                </button>
            </td>

        `;

        document.getElementById('costingBody').appendChild(row);

        initializeErpLinks(row);

        calculateCosting(row.querySelector('.sponsored-amount'));

        reindexCostings();

    }


    function calculateCosting(input) {

        const row = input.closest('tr');

        const sponsored =
            Number(row.querySelector('.sponsored-amount').value) || 0;

        const funded =
            Number(row.querySelector('.funded-amount').value) || 0;

        row.querySelector('.total-amount').value =
            (sponsored + funded).toFixed(2);

        calculateGrandTotal();

    }


    function calculateGrandTotal() {

        let sum = 0;

        document.querySelectorAll('#costingBody .total-amount')
            .forEach(function (field) {

                sum += Number(field.value) || 0;

            });

        document.getElementById('grandTotal').textContent =
            sum.toLocaleString('en-IN', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });

    }


    function removeCostingRow(button) {

        button.closest('tr').remove();

        reindexCostings();

        calculateGrandTotal();

    }


    function reindexCostings() {

        const rows =
            document.querySelectorAll('#costingBody tr');

        rows.forEach(function (row, index) {

            row.querySelector('.row-number').textContent = index + 1;

            row.querySelectorAll('[name]').forEach(function (field) {

                field.name = field.name.replace(
                    /Costings\[\d+\]/,
                    'Costings[' + index + ']'
                );

            });

        });

        costingIndex = rows.length;

    }


    // FORM VALIDATION

    document.getElementById('travelRequestForm')
        .addEventListener('submit', function (event) {

            const errorBox = document.getElementById('clientError');

            errorBox.classList.add('d-none');

            const type = document.getElementById('TravelType').value;

            const purpose =
                document.getElementById('PurposeOfTravel').value.trim();

            const employee =
                document.getElementById('employeeSelect').value.trim();

            const company =
                document.getElementById('Company').value.trim();

            if (!type) {

                event.preventDefault();

                showError('Please select Travel Type.');

                return;

            }

            if (!purpose) {

                event.preventDefault();

                showError('Please select Purpose of Travel.');

                return;

            }

            if (!employee) {

                event.preventDefault();

                showError('Please select Employee.');

                return;

            }

            if (!company) {

                event.preventDefault();

                showError('Please select Company.');

                return;

            }

            // ERPNext remains responsible for validating actual
            // Link field values and applicable permissions on Save.

            reindexItineraries();
            reindexCostings();

            this.querySelectorAll('button[type="submit"]')
                .forEach(function (button) {

                    button.disabled = true;

                    button.textContent = 'Saving in ERPNext...';

                });

        });


    // INITIAL PAGE LOAD

    document.addEventListener('DOMContentLoaded', function () {

        // Set up all five Link fields plus Purpose of Travel.

        initializeErpLinks();

        // Get employee details only when selected from suggestions.

        document.getElementById('employeeSelect')
            .addEventListener('erp-link-selected', function () {

                fillEmployeeDetails(this);

            });

        // Initial child rows.

        addItineraryRow();
        addCostingRow();

        // IMPORTANT:
        // No GetTravelRequestSelectOptions calls here.
        // Travel Type and Funding are rendered from ViewBag.
    });

</script>
