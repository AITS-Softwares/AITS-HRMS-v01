@model List<Erp_Aits.Models.ShiftType>

@{
    ViewBag.Title = "Shift Type";
    var page = (int)(ViewBag.Page ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 20);
    var totalRecords = (int)(ViewBag.TotalRecords ?? 0);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var search = ViewBag.IdFilter?.ToString() ?? "";
    var pageSizes = new[] { 20, 100, 500, 2500 };
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0">Shift Type</h4>
        <div class="d-flex gap-2">
            <div class="dropdown"><button class="btn btn-warning btn-sm dropdown-toggle text-dark fw-semibold" type="button" data-bs-toggle="dropdown">Shift Tool</button><ul class="dropdown-menu"><li><a class="dropdown-item" href="@Url.Action("ShiftAssignmentTool", "HR")">Shift Assignment Tool</a></li><li><a class="dropdown-item" href="@Url.Action("Roster", "HR")">Roster</a></li></ul></div>
            <a href="@Url.Action("CreateShiftType", "HR")" class="btn btn-light text-primary border-0 btn-sm fw-semibold">+ Add Shift Type</a>
        </div>
    </div>

    @if (TempData["ErpNextError"] != null)
    {
        <div class="alert alert-danger">@TempData["ErpNextError"]</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <form method="get" class="row g-2 mb-4">
        <div class="col-md-4">
            <input type="text"
                   name="id"
                   value="@search"
                   class="form-control form-control-sm"
                   placeholder="Filter by Shift Type / Holiday List..." />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-sm btn-primary">Search</button>
        </div>
    </form>

    <div class="card p-3 shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Shift Type</th>
                    <th>Start Time</th>
                    <th>End Time</th>
                    <th>Holiday List</th>
                    <th>Auto Attendance</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var s in Model)
                    {
                        <tr style="cursor:pointer"
                            onclick="location.href='@Url.Action("ShiftTypeDetails", "HR", new { id = s.Id })'">
                            <td><strong>@s.Name</strong></td>
                            <td>@s.StartTime</td>
                            <td>@s.EndTime</td>
                            <td>@s.HolidayList</td>
                            <td>@(s.EnableAutoAttendance ? "Yes" : "No")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No shift types found.</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (totalRecords > 0)
        {
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3 pt-3 border-top">
                <small class="text-muted">Showing @(((page - 1) * pageSize) + 1)-@Math.Min(page * pageSize, totalRecords) of @totalRecords</small>
                <div class="btn-group btn-group-sm" role="group" aria-label="Rows per page">
                    @foreach (var size in pageSizes)
                    {
                        <a class="btn @(pageSize == size ? "btn-primary" : "btn-outline-primary")" href="@Url.Action("ShiftType", "HR", new { id = search, page = 1, pageSize = size })">@size</a>
                    }
                </div>
                @if (totalPages > 1)
                {
                    <div class="btn-group btn-group-sm">
                        <a class="btn btn-outline-secondary @(page == 1 ? "disabled" : "")" href="@Url.Action("ShiftType", "HR", new { id = search, page = page - 1, pageSize })">Previous</a>
                    <span class="btn btn-outline-secondary disabled">Page @(page) / @(totalPages)</span>
                        <a class="btn btn-outline-secondary @(page == totalPages ? "disabled" : "")" href="@Url.Action("ShiftType", "HR", new { id = search, page = page + 1, pageSize })">Next</a>
                    </div>
                }
            </div>
        }
    </div>
</div>
<partial name="_ShiftModuleUi" />
