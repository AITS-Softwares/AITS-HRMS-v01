@model List<Erp_Aits.Models.InterviewRound>
@{
    ViewBag.Title = "Interview Round";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Interview Round</h4>
    <a href="@Url.Action("CreateInterviewRound", "HR")" class="btn btn-dark btn-sm">+ Add Interview Round</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="id" class="form-control form-control-sm" placeholder="ID" value="@ViewBag.IdFilter" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>Round Name</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr style="cursor:pointer" onclick="window.location='@Url.Action("InterviewRoundDetails", "HR", new { id = r.Id })'">
                <td>@r.Id</td>
                <td>@r.RoundName</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted text-center py-5">No interview rounds found.</p>
}