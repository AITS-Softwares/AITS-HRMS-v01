@model List<Erp_Aits.Models.VehicleServiceItem>
@{
    ViewBag.Title = "Vehicle Service Item";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Vehicle Service Item</h4>
    <a href="/HR/CreateVehicleServiceItem" class="btn btn-dark btn-sm">+ Add Vehicle Service Item</a>
</div>

<form method="get" action="/HR/VehicleServiceItem" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="id" class="form-control form-control-sm" placeholder="ID" value="@ViewBag.IdFilter" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
    </div>
</form>

@if (Model.Any())
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Service Item</th>
                <th>Rate</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var v in Model)
            {
                <tr style="cursor:pointer" onclick="window.location='/HR/VehicleServiceItemDetails/@v.Id'">
                    <td>@v.ServiceItem</td>
                    <td>@v.ServiceItem</td>
                    <td>@(v.Rate.HasValue? v.Rate.Value.ToString("0.00") : "")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted text-center py-5">No vehicle service items found.</p>
}
