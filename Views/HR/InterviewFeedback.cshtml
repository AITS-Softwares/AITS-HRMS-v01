@model List<Erp_Aits.Models.InterviewFeedbackListRow>
@{
    ViewBag.Title = "Interview Feedback";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Interview Feedback</h4>
    <a href="@Url.Action("CreateInterviewFeedback", "HR")" class="btn btn-dark btn-sm">+ Add Interview Feedback</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="id" class="form-control form-control-sm" placeholder="ID" value="@ViewBag.IdFilter" />
    </div>
    <div class="col-auto">
        <input type="text" name="interview" class="form-control form-control-sm" placeholder="Interview" value="@ViewBag.InterviewFilter" />
    </div>
    <div class="col-auto">
        <input type="text" name="interviewRound" class="form-control form-control-sm" placeholder="Interview Round" value="@ViewBag.RoundFilter" />
    </div>
    <div class="col-auto">
        <input type="text" name="jobApplicant" class="form-control form-control-sm" placeholder="Job Applicant" value="@ViewBag.ApplicantFilter" />
    </div>
    <div class="col-auto">
        <input type="text" name="interviewer" class="form-control form-control-sm" placeholder="Interviewer" value="@ViewBag.InterviewerFilter" />
    </div>
    <div class="col-auto">
        <select name="result" class="form-select form-select-sm">
            <option value="">Result</option>
            <option value="Cleared" selected="@(ViewBag.ResultFilter == "Cleared")">Cleared</option>
            <option value="Rejected" selected="@(ViewBag.ResultFilter == "Rejected")">Rejected</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>Interview</th>
            <th>Interview Round</th>
            <th>Job Applicant</th>
            <th>Interviewer</th>
            <th>Result</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var f in Model)
        {
            <tr style="cursor:pointer" onclick="window.location='@Url.Action("InterviewFeedbackDetails", "HR", new { id = f.Id })'">
                <td>@f.Id</td>
                <td>@f.InterviewId</td>
                <td>@f.InterviewRound</td>
                <td>@f.JobApplicant</td>
                <td>@f.Interviewer</td>
                <td>
                    <span class="badge @(f.Result == "Cleared" ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">@f.Result</span>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted text-center py-5">No interview feedback found with matching filters.</p>
}
