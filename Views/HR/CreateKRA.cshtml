@model Erp_Aits.Models.KRA

@{
    ViewBag.Title = "New KRA";
}

<!-- ERPNext Error Message -->
@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">

        @TempData["ErpNextError"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>

    </div>
}

<!-- Success Message -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>

    </div>
}

<form asp-controller="HR"
      asp-action="CreateKRA"
      method="post"
      id="createKraForm"
      class="performance-ui performance-form-shell">

    @Html.AntiForgeryToken()

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3 performance-page-header">

        <div>
            <h4 class="mb-0">New KRA</h4>

            <small class="text-muted">
                ERPNext → HRMS synchronized save
            </small>
        </div>

        <div class="d-flex gap-2">

            <a href="@Url.Action("KRA", "HR")"
               class="btn btn-outline-secondary btn-sm">
                Cancel
            </a>

            <button type="submit"
                    id="saveKraBtn"
                    class="btn btn-dark btn-sm">
                Save
            </button>

        </div>

    </div>

    <!-- Validation -->
    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <!-- KRA Form -->
    <div class="card p-4">

        <div class="row g-3">

            <!-- Title -->
            <div class="col-md-12">

                <label asp-for="Title" class="form-label">
                    Title <span class="text-danger">*</span>
                </label>

                <input asp-for="Title"
                       class="form-control"
                       placeholder="Enter KRA Title"
                       maxlength="255"
                       required />

                <span asp-validation-for="Title"
                      class="text-danger">
                </span>

            </div>

            <!-- Description -->
            <div class="col-md-12">

                <label asp-for="Description"
                       class="form-label">
                    Description
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="6"
                          placeholder="Enter KRA Description"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger">
                </span>

            </div>

        </div>

    </div>

    <div class="mt-3">
        <small class="text-muted">
            On Save, the KRA is created in ERPNext first.
            The saved ERPNext record is then imported into HRMS.
        </small>
    </div>

</form>

@await Html.PartialAsync("_PerformanceModuleUi")

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const form = document.getElementById("createKraForm");
        const saveBtn = document.getElementById("saveKraBtn");

        if (!form || !saveBtn)
            return;

        form.addEventListener("submit", function (event) {

            if (!form.checkValidity()) {
                return;
            }

            saveBtn.disabled = true;

            saveBtn.innerHTML =
                '<span class="spinner-border spinner-border-sm me-1" ' +
                'role="status" aria-hidden="true"></span> Saving...';

        });

    });
</script>
