@model List<Erp_Aits.Models.ActivityType>
@{
    ViewBag.Title = "Activity Type";
}
<style>
    .quick-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1050;
    }

    .quick-modal-box {
        background: #fff;
        border-radius: 10px;
        width: 480px;
        max-width: 92%;
        padding: 28px 34px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.25);
    }

    .quick-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .quick-modal-close {
        cursor: pointer;
        font-size: 26px;
        line-height: 1;
        color: #888;
        border: none;
        background: none;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Activity Type</h4>

    <button type="button" class="btn btn-dark btn-sm" onclick="openQuickModal()">+ Add Activity Type</button>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="get" action="/HR/ActivityType" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="id" class="form-control form-control-sm" placeholder="ID" value="@ViewBag.IdFilter" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
    </div>
</form>

@if (Model.Any())
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Status</th>
                <th>Activity Type</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr style="cursor:pointer" onclick="window.location='/HR/ActivityTypeDetails/@a.Id'">
                    <td>@a.Name</td>
                    <td>
                        @if (a.Disabled)
                        {
                            <span class="badge bg-secondary-subtle text-secondary">Disabled</span>
                        }
                        else
                        {
                            <span class="badge bg-primary-subtle text-primary">Enabled</span>
                        }
                    </td>
                    <td>@a.Name</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted text-center py-5">No activity types found.</p>
}

<!-- Quick Add Modal -->
<div id="quickModalOverlay" class="quick-modal-overlay">
    <div class="quick-modal-box">
        <div class="quick-modal-header">
            <h5 class="mb-0">New Activity Type</h5>
            <button type="button" class="quick-modal-close" onclick="closeQuickModal()">&times;</button>
        </div>
        <hr />
        <form method="post" action="/HR/QuickCreateActivityType">
            <div class="mb-3">
                <label class="form-label">Activity Type <span class="text-danger">*</span></label>
                <input type="text" name="Name" class="form-control" required autofocus />
            </div>
            <div class="d-flex justify-content-between align-items-center mt-4">
                <a href="/HR/CreateActivityType" class="btn btn-outline-secondary btn-sm">Edit Full Form</a>
                <button type="submit" class="btn btn-dark btn-sm px-4">Save</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openQuickModal() {
        document.getElementById('quickModalOverlay').style.display = 'flex';
    }
    function closeQuickModal() {
        document.getElementById('quickModalOverlay').style.display = 'none';
    }
</script>
<partial name="_TimeAttendanceUi" />
