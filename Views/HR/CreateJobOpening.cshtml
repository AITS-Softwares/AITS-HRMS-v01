@model Erp_Aits.Models.JobOpening
@{
    ViewBag.Title = "New Job Opening";
}

<div class="jo-form-wrap">
    <div class="jo-breadcrumb">
        <span>HR</span> <span>&gt;</span> <span>Job Opening</span> <span>&gt;</span> <span class="jo-current">New Job Opening</span>
    </div>

    <div class="jo-form-header">
        <h4><i class="fas fa-bars"></i> New Job Opening <span class="jo-not-saved">Not Saved</span></h4>
        <button type="submit" form="jobOpeningForm" class="jo-btn jo-btn-primary">Save</button>
    </div>

    <form id="jobOpeningForm" method="post" asp-action="CreateJobOpening" class="jo-form">

        <div class="jo-row">
            <div class="jo-col">
                <label>Job Opening Template</label>
                <input type="text" name="JobOpeningTemplate" class="jo-input" />
            </div>
            <div class="jo-col">
                <label>Status</label>
                <select name="Status" class="jo-input">
                    <option value="Open" selected="@(Model.Status == "Open")">Open</option>
                    <option value="Closed" selected="@(Model.Status == "Closed")">Closed</option>
                    <option value="On Hold" selected="@(Model.Status == "On Hold")">On Hold</option>
                    <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Cancelled</option>
                </select>
            </div>
        </div>

        <div class="jo-row">
            <div class="jo-col">
                <label>Job Title <span class="jo-required">*</span></label>
                <input type="text" name="JobTitle" class="jo-input" required />
            </div>
            <div class="jo-col">
                <label>Posted On</label>
                <input type="text" class="jo-input" value="@Model.PostedOn.ToString("dd-MM-yyyy HH:mm:ss")" readonly />
                <input type="hidden" name="PostedOn" value="@Model.PostedOn.ToString("yyyy-MM-ddTHH:mm:ss")" />
                <div class="jo-hint">Asia/Kolkata</div>
            </div>
        </div>

        <div class="jo-row">
            <div class="jo-col">
                <label>Designation <span class="jo-required">*</span></label>
                <input type="text" name="Designation" class="jo-input" required />
            </div>
            <div class="jo-col">
                <label>Closes On</label>
                <input type="date" name="ClosesOn" class="jo-input" />
                <div class="jo-hint">If set, the job opening will be closed automatically after this date</div>
            </div>
        </div>

        <div class="jo-section-title">Company Details</div>

        <div class="jo-row">
            <div class="jo-col">
                <label>Company <span class="jo-required">*</span></label>
                <input type="text" name="Company" class="jo-input" value="@Model.Company" required />
            </div>
            <div class="jo-col">
                <label>Employment Type</label>
                <input type="text" name="EmploymentType" class="jo-input" />
            </div>
        </div>

        <div class="jo-row">
            <div class="jo-col">
                <label>Department</label>
                <input type="text" name="Department" class="jo-input" />
            </div>
            <div class="jo-col">
                <label>Location</label>
                <input type="text" name="Location" class="jo-input" />
            </div>
        </div>

        <div class="jo-checkbox-row">
            <label><input type="checkbox" name="PublishOnWebsite" value="true" /> Publish on website</label>
        </div>

        <div class="jo-full">
            <label>Description</label>
            <textarea name="Description" class="jo-textarea" rows="8" placeholder="Job profile, qualifications required etc."></textarea>
        </div>

        <div class="jo-row">
            <div class="jo-col">
                <label>Currency</label>
                <input type="text" name="Currency" class="jo-input" value="@Model.Currency" />
            </div>
            <div class="jo-col">
                <label>Salary Paid Per</label>
                <select name="SalaryPaidPer" class="jo-input">
                    <option value="Month" selected="@(Model.SalaryPaidPer == "Month")">Month</option>
                    <option value="Year" selected="@(Model.SalaryPaidPer == "Year")">Year</option>
                    <option value="Hour" selected="@(Model.SalaryPaidPer == "Hour")">Hour</option>
                </select>
            </div>
        </div>

        <div class="jo-row">
            <div class="jo-col">
                <label>Lower Range</label>
                <input type="number" step="0.01" name="LowerRange" class="jo-input" />
            </div>
            <div class="jo-col">
                <label>&nbsp;</label>
                <label class="jo-checkbox-inline"><input type="checkbox" name="PublishSalaryRange" value="true" /> Publish Salary Range</label>
            </div>
        </div>

        <div class="jo-row">
            <div class="jo-col">
                <label>Upper Range</label>
                <input type="number" step="0.01" name="UpperRange" class="jo-input" />
            </div>
            <div class="jo-col"></div>
        </div>

    </form>
</div>

<style>
    .jo-form-wrap {
        background: #fff;
        border-radius: 10px;
        padding: 20px 24px;
        max-width: 950px;
    }

    .jo-breadcrumb {
        font-size: 13px;
        color: #64748b;
        margin-bottom: 10px;
    }

    .jo-current {
        color: #1a1a2e;
        font-weight: 600;
    }

    .jo-form-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

        .jo-form-header h4 {
            margin: 0;
            font-weight: 700;
            font-size: 20px;
            color: #1a1a2e;
            display: flex;
            align-items: center;
            gap: 10px;
        }

    .jo-not-saved {
        font-size: 11px;
        font-weight: 600;
        color: #dc2626;
        background: #fee2e2;
        padding: 2px 8px;
        border-radius: 10px;
    }

    .jo-btn {
        border: 1px solid #d1d5db;
        background: #fff;
        border-radius: 8px;
        padding: 8px 20px;
        font-size: 13px;
        color: #374151;
        cursor: pointer;
    }

    .jo-btn-primary {
        background: #1a1a2e;
        border-color: #1a1a2e;
        color: #fff;
    }

        .jo-btn-primary:hover {
            background: #000;
        }

    .jo-row {
        display: flex;
        gap: 30px;
        margin-bottom: 18px;
    }

    .jo-col {
        flex: 1;
        min-width: 0;
    }

    .jo-full {
        margin-bottom: 18px;
    }

        .jo-row label, .jo-full label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            color: #64748b;
            margin-bottom: 6px;
        }

    .jo-required {
        color: #dc2626;
    }

    .jo-input, .jo-textarea {
        width: 100%;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 13px;
        color: #374151;
        background: #fff;
    }

        .jo-input:focus, .jo-textarea:focus {
            outline: none;
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }

    .jo-textarea {
        resize: vertical;
        min-height: 160px;
    }

    .jo-hint {
        font-size: 11px;
        color: #94a3b8;
        margin-top: 4px;
    }

    .jo-section-title {
        font-weight: 700;
        font-size: 14px;
        color: #1a1a2e;
        margin: 26px 0 16px;
        padding-bottom: 8px;
        border-bottom: 1px solid #eef0f3;
    }

    .jo-checkbox-row, .jo-checkbox-inline {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: #374151;
        margin-bottom: 18px;
    }

    @@media (max-width: 768px) {
        .jo-row {
            flex-direction: column;
            gap: 12px;
        }
    }
</style>
