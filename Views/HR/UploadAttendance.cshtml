@{
    ViewBag.Title = "Upload Attendance";
    DateTime fromDate = ViewBag.FromDate;
    DateTime toDate = ViewBag.ToDate;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0 d-inline">Upload Attendance</h4>
        <span class="badge bg-danger-subtle text-danger ms-2">Not Saved</span>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card p-3 mb-4">
    <h6 class="mb-3">Download Template</h6>

    <form asp-action="GetAttendanceTemplate" method="get" id="templateForm">
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label">Attendance From Date <span class="text-danger">*</span></label>
                <input type="date" name="fromDate" class="form-control" required value="@fromDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Attendance To Date <span class="text-danger">*</span></label>
                <input type="date" name="toDate" class="form-control" required value="@toDate.ToString("yyyy-MM-dd")" />
            </div>
        </div>

        <button type="submit" class="btn btn-sm btn-outline-secondary">Get Template</button>
    </form>
</div>

<div class="card p-3">
    <h6 class="mb-3">Import Attendance</h6>

    <form asp-action="ImportAttendanceFile" method="post" enctype="multipart/form-data" id="importForm">
        <div id="dropZone" class="upload-dropzone">
            <div class="text-center py-5">
                <p class="text-muted mb-3">Drag and drop files here or upload from</p>

                <div class="d-flex justify-content-center gap-4">
                    <div class="upload-option" onclick="document.getElementById('fileInput').click();">
                        <i class="fas fa-desktop fa-lg mb-1"></i>
                        <div>My Device</div>
                    </div>
                    <div class="upload-option" onclick="alert('Wire this to your document library / file manager if you have one.');">
                        <i class="fas fa-folder fa-lg mb-1"></i>
                        <div>Library</div>
                    </div>
                    <div class="upload-option" onclick="promptLink();">
                        <i class="fas fa-link fa-lg mb-1"></i>
                        <div>Link</div>
                    </div>
                </div>

                <div id="fileNameDisplay" class="mt-3 fw-semibold"></div>
            </div>
        </div>

        <input type="file" id="fileInput" name="file" accept=".csv" style="display:none;" onchange="handleFileSelect()" />

        <div class="text-end mt-3">
            <button type="submit" class="btn btn-dark btn-sm" id="uploadBtn" disabled>Upload</button>
        </div>
    </form>
</div>

<style>
    .upload-dropzone {
        border: 2px dashed #d1d5db;
        border-radius: 10px;
        background: #fafafa;
        transition: all 0.2s;
    }

        .upload-dropzone.dragover {
            border-color: #4f46e5;
            background: #f5f5ff;
        }

    .upload-option {
        cursor: pointer;
        color: #4f46e5;
        font-size: 13px;
        text-align: center;
    }

        .upload-option:hover {
            opacity: 0.75;
        }
</style>

<script>
    var dropZone = document.getElementById('dropZone');
    var fileInput = document.getElementById('fileInput');
    var uploadBtn = document.getElementById('uploadBtn');
    var fileNameDisplay = document.getElementById('fileNameDisplay');

    dropZone.addEventListener('dragover', function (e) {
        e.preventDefault();
        dropZone.classList.add('dragover');
    });

    dropZone.addEventListener('dragleave', function () {
        dropZone.classList.remove('dragover');
    });

    dropZone.addEventListener('drop', function (e) {
        e.preventDefault();
        dropZone.classList.remove('dragover');

        if (e.dataTransfer.files.length > 0) {
            fileInput.files = e.dataTransfer.files;
            handleFileSelect();
        }
    });

    function handleFileSelect() {
        if (fileInput.files.length > 0) {
            fileNameDisplay.textContent = 'Selected: ' + fileInput.files[0].name;
            uploadBtn.disabled = false;
        }
    }

    function promptLink() {
        var url = prompt('Paste a file URL:');
        if (url) {
            fileNameDisplay.textContent = 'Linked file: ' + url;
            // Note: actual remote-file fetching needs a server-side handler; this is a placeholder.
            alert('Link-based import needs a server endpoint to fetch the remote file — let me know if you want this wired up.');
        }
    }
</script>
<partial name="_TimeAttendanceUi" />
