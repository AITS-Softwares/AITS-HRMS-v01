@model Erp_Aits.Models.EmployeeOnboardingTemplate

@{
    ViewBag.Title =
        "New Employee Onboarding Template";
}

@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-danger mb-3">
        @TempData["ErpNextError"]
    </div>
}

<form asp-action="CreateEmployeeOnboardingTemplate"
      asp-controller="HR"
      method="post">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>

            <h4 class="mb-0 d-inline-block me-2">
                New Employee Onboarding Template
            </h4>

            <span class="badge bg-warning-subtle text-warning">
                Not Saved
            </span>

        </div>


        <button type="submit"
                class="btn btn-dark btn-sm px-4">
            Save
        </button>

    </div>


    <!-- ========================================================= -->
    <!-- TEMPLATE DETAILS -->
    <!-- ========================================================= -->

    <div class="card border rounded-3 p-4 mb-3 shadow-sm bg-white">

        <div class="row g-3">


            <!-- Title -->
            <div class="col-md-6">

                <label class="form-label">
                    Title
                    <span class="text-danger">*</span>
                </label>

                <input asp-for="Title"
                       class="form-control"
                       required />

            </div>


            <!-- Company -->
            <div class="col-md-6">

                <label class="form-label">
                    Company
                </label>

                <select asp-for="Company"
                        class="form-select">

                    <option value="">
                        -- Select Company --
                    </option>

                    @if (ViewBag.Companies != null)
                    {
                        foreach (var item in ViewBag.Companies)
                        {
                            <option value="@item.name">
                                @item.name
                            </option>
                        }
                    }

                </select>

            </div>


            <!-- Department -->
            <div class="col-md-6">

                <label class="form-label">
                    Department
                </label>

                <select asp-for="Department"
                        class="form-select">

                    <option value="">
                        -- Select Department --
                    </option>

                    @if (ViewBag.Departments != null)
                    {
                        foreach (var item in ViewBag.Departments)
                        {
                            <option value="@item.name">
                                @item.name
                            </option>
                        }
                    }

                </select>

            </div>


            <!-- Designation -->
            <div class="col-md-6">

                <label class="form-label">
                    Designation
                </label>

                <select asp-for="Designation"
                        class="form-select">

                    <option value="">
                        -- Select Designation --
                    </option>

                    @if (ViewBag.Designations != null)
                    {
                        foreach (var item in ViewBag.Designations)
                        {
                            <option value="@item.name">
                                @item.name
                            </option>
                        }
                    }

                </select>

            </div>


            <!-- Employee Grade -->
            <div class="col-md-6">

                <label class="form-label">
                    Employee Grade
                </label>

                <select asp-for="EmployeeGrade"
                        class="form-select">

                    <option value="">
                        -- Select Employee Grade --
                    </option>

                    @if (ViewBag.EmployeeGrades != null)
                    {
                        foreach (var item in ViewBag.EmployeeGrades)
                        {
                            <option value="@item.name">
                                @item.name
                            </option>
                        }
                    }

                </select>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- ACTIVITIES -->
    <!-- ========================================================= -->

    <div class="card border rounded-3 p-4 shadow-sm bg-white">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <h6 class="mb-0">
                Activities
            </h6>

            <button type="button"
                    id="btnAddActivity"
                    class="btn btn-sm btn-outline-secondary">
                + Add Row
            </button>

        </div>


        <div class="table-responsive">

            <table class="table table-bordered align-middle"
                   id="activitiesTable">

                <thead class="table-light">

                    <tr>

                        <th style="width:60px;">
                            No.
                        </th>

                        <th>
                            Activity Name
                            <span class="text-danger">*</span>
                        </th>

                        <th>
                            User
                        </th>

                        <th style="width:160px;">
                            Begin On (Days)
                        </th>

                        <th style="width:160px;">
                            Duration (Days)
                        </th>

                        <th style="width:70px;">
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody id="activitiesBody">
                </tbody>

            </table>

        </div>

    </div>

</form>


<select id="erpUserMaster"
        style="display:none;">

    <option value="">
        -- Select User --
    </option>

    @if (ViewBag.Users != null)
    {
        foreach (var user in ViewBag.Users)
        {
            <option value="@user.name">
                @user.full_name (@user.name)
            </option>
        }
    }

</select>


@section Scripts
{
    <script>

        let activityRowCounter = 0;


        function getUserOptionsHtml() {

            const master =
                document.getElementById(
                    "erpUserMaster"
                );

            return master
                ? master.innerHTML
                : "";
        }


        function escapeHtml(value) {

            const div =
                document.createElement(
                    "div"
                );

            div.textContent =
                value == null
                    ? ""
                    : String(value);

            return div.innerHTML;
        }


        function addActivityRow(
            activityName = "",
            userName = "",
            beginOn = 0,
            duration = 0
        ) {

            const tbody =
                document.getElementById(
                    "activitiesBody"
                );


            if (!tbody)
                return;


            const index =
                activityRowCounter++;


            const row =
                document.createElement(
                    "tr"
                );


            row.innerHTML = `

                <td class="row-number text-center">
                    ${index + 1}
                </td>


                <td>

                    <input type="text"
                           name="Activities[${index}].ActivityName"
                           value="${escapeHtml(activityName)}"
                           class="form-control form-control-sm"
                           required />

                </td>


                <td>

                    <select name="Activities[${index}].UserName"
                            class="form-select form-select-sm activity-user">

                        ${getUserOptionsHtml()}

                    </select>

                </td>


                <td>

                    <input type="number"
                           name="Activities[${index}].BeginOnDays"
                           value="${beginOn ?? 0}"
                           class="form-control form-control-sm" />

                </td>


                <td>

                    <input type="number"
                           name="Activities[${index}].DurationDays"
                           value="${duration ?? 0}"
                           class="form-control form-control-sm" />

                </td>


                <td class="text-center">

                    <button type="button"
                            class="btn btn-sm btn-outline-danger remove-activity">
                        ×
                    </button>

                </td>

            `;


            tbody.appendChild(
                row
            );


            if (userName) {

                const userSelect =
                    row.querySelector(
                        ".activity-user"
                    );


                if (userSelect) {

                    userSelect.value =
                        userName;
                }
            }


            reindexRows();
        }


        function reindexRows() {

            const rows =
                document.querySelectorAll(
                    "#activitiesBody tr"
                );


            activityRowCounter =
                rows.length;


            rows.forEach(
                function (row, index) {

                    const no =
                        row.querySelector(
                            ".row-number"
                        );


                    if (no) {

                        no.textContent =
                            index + 1;
                    }


                    row.querySelectorAll(
                        "input, select"
                    )
                    .forEach(
                        function (field) {

                            const name =
                                field.getAttribute(
                                    "name"
                                );


                            if (!name)
                                return;


                            field.setAttribute(
                                "name",
                                name.replace(
                                    /Activities\[\d+\]/,
                                    "Activities[" +
                                    index +
                                    "]"
                                )
                            );
                        }
                    );
                }
            );
        }


        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const addButton =
                    document.getElementById(
                        "btnAddActivity"
                    );


                if (addButton) {

                    addButton.addEventListener(
                        "click",
                        function () {

                            addActivityRow();
                        }
                    );
                }


                document.addEventListener(
                    "click",
                    function (event) {

                        const button =
                            event.target.closest(
                                ".remove-activity"
                            );


                        if (!button)
                            return;


                        const row =
                            button.closest(
                                "tr"
                            );


                        if (row)
                            row.remove();


                        reindexRows();
                    }
                );


                // ERP-style first empty activity row
                addActivityRow();

            }
        );

    </script>
}