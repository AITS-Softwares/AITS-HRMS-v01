@model List<Erp_Aits.Models.PaymentEntryListRow>
@{
    ViewBag.Title = "Payment Entry";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @TempData["ErpNextError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Payment Entry</h4>
    <div class="d-flex gap-2">
        <a href="@Url.Action("CreatePaymentEntry", "HR")" class="btn btn-dark btn-sm">+ Add Payment Entry</a>
    </div>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="id" class="form-control form-control-sm" placeholder="ID or ERPNext Ref" value="@ViewBag.IdFilter" />
    </div>
    <div class="col-auto">
        <select name="paymentType" class="form-select form-select-sm">
            <option value="">Payment Type</option>
            <option value="Pay" selected="@(ViewBag.PaymentTypeFilter == "Pay")">Pay</option>
            <option value="Receive" selected="@(ViewBag.PaymentTypeFilter == "Receive")">Receive</option>
            <option value="Internal Transfer" selected="@(ViewBag.PaymentTypeFilter == "Internal Transfer")">Internal Transfer</option>
        </select>
    </div>
    <div class="col-auto">
        <input type="text" name="partyType" class="form-control form-control-sm" placeholder="Party Type" value="@ViewBag.PartyTypeFilter" />
    </div>
    <div class="col-auto">
        <input type="text" name="party" class="form-control form-control-sm" placeholder="Party" value="@ViewBag.PartyFilter" />
    </div>
    <div class="col-auto">
        <input type="text" name="title" class="form-control form-control-sm" placeholder="Title" value="@ViewBag.TitleFilter" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>ERPNext Ref</th>
            <th>Payment Type</th>
            <th>Party Type</th>
            <th>Party</th>
            <th>Party Name</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@(p.Id > 0 ? p.Id.ToString() : "-")</td>
                <td>
                    @if (!string.IsNullOrEmpty(p.ErpNextId))
                    {
                        <a href="@Url.Action("OpenErpPaymentEntry", "HR", new { name = p.ErpNextId })" class="badge bg-success-subtle text-success">@p.ErpNextId</a>
                    }
                    else
                    {
                        <a href="@Url.Action("PaymentEntryDetails", "HR", new { id = p.Id })" class="badge bg-secondary-subtle text-muted">Local</a>
                    }
                </td>
                <td>@p.PaymentType</td>
                <td>@p.PartyType</td>
                <td>@p.Party</td>
                <td>@p.PartyName</td>
            </tr>
        }
    </tbody>
</table>

@if (ViewBag.PaymentEntryPage != null)
{
    <div class="d-flex align-items-center gap-2">
        @if ((int)ViewBag.PaymentEntryPage > 1)
        {
            <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("PaymentEntry", new { id = ViewBag.IdFilter, paymentType = ViewBag.PaymentTypeFilter, partyType = ViewBag.PartyTypeFilter, party = ViewBag.PartyFilter, title = ViewBag.TitleFilter, page = (int)ViewBag.PaymentEntryPage - 1 })">Previous</a>
        }
        <span>Page @ViewBag.PaymentEntryPage</span>
        @if (ViewBag.PaymentEntryHasNext == true)
        {
            <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("PaymentEntry", new { id = ViewBag.IdFilter, paymentType = ViewBag.PaymentTypeFilter, partyType = ViewBag.PartyTypeFilter, party = ViewBag.PartyFilter, title = ViewBag.TitleFilter, page = (int)ViewBag.PaymentEntryPage + 1 })">Next</a>
        }
    </div>
}

@if (!Model.Any())
{
    <p class="text-muted text-center py-5">No Payment Entry found with matching filters.</p>
}
