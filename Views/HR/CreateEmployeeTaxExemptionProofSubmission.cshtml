@using Erp_Aits.Models
@{ViewBag.Title="New Employee Tax Exemption Proof Submission";var employees=ViewBag.TaxProofEmployees as List<PayrollEmployeeOption>??new List<PayrollEmployeeOption>();var periods=ViewBag.TaxProofPeriods as List<string>??new List<string>();var currencies=ViewBag.TaxProofCurrencies as List<string>??new List<string>();var cats=ViewBag.TaxProofCategories as List<string>??new List<string>();var subs=ViewBag.TaxProofSubCategories as List<string>??new List<string>();}
<style>.p{max-width:1210px;margin:auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.h{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.h h1{font-size:22px;margin:0}.save{border:0;background:#0f766e;color:#fff;padding:9px 17px;border-radius:7px;font-weight:650}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.s{padding:20px;border-bottom:1px solid #dbe3ec}.s h2{font-size:17px;margin:0 0 16px;color:#14253d}.g{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.f label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.i,.sel{box-sizing:border-box;width:100%;height:36px;border:1px solid #b8c7d7;border-radius:8px;padding:7px 10px;background:#fbfdff}.i[readonly]{background:#f2f6f9}.t{width:100%;border-collapse:collapse}.t th,.t td{padding:8px;border:1px solid #dbe3ec}.t th{background:#f4f8fc;color:#526375;text-align:left}.t select,.t input{width:100%;height:34px;box-sizing:border-box;border:1px solid #b8c7d7;border-radius:5px;padding:5px}.add{border:0;background:#dce8f1;border-radius:6px;padding:7px 12px;margin-top:10px}.sys{color:#64748b;font-size:12px;margin:-7px 0 12px}</style>
<div class="p"><form method="post" enctype="multipart/form-data" asp-action="CreateEmployeeTaxExemptionProofSubmission">@Html.AntiForgeryToken()<header class="h"><h1>New Employee Tax Exemption Proof Submission</h1><button class="save">Save</button></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}<main class="card"><section class="s"><h2>Employee</h2><div class="g"><div class="f"><label>Employee *</label><select name="Employee" id="e" class="sel" required><option value="">Select employee</option>@foreach(var x in employees){<option value="@x.Id" data-name="@x.EmployeeName" data-department="@x.Department" data-company="@x.Company">@x.Id</option>}</select></div><div class="f"><label>Employee Name</label><input id="n" class="i" readonly/></div><div class="f"><label>Department</label><input id="d" class="i" readonly/></div><div class="f"><label>Company *</label><input id="co" class="i" readonly/></div><div class="f"><label>Currency *</label><select name="Currency" class="sel" required><option value="">Select currency</option>@foreach(var x in currencies){<option value="@x">@x</option>}</select></div><div class="f"><label>Amended From</label><input class="i" readonly/></div><div class="f"><label>Submission Date *</label><input name="SubmissionDate" class="i" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required/></div><div class="f"><label>Payroll Period *</label><select name="PayrollPeriod" class="sel" required><option value="">Select payroll period</option>@foreach(var x in periods){<option value="@x">@x</option>}</select></div></div></section><section class="s"><h2>Exemption Proofs</h2><table class="t"><thead><tr><th>Tax Exemption Category</th><th>Tax Exemption Sub Category</th><th>Amount</th></tr></thead><tbody id="rows"><tr><td><select name="ProofCategories"><option value="">Select category</option>@foreach(var x in cats){<option value="@x">@x</option>}</select></td><td><select name="ProofSubCategories"><option value="">Select sub category</option>@foreach(var x in subs){<option value="@x">@x</option>}</select></td><td><input name="ProofAmounts" type="number" min="0" step="0.01"/></td></tr></tbody></table><button class="add" type="button" id="add">Add Row</button></section><section class="s"><h2>HRA Exemption</h2><p class="sys">ERPNext maintains these values after saving the proof submission.</p><div class="g"><div class="f"><label>House Rent Payment Amount</label><input class="i" readonly/></div><div class="f"><label>Rented in Metro City</label><input class="i" readonly/></div><div class="f"><label>Rented From Date</label><input class="i" readonly/></div><div class="f"><label>Rented To Date</label><input class="i" readonly/></div><div class="f"><label>Monthly House Rent</label><input class="i" readonly/></div><div class="f"><label>Monthly Eligible Amount</label><input class="i" readonly/></div><div class="f"><label>Total Eligible HRA Exemption</label><input class="i" readonly/></div></div></section><section class="s"><div class="g"><div class="f"><label>Total Actual Amount</label><input class="i" readonly/></div><div class="f"><label>Total Exemption Amount</label><input class="i" readonly/></div><div class="f"><label>Attachments</label><input name="attachments" class="i" type="file"/></div></div></section></main></form></div><script>e.onchange=()=>{let o=e.options[e.selectedIndex];n.value=o.dataset.name||'';d.value=o.dataset.department||'';co.value=o.dataset.company||''};add.onclick=()=>{let r=rows.children[0].cloneNode(true);r.querySelectorAll('select').forEach(x=>x.selectedIndex=0);r.querySelector('input').value='';rows.append(r)};</script>
