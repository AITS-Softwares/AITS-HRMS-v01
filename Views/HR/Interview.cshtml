@model List<Erp_Aits.Models.Interview>
@{ ViewBag.Title = "Interview"; }
<style>
.interview-list{max-width:1420px;margin:0 auto;padding:24px;background:#f1fafc;border:1px solid #c7e5ed;border-radius:14px}.interview-list__hero{background:linear-gradient(110deg,#133d61,#008f8b);color:#fff;padding:23px 27px;border-radius:12px;display:flex;align-items:center;justify-content:space-between;margin-bottom:17px}.interview-list__hero small{color:#a5eff1;font-weight:700;letter-spacing:.08em}.interview-list__filters{background:#fff;border:1px solid #c6e1e9;border-radius:12px;padding:16px;margin-bottom:15px}.interview-list__table{background:#fff;border:1px solid #c6e1e9;border-radius:12px;overflow:hidden}.interview-list table{margin:0}.interview-list thead{background:#dff4f7;color:#094462;text-transform:uppercase;font-size:.76rem;letter-spacing:.04em}.interview-list tbody tr{cursor:pointer}.interview-list tbody tr:hover{background:#effaf9}.interview-status{padding:4px 9px;border-radius:999px;font-size:.78rem;font-weight:700;background:#e4f3f7;color:#146178}.interview-status.cleared{background:#dcf8e8;color:#087947}.interview-status.rejected{background:#fde3e5;color:#b42332}.interview-status.review{background:#fff1d7;color:#9a5a00}.btn-interview{background:#008e89;border-color:#008e89;color:#fff}.btn-interview:hover{background:#05736f;color:#fff}.btn-filter{border-color:#77bbc9;color:#07576c}.btn-filter:hover{background:#dff5f4;color:#07576c}
</style>
<div class="recruitment-theme workflow-page interview-ui interview-list">
 @if (TempData["ErpNextError"] != null) { <div class="alert alert-danger py-2">@TempData["ErpNextError"]</div> }
 @if (TempData["Success"] != null) { <div class="alert alert-success py-2">@TempData["Success"]</div> }
 <div class="interview-list__hero"><div><small>RECRUITMENT / SCHEDULING</small><h3 class="mb-0 mt-1">Interviews</h3></div><a href="@Url.Action("CreateInterview", "HR")" class="btn btn-light fw-semibold">+ Add Interview</a></div>
 <form method="get" class="interview-list__filters row g-2 align-items-end">
  <div class="col-md-2"><label class="form-label small fw-semibold">ID</label><input type="text" name="id" class="form-control" placeholder="Interview ID" value="@ViewBag.IdFilter" /></div>
  <div class="col-md-3"><label class="form-label small fw-semibold">Interview Round</label><input type="text" name="interviewRound" class="form-control" placeholder="Interview round" value="@ViewBag.RoundFilter" /></div>
  <div class="col-md-3"><label class="form-label small fw-semibold">Job Applicant</label><input type="text" name="jobApplicant" class="form-control" placeholder="Applicant" value="@ViewBag.ApplicantFilter" /></div>
  <div class="col-md-2"><label class="form-label small fw-semibold">Status</label><select name="status" class="form-select"><option value="">All statuses</option><option value="Pending" selected="@(ViewBag.StatusFilter == "Pending")">Pending</option><option value="Under Review" selected="@(ViewBag.StatusFilter == "Under Review")">Under Review</option><option value="Cleared" selected="@(ViewBag.StatusFilter == "Cleared")">Cleared</option><option value="Rejected" selected="@(ViewBag.StatusFilter == "Rejected")">Rejected</option></select></div>
  <div class="col-md-2"><button type="submit" class="btn btn-filter w-100">Search</button></div>
 </form>
 <div class="interview-list__table table-responsive"><table class="table align-middle"><thead><tr><th class="ps-4">ID</th><th>Interview Round</th><th>Job Applicant</th><th>Designation</th><th>Status</th><th>Scheduled On</th></tr></thead><tbody>
 @foreach (var iv in Model) { var statusClass = iv.Status == "Cleared" ? "cleared" : iv.Status == "Rejected" ? "rejected" : iv.Status == "Under Review" ? "review" : ""; <tr onclick="window.location='@Url.Action("InterviewDetails", "HR", new { id = iv.Id })'"><td class="ps-4 fw-semibold">@iv.Id</td><td>@iv.InterviewRound</td><td>@iv.JobApplicant</td><td>@iv.Designation</td><td><span class="interview-status @statusClass">@iv.Status</span></td><td>@iv.ScheduledOn.ToString("dd-MM-yyyy")</td></tr> }
 </tbody></table>@if (!Model.Any()) { <div class="text-center text-muted py-5">No interviews found with matching filters.</div> }</div>
</div>
@await Html.PartialAsync("_RecruitmentTheme")
