@model Erp_Aits.Models.LeaveEncashment
@{
    ViewBag.Title = "Leave Encashment - " + Model.Id;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Leave Encashment - @Model.Employee</h4>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <label class="form-label">Employee</label>
        <input class="form-control" value="@Model.Employee" readonly />
    </div>
    <div class="col-md-4">
        <label class="form-label">Leave Period</label>
        <input class="form-control" value="@Model.LeavePeriod" readonly />
    </div>
    <div class="col-md-4">
        <label class="form-label">Encashment Days</label>
        <input class="form-control" value="@Model.EncashmentDays" readonly />
    </div>

    <div class="col-md-4">
        <label class="form-label">Company</label>
        <input class="form-control" value="@Model.Company" readonly />
    </div>
    <div class="col-md-4">
        <label class="form-label">Leave Type</label>
        <input class="form-control" value="@Model.LeaveType" readonly />
    </div>
</div>

<hr />
<h6 class="mb-2">Accounting</h6>
<div class="form-check mb-4">
    <input class="form-check-input" type="checkbox" disabled checked="@Model.PayViaPaymentEntry" />
    <label class="form-check-label">Pay Via Payment Entry</label>
</div>

<hr />
<h6 class="mb-2">Payroll</h6>
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <label class="form-label">Encashment Date</label>
        <input class="form-control" value="@Model.EncashmentDate.ToString("dd-MM-yyyy")" readonly />
    </div>
</div>

<hr />
<h6 class="mb-2">More Info</h6>
<div class="row g-3">
    <div class="col-md-4">
        <label class="form-label">Status</label>
        <input class="form-control" value="@Model.Status" readonly />
    </div>
</div>