@model List<Erp_Aits.Models.TrainingProgram>
@{
    ViewBag.Title = "Training Program";
}

<link rel="stylesheet" href="~/css/leave-workspace.css" asp-append-version="true" />
<span class="leave-ui" aria-hidden="true"></span>

<div class="d-flex justify-content-between align-items-center training-list-header">
    <h4 class="mb-0">Training Program</h4>
    <a href="@Url.Action("CreateTrainingProgram", "HR")" class="btn btn-dark btn-sm">+ Add Training Program</a>
</div>

<form method="get" asp-action="TrainingProgram" class="row g-2 training-list-filters">
    <div class="col-md-3">
        <input type="text" name="id" class="form-control form-control-sm" placeholder="ID" value="@ViewBag.IdFilter" />
    </div>
    <div class="col-md-3">
        <input type="text" name="trainingProgram" class="form-control form-control-sm" placeholder="Training Program" value="@ViewBag.TrainingProgramFilter" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-sm btn-outline-dark">Filter</button>
    </div>
</form>

<table class="table table-hover align-middle training-list-table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Training Program</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr style="cursor:pointer;" onclick="location.href='@Url.Action("TrainingProgramDetails", "HR", new { id = t.Id })'">
                <td>@t.TrainingProgramCode</td>
                <td>@t.TrainingProgramName</td>
                <td><span class="badge bg-secondary-subtle text-secondary">@t.Status</span></td>
            </tr>
        }
    </tbody>
</table>
@if (!Model.Any())
{
    <p class="text-muted">No training programs found.</p>
}
