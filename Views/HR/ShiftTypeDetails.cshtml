@model Erp_Aits.Models.ShiftType

@{
    ViewBag.Title = "Shift Type Details";

    bool editMode =
        ViewBag.EditMode == true ||
        string.Equals(Context.Request.Query["edit"], "true", StringComparison.OrdinalIgnoreCase);

    var holidayLists = ViewBag.HolidayLists as List<string> ?? new List<string>();
}

@functions {
    string FormatTime(string value)
    {
        if (TimeSpan.TryParse(value, out var time))
            return time.ToString(@"hh\:mm\:ss");

        return value ?? "";
    }
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0">Shift Type - @Model.Name</h4>
        <small class="text-muted">@Model.ShiftTypeCode</small>
    </div>

    <div class="d-flex gap-2">
        <a href="@Url.Action("ShiftType", "HR")" class="btn btn-outline-secondary btn-sm">Back to List</a>

        @if (!editMode)
        {
            <a href="/HR/ShiftTypeDetails/@Model.Id?edit=true" class="btn btn-dark btn-sm">Edit</a>

            <form method="post"
                  action="@Url.Action("DeleteShiftType", "HR", new { id = Model.Id })"
                  onsubmit="return confirm('Are you sure you want to delete this Shift Type?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
            </form>
        }
    </div>
</div>

@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["ErpNextError"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-3">@TempData["Success"]</div>
}

<form method="post" action="@Url.Action("UpdateShiftType", "HR", new { id = Model.Id })">
    @Html.AntiForgeryToken()

    <div class="card p-4">
        <div class="row g-3">

            <div class="col-md-6">
                <label class="form-label">Shift Type Name</label>
                <input type="text"
                       class="form-control"
                       value="@Model.Name"
                       readonly />
                <input type="hidden" name="Name" value="@Model.Name" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Holiday List</label>

                @if (editMode)
                {
                    <select name="HolidayList" class="form-select" required>
                        <option value="">Select Holiday List</option>
                        @foreach (var hl in holidayLists)
                        {
                            <option value="@hl" selected="@(Model.HolidayList == hl)">
                                @hl
                            </option>
                        }
                    </select>
                }
                else
                {
                    <input type="text" class="form-control" value="@Model.HolidayList" readonly />
                    <input type="hidden" name="HolidayList" value="@Model.HolidayList" />
                }
            </div>

            <div class="col-md-6">
                <label class="form-label">Start Time</label>

                @if (editMode)
                {
                    <input type="time"
                           name="StartTime"
                           class="form-control"
                           value="@FormatTime(Model.StartTime)"
                           step="1"
                           required />
                }
                else
                {
                    <input type="time"
                           class="form-control"
                           value="@FormatTime(Model.StartTime)"
                           step="1"
                           readonly />
                    <input type="hidden" name="StartTime" value="@FormatTime(Model.StartTime)" />
                }
            </div>

            <div class="col-md-6">
                <label class="form-label">Roster Color</label>

                @if (editMode)
                {
                    <select name="RosterColor" class="form-select">
                        <option value="Blue" selected="@(Model.RosterColor == "Blue" || string.IsNullOrWhiteSpace(Model.RosterColor))">Blue</option>
                        <option value="Green" selected="@(Model.RosterColor == "Green")">Green</option>
                        <option value="Red" selected="@(Model.RosterColor == "Red")">Red</option>
                        <option value="Orange" selected="@(Model.RosterColor == "Orange")">Orange</option>
                        <option value="Purple" selected="@(Model.RosterColor == "Purple")">Purple</option>
                        <option value="Yellow" selected="@(Model.RosterColor == "Yellow")">Yellow</option>
                    </select>
                }
                else
                {
                    <input type="text" class="form-control" value="@Model.RosterColor" readonly />
                    <input type="hidden" name="RosterColor" value="@Model.RosterColor" />
                }
            </div>

            <div class="col-md-6">
                <label class="form-label">End Time</label>

                @if (editMode)
                {
                    <input type="time"
                           name="EndTime"
                           class="form-control"
                           value="@FormatTime(Model.EndTime)"
                           step="1"
                           required />
                }
                else
                {
                    <input type="time"
                           class="form-control"
                           value="@FormatTime(Model.EndTime)"
                           step="1"
                           readonly />
                    <input type="hidden" name="EndTime" value="@FormatTime(Model.EndTime)" />
                }
            </div>

            <div class="col-md-6">
                <div class="form-check mt-4">
                    <input type="hidden" name="EnableAutoAttendance" value="false" />

                    @if (editMode)
                    {
                        <input type="checkbox"
                               name="EnableAutoAttendance"
                               value="true"
                               class="form-check-input"
                               id="EnableAutoAttendance"
                               @(Model.EnableAutoAttendance ? "checked" : "") />
                    }
                    else
                    {
                        <input type="checkbox"
                               class="form-check-input"
                               id="EnableAutoAttendance"
                               @(Model.EnableAutoAttendance ? "checked" : "")
                               disabled />
                    }

                    <label class="form-check-label" for="EnableAutoAttendance">Enable Auto Attendance</label>
                </div>
            </div>
        </div>

        @if (editMode)
        {
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-dark">Save</button>
                <a href="/HR/ShiftTypeDetails/@Model.Id" class="btn btn-outline-secondary">Cancel</a>
            </div>
        }
    </div>
</form>
<partial name="_ShiftModuleUi" />
