@using Erp_Aits.Models
@{ ViewBag.Title="New Salary Structure Assignment"; var employees=ViewBag.AssignmentEmployees as List<PayrollEmployeeOption>??new List<PayrollEmployeeOption>(); var structures=ViewBag.AssignmentStructures as List<string>??new List<string>();var slabs=ViewBag.AssignmentTaxSlabs as List<string>??new List<string>();var companies=ViewBag.AssignmentCompanies as List<string>??new List<string>();var accounts=ViewBag.AssignmentAccounts as List<string>??new List<string>();var currencies=ViewBag.AssignmentCurrencies as List<string>??new List<string>();var centers=ViewBag.AssignmentCostCenters as List<string>??new List<string>(); }
<style>.payroll-form{max-width:1210px;margin:0 auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.head{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.head h1{font-size:22px;margin:0}.save{border:0;background:#0f766e;color:#fff;padding:9px 17px;border-radius:7px;font-weight:650}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.section{padding:20px;border-bottom:1px solid #dbe3ec}.section h2{font-size:17px;margin:0 0 16px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.field label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.input,.select{box-sizing:border-box;width:100%;height:36px;border:1px solid #b8c7d7;border-radius:8px;padding:7px 10px;background:#fbfdff;font-size:14px}.input[readonly]{background:#f2f6f9;color:#526375}.table{width:100%;border-collapse:collapse;border:1px solid #d7e0e9;border-radius:8px;overflow:hidden}.table th,.table td{padding:8px;border-bottom:1px solid #e5e7eb;font-size:13px}.table th{background:#f4f8fc;color:#526375;text-align:left}.table input,.table select{width:100%;height:32px;box-sizing:border-box;border:1px solid #b8c7d7;border-radius:6px;padding:5px}.add{margin-top:10px;border:0;background:#dce8f1;color:#172033;border-radius:7px;padding:7px 12px}.search-select{position:relative}.search-menu{display:none;position:fixed;z-index:3000;max-height:260px;overflow:auto;background:#fff;border:1px solid #94a3b8;border-radius:6px;box-shadow:0 10px 20px rgba(15,23,42,.18)}.search-menu button{display:block;width:100%;padding:8px 10px;border:0;background:#fff;text-align:left}.search-menu button:hover{background:#e8f3f3;color:#0f766e}@@media(max-width:800px){.payroll-form{padding:12px}.grid{grid-template-columns:1fr}.section{overflow:auto}.table{min-width:600px}}</style>
<div class="payroll-form"><form method="post" asp-action="CreateSalaryStructureAssignment">@Html.AntiForgeryToken()<header class="head"><h1>New Salary Structure Assignment</h1><button class="save" type="submit">Save</button></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}<main class="card"><section class="section"><div class="grid"><div class="field"><label>Employee *</label><select name="Employee" id="employee" class="select searchable" required><option value="">Select employee</option>@foreach(var x in employees){<option value="@x.Id" data-name="@x.EmployeeName" data-department="@x.Department" data-designation="@x.Designation" data-grade="@x.Grade" data-company="@x.Company">@x.Id</option>}</select></div><div class="field"><label>Employee Name</label><input id="employeeName" class="input" readonly/></div><div class="field"><label>Department</label><input id="department" class="input" readonly/></div><div class="field"><label>Designation</label><input id="designation" class="input" readonly/></div><div class="field"><label>Grade</label><input id="grade" class="input" readonly/></div><div class="field"><label>Salary Structure *</label><select name="SalaryStructure" class="select searchable" required><option value="">Select salary structure</option>@foreach(var x in structures){<option value="@x">@x</option>}</select></div><div class="field"><label>From Date *</label><input name="FromDate" type="date" class="input" required/></div><div class="field"><label>Income Tax Slab</label><select name="IncomeTaxSlab" class="select searchable"><option value="">Select Income Tax Slab</option>@foreach(var x in slabs){<option value="@x">@x</option>}</select></div><div class="field"><label>Company *</label><select name="Company" id="company" class="select searchable" required><option value="">Select company</option>@foreach(var x in companies){<option value="@x">@x</option>}</select></div><div class="field"><label>Payroll Payable Account</label><select name="PayrollPayableAccount" class="select searchable"><option value="">Select account</option>@foreach(var x in accounts){<option value="@x">@x</option>}</select></div><div class="field"><label>Currency *</label><select name="Currency" class="select searchable" required><option value="">Select currency</option>@foreach(var x in currencies){<option value="@x">@x</option>}</select></div></div></section><section class="section"><h2>Base, Variable &amp; Leave Encashment</h2><div class="grid"><div class="field"><label>Base</label><input name="Base" type="number" step="0.01" class="input"/></div><div class="field"><label>Variable</label><input name="Variable" type="number" step="0.01" class="input"/></div><div class="field"><label>Leave Encashment Amount Per Day</label><input name="LeaveEncashmentAmountPerDay" type="number" step="0.01" class="input"/></div></div></section><section class="section"><h2>Opening Balances</h2><div class="grid"><div class="field"><label>Taxable Earnings Till Date</label><input name="TaxableEarningsTillDate" type="number" step="0.01" class="input"/></div><div class="field"><label>Tax Deducted Till Date</label><input name="TaxDeductedTillDate" type="number" step="0.01" class="input"/></div></div></section><section class="section"><h2>Payroll Cost Centers</h2><table class="table"><thead><tr><th>Cost Center</th><th>Percentage</th></tr></thead><tbody id="costRows"><tr><td><select name="CostCenters">@foreach(var x in centers){<option value="@x">@x</option>}</select></td><td><input name="CostCenterPercentages" type="number" step="0.01" value="100"/></td></tr></tbody></table><button type="button" class="add" id="addCost">Add Row</button></section></main></form></div>
<script>
const emp=document.getElementById('employee');emp.addEventListener('change',()=>{const o=emp.options[emp.selectedIndex];document.getElementById('employeeName').value=o.dataset.name||'';document.getElementById('department').value=o.dataset.department||'';document.getElementById('designation').value=o.dataset.designation||'';document.getElementById('grade').value=o.dataset.grade||'';if(o.dataset.company)document.getElementById('company').value=o.dataset.company});
document.getElementById('addCost').addEventListener('click',()=>{const tr=document.querySelector('#costRows tr').cloneNode(true);tr.querySelector('input').value='0';document.getElementById('costRows').appendChild(tr)});
document.querySelectorAll('select.searchable').forEach(select=>{if(select.options.length<=11)return;const wrap=document.createElement('div'),input=document.createElement('input'),menu=document.createElement('div');wrap.className='search-select';input.className='input';input.placeholder='Type to search';menu.className='search-menu';select.parentNode.insertBefore(wrap,select);wrap.append(input,select,menu);select.style.display='none';const draw=()=>{const q=input.value.toLowerCase(),items=[...select.options].filter(x=>x.value&&x.text.toLowerCase().startsWith(q)).slice(0,10);menu.innerHTML='';items.forEach(x=>{const b=document.createElement('button');b.type='button';b.textContent=x.text;b.onclick=()=>{select.value=x.value;input.value=x.text;menu.style.display='none';select.dispatchEvent(new Event('change'))};menu.appendChild(b)});const r=input.getBoundingClientRect();menu.style.width=r.width+'px';menu.style.left=r.left+'px';menu.style.top=r.bottom+'px';menu.style.display='block'};input.addEventListener('focus',draw);input.addEventListener('input',draw);document.addEventListener('click',e=>{if(!wrap.contains(e.target))menu.style.display='none'})});
</script>
