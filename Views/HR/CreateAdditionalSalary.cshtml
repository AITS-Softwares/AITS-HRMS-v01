@using Erp_Aits.Models
@{ ViewBag.Title="New Additional Salary";var employees=ViewBag.AdditionalSalaryEmployees as List<PayrollEmployeeOption>??new List<PayrollEmployeeOption>();var companies=ViewBag.AdditionalSalaryCompanies as List<string>??new List<string>();var components=ViewBag.AdditionalSalaryComponents as List<string>??new List<string>();var currencies=ViewBag.AdditionalSalaryCurrencies as List<string>??new List<string>();var docTypes=ViewBag.AdditionalSalaryDocTypes as List<string>??new List<string>(); }
<style>.payroll-form{max-width:1210px;margin:0 auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.head{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.head h1{font-size:22px;margin:0}.save{border:0;background:#0f766e;color:#fff;padding:9px 17px;border-radius:7px;font-weight:650}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.section{padding:20px;border-bottom:1px solid #dbe3ec}.section h2{font-size:17px;margin:0 0 16px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.field label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.input,.select{box-sizing:border-box;width:100%;height:36px;border:1px solid #b8c7d7;border-radius:8px;padding:7px 10px;background:#fbfdff;font-size:14px}.input[readonly]{background:#f2f6f9;color:#526375}.check{display:flex;align-items:center;gap:8px;font-size:14px;margin-top:13px}.help{font-size:13px;color:#526375;margin-top:8px}.hidden{display:none}.search-select{position:relative}.search-menu{display:none;position:fixed;z-index:3000;max-height:260px;overflow:auto;background:#fff;border:1px solid #94a3b8;border-radius:6px;box-shadow:0 10px 20px rgba(15,23,42,.18)}.search-menu button{display:block;width:100%;padding:8px 10px;border:0;background:#fff;text-align:left}.search-menu button:hover{background:#e8f3f3;color:#0f766e}@@media(max-width:800px){.payroll-form{padding:12px}.grid{grid-template-columns:1fr}}</style>
<div class="payroll-form"><form method="post" asp-action="CreateAdditionalSalary">@Html.AntiForgeryToken()<header class="head"><h1>New Additional Salary</h1><button class="save" type="submit">Save</button></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}<main class="card"><section class="section"><div class="grid"><div class="field"><label>Series *</label><input name="NamingSeries" class="input" value="HR-ADS-.YY.-.MM.-" required/></div><div class="field"><label>Employee *</label><select name="Employee" id="employee" class="select searchable" required><option value="">Select employee</option>@foreach(var x in employees){<option value="@x.Id" data-name="@x.EmployeeName" data-department="@x.Department" data-company="@x.Company">@x.Id</option>}</select></div><div class="field"><label>Employee Name</label><input id="employeeName" class="input" readonly/></div><div class="field"><label>Department</label><input id="department" class="input" readonly/></div><div class="field"><label>Company *</label><select name="Company" id="company" class="select searchable" required><option value="">Select company</option>@foreach(var x in companies){<option value="@x">@x</option>}</select></div><div><label class="check"><input name="IsRecurring" id="isRecurring" type="checkbox"/>Is Recurring</label><label class="check recurring"><input name="Disabled" type="checkbox"/>Disabled</label></div><div class="field recurring"><label>From Date</label><input name="FromDate" type="date" class="input"/></div><div class="field recurring"><label>To Date</label><input name="ToDate" type="date" class="input"/></div><div class="field oneTime"><label>Payroll Date</label><input name="PayrollDate" type="date" class="input"/><p class="help">The date on which Salary Component with Amount contributes to Earnings or Deduction in Salary Slip.</p></div><div class="field"><label>Amended From</label><input class="input" readonly/></div></div></section><section class="section"><h2>Salary</h2><div class="grid"><div class="field"><label>Salary Component *</label><select name="SalaryComponent" id="salaryComponent" class="select searchable" required><option value="">Select salary component</option>@foreach(var x in components){<option value="@x">@x</option>}</select></div><div class="field"><label>Salary Component Type</label><input id="componentType" class="input" readonly/></div><div class="field"><label>Currency *</label><select name="Currency" class="select searchable" required><option value="">Select currency</option>@foreach(var x in currencies){<option value="@x">@x</option>}</select></div><div class="field"><label>Amount *</label><input name="Amount" type="number" step="0.01" class="input" required/></div><div><label class="check"><input name="DeductFullTax" type="checkbox"/>Deduct Full Tax on Selected Payroll Date</label><label class="check"><input name="OverwriteSalaryStructureAmount" type="checkbox" checked/>Overwrite Salary Structure Amount</label></div></div></section><section class="section"><h2>References</h2><div class="grid"><div class="field"><label>Reference Document Type</label><select name="ReferenceDocumentType" class="select searchable"><option value="">Select document type</option>@foreach(var x in docTypes){<option value="@x">@x</option>}</select></div><div class="field"><label>Reference Document</label><input name="ReferenceDocument" class="input"/></div></div></section></main></form></div>
<script>const employee=document.getElementById('employee');employee.addEventListener('change',()=>{const o=employee.options[employee.selectedIndex];document.getElementById('employeeName').value=o.dataset.name||'';document.getElementById('department').value=o.dataset.department||'';if(o.dataset.company)document.getElementById('company').value=o.dataset.company});const toggle=()=>{const recurring=document.getElementById('isRecurring').checked;document.querySelectorAll('.recurring').forEach(x=>x.classList.toggle('hidden',!recurring));document.querySelectorAll('.oneTime').forEach(x=>x.classList.toggle('hidden',recurring))};document.getElementById('isRecurring').addEventListener('change',toggle);toggle();document.querySelectorAll('select.searchable').forEach(select=>{if(select.options.length<=11)return;const wrap=document.createElement('div'),input=document.createElement('input'),menu=document.createElement('div');wrap.className='search-select';input.className='input';input.placeholder='Type to search';menu.className='search-menu';select.parentNode.insertBefore(wrap,select);wrap.append(input,select,menu);select.style.display='none';const draw=()=>{const q=input.value.toLowerCase(),items=[...select.options].filter(x=>x.value&&x.text.toLowerCase().startsWith(q)).slice(0,10);menu.innerHTML='';items.forEach(x=>{const b=document.createElement('button');b.type='button';b.textContent=x.text;b.onclick=()=>{select.value=x.value;input.value=x.text;menu.style.display='none';select.dispatchEvent(new Event('change'))};menu.appendChild(b)});const r=input.getBoundingClientRect();menu.style.width=r.width+'px';menu.style.left=r.left+'px';menu.style.top=r.bottom+'px';menu.style.display='block'};input.addEventListener('focus',draw);input.addEventListener('input',draw);document.addEventListener('click',e=>{if(!wrap.contains(e.target))menu.style.display='none'})});</script>
