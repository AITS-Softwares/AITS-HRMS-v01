@using Erp_Aits.Models
@{ ViewBag.Title="New Additional Salary"; var employees=ViewBag.AdditionalSalaryEmployees as List<PayrollEmployeeOption>??new(); var companies=ViewBag.AdditionalSalaryCompanies as List<string>??new(); var components=ViewBag.AdditionalSalaryComponents as List<string>??new(); var currencies=ViewBag.AdditionalSalaryCurrencies as List<string>??new(); var docTypes=ViewBag.AdditionalSalaryDocTypes as List<string>??new(); }
<style>.payroll-form{max-width:1210px;margin:0 auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.head{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.head h1{font-size:22px;margin:0}.save{border:0;background:#0f766e;color:#fff;padding:9px 17px;border-radius:7px;font-weight:650}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.section{padding:20px;border-bottom:1px solid #dbe3ec}.section h2{font-size:17px;margin:0 0 16px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.field label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.input,.select{box-sizing:border-box;width:100%;height:36px;border:1px solid #b8c7d7;border-radius:8px;padding:7px 10px;background:#fbfdff;font-size:14px}.input[readonly]{background:#f2f6f9;color:#526375}.check{display:flex;align-items:center;gap:8px;font-size:14px;margin-top:13px}.help{font-size:13px;color:#526375;margin-top:8px}.hidden{display:none}@@media(max-width:800px){.payroll-form{padding:12px}.grid{grid-template-columns:1fr}}</style>
<div class="payroll-form"><form method="post" asp-action="CreateAdditionalSalary">@Html.AntiForgeryToken()<header class="head"><h1>New Additional Salary</h1><button class="save" type="submit">Save</button></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}<main class="card"><section class="section"><div class="grid"><div class="field"><label>Series *</label><input name="NamingSeries" class="input" value="HR-ADS-.YY.-.MM.-" required/></div><div class="field"><label>Employee *</label><select name="Employee" id="employee" class="select" required><option value="">Select employee</option>@foreach(var x in employees){<option value="@x.Id" data-name="@x.EmployeeName" data-department="@x.Department" data-company="@x.Company">@x.Id</option>}</select></div><div class="field"><label>Employee Name</label><input id="employeeName" class="input" readonly/></div><div class="field"><label>Department</label><input id="department" class="input" readonly/></div><div class="field"><label>Company *</label><select name="Company" id="company" class="select" required><option value="">Select company</option>@foreach(var x in companies){<option value="@x">@x</option>}</select></div><div><label class="check"><input name="IsRecurring" id="isRecurring" type="checkbox"/>Is Recurring</label><label class="check recurring"><input name="Disabled" type="checkbox"/>Disabled</label></div><div class="field recurring"><label>From Date</label><input name="FromDate" type="date" class="input"/></div><div class="field recurring"><label>To Date</label><input name="ToDate" type="date" class="input"/></div><div class="field oneTime"><label>Payroll Date</label><input name="PayrollDate" type="date" class="input"/><p class="help">The date on which Salary Component with Amount contributes to Earnings or Deduction in Salary Slip.</p></div><div class="field"><label>Amended From</label><input class="input" readonly/></div></div></section><section class="section"><h2>Salary</h2><div class="grid"><div class="field"><label>Salary Component *</label><select name="SalaryComponent" id="salaryComponent" class="select" required><option value="">Select salary component</option>@foreach(var x in components){<option value="@x">@x</option>}</select></div><div class="field"><label>Salary Component Type</label><input id="componentType" class="input" readonly/></div><div class="field"><label>Current Amount</label><input id="currentAmount" class="input" readonly/></div><div class="field"><label>Currency *</label><select name="Currency" class="select" required><option value="">Select currency</option>@foreach(var x in currencies){<option value="@x">@x</option>}</select></div><div class="field"><label>Amount *</label><input id="amount" name="Amount" type="number" step="0.01" class="input" required/></div><div><label class="check"><input name="DeductFullTax" type="checkbox"/>Deduct Full Tax on Selected Payroll Date</label><label class="check"><input name="OverwriteSalaryStructureAmount" type="checkbox" checked/>Overwrite Salary Structure Amount</label></div></div></section><section class="section"><h2>References</h2><div class="grid"><div class="field"><label>Reference Document Type</label><select name="ReferenceDocumentType" class="select"><option value="">Select document type</option>@foreach(var x in docTypes){<option value="@x">@x</option>}</select></div><div class="field"><label>Reference Document</label><input name="ReferenceDocument" class="input"/></div></div></section></main></form></div>
<script>const employee=document.getElementById('employee');employee.addEventListener('change',()=>{const o=employee.options[employee.selectedIndex];document.getElementById('employeeName').value=o.dataset.name||'';document.getElementById('department').value=o.dataset.department||'';if(o.dataset.company)document.getElementById('company').value=o.dataset.company});const toggle=()=>{const recurring=document.getElementById('isRecurring').checked;document.querySelectorAll('.recurring').forEach(x=>x.classList.toggle('hidden',!recurring));document.querySelectorAll('.oneTime').forEach(x=>x.classList.toggle('hidden',recurring))};document.getElementById('isRecurring').addEventListener('change',toggle);toggle();document.getElementById('salaryComponent').addEventListener('change',async e=>{const component=e.target.value;document.getElementById('componentType').value='';document.getElementById('currentAmount').value='';if(!component)return;try{const r=await fetch('@Url.Action("GetAdditionalSalaryComponentDefaults", "HR")?component='+encodeURIComponent(component));const d=await r.json();if(!r.ok)throw new Error(d.message);document.getElementById('componentType').value=d.type||'';document.getElementById('currentAmount').value=d.amount||'';document.getElementById('amount').value=d.amount||''}catch(error){console.error('Salary component defaults could not be loaded.',error)}});</script>
