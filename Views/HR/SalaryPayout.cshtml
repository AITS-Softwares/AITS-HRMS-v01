@{ ViewBag.Title = "Payroll"; }
<style>
.payroll-page{max-width:1320px;margin:auto;padding:28px 24px 48px;color:#172033}.payroll-hero{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:26px}.eyebrow{color:#68758a;font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;margin-bottom:8px}.payroll-title{margin:0;font-size:34px;line-height:1.1;font-weight:800;letter-spacing:-.02em}.payroll-subtitle{margin:10px 0 0;color:#6b778c;font-size:15px}.hero-actions{display:flex;gap:10px;flex-wrap:wrap}.hero-btn{display:inline-flex;align-items:center;gap:8px;padding:11px 15px;border-radius:7px;text-decoration:none;font-size:13px;font-weight:750;border:1px solid #dbe2ec;color:#334155;background:#fff;box-shadow:0 2px 8px #1e2d460d}.hero-btn.primary{background:#2f6fe4;border-color:#2f6fe4;color:#fff}.hero-btn:hover,.shortcut-card:hover{transform:translateY(-2px);box-shadow:0 8px 20px #1e46821c}.stat-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:26px}.stat-card,.shortcut-card,.nav-group{background:#fff;border:1px solid #e3e8f0;border-radius:8px;box-shadow:0 3px 12px #2334500b}.stat-card{padding:18px;display:flex;justify-content:space-between;align-items:center}.stat-label{color:#748096;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em}.stat-value{margin-top:7px;font-size:25px;font-weight:800}.stat-icon,.shortcut-icon{display:grid;place-items:center;border-radius:8px;font-weight:800}.stat-icon{width:38px;height:38px;color:#2f6fe4;background:#eaf2ff}.stat-card:nth-child(2) .stat-icon{color:#12877f;background:#e4f5f2}.stat-card:nth-child(3) .stat-icon{color:#d97706;background:#fff4e5}.stat-card:nth-child(4) .stat-icon{color:#142944;background:#f0eaff}.section-bar{display:flex;justify-content:space-between;align-items:center;gap:18px;margin:30px 0 14px}.section-bar h2{margin:0;font-size:19px;font-weight:800}.search-box{width:240px;position:relative}.search-box input{width:100%;border:1px solid #dce3ed;border-radius:6px;padding:10px 12px 10px 36px;font-size:13px;outline:0}.search-box input:focus{border-color:#7aa7ef;box-shadow:0 0 0 3px #eaf2ff}.search-box span{position:absolute;left:12px;top:9px;color:#8793a7}.shortcut-grid,.group-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.shortcut-card{display:flex;align-items:center;gap:14px;min-height:88px;padding:17px;color:#172033;text-decoration:none;transition:.18s ease}.shortcut-icon{width:42px;height:42px;flex:0 0 42px;background:#eaf2f8;color:#2f6fe4;font-size:18px}.shortcut-card:nth-child(2) .shortcut-icon{background:#e4f5f2;color:#12877f}.shortcut-card:nth-child(3) .shortcut-icon{background:#fff4e5;color:#d97706}.shortcut-name{font-weight:780;font-size:14px}.shortcut-meta{display:block;margin-top:5px;color:#7a879a;font-size:12px}.arrow{margin-left:auto;color:#9aa6b8;font-size:18px}.nav-group{padding:19px 20px 14px}.nav-group h3{display:flex;align-items:center;gap:9px;margin:0 0 14px;font-size:15px;font-weight:800}.group-mark{width:8px;height:8px;border-radius:2px;background:#2f6fe4}.nav-group:nth-child(3n+2) .group-mark{background:#0b806b}.nav-group:nth-child(3n) .group-mark{background:#d97706}.nav-group ul{list-style:none;padding:0;margin:0}.nav-group li{border-top:1px solid #eef1f5}.nav-link{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 0;color:#526075;text-decoration:none;font-size:13px}.nav-link:hover{color:#2f6fe4}.nav-link i{color:#a1acbb;font-style:normal;font-size:15px}@@media(max-width:960px){.group-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.stat-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@@media(max-width:680px){.payroll-page{padding:20px 14px 34px}.payroll-hero{display:block}.hero-actions{margin-top:18px}.shortcut-grid,.group-grid,.stat-grid{grid-template-columns:1fr}.section-bar{align-items:stretch;flex-direction:column}.search-box{width:100%}}
</style>
<main class="payroll-page">
 <header class="payroll-hero"><div><div class="eyebrow">Human Resources / Finance</div><h1 class="payroll-title">Payroll workspace</h1><p class="payroll-subtitle">Manage salaries, payroll cycles, accounting and statutory reports from one place.</p></div><div class="hero-actions"><a class="hero-btn primary" href="@Url.Action("SalaryRegister", "HR")">▤ &nbsp;View register</a></div></header>
 <section class="stat-grid"><div class="stat-card"><div><div class="stat-label">Salary slips</div><div class="stat-value">0</div></div><div class="stat-icon">▤</div></div><div class="stat-card"><div><div class="stat-label">Payroll entries</div><div class="stat-value">0</div></div><div class="stat-icon">✓</div></div><div class="stat-card"><div><div class="stat-label">Pending drafts</div><div class="stat-value">0</div></div><div class="stat-icon">◷</div></div><div class="stat-card"><div><div class="stat-label">Reports</div><div class="stat-value">11</div></div><div class="stat-icon">↗</div></div></section>
 <section><div class="section-bar"><h2>Quick access</h2></div><div class="shortcut-grid"><a class="shortcut-card" href="@Url.Action("SalarySlip", "HR")"><div class="shortcut-icon">₹</div><div><span class="shortcut-name">Salary slips</span><span class="shortcut-meta">Create and review employee slips</span></div><span class="arrow">›</span></a><a class="shortcut-card" href="@Url.Action("PayrollEntry", "HR")"><div class="shortcut-icon">✓</div><div><span class="shortcut-name">Payroll entry</span><span class="shortcut-meta">Process a new payroll cycle</span></div><span class="arrow">›</span></a><a class="shortcut-card" href="@Url.Action("SalaryRegister", "HR")"><div class="shortcut-icon">▥</div><div><span class="shortcut-name">Salary register</span><span class="shortcut-meta">Browse payroll history and totals</span></div><span class="arrow">›</span></a></div></section>
 <section><div class="section-bar"><h2>Payroll tools and reports</h2><label class="search-box"><span>⌕</span><input id="payrollSearch" type="search" placeholder="Search payroll tools" aria-label="Search payroll tools"></label></div><div class="group-grid" id="payrollGroups">
  <div class="nav-group"><h3><span class="group-mark"></span>Masters</h3><ul><li><a class="nav-link" href="@Url.Action("SalaryComponent", "HR")">Salary Component <i>›</i></a></li><li><a class="nav-link" href="@Url.Action("SalaryStructure", "HR")">Salary Structure <i>›</i></a></li><li><a class="nav-link" href="@Url.Action("IncomeTaxSlab", "HR")">Income Tax Slab <i>›</i></a></li><li><a class="nav-link" href="@Url.Action("PayrollPeriod", "HR")">Payroll Period <i>›</i></a></li></ul></div>
  <div class="nav-group"><h3><span class="group-mark"></span>Payroll operations</h3><ul><li><a class="nav-link" href="@Url.Action("SalaryStructureAssignment", "HR")">Salary Structure Assignment <i>›</i></a></li><li><a class="nav-link" href="@Url.Action("BulkSalaryStructureAssignment", "HR")">Bulk Structure Assignment <i>›</i></a></li><li><a class="nav-link" href="@Url.Action("SalarySlip", "HR")">Salary Slip <i>›</i></a></li><li><a class="nav-link" href="@Url.Action("PayrollEntry", "HR")">Payroll Entry <i>›</i></a></li><li><a class="nav-link" href="@Url.Action("SalaryWithholding", "HR")">Salary Withholding <i>›</i></a></li></ul></div>
  <div class="nav-group"><h3><span class="group-mark"></span>Incentives</h3><ul><li><a class="nav-link" href="@Url.Action("AdditionalSalary", "HR")">Additional Salary <i>›</i></a></li><li><a class="nav-link" href="@Url.Action("EmployeeIncentive", "HR")">Employee Incentive <i>›</i></a></li><li><a class="nav-link" href="@Url.Action("RetentionBonus", "HR")">Retention Bonus <i>›</i></a></li></ul></div>
  <div class="nav-group"><h3><span class="group-mark"></span>Accounting</h3><ul><li><a class="nav-link" href="@Url.Action("Account", "HR")">Chart of Accounts <i>›</i></a></li><li><a class="nav-link" href="@Url.Action("CostCenter", "HR")">Chart of Cost Centers <i>›</i></a></li><li><a class="nav-link" href="@Url.Action("PaymentEntry", "HR")">Payment Entry <i>›</i></a></li><li><a class="nav-link" href="@Url.Action("JournalEntry", "HR")">Journal Entry <i>›</i></a></li><li><a class="nav-link" href="@Url.Action("AccountingDimension", "HR")">Accounting Dimension <i>›</i></a></li><li><a class="nav-link" href="@Url.Action("Currency", "HR")">Currency <i>›</i></a></li></ul></div>
  <div class="nav-group"><h3><span class="group-mark"></span>Accounting reports</h3><ul><li><a class="nav-link" href="@Url.Action("GeneralLedger", "HR")">General Ledger <i>›</i></a></li><li><a class="nav-link" href="@Url.Action("AccountsPayable", "HR")">Accounts Payable <i>›</i></a></li><li><a class="nav-link" href="@Url.Action("AccountsReceivable", "HR")">Accounts Receivable <i>›</i></a></li></ul></div>
  <div class="nav-group"><h3><span class="group-mark"></span>Payroll reports</h3><ul><li><a class="nav-link" href="@Url.Action("SalaryRegister", "HR")">Salary Register <i>›</i></a></li><li><a class="nav-link" href="@Url.Action("BankRemittance", "HR")">Bank Remittance <i>›</i></a></li><li><a class="nav-link" href="@Url.Action("SalaryPaymentsBasedOnPaymentMode", "HR")">Payments by mode <i>›</i></a></li><li><a class="nav-link" href="@Url.Action("SalaryPaymentsViaEcs", "HR")">Salary Payments via ECS <i>›</i></a></li><li><a class="nav-link" href="@Url.Action("IncomeTaxComputation", "HR")">Income Tax Computation <i>›</i></a></li></ul></div>
  <div class="nav-group"><h3><span class="group-mark"></span>Deduction reports</h3><ul><li><a class="nav-link" href="@Url.Action("ProvidentFundDeductions", "HR")">Provident Fund Deductions <i>›</i></a></li><li><a class="nav-link" href="@Url.Action("ProfessionalTaxDeductions", "HR")">Professional Tax Deductions <i>›</i></a></li><li><a class="nav-link" href="@Url.Action("IncomeTaxDeductions", "HR")">Income Tax Deductions <i>›</i></a></li></ul></div>
 </div></section>
</main>
<script>document.getElementById('payrollSearch')?.addEventListener('input',function(){const q=this.value.trim().toLowerCase();document.querySelectorAll('#payrollGroups .nav-group').forEach(g=>{const links=[...g.querySelectorAll('.nav-link')];let n=0;links.forEach(a=>{const show=!q||a.textContent.toLowerCase().includes(q);a.parentElement.hidden=!show;n+=show?1:0});g.hidden=q&&n===0})});</script>



