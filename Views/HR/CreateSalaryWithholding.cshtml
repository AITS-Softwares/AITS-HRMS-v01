@using Erp_Aits.Models
@{ ViewBag.Title="New Salary Withholding"; var employees=ViewBag.WithholdingEmployees as List<PayrollEmployeeOption>??new List<PayrollEmployeeOption>(); }
<style>.payroll-form{max-width:1210px;margin:0 auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.head{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.head h1{font-size:22px;margin:0}.save{border:0;background:#0f766e;color:#fff;padding:9px 17px;border-radius:7px;font-weight:650}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.section{padding:20px;border-bottom:1px solid #dbe3ec}.section h2{font-size:17px;margin:0 0 16px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.field label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.input,.select,.textarea{box-sizing:border-box;width:100%;height:36px;border:1px solid #b8c7d7;border-radius:8px;padding:7px 10px;background:#fbfdff;font-size:14px}.textarea{height:90px;resize:vertical}.input[readonly]{background:#f2f6f9;color:#526375}.table{width:100%;border-collapse:collapse;border:1px solid #d7e0e9;border-radius:8px;overflow:hidden}.table th,.table td{padding:10px;border-bottom:1px solid #e5e7eb;font-size:13px}.table th{background:#f4f8fc;color:#526375;text-align:left}.empty{text-align:center;color:#64748b;height:54px}.search-select{position:relative}.search-menu{display:none;position:fixed;z-index:3000;max-height:260px;overflow:auto;background:#fff;border:1px solid #94a3b8;border-radius:6px;box-shadow:0 10px 20px rgba(15,23,42,.18)}.search-menu button{display:block;width:100%;padding:8px 10px;border:0;background:#fff;text-align:left}.search-menu button:hover{background:#e8f3f3;color:#0f766e}@@media(max-width:800px){.payroll-form{padding:12px}.grid{grid-template-columns:1fr}}</style>
<div class="payroll-form"><form method="post" asp-action="CreateSalaryWithholding">@Html.AntiForgeryToken()<header class="head"><h1>New Salary Withholding</h1><button class="save" type="submit">Save</button></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}<main class="card"><section class="section"><div class="grid"><div class="field"><label>Employee *</label><select name="Employee" id="employee" class="select searchable" required><option value="">Select employee</option>@foreach(var x in employees){<option value="@x.Id" data-name="@x.EmployeeName" data-company="@x.Company" data-joining="@x.DateOfJoining" data-relieving="@x.RelievingDate">@x.Id</option>}</select></div><div class="field"><label>Employee Name</label><input id="employeeName" class="input" readonly/></div><div class="field"><label>Company</label><input id="company" class="input" readonly/></div><div class="field"><label>Posting Date *</label><input name="PostingDate" type="date" class="input" required/></div><div class="field"><label>Payroll Frequency *</label><select name="PayrollFrequency" class="select" required><option value="Monthly">Monthly</option><option value="Fortnightly">Fortnightly</option><option value="Bimonthly">Bimonthly</option><option value="Weekly">Weekly</option><option value="Daily">Daily</option></select></div><div class="field"><label>Number of Withholding Cycles *</label><input name="NumberOfWithholdingCycles" type="number" min="1" class="input" required/></div><div class="field"><label>Status</label><select name="Status" class="select"><option>Draft</option><option>Withheld</option><option>Released</option><option>Cancelled</option></select></div><div class="field"><label>From Date *</label><input name="FromDate" type="date" class="input" required/></div><div class="field"><label>To Date *</label><input name="ToDate" type="date" class="input" required/></div></div></section><section class="section"><h2>Exit Details</h2><div class="grid"><div class="field"><label>Date of Joining</label><input id="dateOfJoining" class="input" readonly/></div><div class="field"><label>Relieving Date</label><input id="relievingDate" class="input" readonly/></div></div></section><section class="section"><h2>Reason</h2><div class="field"><label>Reason for Withholding Salary</label><textarea name="ReasonForWithholdingSalary" class="textarea"></textarea></div></section><section class="section"><h2>Cycles</h2><table class="table"><thead><tr><th>Cycles</th></tr></thead><tbody><tr><td class="empty">Cycles are generated and maintained by ERPNext after the record is created.</td></tr></tbody></table></section><section class="section"><div class="field"><label>Amended From</label><input class="input" readonly/></div></section></main></form></div>
<script>const emp=document.getElementById('employee');emp.addEventListener('change',()=>{const o=emp.options[emp.selectedIndex];document.getElementById('employeeName').value=o.dataset.name||'';document.getElementById('company').value=o.dataset.company||'';document.getElementById('dateOfJoining').value=o.dataset.joining||'';document.getElementById('relievingDate').value=o.dataset.relieving||''});document.querySelectorAll('select.searchable').forEach(select=>{if(select.options.length<=11)return;const wrap=document.createElement('div'),input=document.createElement('input'),menu=document.createElement('div');wrap.className='search-select';input.className='input';input.placeholder='Type to search';menu.className='search-menu';select.parentNode.insertBefore(wrap,select);wrap.append(input,select,menu);select.style.display='none';const draw=()=>{const q=input.value.toLowerCase(),items=[...select.options].filter(x=>x.value&&x.text.toLowerCase().startsWith(q)).slice(0,10);menu.innerHTML='';items.forEach(x=>{const b=document.createElement('button');b.type='button';b.textContent=x.text;b.onclick=()=>{select.value=x.value;input.value=x.text;menu.style.display='none';select.dispatchEvent(new Event('change'))};menu.appendChild(b)});const r=input.getBoundingClientRect();menu.style.width=r.width+'px';menu.style.left=r.left+'px';menu.style.top=r.bottom+'px';menu.style.display='block'};input.addEventListener('focus',draw);input.addEventListener('input',draw);document.addEventListener('click',e=>{if(!wrap.contains(e.target))menu.style.display='none'})});</script>
