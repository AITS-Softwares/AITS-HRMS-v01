@using Erp_Aits.Models
@using Newtonsoft.Json.Linq
@{ ViewBag.Title = "Salary Withholding"; var employees = ViewBag.WithholdingEmployees as List<PayrollEmployeeOption> ?? new List<PayrollEmployeeOption>(); var doc = ViewBag.Document as JObject; string V(string key) => doc?[key]?.ToString() ?? ""; bool editing = doc != null; }
<style>
    .withholding-form { max-width:1210px;margin:0 auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px; }
    .withholding-head { display:flex;justify-content:space-between;align-items:center;gap:16px;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff; }.withholding-head h1{font-size:22px;margin:0}.withholding-actions{display:flex;gap:10px}.withholding-actions a,.withholding-actions button{border:1px solid #9bb4c8;border-radius:6px;padding:9px 14px;font-weight:650;text-decoration:none}.withholding-actions a{color:#fff}.withholding-actions button{border:0;background:#0f766e;color:#fff}.withholding-card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.withholding-section{padding:20px;border-bottom:1px solid #dbe3ec}.withholding-section h2{font-size:17px;margin:0 0 16px}.withholding-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.withholding-field label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.withholding-input,.withholding-select,.withholding-textarea{box-sizing:border-box;width:100%;height:38px;border:1px solid #b8c7d7;border-radius:6px;padding:7px 10px;background:#fbfdff;font-size:14px}.withholding-textarea{height:90px;resize:vertical}.withholding-input[readonly]{background:#f2f6f9;color:#526375}.withholding-table{width:100%;border-collapse:collapse;border:1px solid #d7e0e9}.withholding-table th,.withholding-table td{padding:10px;border-bottom:1px solid #e5e7eb;font-size:13px}.withholding-table th{background:#f4f8fc;color:#526375;text-align:left}.withholding-empty{text-align:center;color:#64748b;height:54px}.search-select{position:relative}.search-menu{display:none;position:fixed;z-index:3000;max-height:260px;overflow:auto;background:#fff;border:1px solid #94a3b8;border-radius:6px;box-shadow:0 10px 20px rgba(15,23,42,.18)}.search-menu button{display:block;width:100%;padding:8px 10px;border:0;background:#fff;text-align:left}.search-menu button:hover{background:#e8f3f3;color:#0f766e}@@media(max-width:800px){.withholding-form{padding:12px}.withholding-grid{grid-template-columns:1fr}.withholding-head{align-items:flex-start;flex-direction:column}}
</style>
<div class="withholding-form"><form method="post" asp-action="CreateSalaryWithholding">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@V("name")" /><header class="withholding-head"><div><h1>@(editing ? "Edit Salary Withholding" : "New Salary Withholding")</h1></div><div class="withholding-actions"><a asp-action="SalaryWithholding">Cancel</a><button type="submit">Save</button></div></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}<main class="withholding-card"><section class="withholding-section"><div class="withholding-grid"><div class="withholding-field"><label>Employee *</label><select name="Employee" id="employee" class="withholding-select searchable" required><option value="">Select employee</option>@foreach(var x in employees){<option value="@x.Id" selected="@(x.Id == V("employee"))" data-name="@x.EmployeeName" data-company="@x.Company" data-joining="@x.DateOfJoining" data-relieving="@x.RelievingDate">@x.Id</option>}</select></div><div class="withholding-field"><label>Employee Name</label><input id="employeeName" class="withholding-input" readonly value="@V("employee_name")"/></div><div class="withholding-field"><label>Company</label><input id="company" class="withholding-input" readonly value="@V("company")"/></div><div class="withholding-field"><label>Posting Date *</label><input name="PostingDate" type="date" class="withholding-input" required value="@V("posting_date")"/></div><div class="withholding-field"><label>Payroll Frequency *</label><select name="PayrollFrequency" class="withholding-select" required>@foreach(var frequency in new[]{"Monthly","Fortnightly","Bimonthly","Weekly","Daily"}){<option value="@frequency" selected="@(frequency == V("payroll_frequency"))">@frequency</option>}</select></div><div class="withholding-field"><label>Number of Withholding Cycles *</label><input name="NumberOfWithholdingCycles" type="number" min="1" class="withholding-input" required value="@V("number_of_withholding_cycles")"/></div><div class="withholding-field"><label>Status</label><select name="Status" class="withholding-select">@foreach(var status in new[]{"Draft","Withheld","Released","Cancelled"}){<option value="@status" selected="@(status == V("status"))">@status</option>}</select></div><div class="withholding-field"><label>From Date *</label><input name="FromDate" type="date" class="withholding-input" required value="@V("from_date")"/></div><div class="withholding-field"><label>To Date *</label><input name="ToDate" type="date" class="withholding-input" required value="@V("to_date")"/></div></div></section><section class="withholding-section"><h2>Exit Details</h2><div class="withholding-grid"><div class="withholding-field"><label>Date of Joining</label><input id="dateOfJoining" class="withholding-input" readonly value="@V("date_of_joining")"/></div><div class="withholding-field"><label>Relieving Date</label><input id="relievingDate" class="withholding-input" readonly value="@V("relieving_date")"/></div></div></section><section class="withholding-section"><h2>Reason</h2><div class="withholding-field"><label>Reason for Withholding Salary</label><textarea name="ReasonForWithholdingSalary" class="withholding-textarea">@V("reason_for_withholding_salary")</textarea></div></section><section class="withholding-section"><h2>Cycles</h2><table class="withholding-table"><thead><tr><th>Cycles</th></tr></thead><tbody><tr><td class="withholding-empty">Cycles are generated and maintained by ERPNext after the record is created.</td></tr></tbody></table></section><section class="withholding-section"><div class="withholding-field"><label>Amended From</label><input class="withholding-input" readonly value="@V("amended_from")"/></div></section></main></form></div>
<script>const emp=document.getElementById('employee');emp.addEventListener('change',()=>{const o=emp.options[emp.selectedIndex];document.getElementById('employeeName').value=o.dataset.name||'';document.getElementById('company').value=o.dataset.company||'';document.getElementById('dateOfJoining').value=o.dataset.joining||'';document.getElementById('relievingDate').value=o.dataset.relieving||''});document.querySelectorAll('select.searchable').forEach(select=>{if(select.options.length<=11)return;const wrap=document.createElement('div'),input=document.createElement('input'),menu=document.createElement('div');wrap.className='search-select';input.className='withholding-input';input.placeholder='Type to search';menu.className='search-menu';select.parentNode.insertBefore(wrap,select);wrap.append(input,select,menu);select.style.display='none';const draw=()=>{const q=input.value.toLowerCase(),items=[...select.options].filter(x=>x.value&&x.text.toLowerCase().startsWith(q)).slice(0,10);menu.innerHTML='';items.forEach(x=>{const b=document.createElement('button');b.type='button';b.textContent=x.text;b.onclick=()=>{select.value=x.value;input.value=x.text;menu.style.display='none';select.dispatchEvent(new Event('change'))};menu.appendChild(b)});const r=input.getBoundingClientRect();menu.style.width=r.width+'px';menu.style.left=r.left+'px';menu.style.top=r.bottom+'px';menu.style.display='block'};input.value=select.options[select.selectedIndex]?.text||'';input.addEventListener('focus',draw);input.addEventListener('input',draw);document.addEventListener('click',e=>{if(!wrap.contains(e.target))menu.style.display='none'})});</script>
