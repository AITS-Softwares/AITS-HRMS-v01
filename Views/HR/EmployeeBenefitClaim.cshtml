@using Erp_Aits.Models
@{ViewBag.Title="Employee Benefit Claim";var rows=ViewBag.EmployeeBenefitClaims as List<EmployeeBenefitClaimListItem>??new List<EmployeeBenefitClaimListItem>();}
<style>.p{max-width:1210px;margin:auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.h{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.h h1{margin:0;font-size:22px}.add{background:#0f766e;color:#fff;border-radius:7px;padding:9px 14px;text-decoration:none;font-weight:650}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.filter{display:flex;gap:10px;padding:16px 20px;background:#f4f8fc}.filter input{width:280px;border:1px solid #b8c7d7;border-radius:7px;padding:8px 10px}.filter button{border:0;background:#dce8f1;border-radius:7px;padding:8px 14px}.t{width:100%;border-collapse:collapse}.t th,.t td{padding:13px 16px;border-bottom:1px solid #e4eaf0;text-align:left;font-size:14px}.t th{background:#f4f8fc;color:#526375}.t a{color:#0f766e;text-decoration:none;font-weight:650}.empty{text-align:center;padding:65px;color:#64748b}</style>
<div class="p"><header class="h"><h1>Employee Benefit Claim</h1><a class="add" asp-action="CreateEmployeeBenefitClaim">Add Employee Benefit Claim</a></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}@if(TempData["Success"]!=null){<div class="alert alert-success mt-3">@TempData["Success"]</div>}<main class="card"><form class="filter"><input name="id" value="@Context.Request.Query["id"]" placeholder="Search claim ID"/><button>Search</button></form><table class="t"><thead><tr><th>ID</th><th>Employee</th><th>Employee Name</th><th>Claim Benefit For</th><th>Claimed Amount</th></tr></thead><tbody>@if(rows.Any()){foreach(var r in rows){<tr><td><a asp-action="EmployeeBenefitClaimDetails" asp-route-id="@r.Name">@r.Name</a></td><td>@r.Employee</td><td>@r.EmployeeName</td><td>@r.EarningComponent</td><td>@r.ClaimedAmount</td></tr>}}else{<tr><td colspan="5" class="empty">No Employee Benefit Claims found in ERPNext.</td></tr>}</tbody></table></main></div>
