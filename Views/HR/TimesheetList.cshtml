@model List<Erp_Aits.Models.TimeSheet>
@{
    ViewBag.Title = "Timesheet";
}

<!-- Success or Error Alerts -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Timesheet</h4>
    <div>
        <a href="/HR/CreateTimesheet" class="btn btn-dark btn-sm">+ Add Timesheet</a>
    </div>
</div>

<form method="get" action="/HR/Timesheet" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="id" class="form-control form-control-sm" placeholder="ID" value="@ViewBag.IdFilter" />
    </div>
    <div class="col-auto">
        <input type="text" class="form-control form-control-sm" placeholder="Title" disabled />
    </div>
    <div class="col-auto">
        <select name="status" class="form-select form-select-sm">
            <option value="">Status</option>
            <option value="Draft" selected="@("Draft".Equals(ViewBag.StatusFilter))">Draft</option>
            <option value="Submitted" selected="@("Submitted".Equals(ViewBag.StatusFilter))">Submitted</option>
            <option value="Approved" selected="@("Approved".Equals(ViewBag.StatusFilter))">Approved</option>
            <option value="Cancelled" selected="@("Cancelled".Equals(ViewBag.StatusFilter))">Cancelled</option>
        </select>
    </div>
    <div class="col-auto">
        <input type="text" name="employee" class="form-control form-control-sm" placeholder="Employee" value="@ViewBag.EmployeeFilter" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Filter</button>
    </div>
</form>

@if (Model != null && Model.Any())
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Status</th>
                <th>Employee</th>
                <th>Total Working Hours</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr style="cursor:pointer" onclick="window.location='/HR/TimesheetDetails/@s.Id'">
                    <td>@s.Id</td>
                    <td>@s.Series-@s.Id</td>
                    <td>@s.Status</td>
                    <td>@s.Employee</td>
                    <td>@s.TotalWorkingHours.ToString("0.000")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="text-center py-5">
        <p class="text-muted mb-3">You haven't created a Timesheet yet</p>
        <a href="/HR/CreateTimesheet" class="btn btn-dark btn-sm">Create your first Timesheet</a>
    </div>
}
<partial name="_TimeAttendanceUi" />
