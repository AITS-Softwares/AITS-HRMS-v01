@model Erp_Aits.Models.EnergyPointRule
@{
    ViewBag.Title = "New Energy Point Rule";
}

<form asp-action="CreateEnergyPointRule" method="post" class="energy-point-ui energy-point-shell">
    <div class="energy-point-page-header d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0 d-inline">New Energy Point Rule</h4>
            <span class="badge bg-danger-subtle text-danger ms-2">Not Saved</span>
        </div>
        <button type="submit" class="btn btn-dark btn-sm">Save</button>
    </div>

    <div class="energy-point-section p-3 mb-4">
    <div class="form-check">
        <input asp-for="Enabled" class="form-check-input" type="checkbox" />
        <label class="form-check-label" asp-for="Enabled">Enabled</label>
    </div>
    </div>

    <div class="energy-point-section p-4"><div class="row g-4">
        <div class="col-md-6">
            <div class="mb-3">
                <label class="form-label">Rule Name <span class="text-danger">*</span></label>
                <input asp-for="RuleName" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Reference Document Type <span class="text-danger">*</span></label>
                <select asp-for="ReferenceDocumentType" id="ReferenceDocumentType" class="form-select" required>
                    <option value="">Select Reference Document Type</option>
                    @if (ViewBag.DocTypes != null)
                    {
                        foreach (var item in ViewBag.DocTypes)
                        {
                            <option value="@item.name">@item.name</option>
                        }
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">For Document Event</label>
                <select asp-for="ForDocumentEvent" class="form-select">
                    <option value="Custom">Custom</option>
                    <option value="New">New</option>
                    <option value="Submit">Submit</option>
                    <option value="Cancel">Cancel</option>
                    <option value="Value Change">Value Change</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Field To Check</label>
                <select asp-for="FieldToCheck" id="FieldToCheck" class="form-select" data-selected="@Model.FieldToCheck">
                    <option value="">Select field after choosing a document type</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Points <span class="text-danger">*</span></label>
                <input asp-for="Points" type="number" class="form-control" required />
            </div>

            <div class="form-check mb-2">
                <input asp-for="AllotPointsToAssignedUsers" class="form-check-input" type="checkbox" />
                <label class="form-check-label" asp-for="AllotPointsToAssignedUsers">Allot Points To Assigned Users</label>
            </div>

            <p class="text-muted small mb-3">Users assigned to the reference document will get points.</p>

            <div class="mb-3">
                <label class="form-label">User Field</label>
                <select asp-for="UserField" id="UserField" class="form-select" data-selected="@Model.UserField">
                    <option value="">Select field after choosing a document type</option>
                </select>
                <div class="form-text">The user from this field will be rewarded points</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Multiplier Field</label>
                <select asp-for="MultiplierField" class="form-select" id="MultiplierField" data-selected="@Model.MultiplierField">
                    <option value="">Select numeric field after choosing a document type</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Maximum Points</label>
                <input asp-for="MaxPoints" type="number" class="form-control" />
            </div>
        </div>

        <div class="col-md-6">
            <div class="form-check mb-3">
                <input asp-for="ApplyOnlyOnce" class="form-check-input" type="checkbox" />
                <label class="form-check-label" asp-for="ApplyOnlyOnce">Apply Only Once</label>
            </div>

            <p class="text-muted small mb-3">Apply this rule only once per document</p>

            <label class="form-label">Condition</label>
            <textarea asp-for="Condition" class="form-control" rows="12" style="font-family: monospace;"></textarea>
            <div class="form-text mb-2">
                If the condition is satisfied user will be rewarded with the points. eg. doc.status == 'Closed'
            </div>
        </div>
    </div></div>
</form>

<partial name="_EnergyPointUi" />

<script>
    const referenceDocumentType = document.getElementById('ReferenceDocumentType');
    const ruleFieldToCheck = document.getElementById('FieldToCheck');
    const ruleUserField = document.getElementById('UserField');
    const ruleMultiplierField = document.getElementById('MultiplierField');

    function populateRuleFieldOptions(select, fields, placeholder, numericOnly) {
        const selected = select.dataset.selected || select.value || '';
        select.innerHTML = '<option value="">' + placeholder + '</option>';

        fields.filter(function (field) {
            return !numericOnly || field.isNumeric;
        }).forEach(function (field) {
            const option = document.createElement('option');
            option.value = field.value;
            option.textContent = field.text;
            option.selected = field.value === selected;
            select.appendChild(option);
        });

        if (selected && select.value !== selected) {
            const existingOption = document.createElement('option');
            existingOption.value = selected;
            existingOption.textContent = selected;
            existingOption.selected = true;
            select.appendChild(existingOption);
        }

        select.dataset.selected = '';
    }

    async function loadEnergyPointRuleFields() {
        const doctype = referenceDocumentType.value;
        const selects = [ruleFieldToCheck, ruleUserField, ruleMultiplierField];

        if (!doctype) {
            selects.forEach(function (select) { select.selectedIndex = 0; });
            return;
        }

        try {
            const response = await fetch('@Url.Action("GetEnergyPointRuleDocFields", "HR")?doctype=' + encodeURIComponent(doctype));
            if (!response.ok) throw new Error('Unable to load fields.');

            const fields = await response.json();
            populateRuleFieldOptions(ruleFieldToCheck, fields, 'Select field', false);
            populateRuleFieldOptions(ruleUserField, fields, 'Select user field', false);
            populateRuleFieldOptions(ruleMultiplierField, fields, 'Select numeric multiplier field', true);
        } catch (error) {
            console.error(error);
        }
    }

    referenceDocumentType.addEventListener('change', function () {
        ruleFieldToCheck.dataset.selected = '';
        ruleUserField.dataset.selected = '';
        ruleMultiplierField.dataset.selected = '';
        loadEnergyPointRuleFields();
    });

    if (referenceDocumentType.value) loadEnergyPointRuleFields();
</script>
