@{ ViewBag.Title="New Payroll Period"; var companies=ViewBag.PayrollPeriodCompanies as List<string>??new List<string>(); }
<style>
.payroll-form{max-width:1210px;margin:0 auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.form-head{display:flex;align-items:center;justify-content:space-between;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.form-head h1{font-size:22px;margin:0}.save{border:0;background:#0f766e;border-radius:7px;padding:9px 17px;color:#fff;font-weight:650}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.section{padding:20px;border-bottom:1px solid #dbe3ec}.section h2{font-size:17px;margin:0 0 16px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.field label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.input,.select{box-sizing:border-box;width:100%;height:36px;border:1px solid #b8c7d7;border-radius:8px;padding:7px 10px;background:#fbfdff;font-size:14px}.table{width:100%;border-collapse:collapse;border:1px solid #d7e0e9;border-radius:8px;overflow:hidden}.table th,.table td{padding:10px;border-bottom:1px solid #e5e7eb;text-align:left;font-size:13px}.table th{background:#f4f8fc;color:#526375}.empty{text-align:center;color:#64748b;height:54px}.search-select{position:relative}.search-menu{display:none;position:fixed;z-index:3000;max-height:260px;overflow:auto;background:#fff;border:1px solid #94a3b8;border-radius:6px;box-shadow:0 10px 20px rgba(15,23,42,.18)}.search-menu button{display:block;width:100%;padding:8px 10px;border:0;background:#fff;color:#172033;text-align:left}.search-menu button:hover{background:#e8f3f3;color:#0f766e}@@media(max-width:800px){.grid{grid-template-columns:1fr}.payroll-form{padding:12px}}
</style>
<div class="payroll-form"><form method="post" asp-action="CreatePayrollPeriod">@Html.AntiForgeryToken()<header class="form-head"><h1>New Payroll Period</h1><button type="submit" class="save">Save</button></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}<main class="card"><section class="section"><div class="grid"><div class="field"><label>Company *</label><select class="select searchable" name="Company" required><option value="">Select company</option>@foreach(var option in companies){<option value="@option">@option</option>}</select></div><div class="field"><label>Start Date *</label><input class="input" name="StartDate" type="date" required/></div><div class="field"><label>End Date *</label><input class="input" name="EndDate" type="date" required/></div></div></section><section class="section"><h2>Payroll Periods</h2><table class="table"><thead><tr><th>Payroll Periods</th></tr></thead><tbody><tr><td class="empty">Payroll periods are maintained by ERPNext after the record is created.</td></tr></tbody></table></section></main></form></div>
<script>document.querySelectorAll('select.searchable').forEach(select=>{if(select.options.length<=11)return;const wrap=document.createElement('div'),input=document.createElement('input'),menu=document.createElement('div');wrap.className='search-select';input.className='input';input.placeholder='Type to search';menu.className='search-menu';select.parentNode.insertBefore(wrap,select);wrap.append(input,select,menu);select.style.display='none';const draw=()=>{const q=input.value.toLowerCase(),items=[...select.options].filter(x=>x.value&&x.text.toLowerCase().startsWith(q)).slice(0,10);menu.innerHTML='';items.forEach(x=>{const b=document.createElement('button');b.type='button';b.textContent=x.text;b.onclick=()=>{select.value=x.value;input.value=x.text;menu.style.display='none'};menu.appendChild(b)});const r=input.getBoundingClientRect();menu.style.width=r.width+'px';menu.style.left=r.left+'px';menu.style.top=r.bottom+'px';menu.style.display='block'};input.addEventListener('focus',draw);input.addEventListener('input',draw);document.addEventListener('click',e=>{if(!wrap.contains(e.target))menu.style.display='none'})});</script>
