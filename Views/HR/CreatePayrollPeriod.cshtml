@{ ViewBag.Title="New Payroll Period"; var companies=ViewBag.PayrollPeriodCompanies as List<string>??new List<string>(); }
<style>.payroll-form{max-width:1210px;margin:0 auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.form-head{display:flex;align-items:center;justify-content:space-between;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.form-head h1{font-size:22px;margin:0}.save{border:0;background:#0f766e;color:#fff;padding:9px 17px;border-radius:7px;font-weight:650}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.section{padding:20px;border-bottom:1px solid #dbe3ec}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.field label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.input,.select{box-sizing:border-box;width:100%;height:36px;border:1px solid #b8c7d7;border-radius:8px;padding:7px 10px;background:#fbfdff}.table{width:100%;border-collapse:collapse;border:1px solid #d7e0e9}.table th,.table td{padding:10px;border-bottom:1px solid #e5e7eb;text-align:left;font-size:13px}.empty{text-align:center;color:#64748b;height:54px}</style>
<div class="payroll-form"><form method="post" asp-action="CreatePayrollPeriod">@Html.AntiForgeryToken()<header class="form-head"><h1>New Payroll Period</h1><button type="submit" class="save">Save</button></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}<main class="card"><section class="section"><div class="grid"><div class="field"><label>Name *</label><input class="input" name="Name" required/></div><div class="field"><label>Company *</label><select class="select searchable" name="Company" required><option value="">Select company</option>@foreach(var option in companies){<option value="@option">@option</option>}</select></div><div class="field"><label>Start Date *</label><input class="input" name="StartDate" type="date" required/></div><div class="field"><label>End Date *</label><input class="input" name="EndDate" type="date" required/></div></div></section></main></form></div>
