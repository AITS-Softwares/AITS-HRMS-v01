@model Erp_Aits.Models.ActivityType
@{
    ViewBag.Title = "New Activity Type";
}
<form method="post" action="/HR/CreateActivityType">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0 d-inline-block me-2">New Activity Type</h4>
            <span class="badge bg-warning-subtle text-warning">Not Saved</span>
        </div>
        <div>
            <a href="/HR/ActivityCost" class="btn btn-outline-dark btn-sm">Activity Cost per Employee</a>
            <button type="submit" class="btn btn-dark btn-sm">Save</button>
        </div>
    </div>
    <div class="card p-4">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Activity Type *</label>
                <input name="Name" class="form-control" required autofocus />
            </div>
            <div class="col-md-6">
                <label class="form-label">Default Billing Rate (INR)</label>
                <input name="DefaultBillingRate" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Default Costing Rate (INR)</label>
                <input name="DefaultCostingRate" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check">
                    <input type="checkbox" name="Disabled" value="true" class="form-check-input" id="disabledCheck" />
                    <label class="form-check-label" for="disabledCheck">Disabled</label>
                </div>
            </div>
        </div>
    </div>
</form>
<partial name="_TimeAttendanceUi" />
