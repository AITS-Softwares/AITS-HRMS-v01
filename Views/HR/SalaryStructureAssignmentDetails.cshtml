@using Newtonsoft.Json.Linq
@{ ViewBag.Title="Salary Structure Assignment Details"; var doc=ViewBag.Document as JObject; string Value(string key)=>doc?[key]?.ToString()??"";var centers=doc?["payroll_cost_centers"] as JArray??new JArray(); }
<style>.payroll-form{max-width:1210px;margin:0 auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.head{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.head h1{font-size:22px;margin:0}.head a{color:#fff;text-decoration:none}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.section{padding:20px;border-bottom:1px solid #dbe3ec}.section h2{font-size:17px;margin:0 0 16px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.field label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.value{min-height:36px;box-sizing:border-box;border:1px solid #b8c7d7;border-radius:8px;padding:8px 10px;background:#fbfdff;color:#172033}.table{width:100%;border-collapse:collapse;border:1px solid #d7e0e9;border-radius:8px;overflow:hidden}.table th,.table td{padding:10px;border-bottom:1px solid #e5e7eb;text-align:left;font-size:13px}.table th{background:#f4f8fc;color:#526375}.empty{text-align:center;color:#64748b;height:54px}@@media(max-width:800px){.payroll-form{padding:12px}.grid{grid-template-columns:1fr}.section{overflow:auto}.table{min-width:600px}}</style>
<div class="payroll-form"><header class="head"><h1>@(Value("name")==""?"Salary Structure Assignment":Value("name"))</h1><a asp-action="SalaryStructureAssignment">Back to Salary Structure Assignments</a></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}@if(doc!=null){<main class="card"><section class="section"><div class="grid"><div class="field"><label>Employee</label><div class="value">@Value("employee")</div></div><div class="field"><label>Employee Name</label><div class="value">@Value("employee_name")</div></div><div class="field"><label>Department</label><div class="value">@Value("department")</div></div><div class="field"><label>Designation</label><div class="value">@Value("designation")</div></div><div class="field"><label>Grade</label><div class="value">@Value("grade")</div></div><div class="field"><label>Salary Structure</label><div class="value">@Value("salary_structure")</div></div><div class="field"><label>From Date</label><div class="value">@Value("from_date")</div></div><div class="field"><label>Income Tax Slab</label><div class="value">@Value("income_tax_slab")</div></div><div class="field"><label>Company</label><div class="value">@Value("company")</div></div><div class="field"><label>Payroll Payable Account</label><div class="value">@Value("payroll_payable_account")</div></div><div class="field"><label>Currency</label><div class="value">@Value("currency")</div></div></div></section><section class="section"><h2>Base, Variable &amp; Leave Encashment</h2><div class="grid"><div class="field"><label>Base</label><div class="value">@Value("base")</div></div><div class="field"><label>Variable</label><div class="value">@Value("variable")</div></div><div class="field"><label>Leave Encashment Amount Per Day</label><div class="value">@Value("leave_encashment_amount_per_day")</div></div></div></section><section class="section"><h2>Opening Balances</h2><div class="grid"><div class="field"><label>Taxable Earnings Till Date</label><div class="value">@Value("taxable_earnings_till_date")</div></div><div class="field"><label>Tax Deducted Till Date</label><div class="value">@Value("tax_deducted_till_date")</div></div></div></section><section class="section"><h2>Payroll Cost Centers</h2><table class="table"><thead><tr><th>Cost Center</th><th>Percentage</th></tr></thead><tbody>@if(centers.Any()){foreach(var row in centers){<tr><td>@row["cost_center"]</td><td>@row["percentage"]</td></tr>}}else{<tr><td colspan="2" class="empty">No cost centers configured.</td></tr>}</tbody></table></section></main>}</div>
