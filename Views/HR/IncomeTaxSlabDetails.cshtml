@using Newtonsoft.Json.Linq
@{
 ViewBag.Title = "Income Tax Slab Details";
 var doc = ViewBag.Document as JObject;
 string V(string key) => doc?[key]?.ToString() ?? "";
 bool B(string key) => doc?[key]?.Value<int>() == 1;
 var status = doc?["docstatus"]?.Value<int>() ?? -1;
 var slabs = doc?["slabs"] as JArray ?? new JArray();
 var charges = doc?["other_taxes_and_charges"] as JArray ?? new JArray();
 var companies = ViewBag.IncomeTaxSlabCompanies as List<string> ?? new();
 var currencies = ViewBag.IncomeTaxSlabCurrencies as List<string> ?? new();
}
<style>
 .slab-page{max-width:1210px;margin:auto;padding:28px;background:#f1fbfd;border:1px solid #cbe5ed;border-radius:10px}.slab-head{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:23px 27px;background:linear-gradient(110deg,#17486c,#008d88);color:#fff;border-radius:9px;box-shadow:0 14px 26px rgba(13,83,104,.16)}.slab-head h1{margin:0;font-size:24px;font-weight:750}.slab-actions{display:flex;gap:10px;align-items:center}.slab-actions>a{color:#0b5065;background:#fff;text-decoration:none;padding:10px 14px;border-radius:7px;font-weight:700}.slab-actions button,.slab-add{border:0;border-radius:6px;padding:9px 15px}.slab-actions button{background:#fff;color:#0b5065;font-weight:700}.slab-create{position:relative}.slab-create summary{cursor:pointer;list-style:none;background:#fff;color:#0b5065;border-radius:7px;padding:10px 15px;font-weight:700}.slab-create summary::-webkit-details-marker{display:none}.slab-create summary::after{content:' ▾'}.slab-create-menu{position:absolute;right:0;top:calc(100% + 6px);z-index:20;min-width:220px;background:#fff;border-radius:7px;box-shadow:0 10px 24px rgba(15,23,42,.22);padding:6px}.slab-actions .slab-create-menu a{display:block;color:#17486c;text-decoration:none;padding:9px 10px;border-radius:5px;white-space:nowrap}.slab-actions .slab-create-menu a:hover{background:#e8f7f7;color:#008d88}.slab-card{margin-top:20px;background:#fff;border:1px solid #c9e1e9;border-radius:9px;overflow:hidden;box-shadow:0 8px 22px rgba(26,85,107,.06)}.slab-section{padding:21px 22px;border-bottom:1px solid #d8ebf0}.slab-section h2{font-size:17px;color:#17486c;margin:0 0 14px;font-weight:750}.slab-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.slab-field label{display:block;font-size:13px;color:#24546a;margin-bottom:7px;font-weight:650}.slab-field input,.slab-field select,.slab-table input{width:100%;box-sizing:border-box;height:38px;border:1px solid #b8d6df;border-radius:7px;padding:8px 10px;background:#fbfeff}.slab-field input:focus,.slab-field select:focus,.slab-table input:focus{outline:0;border-color:#008d88;box-shadow:0 0 0 3px rgba(0,141,136,.12)}.slab-table{width:100%;border-collapse:separate;border-spacing:0;border:1px solid #cfe4ea;border-radius:8px;overflow:hidden}.slab-table th,.slab-table td{padding:9px 10px;border-bottom:1px solid #e2eff2;border-right:1px solid #e2eff2}.slab-table th:last-child,.slab-table td:last-child{border-right:0}.slab-table tr:last-child td{border-bottom:0}.slab-table th{background:#e7f5f8;color:#17486c;font-size:13px;text-align:left}.slab-add{margin-top:11px;background:#dff3f2;color:#075d66;font-weight:650}fieldset{border:0;padding:0;margin:0}@@media(max-width:800px){.slab-page{padding:12px}.slab-grid{grid-template-columns:1fr}.slab-head{flex-wrap:wrap}.slab-section{overflow:auto}.slab-table{min-width:650px}}
</style>
<div class="slab-page">
 @if(TempData["ErpNextError"] != null){<div class="alert alert-danger">@TempData["ErpNextError"]</div>}
 @if(TempData["Success"] != null){<div class="alert alert-success">@TempData["Success"]</div>}
 @if(doc != null){
 <header class="slab-head"><div><h1>@V("name")</h1><span>@(status == 0 ? "Draft" : status == 1 ? "Submitted" : "Cancelled")</span></div><div class="slab-actions"><a asp-action="IncomeTaxSlab">Back to Income Tax Slabs</a>@if(status == 0){<button type="submit" form="slabForm" id="saveButton" hidden>Save</button><button type="submit" form="statusForm" id="submitButton">Submit</button>}else if(status == 1){<a href="/HR/IncomeTaxSlabDetails/@Uri.EscapeDataString(V("name"))">Refresh</a><details class="slab-create"><summary>Create</summary><div class="slab-create-menu"><a href="/HR/CreateSalaryStructureAssignment?selectedIncomeTaxSlab=@Uri.EscapeDataString(V("name"))">Salary Structure Assignment</a></div></details>}</div></header>
 <form id="slabForm" method="post" asp-action="UpdateIncomeTaxSlab" asp-route-id="@V("name")">@Html.AntiForgeryToken()<main class="slab-card"><fieldset disabled="@(status != 0)">
 <section class="slab-section"><div class="slab-grid"><div class="slab-field"><label>Name</label><input value="@V("name")" readonly /></div><label><input type="checkbox" name="Disabled" checked="@B("disabled")" /> Disabled</label>
 <div class="slab-field"><label>Effective From *</label><input type="date" name="EffectiveFrom" value="@V("effective_from")" required /></div><div class="slab-field"><label>Company</label><select name="Company"><option value="">Select company</option>@foreach(var x in companies){<option value="@x" selected="@(x == V("company"))">@x</option>}</select></div>
 <div class="slab-field"><label>Currency *</label><select name="Currency" required><option value="">Select currency</option>@foreach(var x in currencies){<option value="@x" selected="@(x == V("currency"))">@x</option>}</select></div><div class="slab-field"><label>Standard Tax Exemption Amount</label><input type="number" step="0.01" name="StandardTaxExemptionAmount" value="@V("standard_tax_exemption_amount")" /></div><label><input type="checkbox" name="AllowTaxExemption" checked="@B("allow_tax_exemption")" /> Allow Tax Exemption</label><div class="slab-field"><label>Amended From</label><input value="@V("amended_from")" readonly /></div></div></section>
 <section class="slab-section"><h2>Taxable Salary Slabs</h2><table class="slab-table"><thead><tr><th>From Amount</th><th>To Amount</th><th>Percent Deduction</th><th>Condition</th></tr></thead><tbody id="slabs">@foreach(var row in slabs){<tr><td><input name="FromAmounts" type="number" step="0.01" value="@row["from_amount"]" /></td><td><input name="ToAmounts" type="number" step="0.01" value="@row["to_amount"]" /></td><td><input name="PercentDeductions" type="number" step="0.01" value="@row["percent_deduction"]" /></td><td><input name="Conditions" value="@row["condition"]" /></td></tr>}</tbody></table>@if(status == 0){<button type="button" class="slab-add" id="addSlab">Add Row</button>}</section>
 <section class="slab-section"><div class="slab-grid"><div class="slab-field"><label>Taxable Income Relief Threshold Limit</label><input name="TaxReliefLimit" type="number" step="0.01" value="@V("tax_relief_limit")" /></div><div class="slab-field"><label>Marginal Relief Threshold Limit</label><input name="MarginalReliefLimit" type="number" step="0.01" value="@V("marginal_relief_limit")" /></div></div></section>
 <section class="slab-section"><h2>Taxes and Charges on Income Tax</h2><table class="slab-table"><thead><tr><th>Description</th><th>Percent</th><th>Min Taxable Income</th><th>Max Taxable Income</th></tr></thead><tbody id="charges">@foreach(var row in charges){<tr><td><input name="ChargeDescriptions" value="@row["description"]" /></td><td><input name="ChargePercents" type="number" step="0.01" value="@row["percent"]" /></td><td><input name="MinTaxableIncomes" type="number" step="0.01" value="@row["min_taxable_income"]" /></td><td><input name="MaxTaxableIncomes" type="number" step="0.01" value="@row["max_taxable_income"]" /></td></tr>}</tbody></table>@if(status == 0){<button type="button" class="slab-add" id="addCharge">Add Row</button>}</section>
 </fieldset></main></form>
 @if(status == 0){<form id="statusForm" method="post" asp-action="SetIncomeTaxSlabStatus" asp-route-id="@V("name")" asp-route-status="1">@Html.AntiForgeryToken()</form>}
 }
</div>
@if(status == 0){<script>
 (()=>{const form=document.getElementById('slabForm'),save=document.getElementById('saveButton'),submit=document.getElementById('submitButton');const dirty=()=>{save.hidden=false;submit.hidden=true};form.addEventListener('input',dirty);form.addEventListener('change',dirty);
 document.getElementById('addSlab').onclick=()=>{document.getElementById('slabs').insertAdjacentHTML('beforeend','<tr><td><input name="FromAmounts" type="number" step="0.01" value="0"></td><td><input name="ToAmounts" type="number" step="0.01"></td><td><input name="PercentDeductions" type="number" step="0.01" value="0"></td><td><input name="Conditions"></td></tr>');dirty()};
 document.getElementById('addCharge').onclick=()=>{document.getElementById('charges').insertAdjacentHTML('beforeend','<tr><td><input name="ChargeDescriptions"></td><td><input name="ChargePercents" type="number" step="0.01" value="0"></td><td><input name="MinTaxableIncomes" type="number" step="0.01"></td><td><input name="MaxTaxableIncomes" type="number" step="0.01"></td></tr>');dirty()};})();
</script>}
