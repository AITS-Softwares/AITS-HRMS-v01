@model List<Erp_Aits.Models.EmployeeOnboardingTemplate>

@{
    ViewBag.Title = "Employee Onboarding Template";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErpNextError"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

<div class="template-list-page">
<div class="template-list-page__header d-flex justify-content-between align-items-center mb-3">

    <div><div class="template-list-page__eyebrow">Employee Lifecycle</div><h4 class="mb-0 fw-bold">Employee Onboarding Template</h4></div>

    <div class="d-flex gap-2">
        <a href="@Url.Action("CreateEmployeeOnboardingTemplate", "HR")"
           class="btn template-list-page__add btn-sm px-4 fw-bold">
            <i class="fa-solid fa-plus"></i> Add Template
        </a>
    </div>

</div>

<form method="get"
      action="@Url.Action("EmployeeOnboardingTemplate", "HR")"
      class="template-list-page__filters row g-2 mb-3">

    <div class="col-auto">
        <input type="text"
               name="id"
               value="@ViewBag.IdFilter"
               class="form-control form-control-sm"
               placeholder="ID" />
    </div>

    <div class="col-auto">
        <input type="text"
               name="title"
               value="@ViewBag.TitleFilter"
               class="form-control form-control-sm"
               placeholder="Title" />
    </div>

    <div class="col-auto">
        <button type="submit"
                class="btn template-list-page__search btn-sm">
            <i class="fa-solid fa-magnifying-glass"></i> Search
        </button>
    </div>

    <div class="col-auto">
        <a href="@Url.Action("EmployeeOnboardingTemplate", "HR")"
           class="btn btn-sm btn-outline-secondary">
            Clear
        </a>
    </div>

</form>

<div class="template-list-page__table card border rounded-3 p-4 shadow-sm bg-white">

    <div class="table-responsive">

        <table class="table table-hover align-middle mb-0">

            <thead class="table-light">
                <tr>
                    <th style="width:80px;"
                        class="text-muted small">
                        ID
                    </th>

                    <th class="text-muted small">
                        ERPNext Ref
                    </th>

                    <th class="text-muted small">
                        Title
                    </th>

                    <th class="text-muted small">
                        Company
                    </th>

                    <th class="text-muted small">
                        Department
                    </th>

                    <th class="text-muted small">
                        Designation
                    </th>

                    <th class="text-muted small">
                        Employee Grade
                    </th>

                    <th style="width:100px;"
                        class="text-center text-muted small">
                        Action
                    </th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var t in Model)
                    {
                        <tr style="cursor:pointer"
                            onclick="window.location='@Url.Action("EmployeeOnboardingTemplateDetails", "HR", new { id = t.Id })'">

                            <td>
                                <strong>@t.Id</strong>
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(t.ErpNextId))
                                {
                                    <span class="badge bg-success-subtle text-success">
                                        @t.ErpNextId
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-muted">
                                        Not Synced
                                    </span>
                                }
                            </td>

                            <td>
                                <span class="fw-semibold">
                                    @t.Title
                                </span>
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(t.Company) ? "-" : t.Company)
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(t.Department) ? "-" : t.Department)
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(t.Designation) ? "-" : t.Designation)
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(t.EmployeeGrade) ? "-" : t.EmployeeGrade)
                            </td>

                            <td class="text-center">
                                <a href="@Url.Action("EmployeeOnboardingTemplateDetails", "HR", new { id = t.Id })"
                                   class="btn btn-sm btn-outline-dark"
                                   onclick="event.stopPropagation();">
                                    View
                                </a>
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8"
                            class="text-center text-muted py-5">
                            No Employee Onboarding Templates Found
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>
</div>
<style>
 .template-list-page{background:linear-gradient(135deg,#eef7fb,#f7fbfa 65%,#edf3fb);border:1px solid #d5e5ee;border-radius:8px;padding:24px;color:#183247}.template-list-page__header{background:#15324b;color:#fff;border-radius:8px;padding:19px 21px;box-shadow:0 12px 26px rgba(21,50,75,.16)}.template-list-page__eyebrow{color:#a8d6e5;font-size:12px;font-weight:700;text-transform:uppercase;margin-bottom:4px}.template-list-page__add{background:#0f877d;border:0;color:#fff}.template-list-page__add i,.template-list-page__search i{margin-right:5px}.template-list-page__filters{margin:16px 0!important;padding:14px;background:#dfeff6;border:1px solid #c4dce8;border-radius:8px}.template-list-page__filters .form-control{border-color:#a9cadb}.template-list-page__search{background:#fff;color:#15324b;border:1px solid #1d6fa5;font-weight:700}.template-list-page__table{border-color:#cfe0eb!important;box-shadow:none!important}.template-list-page__table thead th{background:#e7f4f9!important;color:#15324b}.template-list-page__table tbody tr:hover{background:#edf9f7}
</style>
