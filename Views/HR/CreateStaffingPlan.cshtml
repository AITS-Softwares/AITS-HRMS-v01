@model Erp_Aits.Models.StaffingPlan
@{
    var isEdit = ViewBag.IsEdit == true;
    var isDraft = Model.DocStatus == 0;
    var isLocked = isEdit && !isDraft;
    ViewBag.Title = isEdit ? "Staffing Plan Details" : "New Staffing Plan";
}

<select id="staffingDesignationOptions" class="d-none"><option value="">Select designation...</option>@foreach (var item in ViewBag.Designations) { <option value="@item.name">@item.name</option> }</select>

<form asp-action="@(isEdit ? "UpdateStaffingPlan" : "CreateStaffingPlan")" method="post" id="staffingForm">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" /><input type="hidden" asp-for="ErpNextId" /><input type="hidden" asp-for="DocStatus" />
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">@(isEdit ? "Staffing Plan Details" : "New Staffing Plan")</h4>
        <div class="d-flex gap-2">
            @if (!isEdit) { <button type="submit" class="btn btn-dark btn-sm">Save</button> }
            else { <a href="@Url.Action("StaffingPlan", "HR")" class="btn btn-outline-secondary btn-sm">Back to List</a>
                @if (isDraft) { <button type="submit" formaction="@Url.Action("ChangeStaffingPlanStatus", "HR", new { id = Model.Id, status = 1 })" class="btn btn-success btn-sm">Submit</button> }
                else if (Model.DocStatus == 1) { <button type="submit" formaction="@Url.Action("ChangeStaffingPlanStatus", "HR", new { id = Model.Id, status = 2 })" class="btn btn-danger btn-sm">Cancel</button> }
            }
        </div>
    </div>
    <fieldset @(isLocked ? "disabled" : null)>

    <div class="card p-4 mb-3">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Name *</label>
                <input asp-for="Name" class="form-control" required autofocus />
            </div>
            <div class="col-md-6">
                <label class="form-label">From Date *</label>
                <input asp-for="FromDate" type="date" class="form-control" required value="@Model.FromDate.ToString("yyyy-MM-dd")" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Company *</label>
                <select asp-for="Company" id="staffingCompany" class="form-select" required><option value="">Select company...</option>@foreach (var item in ViewBag.Companies) { <option value="@item.name">@item.name</option> }</select>
            </div>
            <div class="col-md-6">
                <label class="form-label">To Date *</label>
                <input asp-for="ToDate" type="date" class="form-control" required value="@Model.ToDate.ToString("yyyy-MM-dd")" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Department</label>
                <select asp-for="Department" id="staffingDepartment" class="form-select"><option value="">Select department...</option>@foreach (var item in ViewBag.Departments) { <option value="@item.name">@item.name</option> }</select>
            </div>
        </div>
    </div>

    <div class="card p-4 mb-3">
        <h6 class="mb-3">Details</h6>
        <button type="button" class="btn btn-sm btn-outline-secondary mb-3" data-bs-toggle="modal" data-bs-target="#jobReqModal">
            Get Job Requisitions
        </button>

        <label class="form-label">Staffing Details</label>
        <table class="table table-bordered align-middle mb-1" id="staffingTable">
            <thead>
                <tr>
                    <th style="width:40px"><input type="checkbox" disabled /></th>
                    <th style="width:60px">No.</th>
                    <th>Designation *</th>
                    <th>Vacancies</th>
                    <th>Estimated Cost Per Position</th>
                    <th>Total Estimated Cost</th>
                    <th>Number Of Positions</th>
                    <th style="width:50px"></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addStaffingRow()">+ Add Row</button>
    </div>

    <div class="card p-4">
        <label class="form-label">Total Estimated Budget</label>
        <input type="text" id="totalBudgetDisplay" class="form-control" value="₹ 0.00" disabled />
    </div>
</fieldset></form>

<!-- Select Job Requisition Modal -->
<div class="modal fade" id="jobReqModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Select Job Requisition</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-2 mb-3">
                    <div class="col-md-4">
                        <label class="form-label small">Name</label>
                        <input type="text" id="filterName" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small">Designation</label>
                        <input type="text" id="filterDesignation" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small">Requested By</label>
                        <input type="text" id="filterRequestedBy" class="form-control form-control-sm" />
                    </div>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary mb-3" onclick="searchJobRequisitions()">Search</button>

                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th style="width:40px"></th>
                            <th>Name</th>
                            <th>Designation</th>
                            <th>Requested By</th>
                        </tr>
                    </thead>
                    <tbody id="jobReqResultsBody">
                        <tr><td colspan="4" class="text-center text-muted py-3">No filters selected</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer justify-content-between">
                <a href="@Url.Action("CreateJobRequisition", "HR")" class="btn btn-light btn-sm">Make Job Requisition</a>
                <button type="button" class="btn btn-dark btn-sm" onclick="getSelectedItems()">Get Items</button>
            </div>
        </div>
    </div>
</div>

<script>
    var rowIndex = 0;
    var existingDetails = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Details));

    function addStaffingRow(designation) {
        var tbody = document.getElementById('staffingTable').querySelector('tbody');
        var i = rowIndex++;

        var row = document.createElement('tr');
        var designationOptions = document.getElementById('staffingDesignationOptions').innerHTML;
        row.innerHTML = `
            <td><input type="checkbox" /></td>
            <td>${tbody.rows.length + 1}</td>
            <td><select name="Details[${i}].Designation" class="form-select form-select-sm border-0" onchange="refreshStaffingRow(this)">${designationOptions}</select></td>
            <td><input name="Details[${i}].Vacancies" type="number" class="form-control form-control-sm border-0 vacancies" value="0" oninput="recalcRow(this)" /></td>
            <td><input name="Details[${i}].EstimatedCostPerPosition" type="number" step="0.01" class="form-control form-control-sm border-0 costper" value="0" oninput="recalcRow(this)" /></td>
            <td><input name="Details[${i}].TotalEstimatedCost" type="number" step="0.01" class="form-control form-control-sm border-0 total" value="0" readonly /></td>
            <td><input name="Details[${i}].NumberOfPositions" type="number" class="form-control form-control-sm border-0 positions" value="0" readonly /></td>
            <td><i class="fas fa-pen text-muted" style="cursor:pointer"></i></td>
        `;
        tbody.appendChild(row);
        var designationSelect = row.querySelector('select');
        designationSelect.value = designation || '';
        refreshStaffingRow(designationSelect);
    }

    function recalcRow(el) {
        var row = el.closest('tr');
        var vac = parseFloat(row.querySelector('.vacancies').value) || 0;
        var cost = parseFloat(row.querySelector('.costper').value) || 0;
        var total = vac * cost;
        row.querySelector('.total').value = total.toFixed(2);
        recalcTotalBudget();
    }

    function recalcTotalBudget() {
        var totals = document.querySelectorAll('#staffingTable .total');
        var sum = 0;
        totals.forEach(t => sum += parseFloat(t.value) || 0);
        document.getElementById('totalBudgetDisplay').value = '₹ ' + sum.toFixed(2);
    }

    async function refreshStaffingRow(select) {
        var row = select.closest('tr');
        var designation = select.value;
        if (!designation) {
            row.querySelector('.positions').value = '0';
            return;
        }

        var company = document.getElementById('staffingCompany').value;
        var department = document.getElementById('staffingDepartment').value;
        var url = '@Url.Action("GetStaffingPlanPositionCount", "HR")'
            + '?designation=' + encodeURIComponent(designation)
            + '&company=' + encodeURIComponent(company)
            + '&department=' + encodeURIComponent(department);

        try {
            var response = await fetch(url);
            var data = await response.json();
            row.querySelector('.positions').value = data.count || 0;
        } catch {
            row.querySelector('.positions').value = '0';
        }
    }

    function refreshAllStaffingRows() {
        document.querySelectorAll('#staffingTable select[name$=".Designation"]').forEach(refreshStaffingRow);
    }

    document.getElementById('staffingCompany').addEventListener('change', refreshAllStaffingRows);
    document.getElementById('staffingDepartment').addEventListener('change', refreshAllStaffingRows);

    function searchJobRequisitions() {
        var name = document.getElementById('filterName').value;
        var designation = document.getElementById('filterDesignation').value;
        var requestedBy = document.getElementById('filterRequestedBy').value;

        var url = '@Url.Action("SearchJobRequisitions", "HR")' + '?name=' + encodeURIComponent(name)
            + '&designation=' + encodeURIComponent(designation)
            + '&requestedBy=' + encodeURIComponent(requestedBy);

        fetch(url)
            .then(res => res.json())
            .then(data => {
                var body = document.getElementById('jobReqResultsBody');
                body.innerHTML = '';

                if (data.length === 0) {
                    body.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-3">No results found</td></tr>';
                    return;
                }

                data.forEach(item => {
                    var row = document.createElement('tr');
                    row.innerHTML = `
                        <td><input type="checkbox" class="jobReqCheck" data-designation="${item.designation}" /></td>
                        <td>${item.name}</td>
                        <td>${item.designation}</td>
                        <td>${item.requestedBy}</td>
                    `;
                    body.appendChild(row);
                });
            });
    }

    function getSelectedItems() {
        var checks = document.querySelectorAll('.jobReqCheck:checked');
        checks.forEach(c => {
            addStaffingRow(c.getAttribute('data-designation'));
        });
        var modalEl = document.getElementById('jobReqModal');
        var modal = bootstrap.Modal.getInstance(modalEl);
        modal.hide();
    }

    existingDetails.forEach(detail => {
        addStaffingRow(detail.Designation);
        var row = document.querySelector('#staffingTable tbody').lastElementChild;
        row.querySelector('.vacancies').value = detail.Vacancies;
        row.querySelector('.costper').value = detail.EstimatedCostPerPosition;
        row.querySelector('.positions').value = detail.NumberOfPositions;
        recalcRow(row.querySelector('.vacancies'));
    });
</script>
