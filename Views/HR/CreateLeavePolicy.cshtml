@model Erp_Aits.Models.LeavePolicy
@{
    ViewBag.Title = "New Leave Policy";
    var leaveTypes = ViewBag.LeaveTypes as List<Erp_Aits.Models.LeaveType> ?? new List<Erp_Aits.Models.LeaveType>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">New Leave Policy</h4>
</div>

<form asp-controller="HR" asp-action="CreateLeavePolicy" method="post">
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <label class="form-label">Policy Title <span class="text-danger">*</span></label>
            <input type="text" name="Title" class="form-control" value="@Model?.Title" required placeholder="e.g. Standard Leave Policy" />
        </div>
    </div>

    <hr />
    <h6 class="mb-2">Leave Allocations</h6>

    <table class="table table-bordered align-middle" id="detailsTable">
        <thead>
            <tr>
                <th>Leave Type</th>
                <th>Annual Allocation</th>
            </tr>
        </thead>
        <tbody>
            @if (Model?.Details != null && Model.Details.Any())
            {
                for (int i = 0; i < Model.Details.Count; i++)
                {
                    <tr>
                        <td>
                            <select name="Details[@i].LeaveType" class="form-select" required>
                                <option value="">-- Select Leave Type --</option>
                                @if (!string.IsNullOrWhiteSpace(Model.Details[i].LeaveType) && !leaveTypes.Any(lt => lt.LeaveTypeName == Model.Details[i].LeaveType))
                                {
                                    <option value="@Model.Details[i].LeaveType" selected>@Model.Details[i].LeaveType</option>
                                }
                                @foreach (var leaveType in leaveTypes)
                                {
                                    <option value="@leaveType.LeaveTypeName" selected="@(Model.Details[i].LeaveType == leaveType.LeaveTypeName)">
                                        @leaveType.LeaveTypeName
                                    </option>
                                }
                            </select>
                        </td>
                        <td>
                            <input type="number" step="0.01" name="Details[@i].AnnualAllocation" class="form-control" value="@Model.Details[i].AnnualAllocation" required />
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td>
                        <select name="Details[0].LeaveType" class="form-select" required>
                            <option value="">-- Select Leave Type --</option>
                            @foreach (var leaveType in leaveTypes)
                            {
                                <option value="@leaveType.LeaveTypeName">@leaveType.LeaveTypeName</option>
                            }
                        </select>
                    </td>
                    <td>
                        <input type="number" step="0.01" name="Details[0].AnnualAllocation" class="form-control" value="0" required />
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button type="submit" class="btn btn-dark mt-3">Save Leave Policy</button>
</form>
