@model Erp_Aits.Models.AppointmentLetter
@{
    ViewBag.Title = "New Appointment Letter";
    var applicants = ViewBag.AppointmentApplicants as Newtonsoft.Json.Linq.JArray ?? new Newtonsoft.Json.Linq.JArray();
    var companies = ViewBag.AppointmentCompanies as Newtonsoft.Json.Linq.JArray ?? new Newtonsoft.Json.Linq.JArray();
    var templates = ViewBag.AppointmentTemplates as Newtonsoft.Json.Linq.JArray ?? new Newtonsoft.Json.Linq.JArray();
    var formAction = Model.Id > 0 ? "UpdateAppointmentLetter" : "CreateAppointmentLetter";
}

<form asp-action="@formAction" method="post">
    <input asp-for="Id" type="hidden" />
    <input asp-for="ErpNextId" type="hidden" />
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">@(Model.Id > 0 ? "Edit Appointment Letter" : "New Appointment Letter")</h4>
        <button type="submit" class="btn btn-dark btn-sm">Save</button>
    </div>

    <div class="card p-4 mb-3">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Job Applicant *</label>
                <select asp-for="JobApplicant" class="form-select" id="appointmentApplicant" required>
                    <option value="">Select Job Applicant</option>
                    @foreach (var item in applicants) { var name = item["name"]?.ToString() ?? ""; var label = item["applicant_name"]?.ToString() ?? name; <option value="@name" data-name="@label">@label (@name)</option> }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Company *</label>
                <select asp-for="Company" class="form-select" required><option value="">Select Company</option>@foreach (var item in companies) { var name = item["name"]?.ToString() ?? ""; <option value="@name">@name</option> }</select>
            </div>
            <div class="col-md-6"><label class="form-label">Applicant Name</label><input asp-for="ApplicantName" id="appointmentApplicantName" class="form-control" readonly /></div>
            <div class="col-md-6">
                <label class="form-label">Appointment Date *</label>
                <input asp-for="AppointmentDate" type="date" class="form-control" required />
            </div>
            <div class="col-md-6"></div>
            <div class="col-md-6">
                <label class="form-label">Appointment Letter Template *</label>
                <select asp-for="AppointmentLetterTemplate" class="form-select" required><option value="">Select Appointment Letter Template</option>@foreach (var item in templates) { var name = item["name"]?.ToString() ?? ""; var label = item["template_name"]?.ToString() ?? name; <option value="@name">@label</option> }</select>
            </div>
        </div>
    </div>

    <div class="card p-4">
        <h6 class="mb-3">Body</h6>
        <div class="row g-3">
            <div class="col-md-12">
                <label class="form-label">Introduction *</label>
                <textarea asp-for="Introduction" class="form-control" rows="8" required></textarea>
            </div>

            <div class="col-md-12">
                <label class="form-label">Terms</label>
                <table class="table table-bordered" id="termsTable">
                    <thead>
                        <tr>
                            <th style="width:60px;">No.</th>
                            <th>Title *</th>
                            <th>Description *</th>
                            <th style="width:50px;"></th>
                        </tr>
                    </thead>
                    <tbody id="termsBody">
                        @for (var i = 0; i < Model.Terms.Count; i++) { <tr><td>@(i + 1)</td><td><input name="Terms[@i].Title" class="form-control form-control-sm" value="@Model.Terms[i].Title" required /></td><td><input name="Terms[@i].Description" class="form-control form-control-sm" value="@Model.Terms[i].Description" required /></td><td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove()">&times;</button></td></tr> }
                    </tbody>
                </table>
                <button type="button" class="btn btn-sm btn-outline-dark mb-3" onclick="addTermRow()">Add Row</button>
            </div>

            <div class="col-md-12">
                <label class="form-label">Closing Notes</label>
                <textarea asp-for="ClosingNotes" class="form-control" rows="8"></textarea>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        let termIdx = @Model.Terms.Count;

        function addTermRow() {
            const i = termIdx++;
            const row = `<tr>
                <td>${i + 1}</td>
                <td><input name="Terms[${i}].Title" class="form-control form-control-sm" required /></td>
                <td><input name="Terms[${i}].Description" class="form-control form-control-sm" required /></td>
                <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove()">&times;</button></td>
            </tr>`;
            document.getElementById('termsBody').insertAdjacentHTML('beforeend', row);
        }

        if (!document.querySelector('#termsBody tr')) addTermRow();
        document.getElementById('appointmentApplicant').addEventListener('change', function () {
            document.getElementById('appointmentApplicantName').value = this.options[this.selectedIndex]?.dataset.name || '';
        });
    </script>
}
