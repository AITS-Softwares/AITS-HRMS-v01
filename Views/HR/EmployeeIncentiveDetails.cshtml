@using Newtonsoft.Json.Linq
@{ViewBag.Title="Employee Incentive Details";var doc=ViewBag.Document as JObject;string Value(string key)=>doc?[key]?.ToString()??"";}
<style>.payroll-form{max-width:1210px;margin:0 auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.head{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.head h1{font-size:22px;margin:0}.head a{color:#fff;text-decoration:none}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.section{padding:20px;border-bottom:1px solid #dbe3ec}.section h2{font-size:17px;margin:0 0 16px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.field label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.value{min-height:36px;box-sizing:border-box;border:1px solid #b8c7d7;border-radius:8px;padding:8px 10px;background:#fbfdff;color:#172033}@@media(max-width:800px){.payroll-form{padding:12px}.grid{grid-template-columns:1fr}}</style>
<div class="payroll-form"><header class="head"><h1>@(Value("name")==""?"Employee Incentive":Value("name"))</h1><a asp-action="EmployeeIncentive">Back to Employee Incentive</a></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}@if(doc!=null){<main class="card"><section class="section"><h2>Employee</h2><div class="grid"><div class="field"><label>Employee</label><div class="value">@Value("employee")</div></div><div class="field"><label>Employee Name</label><div class="value">@Value("employee_name")</div></div><div class="field"><label>Company</label><div class="value">@Value("company")</div></div><div class="field"><label>Department</label><div class="value">@Value("department")</div></div><div class="field"><label>Amended From</label><div class="value">@Value("amended_from")</div></div></div></section><section class="section"><h2>Incentive</h2><div class="grid"><div class="field"><label>Salary Component</label><div class="value">@Value("salary_component")</div></div><div class="field"><label>Currency</label><div class="value">@Value("currency")</div></div><div class="field"><label>Payroll Date</label><div class="value">@Value("payroll_date")</div></div><div class="field"><label>Incentive Amount</label><div class="value">@Value("incentive_amount")</div></div></div></section></main>}</div>
