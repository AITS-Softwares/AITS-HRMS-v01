@{ViewBag.Title="New Employee Tax Exemption Category";}
<style>.p{max-width:1210px;margin:auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.h{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.h h1{margin:0;font-size:22px}.save{border:0;background:#0f766e;color:#fff;padding:9px 17px;border-radius:7px;font-weight:650}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px}.s{padding:20px}.g{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.f label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.i{box-sizing:border-box;width:100%;height:36px;border:1px solid #b8c7d7;border-radius:8px;padding:7px 10px;background:#fbfdff}.check{display:flex;align-items:center;gap:8px;padding-top:24px}@@media(max-width:800px){.p{padding:12px}.g{grid-template-columns:1fr}}</style>
<div class="p"><form method="post" asp-action="CreateEmployeeTaxExemptionCategory">@Html.AntiForgeryToken()<header class="h"><h1>New Employee Tax Exemption Category</h1><button class="save">Save</button></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}<main class="card"><section class="s"><div class="g"><div class="f"><label>Max Exemption Amount</label><input name="MaxAmount" type="number" step="0.01" class="i"/></div><label class="check"><input name="IsActive" type="checkbox" checked/> Is Active</label></div></section></main></form></div>
