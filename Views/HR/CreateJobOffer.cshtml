@model Erp_Aits.Models.JobOffer

@{
    ViewBag.Title = "New Job Offer";
}

<form asp-action="CreateJobOffer" asp-controller="HR" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" name="returnToOnboarding" value="@ViewBag.ReturnToOnboarding" />

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">New Job Offer</h4>

        <button type="submit" class="btn btn-dark btn-sm px-4">
            Save
        </button>
    </div>

    <div class="card p-4 mb-3">
        <div class="row g-3">

            <div class="col-md-6">
                <label class="form-label">
                    Job Applicant <span class="text-danger">*</span>
                </label>

                <select asp-for="JobApplicant"
                        id="JobApplicant"
                        class="form-select"
                        required>
                    <option value="">-- Select Job Applicant --</option>

                    @if (ViewBag.JobApplicants != null)
                    {
                        foreach (var applicant in ViewBag.JobApplicants)
                        {
                            <option value="@applicant.name"
                                    data-applicant-name="@applicant.applicant_name">
                                @applicant.name - @applicant.applicant_name
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Applicant Name</label>

                <input asp-for="ApplicantName"
                       id="ApplicantName"
                       class="form-control"
                       readonly />
            </div>

            <div class="col-md-6">
                <label class="form-label">Status</label>

                <select asp-for="Status" class="form-select">
                    <option>Awaiting Response</option>
                    <option>Accepted</option>
                    <option>Rejected</option>
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">
                    Offer Date <span class="text-danger">*</span>
                </label>

                <input asp-for="OfferDate"
                       type="date"
                       class="form-control"
                       value="@Model.OfferDate.ToString("yyyy-MM-dd")"
                       required />
            </div>

            <div class="col-md-6">
                <label class="form-label">
                    Designation <span class="text-danger">*</span>
                </label>

                <select asp-for="Designation"
                        class="form-select"
                        required>
                    <option value="">-- Select Designation --</option>

                    @if (ViewBag.Designations != null)
                    {
                        foreach (var designation in ViewBag.Designations)
                        {
                            <option value="@designation.name">@designation.name</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">
                    Company <span class="text-danger">*</span>
                </label>

                <select asp-for="Company"
                        class="form-select"
                        required>
                    <option value="">-- Select Company --</option>

                    @if (ViewBag.Companies != null)
                    {
                        foreach (var company in ViewBag.Companies)
                        {
                            <option value="@company.name">@company.name</option>
                        }
                    }
                </select>
            </div>

        </div>
    </div>

    <div class="card p-4 mb-3">
        <label class="form-label">Job Offer Term Template</label>
        <input asp-for="JobOfferTermTemplate"
               class="form-control mb-3"
               placeholder="Enter Job Offer Term Template" />

        <label class="form-label">Job Offer Terms</label>

        <table class="table table-bordered align-middle mb-1" id="termsTable">
            <thead>
                <tr>
                    <th style="width:60px">No.</th>
                    <th>Offer Term *</th>
                    <th>Value / Description *</th>
                    <th style="width:60px"></th>
                </tr>
            </thead>

            <tbody></tbody>
        </table>

        <button type="button"
                class="btn btn-sm btn-outline-secondary"
                onclick="addTermRow()">
            + Add Row
        </button>
    </div>

    <div class="card p-4 mb-3">
        <label class="form-label">Select Terms and Conditions</label>

        <select asp-for="SelectTermsAndConditions"
                class="form-select mb-3">
            <option value="">-- Select Terms and Conditions --</option>

            @if (ViewBag.TermsAndConditions != null)
            {
                foreach (var terms in ViewBag.TermsAndConditions)
                {
                    <option value="@terms.name">
                        @terms.name
                    </option>
                }
            }
        </select>

        <label class="form-label">Terms and Conditions</label>

        <textarea asp-for="TermsAndConditions"
                  class="form-control"
                  rows="10"></textarea>
    </div>

    <div class="card p-4">
        <h6 class="mb-3">Printing Details</h6>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Letter Head</label>
                <input asp-for="LetterHead" class="form-control" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Print Heading</label>
                <input asp-for="PrintHeading" class="form-control" />
            </div>
        </div>
    </div>
</form>

<datalist id="OfferTermList">
    @if (ViewBag.OfferTerms != null)
    {
        foreach (var term in ViewBag.OfferTerms)
        {
            <option value="@term.name">@term.name</option>
        }
    }
</datalist>

<script>
    document.getElementById("JobApplicant").addEventListener("change", function () {
        const selected = this.options[this.selectedIndex];
        const applicantName = selected.getAttribute("data-applicant-name") || "";

        document.getElementById("ApplicantName").value = applicantName;
    });

    function addTermRow() {
        const tbody = document.getElementById("termsTable").querySelector("tbody");
        const rowNum = tbody.rows.length + 1;

        const row = document.createElement("tr");

        row.innerHTML = `
            <td>${rowNum}</td>

            <td>
                <input class="form-control form-control-sm"
                       name="OfferTerms"
                       list="OfferTermList"
                       placeholder="Select or type Offer Term"
                       required />
            </td>

            <td>
                <input class="form-control form-control-sm"
                       name="OfferTermValues"
                       placeholder="Value / Description"
                       required />
            </td>

            <td class="text-center">
                <button type="button"
                        class="btn btn-sm btn-outline-danger"
                        onclick="removeTermRow(this)">
                    ×
                </button>
            </td>
        `;

        tbody.appendChild(row);
        renumberTermRows();
    }

    function removeTermRow(button) {
        const row = button.closest("tr");

        if (row) {
            row.remove();
        }

        renumberTermRows();
    }

    function renumberTermRows() {
        const rows = document.querySelectorAll("#termsTable tbody tr");

        rows.forEach(function (row, index) {
            row.cells[0].innerText = index + 1;
        });
    }
</script>