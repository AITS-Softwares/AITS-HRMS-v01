@model Erp_Aits.Models.VehicleServiceItem
@{
    ViewBag.Title = "New Vehicle Service Item";
}
<form method="post" action="/HR/CreateVehicleServiceItem">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0 d-inline-block me-2">New Vehicle Service Item</h4>
            <span class="badge bg-warning-subtle text-warning">Not Saved</span>
        </div>
        <button type="submit" class="btn btn-dark btn-sm">Save</button>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@err.ErrorMessage</div>
            }
        </div>
    }

    <div class="card p-4">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Service Item *</label>
                <input name="ServiceItem" value="@Model.ServiceItem" class="form-control" required autofocus />
            </div>
            <div class="col-md-6">
                <label class="form-label">Rate</label>
                <input name="Rate" type="number" step="0.01" value="@Model.Rate" class="form-control" />
            </div>
        </div>
    </div>
</form>