@model Erp_Aits.Models.HolidayList
@{
    ViewBag.Title = "Holiday List Details";
    bool editMode = true;
}

<div class="container my-4 holiday-shell">
    <style>
        .holiday-shell { background:#f1fbfd; border:1px solid #cbe5ed; border-radius:18px; padding:26px; }
        .holiday-shell .card { border:1px solid #c9e1e9; border-radius:14px; box-shadow:none !important; }
        .holiday-shell h4, .holiday-shell h6, .holiday-shell .form-label { color:#17486c; font-weight:700; }
        .holiday-shell .table thead th { background:#e7f5f8; color:#17486c; }
    </style>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4>Holiday List - @Model.HolidayListName</h4>

        <div class="d-flex gap-2">
            <a href="@Url.Action("HolidayList", "HR")" class="btn btn-outline-dark btn-sm">Back to List</a>

            <form method="post"
                      action="@Url.Action("DeleteHolidayList", "HR", new { id = Model.Id })"
                      onsubmit="return confirm('Delete this Holiday List from HRMS and ERPNext?');"
                      class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
        </div>
    </div>

    @if (TempData["ErpNextError"] != null)
    {
        <div class="alert alert-danger">@TempData["ErpNextError"]</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <form method="post" action="@Url.Action("UpdateHolidayList", "HR", new { id = Model.Id })">
        @Html.AntiForgeryToken()

        <div class="card p-4 mb-4 shadow-sm">
            <h6 class="mb-3 font-weight-bold">General Information</h6>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Holiday List Name</label>
                    <input name="HolidayListName"
                           class="form-control"
                           value="@Model.HolidayListName"
                           @(editMode ? "" : "readonly") />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Total Holidays</label>
                    <input name="TotalHolidays"
                           class="form-control"
                           value="@(Model.Holidays?.Count ?? Model.TotalHolidays)"
                           readonly />
                </div>

                <div class="col-md-6">
                    <label class="form-label">From Date</label>
                    <input type="date"
                           name="FromDate"
                           class="form-control"
                           value="@Model.FromDate.ToString("yyyy-MM-dd")"
                           @(editMode ? "" : "readonly") />
                </div>

                <div class="col-md-6">
                    <label class="form-label">To Date</label>
                    <input type="date"
                           name="ToDate"
                           class="form-control"
                           value="@Model.ToDate.ToString("yyyy-MM-dd")"
                           @(editMode ? "" : "readonly") />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Country</label>
                    <input name="Country" id="country" class="form-control" list="countryOptions"
                           value="@Model.Country" placeholder="Select or type country" autocomplete="off" />
                    <datalist id="countryOptions"></datalist>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Subdivision (State)</label>
                    <input name="Subdivision" id="subdivision" class="form-control" list="subdivisionOptions" data-current="@Model.Subdivision"
                           value="@Model.Subdivision" placeholder="Select or type subdivision" autocomplete="off" />
                    <datalist id="subdivisionOptions"></datalist>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Weekly Off</label>
                    <select name="WeeklyOff" class="form-select">
                        <option value="">Select weekly off</option>
                        @foreach (var day in new[] { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" })
                        {
                            if (Model.WeeklyOff == day) { <option value="@day" selected>@day</option> }
                            else { <option value="@day">@day</option> }
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Color</label>

                    @if (editMode)
                    {
                        <input type="color"
                               name="Color"
                               class="form-control form-control-color"
                               value="@(string.IsNullOrWhiteSpace(Model.Color) ? "#3788d8" : Model.Color)" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2">
                            <span style="display:inline-block;width:28px;height:28px;border-radius:4px;background-color:@(string.IsNullOrWhiteSpace(Model.Color) ? "#3788d8" : Model.Color);border:1px solid #ccc;"></span>
                            <input class="form-control"
                                   value="@(string.IsNullOrWhiteSpace(Model.Color) ? "#3788d8" : Model.Color)"
                                   readonly />
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card p-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="mb-0 font-weight-bold">Holidays</h6>

                @if (editMode)
                {
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="addHolidayRow()">
                        Add Row
                    </button>
                }
            </div>

            <table class="table table-bordered align-middle mb-0" id="holidaysTable">
                <thead>
                    <tr>
                        <th style="width:60px">No.</th>
                        <th style="width:260px">Date</th>
                        <th>Description</th>
                        @if (editMode)
                        {
                            <th style="width:110px">Action</th>
                        }
                    </tr>
                </thead>

                <tbody id="holidaysBody">
                    @if (Model.Holidays != null && Model.Holidays.Any())
                    {
                        for (int i = 0; i < Model.Holidays.Count; i++)
                        {
                            <tr>
                                <td class="row-no">@(i + 1)</td>

                                <td>
                                    <input type="date"
                                           name="Holidays[@i].HolidayDate"
                                           value="@Model.Holidays[i].HolidayDate.ToString("yyyy-MM-dd")"
                                           class="form-control form-control-sm"
                                           @(editMode ? "" : "readonly") />
                                </td>

                                <td>
                                    <input type="text"
                                           name="Holidays[@i].Description"
                                           value="@Model.Holidays[i].Description"
                                           class="form-control form-control-sm"
                                           @(editMode ? "" : "readonly") />
                                </td>

                                @if (editMode)
                                {
                                    <td>
                                        <button type="button"
                                                class="btn btn-outline-danger btn-sm"
                                                onclick="removeHolidayRow(this)">
                                            Remove
                                        </button>
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="emptyHolidayRow">
                            <td colspan="@(editMode ? 4 : 3)" class="text-muted text-center py-3">
                                No holidays added
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (editMode)
        {
            <div class="mt-3 d-flex justify-content-end gap-2">
                <a href="@Url.Action("HolidayListDetails", "HR", new { id = Model.Id })"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

                <button type="submit" class="btn btn-dark">
                    Save
                </button>
            </div>
        }
    </form>
</div>

@if (editMode)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const countrySelect = document.getElementById("country");
            const subdivisionSelect = document.getElementById("subdivision");
            if (!countrySelect || !subdivisionSelect) return;
            let holidayCountryOptions;

            async function loadHolidayCountryOptions() {
                if (holidayCountryOptions) return holidayCountryOptions;
                const response = await fetch('@Url.Action("GetHolidayCountryOptions", "HR")');
                if (!response.ok) return null;
                holidayCountryOptions = await response.json();
                const options = document.getElementById("countryOptions");
                options.innerHTML = "";
                (holidayCountryOptions.countries || []).forEach(country => {
                    options.appendChild(new Option(country.label + " (" + country.value + ")", country.value));
                });
                return holidayCountryOptions;
            }

            async function loadSubdivisions() {
                const current = subdivisionSelect.dataset.current || subdivisionSelect.value;
                const options = document.getElementById("subdivisionOptions");
                options.innerHTML = "";
                if (!countrySelect.value) return;
                try {
                    const data = await loadHolidayCountryOptions();
                    if (!data) return;
                    const selected = (data.countries || []).find(country =>
                        country.value.toLowerCase() === countrySelect.value.toLowerCase() ||
                        country.label.toLowerCase() === countrySelect.value.toLowerCase());
                    const countryCode = selected ? selected.value : countrySelect.value.trim();
                    if (selected) countrySelect.value = countryCode;
                    ((data.subdivisionsByCountry || {})[countryCode] || [])
                        .forEach(name => options.appendChild(new Option(name, name)));
                    if (current) subdivisionSelect.value = current;
                } catch { }
            }

            countrySelect.addEventListener("change", function () {
                subdivisionSelect.dataset.current = "";
                loadSubdivisions();
            });
            countrySelect.addEventListener("input", function () {
                subdivisionSelect.dataset.current = "";
                loadSubdivisions();
            });
            // Load Country first, then populate the State/Subdivision list
            // for the currently selected country.
            loadHolidayCountryOptions().then(function () {
                if (countrySelect.value) loadSubdivisions();
            });
        });

        function updateHolidayIndexes() {
            const rows = document.querySelectorAll("#holidaysBody tr:not(#emptyHolidayRow)");

            rows.forEach(function (row, index) {
                const noCell = row.querySelector(".row-no");
                const dateInput = row.querySelector("input[type='date']");
                const descInput = row.querySelector("input[type='text']");

                if (noCell) {
                    noCell.innerText = index + 1;
                }

                if (dateInput) {
                    dateInput.name = `Holidays[${index}].HolidayDate`;
                }

                if (descInput) {
                    descInput.name = `Holidays[${index}].Description`;
                }
            });
        }

        function addHolidayRow() {
            const tbody = document.getElementById("holidaysBody");
            const emptyRow = document.getElementById("emptyHolidayRow");

            if (emptyRow) {
                emptyRow.remove();
            }

            const index = tbody.querySelectorAll("tr").length;

            const tr = document.createElement("tr");
            tr.innerHTML = `
                <td class="row-no">${index + 1}</td>
                <td>
                    <input type="date"
                           name="Holidays[${index}].HolidayDate"
                           class="form-control form-control-sm"
                           required />
                </td>
                <td>
                    <input type="text"
                           name="Holidays[${index}].Description"
                           class="form-control form-control-sm"
                           required />
                </td>
                <td>
                    <button type="button"
                            class="btn btn-outline-danger btn-sm"
                            onclick="removeHolidayRow(this)">
                        Remove
                    </button>
                </td>
            `;

            tbody.appendChild(tr);
            updateHolidayIndexes();
        }

        function removeHolidayRow(button) {
            button.closest("tr").remove();

            const tbody = document.getElementById("holidaysBody");

            if (tbody.querySelectorAll("tr").length === 0) {
                const tr = document.createElement("tr");
                tr.id = "emptyHolidayRow";
                tr.innerHTML = `
                    <td colspan="4" class="text-muted text-center py-3">
                        No holidays added
                    </td>
                `;
                tbody.appendChild(tr);
            }

            updateHolidayIndexes();
        }
    </script>
}
