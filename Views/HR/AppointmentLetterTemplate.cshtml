@model List<Erp_Aits.Models.AppointmentLetterTemplate>
@{
    ViewBag.Title = "Appointment Letter Template";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Appointment Letter Template</h4>
    <a href="@Url.Action("CreateAppointmentLetterTemplate", "HR")" class="btn btn-dark btn-sm">+ Add Appointment Letter Template</a>
</div>

<form method="get" asp-action="AppointmentLetterTemplate" class="row g-2 mb-3">
    <div class="col-md-3">
        <input type="text" name="id" class="form-control form-control-sm" placeholder="ID" value="@ViewBag.IdFilter" />
    </div>
    <div class="col-md-3">
        <input type="text" name="templateName" class="form-control form-control-sm" placeholder="Template Name" value="@ViewBag.TemplateNameFilter" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-sm btn-outline-dark">Filter</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>Template Name</th>
        </tr>
    </thead>
    @* <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.TemplateCode</td>
                <td>@t.TemplateName</td>
            </tr>
        }
    </tbody> *@
    <tbody>
        @foreach (var t in Model)
        {
            <tr style="cursor:pointer;" onclick="location.href='@Url.Action("AppointmentLetterTemplateDetails", "HR", new { id = t.Id })'">
                <td>@t.TemplateCode</td>
                <td>@t.TemplateName</td>
            </tr>
        }
    </tbody>
</table>
@if (!Model.Any())
{
    <p class="text-muted">No appointment letter templates found.</p>
}