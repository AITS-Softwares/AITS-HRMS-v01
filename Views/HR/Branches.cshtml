@model List<Erp_Aits.Models.Branch>

@{
    ViewBag.Title = "Branches";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErpNextError"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

@if (ViewBag.SyncWarning != null)
{
    <div class="alert alert-warning">
        @ViewBag.SyncWarning
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <h4 class="mb-0">
        Branches
    </h4>

    <button type="button"
            class="btn btn-dark btn-sm"
            data-bs-toggle="modal"
            data-bs-target="#newBranchModal">

        + Add Branch

    </button>

</div>

<div class="card p-0">

    <table class="table table-hover align-middle mb-0">

        <thead>
            <tr>
                <th>Branch Name</th>
                <th>ERPNext ID</th>
            </tr>
        </thead>

        <tbody>

            @if (Model != null && Model.Any())
            {
                foreach (var b in Model)
                {
                    <tr style="cursor:pointer;"
                        onclick="window.location='@Url.Action(
                                                    "BranchDetails",
                                                    "HR",
                                                    new { id = b.Id })'">

                        <td>
                            @b.BranchName
                        </td>

                        <td>
                            <span class="text-muted">
                                @(string.IsNullOrWhiteSpace(b.ErpName)
                                                        ? "-"
                                                        : b.ErpName)
                    </span>
                </td>

                    </tr>
                        }
            }
            else
            {
                <tr>
                    <td colspan="2"
                        class="text-center text-muted py-4">

                        No branches found.

                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>


<!-- CREATE BRANCH MODAL -->
<div class="modal fade"
     id="newBranchModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form asp-action="CreateBranch"
                  asp-controller="HR"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">

                    <h5 class="modal-title">
                        New Branch
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <label class="form-label">
                        Branch
                        <span class="text-danger">*</span>
                    </label>

                    <input type="text"
                           name="BranchName"
                           class="form-control"
                           required
                           autofocus />

                </div>

                <div class="modal-footer">

                    <button type="submit"
                            class="btn btn-dark btn-sm">
                        Save
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>