@using System.Collections.Generic
@{ViewBag.Title="New Accounting Dimension";var types=ViewBag.DimensionDocTypes as List<string>??new List<string>();var companies=ViewBag.DimensionCompanies as List<string>??new List<string>();}
<style>.p{max-width:1210px;margin:auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.h{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.h h1{font-size:22px;margin:0}.save{border:0;background:#0f766e;color:#fff;padding:9px 17px;border-radius:7px;font-weight:650}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.s{padding:20px;border-bottom:1px solid #dbe3ec}.g{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.f label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.i,.sel{box-sizing:border-box;width:100%;height:36px;border:1px solid #b8c7d7;border-radius:8px;padding:7px 10px;background:#fbfdff;font-size:14px}.i[readonly]{background:#f2f6f9}.check{display:flex;gap:8px;align-items:center;padding-top:24px}.table{width:100%;border-collapse:collapse}.table th,.table td{border:1px solid #dbe3ec;padding:8px}.table select{width:100%;height:34px;border:1px solid #b8c7d7;border-radius:6px}.add{margin-top:10px;border:0;background:#dce8f1;border-radius:6px;padding:7px 12px}@@media(max-width:800px){.p{padding:12px}.g{grid-template-columns:1fr}}</style>
<div class="p"><form method="post" asp-action="CreateAccountingDimension">@Html.AntiForgeryToken()<header class="h"><h1>New Accounting Dimension</h1><button class="save">Save</button></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}<main class="card"><section class="s"><div class="g"><div class="f"><label>Reference Document Type *</label><select name="DocumentType" class="sel" required><option value="">Select document type</option>@foreach(var x in types){<option value="@x">@x</option>}</select></div><div class="f"><label>Dimension Name *</label><input name="Label" id="label" class="i" required/></div><div class="f"><label>Fieldname</label><input id="fieldname" class="i" readonly/></div><label class="check"><input name="Disabled" type="checkbox"/> Disable</label></div></section><section class="s"><h2>Dimension Defaults</h2><table class="table"><thead><tr><th>Company</th><th>Mandatory for Balance Sheet</th><th>Mandatory for Profit and Loss</th></tr></thead><tbody id="rows"><tr><td><select name="DefaultCompanies"><option value="">Select company</option>@foreach(var x in companies){<option value="@x">@x</option>}</select></td><td><input name="MandatoryBs" type="checkbox"/></td><td><input name="MandatoryPl" type="checkbox"/></td></tr></tbody></table><button type="button" class="add" id="add">Add Row</button></section></main></form></div><script>const l=document.getElementById('label'),f=document.getElementById('fieldname');l.oninput=()=>f.value=l.value.toLowerCase().replace(/[^a-z0-9]+/g,'_').replace(/^_|_$/g,'');document.getElementById('add').onclick=()=>{const r=document.querySelector('#rows tr').cloneNode(true);r.querySelector('select').selectedIndex=0;r.querySelectorAll('input').forEach(x=>x.checked=false);document.getElementById('rows').append(r)};</script>
