@model List<Erp_Aits.Models.EnergyPointRuleListRow>
@{
    ViewBag.Title = "Energy Point Rule";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Energy Point Rule</h4>

    <div class="d-flex gap-2">
        <form method="post" asp-action="SyncEnergyPointRulesFromErpNext" asp-controller="HR">
            <button type="submit" class="btn btn-outline-primary btn-sm">Sync From ERPNext</button>
        </form>

        <a href="@Url.Action("CreateEnergyPointRule", "HR")" class="btn btn-dark btn-sm">
            + Add Energy Point Rule
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="id" class="form-control form-control-sm" placeholder="ID" value="@ViewBag.IdFilter" />
    </div>

    <div class="col-auto">
        <select name="status" class="form-select form-select-sm">
            <option value="">Status</option>
            <option value="Active" selected="@(ViewBag.StatusFilter == "Active")">Active</option>
            <option value="Inactive" selected="@(ViewBag.StatusFilter == "Inactive")">Inactive</option>
        </select>
    </div>

    <div class="col-auto">
        <select name="enabled" class="form-select form-select-sm">
            <option value="">Enabled</option>
            <option value="true" selected="@(ViewBag.EnabledFilter?.ToString() == "True")">Yes</option>
            <option value="false" selected="@(ViewBag.EnabledFilter?.ToString() == "False")">No</option>
        </select>
    </div>

    <div class="col-auto">
        <input type="text" name="ruleName" class="form-control form-control-sm" placeholder="Rule Name" value="@ViewBag.RuleNameFilter" />
    </div>

    <div class="col-auto">
        <input type="text" name="referenceDocumentType" class="form-control form-control-sm" placeholder="Reference Document Type" value="@ViewBag.RefDocTypeFilter" />
    </div>

    <div class="col-auto">
        <input type="text" name="condition" class="form-control form-control-sm" placeholder="Condition" value="@ViewBag.ConditionFilter" />
    </div>

    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>ERPNext ID</th>
            <th>Rule Name</th>
            <th>Reference Document Type</th>
            <th>Enabled</th>
            <th>Status</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var r in Model)
        {
            <tr style="cursor:pointer" onclick="window.location='@Url.Action("EnergyPointRuleDetails", "HR", new { id = r.Id })'">
                <td>@r.Id</td>
                <td>@(string.IsNullOrWhiteSpace(r.ErpNextId) ? "-" : r.ErpNextId)</td>
                <td>@r.RuleName</td>
                <td>@r.ReferenceDocumentType</td>
                <td>@(r.Enabled ? "Yes" : "No")</td>
                <td><span class="badge bg-secondary-subtle text-secondary">@r.Status</span></td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted text-center py-5">No Energy Point Rule found with matching filters.</p>
}