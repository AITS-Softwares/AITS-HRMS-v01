@model Erp_Aits.Models.InterviewFeedbackModel
@{
    ViewBag.Title = "New Interview Feedback";
    var interviews = ViewBag.FeedbackInterviews as List<Erp_Aits.Models.Interview> ?? new List<Erp_Aits.Models.Interview>();
    var interviewers = ViewBag.FeedbackInterviewers as Newtonsoft.Json.Linq.JArray ?? new Newtonsoft.Json.Linq.JArray();
}

<form asp-action="CreateInterviewFeedback" method="post" novalidate class="recruitment-theme workflow-page interview-ui">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0 d-inline">New Interview Feedback</h4>
            <span class="badge bg-danger-subtle text-danger ms-2">Not Saved</span>
        </div>
        <button type="submit" class="btn btn-dark btn-sm">Save</button>
    </div>

    <h6 class="mb-3">Details</h6>
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <label class="form-label">Interview <span class="text-danger">*</span></label>
            <select asp-for="InterviewId" class="form-select" id="feedbackInterview">
                <option value="">Select Interview</option>
                @foreach (var interview in interviews)
                {
                    <option value="@interview.Id">@interview.InterviewRound — @interview.JobApplicant (@interview.ScheduledOn.ToString("dd-MM-yyyy"))</option>
                }
            </select>
            <span asp-validation-for="InterviewId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">Interviewer <span class="text-danger">*</span></label>
            <select asp-for="Interviewer" class="form-select">
                <option value="">Select Interviewer</option>
                @foreach (var row in interviewers)
                {
                    var id = row["name"]?.ToString() ?? string.Empty;
                    var label = row["full_name"]?.ToString() ?? id;
                    <option value="@id">@label</option>
                }
            </select>
            <span asp-validation-for="Interviewer" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label class="form-label">Result <span class="text-danger">*</span></label>
            <select asp-for="Result" class="form-select">
                <option value="Cleared">Cleared</option>
                <option value="Rejected">Rejected</option>
            </select>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6"><label class="form-label">Interview Round</label><input id="feedbackRound" class="form-control" readonly /></div>
        <div class="col-md-6"><label class="form-label">Job Applicant</label><input id="feedbackApplicant" class="form-control" readonly /></div>
    </div>

    <hr />
    <h6 class="mb-3">Skill Assessment</h6>

    <table class="table table-bordered align-middle mb-1" id="skillsTable">
        <thead>
            <tr>
                <th style="width:40px"><input type="checkbox" disabled /></th>
                <th style="width:60px">No.</th>
                <th>Skill <span class="text-danger">*</span></th>
                <th>Rating <span class="text-danger">*</span></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><input type="checkbox" /></td>
                <td class="row-number">1</td>
                <td><select name="SkillNames" class="form-select form-select-sm border-0 skill-select"><option value="">Select Interview first</option></select></td>
                <td>
                    <div class="star-rating" data-index="0">
                        <i class="fa-star" data-value="1">★</i>
                        <i class="fa-star" data-value="2">★</i>
                        <i class="fa-star" data-value="3">★</i>
                        <i class="fa-star" data-value="4">★</i>
                        <i class="fa-star" data-value="5">★</i>
                        <input type="hidden" name="SkillRatings" class="rating-input" value="0" />
                    </div>
                </td>
            </tr>
        </tbody>
    </table>
    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addSkillRow()">Add Row</button>

    <hr class="my-4" />
    <h6 class="mb-2">Feedback</h6>
    <textarea asp-for="FeedbackText" class="form-control" rows="8"></textarea>

</form>

<style>
    .star-rating {
        display: flex;
        gap: 2px;
    }

        .star-rating .fa-star {
            cursor: pointer;
            font-size: 16px;
            color: #d1d5db;
            font-style: normal;
        }

            .star-rating .fa-star.filled {
                color: #f59e0b;
            }
</style>

<script>
    document.querySelectorAll('.star-rating').forEach(initStars);

    function initStars(container) {
        var stars = container.querySelectorAll('.fa-star');
        var input = container.querySelector('.rating-input');

        stars.forEach(function (star) {
            star.addEventListener('click', function () {
                var value = parseInt(star.getAttribute('data-value'));
                input.value = value;
                stars.forEach(function (s) {
                    s.classList.toggle('filled', parseInt(s.getAttribute('data-value')) <= value);
                });
            });
        });
    }

    function addSkillRow() {
        var tbody = document.querySelector('#skillsTable tbody');
        var rowNum = tbody.rows.length + 1;

        var row = document.createElement('tr');
        row.innerHTML =
            '<td><input type="checkbox" /></td>' +
            '<td class="row-number">' + rowNum + '</td>' +
            '<td><select name="SkillNames" class="form-select form-select-sm border-0 skill-select"><option value="">Select Skill</option></select></td>' +
            '<td>' +
                '<div class="star-rating">' +
                    '<i class="fa-star" data-value="1">★</i>' +
                    '<i class="fa-star" data-value="2">★</i>' +
                    '<i class="fa-star" data-value="3">★</i>' +
                    '<i class="fa-star" data-value="4">★</i>' +
                    '<i class="fa-star" data-value="5">★</i>' +
                    '<input type="hidden" name="SkillRatings" class="rating-input" value="0" />' +
                '</div>' +
            '</td>';

        tbody.appendChild(row);
        initStars(row.querySelector('.star-rating'));
        populateSkillSelect(row.querySelector('.skill-select'));
    }

    var feedbackSkills = [];
    function populateSkillSelect(select) {
        select.innerHTML = '<option value="">Select Skill</option>';
        feedbackSkills.forEach(function (skill) { var option = new Option(skill, skill); select.add(option); });
    }
    document.getElementById('feedbackInterview').addEventListener('change', async function () {
        var id = this.value;
        document.getElementById('feedbackRound').value = '';
        document.getElementById('feedbackApplicant').value = '';
        feedbackSkills = [];
        if (id) {
            var response = await fetch('@Url.Action("GetInterviewFeedbackData", "HR")?interviewId=' + encodeURIComponent(id));
            if (response.ok) {
                var data = await response.json();
                document.getElementById('feedbackRound').value = data.interviewRound || '';
                document.getElementById('feedbackApplicant').value = data.jobApplicant || '';
                feedbackSkills = data.skills || [];
            }
        }
        document.querySelectorAll('.skill-select').forEach(populateSkillSelect);
    });
</script>
@await Html.PartialAsync("_RecruitmentTheme")
