@model Erp_Aits.Models.CompensatoryLeaveRequest
@{
    ViewBag.Title = "Compensatory Leave Request Details";
    bool isEdit = ViewBag.IsEdit == true;
    bool isSubmitted = string.Equals(Model.Status, "Submitted", StringComparison.OrdinalIgnoreCase);
    bool isCancelled = string.Equals(Model.Status, "Cancelled", StringComparison.OrdinalIgnoreCase);
}

<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    body {
        background: linear-gradient(160deg, #f4f6fb 0%, #eef1f8 100%);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        min-height: 100vh;
    }

    .clr-form-wrapper {
        max-width: 800px;
        margin: 0 auto;
        padding: 32px 16px 40px;
    }

    .clr-page-header h4 {
        font-family: 'Manrope', sans-serif;
        color: #0f2544;
        font-weight: 800;
        font-size: 21px;
        margin: 0;
    }

    .form-card {
        background: #ffffff;
        border: 1px solid #e2e6f0;
        border-radius: 14px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08), 0 2px 8px rgba(15, 23, 42, 0.04);
        padding: 24px;
        margin-top: 20px;
    }

    .form-label {
        font-weight: 700;
        font-size: 13px;
        color: #0f2544;
        margin-bottom: 6px;
    }

    .form-control, .form-select {
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        padding: 10px 14px;
        font-size: 14px;
        color: #334155;
    }

        .form-control:focus, .form-select:focus {
            border-color: #2dd4bf;
            box-shadow: 0 0 0 3px rgba(45, 212, 191, 0.25);
        }

    .btn-save {
        background: #0f2544;
        color: #ffffff;
        border: none;
        font-weight: 700;
        font-size: 13px;
        padding: 10px 24px;
        border-radius: 999px;
        transition: all 0.2s ease-in-out;
        box-shadow: 0 4px 12px rgba(15, 37, 68, 0.25);
        cursor: pointer;
    }

        .btn-save:hover {
            background: #2dd4bf;
            color: #0a2540;
            transform: translateY(-2px);
        }

    .btn-back {
        color: #64748b;
        font-weight: 600;
        font-size: 13px;
        text-decoration: none;
        padding: 10px 16px;
        display: inline-block;
    }

        .btn-back:hover {
            color: #0f2544;
        }
</style>

<div class="clr-form-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-3 clr-page-header">
        <h4 class="mb-0">Compensatory Leave Request</h4>
        <div class="d-flex gap-2">
            <a href="/HR/CompensatoryLeaveRequest" class="btn-back">Back to List</a>
            @if (isEdit)
            {
                <a href="@Url.Action("CompensatoryLeaveRequestDetails", "HR", new { id = string.IsNullOrEmpty(Model.ErpNextId) ? Model.Id.ToString() : Model.ErpNextId })" class="btn btn-outline-secondary btn-sm">Cancel</a>
            }
            else
            {
                @if (!isSubmitted && !isCancelled)
                {
                    <a href="@Url.Action("CompensatoryLeaveRequestDetails", "HR", new { id = string.IsNullOrEmpty(Model.ErpNextId) ? Model.Id.ToString() : Model.ErpNextId, edit = true })" class="btn btn-dark btn-sm">Edit</a>
                    <button type="submit" form="compLeaveForm" name="actionCommand" value="Submit" class="btn btn-success btn-sm">Submit</button>
                    <button type="submit" form="deleteCompLeaveForm" class="btn btn-outline-danger btn-sm" onclick="return confirm('Delete this Compensatory Leave Request from ERPNext and HRMS?');">Delete</button>
                }
                @if (isSubmitted)
                {
                    <button type="submit" form="compLeaveForm" name="actionCommand" value="Cancel" class="btn btn-outline-danger btn-sm" onclick="return confirm('Cancel this Compensatory Leave Request in ERPNext and HRMS?');">Cancel</button>
                }
            }
        </div>
    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mb-3">@TempData["Success"]</div>
    }

    @if (TempData["ErpNextError"] != null)
    {
        <div class="alert alert-danger mb-3">@TempData["ErpNextError"]</div>
    }






    @* @using (Html.BeginForm("UpdateCompensatoryLeaveRequest", "HR", FormMethod.Post)) *@
    <form id="compLeaveForm" action="/HR/UpdateCompensatoryLeaveRequest" method="post">
        <input type="hidden" name="Id" value="@Model.Id" />
        <input type="hidden" name="ErpNextId" value="@Model.ErpNextId" />
        <input type="hidden" name="Status" value="@Model.Status" />

        <div class="form-card">
            <fieldset disabled="@(!isEdit)">
            <div class="mb-3">
                <label class="form-label">ERP Reference ID</label>
                <input type="text" class="form-control" value="@Model.ErpNextId" disabled />
            </div>

            <div class="mb-3">
                <label class="form-label">Status</label>
                <input type="text" class="form-control" value="@Model.Status" disabled />
            </div>

            <div class="mb-3">
                <label class="form-label">Employee</label>
                @Html.TextBoxFor(m => m.Employee, new { @class = "form-control" })
            </div>

            <div class="mb-3">
                <label class="form-label">Leave Type</label>
                @Html.TextBoxFor(m => m.LeaveType, new { @class = "form-control" })
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Work From Date</label>
                    @Html.TextBoxFor(m => m.WorkFromDate, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date" })
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Work End Date</label>
                    @Html.TextBoxFor(m => m.WorkEndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date" })
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Reason</label>
                @Html.TextAreaFor(m => m.Reason, new { @class = "form-control", rows = 3 })
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a href="/HR/CompensatoryLeaveRequest"
                   class="btn btn-light"
                   style="border-radius: 999px; padding: 10px 20px; font-weight: 600; text-decoration: none; color: #475569; border: 1px solid #cbd5e1;">
                    Cancel
                </a>

                @if (isEdit)
                {
                    <button type="submit" name="actionCommand" value="Save" class="btn-save">Save</button>
                }
            </div>
            </fieldset>
        </div>
    </form>
    <form id="deleteCompLeaveForm" method="post" action="@Url.Action("DeleteCompensatoryLeaveRequest", "HR", new { id = Model.Id })"></form>
</div>
