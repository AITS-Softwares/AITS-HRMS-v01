@model Erp_Aits.Models.ActivityCost
@{
    ViewBag.Title = "New Activity Cost";
}

<form method="post" action="/HR/CreateActivityCost">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0 d-inline-block me-2">New Activity Cost</h4>
            <span class="badge bg-warning-subtle text-warning">Not Saved</span>
        </div>

        <button type="submit" class="btn btn-dark btn-sm">Save</button>
    </div>

    <div class="card p-4 mb-3">
        <label class="form-label">Activity Type <span class="text-danger">*</span></label>
        <select name="ActivityType" class="form-select mb-3" required>
            <option value="">Select Activity Type</option>
            @if (ViewBag.ActivityTypes != null)
            {
                foreach (var item in ViewBag.ActivityTypes)
                {
                    string name = item.name?.ToString();
                    <option value="@name">@name</option>
                }
            }
        </select>

        <label class="form-label">Employee</label>
        <select name="Employee" class="form-select">
            <option value="">Select Employee</option>
            @if (ViewBag.Employees != null)
            {
                foreach (var item in ViewBag.Employees)
                {
                    string empId = item.name?.ToString();
                    string empName = item.employee_name?.ToString();

                    <option value="@empId">
                        @(string.IsNullOrWhiteSpace(empName) ? empId : empName + " (" + empId + ")")
                    </option>
                }
            }
        </select>
    </div>

    <div class="card p-4">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Billing Rate</label>
                <input name="BillingRate" type="number" step="0.01" class="form-control" value="0.00" />
                <small class="text-muted">per hour</small>
            </div>

            <div class="col-md-6">
                <label class="form-label">Costing Rate</label>
                <input name="CostingRate" type="number" step="0.01" class="form-control" value="0.00" />
                <small class="text-muted">per hour</small>
            </div>
        </div>
    </div>
</form>