@model Erp_Aits.Models.AdditionalSalary
@{
    ViewBag.Title = Model.AdditionalSalaryCode;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0">@Model.EmployeeName</h4>
        <small class="text-muted">@Model.AdditionalSalaryCode</small>
    </div>
    <a href="@Url.Action("AdditionalSalary", "HR")" class="btn btn-outline-dark btn-sm">Back to List</a>
</div>

<div class="card p-4">
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Company</label>
            <div class="form-control bg-light">@Model.Company</div>
        </div>
        <div class="col-md-6">
            <label class="form-label">Is Recurring</label>
            <div class="form-control bg-light">@(Model.IsRecurring ? "Yes" : "No")</div>
        </div>
        <div class="col-md-6">
            <label class="form-label">Employee</label>
            <div class="form-control bg-light">@Model.Employee</div>
        </div>
        <div class="col-md-6">
            <label class="form-label">Payroll Date</label>
            <div class="form-control bg-light">@(Model.PayrollDate?.ToString("dd-MM-yyyy"))</div>
        </div>
    </div>
</div>

<div class="card p-4 mt-3">
    <h6 class="mb-3">Salary</h6>
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Salary Component</label>
            <div class="form-control bg-light">@Model.SalaryComponent</div>
        </div>
        <div class="col-md-6">
            <label class="form-label">Deduct Full Tax on Selected Payroll Date</label>
            <div class="form-control bg-light">@(Model.DeductFullTaxOnSelectedPayrollDate ? "Yes" : "No")</div>
        </div>
        <div class="col-md-6">
            <label class="form-label">Amount</label>
            <div class="form-control bg-light">@Model.Amount.ToString("0.00")</div>
        </div>
        <div class="col-md-6">
            <label class="form-label">Overwrite Salary Structure Amount</label>
            <div class="form-control bg-light">@(Model.OverwriteSalaryStructureAmount ? "Yes" : "No")</div>
        </div>
    </div>
</div>
