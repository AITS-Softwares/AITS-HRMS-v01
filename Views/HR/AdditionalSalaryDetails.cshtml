@using Erp_Aits.Models
@using Newtonsoft.Json.Linq
@{
    ViewBag.Title = "Additional Salary Details";
    var doc = ViewBag.Document as JObject;
    string V(string key) => doc?[key]?.ToString() ?? "";
    bool Checked(string key) => V(key) == "1" || V(key).Equals("Yes", StringComparison.OrdinalIgnoreCase);
    var status = doc?["docstatus"]?.Value<int>() ?? -1;
    var employees = ViewBag.AdditionalSalaryEmployees as List<PayrollEmployeeOption> ?? new();
    var companies = ViewBag.AdditionalSalaryCompanies as List<string> ?? new();
    var components = ViewBag.AdditionalSalaryComponents as List<string> ?? new();
    var currencies = ViewBag.AdditionalSalaryCurrencies as List<string> ?? new();
    var types = ViewBag.AdditionalSalaryDocTypes as List<string> ?? new();
}
<style>
 .salary-page{max-width:1210px;margin:auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.salary-head{display:flex;justify-content:space-between;align-items:center;gap:15px;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.salary-head h1{font-size:22px;margin:0}.salary-actions{display:flex;gap:10px;align-items:center}.salary-actions a{color:#fff}.salary-actions button{border:0;border-radius:6px;padding:9px 16px;color:#fff;background:#0f766e}.salary-actions .cancel{background:#b91c1c}.salary-card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.salary-section{padding:20px;border-bottom:1px solid #dbe3ec}.salary-section h2{font-size:17px}.salary-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.salary-field label{display:block;font-size:13px;margin-bottom:7px}.salary-field input,.salary-field select{width:100%;height:36px;box-sizing:border-box;border:1px solid #b8c7d7;border-radius:6px;padding:7px 10px;background:#fbfdff}.salary-field input[readonly]{background:#f2f6f9}.salary-check{display:flex;gap:8px;margin-top:12px}fieldset{border:0;margin:0;padding:0}@@media(max-width:800px){.salary-grid{grid-template-columns:1fr}.salary-head{flex-wrap:wrap}}
</style>
<div class="salary-page">
 @if(TempData["ErpNextError"] != null){<div class="alert alert-danger">@TempData["ErpNextError"]</div>}
 @if(TempData["Success"] != null){<div class="alert alert-success">@TempData["Success"]</div>}
 @if(doc != null){
 <header class="salary-head"><div><h1>@V("name")</h1><span>@(status == 0 ? "Draft" : status == 1 ? "Submitted" : "Cancelled")</span></div><div class="salary-actions"><a asp-action="AdditionalSalary">Back to Additional Salary</a>@if(status == 0){<button id="saveButton" form="salaryForm" type="submit" hidden>Save</button><button id="submitButton" form="statusForm" type="submit">Submit</button>}else if(status == 1){<button class="cancel" form="statusForm" type="submit" onclick="return confirm('Cancel this Additional Salary in ERPNext?')">Cancel</button>}</div></header>
 <form id="salaryForm" method="post" asp-action="UpdateAdditionalSalary" asp-route-id="@V("name")">@Html.AntiForgeryToken()<main class="salary-card"><fieldset disabled="@(status != 0)">
 <section class="salary-section"><div class="salary-grid">
 <div class="salary-field"><label>Series</label><input name="NamingSeries" value="@V("naming_series")" readonly /></div>
 <div class="salary-field"><label>Employee *</label><select name="Employee" id="employee" required><option value="">Select employee</option>@foreach(var e in employees){<option value="@e.Id" selected="@(e.Id == V("employee"))" data-name="@e.EmployeeName" data-department="@e.Department" data-company="@e.Company">@e.Id</option>}</select></div>
 <div class="salary-field"><label>Employee Name</label><input id="employeeName" value="@V("employee_name")" readonly /></div><div class="salary-field"><label>Department</label><input id="department" value="@V("department")" readonly /></div>
 <div class="salary-field"><label>Company *</label><select id="company" name="Company" required><option value="">Select company</option>@foreach(var x in companies){<option value="@x" selected="@(x == V("company"))">@x</option>}</select></div>
 <div><label class="salary-check"><input type="checkbox" name="IsRecurring" id="recurring" checked="@Checked("is_recurring")" />Is Recurring</label><label class="salary-check"><input type="checkbox" name="Disabled" checked="@Checked("disabled")" />Disabled</label></div>
 <div class="salary-field"><label>From Date</label><input type="date" name="FromDate" value="@V("from_date")" /></div><div class="salary-field"><label>To Date</label><input type="date" name="ToDate" value="@V("to_date")" /></div><div class="salary-field"><label>Payroll Date</label><input type="date" name="PayrollDate" value="@V("payroll_date")" /></div><div class="salary-field"><label>Amended From</label><input value="@V("amended_from")" readonly /></div>
 </div></section>
 <section class="salary-section"><h2>Salary</h2><div class="salary-grid">
 <div class="salary-field"><label>Salary Component *</label><select name="SalaryComponent" required><option value="">Select component</option>@foreach(var x in components){<option value="@x" selected="@(x == V("salary_component"))">@x</option>}</select></div><div class="salary-field"><label>Salary Component Type</label><input value="@V("type")" readonly /></div>
 <div class="salary-field"><label>Currency *</label><select name="Currency" required><option value="">Select currency</option>@foreach(var x in currencies){<option value="@x" selected="@(x == V("currency"))">@x</option>}</select></div><div class="salary-field"><label>Amount *</label><input type="number" step="0.01" name="Amount" value="@V("amount")" required /></div>
 <div><label class="salary-check"><input type="checkbox" name="DeductFullTax" checked="@Checked("deduct_full_tax_on_selected_payroll_date")" />Deduct Full Tax on Selected Payroll Date</label><label class="salary-check"><input type="checkbox" name="OverwriteSalaryStructureAmount" checked="@Checked("overwrite_salary_structure_amount")" />Overwrite Salary Structure Amount</label></div>
 </div></section><section class="salary-section"><h2>References</h2><div class="salary-grid"><div class="salary-field"><label>Reference Document Type</label><select name="ReferenceDocumentType"><option value="">Select document type</option>@foreach(var x in types){<option value="@x" selected="@(x == V("ref_doctype"))">@x</option>}</select></div><div class="salary-field"><label>Reference Document</label><input name="ReferenceDocument" value="@V("ref_docname")" /></div></div></section>
 </fieldset></main></form>
 @if(status == 0 || status == 1){<form id="statusForm" method="post" asp-action="SetAdditionalSalaryStatus" asp-route-id="@V("name")" asp-route-status="@(status == 0 ? 1 : 2)">@Html.AntiForgeryToken()</form>}
 }
</div>
@if(status == 0){<script>
 (() => { const form=document.getElementById('salaryForm'),save=document.getElementById('saveButton'),submit=document.getElementById('submitButton'),employee=document.getElementById('employee');
 const dirty=()=>{save.hidden=false;submit.hidden=true}; form.addEventListener('input',dirty); form.addEventListener('change',dirty);
 employee.addEventListener('change',()=>{const o=employee.options[employee.selectedIndex];document.getElementById('employeeName').value=o.dataset.name||'';document.getElementById('department').value=o.dataset.department||'';if(o.dataset.company)document.getElementById('company').value=o.dataset.company});
 })();
</script>}
