<script>
    let expenseIdx = 0;
    let taxIdx = 0;
    let advanceIdx = 0;
    let erpLinkTimer = null;

    function esc(value) {
        if (value === null || value === undefined) return '';
        return String(value)
            .replaceAll('&', '&amp;')
            .replaceAll('"', '&quot;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;');
    }

    function today() {
        return new Date().toISOString().slice(0, 10);
    }

    function findOption(listId, value) {
        return document.querySelector(`#${listId} option[value="${CSS.escape(value)}"]`);
    }

    function autoFillEmployeeData(employee) {
        const opt = findOption('employeeList', employee);
        if (!opt) return;

        const empName = opt.getAttribute('data-name') || '';
        const department = opt.getAttribute('data-department') || '';
        const company = opt.getAttribute('data-company') || '';

        const empNameInput = document.getElementById('EmployeeName');
        const departmentInput = document.getElementById('Department');
        const companyInput = document.getElementById('Company');

        if (empNameInput && empName) empNameInput.value = empName;
        if (departmentInput && department) departmentInput.value = department;

        if (companyInput && company) {
            companyInput.value = company;
            autoFillCompanyData(company);
        }
    }

    function autoFillCompanyData(company) {
        const opt = findOption('companyList', company);
        if (!opt) return;

        const gstin = opt.getAttribute('data-gstin') || '';
        const payable = opt.getAttribute('data-payable') || '';
        const costCenter = opt.getAttribute('data-cost-center') || '';

        const gstinInput = document.getElementById('CompanyGstin');
        const payableInput = document.getElementById('PayableAccount');
        const costCenterInput = document.getElementById('CostCenter');

        if (gstinInput && gstin) gstinInput.value = gstin;
        if (payableInput && payable) payableInput.value = payable;
        if (costCenterInput && costCenter) costCenterInput.value = costCenter;
    }

    function loadErpLinkDropdown(input, doctype) {
        clearTimeout(erpLinkTimer);

        erpLinkTimer = setTimeout(async function () {
            const wrapper = input.closest('.erp-link-wrapper');
            const dropdown = wrapper?.querySelector('.erp-link-dropdown');

            if (!dropdown) return;

            const employee = document.getElementById('Employee')?.value || '';

            const url =
                `/HR/SearchExpenseClaimLink?doctype=${encodeURIComponent(doctype)}` +
                `&txt=${encodeURIComponent(input.value || '')}` +
                `&employee=${encodeURIComponent(employee)}`;

            const response = await fetch(url);
            const rows = await response.json();

            dropdown.innerHTML = '';

            if (!rows || !rows.length) {
                dropdown.classList.add('d-none');
                return;
            }

            rows.forEach(row => {
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'erp-link-option';
                button.textContent = row.label
                    ? `${row.name} - ${row.label}`
                    : row.name;

                button.onclick = function () {
                    input.value = row.name;
                    dropdown.classList.add('d-none');

                    if (doctype === 'Employee Advance') {
                        autoFillAdvanceData(input);
                    }
                };

                dropdown.appendChild(button);
            });

            dropdown.classList.remove('d-none');
        }, 250);
    }

    function addExpenseRow(type = '', desc = '', amount = '0.00', sanctionedAmount = '0.00') {
        const i = expenseIdx++;

        const row = `
            <tr>
                <td>${i + 1}</td>
                <td>
                    <input type="date"
                           name="Expenses[${i}].ExpenseDate"
                           class="form-control form-control-sm"
                           value="${today()}" />
                </td>
                <td>
                    <input name="Expenses[${i}].ExpenseClaimType"
                           value="${esc(type)}"
                           class="form-control form-control-sm"
                           list="expenseTypeList"
                           placeholder="Select expense type" />
                </td>
                <td>
                    <input name="Expenses[${i}].Description"
                           value="${esc(desc)}"
                           class="form-control form-control-sm" />
                </td>
                <td>
                    <input type="number"
                           step="0.01"
                           name="Expenses[${i}].Amount"
                           value="${esc(amount)}"
                           class="form-control form-control-sm expense-amount"
                           oninput="syncSanctionedAmount(this)" />
                </td>
                <td>
                    <input type="number"
                           step="0.01"
                           name="Expenses[${i}].SanctionedAmount"
                           value="${esc(sanctionedAmount)}"
                           class="form-control form-control-sm sanctioned-amount" />
                </td>
                <td class="text-center">
                    <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            onclick="this.closest('tr').remove()">×</button>
                </td>
            </tr>`;

        document.getElementById('expensesBody').insertAdjacentHTML('beforeend', row);


    }

        function syncSanctionedAmount(amountInput) {
        const row = amountInput.closest('tr');
        const sanctionedInput = row.querySelector('.sanctioned-amount');

        if (!sanctionedInput) return;

        sanctionedInput.value = amountInput.value || '0.00';
        document.querySelectorAll('#taxesBody .tax-rate').forEach(calculateTaxTotal);
    }











    function addTaxRow(account = '', rate = '', amount = '', total = '') {
        const i = taxIdx++;

        const row = `
            <tr>
                <td>${i + 1}</td>
                <td>
                    <input name="Taxes[${i}].AccountHead"
                           value="${esc(account)}"
                           class="form-control form-control-sm"
                           list="accountList"
                           placeholder="Select account head" />
                </td>
                <td>
                    <input type="number"
                           step="0.01"
                           name="Taxes[${i}].Rate"
                           value="${esc(rate)}"
                           class="form-control form-control-sm tax-rate"
                           oninput="calculateTaxTotal(this)" />
                </td>
                <td>
                    <input type="number"
                           step="0.01"
                           name="Taxes[${i}].Amount"
                           value="${esc(amount)}"
                           class="form-control form-control-sm tax-amount"
                           readonly />
                </td>
                <td>
                    <input type="number"
                           step="0.01"
                           name="Taxes[${i}].Total"
                           value="${esc(total)}"
                           class="form-control form-control-sm tax-total"
                           readonly />
                </td>
                <td class="text-center">
                    <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            onclick="this.closest('tr').remove()">×</button>
                </td>
            </tr>`;

        document.getElementById('taxesBody').insertAdjacentHTML('beforeend', row);
    }

    function calculateTaxTotal(input) {
        const row = input.closest('tr');
        const rate = parseFloat(row.querySelector('.tax-rate')?.value || 0);
        const claimedAmount = Array.from(document.querySelectorAll('#expensesBody .expense-amount'))
            .reduce((sum, field) => sum + (parseFloat(field.value) || 0), 0);
        const amount = claimedAmount * rate / 100;
        row.querySelector('.tax-amount').value = amount.toFixed(2);
        row.querySelector('.tax-total').value = (claimedAmount + amount).toFixed(2);
    }

    function addAdvanceRow(advance = '', advancePaid = '', unclaimed = '', allocated = '') {
        const i = advanceIdx++;

        const row = `
            <tr>
                <td>${i + 1}</td>
                <td>
                    <div class="erp-link-wrapper">
                        <input name="Advances[${i}].EmployeeAdvance"
                               value="${esc(advance)}"
                               class="form-control form-control-sm advance-input"
                               placeholder="Select employee advance"
                               autocomplete="off"
                               oninput="loadErpLinkDropdown(this, 'Employee Advance')"
                               onfocus="loadErpLinkDropdown(this, 'Employee Advance')" />
                        <div class="erp-link-dropdown d-none"></div>
                    </div>
                </td>
                <td>
                    <input type="date"
                           name="Advances[${i}].PostingDate"
                           class="form-control form-control-sm advance-posting-date"
                           value="${today()}" />
                </td>
                <td>
                    <input type="number"
                           step="0.01"
                           name="Advances[${i}].AdvancePaid"
                           value="${esc(advancePaid)}"
                           class="form-control form-control-sm advance-paid" />
                </td>
                <td>
                    <input type="number"
                           step="0.01"
                           name="Advances[${i}].UnclaimedAmount"
                           value="${esc(unclaimed)}"
                           class="form-control form-control-sm advance-unclaimed" />
                </td>
                <td>
                    <input type="number"
                           step="0.01"
                           name="Advances[${i}].AllocatedAmount"
                           value="${esc(allocated)}"
                           class="form-control form-control-sm advance-allocated" />
                </td>
                <td class="text-center">
                    <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            onclick="this.closest('tr').remove()">×</button>
                </td>
            </tr>`;

        document.getElementById('advancesBody').insertAdjacentHTML('beforeend', row);
    }

    function autoFillAdvanceData(input) {
        const opt = findOption('advanceList', input.value);
        if (!opt) return;

        const row = input.closest('tr');

        const postingDate = opt.getAttribute('data-posting-date') || '';
        const advanceAmount = parseFloat(opt.getAttribute('data-advance-amount') || 0);
        const paidAmount = parseFloat(opt.getAttribute('data-paid-amount') || 0);
        const claimedAmount = parseFloat(opt.getAttribute('data-claimed-amount') || 0);

        const unclaimed = Math.max(advanceAmount - claimedAmount, 0);

        const postingDateInput = row.querySelector('.advance-posting-date');
        const paidInput = row.querySelector('.advance-paid');
        const unclaimedInput = row.querySelector('.advance-unclaimed');
        const allocatedInput = row.querySelector('.advance-allocated');

        if (postingDateInput && postingDate) {
            postingDateInput.value = postingDate.substring(0, 10);
        }

        if (paidInput) {
            paidInput.value = paidAmount > 0 ? paidAmount.toFixed(2) : advanceAmount.toFixed(2);
        }

        if (unclaimedInput) {
            unclaimedInput.value = unclaimed.toFixed(2);
        }

        if (allocatedInput && !allocatedInput.value) {
            allocatedInput.value = unclaimed.toFixed(2);
        }
    }

    document.addEventListener('click', function (e) {
        document.querySelectorAll('.erp-link-dropdown').forEach(dropdown => {
            const wrapper = dropdown.closest('.erp-link-wrapper');

            if (wrapper && !wrapper.contains(e.target)) {
                dropdown.classList.add('d-none');
            }
        });
    });

    document.addEventListener('DOMContentLoaded', function () {
        if (!document.getElementById('expensesBody').children.length) {
            addExpenseRow();
        }

        const companyInput = document.getElementById('Company');
        if (companyInput && companyInput.value) {
            autoFillCompanyData(companyInput.value);
        }
    });
</script>
