@model Erp_Aits.Models.ExpenseClaim

@{
    ViewBag.Title = "New Expense Claim";
}

<datalist id="employeeList">
    @if (ViewBag.Employees != null)
    {
        foreach (var emp in ViewBag.Employees)
        {
            <option value="@emp.name"
                    data-name="@emp.employee_name"
                    data-department="@emp.department"
                    data-company="@emp.company">
                @emp.employee_name (@emp.name)
            </option>
        }
    }
</datalist>

<datalist id="userList">
    @if (ViewBag.Users != null)
    {
        foreach (var u in ViewBag.Users)
        {
            <option value="@u.name">@u.full_name (@u.name)</option>
        }
    }
</datalist>

<datalist id="departmentList">
    @if (ViewBag.Departments != null)
    {
        foreach (var d in ViewBag.Departments)
        {
            <option value="@d.name" data-company="@d.company">@d.name</option>
        }
    }
</datalist>

<datalist id="companyList">
    @if (ViewBag.Companies != null)
    {
        foreach (var c in ViewBag.Companies)
        {
            <option value="@c.name"
                    data-gstin="@c.gstin"
                    data-payable="@c.default_payable_account"
                    data-cost-center="@c.cost_center">
                @c.name
            </option>
        }
    }
</datalist>

<datalist id="companyGstinList">
    @if (ViewBag.Companies != null)
    {
        foreach (var c in ViewBag.Companies)
        {
            <option value="@c.gstin">@c.name</option>
        }
    }
</datalist>

<datalist id="expenseTypeList">
    @if (ViewBag.ExpenseTypes != null)
    {
        foreach (var t in ViewBag.ExpenseTypes)
        {
            <option value="@t.name">@t.name</option>
        }
    }
</datalist>

<datalist id="accountList">
    @if (ViewBag.Accounts != null)
    {
        foreach (var acc in ViewBag.Accounts)
        {
            <option value="@acc.name"
                    data-company="@acc.company"
                    data-account-type="@acc.account_type"
                    data-root-type="@acc.root_type">
                @acc.name
            </option>
        }
    }
</datalist>

<datalist id="advanceList">
    @if (ViewBag.EmployeeAdvances != null)
    {
        foreach (var adv in ViewBag.EmployeeAdvances)
        {
            <option value="@adv.name"
                    data-employee="@adv.employee"
                    data-posting-date="@adv.posting_date"
                    data-advance-amount="@adv.advance_amount"
                    data-paid-amount="@adv.paid_amount"
                    data-claimed-amount="@adv.claimed_amount">
                @adv.name
            </option>
        }
    }
</datalist>

<datalist id="projectList">
    @if (ViewBag.Projects != null)
    {
        foreach (var p in ViewBag.Projects)
        {
            <option value="@p.name" data-company="@p.company">@(p.project_name ?? p.name)</option>
        }
    }
</datalist>

<datalist id="costCenterList">
    @if (ViewBag.CostCenters != null)
    {
        foreach (var cc in ViewBag.CostCenters)
        {
            <option value="@cc.name" data-company="@cc.company">@cc.name</option>
        }
    }
</datalist>

<datalist id="dunningList">
    @if (ViewBag.Dunnings != null)
    {
        foreach (var item in ViewBag.Dunnings)
        {
            <option value="@item.name"></option>
        }
    }
</datalist>
<datalist id="aiAuditLogList">
    @if (ViewBag.AiAuditLogs != null)
    {
        foreach (var item in ViewBag.AiAuditLogs)
        {
            <option value="@item.name"></option>
        }
    }
</datalist>
<datalist id="allowedToTransactWithList">
    @if (ViewBag.AllowedToTransactWithOptions != null)
    {
        foreach (var item in ViewBag.AllowedToTransactWithOptions)
        {
            <option value="@item.name"></option>
        }
    }
</datalist>
<datalist id="appraisalTemplateList">
    @if (ViewBag.AppraisalTemplates != null)
    {
        foreach (var item in ViewBag.AppraisalTemplates)
        {
            <option value="@item.name"></option>
        }
    }
</datalist>

<datalist id="taskList">
    @if (ViewBag.Tasks != null)
    {
        foreach (var t in ViewBag.Tasks)
        {
            <option value="@t.name" data-project="@t.project">@t.subject (@t.name)</option>
        }
    }
</datalist>

<div class="expense-claim-create">
<form action="/HR/CreateExpenseClaim" method="post">
    <div class="ec-header">
        <div>
            <div class="ec-breadcrumb">Expense Claim</div>
            <h4 class="mb-0">New Expense Claim</h4>
        </div>

        <div class="d-flex gap-2">
            <a href="@Url.Action("ExpenseClaimList", "HR")" class="btn ec-btn-secondary btn-sm"><i class="fa-solid fa-arrow-left"></i> Back</a>
            <button type="submit" class="btn ec-btn-primary btn-sm"><i class="fa-solid fa-floppy-disk"></i> Save Draft</button>
        </div>
    </div>

    <ul class="nav ec-tabs mb-3" id="expenseTabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#expensesTab" type="button">
                Expenses & Advances
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#accountingTab" type="button">
                Accounting
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#moreInfoTab" type="button">
                More Info
            </button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="expensesTab">
            <div class="ec-section">
                <h6 class="ec-section-title">Basic Information</h6>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Series</label>
                        <input name="ExpenseClaimCode"
                               class="form-control"
                               value="@ViewBag.NextCode"
                               readonly
                               required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Expense Approver</label>
                        <input name="ExpenseApprover"
                               value="@Model.ExpenseApprover"
                               class="form-control"
                               list="userList"
                               placeholder="Select approver"
                               required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">From Employee</label>
                        <input id="Employee"
                               name="Employee"
                               value="@Model.Employee"
                               class="form-control"
                               list="employeeList"
                               placeholder="Select employee"
                               oninput="autoFillEmployeeData(this.value)"
                               required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Employee Name</label>
                        <input id="EmployeeName"
                               name="EmployeeName"
                               value="@Model.EmployeeName"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Approval Status</label>
                        <select name="ApprovalStatus" class="form-select">
                            <option value="Draft" selected="@(Model.ApprovalStatus == "Draft")">Draft</option>
                            <option value="Approved" selected="@(Model.ApprovalStatus == "Approved")">Approved</option>
                            <option value="Rejected" selected="@(Model.ApprovalStatus == "Rejected")">Rejected</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label ea-form-label">Department</label>

                        <div class="erp-link-wrapper">
                            <input id="Department"
                                   name="Department"
                                   value="@Model.Department"
                                   class="form-control ea-input"
                                   placeholder="Select Department..."
                                   autocomplete="off"
                                   oninput="loadErpLinkDropdown(this, 'Department')"
                                   onfocus="loadErpLinkDropdown(this, 'Department')" />

                            <div class="erp-link-dropdown d-none"></div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Company</label>
                        <input id="Company"
                               name="Company"
                               value="@(string.IsNullOrWhiteSpace(Model.Company) ? "Vinod Cookware India Private Limited" : Model.Company)"
                               class="form-control"
                               list="companyList"
                               placeholder="Select company"
                               oninput="autoFillCompanyData(this.value)"
                               required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Company GSTIN</label>
                        <input id="CompanyGstin"
                               name="CompanyGstin"
                               value="@Model.CompanyGstin"
                               class="form-control"
                               list="companyGstinList"
                               placeholder="Auto-filled from company" />
                    </div>
                </div>
            </div>

            <div class="ec-section">
                <h6 class="ec-section-title">Expenses</h6>

                <div class="table-responsive">
                    <table class="table table-bordered align-middle" id="expensesTable">
                        <thead>
                            <tr>
                                <th style="width:60px;">No.</th>
                                <th>Expense Date</th>
                                <th>Expense Type</th>
                                <th>Description</th>
                                <th>Amount</th>
                                <th>Sanctioned Amount</th>
                                <th style="width:60px;"></th>
                            </tr>
                        </thead>
                        <tbody id="expensesBody"></tbody>
                    </table>
                </div>

                <button type="button" class="btn btn-sm btn-outline-dark" onclick="addExpenseRow()">Add Row</button>
            </div>

            <div class="ec-section">
                <h6 class="ec-section-title">Taxes and Charges</h6>

                <div class="table-responsive">
                    <table class="table table-bordered align-middle" id="taxesTable">
                        <thead>
                            <tr>
                                <th style="width:60px;">No.</th>
                                <th>Account Head</th>
                                <th>Rate</th>
                                <th>Amount</th>
                                <th>Total</th>
                                <th style="width:60px;"></th>
                            </tr>
                        </thead>
                        <tbody id="taxesBody"></tbody>
                    </table>
                </div>

                <button type="button" class="btn btn-sm btn-outline-dark" onclick="addTaxRow()">Add Row</button>
            </div>

            <div class="ec-section">
                <h6 class="ec-section-title">Advances</h6>

                <div class="table-responsive">
                    <table class="table table-bordered align-middle" id="advancesTable">
                        <thead>
                            <tr>
                                <th style="width:60px;">No.</th>
                                <th>Employee Advance</th>
                                <th>Posting Date</th>
                                <th>Advance Paid</th>
                                <th>Unclaimed Amount</th>
                                <th>Allocated Amount</th>
                                <th style="width:60px;"></th>
                            </tr>
                        </thead>
                        <tbody id="advancesBody"></tbody>
                    </table>
                </div>

                <button type="button" class="btn btn-sm btn-outline-dark" onclick="addAdvanceRow()">Add Row</button>
            </div>
        </div>

        <div class="tab-pane fade" id="accountingTab">
            <div class="ec-section">
                <h6 class="ec-section-title">Accounting Details</h6>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Posting Date</label>
                        <input name="PostingDate"
                               type="date"
                               class="form-control"
                               value="@(Model.PostingDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))"
                               required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Clearance Date</label>
                        <input name="ClearanceDate"
                               type="date"
                               class="form-control"
                               value="@(Model.ClearanceDate?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Payable Account</label>
                        <input id="PayableAccount"
                               name="PayableAccount"
                               value="@Model.PayableAccount"
                               class="form-control"
                               list="accountList"
                               placeholder="Select payable account" />
                    </div>

                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check">
                            <input name="IsPaid" value="true" type="checkbox" class="form-check-input" @(Model.IsPaid ? "checked" : "") />
                            <input name="IsPaid" value="false" type="hidden" />
                            <label class="form-check-label">Is Paid</label>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Remark</label>
                        <textarea name="Remark" class="form-control" rows="3">@Model.Remark</textarea>
                    </div>
                </div>
            </div>

            <div class="ec-section">
                <h6 class="ec-section-title">Accounting Dimensions</h6>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Project</label>
                        <input id="Project"
                               name="Project"
                               value="@Model.Project"
                               class="form-control"
                               list="projectList"
                               placeholder="Select project" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Cost Center</label>
                        <input id="CostCenter"
                               name="CostCenter"
                               value="@Model.CostCenter"
                               class="form-control"
                               list="costCenterList"
                               placeholder="Select cost center" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Dunning</label>
                        <input asp-for="Dunning" class="form-control" list="dunningList" placeholder="Select dunning" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">AI Audit Log</label>
                        <input asp-for="AiAuditLog" class="form-control" list="aiAuditLogList" placeholder="Select AI audit log" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Allowed To Transact With</label>
                        <input asp-for="AllowedToTransactWith" class="form-control" list="allowedToTransactWithList" placeholder="Select party" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Appraisal Template</label>
                        <input asp-for="AppraisalTemplate" class="form-control" list="appraisalTemplateList" placeholder="Select appraisal template" />
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="moreInfoTab">
            <div class="ec-section">
                <h6 class="ec-section-title">More Info</h6>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Status</label>
                        <select name="Status" class="form-select">
                            <option value="Draft" selected="@(Model.Status == "Draft")">Draft</option>
                            <option value="Submitted" selected="@(Model.Status == "Submitted")">Submitted</option>
                            <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Cancelled</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Task</label>
                        <input id="Task"
                               name="Task"
                               value="@Model.Task"
                               class="form-control"
                               list="taskList"
                               placeholder="Select task" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
</div>

<style>
