@{
    ViewBag.Title = "New Salary Structure";
    var companies = ViewBag.StructureCompanies as List<string> ?? new List<string>();
    var letterHeads = ViewBag.StructureLetterHeads as List<string> ?? new List<string>();
    var currencies = ViewBag.StructureCurrencies as List<string> ?? new List<string>();
    var modesOfPayment = ViewBag.StructureModesOfPayment as List<string> ?? new List<string>();
    var accounts = ViewBag.StructureAccounts as List<string> ?? new List<string>();
    var earnings = ViewBag.StructureEarnings as List<string> ?? new List<string>();
    var deductions = ViewBag.StructureDeductions as List<string> ?? new List<string>();
}

<style>
    .erp-form-page {
        max-width: 1210px;
        margin: 0 auto;
        padding:26px; background:#eaf0f6; border:1px solid #d4e0eb; border-radius:8px;
    }

    .erp-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
        padding:20px 24px; background:#14253d; border-radius:7px;
    }

    .erp-title-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .menu-icon {
        border: 0;
        background: transparent;
        font-size: 20px;
        color: #6b7280;
    }

    .erp-title {
        font-size: 20px;
        font-weight: 700;
        color:#fff;
    }

    .not-saved {
        color: #d9480f;
        background: #fff1e8;
        border-radius: 999px;
        padding: 3px 9px;
        font-size: 12px;
        margin-left: 8px;
    }

    .save-btn {
        background: #0f766e;
        color: #fff;
        border: 0;
        border-radius: 8px;
        padding: 7px 14px;
        font-weight: 600;
    }

    .erp-card {
        background: #fff;
        border: 1px solid #cbd8e5;
        border-radius: 8px;
        overflow: hidden;
    }

    .tab-row {
        display: flex;
        gap: 28px;
        background:#f4f8fc; border-bottom: 1px solid #dbe3ec;
        padding: 0 20px;
    }

    .tab-btn {
        border: 0;
        background: transparent;
        padding: 13px 0;
        font-size: 14px;
        color: #374151;
        border-bottom: 2px solid transparent;
    }

        .tab-btn.active {
            color: #111827;
            font-weight: 700;
            border-bottom-color: #111827;
        }

    .tab-pane {
        display: none;
        padding: 18px 20px;
    }

        .tab-pane.active {
            display: block;
        }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px 28px;
    }

    .field-label {
        display: block;
        font-size: 13px;
        margin-bottom: 7px;
        color: #374151;
    }

    .required {
        color: #dc2626;
    }

    .erp-input, .erp-select {
        width: 100%;
        height: 34px;
        border: 1px solid #b8c7d7;
        background: #fbfdff;
        border-radius: 8px;
        padding: 7px 10px;
        font-size: 14px;
    }

    .check-row {
        display: flex;
        gap: 8px;
        align-items: center;
        font-size: 14px;
        margin-top: 4px;
    }

    .child-label {
        font-size: 13px;
        margin-bottom: 8px;
        display: block;
    }

    .child-table {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        overflow: hidden;
    }

        .child-table th {
            background: #f3f3f3;
            padding: 8px;
            color: #6b7280;
            font-size: 13px;
            font-weight: 500;
            border-bottom: 1px solid #e5e7eb;
        }

        .child-table td {
            padding: 8px;
            text-align: center;
            border-bottom: 1px solid #e5e7eb;
            font-size: 13px;
        }

        .child-table input {
            width: 100%;
            height: 30px;
            border: 1px solid #e5e7eb;
            background: #fff;
            border-radius: 6px;
            padding: 4px 7px;
            font-size: 13px;
        }

    .empty-cell {
        height: 92px;
        color: #6b7280;
    }

    .add-row-btn {
        margin-top: 10px;
        background: #f3f4f6;
        border: 0;
        border-radius: 7px;
        padding: 6px 12px;
        font-size: 13px;
    }

    .help-link {
        margin-top: 18px;
        border: 0;
        background: transparent;
        padding: 0;
        color: #374151;
        font-size: 13px;
    }

    .modal-backdrop-custom {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.58);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }

    .modal-box {
        width: 545px;
        max-width: calc(100% - 30px);
        background: #fff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 12px 35px rgba(0,0,0,.25);
    }

    .modal-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 20px;
        border-bottom: 1px solid #e5e7eb;
        font-weight: 700;
    }

    .modal-body {
        padding: 18px 20px;
        line-height: 1.6;
        font-size: 14px;
    }

        .modal-body h4 {
            font-weight: 700;
            margin: 0 0 12px;
        }

        .modal-body code {
            color: #7c3aed;
            background: transparent;
            font-size: 13px;
        }
</style>

<div class="erp-form-page">
    <form method="post" action="@Url.Action("CreateSalaryStructure", "HR")">
        @Html.AntiForgeryToken()
        @if (TempData["ErpNextError"] != null) { <div class="alert alert-danger">@TempData["ErpNextError"]</div> }
        <div class="erp-header">
            <div class="erp-title-left">
                <button type="button" class="menu-icon">≡</button>
                <span class="erp-title">New Salary Structure</span>
                <span class="not-saved">Not Saved</span>
            </div>
            <button type="submit" class="save-btn">Save</button>
        </div>

        <div class="erp-card">
            <div class="tab-row">
                <button type="button" class="tab-btn active" data-tab="details">Details</button>
                <button type="button" class="tab-btn" data-tab="earningDeduction">Earnings &amp; Deductions</button>
                <button type="button" class="tab-btn" data-tab="account">Account</button>
            </div>

            <div id="details" class="tab-pane active">
                <div class="form-grid">
                    <div>
                        <label class="field-label">Name <span class="required">*</span></label>
                        <input type="text" name="Name" class="erp-input" />

                        <label class="field-label mt-3">Company <span class="required">*</span></label>
                        <select id="structureCompany" name="Company" class="erp-select"><option value="">Select company</option>@foreach(var option in companies) { <option value="@option">@option</option> }</select>

                        <label class="field-label mt-3">Letter Head</label>
                        <select name="LetterHead" class="erp-select"><option value="">Select letter head</option>@foreach(var option in letterHeads) { <option value="@option">@option</option> }</select>
                    </div>

                    <div>
                        <label class="field-label">Is Active <span class="required">*</span></label>
                        <select name="IsActive" class="erp-select">
                            <option value="Yes">Yes</option>
                            <option value="No">No</option>
                        </select>

                        <label class="field-label mt-3">Currency <span class="required">*</span></label>
                        <select name="Currency" class="erp-select"><option value="">Select currency</option>@foreach(var option in currencies) { <option value="@option">@option</option> }</select>

                        <label class="field-label mt-3">Is Default</label>
                        <select name="IsDefault" class="erp-select"><option>No</option><option>Yes</option></select>
                    </div>

                    <div>
                        <label class="field-label">Leave Encashment Amount Per Day (INR)</label>
                        <input type="number" step="0.01" name="LeaveEncashmentAmountPerDay" class="erp-input" />

                        <label class="field-label mt-3">Max Benefits (Amount) (INR)</label>
                        <input type="number" step="0.01" name="MaxBenefitsAmount" class="erp-input" />
                    </div>

                    <div>
                        <label class="check-row">
                            <input type="checkbox" name="SalarySlipBasedOnTimesheet" />
                            <span>Salary Slip Based on Timesheet</span>
                        </label>

                        <label class="field-label mt-4">Payroll Frequency <span class="required">*</span></label>
                        <select name="PayrollFrequency" class="erp-select">
                            <option>Monthly</option>
                            <option>Bimonthly</option>
                            <option>Fortnightly</option>
                            <option>Weekly</option>
                            <option>Daily</option>
                        </select>

                        <label class="field-label mt-3">Salary Component</label><select name="SalaryComponent" class="erp-select"><option value="">Select salary component</option>@foreach(var option in earnings) { <option value="@option">@option</option> }</select>
                        <label class="field-label mt-3">Hour Rate</label><input type="number" step="0.01" name="HourRate" class="erp-input" />
                    </div>
                </div>
            </div>

            <div id="earningDeduction" class="tab-pane">
                <label class="child-label">Earnings</label>
                <table class="child-table">
                    <thead>
                        <tr>
                            <th style="width:45px;"><input type="checkbox" /></th>
                            <th style="width:70px;">No.</th>
                            <th>Component <span class="required">*</span></th>
                            <th>Abbr</th>
                            <th>Amount</th>
                            <th>Depends on Payment Days</th>
                            <th>Is Tax Applicable</th>
                            <th style="width:55px;">Gear</th>
                        </tr>
                    </thead>
                    <tbody id="earningsBody">
                        <tr id="earningsEmpty"><td colspan="8" class="empty-cell">No Data</td></tr>
                    </tbody>
                </table>
                <button type="button" class="add-row-btn" onclick="addStructureRow('earningsBody','earningsEmpty')">Add Row</button>

                <label class="child-label mt-4">Deductions</label>
                <table class="child-table">
                    <thead>
                        <tr>
                            <th style="width:45px;"><input type="checkbox" /></th>
                            <th style="width:70px;">No.</th>
                            <th>Component <span class="required">*</span></th>
                            <th>Abbr</th>
                            <th>Amount</th>
                            <th>Depends on Payment Days</th>
                            <th>Is Tax Applicable</th>
                            <th style="width:55px;">Gear</th>
                        </tr>
                    </thead>
                    <tbody id="deductionsBody">
                        <tr id="deductionsEmpty"><td colspan="8" class="empty-cell">No Data</td></tr>
                    </tbody>
                </table>
                <button type="button" class="add-row-btn" onclick="addStructureRow('deductionsBody','deductionsEmpty')">Add Row</button>

                <br />
                <button type="button" class="help-link" onclick="openFormulaHelp()">Condition and Formula Help</button>
            </div>

            <div id="account" class="tab-pane">
                <div class="form-grid">
                    <div>
                        <label class="field-label">Mode of Payment</label>
                        <select id="structureModeOfPayment" name="ModeOfPayment" class="erp-select"><option value="">Select mode of payment</option>@foreach(var option in modesOfPayment) { <option value="@option">@option</option> }</select>
                    </div>

                    <div>
                        <label class="field-label">Payment Account</label>
                        <select id="structurePaymentAccount" name="PaymentAccount" class="erp-select"><option value="">Select payment account</option>@foreach(var option in accounts) { <option value="@option">@option</option> }</select>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<div id="formulaHelpModal" class="modal-backdrop-custom">
    <div class="modal-box">
        <div class="modal-head">
            <span>Condition and Formula Help</span>
            <button type="button" onclick="closeFormulaHelp()" style="border:0;background:transparent;font-size:22px;">x</button>
        </div>
        <div class="modal-body">
            <h4>Variables</h4>
            <ul>
                <li>Variables from Salary Structure Assignment:<br /><code>base = Base, variable = Variable</code> etc.</li>
                <li>Variables from Employee:<br /><code>Employment Type = employment_type, Branch = branch</code> etc.</li>
                <li>Variables from Salary Slip:<br /><code>Payment Days = payment_days, Leave without pay = leave_without_pay</code> etc.</li>
                <li>Abbreviation from Salary Component:<br /><code>BS = Basic Salary</code> etc.</li>
                <li>Some additional variables:<br /><code>gross_pay</code> and <code>annual_taxable_earning</code> can also be used.</li>
                <li>Direct Amount can also be used</li>
            </ul>

            <h4>Examples for Conditions and formula</h4>
            <ul>
                <li>Calculating Basic Salary based on <code>base</code><br /><code>Condition: base &lt; 10000</code><br /><br /><code>Formula: base * .2</code></li>
                <li>Calculating HRA based on Basic Salary <code>BS</code><br /><code>Condition: BS &gt; 2000</code><br /><br /><code>Formula: BS * .1</code></li>
                <li>Calculating TDS based on Employment Type <code>employment_type</code><br /><code>Condition: employment_type=="Intern"</code><br /><br /><code>Amount: 1000</code></li>
                <li>Calculating Income Tax based on <code>annual_taxable_earning</code><br /><code>Condition: annual_taxable_earning &gt; 2000000</code><br /><br /><code>Formula: annual_taxable_earning * 0.10</code></li>
            </ul>
        </div>
    </div>
</div>

<script>
    const structureEarnings = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(earnings));
    const structureDeductions = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(deductions));
    document.querySelectorAll('.tab-btn').forEach(function (button) {
        button.addEventListener('click', function () {
            document.querySelectorAll('.tab-btn').forEach(x => x.classList.remove('active'));
            document.querySelectorAll('.tab-pane').forEach(x => x.classList.remove('active'));
            button.classList.add('active');
            document.getElementById(button.dataset.tab).classList.add('active');
        });
    });

       function addStructureRow(bodyId, emptyId) {
        const body = document.getElementById(bodyId);
        const empty = document.getElementById(emptyId);

        if (empty) {
            empty.remove();
        }

        const rowNo = body.querySelectorAll('tr').length + 1;
        const row = document.createElement('tr');

        row.innerHTML = `
            <td><input type="checkbox" /></td>
            <td>${rowNo}</td>
            <td><select name="${bodyId === 'earningsBody' ? 'EarningsComponents' : 'DeductionsComponents'}">${['<option value="">Select component</option>'].concat((bodyId === 'earningsBody' ? structureEarnings : structureDeductions).map(value => '<option value="' + value.replace(/"/g, '&quot;') + '">' + value + '</option>')).join('')}</select></td>
            <td><input type="text" name="${bodyId}Abbrs" /></td>
            <td><input type="number" step="0.01" name="${bodyId === 'earningsBody' ? 'EarningsAmounts' : 'DeductionsAmounts'}" /></td>
            <td><input type="checkbox" name="${bodyId}DependsOnPaymentDays" /></td>
            <td><input type="checkbox" name="${bodyId}IsTaxApplicable" /></td>
            <td>⚙</td>
        `;

        body.appendChild(row);
        enhanceLargeSelects(row);
    }
    function openFormulaHelp() {
        document.getElementById('formulaHelpModal').style.display = 'flex';
    }

    function closeFormulaHelp() {
        document.getElementById('formulaHelpModal').style.display = 'none';
    }

    async function loadStructurePaymentAccount() {
        const company = document.getElementById('structureCompany');
        const modeOfPayment = document.getElementById('structureModeOfPayment');
        const paymentAccount = document.getElementById('structurePaymentAccount');

        if (!company.value || !modeOfPayment.value) return;

        try {
            const response = await fetch('/HR/GetPaymentEntryModeOfPaymentDetails?modeOfPayment='
                + encodeURIComponent(modeOfPayment.value)
                + '&company=' + encodeURIComponent(company.value));
            const data = await response.json();

            if (!data.success || !data.defaultAccount) return;

            if (!Array.from(paymentAccount.options).some(option => option.value === data.defaultAccount)) {
                paymentAccount.add(new Option(data.defaultAccount, data.defaultAccount));
            }

            paymentAccount.value = data.defaultAccount;
            const paymentAccountSearchInput = paymentAccount.parentElement.querySelector('input.erp-input');
            if (paymentAccount.dataset.searchSelectReady && paymentAccountSearchInput) {
                paymentAccountSearchInput.value = data.defaultAccount;
            }
            paymentAccount.dispatchEvent(new Event('change'));
        } catch (error) {
            console.error('Could not load the payment account for the selected mode of payment.', error);
        }
    }

    document.getElementById('structureModeOfPayment').addEventListener('change', loadStructurePaymentAccount);
    document.getElementById('structureCompany').addEventListener('change', loadStructurePaymentAccount);

    function enhanceLargeSelects(scope) {
        scope.querySelectorAll('select').forEach(function (select) {
            if (select.dataset.searchSelectReady || select.options.length <= 11) return;
            select.dataset.searchSelectReady = 'true';
            const wrapper = document.createElement('div'); wrapper.style.position = 'relative';
            const input = document.createElement('input'); input.type = 'text'; input.className = 'erp-input'; input.placeholder = select.options[0].text;
            const menu = document.createElement('div'); menu.className = 'search-select-menu'; menu.style.cssText = 'display:none;position:fixed;z-index:3000;max-height:260px;overflow:auto;background:#fff;border:1px solid #94a3b8;border-radius:6px;box-shadow:0 10px 20px rgba(15,23,42,.18)';
            select.parentNode.insertBefore(wrapper, select); wrapper.appendChild(input); wrapper.appendChild(menu); wrapper.appendChild(select); select.style.display = 'none';
            const values = Array.from(select.options).slice(1).map(option => ({ value: option.value, text: option.text }));
            function render(term) { const matches = values.filter(value => value.text.toLowerCase().startsWith(term.toLowerCase())).slice(0,10); menu.innerHTML = matches.map(value => '<button type="button" data-value="' + value.value.replace(/"/g,'&quot;') + '" style="display:block;width:100%;padding:8px 10px;border:0;background:#fff;text-align:left">' + value.text + '</button>').join('') || '<span style="display:block;padding:9px 10px">No matching option</span>'; const box=input.getBoundingClientRect(); menu.style.left=box.left+'px'; menu.style.top=(box.bottom+4)+'px'; menu.style.width=box.width+'px'; menu.style.display='block'; }
            input.addEventListener('focus', () => render(input.value)); input.addEventListener('input', () => render(input.value)); menu.addEventListener('click', event => { const value=event.target.dataset.value; if(!value)return; select.value=value; input.value=event.target.textContent; menu.style.display='none'; select.dispatchEvent(new Event('change')); }); document.addEventListener('click', event => {if(!wrapper.contains(event.target)) menu.style.display='none';});
        });
    }
    enhanceLargeSelects(document);
</script>
