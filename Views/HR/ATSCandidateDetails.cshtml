@model Erp_Aits.Models.ATSCandidate
@{
    ViewBag.Title = Model.CandidateName;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0">@Model.CandidateName</h4>
        <small class="text-muted">@Model.ATSCandidateCode</small>
    </div>
    <a href="@Url.Action("ATSCandidate", "HR")" class="btn btn-outline-dark btn-sm">Back to List</a>
</div>

<div class="card p-4 mb-3">
    <h6 class="mb-3">Stats</h6>
    <div class="row g-3">
        <div class="col-md-6"><span class="badge bg-secondary-subtle text-secondary">@Model.CandidateStatus</span></div>
        <div class="col-md-6"><span class="badge bg-secondary-subtle text-secondary">ATS Score: @Model.ATSScore%</span></div>
    </div>
</div>

<div class="card p-4 mb-3">
    <h6 class="mb-3">Candidate Profile</h6>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">Candidate Name</label><div class="form-control bg-light">@Model.CandidateName</div></div>
        <div class="col-md-6"><label class="form-label">Applied Job</label><div class="form-control bg-light">@Model.AppliedJob</div></div>
        <div class="col-md-6"><label class="form-label">Email</label><div class="form-control bg-light">@Model.Email</div></div>
        <div class="col-md-6"><label class="form-label">Candidate Status</label><div class="form-control bg-light">@Model.CandidateStatus</div></div>
        <div class="col-md-6"><label class="form-label">Phone</label><div class="form-control bg-light">@Model.Phone</div></div>
        <div class="col-md-6"><label class="form-label">Source</label><div class="form-control bg-light">@Model.Source</div></div>
    </div>
</div>

<div class="card p-4 mb-3">
    <h6 class="mb-3">ATS Scoring</h6>
    <label class="form-label">Skills</label>
    <div class="form-control bg-light mb-3" style="min-height:80px;">@Model.Skills</div>

    <label class="form-label">Candidate Skill Matrix</label>
    <table class="table table-bordered">
        <thead><tr><th>No.</th><th>Skill</th><th>Experience</th><th>Rating</th></tr></thead>
        <tbody>
            @{
                int i = 1;
            }
            @foreach (var s in Model.SkillMatrix)
            {
                <tr><td>@(i++)</td><td>@s.Skill</td><td>@s.Experience</td><td>@s.Rating</td></tr>
            }
        </tbody>
    </table>
</div>

<div class="card p-4 mb-3">
    <h6 class="mb-3">Experience and Offer Fit</h6>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">Experience</label><div class="form-control bg-light">@Model.Experience</div></div>
        <div class="col-md-6"><label class="form-label">Current Company</label><div class="form-control bg-light">@Model.CurrentCompany</div></div>
        <div class="col-md-6"><label class="form-label">Expected Salary</label><div class="form-control bg-light">@Model.ExpectedSalary</div></div>
        <div class="col-md-6"><label class="form-label">Notice Period</label><div class="form-control bg-light">@Model.NoticePeriod</div></div>
    </div>
</div>

<div class="card p-4">
    <h6 class="mb-3">Recruiter Review</h6>
    <label class="form-label">Recruiter Notes</label>
    <div class="form-control bg-light mb-3" style="min-height:100px;">@Model.RecruiterNotes</div>
    <label class="form-label">Interview Rating</label>
    <div>@(new string('★', Model.InterviewRating ?? 0))@(new string('☆', 5 - (Model.InterviewRating ?? 0)))</div>
</div>