@using Newtonsoft.Json.Linq
@{ViewBag.Title="Employee Benefit Claim Details";var d=ViewBag.Document as JObject;string V(string k)=>d?[k]?.ToString()??"";var employeeFields=new[]{("Employee","employee"),("Employee Name","employee_name"),("Department","department"),("Claim Date","claim_date"),("Currency","currency"),("Company","company"),("Amended From","amended_from")};var benefitFields=new[]{("Claim Benefit For","earning_component"),("Max Amount Eligible","max_amount_eligible"),("Pay Against Benefit Claim","pay_against_benefit_claim"),("Claimed Amount","claimed_amount"),("Salary Slip","salary_slip"),("Attachments","attachments")};}
<style>.p{max-width:1210px;margin:auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.h{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.h h1{font-size:22px;margin:0}.back{color:#fff;text-decoration:none;border:1px solid #7890a8;border-radius:7px;padding:8px 13px}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px}.s{padding:20px;border-bottom:1px solid #dbe3ec}.s h2{font-size:17px;margin:0 0 16px;color:#14253d}.g{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.f label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.v{min-height:36px;padding:8px 10px;border:1px solid #b8c7d7;border-radius:8px;background:#f2f6f9}</style>
<div class="p"><header class="h"><h1>Employee Benefit Claim Details</h1><a class="back" asp-action="EmployeeBenefitClaim">Back to Benefit Claims</a></header><main class="card"><section class="s"><h2>Employee</h2><div class="g">@foreach(var x in employeeFields){<div class="f"><label>@x.Item1</label><div class="v">@V(x.Item2)</div></div>}</div></section><section class="s"><h2>Benefits</h2><div class="g">@foreach(var x in benefitFields.Take(5)){<div class="f"><label>@x.Item1</label><div class="v">@V(x.Item2)</div></div>}</div></section><section class="s"><h2>Expense Proof</h2><div class="f"><label>Attachments</label><div class="v">@V("attachments")</div></div></section></main></div>
