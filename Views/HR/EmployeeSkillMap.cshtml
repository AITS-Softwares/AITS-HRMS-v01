@model List<Erp_Aits.Models.EmployeeSkillMapListRow>

@{
    ViewBag.Title = "Employee Skill Map";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErpNextError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Employee Skill Map</h4>

    <a href="@Url.Action("CreateEmployeeSkillMap", "HR")"
       class="btn btn-dark btn-sm">
        + Add Employee Skill Map
    </a>
</div>

<form method="get"
      action="@Url.Action("EmployeeSkillMap", "HR")"
      class="row g-2 mb-3">

    <div class="col-auto">
        <input type="text"
               name="id"
               class="form-control form-control-sm"
               placeholder="ID"
               value="@ViewBag.IdFilter" />
    </div>

    <div class="col-auto">
        <input type="text"
               name="employeeName"
               class="form-control form-control-sm"
               placeholder="Employee Name"
               value="@ViewBag.EmployeeNameFilter" />
    </div>

    <div class="col-auto">
        <button type="submit"
                class="btn btn-sm btn-outline-secondary">
            Search
        </button>
    </div>
</form>

<div class="card border rounded-3 p-4 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Employee</th>
                    <th>Employee Name</th>
                    <th>Designation</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr style="cursor:pointer;"
                            onclick="window.location='@Url.Action("EmployeeSkillMapDetails", "HR", new { id = item.Id })'">
                            <td>@item.Id</td>
                            <td>@item.Employee</td>
                            <td>@item.EmployeeName</td>
                            <td>@item.Designation</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4"
                            class="text-center text-muted py-4">
                            No Employee Skill Maps Found
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>