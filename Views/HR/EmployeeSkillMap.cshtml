@model List<Erp_Aits.Models.EmployeeSkillMapListRow>

@{
    ViewBag.Title = "Employee Skill Map";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErpNextError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="skill-map-list-page">
<div class="skill-map-list-page__header d-flex justify-content-between align-items-center mb-3">
    <div><div class="skill-map-list-page__eyebrow">Employee Development</div><h4 class="mb-0">Employee Skill Map</h4></div>

    <a href="@Url.Action("CreateEmployeeSkillMap", "HR")"
       class="btn skill-map-list-page__add btn-sm">
        <i class="fa-solid fa-plus"></i> Add Employee Skill Map
    </a>
</div>

<form method="get"
      action="@Url.Action("EmployeeSkillMap", "HR")"
      class="skill-map-list-page__filters row g-2 mb-3">

    <div class="col-auto">
        <input type="text"
               name="id"
               class="form-control form-control-sm"
               placeholder="ID"
               value="@ViewBag.IdFilter" />
    </div>

    <div class="col-auto">
        <input type="text"
               name="employeeName"
               class="form-control form-control-sm"
               placeholder="Employee Name"
               value="@ViewBag.EmployeeNameFilter" />
    </div>

    <div class="col-auto">
        <button type="submit"
                class="btn skill-map-list-page__search btn-sm">
            <i class="fa-solid fa-magnifying-glass"></i> Search
        </button>
    </div>
</form>

<div class="skill-map-list-page__table card border rounded-3 p-4 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Employee</th>
                    <th>Employee Name</th>
                    <th>Designation</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr style="cursor:pointer;"
                            onclick="window.location='@Url.Action("EmployeeSkillMapDetails", "HR", new { id = item.Id })'">
                            <td>@item.Id</td>
                            <td>@item.Employee</td>
                            <td>@item.EmployeeName</td>
                            <td>@item.Designation</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4"
                            class="text-center text-muted py-4">
                            No Employee Skill Maps Found
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
</div>
<style>
 .skill-map-list-page{background:linear-gradient(135deg,#eef7fb,#f7fbfa 65%,#edf3fb);border:1px solid #d5e5ee;border-radius:8px;padding:24px;color:#183247}.skill-map-list-page__header{background:#15324b;color:#fff;border-radius:8px;padding:19px 21px;box-shadow:0 12px 26px rgba(21,50,75,.16)}.skill-map-list-page__eyebrow{color:#a8d6e5;font-size:12px;font-weight:700;text-transform:uppercase;margin-bottom:4px}.skill-map-list-page__add{background:#0f877d;border:0;color:#fff;font-weight:700}.skill-map-list-page__add i,.skill-map-list-page__search i{margin-right:5px}.skill-map-list-page__filters{margin:16px 0!important;padding:14px;background:#dfeff6;border:1px solid #c4dce8;border-radius:8px}.skill-map-list-page__filters .form-control{border-color:#a9cadb}.skill-map-list-page__search{background:#fff;color:#15324b;border:1px solid #1d6fa5;font-weight:700}.skill-map-list-page__table{border-color:#cfe0eb!important;box-shadow:none!important}.skill-map-list-page__table thead th{background:#e7f4f9!important;color:#15324b}.skill-map-list-page__table tbody tr:hover{background:#edf9f7}
</style>
