@using Erp_Aits.Models
@{ViewBag.Title="New Employee Benefit Claim";var employees=ViewBag.ClaimEmployees as List<PayrollEmployeeOption>??new List<PayrollEmployeeOption>();var currencies=ViewBag.ClaimCurrencies as List<string>??new List<string>();var components=ViewBag.ClaimComponents as List<string>??new List<string>();var slips=ViewBag.ClaimSalarySlips as List<string>??new List<string>();}
<style>.p{max-width:1210px;margin:auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.h{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.h h1{font-size:22px;margin:0}.save{border:0;background:#0f766e;color:#fff;padding:9px 17px;border-radius:7px;font-weight:650}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.s{padding:20px;border-bottom:1px solid #dbe3ec}.s h2{font-size:17px;margin:0 0 16px;color:#14253d}.g{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.f label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.i,.sel{box-sizing:border-box;width:100%;height:36px;border:1px solid #b8c7d7;border-radius:8px;padding:7px 10px;background:#fbfdff}.i[readonly]{background:#f2f6f9}.check{display:flex;gap:9px;align-items:center;height:36px;color:#374151}</style>
<div class="p"><form method="post" enctype="multipart/form-data" asp-action="CreateEmployeeBenefitClaim">@Html.AntiForgeryToken()<header class="h"><h1>New Employee Benefit Claim</h1><button class="save">Save</button></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}<main class="card"><section class="s"><h2>Employee</h2><div class="g"><div class="f"><label>Employee *</label><select name="Employee" id="e" class="sel" required><option value="">Select employee</option>@foreach(var x in employees){<option value="@x.Id" data-name="@x.EmployeeName" data-department="@x.Department" data-company="@x.Company">@x.Id</option>}</select></div><div class="f"><label>Employee Name</label><input id="n" class="i" readonly/></div><div class="f"><label>Department</label><input id="d" class="i" readonly/></div><div class="f"><label>Claim Date *</label><input name="ClaimDate" class="i" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required/></div><div class="f"><label>Currency *</label><select name="Currency" class="sel" required><option value="">Select currency</option>@foreach(var x in currencies){<option value="@x">@x</option>}</select></div><div class="f"><label>Company *</label><input id="co" name="Company" class="i" readonly required/></div><div class="f"><label>Amended From</label><input class="i" readonly/></div></div></section><section class="s"><h2>Benefits</h2><div class="g"><div class="f"><label>Claim Benefit For *</label><select name="EarningComponent" class="sel" required><option value="">Select salary component</option>@foreach(var x in components){<option value="@x">@x</option>}</select></div><div class="f"><label>Max Amount Eligible</label><input class="i" readonly/></div><div class="f"><label>Pay Against Benefit Claim</label><label class="check"><input name="PayAgainstBenefitClaim" type="checkbox"/> Pay against benefit claim</label></div><div class="f"><label>Claimed Amount *</label><input name="ClaimedAmount" class="i" type="number" min="0" step="0.01" required/></div><div class="f"><label>Salary Slip</label><select name="SalarySlip" class="sel"><option value="">Select salary slip</option>@foreach(var x in slips){<option value="@x">@x</option>}</select></div></div></section><section class="s"><h2>Expense Proof</h2><div class="f"><label>Attachments</label><input name="attachments" class="i" type="file"/></div></section></main></form></div><script>e.onchange=()=>{let o=e.options[e.selectedIndex];n.value=o.dataset.name||'';d.value=o.dataset.department||'';co.value=o.dataset.company||''};</script>
