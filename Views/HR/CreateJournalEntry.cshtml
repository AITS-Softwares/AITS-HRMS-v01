@using System.Collections.Generic
@{ViewBag.Title="New Journal Entry";var companies=ViewBag.JournalCompanies as List<string>??new List<string>();var accounts=ViewBag.JournalAccounts as List<string>??new List<string>();var finance=ViewBag.JournalFinanceBooks as List<string>??new List<string>();var templates=ViewBag.JournalTemplates as List<string>??new List<string>();var entries=ViewBag.JournalEntriesForLink as List<string>??new List<string>();var tax=ViewBag.JournalTaxCategories as List<string>??new List<string>();var letters=ViewBag.JournalLetterHeads as List<string>??new List<string>();var heads=ViewBag.JournalPrintHeadings as List<string>??new List<string>();var modes=ViewBag.JournalModes as List<string>??new List<string>();var orders=ViewBag.JournalPaymentOrders as List<string>??new List<string>();var stocks=ViewBag.JournalStockEntries as List<string>??new List<string>();var repeats=ViewBag.JournalRepeats as List<string>??new List<string>();var types=new[]{"Journal Entry","Inter Company Journal Entry","Bank Entry","Cash Entry","Credit Card Entry","Debit Note","Credit Note","Contra Entry","Excise Entry","Write Off Entry","Opening Entry","Depreciation Entry","Exchange Rate Revaluation","Exchange Gain Or Loss","Deferred Revenue","Deferred Expense","Reversal Of ITC","Reclaim of ITC Reversal"};}
<style>.p{max-width:1210px;margin:auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.h{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.h h1{font-size:22px;margin:0}.save{border:0;background:#0f766e;color:#fff;padding:9px 17px;border-radius:7px;font-weight:650}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.s{padding:20px;border-bottom:1px solid #dbe3ec}.s h2{font-size:17px;margin:0 0 16px}.g{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.f label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.i,.sel{box-sizing:border-box;width:100%;height:36px;border:1px solid #b8c7d7;border-radius:8px;padding:7px 10px;background:#fbfdff;font-size:14px}.i[readonly]{background:#f2f6f9;color:#526375}.check{display:flex;align-items:center;gap:8px;padding-top:24px;font-size:14px}.table{width:100%;border-collapse:collapse}.table th,.table td{border:1px solid #dbe3ec;padding:7px}.table input,.table select{width:100%;box-sizing:border-box;height:34px;border:1px solid #b8c7d7;border-radius:6px;padding:5px}.rowbtn{border:0;background:#dce8f1;border-radius:6px;padding:7px 12px;margin-top:10px}.ss{position:relative}.sm{display:none;position:fixed;z-index:3000;max-height:260px;overflow:auto;background:#fff;border:1px solid #94a3b8;border-radius:6px;box-shadow:0 10px 20px rgba(15,23,42,.18)}.sm button{display:block;width:100%;padding:8px 10px;border:0;background:#fff;text-align:left}.sm button:hover{background:#e8f3f3;color:#0f766e}@@media(max-width:800px){.p{padding:12px}.g{grid-template-columns:1fr}.table{display:block;overflow:auto}}</style>
<div class="p"><form method="post" asp-action="CreateJournalEntry">@Html.AntiForgeryToken()<header class="h"><h1>New Journal Entry</h1><button class="save" type="submit">Save</button></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}<main class="card"><section class="s"><h2>Entry Type and Date</h2><div class="g"><label class="check"><input name="IsSystemGenerated" type="checkbox"/> Is System Generated</label><div class="f"><label>Title</label><input class="i" readonly/></div><div class="f"><label>Entry Type *</label><select name="VoucherType" class="sel" required>@foreach(var x in types){<option>@x</option>}</select></div><div class="f"><label>Reversal Type</label><select name="IneligibilityReason" class="sel"><option value="">Select</option><option>As per rules 42 &amp; 43 of CGST Rules</option><option>Others</option></select></div><div class="f"><label>Series *</label><select name="NamingSeries" class="sel" required><option>ACC-JV-.YYYY.-</option></select></div><div class="f"><label>Finance Book</label><select name="FinanceBook" class="sel searchable"><option value="">Select finance book</option>@foreach(var x in finance){<option value="@x">@x</option>}</select></div><div class="f"><label>Process Deferred Accounting</label><input name="ProcessDeferredAccounting" class="i"/></div><div class="f"><label>Reversal Of</label><select name="ReversalOf" class="sel searchable"><option value="">Select Journal Entry</option>@foreach(var x in entries){<option value="@x">@x</option>}</select></div><div class="f"><label>Tax Withholding Category</label><select name="TaxWithholdingCategory" class="sel searchable"><option value="">Select category</option>@foreach(var x in tax){<option value="@x">@x</option>}</select></div><div class="f"><label>From Template</label><select name="FromTemplate" class="sel searchable"><option value="">Select template</option>@foreach(var x in templates){<option value="@x">@x</option>}</select></div><div class="f"><label>Company *</label><select name="Company" class="sel searchable" required><option value="">Select company</option>@foreach(var x in companies){<option value="@x">@x</option>}</select></div><div class="f"><label>Company GSTIN</label><select name="CompanyGstin" id="journalGstin" class="sel"><option value="">Select company first</option></select></div><div class="f"><label>Posting Date *</label><input name="PostingDate" type="date" class="i" required/></div><label class="check"><input name="ApplyTds" type="checkbox"/> Apply Tax Withholding Amount</label></div></section><section class="s"><h2>Accounting Entries</h2><table class="table"><thead><tr><th>Account</th><th>Party Type</th><th>Party</th><th>Debit</th><th>Credit</th></tr></thead><tbody id="rows"><tr><td><select name="Accounts" class="searchable"><option value="">Select account</option>@foreach(var x in accounts){<option value="@x">@x</option>}</select></td><td><select name="PartyTypes"><option value=""></option><option>Customer</option><option>Supplier</option><option>Employee</option></select></td><td><select name="Parties"><option value="">Select party type first</option></select></td><td><input name="Debits" type="number" step="0.01" value="0"/></td><td><input name="Credits" type="number" step="0.01" value="0"/></td></tr></tbody></table><button class="rowbtn" type="button" id="add">Add Row</button></section><section class="s"><h2>Reference and Totals</h2><div class="g"><div class="f"><label>Reference Number</label><input name="ChequeNo" class="i"/></div><div class="f"><label>Reference Date</label><input name="ChequeDate" type="date" class="i"/></div><div class="f"><label>User Remark</label><textarea name="UserRemark" class="i"></textarea></div><div class="f"><label>Total Debit</label><input id="journalDebit" class="i" readonly/></div><div class="f"><label>Total Credit</label><input id="journalCredit" class="i" readonly/></div><div class="f"><label>Difference (Dr - Cr)</label><input id="journalDifference" class="i" readonly/></div><div class="f"><label>Make Difference Entry</label><input class="i" readonly/></div><label class="check"><input name="MultiCurrency" type="checkbox"/> Multi Currency</label><div class="f"><label>Total Amount Currency</label><input class="i" readonly/></div><div class="f"><label>Total Amount</label><input class="i" readonly/></div><div class="f"><label>Total Amount in Words</label><input class="i" readonly/></div></div></section><section class="s"><h2>Reference</h2><div class="g"><div class="f"><label>Clearance Date</label><input name="ClearanceDate" type="date" class="i"/></div><div class="f"><label>Remark</label><textarea name="Remark" class="i"></textarea></div><div class="f"><label>Paid Loan</label><input name="PaidLoan" class="i"/></div><div class="f"><label>Inter Company Journal Entry Reference</label><select name="InterCompanyReference" class="sel searchable"><option value="">Select Journal Entry</option>@foreach(var x in entries){<option value="@x">@x</option>}</select></div><div class="f"><label>Bill No</label><input name="BillNo" class="i"/></div><div class="f"><label>Bill Date</label><input name="BillDate" type="date" class="i"/></div><div class="f"><label>Due Date</label><input name="DueDate" type="date" class="i"/></div><div class="f"><label>Write Off Based On</label><select name="WriteOffBasedOn" class="sel"><option value="">Select</option><option>Accounts Receivable</option><option>Accounts Payable</option></select></div><div class="f"><label>Get Outstanding Invoices</label><input class="i" readonly/></div><div class="f"><label>Write Off Amount</label><input name="WriteOffAmount" type="number" step="0.01" class="i"/></div></div></section><section class="s"><h2>Printing and More Information</h2><div class="g"><div class="f"><label>Pay To / Recd From</label><input name="PayToRecdFrom" class="i"/></div><div class="f"><label>Letter Head</label><select name="LetterHead" class="sel searchable"><option value="">Select letter head</option>@foreach(var x in letters){<option value="@x">@x</option>}</select></div><div class="f"><label>Print Heading</label><select name="PrintHeading" class="sel searchable"><option value="">Select print heading</option>@foreach(var x in heads){<option value="@x">@x</option>}</select></div><div class="f"><label>Mode of Payment</label><select name="ModeOfPayment" class="sel searchable"><option value="">Select mode</option>@foreach(var x in modes){<option value="@x">@x</option>}</select></div><div class="f"><label>Payment Order</label><select name="PaymentOrder" class="sel searchable"><option value="">Select payment order</option>@foreach(var x in orders){<option value="@x">@x</option>}</select></div><label class="check"><input name="PartyNotRequired" type="checkbox"/> Party Not Required</label><div class="f"><label>Is Opening</label><select name="IsOpening" class="sel"><option>No</option><option>Yes</option></select></div><div class="f"><label>Stock Entry</label><select name="StockEntry" class="sel searchable"><option value="">Select stock entry</option>@foreach(var x in stocks){<option value="@x">@x</option>}</select></div><div class="f"><label>Auto Repeat</label><select name="AutoRepeat" class="sel searchable"><option value="">Select auto repeat</option>@foreach(var x in repeats){<option value="@x">@x</option>}</select></div><div class="f"><label>Amended From</label><input class="i" readonly/></div></div></section></main></form></div>
<script>
    (function () {
        const rows = document.getElementById('rows');
        const accountOptions = rows.querySelector('select[name="Accounts"]').innerHTML;
        const partyTypeOptions = rows.querySelector('select[name="PartyTypes"]').innerHTML;

        function enhancePicker(select) {
            if (select.dataset.journalPicker || select.closest('.ss')) return;
            select.dataset.journalPicker = 'true';
            const wrapper = document.createElement('div');
            const input = document.createElement('input');
            const menu = document.createElement('div');
            wrapper.className = 'ss';
            input.className = 'i';
            input.type = 'text';
            input.autocomplete = 'off';
            input.placeholder = select.options[0].text || 'Select';
            menu.className = 'sm';
            select.parentNode.insertBefore(wrapper, select);
            wrapper.append(input, select, menu);
            select.style.display = 'none';

            const draw = () => {
                const query = input.value.trim().toLowerCase();
                const options = Array.from(select.options).filter(option => option.value && option.text.toLowerCase().startsWith(query)).slice(0, 10);
                menu.innerHTML = options.map(option => '<button type="button" data-value="' + option.value.replace(/"/g, '&quot;') + '">' + option.text + '</button>').join('') || '<span>No matching option</span>';
                const box = input.getBoundingClientRect();
                menu.style.left = box.left + 'px';
                menu.style.top = (box.bottom + 4) + 'px';
                menu.style.width = box.width + 'px';
                menu.style.display = 'block';
            };
            input.addEventListener('focus', draw);
            input.addEventListener('input', draw);
            menu.addEventListener('click', event => {
                const selected = event.target.dataset.value;
                if (!selected) return;
                select.value = selected;
                input.value = event.target.textContent;
                menu.style.display = 'none';
                select.dispatchEvent(new Event('change', { bubbles: true }));
            });
            document.addEventListener('click', event => {
                if (!wrapper.contains(event.target) && !menu.contains(event.target)) menu.style.display = 'none';
            });
        }

        document.querySelectorAll('select.searchable, select[name="PartyTypes"]').forEach(enhancePicker);
        document.getElementById('add').onclick = () => {
            const row = document.createElement('tr');
            row.innerHTML = '<td><select name="Accounts" class="searchable">' + accountOptions + '</select></td><td><select name="PartyTypes" class="searchable">' + partyTypeOptions + '</select></td><td><select name="Parties"><option value="">Select party type first</option></select></td><td><input name="Debits" type="number" step="0.01" value="0" /></td><td><input name="Credits" type="number" step="0.01" value="0" /></td>';
            rows.appendChild(row);
            row.querySelectorAll('select.searchable').forEach(enhancePicker);
        };

        function totals() {
            let debit = 0, credit = 0;
            rows.querySelectorAll('tr').forEach(row => {
                debit += Math.round((Number(row.querySelector('[name="Debits"]').value) || 0) * 100);
                credit += Math.round((Number(row.querySelector('[name="Credits"]').value) || 0) * 100);
            });
            document.getElementById('journalDebit').value = (debit / 100).toFixed(2);
            document.getElementById('journalCredit').value = (credit / 100).toFixed(2);
            document.getElementById('journalDifference').value = ((debit - credit) / 100).toFixed(2);
        }
        rows.addEventListener('input', totals);
        totals();

        async function loadParties(row) {
            const type = row.querySelector('[name="PartyTypes"]').value;
            const party = row.querySelector('[name="Parties"]');
            party.replaceChildren(new Option(type ? 'Loading parties...' : 'Select party type first', ''));
            if (!type) return;
            try {
                const response = await fetch('/HR/GetPartiesByDocType?doctype=' + encodeURIComponent(type));
                if (!response.ok) throw new Error('Could not load parties from ERPNext.');
                const data = await response.json();
                if (row.querySelector('[name="PartyTypes"]').value !== type) return;
                party.replaceChildren(new Option(data.length ? 'Select party' : 'No parties found', ''));
                data.forEach(item => party.add(new Option(item.title && item.title !== item.name ? item.name + ' - ' + item.title : item.name, item.name)));
            } catch (error) { party.replaceChildren(new Option('Could not load parties', '')); alert(error.message); }
        }

        rows.addEventListener('change', async event => {
            const row = event.target.closest('tr');
            if (event.target.name === 'PartyTypes') await loadParties(row);
            if (event.target.name !== 'Accounts') return;
            const account = event.target.value;
            const type = row.querySelector('[name="PartyTypes"]');
            type.value = '';
            type.closest('.ss').querySelector('input').value = '';
            await loadParties(row);
            if (!account) return;
            try {
                const response = await fetch('/HR/JournalAccountPartyType?account=' + encodeURIComponent(account));
                const data = await response.json();
                if (!response.ok) throw new Error(data.message || 'Could not load account details.');
                if (event.target.value !== account) return;
                type.value = data.partyType || '';
                type.closest('.ss').querySelector('input').value = type.value;
                await loadParties(row);
            } catch (error) { alert(error.message); }
        });

        const company = document.querySelector('[name="Company"]');
        const gstin = document.getElementById('journalGstin');
        company.addEventListener('change', async () => {
            const selected = company.value;
            gstin.replaceChildren(new Option(selected ? 'Loading GSTINs...' : 'Select company first', ''));
            if (!selected) return;
            try {
                const response = await fetch('/HR/JournalCompanyGstins?company=' + encodeURIComponent(selected));
                const data = await response.json();
                if (!response.ok) throw new Error(data.message || 'Could not load company GSTINs.');
                if (company.value !== selected) return;
                gstin.replaceChildren(new Option(data.length ? 'Select GSTIN' : 'No GSTIN found', ''));
                data.forEach(value => gstin.add(new Option(value, value)));
            } catch (error) { gstin.replaceChildren(new Option('Could not load GSTINs', '')); alert(error.message); }
        });
    })();
</script>
