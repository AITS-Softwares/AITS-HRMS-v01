@model Erp_Aits.Models.JobRequisition
@{
    var isEdit = ViewBag.IsEdit == true;
    var isDraft = Model.DocStatus == 0;
    var isLocked = isEdit && !isDraft;
    ViewBag.Title = isEdit ? "Job Requisition Details" : "New Job Requisition";
}

<form id="jobRequisitionForm" asp-action="@(isEdit ? "UpdateJobRequisition" : "CreateJobRequisition")" method="post" class="recruitment-theme workflow-page">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" /><input type="hidden" asp-for="ErpNextId" /><input type="hidden" asp-for="DocStatus" />
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">@(isEdit ? "Job Requisition Details" : "New Job Requisition")</h4>
        <div class="d-flex gap-2">
            @if (!isEdit) { <button type="submit" class="btn btn-dark btn-sm">Save</button> }
            else { <a href="@Url.Action("JobRequisition", "HR")" class="btn btn-outline-secondary btn-sm">Back to List</a>
                @if (isDraft) { <button type="submit" id="jobRequisitionWorkflowButton" formaction="@Url.Action("ChangeJobRequisitionStatus", "HR", new { id = Model.Id, status = 1 })" class="btn btn-success btn-sm">Submit</button> }
                else if (Model.DocStatus == 1) { <button type="submit" formaction="@Url.Action("ChangeJobRequisitionStatus", "HR", new { id = Model.Id, status = 2 })" class="btn btn-danger btn-sm">Cancel</button> }
            }
        </div>
    </div>
    <fieldset @(isLocked ? "disabled" : null)>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#detailsTab">Details</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#jobDescTab">Job Description</a></li>
    </ul>

    <div class="tab-content">

        <div class="tab-pane fade show active" id="detailsTab">
            <div class="card p-4 mb-3">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Naming Series</label>
                        <input class="form-control" value="HR-HIREQ-" disabled />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">No of. Positions *</label>
                        <input asp-for="NoOfPositions" type="number" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Company *</label>
                        <select asp-for="Company" class="form-select" required>
                            <option value="">Select company...</option>
                            @foreach (var item in ViewBag.Companies) { <option value="@item.name">@item.name</option> }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Designation *</label>
                        <select asp-for="Designation" class="form-select" required autofocus>
                            <option value="">Select designation...</option>
                            @foreach (var item in ViewBag.Designations) { <option value="@item.name">@item.name</option> }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Expected Compensation *</label>
                        <input asp-for="ExpectedCompensation" type="number" step="0.01" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Status *</label>
                        <select asp-for="Status" class="form-select">
                            <option>Pending</option>
                            <option>Approved</option>
                            <option>Rejected</option>
                            <option>Filled</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Department</label>
                        <select asp-for="Department" class="form-select">
                            <option value="">Select department...</option>
                            @foreach (var item in ViewBag.Departments) { <option value="@item.name">@item.name</option> }
                        </select>
                    </div>
                </div>
            </div>

            <div class="card p-4 mb-3">
                <h6 class="mb-3">Requested By</h6>
                <label class="form-label">Requested By *</label>
                <select asp-for="RequestedBy" class="form-select" required>
                    <option value="">Select user...</option>
                    @foreach (var item in ViewBag.Users) { <option value="@item.name">@item.name - @item.full_name</option> }
                </select>
            </div>

            <div class="card p-4">
                <h6 class="mb-3">Timelines</h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Posting Date *</label>
                        <input asp-for="PostingDate" type="date" class="form-control" required value="@Model.PostingDate.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Expected By</label>
                        <input asp-for="ExpectedBy" type="date" class="form-control" />
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="jobDescTab">
            <div class="card p-4 mb-3">
                <label class="form-label">Job Description *</label>
                <textarea asp-for="JobDescription" class="form-control" rows="8" required></textarea>
            </div>
            <div class="card p-4">
                <label class="form-label">Reason for Requesting</label>
                <textarea asp-for="ReasonForRequesting" class="form-control" rows="8"></textarea>
            </div>
        </div>

    </div>
</fieldset></form>
@if (isEdit && isDraft)
{
<script>
document.addEventListener('DOMContentLoaded', function () {
    const button = document.getElementById('jobRequisitionWorkflowButton');
    if (!button) return;
    document.querySelectorAll('#jobRequisitionForm input, #jobRequisitionForm select, #jobRequisitionForm textarea').forEach(function (input) {
        input.addEventListener('change', function () { button.textContent = 'Save'; button.removeAttribute('formaction'); button.className = 'btn btn-dark btn-sm'; });
    });
});
</script>
}
@await Html.PartialAsync("_RecruitmentTheme")
