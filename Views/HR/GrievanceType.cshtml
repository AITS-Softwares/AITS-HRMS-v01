@model List<Erp_Aits.Models.GrievanceType>
@{
    ViewBag.Title = "Grievance Type";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Grievance Type</h4>

    <div class="d-flex gap-2">
        <form method="post" asp-action="SyncGrievanceTypesFromErpNext" asp-controller="HR">
            <button type="submit" class="btn btn-outline-primary btn-sm">Sync From ERPNext</button>
        </form>

        <a href="@Url.Action("CreateGrievanceType", "HR")" class="btn btn-dark btn-sm">+ Add Grievance Type</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="get" action="/HR/GrievanceType" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="id" class="form-control form-control-sm" placeholder="ID" value="@ViewBag.IdFilter" />
    </div>

    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Filter</button>
    </div>
</form>

@if (Model.Any())
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Description</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr style="cursor:pointer" onclick="window.location='@Url.Action("GrievanceTypeDetails", "HR", new { id = item.Id })'">
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted text-center py-5">No Grievance Type found.</p>
}