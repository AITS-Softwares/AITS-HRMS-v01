@model Erp_Aits.Models.EmployeePromotion
@{
    ViewBag.Title = "Employee Promotion Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Employee Promotion Details</h4>
    <a asp-action="EmployeePromotion" class="btn btn-outline-secondary btn-sm">Back</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6"><strong>Employee:</strong> @Model.Employee</div>
            <div class="col-md-6"><strong>Employee Name:</strong> @Model.EmployeeName</div>
            <div class="col-md-6"><strong>Promotion Date:</strong> @Model.PromotionDate.ToString("dd-MM-yyyy")</div>
            <div class="col-md-6"><strong>Current CTC:</strong> @(Model.CurrentCTC?.ToString() ?? "-")</div>
            <div class="col-md-6"><strong>Salary Currency:</strong> @Model.SalaryCurrency</div>
            <div class="col-md-6"><strong>Company:</strong> @Model.Company</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">Promotion Details</div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>Field</th><th>Property</th><th>Current</th><th>New</th></tr></thead>
            <tbody>
            @foreach (var detail in Model.Details)
            {
                <tr><td>@detail.FieldName</td><td>@detail.Property</td><td>@detail.CurrentValue</td><td>@detail.NewValue</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
