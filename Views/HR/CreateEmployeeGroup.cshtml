@model Erp_Aits.Models.EmployeeGroup
@{
    ViewBag.Title = "New Employee Group";
}

<form asp-action="CreateEmployeeGroup" asp-controller="HR" method="post" class="employee-group-form">
    <!-- Header / Breadcrumb Bar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted">Employee Group</span>
            <span class="text-muted">/</span>
            <h4 class="mb-0 fw-bold">New Employee Group</h4>
            <span class="badge bg-warning-subtle text-warning border border-warning px-2 py-1 ms-2">Not Saved</span>
        </div>
        <button type="submit" class="btn btn-dark btn-sm px-4 fw-bold">Save</button>
    </div>

    <!-- Main Form Card -->
    <div class="card border rounded-3 p-4 mb-3 shadow-sm bg-white">
        <div class="row">
            <div class="col-md-6">
                <label class="form-label text-muted small mb-1">Name <span class="text-danger">*</span></label>
                <input asp-for="GroupName" class="form-control" required autofocus />
            </div>
        </div>
    </div>

    <!-- Child Table Card (employee_list) -->
    <div class="card border rounded-3 p-4 shadow-sm bg-white">
        <h6 class="fw-bold mb-1">Employee</h6>
        <p class="text-muted small mb-3">Employee</p>

        <div class="table-responsive">
            <table class="table table-bordered align-middle mb-2" id="employeeTable">
                <thead class="table-light">
                    <tr>
                        <th style="width: 40px;" class="text-center">
                            <input type="checkbox" class="form-check-input" id="selectAll" />
                        </th>
                        <th style="width: 60px;" class="text-center text-muted small">No.</th>
                        <th class="text-muted small">Employee</th>
                        <th class="text-muted small">Employee Name</th>
                        <th class="text-muted small">ERPNext User ID</th>
                        <th style="width: 50px;" class="text-center"></th>
                    </tr>
                </thead>
                <tbody id="employeeTableBody">
                    <!-- Dynamic Rows Injected Here -->
                </tbody>
            </table>
        </div>

        <div class="mt-2">
            <button type="button" class="btn btn-light border btn-sm px-3 shadow-sm" onclick="addEmployeeRow()">Add Row</button>
        </div>

        <!-- Datalist containing ERPNext Employee dropdown values -->
        <datalist id="erpEmployeeList">
            @if (ViewBag.Employees != null)
            {
                foreach (var emp in ViewBag.Employees)
                {
                    <option value="@emp.name" data-name="@emp.employee_name" data-userid="@emp.user_id">@emp.name - @emp.employee_name</option>
                }
            }
        </datalist>
    </div>
</form>

<script>
    let rowIndex = 0;

    function addEmployeeRow() {
        const i = rowIndex++;
        const row = `
            <tr id="row_${i}">
                <td class="text-center">
                    <input type="checkbox" class="form-check-input" />
                </td>
                <td class="text-center text-muted small row-number">${i + 1}</td>
                <td>
                    <input name="Members[${i}].Employee"
                           class="form-control form-control-sm"
                           list="erpEmployeeList"
                           placeholder="Employee"
                           onchange="onEmployeeSelect(this, ${i})"
                           required />
                </td>
                <td>
                    <input name="Members[${i}].EmployeeName"
                           id="empName_${i}"
                           class="form-control form-control-sm bg-light"
                           placeholder="Employee Name"
                           readonly />
                </td>
                <td>
                    <input name="Members[${i}].ERPNextUserId"
                           id="userId_${i}"
                           class="form-control form-control-sm bg-light"
                           placeholder="ERPNext User ID"
                           readonly />
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-outline-danger border-0" onclick="removeRow(${i})">&times;</button>
                </td>
            </tr>`;
        document.getElementById('employeeTableBody').insertAdjacentHTML('beforeend', row);
        renumberRows();
    }

    function removeRow(idx) {
        const row = document.getElementById(`row_${idx}`);
        if (row) {
            row.remove();
            renumberRows();
        }
    }

    function renumberRows() {
        const rows = document.querySelectorAll('#employeeTableBody tr');
        rows.forEach((tr, index) => {
            const numCell = tr.querySelector('.row-number');
            if (numCell) numCell.textContent = index + 1;
        });
    }

    function onEmployeeSelect(input, idx) {
        const selectedValue = input.value.trim();
        const datalist = document.getElementById('erpEmployeeList');
        let matched = false;

        for (let opt of datalist.options) {
            if (opt.value === selectedValue) {
                document.getElementById(`empName_${idx}`).value = opt.getAttribute('data-name') || '';
                document.getElementById(`userId_${idx}`).value = opt.getAttribute('data-userid') || '';
                matched = true;
                break;
            }
        }

        if (!matched) {
            document.getElementById(`empName_${idx}`).value = '';
            document.getElementById(`userId_${idx}`).value = '';
        }
    }

    // Initialize with 1 empty row on load like ERPNext
    document.addEventListener('DOMContentLoaded', () => {
        addEmployeeRow();
    });
</script>

<style>
    .employee-group-form{max-width:1280px;margin:8px auto 40px;padding:26px;border:1px solid #c7daea;border-radius:8px;background:#edf5fb;box-shadow:0 16px 34px rgba(19,55,91,.10);color:#173555}
    .employee-group-form> .d-flex:first-of-type{margin:-26px -26px 24px!important;padding:20px 26px;background:#14365d;border-radius:8px 8px 0 0;color:#fff}
    .employee-group-form> .d-flex:first-of-type .text-muted{color:#a9c7df!important}.employee-group-form h4{color:#fff;font-weight:760}.employee-group-form .badge{border:0!important;background:#d8f5ec!important;color:#0d735e!important;font-weight:760}
    .employee-group-form .card{border:1px solid #c8ddec!important;border-radius:8px!important;background:#fff!important;box-shadow:0 8px 20px rgba(16,49,82,.07)!important}
    .employee-group-form .card h6{color:#163f6d;font-size:16px}.employee-group-form .card p{color:#5d7390!important}.employee-group-form .form-label{color:#315879!important;font-weight:720!important}.employee-group-form .form-control,.employee-group-form .form-select{min-height:40px;border-color:#b9cee2;border-radius:6px;color:#183b60;box-shadow:none}.employee-group-form .form-control:focus,.employee-group-form .form-select:focus{border-color:#159b84;box-shadow:0 0 0 3px rgba(21,155,132,.14)}
    .employee-group-form .btn-dark{border:1px solid #16a085;background:#108c77;border-radius:6px;font-weight:740;box-shadow:0 5px 12px rgba(16,140,119,.2)}.employee-group-form .btn-dark:hover{background:#087361}.employee-group-form .btn-light{border-color:#c8ddec;background:#eef5fc;color:#21496f}.employee-group-form .table{border-color:#d8e5f0}.employee-group-form .table thead th{border-color:#2a5a89;background:#1d4b7d;color:#fff!important;font-size:12px;text-transform:uppercase;letter-spacing:.04em}.employee-group-form .table tbody td{border-color:#e1ebf4}.employee-group-form .table tbody tr:nth-child(even){background:#f4f9fd}.employee-group-form .btn-outline-danger{border-radius:6px}.employee-group-form .form-check-input:checked{background-color:#159b84;border-color:#159b84}
    @@media(max-width:640px){.employee-group-form{padding:16px}.employee-group-form> .d-flex:first-of-type{align-items:flex-start!important;flex-direction:column;margin:-16px -16px 18px!important;padding:18px}.employee-group-form .table{min-width:760px}}
</style>
