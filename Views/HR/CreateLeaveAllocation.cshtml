@model Erp_Aits.Models.LeaveAllocation
@{
    ViewBag.Title = "New Leave Allocation";
    var leavePeriods = ViewBag.LeavePeriods as List<string> ?? new List<string>();
    var leavePolicies = ViewBag.LeavePolicies as List<string> ?? new List<string>();
}

<link rel="stylesheet" href="~/css/leave-workspace.css" asp-append-version="true" />
<span class="leave-ui" aria-hidden="true"></span>
<form method="post" action="/HR/CreateLeaveAllocation" id="leaveAllocForm">
<style>
 body{background:#f1fbfd}.leave-allocation-form{max-width:1180px;margin:24px auto}.leave-allocation-form .form-top{background:linear-gradient(110deg,#17486c,#008d88);border-radius:14px;padding:22px 26px;color:#fff}.leave-allocation-form .card{border:1px solid #cbe5ed;border-radius:14px;box-shadow:0 8px 18px rgba(11,80,101,.06)}.leave-allocation-form .card h6,.leave-allocation-form label{color:#17486c;font-weight:700}.leave-allocation-form .form-control{border-color:#b9dce5}.leave-allocation-form .btn-dark{background:#fff;color:#0b5065;border:0;font-weight:700}
</style><div class="leave-allocation-form">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0 d-inline-block me-2">New Leave Allocation</h4>
            <span class="badge bg-warning-subtle text-warning">Not Saved</span>
        </div>
        <button type="submit" class="btn btn-dark btn-sm">Save</button>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@err.ErrorMessage</div>
            }
        </div>
    }

    <div class="card p-4 mb-3">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Series *</label>
                <input name="Series" value="@Model.Series" class="form-control" required />
            </div>

            <!-- Leave Type Dropdown with "+ Create New Leave Type" Option -->
            <div class="col-md-6">
                <label class="form-label">Leave Type *</label>
                <select name="LeaveType" class="form-control" required onchange="if(this.value==='__CREATE_NEW__') location.href='@Url.Action("CreateLeaveType", "HR")';">
                    <option value="">-- Select Leave Type --</option>
                    @if (ViewBag.LeaveTypes != null)
                    {
                        foreach (var lt in ViewBag.LeaveTypes)
                        {
                            <!option value="@lt" @(Model.LeaveType == lt ? "selected" : "")>@lt</!option>
                        }
                    }
                    <!option value="__CREATE_NEW__" class="fw-bold text-primary">+ Create New Leave Type</!option>
                </select>
            </div>

            <!-- Employee Dropdown mapped to 'employee' -->
            <div class="col-md-6">
                <label class="form-label">Employee *</label>
                <select name="Employee" id="employeeSelect" class="form-control" required onchange="updateEmployeeName(this)">
                    <option value="">-- Select Employee --</option>
                    @if (ViewBag.EmployeesList != null)
                    {
                        foreach (var emp in ViewBag.EmployeesList)
                        {
                            // emp can be stored as an anonymous object or tuple with Name and EmployeeName
                            <!option value="@emp.EmployeeId" data-empname="@emp.EmployeeName" @(Model.Employee == emp.EmployeeId ? "selected" : "")>@emp.EmployeeId - @emp.EmployeeName</!option>
                        }
                    }
                </select>
            </div>

            <!-- Hidden or Readonly Employee Name field that auto-fills -->
            <div class="col-md-6">
                <label class="form-label">Employee Name *</label>
                <input name="EmployeeName" id="employeeNameInput" value="@Model.EmployeeName" class="form-control" readonly required />
            </div>

            <div class="col-md-6">
                <label class="form-label">From Date *</label>
                <input id="leaveAllocationFromDate" name="FromDate" type="date" value="@(Model.FromDate != default ? Model.FromDate.ToString("yyyy-MM-dd") : "")" class="form-control" required />
            </div>

            <div class="col-md-6">
                <label class="form-label">Company *</label>
                <input name="Company" value="@(string.IsNullOrEmpty(Model.Company) ? "AITS" : Model.Company)" class="form-control" required />
            </div>

            <div class="col-md-6">
                <label class="form-label">To Date *</label>
                <input id="leaveAllocationToDate" name="ToDate" type="date" value="@(Model.ToDate != default ? Model.ToDate.ToString("yyyy-MM-dd") : "")" class="form-control" required />
            </div>

            <div class="col-md-6">
                <label class="form-label">Leave Period</label>
                <select name="LeavePeriod" class="form-control">
                    <option value="">-- Select Leave Period --</option>
                    @foreach (var period in leavePeriods)
                    {
                        <!option value="@period" @(Model.LeavePeriod == period ? "selected" : "")>@period</!option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Leave Policy *</label>
                <select name="LeavePolicy" class="form-control" required>
                    <option value="">-- Select Leave Policy --</option>
                    @foreach (var policy in leavePolicies)
                    {
                        <!option value="@policy" @(Model.LeavePolicy == policy ? "selected" : "")>@policy</!option>
                    }
                </select>
            </div>

        </div>
    </div>

    <div class="card p-4 mb-3">
        <h6 class="mb-3">Allocation</h6>
        <label class="form-label">New Leaves Allocated</label>
        <input name="NewLeavesAllocated" type="number" step="0.01" value="@Model.NewLeavesAllocated" class="form-control mb-3" />

        <div class="form-check">
            <input type="checkbox" name="AddUnusedLeaves" value="true" class="form-check-input" id="unusedCheck" @(Model.AddUnusedLeaves ? "checked" : "") />
            <label class="form-check-label" for="unusedCheck">Add unused leaves from previous allocations</label>
        </div>
    </div>

    <div class="card p-4">
        <h6 class="mb-3">Notes</h6>
        <label class="form-label">Description</label>
        <textarea name="Description" class="form-control" rows="5">@Model.Description</textarea>
    </div>
</div></form>

<script>
    function updateEmployeeName(selectElement) {
        var selectedOption = selectElement.options[selectElement.selectedIndex];
        var empName = selectedOption.getAttribute("data-empname");
        document.getElementById("employeeNameInput").value = empName || "";
    }

    (function () {
        const from = document.getElementById('leaveAllocationFromDate');
        const to = document.getElementById('leaveAllocationToDate');
        if (!from || !to) return;
        const nextDay = value => {
            const date = new Date(value + 'T00:00:00');
            date.setDate(date.getDate() + 1);
            return date.toISOString().slice(0, 10);
        };
        const alignDates = () => {
            if (from.value && (!to.value || to.value <= from.value)) to.value = nextDay(from.value);
            if (from.value) to.min = nextDay(from.value);
        };
        from.addEventListener('change', alignDates);
        alignDates();
    })();
</script>
