@{
    ViewBag.Title = "New Income Tax Slab";
}

<style>
    .erp-form-page {
        max-width: 945px;
        margin: 0 auto;
    }

    .erp-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

    .erp-title-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .menu-icon {
        border: 0;
        background: transparent;
        font-size: 20px;
        color: #6b7280;
    }

    .erp-title {
        font-size: 18px;
        font-weight: 700;
    }

    .not-saved {
        color: #d9480f;
        background: #fff1e8;
        border-radius: 999px;
        padding: 3px 9px;
        font-size: 12px;
        margin-left: 8px;
    }

    .save-btn {
        background: #111;
        color: #fff;
        border: 0;
        border-radius: 8px;
        padding: 7px 14px;
        font-weight: 600;
    }

    .erp-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        overflow: hidden;
    }

    .form-section {
        padding: 18px 16px;
        border-bottom: 1px solid #e5e7eb;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px 28px;
    }

    .field-label {
        display: block;
        font-size: 12px;
        margin-bottom: 7px;
        color: #374151;
    }

    .required {
        color: #dc2626;
    }

    .erp-input {
        width: 100%;
        height: 30px;
        border: 1px solid #e5e7eb;
        background: #f3f3f3;
        border-radius: 7px;
        padding: 5px 9px;
        font-size: 13px;
    }

    .check-row {
        display: flex;
        gap: 8px;
        align-items: center;
        font-size: 12px;
        margin-top: 14px;
    }

    .field-help {
        color: #475569;
        font-size: 11px;
        line-height: 1.5;
        margin-top: 8px;
    }

    .section-title {
        font-size: 14px;
        font-weight: 700;
        padding: 13px 16px 8px;
    }

    .child-table-wrap {
        padding: 0 16px 14px;
    }

    .child-table-label {
        display: block;
        font-size: 12px;
        color: #374151;
        margin-bottom: 8px;
    }

    .child-table {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        overflow: hidden;
    }

        .child-table th {
            background: #f3f3f3;
            padding: 8px;
            color: #6b7280;
            font-size: 11px;
            font-weight: 500;
            border-bottom: 1px solid #e5e7eb;
        }

        .child-table td {
            padding: 8px;
            text-align: center;
            border-bottom: 1px solid #e5e7eb;
            font-size: 12px;
        }

        .child-table input {
            width: 100%;
            height: 28px;
            border: 1px solid #e5e7eb;
            background: #fff;
            border-radius: 6px;
            padding: 4px 7px;
            font-size: 12px;
        }

    .add-row-btn {
        margin-top: 10px;
        background: #f3f4f6;
        border: 0;
        border-radius: 7px;
        padding: 6px 12px;
        font-size: 12px;
    }

    .empty-table-cell {
        height: 78px;
        color: #6b7280;
        text-align: center;
    }

    @@media (max-width: 900px) {
        .form-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="erp-form-page">
    <form method="post" action="#">
        <div class="erp-header">
            <div class="erp-title-left">
                <button type="button" class="menu-icon">≡</button>
                <span class="erp-title">New Income Tax Slab</span>
                <span class="not-saved">Not Saved</span>
            </div>

            <button type="submit" class="save-btn">Save</button>
        </div>

        <div class="erp-card">
            <div class="form-section">
                <div style="max-width:445px;">
                    <label class="field-label">Name <span class="required">*</span></label>
                    <input type="text" name="Name" class="erp-input" />

                    <label class="check-row">
                        <input type="checkbox" name="Disabled" />
                        <span>Disabled</span>
                    </label>
                </div>
            </div>

            <div class="form-section">
                <div class="form-grid">
                    <div>
                        <label class="field-label">Effective from <span class="required">*</span></label>
                        <input type="date" name="EffectiveFrom" class="erp-input" />
                    </div>

                    <div>
                        <label class="field-label">Currency <span class="required">*</span></label>
                        <input type="text" name="Currency" class="erp-input" />
                    </div>

                    <div>
                        <label class="field-label">Company</label>
                        <input type="text" name="Company" class="erp-input" />
                    </div>

                    <div>
                        <label class="field-label">Standard Tax Exemption Amount</label>
                        <input type="number" step="0.01" name="StandardTaxExemptionAmount" class="erp-input" />

                        <label class="check-row">
                            <input type="checkbox" name="AllowTaxExemption" />
                            <span>Allow Tax Exemption</span>
                        </label>

                        <div class="field-help">
                            If enabled, Tax Exemption Declaration will be considered for income tax calculation.
                        </div>
                    </div>
                </div>
            </div>

            <div class="section-title">Taxable Salary Slabs</div>

            <div class="child-table-wrap">
                <label class="child-table-label">Taxable Salary Slabs</label>

                <table class="child-table">
                    <thead>
                        <tr>
                            <th style="width:40px;"><input type="checkbox" /></th>
                            <th style="width:70px;">No.</th>
                            <th>From Amount <span class="required">*</span></th>
                            <th>To Amount</th>
                            <th>Percent Deduction <span class="required">*</span></th>
                            <th>Condition</th>
                            <th style="width:55px;">⚙</th>
                        </tr>
                    </thead>
                    <tbody id="taxSlabsBody">
                        <tr>
                            <td><input type="checkbox" /></td>
                            <td>1</td>
                            <td><input type="number" step="0.01" name="FromAmounts" value="0.00" /></td>
                            <td><input type="number" step="0.01" name="ToAmounts" value="0.00" /></td>
                            <td><input type="number" step="0.01" name="PercentDeductions" value="0.00" /></td>
                            <td><input type="text" name="Conditions" /></td>
                            <td>✎</td>
                        </tr>
                    </tbody>
                </table>

                <button type="button" class="add-row-btn" onclick="addTaxSlabRow()">Add Row</button>
            </div>

            <div class="form-section">
                <div style="max-width:445px;">
                    <label class="field-label">Taxable Income Relief Threshold Limit</label>
                    <input type="number" step="0.01" name="TaxableIncomeReliefThresholdLimit" class="erp-input" />

                    <div class="field-help">
                        Maximum annual taxable income eligible for full tax relief. No tax is applied if income does not exceed this limit
                    </div>
                </div>
            </div>

            <div class="section-title">
                Taxes and Charges on Income Tax <span style="font-size:12px;color:#64748b;margin-left:6px;">⌃</span>
            </div>

            <div class="child-table-wrap">
                <label class="child-table-label">Other Taxes and Charges</label>

                <table class="child-table">
                    <thead>
                        <tr>
                            <th style="width:40px;"><input type="checkbox" /></th>
                            <th style="width:70px;">No.</th>
                            <th>Description <span class="required">*</span></th>
                            <th>Percent <span class="required">*</span></th>
                            <th>Min Taxable Income</th>
                            <th>Max Taxable Income</th>
                            <th style="width:55px;">⚙</th>
                        </tr>
                    </thead>
                    <tbody id="taxChargesBody">
                        <tr id="taxChargesEmptyRow">
                            <td colspan="7" class="empty-table-cell">No Data</td>
                        </tr>
                    </tbody>
                </table>

                <button type="button" class="add-row-btn" onclick="addTaxChargeRow()">Add Row</button>
            </div>
        </div>
    </form>
</div>

<script>
    function addTaxSlabRow() {
        const body = document.getElementById('taxSlabsBody');
        const rowNo = body.querySelectorAll('tr').length + 1;
        const row = document.createElement('tr');

        row.innerHTML = `
            <td><input type="checkbox" /></td>
            <td>${rowNo}</td>
            <td><input type="number" step="0.01" name="FromAmounts" value="0.00" /></td>
            <td><input type="number" step="0.01" name="ToAmounts" value="0.00" /></td>
            <td><input type="number" step="0.01" name="PercentDeductions" value="0.00" /></td>
            <td><input type="text" name="Conditions" /></td>
            <td>✎</td>
        `;

        body.appendChild(row);
    }

    function addTaxChargeRow() {
        const body = document.getElementById('taxChargesBody');
        const emptyRow = document.getElementById('taxChargesEmptyRow');

        if (emptyRow) {
            emptyRow.remove();
        }

        const rowNo = body.querySelectorAll('tr').length + 1;
        const row = document.createElement('tr');

        row.innerHTML = `
            <td><input type="checkbox" /></td>
            <td>${rowNo}</td>
            <td><input type="text" name="ChargeDescriptions" /></td>
            <td><input type="number" step="0.01" name="ChargePercents" value="0.00" /></td>
            <td><input type="number" step="0.01" name="MinTaxableIncomes" /></td>
            <td><input type="number" step="0.01" name="MaxTaxableIncomes" /></td>
            <td>✎</td>
        `;

        body.appendChild(row);
    }
</script>