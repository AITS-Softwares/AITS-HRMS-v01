@using System.Collections.Generic
@{ ViewBag.Title = "New Income Tax Slab"; var companies = ViewBag.IncomeTaxSlabCompanies as List<string> ?? new List<string>(); var currencies = ViewBag.IncomeTaxSlabCurrencies as List<string> ?? new List<string>(); }
<style>.p{max-width:1210px;margin:auto;padding:28px;background:#f1fbfd;border:1px solid #cbe5ed;border-radius:10px}.h{display:flex;justify-content:space-between;align-items:center;padding:23px 27px;background:linear-gradient(110deg,#17486c,#008d88);border-radius:9px;color:#fff;box-shadow:0 14px 26px rgba(13,83,104,.16)}.h h1{margin:0;font-size:24px;font-weight:750}.save{border:0;background:#fff;color:#0b5065;padding:10px 18px;border-radius:7px;font-weight:700}.card{margin-top:20px;background:#fff;border:1px solid #c9e1e9;border-radius:9px;overflow:hidden;box-shadow:0 8px 22px rgba(26,85,107,.06)}.s{padding:21px 22px;border-bottom:1px solid #d8ebf0}.s h2{font-size:17px;color:#17486c;margin:0 0 14px;font-weight:750}.g{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.f label{display:block;font-size:13px;color:#24546a;margin-bottom:7px;font-weight:650}.i,.sel{box-sizing:border-box;width:100%;height:38px;border:1px solid #b8d6df;border-radius:7px;padding:8px 10px;background:#fbfeff}.i:focus,.sel:focus,.t input:focus{outline:0;border-color:#008d88;box-shadow:0 0 0 3px rgba(0,141,136,.12)}.check{display:flex;gap:8px;align-items:center;padding-top:24px;color:#24546a;font-size:14px}.t{width:100%;border-collapse:separate;border-spacing:0;border:1px solid #cfe4ea;border-radius:8px;overflow:hidden}.t th,.t td{padding:9px 10px;border-bottom:1px solid #e2eff2;border-right:1px solid #e2eff2}.t th:last-child,.t td:last-child{border-right:0}.t tr:last-child td{border-bottom:0}.t th{background:#e7f5f8;color:#17486c;font-size:13px;text-align:left}.t input{width:100%;box-sizing:border-box;height:35px;border:1px solid #b8d6df;border-radius:6px;padding:6px 8px}.add{border:0;background:#dff3f2;color:#075d66;border-radius:6px;padding:8px 13px;margin-top:11px;font-weight:650}@@media(max-width:800px){.p{padding:12px}.h{flex-wrap:wrap}.g{grid-template-columns:1fr}.s{overflow:auto}.t{min-width:650px}}</style>
<div class="p"><form method="post" asp-action="CreateIncomeTaxSlab">@Html.AntiForgeryToken()<header class="h"><h1>New Income Tax Slab</h1><button class="save">Save</button></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}<main class="card"><section class="s"><div class="g"><div class="f"><label>Name *</label><input name="Name" class="i" required/></div><label class="check"><input name="Disabled" type="checkbox"/> Disabled</label><div class="f"><label>Effective from *</label><input name="EffectiveFrom" type="date" class="i" required/></div><div class="f"><label>Company</label><select name="Company" class="sel searchable"><option value="">Select company</option>@foreach(var x in companies){<option value="@x">@x</option>}</select></div><div class="f"><label>Currency *</label><select name="Currency" class="sel searchable" required><option value="">Select currency</option>@foreach(var x in currencies){<option value="@x">@x</option>}</select></div><div class="f"><label>Standard Tax Exemption Amount</label><input name="StandardTaxExemptionAmount" type="number" step="0.01" class="i"/></div><label class="check"><input name="AllowTaxExemption" type="checkbox"/> Allow Tax Exemption</label><div class="f"><label>Amended From</label><input class="i" readonly/></div></div></section><section class="s"><h2>Taxable Salary Slabs</h2><table class="t"><thead><tr><th>From Amount *</th><th>To Amount</th><th>Percent Deduction *</th><th>Condition</th></tr></thead><tbody id="slabs"><tr><td><input name="FromAmounts" type="number" step="0.01" value="0"/></td><td><input name="ToAmounts" type="number" step="0.01"/></td><td><input name="PercentDeductions" type="number" step="0.01" value="0"/></td><td><input name="Conditions"/></td></tr></tbody></table><button type="button" class="add" id="addSlab">Add Row</button></section><section class="s"><div class="g"><div class="f"><label>Taxable Income Relief Threshold Limit</label><input name="TaxReliefLimit" type="number" step="0.01" class="i"/></div><div class="f"><label>Marginal Relief Threshold Limit</label><input name="MarginalReliefLimit" type="number" step="0.01" class="i"/></div></div></section><section class="s"><h2>Taxes and Charges on Income Tax</h2><table class="t"><thead><tr><th>Description *</th><th>Percent *</th><th>Min Taxable Income</th><th>Max Taxable Income</th></tr></thead><tbody id="charges"></tbody></table><button type="button" class="add" id="addCharge">Add Row</button></section></main></form></div>
<script>const add=(id,html)=>document.getElementById(id).insertAdjacentHTML('beforeend',html);addSlab.onclick=()=>add('slabs','<tr><td><input name="FromAmounts" type="number" step="0.01" value="0"/></td><td><input name="ToAmounts" type="number" step="0.01"/></td><td><input name="PercentDeductions" type="number" step="0.01" value="0"/></td><td><input name="Conditions"/></td></tr>');addCharge.onclick=()=>add('charges','<tr><td><input name="ChargeDescriptions"/></td><td><input name="ChargePercents" type="number" step="0.01" value="0"/></td><td><input name="MinTaxableIncomes" type="number" step="0.01"/></td><td><input name="MaxTaxableIncomes" type="number" step="0.01"/></td></tr>');</script>
