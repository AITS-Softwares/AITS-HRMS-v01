@using Newtonsoft.Json.Linq
@{
    ViewBag.Title = "Salary Component Details";
    var doc = ViewBag.Document as JObject;
    string Value(string key) => doc?[key]?.ToString() ?? "";
    bool Checked(string key) => doc?[key]?.ToString() == "1" || doc?[key]?.ToString().Equals("Yes", StringComparison.OrdinalIgnoreCase) == true;
    var accounts = doc?["accounts"] as JArray ?? new JArray();
}
<style>
.payroll-form{max-width:1210px;margin:0 auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.payroll-head{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.payroll-head h1{font-size:22px;margin:0}.payroll-head a{color:#fff;text-decoration:none}.payroll-card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.tabs{display:flex;gap:28px;padding:0 20px;background:#f4f8fc;border-bottom:1px solid #dbe3ec}.tabs button{border:0;border-bottom:2px solid transparent;background:transparent;padding:13px 0;color:#374151}.tabs button.active{font-weight:700;color:#111827;border-color:#0f766e}.pane{display:none;padding:20px}.pane.active{display:block}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 28px}.field label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.value{min-height:34px;padding:8px 10px;border:1px solid #b8c7d7;border-radius:8px;background:#fbfdff;color:#172033;white-space:pre-wrap}.check{display:flex;align-items:center;gap:8px;font-size:14px;margin:12px 0}.check input{accent-color:#0f766e}.table{width:100%;border-collapse:collapse;border:1px solid #d7e0e9;border-radius:8px;overflow:hidden}.table th,.table td{padding:10px;border-bottom:1px solid #e5e7eb;text-align:left;font-size:13px}.table th{background:#f4f8fc;color:#526375}.table .empty{text-align:center;color:#64748b;height:54px}.code{min-height:140px;font-family:Consolas,monospace}@@media(max-width:800px){.grid{grid-template-columns:1fr}.payroll-form{padding:12px}}
</style>
<div class="payroll-form">
 <header class="payroll-head"><h1>@(Value("name") == "" ? "Salary Component" : Value("name"))</h1><a asp-action="SalaryComponent">Back to Salary Components</a></header>
 @if (TempData["ErpNextError"] != null) { <div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div> }
 @if (doc != null) { <main class="payroll-card">
  <nav class="tabs"><button type="button" class="active" data-tab="overview">Overview</button><button type="button" data-tab="formula">Condition &amp; Formula</button><button type="button" data-tab="benefits">Flexible Benefits</button></nav>
  <section id="overview" class="pane active"><div class="grid"><div class="field"><label>Name</label><div class="value">@(Value("salary_component") == "" ? Value("name") : Value("salary_component"))</div></div><div class="field"><label>Abbr</label><div class="value">@Value("salary_component_abbr")</div></div><div class="field"><label>Type</label><div class="value">@Value("type")</div></div><div class="field"><label>Component Type</label><div class="value">@Value("component_type")</div></div><div class="field"><label>Description</label><div class="value">@Value("description")</div></div><div class="field"><label>Amount</label><div class="value">@Value("amount")</div></div></div>
   <div class="grid" style="margin-top:18px"><div>@foreach (var item in new[]{("depends_on_payment_days","Depends on Payment Days"),("is_tax_applicable","Is Tax Applicable"),("deduct_full_tax_on_selected_payroll_date","Deduct Full Tax on Selected Payroll Date"),("variable_based_on_taxable_salary","Variable Based On Taxable Salary"),("is_income_tax_component","Is Income Tax Component"),("exempted_from_income_tax","Exempted From Income Tax")}) { <label class="check"><input type="checkbox" disabled checked="@Checked(item.Item1)" />@item.Item2</label> }</div><div>@foreach (var item in new[]{("round_to_the_nearest_integer","Round to the Nearest Integer"),("statistical_component","Statistical Component"),("do_not_include_in_total","Do Not Include in Total"),("do_not_include_in_accounts","Do Not Include in Accounts"),("remove_if_zero_valued","Remove if Zero Valued"),("disabled","Disabled")}) { <label class="check"><input type="checkbox" disabled checked="@Checked(item.Item1)" />@item.Item2</label> }</div></div>
   <h3 style="font-size:16px;margin-top:22px">Accounts</h3><table class="table"><thead><tr><th>Company</th><th>Account</th></tr></thead><tbody>@if(accounts.Any()){foreach(var row in accounts){<tr><td>@row["company"]</td><td>@row["account"]</td></tr>}}else{<tr><td colspan="2" class="empty">No accounts configured</td></tr>}</tbody></table>
  </section>
  <section id="formula" class="pane"><div class="grid"><div class="field"><label>Condition</label><div class="value code">@Value("condition")</div></div><div class="field"><label>Formula</label><div class="value code">@Value("formula")</div></div><div class="field"><label>Amount</label><div class="value">@Value("amount")</div></div><div class="field"><label>Amount Based on Formula</label><div class="value">@Value("amount_based_on_formula")</div></div></div></section>
  <section id="benefits" class="pane"><div class="grid"><div>@foreach(var item in new[]{("is_flexible_benefit","Is Flexible Benefit"),("pay_against_benefit_claim","Pay Against Benefit Claim")}){<label class="check"><input type="checkbox" disabled checked="@Checked(item.Item1)"/>@item.Item2</label>}</div><div>@foreach(var item in new[]{("only_tax_impact","Only Tax Impact"),("create_separate_payment_entry_against_benefit_claim","Create Separate Payment Entry Against Benefit Claim")}){<label class="check"><input type="checkbox" disabled checked="@Checked(item.Item1)"/>@item.Item2</label>}</div><div class="field"><label>Max Benefit Amount</label><div class="value">@Value("max_benefit_amount")</div></div></div></section>
 </main> }
</div>
<script>document.querySelectorAll('.tabs button').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.tabs button,.pane').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.getElementById(b.dataset.tab).classList.add('active')}));</script>
