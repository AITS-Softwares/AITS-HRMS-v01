@using Newtonsoft.Json.Linq
@{ViewBag.Title="Employee Benefit Application Details";var d=ViewBag.Document as JObject;string V(string k)=>d?[k]?.ToString()??"";var rows=d?["employee_benefits"] as JArray??new JArray();var employeeFields=new[]{("Employee","employee"),("Employee Name","employee_name"),("Department","department"),("Date","date"),("Payroll Period","payroll_period"),("Company","company"),("Amended From","amended_from")};var benefitFields=new[]{("Currency","currency"),("Max Benefits (Yearly)","max_benefits"),("Remaining Benefits (Yearly)","remaining_benefit"),("Total Amount","total_amount"),("Dispensed Amount (Pro-rated)","pro_rata_dispensed_amount")};}
<style>.p{max-width:1210px;margin:auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.h{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.h h1{font-size:22px;margin:0}.back{color:#fff;text-decoration:none;border:1px solid #7890a8;border-radius:7px;padding:8px 13px}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px}.s{padding:20px;border-bottom:1px solid #dbe3ec}.s h2{font-size:17px;margin:0 0 16px;color:#14253d}.g{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.f label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.v{min-height:36px;padding:8px 10px;border:1px solid #b8c7d7;border-radius:8px;background:#f2f6f9}.t{width:100%;border-collapse:collapse}.t th,.t td{padding:8px;border:1px solid #dbe3ec}.t th{background:#f4f8fc;text-align:left;color:#526375}</style>
<div class="p"><header class="h"><h1>Employee Benefit Application Details</h1><a class="back" asp-action="EmployeeBenefitApplication">Back to Benefit Applications</a></header><main class="card"><section class="s"><h2>Employee</h2><div class="g">@foreach(var x in employeeFields){<div class="f"><label>@x.Item1</label><div class="v">@V(x.Item2)</div></div>}</div></section><section class="s"><h2>Benefits</h2><div class="g">@foreach(var x in benefitFields.Take(3)){<div class="f"><label>@x.Item1</label><div class="v">@V(x.Item2)</div></div>}</div><table class="t" style="margin-top:18px"><thead><tr><th>Salary Component</th><th>Amount</th></tr></thead><tbody>@foreach(var r in rows){<tr><td>@r["salary_component"]</td><td>@r["amount"]</td></tr>}@if(!rows.Any()){<tr><td colspan="2">No employee benefits were added.</td></tr>}</tbody></table></section><section class="s"><h2>Totals</h2><div class="g">@foreach(var x in benefitFields.Skip(3)){<div class="f"><label>@x.Item1</label><div class="v">@V(x.Item2)</div></div>}</div></section></main></div>
