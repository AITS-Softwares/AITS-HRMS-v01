@model Erp_Aits.Models.EmployeeGrade

@{
    ViewBag.Title = "Employee Grade Details";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErpNextError"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

@if (ViewBag.SyncWarning != null)
{
    <div class="alert alert-warning">
        @ViewBag.SyncWarning
    </div>
}

<form asp-action="UpdateEmployeeGrade"
      asp-controller="HR"
      asp-route-id="@Model.Id"
      method="post"
      id="updateGradeForm"
      class="employee-grade-form">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ErpNextId" />

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h4 class="mb-0">
            Employee Grade Details (@Model.GradeName)
        </h4>

        <div class="d-flex gap-2">

            <a href="@Url.Action("EmployeeGrades", "HR")"
               class="btn btn-outline-secondary btn-sm">
                Back
            </a>

            <button type="button"
                    id="btnEditGrade"
                    class="btn btn-primary btn-sm px-3">
                Edit
            </button>

            <button type="submit"
                    form="deleteGradeForm"
                    class="btn btn-danger btn-sm px-3"
                    onclick="return confirm('Delete this Employee Grade from both ERPNext and HRMS?');">
                Delete
            </button>

            <button type="submit"
                    id="btnUpdateGrade"
                    class="btn btn-dark btn-sm px-4 fw-bold"
                    style="display:none;">
                Update Changes
            </button>

            <button type="button"
                    id="btnCancelEdit"
                    class="btn btn-outline-secondary btn-sm"
                    style="display:none;">
                Cancel
            </button>

        </div>

    </div>

    <div class="card p-4 shadow-sm bg-white border">

        <div class="mb-3">
            <label class="form-label text-muted small">
                Name <span class="text-danger">*</span>
            </label>

            <input asp-for="GradeName"
                   id="GradeName"
                   class="form-control grade-editable"
                   required
                   readonly />
        </div>

        <div class="mb-3">
            <label class="form-label text-muted small">
                Default Salary Structure
            </label>

            <input asp-for="DefaultSalaryStructure"
                   id="DefaultSalaryStructure"
                   class="form-control grade-editable"
                   list="salaryStructureList"
                   placeholder="Select or type salary structure"
                   readonly />

            <datalist id="salaryStructureList">
                @if (ViewBag.SalaryStructures != null)
                {
                    foreach (var ss in ViewBag.SalaryStructures)
                    {
                        <option value="@ss.name">@ss.name</option>
                    }
                }
            </datalist>
        </div>

        <div>
            <label class="form-label text-muted small">
                Default Base Pay
            </label>

            <input asp-for="DefaultBasePay"
                   id="DefaultBasePay"
                   class="form-control grade-editable"
                   type="number"
                   step="0.01"
                   placeholder="Enter Default Base Pay"
                   readonly />
        </div>

    </div>

</form>

<style>
    .employee-grade-form{max-width:1080px;margin:8px auto 40px;padding:26px;border:1px solid #c7daea;border-radius:8px;background:#edf5fb;box-shadow:0 16px 34px rgba(19,55,91,.10);color:#173555}.employee-grade-form> .d-flex:first-of-type{margin:-26px -26px 24px!important;padding:20px 26px;background:#14365d;border-radius:8px 8px 0 0}.employee-grade-form h4{color:#fff;font-weight:760}.employee-grade-form .btn{border-radius:6px;font-weight:700}.employee-grade-form .btn-dark{border-color:#16a085;background:#108c77}.employee-grade-form .btn-primary{border-color:#2769a2;background:#286ca7}.employee-grade-form .btn-outline-secondary{border-color:#91acc7;color:#e7f1fb}.employee-grade-form .btn-outline-secondary:hover{background:#fff;color:#163d64}.employee-grade-form .card{border:1px solid #c8ddec!important;border-radius:8px!important;background:#fff!important;box-shadow:0 8px 20px rgba(16,49,82,.07)!important}.employee-grade-form .form-label{color:#315879!important;font-weight:720!important}.employee-grade-form .form-control{min-height:42px;border-color:#b9cee2;border-radius:6px;color:#183b60}.employee-grade-form .form-control:focus{border-color:#159b84;box-shadow:0 0 0 3px rgba(21,155,132,.14)}.employee-grade-form .form-control[readonly]{background:#f2f7fb;color:#516d88}
    @@media(max-width:640px){.employee-grade-form{padding:16px}.employee-grade-form> .d-flex:first-of-type{align-items:flex-start!important;flex-direction:column;margin:-16px -16px 18px!important;padding:18px}}
</style>

<form asp-controller="HR"
      asp-action="DeleteEmployeeGrade"
      asp-route-id="@Model.Id"
      method="post"
      id="deleteGradeForm"
      class="d-none">

    @Html.AntiForgeryToken()

</form>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const editButton =
            document.getElementById("btnEditGrade");

        const updateButton =
            document.getElementById("btnUpdateGrade");

        const cancelButton =
            document.getElementById("btnCancelEdit");

        const editableFields =
            document.querySelectorAll(".grade-editable");

        editButton.addEventListener("click", function () {

            editableFields.forEach(function (field) {
                field.readOnly = false;
            });

            editButton.style.display = "none";
            updateButton.style.display = "inline-block";
            cancelButton.style.display = "inline-block";

            const gradeName =
                document.getElementById("GradeName");

            if (gradeName)
                gradeName.focus();
        });

        cancelButton.addEventListener("click", function () {
            window.location.reload();
        });

    });
</script>
