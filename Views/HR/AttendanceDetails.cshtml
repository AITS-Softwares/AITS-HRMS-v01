@model Erp_Aits.Models.AttendanceRequest

@{
    ViewBag.Title = "Attendance Request Details";

    bool isDraft = Model.DocStatus == 0;
    bool isSubmitted = Model.DocStatus == 1;
    bool isCancelled = Model.DocStatus == 2;

    string docStatusText = isSubmitted ? "Submitted" : isCancelled ? "Cancelled" : "Draft";
    string badgeClass = isSubmitted ? "bg-success" : isCancelled ? "bg-danger" : "bg-secondary";

    var employees = ViewBag.Employees;
    var companies = ViewBag.Companies;
    var shifts = ViewBag.Shifts;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErpNextError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-1">Attendance Request</h4>
        <div>
            <span class="fw-semibold">
                @(string.IsNullOrWhiteSpace(Model.AttendanceRequestCode) ? Model.ErpNextId : Model.AttendanceRequestCode)
            </span>
            <span class="badge @badgeClass ms-2">@docStatusText</span>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a href="@Url.Action("AttendanceRequest", "HR")" class="btn btn-outline-secondary btn-sm">
            Back to List
        </a>

        <form action="@Url.Action("DeleteAttendanceRequest", "HR", new { id = Model.Id })"
              method="post"
              onsubmit="return confirm('Are you sure you want to delete this Attendance Request?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
        </form>
    </div>
</div>

<form action="@Url.Action("ProcessAttendanceRequestAction", "HR")" method="post" id="attendanceRequestForm">
    @Html.AntiForgeryToken()

    <input type="hidden" name="Id" value="@Model.Id" />
    <input type="hidden" name="AttendanceRequestCode" value="@Model.AttendanceRequestCode" />
    <input type="hidden" name="ErpNextId" value="@Model.ErpNextId" />
    <input type="hidden" name="DocStatus" value="@Model.DocStatus" />

    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <h5 class="mb-3">Request Details</h5>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Employee <span class="text-danger">*</span></label>

                    @if (isDraft)
                    {
                        <select class="form-select editable-field" name="Employee" id="Employee" required="required">
                            <option value="">-- Select Employee --</option>

                            @if (employees != null)
                            {
                                foreach (var emp in employees)
                                {
                                    string empCode = emp.name != null ? emp.name.ToString() : "";
                                    string empName = emp.employee_name != null ? emp.employee_name.ToString() : "";

                                    if (empCode == Model.Employee)
                                    {
                                        <option value="@empCode" data-name="@empName" selected="selected">
                                            @empCode - @empName
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@empCode" data-name="@empName">
                                            @empCode - @empName
                                        </option>
                                    }
                                }
                            }
                        </select>
                    }
                    else
                    {
                        <input type="text" class="form-control" value="@Model.Employee" disabled="disabled" />
                        <input type="hidden" name="Employee" value="@Model.Employee" />
                    }
                </div>

                <div class="col-md-6">
                    <label class="form-label">Employee Name</label>
                    <input type="text"
                           class="form-control"
                           name="EmployeeName"
                           id="EmployeeName"
                           value="@Model.EmployeeName"
                           readonly="readonly" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Company <span class="text-danger">*</span></label>

                    @if (isDraft)
                    {
                        <select class="form-select editable-field" name="Company" required="required">
                            <option value="">-- Select Company --</option>

                            @if (companies != null)
                            {
                                foreach (var company in companies)
                                {
                                    string companyName = company.name != null ? company.name.ToString() : "";

                                    if (companyName == Model.Company)
                                    {
                                        <option value="@companyName" selected="selected">@companyName</option>
                                    }
                                    else
                                    {
                                        <option value="@companyName">@companyName</option>
                                    }
                                }
                            }
                        </select>
                    }
                    else
                    {
                        <input type="text" class="form-control" value="@Model.Company" disabled="disabled" />
                        <input type="hidden" name="Company" value="@Model.Company" />
                    }
                </div>

                <div class="col-md-3">
                    <label class="form-label">From Date <span class="text-danger">*</span></label>

                    @if (isDraft)
                    {
                        <input type="date"
                               class="form-control editable-field"
                               name="FromDate"
                               id="FromDate"
                               value="@(Model.FromDate.HasValue? Model.FromDate.Value.ToString("yyyy-MM-dd") : "")"
                               required="required" />
                    }
                    else
                    {
                        <input type="date"
                               class="form-control"
                               value="@(Model.FromDate.HasValue? Model.FromDate.Value.ToString("yyyy-MM-dd") : "")"
                               disabled="disabled" />
                        <input type="hidden"
                               name="FromDate"
                               value="@(Model.FromDate.HasValue? Model.FromDate.Value.ToString("yyyy-MM-dd") : "")" />
                    }
                </div>

                <div class="col-md-3">
                    <label class="form-label">To Date <span class="text-danger">*</span></label>

                    @if (isDraft)
                    {
                        <input type="date"
                               class="form-control editable-field"
                               name="ToDate"
                               id="ToDate"
                               value="@(Model.ToDate.HasValue? Model.ToDate.Value.ToString("yyyy-MM-dd") : "")"
                               required="required" />
                    }
                    else
                    {
                        <input type="date"
                               class="form-control"
                               value="@(Model.ToDate.HasValue? Model.ToDate.Value.ToString("yyyy-MM-dd") : "")"
                               disabled="disabled" />
                        <input type="hidden"
                               name="ToDate"
                               value="@(Model.ToDate.HasValue? Model.ToDate.Value.ToString("yyyy-MM-dd") : "")" />
                    }
                </div>

                <div class="col-md-6">
                    <div class="checkbox-panel">
                        <div class="form-check">
                            @if (Model.HalfDay)
                            {
                                <input type="checkbox"
                                       class="form-check-input editable-field"
                                       name="HalfDay"
                                       id="HalfDay"
                                       value="true"
                                       checked="checked"
                                       @(isDraft ? "" : "disabled") />
                            }
                            else
                            {
                                <input type="checkbox"
                                       class="form-check-input editable-field"
                                       name="HalfDay"
                                       id="HalfDay"
                                       value="true"
                                       @(isDraft ? "" : "disabled") />
                            }

                            <input type="hidden" name="HalfDay" value="false" />
                            <label class="form-check-label fw-semibold" for="HalfDay">Half Day</label>
                        </div>

                        <div class="mt-3" id="halfDayDateBox" style="display:none;">
                            <label class="form-label">Half Day Date <span class="text-danger">*</span></label>

                            @if (isDraft)
                            {
                                <input type="date"
                                       class="form-control editable-field"
                                       name="HalfDayDate"
                                       id="HalfDayDate"
                                       value="@(Model.HalfDayDate.HasValue? Model.HalfDayDate.Value.ToString("yyyy-MM-dd") : "")" />
                            }
                            else
                            {
                                <input type="date"
                                       class="form-control"
                                       id="HalfDayDate"
                                       value="@(Model.HalfDayDate.HasValue? Model.HalfDayDate.Value.ToString("yyyy-MM-dd") : "")"
                                       disabled="disabled" />
                                <input type="hidden"
                                       name="HalfDayDate"
                                       value="@(Model.HalfDayDate.HasValue? Model.HalfDayDate.Value.ToString("yyyy-MM-dd") : "")" />
                            }
                        </div>

                        <div class="form-check mt-3">
                            @if (Model.IncludeHolidays)
                            {
                                <input type="checkbox"
                                       class="form-check-input editable-field"
                                       name="IncludeHolidays"
                                       id="IncludeHolidays"
                                       value="true"
                                       checked="checked"
                                       @(isDraft ? "" : "disabled") />
                            }
                            else
                            {
                                <input type="checkbox"
                                       class="form-check-input editable-field"
                                       name="IncludeHolidays"
                                       id="IncludeHolidays"
                                       value="true"
                                       @(isDraft ? "" : "disabled") />
                            }

                            <input type="hidden" name="IncludeHolidays" value="false" />
                            <label class="form-check-label fw-semibold" for="IncludeHolidays">Include Holidays</label>
                        </div>

                        <div class="form-text mt-2">Select if any selected request days are holidays.</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Shift</label>

                    @if (isDraft)
                    {
                        <select class="form-select editable-field" name="Shift">
                            <option value="">-- Select Shift --</option>

                            @if (shifts != null)
                            {
                                foreach (var shift in shifts)
                                {
                                    string shiftName = shift != null ? shift.ToString() : "";

                                    if (shiftName == Model.Shift)
                                    {
                                        <option value="@shiftName" selected="selected">@shiftName</option>
                                    }
                                    else
                                    {
                                        <option value="@shiftName">@shiftName</option>
                                    }
                                }
                            }
                        </select>
                    }
                    else
                    {
                        <input type="text" class="form-control" value="@Model.Shift" disabled="disabled" />
                        <input type="hidden" name="Shift" value="@Model.Shift" />
                    }

                    <div class="form-text">Note: Shift will not be overwritten in existing attendance records.</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <h5 class="mb-3">Reason</h5>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Reason <span class="text-danger">*</span></label>

                    @if (isDraft)
                    {
                        <select class="form-select editable-field" name="Reason" required="required">
                            @if (Model.Reason == "Work From Home" || string.IsNullOrWhiteSpace(Model.Reason))
                            {
                                <option value="Work From Home" selected="selected">Work From Home</option>
                            }
                            else
                            {
                                <option value="Work From Home">Work From Home</option>
                            }

                            @if (Model.Reason == "On Duty")
                            {
                                <option value="On Duty" selected="selected">On Duty</option>
                            }
                            else
                            {
                                <option value="On Duty">On Duty</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input type="text" class="form-control" value="@Model.Reason" disabled="disabled" />
                        <input type="hidden" name="Reason" value="@Model.Reason" />
                    }
                </div>

                <div class="col-md-6">
                    <label class="form-label">Explanation</label>

                    @if (isDraft)
                    {
                        <textarea class="form-control editable-field"
                              name="Explanation"
                              rows="4">@Model.Explanation</textarea>
                    }
                    else
                    {
                        <textarea class="form-control"
                              rows="4"
                              disabled="disabled">@Model.Explanation</textarea>
                        <input type="hidden" name="Explanation" value="@Model.Explanation" />
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mb-4">
        @if (isDraft)
        {
            <button type="submit"
                    class="btn btn-dark"
                    name="actionCommand"
                    value="Submit"
                    id="mainActionButton">
                Submit
            </button>
        }
        else if (isSubmitted)
        {
            <button type="submit"
                    class="btn btn-danger"
                    name="actionCommand"
                    value="Cancel"
                    onclick="return confirm('Attendance Request is linked with submitted Attendance documents. Do you want to cancel all linked documents?');">
                Cancel
            </button>
        }
    </div>
</form>

<style>
    .card {
        border-radius: 8px;
    }

    .form-label {
        font-weight: 600;
        margin-bottom: 6px;
    }

    .form-control,
    .form-select {
        min-height: 42px;
    }

    .badge {
        font-size: 12px;
        padding: 6px 10px;
        border-radius: 6px;
    }

    .checkbox-panel {
        border: 1px solid #d9e0ea;
        border-radius: 8px;
        padding: 18px;
        background: #f8fafc;
    }

    .form-text {
        font-size: 13px;
        color: #6c757d;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const employeeSelect = document.getElementById("Employee");
        const employeeNameInput = document.getElementById("EmployeeName");

        if (employeeSelect && employeeNameInput) {
            employeeSelect.addEventListener("change", function () {
                const selected = employeeSelect.options[employeeSelect.selectedIndex];
                employeeNameInput.value = selected ? (selected.getAttribute("data-name") || "") : "";
            });
        }

        const halfDay = document.getElementById("HalfDay");
        const halfDayDateBox = document.getElementById("halfDayDateBox");
        const halfDayDate = document.getElementById("HalfDayDate");
        const fromDate = document.getElementById("FromDate");

        function toggleHalfDayDate() {
            if (!halfDay || !halfDayDateBox) return;

            if (halfDay.checked) {
                halfDayDateBox.style.display = "block";

                if (halfDayDate) {
                    halfDayDate.setAttribute("required", "required");

                    if (!halfDayDate.value && fromDate && fromDate.value) {
                        halfDayDate.value = fromDate.value;
                    }
                }
            } else {
                halfDayDateBox.style.display = "none";

                if (halfDayDate) {
                    halfDayDate.removeAttribute("required");

                    if (!halfDayDate.disabled) {
                        halfDayDate.value = "";
                    }
                }
            }
        }

        if (halfDay) {
            halfDay.addEventListener("change", toggleHalfDayDate);
            toggleHalfDayDate();
        }

        if (fromDate && halfDayDate) {
            fromDate.addEventListener("change", function () {
                if (halfDay && halfDay.checked && !halfDayDate.value) {
                    halfDayDate.value = fromDate.value;
                }
            });
        }

        const form = document.getElementById("attendanceRequestForm");
        const actionButton = document.getElementById("mainActionButton");

        if (form && actionButton) {
            const fields = form.querySelectorAll(".editable-field");

            fields.forEach(function (field) {
                field.addEventListener("change", function () {
                    actionButton.textContent = "Save";
                    actionButton.value = "Save";
                });

                field.addEventListener("input", function () {
                    actionButton.textContent = "Save";
                    actionButton.value = "Save";
                });
            });
        }
    });
</script>