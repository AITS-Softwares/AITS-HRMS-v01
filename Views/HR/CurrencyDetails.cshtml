@using Newtonsoft.Json.Linq
@{ ViewBag.Title = "Currency Details"; var d = ViewBag.Document as JObject; string V(string key) => d?[key]?.ToString() ?? ""; bool B(string key) => d?[key]?.ToString() == "1" || d?[key]?.ToString()?.Equals("true", StringComparison.OrdinalIgnoreCase) == true; }
<style>.p{max-width:1210px;margin:auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.h{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.h h1{font-size:22px;margin:0}.actions{display:flex;align-items:center;gap:12px}.back{color:#fff;text-decoration:none;border:1px solid #7890a8;border-radius:7px;padding:8px 13px}.save,.delete{border:0;border-radius:7px;padding:9px 17px;color:#fff;font-weight:650}.save{background:#0f766e}.delete{background:#b42318}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px}.s{padding:20px}.s h2{font-size:17px;margin:0 0 16px}.g{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.f label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.i{box-sizing:border-box;width:100%;height:36px;border:1px solid #b8c7d7;border-radius:8px;padding:8px 10px;background:#fbfdff;font-size:14px}.i[readonly]{background:#f2f6f9;color:#526375}.check{display:flex;align-items:center;gap:8px;padding-top:25px;font-size:14px}.check input{accent-color:#0f766e}@@media(max-width:800px){.p{padding:12px}.h{align-items:flex-start}.actions{flex-wrap:wrap;justify-content:flex-end}.g{grid-template-columns:1fr}}</style>
<div class="p"><form method="post" action="@Url.Action("CurrencyDetails", new { id = V("name") })">@Html.AntiForgeryToken()<header class="h"><h1>Currency Details</h1><div class="actions"><a class="back" asp-action="Currency">Back to Currencies</a><button class="save" type="submit">Save</button></div></header>@if(TempData["ErpNextError"] != null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}@if(TempData["Success"] != null){<div class="alert alert-success mt-3">@TempData["Success"]</div>}<main class="card"><section class="s"><h2>Currency</h2><div class="g"><div class="f"><label>Currency Name</label><input class="i" value="@V("currency_name")" readonly/></div><label class="check"><input name="Enabled" type="checkbox" value="true" checked="@(B("enabled") ? "checked" : null)"/> Enabled</label><div class="f"><label>Fraction</label><input name="Fraction" class="i" value="@V("fraction")"/></div><div class="f"><label>Fraction Units</label><input name="FractionUnits" class="i" value="@V("fraction_units")"/></div><div class="f"><label>Smallest Currency Fraction Value</label><input name="SmallestCurrencyFractionValue" type="number" step="0.000001" class="i" value="@V("smallest_currency_fraction_value")"/></div><div class="f"><label>Symbol</label><input name="Symbol" class="i" value="@V("symbol")"/></div><label class="check"><input name="SymbolOnRight" type="checkbox" value="true" checked="@(B("symbol_on_right") ? "checked" : null)"/> Show Currency Symbol on Right Side</label><div class="f"><label>Number Format</label><input name="NumberFormat" class="i" value="@V("number_format")"/></div></div></section></main></form><form method="post" action="@Url.Action("DeleteCurrency", new { id = V("name") })" class="mt-3" onsubmit="return confirm('Delete this Currency from ERPNext? This cannot be undone.');">@Html.AntiForgeryToken()<button class="delete" type="submit">Delete</button></form></div>
