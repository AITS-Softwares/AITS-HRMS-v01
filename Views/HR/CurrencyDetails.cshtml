@using Newtonsoft.Json.Linq
@{ViewBag.Title="Currency Details";var d=ViewBag.Document as JObject;string V(string key)=>d?[key]?.ToString()??"";bool B(string key)=>d?[key]?.Value<int>()==1;}
<style>.p{max-width:1210px;margin:auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.h{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.h h1{font-size:22px;margin:0}.back{color:#fff;text-decoration:none;border:1px solid #7890a8;border-radius:7px;padding:8px 13px}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px}.s{padding:20px}.s h2{font-size:17px;margin:0 0 16px}.g{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.f label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.v{min-height:36px;box-sizing:border-box;width:100%;border:1px solid #b8c7d7;border-radius:8px;padding:8px 10px;background:#f2f6f9;color:#526375;font-size:14px}.check{display:flex;align-items:center;gap:8px;padding-top:25px;font-size:14px}.check input{accent-color:#0f766e}@@media(max-width:800px){.p{padding:12px}.g{grid-template-columns:1fr}}</style>
<div class="p"><header class="h"><h1>Currency Details</h1><a class="back" asp-action="Currency">Back to Currencies</a></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}<main class="card"><section class="s"><h2>Currency</h2><div class="g"><div class="f"><label>Currency Name</label><div class="v">@V("currency_name")</div></div><label class="check"><input type="checkbox" disabled checked="@B("enabled")"/> Enabled</label><div class="f"><label>Fraction</label><div class="v">@V("fraction")</div></div><div class="f"><label>Fraction Units</label><div class="v">@V("fraction_units")</div></div><div class="f"><label>Smallest Currency Fraction Value</label><div class="v">@V("smallest_currency_fraction_value")</div></div><div class="f"><label>Symbol</label><div class="v">@V("symbol")</div></div><label class="check"><input type="checkbox" disabled checked="@B("symbol_on_right")"/> Show Currency Symbol on Right Side</label><div class="f"><label>Number Format</label><div class="v">@V("number_format")</div></div></div></section></main></div>
