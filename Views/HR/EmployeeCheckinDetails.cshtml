@model Erp_Aits.Models.EmployeeCheckin

@{
    ViewBag.Title = Model.EmployeeName + " - " + Model.EmployeeCheckinCode;

    bool editMode =
        ViewBag.EditMode == true ||
        string.Equals(Context.Request.Query["edit"], "true", StringComparison.OrdinalIgnoreCase);

    string timeValue = Model.Time.HasValue
        ? Model.Time.Value.ToString("yyyy-MM-ddTHH:mm:ss")
        : "";
}

<div class="workforce-ui checkin-details">
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0">@Model.EmployeeName</h4>
        <p class="text-muted small mb-0">@Model.EmployeeCheckinCode</p>
    </div>

    <div class="d-flex gap-2">
        <a href="@Url.Action("EmployeeCheckin", "HR")"
           class="btn btn-outline-secondary btn-sm">
            Back to List
        </a>

        @if (!editMode)
        {
            <a href="/HR/EmployeeCheckinDetails/@Model.Id?edit=true"
               class="btn btn-dark btn-sm">
                Edit
            </a>

            <form method="post"
                  action="@Url.Action("DeleteEmployeeCheckin", "HR", new { id = Model.Id })"
                  onsubmit="return confirm('Are you sure you want to delete this Employee Checkin?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger btn-sm">
                    Delete
                </button>
            </form>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-3">@TempData["Success"]</div>
}

@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["ErpNextError"]</div>
}

<form method="post" action="@Url.Action("UpdateEmployeeCheckin", "HR", new { id = Model.Id })">
    @Html.AntiForgeryToken()

    <div class="card p-4">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Employee *</label>

                @if (editMode)
                {
                    <input name="Employee"
                           id="Employee"
                           class="form-control"
                           list="employeeList"
                           value="@Model.Employee"
                           required />

                    <datalist id="employeeList">
                        @if (ViewBag.Employees != null)
                        {
                            foreach (var emp in ViewBag.Employees)
                            {
                                <option value="@emp.name">@emp.employee_name</option>
                            }
                        }
                    </datalist>
                }
                else
                {
                    <input class="form-control" value="@Model.Employee" readonly />
                    <input type="hidden" name="Employee" value="@Model.Employee" />
                }
            </div>

            <div class="col-md-6">
                <label class="form-label">Time *</label>

                @if (editMode)
                {
                    <input type="datetime-local"
                           name="Time"
                           class="form-control"
                           value="@timeValue"
                           step="1"
                           required />
                }
                else
                {
                    <input class="form-control"
                           value="@(Model.Time?.ToString("dd-MM-yyyy HH:mm:ss"))"
                           readonly />
                    <input type="hidden" name="Time" value="@timeValue" />
                }

                <small class="text-muted">Asia/Kolkata</small>
            </div>

            <div class="col-md-6">
                <label class="form-label">Employee Name</label>
                <input name="EmployeeName"
                       id="EmployeeName"
                       class="form-control bg-light"
                       value="@Model.EmployeeName"
                       readonly />
            </div>

            <div class="col-md-6">
                <label class="form-label">Location / Device ID</label>
                <input name="LocationDeviceId"
                       class="form-control"
                       value="@Model.LocationDeviceId"
                       @(editMode ? "" : "readonly") />
            </div>

            <div class="col-md-6">
                <label class="form-label">Log Type</label>

                @if (editMode)
                {
                    <select name="LogType" class="form-select">
                        <option value="">-- Select --</option>
                        <option value="IN" selected="@(Model.LogType == "IN")">IN</option>
                        <option value="OUT" selected="@(Model.LogType == "OUT")">OUT</option>
                    </select>
                }
                else
                {
                    <input class="form-control" value="@Model.LogType" readonly />
                    <input type="hidden" name="LogType" value="@Model.LogType" />
                }
            </div>

            <div class="col-md-6">
                <div class="form-check mt-4">
                    <input type="hidden" name="SkipAutoAttendance" value="false" />

                    <input class="form-check-input"
                           type="checkbox"
                           name="SkipAutoAttendance"
                           value="true"
                           id="SkipAutoAttendance"
                           @(Model.SkipAutoAttendance ? "checked" : "")
                           @(editMode ? "" : "disabled") />

                    <label class="form-check-label" for="SkipAutoAttendance">
                        Skip Auto Attendance
                    </label>
                </div>
            </div>
        </div>

        @if (editMode)
        {
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-dark">Save</button>
                <a href="/HR/EmployeeCheckinDetails/@Model.Id"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>
            </div>
        }
    </div>
</form>

</div>

<style>
    .workforce-ui.checkin-details { max-width: 1080px; margin: 8px auto 40px; padding: 26px; border: 1px solid #c7daea; border-radius: 8px; background: #edf5fb; box-shadow: 0 16px 34px rgba(19,55,91,.10); }.workforce-ui.checkin-details > .d-flex:first-child { margin: -26px -26px 24px; padding: 20px 26px; background: #14365d; border-radius: 8px 8px 0 0; }.workforce-ui.checkin-details h4 { color: #fff; font-weight: 760; }.workforce-ui.checkin-details .text-muted { color: #b7d0e7!important; }.workforce-ui.checkin-details .btn { border-radius: 6px; font-weight: 700; }.workforce-ui.checkin-details .btn-dark { border-color: #16a085; background: #108c77; }.workforce-ui.checkin-details .btn-outline-secondary { border-color: #91acc7; color: #e7f1fb; }.workforce-ui.checkin-details .btn-outline-secondary:hover { background: #fff; color: #163d64; }.workforce-ui.checkin-details .card { border: 1px solid #c8ddec; border-radius: 8px; box-shadow: 0 8px 20px rgba(16,49,82,.07); }.workforce-ui.checkin-details .form-label { color: #315879; font-weight: 720; }.workforce-ui.checkin-details .form-control, .workforce-ui.checkin-details .form-select { min-height: 42px; border-color: #b9cee2; border-radius: 6px; }.workforce-ui.checkin-details .form-control:focus, .workforce-ui.checkin-details .form-select:focus { border-color: #159b84; box-shadow: 0 0 0 3px rgba(21,155,132,.14); }.workforce-ui.checkin-details .form-control[readonly] { background: #f2f7fb; }.workforce-ui.checkin-details .form-check-input:checked { background-color: #159b84; border-color: #159b84; }
</style>

@if (editMode)
{
    <script>
        async function loadEmployeeName() {
            const employee = document.getElementById("Employee")?.value;
            const employeeNameInput = document.getElementById("EmployeeName");

            if (!employeeNameInput) return;

            employeeNameInput.value = "";

            if (!employee) return;

            try {
                const response = await fetch(
                    '@Url.Action("GetEmployeeSkillMapEmployeeDetails", "HR")' +
                    '?employee=' + encodeURIComponent(employee)
                );

                const data = await response.json();

                if (data && data.success) {
                    employeeNameInput.value = data.employeeName || "";
                }
            } catch (error) {
                console.error(error);
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            const employee = document.getElementById("Employee");

            if (employee) {
                employee.addEventListener("change", loadEmployeeName);
            }
        });
    </script>
}
