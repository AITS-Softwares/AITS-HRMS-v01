@using System.Collections.Generic
@{ViewBag.Title="New Cost Center";var companies=ViewBag.CostCenterCompanies as List<string>??new List<string>();var parents=ViewBag.ParentCostCenters as List<string>??new List<string>();}
<style>.p{max-width:1210px;margin:0 auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.h{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.h h1{font-size:22px;margin:0}.save{border:0;background:#0f766e;color:#fff;padding:9px 17px;border-radius:7px;font-weight:650}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.s{padding:20px}.s h2{font-size:17px;margin:0 0 16px}.g{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.f label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.i,.sel{box-sizing:border-box;width:100%;height:36px;border:1px solid #b8c7d7;border-radius:8px;padding:7px 10px;background:#fbfdff;font-size:14px}.i[readonly]{background:#f2f6f9;color:#526375}.check{display:flex;align-items:center;gap:8px;padding-top:24px;font-size:14px}.ss{position:relative}.sm{display:none;position:fixed;z-index:3000;max-height:260px;overflow:auto;background:#fff;border:1px solid #94a3b8;border-radius:6px;box-shadow:0 10px 20px rgba(15,23,42,.18)}.sm button{display:block;width:100%;padding:8px 10px;border:0;background:#fff;text-align:left}.sm button:hover{background:#e8f3f3;color:#0f766e}@@media(max-width:800px){.p{padding:12px}.g{grid-template-columns:1fr}}</style>
<div class="p"><form method="post" asp-action="CreateCostCenter">@Html.AntiForgeryToken()<header class="h"><h1>New Cost Center</h1><button class="save" type="submit">Save</button></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}<main class="card"><section class="s"><h2>Cost Center</h2><div class="g"><div class="f"><label>Cost Center Name *</label><input name="CostCenterName" class="i" required/></div><div class="f"><label>Cost Center Number</label><input name="CostCenterNumber" class="i"/></div><div class="f"><label>Parent Cost Center *</label><select name="ParentCostCenter" class="sel searchable" required><option value="">Select parent cost center</option>@foreach(var x in parents){<option value="@x">@x</option>}</select></div><div class="f"><label>Company *</label><select name="Company" class="sel searchable" required><option value="">Select company</option>@foreach(var x in companies){<option value="@x">@x</option>}</select></div><label class="check"><input name="IsGroup" type="checkbox"/> Is Group</label><label class="check"><input name="Disabled" type="checkbox"/> Disabled</label><div class="f"><label>Lft</label><input class="i" readonly/></div><div class="f"><label>Rgt</label><input class="i" readonly/></div><div class="f"><label>Old Parent</label><input class="i" readonly/></div></div></section></main></form></div>
<script>document.querySelectorAll('select.searchable').forEach(s=>{if(s.options.length<=11)return;const w=document.createElement('div'),i=document.createElement('input'),m=document.createElement('div');w.className='ss';i.className='i';i.placeholder='Type to search';m.className='sm';s.parentNode.insertBefore(w,s);w.append(i,s,m);s.style.display='none';const draw=()=>{const q=i.value.toLowerCase(),a=[...s.options].filter(x=>x.value&&x.text.toLowerCase().startsWith(q)).slice(0,10);m.innerHTML='';a.forEach(x=>{const b=document.createElement('button');b.type='button';b.textContent=x.text;b.onclick=()=>{s.value=x.value;i.value=x.text;m.style.display='none';s.dispatchEvent(new Event('change'))};m.appendChild(b)});const r=i.getBoundingClientRect();m.style.width=r.width+'px';m.style.left=r.left+'px';m.style.top=r.bottom+'px';m.style.display='block'};i.onfocus=draw;i.oninput=draw;document.addEventListener('click',x=>{if(!w.contains(x.target))m.style.display='none'})});</script>
