@model Erp_Aits.Models.Employee
@using Erp_Aits.Models
@using Microsoft.AspNetCore.Mvc.Rendering
@using Newtonsoft.Json.Linq
@using System.Collections

@functions {
    private static string DropValue(object row, string field)
    {
        if (row == null) return string.Empty;

        if (row is JObject obj)
        {
            return obj[field]?.ToString() ?? string.Empty;
        }

        if (row is JToken token)
        {
            return token[field]?.ToString() ?? string.Empty;
        }

        var prop = row.GetType().GetProperty(field);
        return prop?.GetValue(row)?.ToString() ?? string.Empty;
    }

    private static List<SelectListItem> DropOptions(object source, string valueField, string textField, string firstOption)
    {
        var items = new List<SelectListItem>
        {
            new SelectListItem { Value = "", Text = firstOption }
        };

        if (source is IEnumerable rows && source is not string)
        {
            foreach (var row in rows)
            {
                var value = DropValue(row, valueField);
                var text = DropValue(row, textField);

                if (string.IsNullOrWhiteSpace(text))
                {
                    text = value;
                }

                if (!string.IsNullOrWhiteSpace(value)
                    && !items.Any(x => string.Equals(x.Value, value, StringComparison.OrdinalIgnoreCase)))
                {
                    items.Add(new SelectListItem { Value = value, Text = text });
                }
            }
        }

        return items;
    }
}



        @{
    var educationRows = Model?.EducationRows != null && Model.EducationRows.Any()
        ? Model.EducationRows
        : new List<EmployeeEducationRow> { new EmployeeEducationRow() };

    var externalRows = Model?.ExternalWorkHistoryRows != null && Model.ExternalWorkHistoryRows.Any()
        ? Model.ExternalWorkHistoryRows
        : new List<EmployeeExternalWorkHistoryRow> { new EmployeeExternalWorkHistoryRow() };

    var internalRows = Model?.InternalWorkHistoryRows != null && Model.InternalWorkHistoryRows.Any()
        ? Model.InternalWorkHistoryRows
        : new List<EmployeeInternalWorkHistoryRow> { new EmployeeInternalWorkHistoryRow() };

    var companyOptions = DropOptions(ViewBag.Companies, "name", "name", "Select Company");
    var userOptions = DropOptions(ViewBag.Users, "name", "name", "Select User");
    var designationOptions = DropOptions(ViewBag.Designations, "name", "name", "Select Designation");
    var departmentOptions = DropOptions(ViewBag.Departments, "name", "name", "Select Department");
    var reportsToOptions = DropOptions(ViewBag.ReportsToEmployees, "name", "name", "Select Reports To");
    var branchOptions = DropOptions(ViewBag.Branches, "name", "name", "Select Branch");
    var gradeOptions = DropOptions(ViewBag.EmployeeGrades, "name", "name", "Select Grade");
    var employmentTypeOptions = DropOptions(ViewBag.EmploymentTypes, "name", "name", "Select Employment Type");
    var jobApplicantOptions = DropOptions(ViewBag.JobApplicants, "name", "applicant_name", "Select Job Applicant");
    var holidayListOptions = DropOptions(ViewBag.HolidayLists, "name", "name", "Select Holiday List");
    var defaultShiftOptions = DropOptions(ViewBag.ShiftTypes, "name", "name", "Select Default Shift");
    var payrollCostCenterOptions = DropOptions(ViewBag.CostCenters, "name", "name", "Select Payroll Cost Center");
    var healthInsuranceProviderOptions = DropOptions(ViewBag.HealthInsuranceProviders, "name", "name", "Select Health Insurance Provider");
    var salutationOptions = DropOptions(ViewBag.Salutations, "name", "name", "Select Salutation");

    var preferredContactEmailOptions = DropOptions(ViewBag.PreferredContactEmails, "name", "name", "Select Preferred Contact Email");
    if (preferredContactEmailOptions.Count == 1)
    {
        preferredContactEmailOptions.Add(new SelectListItem { Value = "Personal Email", Text = "Personal Email" });
        preferredContactEmailOptions.Add(new SelectListItem { Value = "Company Email", Text = "Company Email" });
        preferredContactEmailOptions.Add(new SelectListItem { Value = "User ID", Text = "User ID" });
    }
}

