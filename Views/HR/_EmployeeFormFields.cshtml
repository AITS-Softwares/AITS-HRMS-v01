                <div class="employee-field">
                    <label asp-for="FamilyBackground">Family Background</label>
                    <textarea asp-for="FamilyBackground"></textarea>
                    <div class="employee-help">Here you can maintain family details like name and occupation of parent, spouse and children</div>
                </div>

                <div class="employee-field">
                    <label asp-for="HealthDetails">Health Details</label>
                    <textarea asp-for="HealthDetails"></textarea>
                    <div class="employee-help">Here you can maintain height, weight, allergies, medical concerns etc</div>
                </div>
            </div>
        </div>

        @* <div class="employee-section">
            <div class="employee-section-title">Health Insurance</div>
            <div class="employee-grid two">
            <div class="employee-field">
                <label asp-for="HealthInsuranceProvider">Health Insurance Provider</label>
                <select asp-for="HealthInsuranceProvider" asp-items="healthInsuranceProviderOptions"></select>
            </div>
            </div>
        </div> *@
        <div class="employee-section">
            <div class="employee-section-title">Health Insurance</div>
            <div class="employee-grid two">
                <div class="employee-field">
                    <label asp-for="HealthInsuranceProvider">Health Insurance Provider</label>
                    <select asp-for="HealthInsuranceProvider" asp-items="healthInsuranceProviderOptions"></select>
                </div>

                <div class="employee-field">
                    <label asp-for="HealthInsuranceNo">Health Insurance No</label>
                    <input asp-for="HealthInsuranceNo" />
                </div>
            </div>
        </div>

        <div class="employee-section">
            <div class="employee-section-title">Passport Details</div>
            <div class="employee-grid two">
                <div class="employee-field">
                    <label asp-for="PassportNumber">Passport Number</label>
                    <input asp-for="PassportNumber" />
                </div>

                <div class="employee-field">
                    <label asp-for="PassportDateOfIssue">Date of Issue</label>
                    <input asp-for="PassportDateOfIssue" type="date" />
                </div>

                <div class="employee-field">
                    <label asp-for="PassportValidUpto">Valid Upto</label>
                    <input asp-for="PassportValidUpto" type="date" />
                </div>

                <div class="employee-field">
                    <label asp-for="PassportPlaceOfIssue">Place of Issue</label>
                    <input asp-for="PassportPlaceOfIssue" />
                </div>
            </div>
        </div>
    </div>

    <div class="employee-pane" data-employee-pane="profile">
        <div class="employee-section">
            <div class="employee-grid one">
                <div class="employee-field">
                    <label asp-for="Bio">Bio / Cover Letter</label>
                    <textarea asp-for="Bio" style="min-height: 220px;"></textarea>
                    <div class="employee-help">Short biography for website and other publications.</div>
                </div>
            </div>
        </div>

        <div class="employee-section">
            <div class="employee-section-title">Educational Qualification</div>
            <table class="employee-table" id="educationTable">
                <thead>
                    <tr>
                        <th style="width:60px;">No.</th>
                        <th>School/University</th>
                        <th>Qualification</th>
                        <th>Level</th>
                        <th>Year of Passing</th>
                        <th style="width:60px;"></th>
                    </tr>
                </thead>
                <tbody id="educationBody">
                    @for (var i = 0; i < educationRows.Count; i++)
                    {
                        <tr>
                            <td>@(i + 1)</td>

                            <td>
                                <input name="EduSchools" value="@educationRows[i].SchoolUniversity" />
                            </td>

                            <td>
                                <input name="EduQualifications" value="@educationRows[i].Qualification" />
                            </td>

                            <td>
                                <select name="EduLevels">
                                    <option value="">Select Level</option>
                                    <option value="Graduate" selected="@(educationRows[i].Level == "Graduate" ? "selected" : null)">Graduate</option>
                                    <option value="Post Graduate" selected="@(educationRows[i].Level == "Post Graduate" ? "selected" : null)">Post Graduate</option>
                                    <option value="Under Graduate" selected="@(educationRows[i].Level == "Under Graduate" ? "selected" : null)">Under Graduate</option>
                                </select>
                            </td>

                            <td>
                                <input name="EduYears" type="number" value="@educationRows[i].YearOfPassing" />
                            </td>

                            <td>
                                <button type="button" class="employee-remove-btn" onclick="this.closest('tr').remove(); renumberRows('educationBody');">x</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <button type="button" class="employee-small-btn" onclick="addEducationRow()">Add Row</button>
        </div>

        <div class="employee-section">
            <div class="employee-section-title">Previous Work Experience</div>
            <table class="employee-table" id="externalWorkTable">
                <thead>
                    <tr>
                        <th style="width:60px;">No.</th>
                        <th>Company</th>
                        <th>Designation</th>
                        <th>Salary</th>
                        <th>Address</th>
                        <th style="width:60px;"></th>
                    </tr>
                </thead>
                <tbody id="externalWorkBody">
                    @for (var i = 0; i < externalRows.Count; i++)
                    {
                        <tr>
                            <td>@(i + 1)</td>
                            <td><input name="ExpCompanies" value="@externalRows[i].CompanyName" /></td>
                            <td>
                                <select name="ExpDesignations">
                                    @foreach (var item in designationOptions)
                                    {
                                        <option value="@item.Value" selected="@(item.Value == externalRows[i].Designation ? "selected" : null)">
                                            @item.Text
                                        </option>
                                    }
                                </select>
                            </td>
                            <td><input name="ExpSalaries" type="number" step="0.01" value="@externalRows[i].Salary" /></td>
                            <td><input name="ExpAddresses" value="@externalRows[i].Address" /></td>
                            <td><button type="button" class="employee-remove-btn" onclick="this.closest('tr').remove(); renumberRows('externalWorkBody');">x</button></td>
                        </tr>
                    }
                </tbody>
            </table>
            <button type="button" class="employee-small-btn" onclick="addExternalWorkRow()">Add Row</button>
        </div>
        <div class="employee-section">
            <div class="employee-section-title">History In Company</div>
            <table class="employee-table" id="internalWorkTable">
                <thead>
                    <tr>
                        <th style="width:60px;">No.</th>
                        <th>Branch</th>
                        <th>Department</th>
                        <th>Designation</th>
                        <th>From Date</th>
                        <th>To Date</th>
                        <th style="width:60px;"></th>
                    </tr>
                </thead>
                <tbody id="internalWorkBody">
                    @for (var i = 0; i < internalRows.Count; i++)
                    {
                        <tr>
                            <td>@(i + 1)</td>
                        <td>
                            <select name="HistBranches">
                                <option value="">Select Branch</option>
                                @foreach (var item in branchOptions)
                                {
                                    <option value="@item.Value" selected="@(item.Value == internalRows[i].Branch ? "selected" : null)">
                                        @item.Text
                                    </option>
                                }
                            </select>
                        </td>
                        <td>
                            <select name="HistDepartments">
                                <option value="">Select Department</option>
                                @foreach (var item in departmentOptions)
                                {
                                    <option value="@item.Value" selected="@(item.Value == internalRows[i].Department ? "selected" : null)">
                                        @item.Text
                                    </option>
                                }
                            </select>
                        </td>
                        <td>
                            <select name="HistDesignations">
                                <option value="">Select Designation</option>
                                @foreach (var item in designationOptions)
                                {
                                    <option value="@item.Value" selected="@(item.Value == internalRows[i].Designation ? "selected" : null)">
                                        @item.Text
                                    </option>
                                }
                            </select>
                        </td>
                            <td><input name="HistFromDates" type="date" value="@(internalRows[i].FromDate?.ToString("yyyy-MM-dd"))" /></td>
                            <td><input name="HistToDates" type="date" value="@(internalRows[i].ToDate?.ToString("yyyy-MM-dd"))" /></td>
                            <td><button type="button" class="employee-remove-btn" onclick="this.closest('tr').remove(); renumberRows('internalWorkBody');">x</button></td>
                        </tr>
                    }
                </tbody>
            </table>
            <button type="button" class="employee-small-btn" onclick="addInternalWorkRow()">Add Row</button>
        </div>
    </div>

    <div class="employee-pane" data-employee-pane="exit">
        <div class="employee-section">
            <div class="employee-grid">
                <div class="employee-field">
                    <label asp-for="ResignationLetterDate">Resignation Letter Date</label>
                    <input asp-for="ResignationLetterDate" type="date" />
                </div>

                <div class="employee-field">
                    <label asp-for="ExitInterviewHeldOn">Exit Interview Held On</label>
                    <input asp-for="ExitInterviewHeldOn" type="date" />
                </div>

                <div class="employee-field">
                    <label asp-for="LeaveEncashed">Leave Encashed?</label>
                    <select asp-for="LeaveEncashed">
                        <option value="">Select</option>
                        <option value="true">Yes</option>
                        <option value="false">No</option>
                    </select>
                </div>

                <div class="employee-field">
                    <label asp-for="EncashmentDate">Encashment Date</label>
                    <input asp-for="EncashmentDate" type="date" />
                </div>

                <div class="employee-field">
                    <label asp-for="RelievingDate">Relieving Date</label>
                    <input asp-for="RelievingDate" type="date" />
                </div>

                <div class="employee-field">
                    <label asp-for="NewWorkplace">New Workplace</label>
                    <input asp-for="NewWorkplace" />
                </div>
            </div>
        </div>

        <div class="employee-section">
            <div class="employee-section-title">Feedback</div>
            <div class="employee-grid two">
                <div class="employee-field">
                    <label asp-for="ReasonForLeaving">Reason for Leaving</label>
                    <textarea asp-for="ReasonForLeaving"></textarea>
                </div>

                <div class="employee-field">
                    <label asp-for="Feedback">Feedback</label>
                    <textarea asp-for="Feedback"></textarea>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
       document.addEventListener('DOMContentLoaded', function () {
        function showEmployeePane(selectedTab) {
            document.querySelectorAll('[data-employee-tab]').forEach(function (button) {
                button.classList.toggle('active', button.getAttribute('data-employee-tab') === selectedTab);
            });

            document.querySelectorAll('[data-employee-pane]').forEach(function (pane) {
                var isSelected = pane.getAttribute('data-employee-pane') === selectedTab;
                pane.classList.toggle('active', isSelected);
                pane.style.display = isSelected ? 'block' : 'none';
            });
        }

        document.querySelectorAll('[data-employee-tab]').forEach(function (tabButton) {
            tabButton.addEventListener('click', function (e) {
                e.preventDefault();
                showEmployeePane(tabButton.getAttribute('data-employee-tab'));
            });
        });

        showEmployeePane('overview');
            function toggleBankDetails() {
        var salaryMode = document.getElementById('SalaryMode');
        var bankDetails = document.getElementById('bankDetailsSection');

        if (!salaryMode || !bankDetails) {
            return;
        }

        bankDetails.style.display = salaryMode.value === 'Bank' ? 'block' : 'none';
    }

    var salaryMode = document.getElementById('SalaryMode');
    if (salaryMode) {
        salaryMode.addEventListener('change', toggleBankDetails);
    }

    toggleBankDetails();
    });

    function renumberRows(bodyId) {
        document.querySelectorAll('#' + bodyId + ' tr').forEach(function (row, index) {
            row.cells[0].innerText = index + 1;
        });
    }

    function removeEmployeeRow(button, bodyId) {
        button.closest('tr').remove();
        renumberRows(bodyId);
    }

    function addEducationRow() {
        var tbody = document.getElementById('educationBody');
        var tr = document.createElement('tr');

        tr.innerHTML =
            '<td></td>' +
            '<td><input name="EduSchools" /></td>' +
            '<td><input name="EduQualifications" /></td>' +
          '<td><select name="EduLevels"><option value="">Select Level</option><option value="Graduate">Graduate</option><option value="Post Graduate">Post Graduate</option><option value="Under Graduate">Under Graduate</option></select></td>' +
            '<td><input name="EduYears" type="number" /></td>' +
            '<td><button type="button" class="employee-remove-btn" onclick="removeEmployeeRow(this, \'educationBody\')">x</button></td>';

        tbody.appendChild(tr);
        renumberRows('educationBody');
    }

    function addExternalWorkRow() {
        var tbody = document.getElementById('externalWorkBody');
        var tr = document.createElement('tr');

        tr.innerHTML =
            '<td></td>' +
            '<td><input name="ExpCompanies" /></td>' +
            '<td><select name="ExpDesignations">' + (document.getElementById('Designation') ? document.getElementById('Designation').innerHTML : '<option value="">Select Designation</option>') + '</select></td>' +
            '<td><input name="ExpSalaries" type="number" step="0.01" /></td>' +
            '<td><input name="ExpAddresses" /></td>' +
            '<td><button type="button" class="employee-remove-btn" onclick="removeEmployeeRow(this, \'externalWorkBody\')">x</button></td>';

        tbody.appendChild(tr);
        renumberRows('externalWorkBody');
    }



        function clearEmptyRow(tbody) {
        if (!tbody) {
            return;
        }

        var emptyRow = tbody.querySelector('[data-empty-row="true"], .empty-row');
        if (emptyRow) {
            emptyRow.remove();
        }
    }






      function addInternalWorkRow() {
        var tbody = document.getElementById('internalWorkBody');
        clearEmptyRow(tbody);

        var branchSelect = document.getElementById('Branch');
        var departmentSelect = document.getElementById('Department');
        var designationSelect = document.getElementById('Designation');

        var branchOptionsHtml = branchSelect ? branchSelect.innerHTML : '<option value="">Select Branch</option>';
        var departmentOptionsHtml = departmentSelect ? departmentSelect.innerHTML : '<option value="">Select Department</option>';
        var designationOptionsHtml = designationSelect ? designationSelect.innerHTML : '<option value="">Select Designation</option>';

        var tr = document.createElement('tr');

        tr.innerHTML =
            '<td></td>' +
            '<td><select name="HistBranches">' + branchOptionsHtml + '</select></td>' +
            '<td><select name="HistDepartments">' + departmentOptionsHtml + '</select></td>' +
            '<td><select name="HistDesignations">' + designationOptionsHtml + '</select></td>' +
            '<td><input name="HistFromDates" type="date" /></td>' +
            '<td><input name="HistToDates" type="date" /></td>' +
            '<td><button type="button" class="employee-remove-btn" onclick="removeEmployeeRow(this, \'internalWorkBody\')">x</button></td>';

        tbody.appendChild(tr);
        renumberRows('internalWorkBody');
    }
</script>
