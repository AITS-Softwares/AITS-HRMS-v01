        // INITIAL PAGE
        // ============================================================

        document.addEventListener(
            "DOMContentLoaded",
            async function()
            {
                await loadAccounts();
                const savedReferences = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.References ?? new List<Erp_Aits.Models.PaymentEntryReference>()));
                savedReferences.forEach(r => addPaymentReference({ voucher_type: r.ReferenceDoctype, voucher_no: r.ReferenceName, invoice_amount: r.GrandTotal, outstanding_amount: r.OutstandingAmount, allocated_amount: r.AllocatedAmount, payment_term: r.PaymentTerm, due_date: r.DueDate ? r.DueDate.substring(0, 10) : "", exchange_rate: r.ExchangeRate }));
                const savedTaxes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Taxes ?? new List<Erp_Aits.Models.PaymentEntryTax>()));
                savedTaxes.forEach(t => {
                    addTaxRow(); const row = document.querySelector("#taxBody tr:last-child");
                    const set = (name, value) => { const el = row.querySelector('[name$=".' + name + '"]'); if (el.type === "checkbox") el.checked = !!value; else el.value = value ?? ""; };
                    set("Type", t.Type); set("AccountHead", t.AccountHead); set("TaxRate", t.TaxRate); set("Amount", t.Amount); set("AddDeductTax", t.AddDeductTax || "Add"); set("RowId", t.RowId); set("IncludedInPaidAmount", t.IncludedInPaidAmount);
                });
                const savedDeductions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Deductions ?? new List<Erp_Aits.Models.PaymentEntryDeduction>()));
                savedDeductions.forEach(d => {
                    document.getElementById("addPaymentDeduction").click(); const row = deductionsBody.lastElementChild;
                    row.querySelector('[name$=".Account"]').value = d.Account || ""; row.querySelector('[name$=".CostCenter"]').value = d.CostCenter || ""; row.querySelector('[name$=".Amount"]').value = d.Amount;
                });
                if (!document.getElementById("CompanyAddress").value && !document.getElementById("CustomerAddress").value) await loadPaymentGstDetails();
                updateReferenceAmounts();

                refreshVisibility();
            }
        );

