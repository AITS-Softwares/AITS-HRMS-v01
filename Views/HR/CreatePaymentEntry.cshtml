        async function loadPaymentGstDetails() {
            const fields = ["CompanyAddress", "CompanyGstin", "CustomerAddress", "BillingAddressGstin", "PlaceOfSupply", "GstCategory"];
            fields.forEach(id => document.getElementById(id).value = "");
            if (!company.value) return;
            const requestCompany = company.value, requestParty = party.value, requestType = partyType.value;
            try {
                const params = new URLSearchParams({ company: requestCompany, partyType: requestType, party: requestParty });
                const result = await (await fetch("/HR/PaymentEntryGstDetails?" + params)).json();
                if (requestCompany !== company.value || requestParty !== party.value || requestType !== partyType.value) return;
                if (!result.success) throw new Error(result.message || "GST details could not be loaded.");
                document.getElementById("CompanyAddress").value = result.companyAddress || "";
                document.getElementById("CompanyGstin").value = result.companyGstin || "";
                document.getElementById("CustomerAddress").value = result.customerAddress || "";
                document.getElementById("BillingAddressGstin").value = result.customerGstin || "";
                document.getElementById("PlaceOfSupply").value = result.placeOfSupply || "";
                document.getElementById("GstCategory").value = result.gstCategory || "";
            } catch (error) { alert(error.message); }
        }
        party.addEventListener("change", loadPaymentGstDetails);
        company.addEventListener("change", loadPaymentGstDetails);

        const referencesBody = document.getElementById("paymentReferencesBody");
        const deductionsBody = document.getElementById("paymentDeductionsBody");
        const number = element => Number(element?.value) || 0;
        function updateReferenceAmounts() {
            let allocated = 0;
            referencesBody.querySelectorAll("tr").forEach((row, index) => {
                row.querySelectorAll("input").forEach(input => input.name = input.name.replace(/References\[\d+\]/, "References[" + index + "]"));
                allocated += number(row.querySelector(".reference-allocated"));
            });
            allocated = Math.abs(allocated);
            let deductions = 0;
            deductionsBody.querySelectorAll("tr").forEach((row, index) => {
                row.querySelectorAll("input").forEach(input => input.name = input.name.replace(/Deductions\[\d+\]/, "Deductions[" + index + "]"));
                deductions += number(row.querySelector(".deduction-amount"));
            });
            const source = number(document.getElementById("SourceExchangeRate")) || 1;
            const target = number(document.getElementById("TargetExchangeRate")) || 1;
            const basePaid = number(document.getElementById("PaidAmount")) * source;
            const baseReceived = number(document.getElementById("ReceivedAmount")) * target;
            const taxRows = [...document.querySelectorAll("#taxBody tr:not(#noTaxRow)")];
            let fractions = [], cumulative = [], includedFraction = 0, invalid = false;
            taxRows.forEach((row, index) => {
                const type = row.querySelector('[name$=".Type"]').value;
                const rate = number(row.querySelector('[name$=".TaxRate"]')) / 100;
                const sign = row.querySelector('[name$=".AddDeductTax"]').value === "Deduct" ? -1 : 1;
                const included = row.querySelector('[name$=".IncludedInPaidAmount"]').checked;
                const ref = number(row.querySelector('[name$=".RowId"]')) || index;
                if ((type === "On Previous Row Amount" || type === "On Previous Row Total") && (ref < 1 || ref > index)) invalid = true;
                let fraction = 0;
                if (included && type === "Actual") invalid = true;
                if (included && type === "On Paid Amount") fraction = rate;
                if (included && type === "On Previous Row Amount") fraction = rate * (fractions[ref - 1] || 0);
                if (included && type === "On Previous Row Total") fraction = rate * (cumulative[ref - 1] || 0);
                fraction *= sign; fractions.push(fraction); cumulative.push((cumulative[index - 1] ?? 1) + fraction); includedFraction += fraction;
            });
            let net = basePaid / (1 + includedFraction), running = net, baseTax = 0, includedTax = 0, taxes = [];
            taxRows.forEach((row, index) => {
                const type = row.querySelector('[name$=".Type"]').value;
                const rate = number(row.querySelector('[name$=".TaxRate"]')) / 100;
                const sign = row.querySelector('[name$=".AddDeductTax"]').value === "Deduct" ? -1 : 1;
                const included = row.querySelector('[name$=".IncludedInPaidAmount"]').checked;
                const ref = number(row.querySelector('[name$=".RowId"]')) || index;
                const amountInput = row.querySelector('[name$=".Amount"]');
                let amount = type === "Actual" ? number(amountInput) : type === "On Paid Amount" ? net * rate : type === "On Previous Row Amount" ? (taxes[ref - 1]?.amount || 0) * rate : (taxes[ref - 1]?.total || 0) * rate;
                amount = Math.round((amount + Number.EPSILON) * 100) / 100;
                if (type !== "Actual") amountInput.value = amount.toFixed(2);
                running += sign * amount; baseTax += sign * amount; if (included) includedTax += sign * amount;
                row.querySelector('[name$=".Total"]').value = invalid ? "" : running.toFixed(2);
                taxes.push({ amount, total: running });
            });
            const rate = paymentType.value === "Pay" ? target : source;
            const baseAllocated = allocated * rate;
            let unallocated = 0;
            if (party.value && paymentType.value === "Receive" && baseAllocated < basePaid + deductions) unallocated = (basePaid + deductions - baseAllocated - includedTax) / source;
            if (party.value && paymentType.value === "Pay" && baseAllocated < baseReceived - deductions) unallocated = (baseReceived - deductions - baseAllocated - includedTax) / target;
            const baseParty = baseAllocated + unallocated * rate;
            let difference = paymentType.value === "Receive" ? baseParty - baseReceived : paymentType.value === "Pay" ? basePaid - baseParty : basePaid - baseReceived;
            difference += baseTax - deductions;
            document.getElementById("TotalAllocatedAmount").value = allocated.toFixed(2);
            document.getElementById("UnallocatedAmount").value = invalid ? "" : unallocated.toFixed(2);
            document.getElementById("DifferenceAmount").value = invalid ? "" : difference.toFixed(2);
            document.getElementById("TotalTaxesAndCharges").value = invalid ? "" : (baseTax / rate).toFixed(2);
        }
        function addPaymentReference(data = {}) {
            const row = document.createElement("tr");
            row.innerHTML = '<td><input class="form-control" name="References[0].ReferenceDoctype" required></td><td><input class="form-control" name="References[0].ReferenceName" required><input type="hidden" name="References[0].PaymentTerm"><input type="hidden" name="References[0].DueDate"><input type="hidden" name="References[0].ExchangeRate"></td><td><input class="form-control" name="References[0].GrandTotal" readonly></td><td><input class="form-control" name="References[0].OutstandingAmount" readonly></td><td><input class="form-control reference-allocated" name="References[0].AllocatedAmount" type="number" step="0.01"></td><td><button type="button" class="btn btn-outline-danger remove-reference" aria-label="Remove reference">&times;</button></td>';
            const set = (field, value) => row.querySelector('[name$=".' + field + '"]').value = value ?? "";
            set("ReferenceDoctype", data.voucher_type); set("ReferenceName", data.voucher_no); set("GrandTotal", data.invoice_amount); set("OutstandingAmount", data.outstanding_amount); set("AllocatedAmount", data.allocated_amount ?? 0); set("PaymentTerm", data.payment_term); set("DueDate", data.due_date); set("ExchangeRate", data.exchange_rate);
            referencesBody.appendChild(row); updateReferenceAmounts();
        }
        document.getElementById("addPaymentReference").addEventListener("click", () => addPaymentReference());
        async function fetchOutstanding(kind) {
            const params = new URLSearchParams({ company: company.value, partyType: partyType.value, party: party.value, paymentType: paymentType.value, partyAccount: paymentType.value === "Receive" ? paidFrom.value : paidTo.value, postingDate: document.getElementById("PostingDate").value, costCenter: document.getElementById("CostCenter").value, kind });
            try {
                const data = await (await fetch("/HR/PaymentEntryOutstanding?" + params)).json();
                if (!data.success) throw new Error(data.message || "Unable to load outstanding documents.");
                const existing = new Set([...referencesBody.querySelectorAll("tr")].map(row => [row.querySelector('[name$=".ReferenceDoctype"]').value, row.querySelector('[name$=".ReferenceName"]').value, row.querySelector('[name$=".PaymentTerm"]').value].join("|")));
                data.documents.forEach(doc => { const key = [doc.voucher_type, doc.voucher_no, doc.payment_term || ""].join("|"); if (!existing.has(key)) { addPaymentReference(doc); existing.add(key); } });
                if (!data.documents.length) alert("No outstanding " + kind + " found for these criteria.");
            } catch (error) { alert(error.message); }
        }
        document.getElementById("getOutstandingInvoices").addEventListener("click", () => fetchOutstanding("invoices"));
        document.getElementById("getOutstandingOrders").addEventListener("click", () => fetchOutstanding("orders"));
        document.getElementById("addPaymentDeduction").addEventListener("click", () => {
            const row = document.createElement("tr");
            row.innerHTML = '<td><input class="form-control" list="dynamicAccountList" name="Deductions[0].Account" required></td><td><input class="form-control" list="costCenterList" name="Deductions[0].CostCenter" required></td><td><input class="form-control deduction-amount" name="Deductions[0].Amount" type="number" step="0.01"></td><td><button type="button" class="btn btn-outline-danger remove-deduction" aria-label="Remove deduction">&times;</button></td>';
            deductionsBody.appendChild(row); updateReferenceAmounts();
        });
        deductionsBody.addEventListener("input", updateReferenceAmounts);
        deductionsBody.addEventListener("click", event => { if (event.target.classList.contains("remove-deduction")) { event.target.closest("tr").remove(); updateReferenceAmounts(); } });
        document.getElementById("taxBody").addEventListener("input", updateReferenceAmounts);
        document.getElementById("taxBody").addEventListener("change", updateReferenceAmounts);
        document.getElementById("SourceExchangeRate").addEventListener("input", updateReferenceAmounts);
        document.getElementById("TargetExchangeRate").addEventListener("input", updateReferenceAmounts);
        referencesBody.addEventListener("input", updateReferenceAmounts);
        referencesBody.addEventListener("click", event => { if (event.target.classList.contains("remove-reference")) { event.target.closest("tr").remove(); updateReferenceAmounts(); } });
        document.getElementById("PaidAmount").addEventListener("input", updateReferenceAmounts);
        document.getElementById("PaidAmount").addEventListener("change", function () {
            const fromCurrency = document.getElementById("PaidFromAccountCurrency").value;
            const toCurrency = document.getElementById("PaidToAccountCurrency").value;
            if (fromCurrency && fromCurrency === toCurrency) document.getElementById("ReceivedAmount").value = this.value;
            updateReferenceAmounts();
        });
        document.getElementById("ReceivedAmount").addEventListener("input", updateReferenceAmounts);
        paymentType.addEventListener("change", updateReferenceAmounts);


        function reindexTaxRows()
        {
            const rows =
                document.querySelectorAll(
                    "#taxBody tr:not(#noTaxRow)"
                );


            rows.forEach(
                function(row, index)
                {
                    row.querySelector(
                        ".tax-number"
                    ).textContent =
                        index + 1;


                    const controls =
                        row.querySelectorAll(
                            "select, input"
                        );


                    controls.forEach(
                        function(control)
                        {
                            if (!control.name)
                                return;


                            control.name =
                                control.name.replace(
                                    /Taxes\[\d+\]/,
                                    "Taxes[" +
                                    index +
                                    "]"
                                );
                        }
                    );
                }
            );


            taxIndex =
                rows.length;
        }


