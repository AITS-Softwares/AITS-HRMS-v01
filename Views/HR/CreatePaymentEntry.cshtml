@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model Erp_Aits.Models.PaymentEntry

@{
    bool isEdit = Model.Id > 0;
    ViewBag.Title = isEdit ? "Edit Payment Entry" : "New Payment Entry";
}

<style>
    #paymentEntryForm { max-width: 1280px; margin: 0 auto; }
    #paymentEntryForm .card { border: 1px solid #c9dbe5 !important; border-radius: 8px !important; box-shadow: 0 10px 24px rgba(16, 79, 112, .07); }
    #paymentEntryForm .card h6 { color: #075985; font-weight: 700; border-bottom: 1px solid #dbeafe; padding-bottom: .75rem; }
    #paymentEntryForm .form-label { color: #334155; font-size: .84rem; font-weight: 650; }
    #paymentEntryForm .form-control, #paymentEntryForm .form-select { border-color: #b9d2df; min-height: 40px; }
    #paymentEntryForm .form-control:focus, #paymentEntryForm .form-select:focus { border-color: #0f766e; box-shadow: 0 0 0 .18rem rgba(13, 148, 136, .13); }
    .payment-form-header { background: linear-gradient(110deg, #0c4a6e, #0f766e); color: #fff; border-radius: 8px; padding: 1.25rem 1.5rem; }
</style>


@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3">
        <strong>ERPNext Validation:</strong>
        @TempData["ErpNextError"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

@if (ViewBag.PaymentEntryMasterError != null)
{
    <div class="alert alert-warning">@ViewBag.PaymentEntryMasterError</div>
}


<!-- ============================================================= -->
<!-- MASTER DATALISTS -->
<!-- ============================================================= -->

<datalist id="modeOfPaymentList">
    @if (ViewBag.ModesOfPayment != null)
    {
        foreach (var item in ViewBag.ModesOfPayment)
        {
            <option value="@item.name"></option>
        }
    }
</datalist>


<datalist id="paymentContactList"></datalist>
<datalist id="paymentLetterHeads">@foreach (var item in ViewBag.LetterHeads ?? new object[0]) { <option value="@item.name"></option> }</datalist>
<datalist id="paymentPrintHeadings">@foreach (var item in ViewBag.PrintHeadings ?? new object[0]) { <option value="@item.name"></option> }</datalist>
<datalist id="bankList">@foreach (var item in ViewBag.Banks ?? new object[0]) { <option value="@item.name"></option> }</datalist>
<datalist id="taxWithholdingCategoryList">@foreach (var item in ViewBag.TaxWithholdingCategories ?? new object[0]) { <option value="@item.name"></option> }</datalist>
<datalist id="paymentOrderList">@foreach (var item in ViewBag.PaymentOrders ?? new object[0]) { <option value="@item.name"></option> }</datalist>
<datalist id="autoRepeatList">@foreach (var item in ViewBag.AutoRepeats ?? new object[0]) { <option value="@item.name"></option> }</datalist>
<datalist id="dunningList">@foreach (var item in ViewBag.Dunnings ?? new object[0]) { <option value="@item.name"></option> }</datalist>
<datalist id="aiAuditLogList">@foreach (var item in ViewBag.AiAuditLogs ?? new object[0]) { <option value="@item.name"></option> }</datalist>
<datalist id="allowedToTransactWithList">@foreach (var item in ViewBag.AllowedToTransactWithOptions ?? new object[0]) { <option value="@item.name"></option> }</datalist>
<datalist id="appraisalTemplateList">@foreach (var item in ViewBag.AppraisalTemplates ?? new object[0]) { <option value="@item.name"></option> }</datalist>

<datalist id="dynamicAccountList"></datalist>


<datalist id="bankAccountList">
    @if (ViewBag.BankAccounts != null)
    {
        foreach (var item in ViewBag.BankAccounts)
        {
            <option value="@item.name"></option>
        }
    }
</datalist>


<datalist id="projectList">
    @if (ViewBag.Projects != null)
    {
        foreach (var item in ViewBag.Projects)
        {
            <option value="@item.name"></option>
        }
    }
</datalist>


<datalist id="costCenterList">
    @if (ViewBag.CostCenters != null)
    {
        foreach (var item in ViewBag.CostCenters)
        {
            <option value="@item.name"></option>
        }
    }
</datalist>


<datalist id="salesTaxTemplateList">
    @if (ViewBag.SalesTaxTemplates != null)
    {
        foreach (var item in ViewBag.SalesTaxTemplates)
        {
            <option value="@item.name"></option>
        }
    }
</datalist>


<datalist id="purchaseTaxTemplateList">
    @if (ViewBag.PurchaseTaxTemplates != null)
    {
        foreach (var item in ViewBag.PurchaseTaxTemplates)
        {
            <option value="@item.name"></option>
        }
    }
</datalist>


<form asp-controller="HR"
      asp-action="CreatePaymentEntry"
      method="post"
      id="paymentEntryForm">

    <input asp-for="Id" type="hidden" />
    <input asp-for="ErpNextId" type="hidden" />


    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-3 payment-form-header">

        <div>
            <h4 class="mb-0 d-inline">
                @(isEdit ? "Edit Payment Entry" : "New Payment Entry")
            </h4>

            <span class="badge bg-warning-subtle text-warning ms-2">
                @(isEdit ? "Draft - editable" : "Not Saved")
            </span>
        </div>


        <button type="submit"
                class="btn btn-dark btn-sm px-4">

            @(isEdit ? "Save Changes" : "Save")

        </button>

    </div>


    <!-- ========================================================= -->
    <!-- TYPE OF PAYMENT -->
    <!-- ========================================================= -->

    <div class="card border rounded-3 p-4 mb-3">

        <h6 class="mb-3">
            Type of Payment
        </h6>


        <div class="row g-3">

            <!-- SERIES -->
            <div class="col-md-6">

                <label class="form-label">
                    Series
                    <span class="text-danger">*</span>
                </label>

                <select asp-for="Series"
                        class="form-select"
                        required>

                    <option value="">Select series</option>

                    @if (ViewBag.NamingSeries != null)
                    {
                        foreach (var series in ViewBag.NamingSeries)
                        {
                            <option value="@series">
                                @series
                            </option>
                        }
                    }

                </select>

            </div>


            <!-- POSTING DATE -->
            <div class="col-md-6">

                <label class="form-label">
                    Posting Date
                    <span class="text-danger">*</span>
                </label>

                <input asp-for="PostingDate"
                       type="date"
                       class="form-control"
                       required />

            </div>


            <!-- PAYMENT TYPE -->
            <div class="col-md-6">

                <label class="form-label">
                    Payment Type
                    <span class="text-danger">*</span>
                </label>

                <select asp-for="PaymentType"
                        id="PaymentType"
                        class="form-select"
                        required>

                    <option value="Receive">
                        Receive
                    </option>

                    <option value="Pay">
                        Pay
                    </option>

                    <option value="Internal Transfer">
                        Internal Transfer
                    </option>

                </select>

            </div>


            <!-- COMPANY -->
            <div class="col-md-6">

                <label class="form-label">
                    Company
                    <span class="text-danger">*</span>
                </label>

                <select asp-for="Company"
                        id="Company"
                        class="form-select"
                        required>

                    <option value="">
                        -- Select Company --
                    </option>

                    @if (ViewBag.Companies != null)
                    {
                        foreach (var company in ViewBag.Companies)
                        {
                            <option value="@company.name">
                                @company.name
                            </option>
                        }
                    }

                </select>

            </div>


            <!-- MODE OF PAYMENT -->
            <div class="col-md-6">

                <label class="form-label">
                    Mode of Payment
                </label>

                <input asp-for="ModeOfPayment"
                       id="ModeOfPayment"
                       list="modeOfPaymentList"
                       class="form-control"
                       placeholder="Select Mode of Payment..." />

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- PAYMENT FROM / TO -->
    <!-- Hidden completely for Internal Transfer -->
    <!-- ========================================================= -->

    <div class="card border rounded-3 p-4 mb-3"
         id="partySection">

        <h6 class="mb-3">
            Payment From / To
        </h6>


        <div class="row g-3">

            <!-- PARTY TYPE - always shown for Receive / Pay -->
            <div class="col-md-6">

                <label class="form-label">
                    Party Type
                </label>

                <select asp-for="PartyType"
                        id="PartyType"
                        class="form-select">

                    <option value="">
                        -- Select Party Type --
                    </option>

                    <option value="Customer">
                        Customer
                    </option>

                    <option value="Supplier">
                        Supplier
                    </option>

                    <option value="Employee">
                        Employee
                    </option>

                    <option value="Shareholder">
                        Shareholder
                    </option>

                </select>

            </div>


            <!-- PARTY: ERP reveals after Party Type -->
            <div class="col-md-6 dependent-party"
                 style="display:none;">

                <label class="form-label">
                    Party
                    <span class="text-danger">*</span>
                </label>

                <select asp-for="Party"
                        id="Party"
                        class="form-select"
                        required>
                    <option value="">-- Select Party --</option>
                </select>

            </div>


            <!-- PARTY NAME -->
            <div class="col-md-6 dependent-party"
                 style="display:none;">

                <label class="form-label">
                    Party Name
                </label>

                <input asp-for="PartyName"
                       id="PartyName"
                       class="form-control bg-light"
                       readonly />

            </div>


            <!-- COMPANY BANK ACCOUNT -->
            <div class="col-md-6 dependent-party"
                 style="display:none;">

                <label class="form-label">
                    Company Bank Account
                </label>

                <input asp-for="CompanyBankAccount"
                       id="CompanyBankAccount"
                       list="bankAccountList"
                       class="form-control" />

            </div>


            <!-- PARTY BANK ACCOUNT -->
            <div class="col-md-6 dependent-party-selected"
                 style="display:none;">

                <label class="form-label">
                    Party Bank Account
                </label>

                <input asp-for="PartyBankAccount"
                       id="PartyBankAccount"
                       list="bankAccountList"
                       class="form-control" />

            </div>


            <!-- CONTACT -->
            <div class="col-md-6 dependent-contact"
                 style="display:none;">

                <label class="form-label">
                    Contact
                </label>

                <select asp-for="ContactPerson" id="ContactPerson" class="form-select">
                    <option value="">Select contact</option>
                </select>

            </div>


            <!-- CONTACT EMAIL -->
            <div class="col-md-6 dependent-contact"
                 style="display:none;">

                <label class="form-label">
                    Email
                </label>

                <input asp-for="ContactEmail"
                       id="ContactEmail"
                       class="form-control bg-light"
                       readonly />

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- ACCOUNTS -->
    <!-- ========================================================= -->

    <div class="card border rounded-3 p-4 mb-3">

        <h6 class="mb-3">
            Accounts
        </h6>


        <div class="row g-3">

            <!-- PARTY BALANCE -->
            <div class="col-md-6"
                 id="PartyBalanceContainer"
                 style="display:none;">

                <label class="form-label">
                    Party Balance
                </label>

                <input asp-for="PartyBalance"
                       id="PartyBalance"
                       class="form-control bg-light"
                       readonly />

            </div>


            <!-- PAID FROM -->
            <div class="col-md-6"
                 id="PaidFromContainer"
                 style="display:none;">

                <label class="form-label">
                    Account Paid From
                    <span class="text-danger">*</span>
                </label>

                <input asp-for="PaidFrom"
                       id="PaidFrom"
                       list="dynamicAccountList"
                       class="form-control" />

            </div>


            <!-- PAID FROM CURRENCY -->
            <div class="col-md-6"
                 id="PaidFromCurrencyContainer"
                 style="display:none;">

                <label class="form-label">
                    Account Currency (From)
                </label>

                <input asp-for="PaidFromAccountCurrency"
                       id="PaidFromAccountCurrency"
                       class="form-control bg-light"
                       readonly />

            </div>


            <!-- PAID FROM BALANCE -->
            <div class="col-md-6"
                 id="PaidFromBalanceContainer"
                 style="display:none;">

                <label class="form-label">
                    Account Balance (From)
                </label>

                <input asp-for="PaidFromAccountBalance"
                       id="PaidFromAccountBalance"
                       class="form-control bg-light"
                       readonly />

            </div>


            <!-- PAID TO -->
            <div class="col-md-6"
                 id="PaidToContainer"
                 style="display:none;">

                <label class="form-label">
                    Account Paid To
                    <span class="text-danger">*</span>
                </label>

                <input asp-for="PaidTo"
                       id="PaidTo"
                       list="dynamicAccountList"
                       class="form-control" />

            </div>


            <!-- PAID TO CURRENCY -->
            <div class="col-md-6"
                 id="PaidToCurrencyContainer"
                 style="display:none;">

                <label class="form-label">
                    Account Currency (To)
                </label>

                <input asp-for="PaidToAccountCurrency"
                       id="PaidToAccountCurrency"
                       class="form-control bg-light"
                       readonly />

            </div>


            <!-- PAID TO BALANCE -->
            <div class="col-md-6"
                 id="PaidToBalanceContainer"
                 style="display:none;">

                <label class="form-label">
                    Account Balance (To)
                </label>

                <input asp-for="PaidToAccountBalance"
                       id="PaidToAccountBalance"
                       class="form-control bg-light"
                       readonly />

            </div>


        </div>

    </div>


    <!-- ========================================================= -->
    <!-- AMOUNT -->
    <!-- ERP shows after BOTH accounts exist -->
    <!-- ========================================================= -->

    <div class="card border rounded-3 p-4 mb-3"
         id="amountSection"
         style="display:none;">

        <h6 class="mb-3">
            Amount
        </h6>


        <div class="row g-3">

            <div class="col-md-6">

                <label class="form-label">
                    Paid Amount
                    <span class="text-danger">*</span>
                </label>

                <input asp-for="PaidAmount"
                       id="PaidAmount"
                       type="number"
                       step="0.01"
                       class="form-control" />

            </div>


            <div class="col-md-6">

                <label class="form-label">
                    Received Amount
                    <span class="text-danger">*</span>
                </label>

                <input asp-for="ReceivedAmount"
                       id="ReceivedAmount"
                       type="number"
                       step="0.01"
                       class="form-control" />

            </div>


            <div class="col-md-6">

                <label class="form-label">
                    Source Exchange Rate
                </label>

                <input asp-for="SourceExchangeRate"
                       id="SourceExchangeRate"
                       type="number"
                       step="0.000000001"
                       class="form-control" />

            </div>


            <div class="col-md-6">

                <label class="form-label">
                    Target Exchange Rate
                </label>

                <input asp-for="TargetExchangeRate"
                       id="TargetExchangeRate"
                       type="number"
                       step="0.000000001"
                       class="form-control" />

            </div>

            <div class="col-md-6"><label class="form-label">Paid Amount After Tax</label><input asp-for="PaidAmountAfterTax" id="PaidAmountAfterTax" class="form-control" readonly /></div>
            <div class="col-md-6"><label class="form-label">Received Amount After Tax</label><input asp-for="ReceivedAmountAfterTax" id="ReceivedAmountAfterTax" class="form-control" readonly /></div>
            <div class="col-md-6"><label class="form-label">Paid Amount (Company Currency)</label><input asp-for="BasePaidAmount" id="BasePaidAmount" class="form-control" readonly /></div>
            <div class="col-md-6"><label class="form-label">Received Amount (Company Currency)</label><input asp-for="BaseReceivedAmount" id="BaseReceivedAmount" class="form-control" readonly /></div>
            <div class="col-md-6"><label class="form-label">Paid Amount After Tax (Company Currency)</label><input asp-for="BasePaidAmountAfterTax" id="BasePaidAmountAfterTax" class="form-control" readonly /></div>
            <div class="col-md-6"><label class="form-label">Received Amount After Tax (Company Currency)</label><input asp-for="BaseReceivedAmountAfterTax" id="BaseReceivedAmountAfterTax" class="form-control" readonly /></div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- TAXES -->
    <!-- Only Customer / Supplier -->
    <!-- ========================================================= -->

    <div class="card border rounded-3 p-4 mb-3" id="paymentReferencesSection">
        <h6>Payment References</h6>
        <div class="d-flex gap-2 mb-2"><button type="button" class="btn btn-outline-secondary btn-sm" id="getOutstandingInvoices">Get Outstanding Invoices</button><button type="button" class="btn btn-outline-secondary btn-sm" id="getOutstandingOrders">Get Outstanding Orders</button></div>
        <div class="table-responsive"><table class="table table-bordered"><thead><tr><th>Type</th><th>Name</th><th>Grand Total</th><th>Outstanding</th><th>Allocated</th><th></th></tr></thead><tbody id="paymentReferencesBody"></tbody></table></div>
        <div><button type="button" class="btn btn-outline-secondary btn-sm" id="addPaymentReference">Add Row</button></div>
        <div class="row g-3 mt-1">
            <div class="col-md-6"><label class="form-label">Total Allocated Amount</label><input asp-for="TotalAllocatedAmount" class="form-control" readonly /></div>
            <div class="col-md-6"><label class="form-label">Unallocated Amount</label><input asp-for="UnallocatedAmount" class="form-control" readonly /></div>
            <div class="col-md-6"><label class="form-label">Difference Amount (Company Currency)</label><input asp-for="DifferenceAmount" class="form-control" readonly /></div>
        </div>
    </div>

    <div class="card border rounded-3 p-4 mb-3"
         id="taxSection"
         style="display:none;">

        <h6 class="mb-3">
            Taxes and Charges
        </h6>


        <!-- CUSTOMER -->
        <div id="salesTaxContainer"
             style="display:none;"
             class="mb-3">

            <label class="form-label">
                Sales Taxes and Charges Template
            </label>

            <input asp-for="SalesTaxesChargesTemplate"
                   list="salesTaxTemplateList"
                   class="form-control" />

        </div>


        <!-- SUPPLIER -->
        <div id="purchaseTaxContainer"
             style="display:none;"
             class="mb-3">

            <label class="form-label">
                Purchase Taxes and Charges Template
            </label>

            <input asp-for="PurchaseTaxesChargesTemplate"
                   list="purchaseTaxTemplateList"
                   class="form-control" />

        </div>


        <div class="d-flex justify-content-between mb-2">

            <label class="form-label mb-0">
                Advance Taxes and Charges
            </label>

            <button type="button"
                    class="btn btn-outline-secondary btn-sm"
                    id="AddTaxButton">

                Add Row

            </button>

        </div>


        <div class="table-responsive">

            <table class="table table-bordered align-middle"
                   id="taxTable">

                <thead>

                    <tr>
                        <th style="width:50px;">
                            No.
                        </th>

                        <th>
                            Type
                        </th>

                        <th>
                            Account Head
                        </th>

                        <th>
                            Tax Rate
                        </th>

                        <th>
                            Amount
                        </th>

                        <th>
                            Total
                        </th>

                        <th style="width:60px;">
                        </th>
                    </tr>

                </thead>


                <tbody id="taxBody">

                    <tr id="noTaxRow">

                        <td colspan="7"
                            class="text-center text-muted">

                            No Data

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

        <div class="row"><div class="col-md-6 ms-auto"><label class="form-label">Total Taxes and Charges</label><input asp-for="TotalTaxesAndCharges" class="form-control" readonly /></div></div>

    </div>


    <!-- ========================================================= -->
    <!-- GST -->
    <!-- ========================================================= -->

    <div class="card border rounded-3 p-4 mb-3"><h6>Deductions or Loss</h6><div class="table-responsive"><table class="table table-bordered"><thead><tr><th>Account</th><th>Cost Center</th><th>Amount</th><th></th></tr></thead><tbody id="paymentDeductionsBody"></tbody></table></div><div><button type="button" class="btn btn-outline-secondary btn-sm" id="addPaymentDeduction">Add Row</button></div></div>
    <div class="card border rounded-3 p-4 mb-3">

        <h6 class="mb-3">
            GST Details
        </h6>


        <div class="row g-3">

            <div class="col-md-6">

                <label class="form-label">
                    Company Address
                </label>

                <input asp-for="CompanyAddress"
                       class="form-control bg-light"
                       readonly />

            </div>


            <div class="col-md-6 customer-gst"
                 style="display:none;">

                <label class="form-label">
                    Customer Address
                </label>

                <input asp-for="CustomerAddress"
                       class="form-control bg-light"
                       readonly />

            </div>


            <div class="col-md-6">

                <label class="form-label">
                    Company GSTIN
                </label>

                <input asp-for="CompanyGstin"
                       class="form-control bg-light"
                       readonly />

            </div>


            <div class="col-md-6 customer-gst"
                 style="display:none;">

                <label class="form-label">
                    Customer GSTIN
                </label>

                <input asp-for="BillingAddressGstin"
                       class="form-control bg-light"
                       readonly />

            </div>


            <div class="col-md-6 customer-gst"
                 style="display:none;">

                <label class="form-label">
                    Place of Supply
                </label>

                <input asp-for="PlaceOfSupply"
                       class="form-control bg-light"
                       readonly />

            </div>


            <div class="col-md-6 customer-gst"
                 style="display:none;">

                <label class="form-label">
                    GST Category
                </label>

                <input asp-for="GstCategory"
                       class="form-control bg-light"
                       readonly />

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- TRANSACTION REFERENCE -->
    <!-- ========================================================= -->

    <div class="card border rounded-3 p-4 mb-3"
         id="referenceSection"
         style="display:none;">

        <h6 class="mb-3">
            Transaction ID
        </h6>


        <div class="row g-3">

            <div class="col-md-6">

                <label class="form-label">
                    Cheque/Reference No <span class="text-danger">*</span>
                </label>

                <input asp-for="ReferenceNo"
                       id="ReferenceNo"
                       class="form-control"
                       required />

            </div>


            <div class="col-md-6">

                <label class="form-label">
                    Cheque/Reference Date <span class="text-danger">*</span>
                </label>

                <input asp-for="ReferenceDate"
                       id="ReferenceDate"
                       type="date"
                       class="form-control"
                       required />

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- ACCOUNTING DIMENSIONS -->
    <!-- ========================================================= -->

    <div class="card border rounded-3 p-4">

        <h6 class="mb-3">
            Accounting Dimensions
        </h6>


        <div class="row g-3">

            <div class="col-md-6">

                <label class="form-label">
                    Project
                </label>

                <input asp-for="Project"
                       list="projectList"
                       class="form-control" />

            </div>


            <div class="col-md-6">

                <label class="form-label">
                    Cost Center
                </label>

                <input asp-for="CostCenter"
                       list="costCenterList"
                       class="form-control" />

            </div>

            <div class="col-md-6"><label class="form-label">Dunning</label><input asp-for="Dunning" list="dunningList" class="form-control" /></div>
            <div class="col-md-6"><label class="form-label">AI Audit Log</label><input asp-for="AiAuditLog" list="aiAuditLogList" class="form-control" /></div>
            <div class="col-md-6"><label class="form-label">Allowed To Transact With</label><input asp-for="AllowedToTransactWith" list="allowedToTransactWithList" class="form-control" /></div>
            <div class="col-md-6"><label class="form-label">Appraisal Template</label><input asp-for="AppraisalTemplate" list="appraisalTemplateList" class="form-control" /></div>

        </div>

    </div>

    <div class="card border rounded-3 p-4 mb-3">
        <h6>More Information</h6>
        <div class="row g-3">
            <div class="col-md-6"><label class="form-label">Status</label><input class="form-control" value="@(isEdit ? Model.Status : "Draft")" readonly /></div>
            <div class="col-md-6"><label class="form-label">Letter Head</label><input asp-for="LetterHead" list="paymentLetterHeads" class="form-control" /></div>
            <div class="col-md-6"><label><input asp-for="CustomRemarks" /> Custom Remarks</label><textarea asp-for="Remarks" class="form-control"></textarea></div>
            <div class="col-md-6"><label class="form-label">Print Heading</label><input asp-for="PrintHeading" list="paymentPrintHeadings" class="form-control" /></div>
        </div>
    </div>

    <div class="card border rounded-3 p-4 mb-3">
        <h6>Payment Controls and Bank Details</h6>
        <div class="row g-3">
            <div class="col-md-4"><label class="form-label">Payment Order Status</label><select asp-for="PaymentOrderStatus" class="form-select"><option value="">Select status</option><option>Initiated</option><option>Payment Ordered</option><option>Paid</option><option>Cancelled</option></select></div>
            <div class="col-md-4"><label class="form-label">Clearance Date</label><input asp-for="ClearanceDate" type="date" class="form-control" /></div>
            <div class="col-md-4"><label class="form-label">Is Opening</label><select asp-for="IsOpening" class="form-select"><option value="No">No</option><option value="Yes">Yes</option></select></div>
            <div class="col-md-4"><label class="form-label">Bank</label><input asp-for="Bank" list="bankList" class="form-control" /></div>
            <div class="col-md-4"><label class="form-label">Bank Account No</label><input asp-for="BankAccountNo" class="form-control" /></div>
            <div class="col-md-4"><label class="form-label">Payment Order</label><input asp-for="PaymentOrder" list="paymentOrderList" class="form-control" /></div>
            <div class="col-md-6"><label class="form-label">Auto Repeat</label><input asp-for="AutoRepeat" list="autoRepeatList" class="form-control" /></div>
            <div class="col-md-6"><label class="form-label">Title</label><input asp-for="Title" class="form-control" /></div>
        </div>
    </div>

    <div class="card border rounded-3 p-4 mb-3">
        <h6>Tax Withholding and Advance Settings</h6>
        <div class="row g-3 align-items-end">
            <div class="col-md-4"><div class="form-check"><input asp-for="BookAdvancePaymentsInSeparatePartyAccount" class="form-check-input" /><label asp-for="BookAdvancePaymentsInSeparatePartyAccount" class="form-check-label">Book Advance Payments in Separate Party Account</label></div></div>
            <div class="col-md-4"><div class="form-check"><input asp-for="ReconcileOnAdvancePaymentDate" class="form-check-input" /><label asp-for="ReconcileOnAdvancePaymentDate" class="form-check-label">Reconcile on Advance Payment Date</label></div></div>
            <div class="col-md-4"><div class="form-check"><input asp-for="ApplyTaxWithholdingAmount" class="form-check-input" /><label asp-for="ApplyTaxWithholdingAmount" class="form-check-label">Apply Tax Withholding Amount</label></div></div>
            <div class="col-md-6"><label class="form-label">Tax Withholding Category</label><input asp-for="TaxWithholdingCategory" list="taxWithholdingCategoryList" class="form-control" /></div>
            <div class="col-md-6"><label class="form-label">Amended From</label><input asp-for="AmendedFrom" class="form-control" readonly /></div>
        </div>
    </div>
</form>


@section Scripts
{
    <script>

        let taxIndex = 0;


        const paymentType =
            document.getElementById("PaymentType");

        const company =
            document.getElementById("Company");

        const partyType =
            document.getElementById("PartyType");

        const party =
            document.getElementById("Party");

        const paidFrom =
            document.getElementById("PaidFrom");

        const paidTo =
            document.getElementById("PaidTo");

        const modeOfPayment =
            document.getElementById("ModeOfPayment");


        // ============================================================
        // ERP DEPENDENCY ENGINE
        // ============================================================

               function refreshVisibility()
        {
            const payment = paymentType.value;
            const pt = partyType.value;
            const partyValue = party.value;

            const showPartySection =
                payment === "Receive" ||
                payment === "Pay";

            document.getElementById("partySection").style.display =
                showPartySection ? "" : "none";

            document
                .querySelectorAll(".dependent-party")
                .forEach(function(el)
                {
                    el.style.display =
                        showPartySection && pt
                            ? ""
                            : "none";
                });

            document
                .querySelectorAll(".dependent-party-selected")
                .forEach(function(el)
                {
                    el.style.display =
                        showPartySection && pt && partyValue
                            ? ""
                            : "none";
                });

            document
                .querySelectorAll(".dependent-contact")
                .forEach(function(el)
                {
                    el.style.display =
                        showPartySection &&
                        partyValue &&
                        pt !== "Employee"
                            ? ""
                            : "none";
                });

            const showPaidFrom =
                payment === "Internal Transfer" ||
                payment === "Pay" ||
                !!partyValue;

            const showPaidTo =
                payment === "Internal Transfer" ||
                payment === "Receive" ||
                !!partyValue;

            document.getElementById("PaidFromContainer").style.display =
                showPaidFrom ? "" : "none";

            document.getElementById("PaidToContainer").style.display =
                showPaidTo ? "" : "none";

            document.getElementById("PaidFromCurrencyContainer").style.display =
                showPaidFrom && !!paidFrom.value ? "" : "none";

            document.getElementById("PaidFromBalanceContainer").style.display =
                showPaidFrom && !!paidFrom.value ? "" : "none";

            document.getElementById("PaidToCurrencyContainer").style.display =
                showPaidTo && !!paidTo.value ? "" : "none";

            const paidToBalanceContainer =
                document.getElementById("PaidToBalanceContainer");

            if (paidToBalanceContainer)
            {
                paidToBalanceContainer.style.display =
                    showPaidTo && !!paidTo.value ? "" : "none";
            }

            document.getElementById("PartyBalanceContainer").style.display =
                partyValue ? "" : "none";

            document.getElementById("amountSection").style.display =
                paidFrom.value && paidTo.value ? "" : "none";

            document.getElementById("referenceSection").style.display =
                paidFrom.value && paidTo.value ? "" : "none";

            const customer = pt === "Customer";
            const supplier = pt === "Supplier";

            document.getElementById("taxSection").style.display =
                customer || supplier ? "" : "none";

            document.getElementById("salesTaxContainer").style.display =
                customer ? "" : "none";

            document.getElementById("purchaseTaxContainer").style.display =
                supplier ? "" : "none";

            document
                .querySelectorAll(".customer-gst")
                .forEach(function(el)
                {
                    el.style.display =
                        customer && partyValue ? "" : "none";
                });
        }        // ============================================================
        // COMPANY → ACCOUNT MASTER
        // ============================================================

        async function loadAccounts()
        {
            const list =
                document.getElementById(
                    "dynamicAccountList"
                );


            list.innerHTML = "";


            if (!company.value)
                return;


            try
            {
                const response =
                    await fetch(
                        "/HR/GetPaymentEntryAccounts?company="
                        + encodeURIComponent(
                            company.value
                        )
                    );


                if (!response.ok) throw new Error("Could not load accounts from ERPNext.");
                const data =
                    await response.json();


                data.forEach(
                    function(item)
                    {
                        const option =
                            document.createElement(
                                "option"
                            );

                        option.value =
                            item.name;

                        list.appendChild(
                            option
                        );
                    }
                );
            }
            catch(error)
            {
                console.error(error);
                alert(error.message || "Could not load accounts from ERPNext.");
            }
        }


        // ============================================================
        // PARTY TYPE → PARTY MASTER
        // ============================================================

        async function loadParties()
        {
            const selectedParty = party.value;
            party.innerHTML = '<option value="">-- Select Party --</option>';

            document.getElementById(
                "PartyName"
            ).value = "";


            if (!partyType.value)
            {
                refreshVisibility();
                return;
            }


            try
            {
                const response =
                    await fetch(
                        "/HR/GetPartiesByDocType?doctype="
                        + encodeURIComponent(
                            partyType.value
                        )
                    );


                if (!response.ok) throw new Error("Could not load parties from ERPNext.");
                const data =
                    await response.json();


                data.forEach(
                    function(item)
                    {
                        const option = document.createElement("option");
                        option.value = item.name;
                        option.textContent = item.title
                            ? item.name + " - " + item.title
                            : item.name;
                        option.dataset.partyType = partyType.value;
                        party.appendChild(option);
                    }
                );

                if (selectedParty && [...party.options].some(option => option.value === selectedParty))
                    party.value = selectedParty;
            }
            catch(error)
            {
                console.error(error);
                alert(error.message || "Could not load parties from ERPNext.");
            }


            refreshVisibility();
        }


        // ============================================================
        // PARTY → PARTY DETAILS + PARTY ACCOUNT
        // ============================================================

             async function loadPartyDetails()
        {
            if (
                !partyType.value ||
                !party.value ||
                !company.value
            )
            {
                refreshVisibility();
                return;
            }

            try
            {
                const postingDate =
                    document.getElementById("PostingDate");

                const url =
                    "/HR/GetPaymentEntryPartyDetails"
                    + "?partyType=" + encodeURIComponent(partyType.value)
                    + "&party=" + encodeURIComponent(party.value)
                    + "&company=" + encodeURIComponent(company.value)
                    + "&paymentType=" + encodeURIComponent(paymentType.value)
                    + "&postingDate=" + encodeURIComponent(postingDate.value || "");

                const response = await fetch(url);
                const data = await response.json();

                if (!data.success)
                {
                    console.error(data.message || "Unable to load party details.");
                    refreshVisibility();
                    return;
                }

                document.getElementById("PartyName").value =
                    data.partyName || "";

                document.getElementById("PartyBalance").value =
                    data.partyBalance || 0;

                document.getElementById("CompanyBankAccount").value =
                    data.companyBankAccount || "";

                document.getElementById("PartyBankAccount").value =
                    data.partyBankAccount || "";

                const contactSelect = document.getElementById("ContactPerson");
                const emailField = document.getElementById("ContactEmail");
                if (data.contactPerson)
                {
                    if (![...contactSelect.options].some(option => option.value === data.contactPerson))
                        contactSelect.add(new Option(data.contactPerson, data.contactPerson));
                    contactSelect.value = data.contactPerson;
                }
                emailField.value = data.contactEmail || "";

                if (data.paidFrom)
                    paidFrom.value = data.paidFrom;

                if (data.paidTo)
                    paidTo.value = data.paidTo;

                if (data.paidFrom) {
                    document.getElementById("PaidFromAccountCurrency").value = data.paidFromAccountCurrency || "";
                    document.getElementById("PaidFromAccountBalance").value = data.paidFromAccountBalance || 0;
                }

                const paidToBalance =
                    document.getElementById("PaidToAccountBalance");

                if (paidToBalance && data.paidTo)
                {
                    document.getElementById("PaidToAccountCurrency").value = data.paidToAccountCurrency || "";
                    paidToBalance.value =
                        data.paidToAccountBalance || 0;
                }

                document.getElementById("SourceExchangeRate").value =
                    data.sourceExchangeRate || 1;

                document.getElementById("TargetExchangeRate").value =
                    data.targetExchangeRate || 1;
            }
            catch(error)
            {
                console.error(error);
            }

            refreshVisibility();
        }

        // ============================================================
        // MODE OF PAYMENT → DEFAULT BANK/CASH ACCOUNT
        // ============================================================

        async function loadModeOfPaymentAccount()
        {
            if (
                !modeOfPayment.value ||
                !company.value
            )
            {
                return;
            }


            try
            {
                const response =
                    await fetch(
                        "/HR/GetPaymentEntryModeOfPaymentDetails"
                        + "?modeOfPayment="
                        + encodeURIComponent(
                            modeOfPayment.value
                        )
                        + "&company="
                        + encodeURIComponent(
                            company.value
                        )
                    );


                const data =
                    await response.json();


                if (!data.defaultAccount)
                    return;


                // Pay:
                // company bank/cash is Paid From

                if (
                    paymentType.value ===
                    "Pay"
                )
                {
                    paidFrom.value =
                        data.defaultAccount;

                    await loadPaidFromDetails();
                }


                // Receive:
                // company bank/cash is Paid To

                else if (
                    paymentType.value ===
                    "Receive"
                )
                {
                    paidTo.value =
                        data.defaultAccount;

                    await loadPaidToDetails();
                }
            }
            catch(error)
            {
                console.error(error);
            }


            refreshVisibility();
        }


        // ============================================================
        // ACCOUNT DETAILS
        // ============================================================

        async function getAccountDetails(
            account)
        {
            if (!account)
                return null;


            try
            {
                const response =
                    await fetch(
                        "/HR/GetPaymentEntryAccountDetails?account="
                        + encodeURIComponent(
                            account
                        ) + "&date=" + encodeURIComponent(document.getElementById("PostingDate").value || "")
                    );


                return await response.json();
            }
            catch(error)
            {
                console.error(error);

                return null;
            }
        }


        async function loadPaidFromDetails()
        {
            const data =
                await getAccountDetails(
                    paidFrom.value
                );


            if (
                data &&
                data.success
            )
            {
                document.getElementById(
                    "PaidFromAccountCurrency"
                ).value =
                    data.currency || "";
                document.getElementById("PaidFromAccountBalance").value = data.balance ?? "";
            }


            refreshVisibility();
        }


        async function loadPaidToDetails()
        {
            const data =
                await getAccountDetails(
                    paidTo.value
                );


            if (
                data &&
                data.success
            )
            {
                document.getElementById(
                    "PaidToAccountCurrency"
                ).value =
                    data.currency || "";
                document.getElementById("PaidToAccountBalance").value = data.balance ?? "";
            }


            refreshVisibility();
        }


        // ============================================================
        // PAYMENT TYPE CHANGE
        // ============================================================

                      async function paymentTypeChanged()
        {
            paidFrom.value = "";
            paidTo.value = "";

            document.getElementById("PaidFromAccountCurrency").value = "";
            document.getElementById("PaidToAccountCurrency").value = "";
            document.getElementById("PaidFromAccountBalance").value = "";

            const paidToBalance =
                document.getElementById("PaidToAccountBalance");

            if (paidToBalance)
                paidToBalance.value = "";

            if (paymentType.value === "Internal Transfer")
            {
                partyType.value = "";
                party.value = "";

                document.getElementById("PartyName").value = "";
                document.getElementById("PartyBalance").value = "";
                document.getElementById("CompanyBankAccount").value = "";
                document.getElementById("PartyBankAccount").value = "";
                document.getElementById("ContactPerson").value = "";
                document.getElementById("ContactEmail").value = "";
            }
            else
            {
                const requiredPartyType = paymentType.value === "Receive" ? "Customer" : "Supplier";
                partyType.value = requiredPartyType;
                await loadParties();
            }

            await loadModeOfPaymentAccount();

            if (
                paymentType.value !== "Internal Transfer" &&
                partyType.value &&
                party.value
            )
            {
                await loadPartyDetails();
            }

            refreshVisibility();
        }

        // ============================================================
        // TAX TABLE
        // ============================================================

        function addTaxRow()
        {
            const noData =
                document.getElementById(
                    "noTaxRow"
                );


            if (noData)
                noData.remove();


            const body =
                document.getElementById(
                    "taxBody"
                );


            const index =
                taxIndex++;


            const row =
                document.createElement(
                    "tr"
                );


            row.innerHTML = `

                <td class="tax-number">
                    ${index + 1}
                </td>

                <td>
                    <select name="Taxes[${index}].Type"
                            class="form-select form-select-sm">

                        <option value="Actual">
                            Actual
                        </option>

                        <option value="On Paid Amount">
                            On Paid Amount
                        </option>

                        <option value="On Previous Row Amount">
                            On Previous Row Amount
                        </option>

                        <option value="On Previous Row Total">
                            On Previous Row Total
                        </option>

                    </select>
                    <input name="Taxes[${index}].AddDeductTax" type="hidden" value="Add" />
                    <input name="Taxes[${index}].RowId" type="hidden" />
                    <input name="Taxes[${index}].IncludedInPaidAmount" type="hidden" value="false" />
                </td>

                <td>
                    <input name="Taxes[${index}].AccountHead"
                           list="dynamicAccountList"
                           class="form-control form-control-sm" />
                </td>

                <td>
                    <input name="Taxes[${index}].TaxRate"
                           type="number"
                           step="0.01"
                           class="form-control form-control-sm" />
                </td>

                <td>
                    <input name="Taxes[${index}].Amount"
                           type="number"
                           step="0.01"
                           class="form-control form-control-sm" />
                </td>

                <td>
                    <input name="Taxes[${index}].Total"
                           type="number"
                           step="0.01"
                           class="form-control form-control-sm"
                           readonly />
                </td>

                <td>
                    <button type="button"
                            class="btn btn-outline-danger btn-sm remove-tax">

                        ×

                    </button>
                </td>
            `;


            body.appendChild(row);

            reindexTaxRows();
            updateReferenceAmounts();
        }

        async function loadPaymentContacts() {
            // Contact and email are returned by ERPNext's party-details API.
            // Do not call contact_query: it is unavailable on this ERPNext site.
            return;
        }

        async function loadPaymentGstDetails() {
            const fields = ["CompanyAddress", "CompanyGstin", "CustomerAddress", "BillingAddressGstin", "PlaceOfSupply", "GstCategory"];
            fields.forEach(id => document.getElementById(id).value = "");
            if (!company.value) return;
            const requestCompany = company.value, requestParty = party.value, requestType = partyType.value;
            try {
                const params = new URLSearchParams({ company: requestCompany, partyType: requestType, party: requestParty });
                const result = await (await fetch("/HR/PaymentEntryGstDetails?" + params)).json();
                if (requestCompany !== company.value || requestParty !== party.value || requestType !== partyType.value) return;
                if (!result.success) throw new Error(result.message || "GST details could not be loaded.");
                document.getElementById("CompanyAddress").value = result.companyAddress || "";
                document.getElementById("CompanyGstin").value = result.companyGstin || "";
                document.getElementById("CustomerAddress").value = result.customerAddress || "";
                document.getElementById("BillingAddressGstin").value = result.customerGstin || "";
                document.getElementById("PlaceOfSupply").value = result.placeOfSupply || "";
                document.getElementById("GstCategory").value = result.gstCategory || "";
            } catch (error) { alert(error.message); }
        }
        party.addEventListener("change", loadPaymentGstDetails);
        company.addEventListener("change", loadPaymentGstDetails);

        const referencesBody = document.getElementById("paymentReferencesBody");
        const deductionsBody = document.getElementById("paymentDeductionsBody");
        const number = element => Number(element?.value) || 0;
        function updateReferenceAmounts() {
            let allocated = 0;
            referencesBody.querySelectorAll("tr").forEach((row, index) => {
                row.querySelectorAll("input").forEach(input => input.name = input.name.replace(/References\[\d+\]/, "References[" + index + "]"));
                allocated += number(row.querySelector(".reference-allocated"));
            });
            allocated = Math.abs(allocated);
            let deductions = 0;
            deductionsBody.querySelectorAll("tr").forEach((row, index) => {
                row.querySelectorAll("input").forEach(input => input.name = input.name.replace(/Deductions\[\d+\]/, "Deductions[" + index + "]"));
                deductions += number(row.querySelector(".deduction-amount"));
            });
            const source = number(document.getElementById("SourceExchangeRate")) || 1;
            const target = number(document.getElementById("TargetExchangeRate")) || 1;
            const basePaid = number(document.getElementById("PaidAmount")) * source;
            const baseReceived = number(document.getElementById("ReceivedAmount")) * target;
            const taxRows = [...document.querySelectorAll("#taxBody tr:not(#noTaxRow)")];
            let fractions = [], cumulative = [], includedFraction = 0, invalid = false;
            taxRows.forEach((row, index) => {
                const type = row.querySelector('[name$=".Type"]').value;
                const rate = number(row.querySelector('[name$=".TaxRate"]')) / 100;
                const sign = row.querySelector('[name$=".AddDeductTax"]').value === "Deduct" ? -1 : 1;
                const included = row.querySelector('[name$=".IncludedInPaidAmount"]').checked;
                const ref = number(row.querySelector('[name$=".RowId"]')) || index;
                if ((type === "On Previous Row Amount" || type === "On Previous Row Total") && (ref < 1 || ref > index)) invalid = true;
                let fraction = 0;
                if (included && type === "Actual") invalid = true;
                if (included && type === "On Paid Amount") fraction = rate;
                if (included && type === "On Previous Row Amount") fraction = rate * (fractions[ref - 1] || 0);
                if (included && type === "On Previous Row Total") fraction = rate * (cumulative[ref - 1] || 0);
                fraction *= sign; fractions.push(fraction); cumulative.push((cumulative[index - 1] ?? 1) + fraction); includedFraction += fraction;
            });
            let net = basePaid / (1 + includedFraction), running = net, baseTax = 0, includedTax = 0, taxes = [];
            taxRows.forEach((row, index) => {
                const type = row.querySelector('[name$=".Type"]').value;
                const rate = number(row.querySelector('[name$=".TaxRate"]')) / 100;
                const sign = row.querySelector('[name$=".AddDeductTax"]').value === "Deduct" ? -1 : 1;
                const included = row.querySelector('[name$=".IncludedInPaidAmount"]').checked;
                const ref = number(row.querySelector('[name$=".RowId"]')) || index;
                const amountInput = row.querySelector('[name$=".Amount"]');
                let amount = type === "Actual" ? number(amountInput) : type === "On Paid Amount" ? net * rate : type === "On Previous Row Amount" ? (taxes[ref - 1]?.amount || 0) * rate : (taxes[ref - 1]?.total || 0) * rate;
                amount = Math.round((amount + Number.EPSILON) * 100) / 100;
                if (type !== "Actual") amountInput.value = amount.toFixed(2);
                running += sign * amount; baseTax += sign * amount; if (included) includedTax += sign * amount;
                row.querySelector('[name$=".Total"]').value = invalid ? "" : running.toFixed(2);
                taxes.push({ amount, total: running });
            });
            const rate = paymentType.value === "Pay" ? target : source;
            const baseAllocated = allocated * rate;
            let unallocated = 0;
            if (party.value && paymentType.value === "Receive" && baseAllocated < basePaid + deductions) unallocated = (basePaid + deductions - baseAllocated - includedTax) / source;
            if (party.value && paymentType.value === "Pay" && baseAllocated < baseReceived - deductions) unallocated = (baseReceived - deductions - baseAllocated - includedTax) / target;
            const baseParty = baseAllocated + unallocated * rate;
            let difference = paymentType.value === "Receive" ? baseParty - baseReceived : paymentType.value === "Pay" ? basePaid - baseParty : basePaid - baseReceived;
            difference += baseTax - deductions;
            document.getElementById("TotalAllocatedAmount").value = allocated.toFixed(2);
            document.getElementById("UnallocatedAmount").value = invalid ? "" : unallocated.toFixed(2);
            document.getElementById("DifferenceAmount").value = invalid ? "" : difference.toFixed(2);
            document.getElementById("TotalTaxesAndCharges").value = invalid ? "" : (baseTax / rate).toFixed(2);
        }
        function addPaymentReference(data = {}) {
            const row = document.createElement("tr");
            row.innerHTML = '<td><input class="form-control" name="References[0].ReferenceDoctype" required></td><td><input class="form-control" name="References[0].ReferenceName" required><input type="hidden" name="References[0].PaymentTerm"><input type="hidden" name="References[0].DueDate"><input type="hidden" name="References[0].ExchangeRate"></td><td><input class="form-control" name="References[0].GrandTotal" readonly></td><td><input class="form-control" name="References[0].OutstandingAmount" readonly></td><td><input class="form-control reference-allocated" name="References[0].AllocatedAmount" type="number" step="0.01"></td><td><button type="button" class="btn btn-outline-danger remove-reference" aria-label="Remove reference">&times;</button></td>';
            const set = (field, value) => row.querySelector('[name$=".' + field + '"]').value = value ?? "";
            set("ReferenceDoctype", data.voucher_type); set("ReferenceName", data.voucher_no); set("GrandTotal", data.invoice_amount); set("OutstandingAmount", data.outstanding_amount); set("AllocatedAmount", data.allocated_amount ?? 0); set("PaymentTerm", data.payment_term); set("DueDate", data.due_date); set("ExchangeRate", data.exchange_rate);
            referencesBody.appendChild(row); updateReferenceAmounts();
        }
        document.getElementById("addPaymentReference").addEventListener("click", () => addPaymentReference());
        async function fetchOutstanding(kind) {
            const params = new URLSearchParams({ company: company.value, partyType: partyType.value, party: party.value, paymentType: paymentType.value, partyAccount: paymentType.value === "Receive" ? paidFrom.value : paidTo.value, postingDate: document.getElementById("PostingDate").value, costCenter: document.getElementById("CostCenter").value, kind });
            try {
                const data = await (await fetch("/HR/PaymentEntryOutstanding?" + params)).json();
                if (!data.success) throw new Error(data.message || "Unable to load outstanding documents.");
                const existing = new Set([...referencesBody.querySelectorAll("tr")].map(row => [row.querySelector('[name$=".ReferenceDoctype"]').value, row.querySelector('[name$=".ReferenceName"]').value, row.querySelector('[name$=".PaymentTerm"]').value].join("|")));
                data.documents.forEach(doc => { const key = [doc.voucher_type, doc.voucher_no, doc.payment_term || ""].join("|"); if (!existing.has(key)) { addPaymentReference(doc); existing.add(key); } });
                if (!data.documents.length) alert("No outstanding " + kind + " found for these criteria.");
            } catch (error) { alert(error.message); }
        }
        document.getElementById("getOutstandingInvoices").addEventListener("click", () => fetchOutstanding("invoices"));
        document.getElementById("getOutstandingOrders").addEventListener("click", () => fetchOutstanding("orders"));
        document.getElementById("addPaymentDeduction").addEventListener("click", () => {
            const row = document.createElement("tr");
            row.innerHTML = '<td><input class="form-control" list="dynamicAccountList" name="Deductions[0].Account" required></td><td><input class="form-control" list="costCenterList" name="Deductions[0].CostCenter" required></td><td><input class="form-control deduction-amount" name="Deductions[0].Amount" type="number" step="0.01"></td><td><button type="button" class="btn btn-outline-danger remove-deduction" aria-label="Remove deduction">&times;</button></td>';
            deductionsBody.appendChild(row); updateReferenceAmounts();
        });
        deductionsBody.addEventListener("input", updateReferenceAmounts);
        deductionsBody.addEventListener("click", event => { if (event.target.classList.contains("remove-deduction")) { event.target.closest("tr").remove(); updateReferenceAmounts(); } });
        document.getElementById("taxBody").addEventListener("input", updateReferenceAmounts);
        document.getElementById("taxBody").addEventListener("change", updateReferenceAmounts);
        document.getElementById("SourceExchangeRate").addEventListener("input", updateReferenceAmounts);
        document.getElementById("TargetExchangeRate").addEventListener("input", updateReferenceAmounts);
        referencesBody.addEventListener("input", updateReferenceAmounts);
        referencesBody.addEventListener("click", event => { if (event.target.classList.contains("remove-reference")) { event.target.closest("tr").remove(); updateReferenceAmounts(); } });
        document.getElementById("PaidAmount").addEventListener("input", updateReferenceAmounts);
        document.getElementById("PaidAmount").addEventListener("change", function () {
            const fromCurrency = document.getElementById("PaidFromAccountCurrency").value;
            const toCurrency = document.getElementById("PaidToAccountCurrency").value;
            if (fromCurrency && fromCurrency === toCurrency) document.getElementById("ReceivedAmount").value = this.value;
            updateReferenceAmounts();
        });
        document.getElementById("ReceivedAmount").addEventListener("input", updateReferenceAmounts);
        paymentType.addEventListener("change", updateReferenceAmounts);


        function reindexTaxRows()
        {
            const rows =
                document.querySelectorAll(
                    "#taxBody tr:not(#noTaxRow)"
                );


            rows.forEach(
                function(row, index)
                {
                    row.querySelector(
                        ".tax-number"
                    ).textContent =
                        index + 1;


                    const controls =
                        row.querySelectorAll(
                            "select, input"
                        );


                    controls.forEach(
                        function(control)
                        {
                            if (!control.name)
                                return;


                            control.name =
                                control.name.replace(
                                    /Taxes\[\d+\]/,
                                    "Taxes[" +
                                    index +
                                    "]"
                                );
                        }
                    );
                }
            );


            taxIndex =
                rows.length;
        }


        // ============================================================
        // EVENTS
        // ============================================================

        paymentType.addEventListener(
            "change",
            paymentTypeChanged
        );


        company.addEventListener(
            "change",
            async function()
            {
                paidFrom.value = "";
                paidTo.value = "";

                await loadAccounts();

                await loadModeOfPaymentAccount();

                refreshVisibility();
            }
        );


        partyType.addEventListener(
            "change",
            loadParties
        );


        party.addEventListener(
            "change",
            async function()
            {
                const selected = party.options[party.selectedIndex];
                if (selected?.dataset.partyType)
                    partyType.value = selected.dataset.partyType;

                await loadPartyDetails();
                await loadPaymentContacts();
                await loadPaymentGstDetails();
            }
        );


        party.addEventListener(
            "blur",
            loadPartyDetails
        );


        modeOfPayment.addEventListener(
            "change",
            loadModeOfPaymentAccount
        );


        paidFrom.addEventListener(
            "change",
            loadPaidFromDetails
        );


        paidTo.addEventListener(
            "change",
            loadPaidToDetails
        );


        document.getElementById(
            "AddTaxButton"
        ).addEventListener(
            "click",
            addTaxRow
        );


        document.addEventListener(
            "click",
            function(event)
            {
                if (
                    event.target.classList.contains(
                        "remove-tax"
                    )
                )
                {
                    event.target
                        .closest("tr")
                        .remove();


                    reindexTaxRows();
                    updateReferenceAmounts();
                }
            }
        );


        // ============================================================
        // INITIAL PAGE
        // ============================================================

        document.addEventListener(
            "DOMContentLoaded",
            async function()
            {
                await loadAccounts();
                await paymentTypeChanged();
                const savedReferences = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.References ?? new List<Erp_Aits.Models.PaymentEntryReference>()));
                savedReferences.forEach(r => addPaymentReference({ voucher_type: r.ReferenceDoctype, voucher_no: r.ReferenceName, invoice_amount: r.GrandTotal, outstanding_amount: r.OutstandingAmount, allocated_amount: r.AllocatedAmount, payment_term: r.PaymentTerm, due_date: r.DueDate ? r.DueDate.substring(0, 10) : "", exchange_rate: r.ExchangeRate }));
                const savedTaxes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Taxes ?? new List<Erp_Aits.Models.PaymentEntryTax>()));
                savedTaxes.forEach(t => {
                    addTaxRow(); const row = document.querySelector("#taxBody tr:last-child");
                    const set = (name, value) => { const el = row.querySelector('[name$=".' + name + '"]'); if (el.type === "checkbox") el.checked = !!value; else el.value = value ?? ""; };
                    set("Type", t.Type); set("AccountHead", t.AccountHead); set("TaxRate", t.TaxRate); set("Amount", t.Amount); set("AddDeductTax", t.AddDeductTax || "Add"); set("RowId", t.RowId); set("IncludedInPaidAmount", t.IncludedInPaidAmount);
                });
                const savedDeductions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Deductions ?? new List<Erp_Aits.Models.PaymentEntryDeduction>()));
                savedDeductions.forEach(d => {
                    document.getElementById("addPaymentDeduction").click(); const row = deductionsBody.lastElementChild;
                    row.querySelector('[name$=".Account"]').value = d.Account || ""; row.querySelector('[name$=".CostCenter"]').value = d.CostCenter || ""; row.querySelector('[name$=".Amount"]').value = d.Amount;
                });
                if (!document.getElementById("CompanyAddress").value && !document.getElementById("CustomerAddress").value) await loadPaymentGstDetails();
                updateReferenceAmounts();

                refreshVisibility();
            }
        );

        function syncComputedAmounts() {
            const read = id => Number(document.getElementById(id)?.value || 0);
            const set = (id, value) => { const field = document.getElementById(id); if (field) field.value = Number.isFinite(value) ? value.toFixed(2) : "0.00"; };
            const paid = read("PaidAmount");
            const received = read("ReceivedAmount");
            const sourceRate = read("SourceExchangeRate") || 1;
            const targetRate = read("TargetExchangeRate") || 1;
            set("PaidAmountAfterTax", paid);
            set("ReceivedAmountAfterTax", received);
            set("BasePaidAmount", paid * sourceRate);
            set("BaseReceivedAmount", received * targetRate);
            set("BasePaidAmountAfterTax", paid * sourceRate);
            set("BaseReceivedAmountAfterTax", received * targetRate);
        }

        ["PaidAmount", "ReceivedAmount", "SourceExchangeRate", "TargetExchangeRate"].forEach(id =>
            document.getElementById(id)?.addEventListener("input", syncComputedAmounts));
        document.addEventListener("DOMContentLoaded", syncComputedAmounts);

    </script>
}
