        async function getAccountDetails(
            account)
        {
            if (!account)
                return null;


            try
            {
                const response =
                    await fetch(
                        "/HR/GetPaymentEntryAccountDetails?account="
                        + encodeURIComponent(
                            account
                        ) + "&date=" + encodeURIComponent(document.getElementById("PostingDate").value || "")
                    );


                return await response.json();
            }
            catch(error)
            {
                console.error(error);

                return null;
            }
        }


