        // ============================================================

                      async function paymentTypeChanged()
        {
            paidFrom.value = "";
            paidTo.value = "";

            document.getElementById("PaidFromAccountCurrency").value = "";
            document.getElementById("PaidToAccountCurrency").value = "";
            document.getElementById("PaidFromAccountBalance").value = "";

            const paidToBalance =
                document.getElementById("PaidToAccountBalance");

            if (paidToBalance)
                paidToBalance.value = "";

            if (paymentType.value === "Internal Transfer")
            {
                partyType.value = "";
                party.value = "";

                document.getElementById("PartyName").value = "";
                document.getElementById("PartyBalance").value = "";
                document.getElementById("CompanyBankAccount").value = "";
                document.getElementById("PartyBankAccount").value = "";
                document.getElementById("ContactPerson").value = "";
                document.getElementById("ContactEmail").value = "";
            }

            await loadModeOfPaymentAccount();

            if (
                paymentType.value !== "Internal Transfer" &&
                partyType.value &&
                party.value
            )
            {
                await loadPartyDetails();
            }

            refreshVisibility();
        }

