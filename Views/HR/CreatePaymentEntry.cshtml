        async function loadParties()
        {
            const list =
                document.getElementById(
                    "dynamicPartyList"
                );


            list.innerHTML = "";

            party.value = "";

            document.getElementById(
                "PartyName"
            ).value = "";


            if (!partyType.value)
            {
                refreshVisibility();
                return;
            }


            try
            {
                const response =
                    await fetch(
                        "/HR/GetPartiesByDocType?doctype="
                        + encodeURIComponent(
