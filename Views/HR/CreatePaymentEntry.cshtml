        async function loadPaymentContacts() {
            const list = document.getElementById("ContactPerson");
            list.replaceChildren(new Option("Select contact", ""));
            document.getElementById("ContactPerson").value = "";
            document.getElementById("ContactEmail").value = "";
            if (!party.value || !partyType.value) return;
            try {
                const selectedParty = party.value, selectedType = partyType.value;
                const url = "/HR/PaymentEntryContacts?partyType=" + encodeURIComponent(selectedType) + "&party=" + encodeURIComponent(selectedParty);
                const data = await (await fetch(url)).json();
                if (party.value !== selectedParty || partyType.value !== selectedType) return;
                if (!data.success) throw new Error(data.message || "Contacts could not be loaded.");
                data.contacts.forEach(name => list.add(new Option(name, name)));
                if (!data.contacts.length) list.options[0].text = "No linked contacts";
            } catch (error) { alert(error.message); }
        }
        document.getElementById("ContactPerson").addEventListener("change", async function () {
            const email = document.getElementById("ContactEmail");
            email.value = "";
            if (!this.value) return;
            try {
                const data = await (await fetch("/HR/PaymentEntryContacts?contact=" + encodeURIComponent(this.value))).json();
                if (!data.success) throw new Error(data.message || "Contact email could not be loaded.");
                email.value = data.email || "";
            } catch (error) { alert(error.message); }
        });
