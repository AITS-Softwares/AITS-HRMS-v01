@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model Erp_Aits.Models.PaymentEntry

@{
    ViewBag.Title = "New Payment Entry";
}


@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3">
        <strong>ERPNext Validation:</strong>
        @TempData["ErpNextError"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

@if (ViewBag.PaymentEntryMasterError != null)
{
    <div class="alert alert-warning">@ViewBag.PaymentEntryMasterError</div>
}


<!-- ============================================================= -->
<!-- MASTER DATALISTS -->
<!-- ============================================================= -->

<datalist id="modeOfPaymentList">
    @if (ViewBag.ModesOfPayment != null)
    {
        foreach (var item in ViewBag.ModesOfPayment)
        {
            <option value="@item.name"></option>
        }
    }
</datalist>


<datalist id="dynamicPartyList"></datalist>
<datalist id="paymentContactList"></datalist>
<datalist id="paymentLetterHeads">@foreach (var item in ViewBag.LetterHeads ?? new object[0]) { <option value="@item.name"></option> }</datalist>
<datalist id="paymentPrintHeadings">@foreach (var item in ViewBag.PrintHeadings ?? new object[0]) { <option value="@item.name"></option> }</datalist>

<datalist id="dynamicAccountList"></datalist>


<datalist id="bankAccountList">
    @if (ViewBag.BankAccounts != null)
    {
        foreach (var item in ViewBag.BankAccounts)
        {
            <option value="@item.name"></option>
        }
    }
</datalist>


<datalist id="projectList">
    @if (ViewBag.Projects != null)
    {
        foreach (var item in ViewBag.Projects)
        {
            <option value="@item.name"></option>
        }
    }
</datalist>


<datalist id="costCenterList">
    @if (ViewBag.CostCenters != null)
    {
        foreach (var item in ViewBag.CostCenters)
        {
            <option value="@item.name"></option>
        }
    }
</datalist>


<datalist id="salesTaxTemplateList">
    @if (ViewBag.SalesTaxTemplates != null)
    {
        foreach (var item in ViewBag.SalesTaxTemplates)
        {
            <option value="@item.name"></option>
        }
    }
</datalist>


<datalist id="purchaseTaxTemplateList">
    @if (ViewBag.PurchaseTaxTemplates != null)
    {
        foreach (var item in ViewBag.PurchaseTaxTemplates)
        {
            <option value="@item.name"></option>
        }
    }
</datalist>


<form asp-controller="HR"
      asp-action="CreatePaymentEntry"
      method="post"
      id="paymentEntryForm">


    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h4 class="mb-0 d-inline">
                New Payment Entry
            </h4>

            <span class="badge bg-warning-subtle text-warning ms-2">
                Not Saved
            </span>
        </div>


        <button type="submit"
                class="btn btn-dark btn-sm px-4">

            Save

        </button>

    </div>


    <!-- ========================================================= -->
    <!-- TYPE OF PAYMENT -->
    <!-- ========================================================= -->

    <div class="card border rounded-3 p-4 mb-3">

        <h6 class="mb-3">
            Type of Payment
        </h6>


        <div class="row g-3">

            <!-- SERIES -->
            <div class="col-md-6">

                <label class="form-label">
                    Series
                    <span class="text-danger">*</span>
                </label>

                <select asp-for="Series"
                        class="form-select"
                        required>

                    <option value="">Select series</option>

                    @if (ViewBag.NamingSeries != null)
                    {
                        foreach (var series in ViewBag.NamingSeries)
                        {
                            <option value="@series">
                                @series
                            </option>
                        }
                    }

                </select>

            </div>


            <!-- POSTING DATE -->
            <div class="col-md-6">

                <label class="form-label">
                    Posting Date
                    <span class="text-danger">*</span>
                </label>

                <input asp-for="PostingDate"
                       type="date"
                       class="form-control"
                       required />

            </div>


            <!-- PAYMENT TYPE -->
            <div class="col-md-6">

                <label class="form-label">
                    Payment Type
                    <span class="text-danger">*</span>
                </label>

                <select asp-for="PaymentType"
                        id="PaymentType"
                        class="form-select"
                        required>

                    <option value="Receive">
                        Receive
                    </option>

                    <option value="Pay">
                        Pay
                    </option>

                    <option value="Internal Transfer">
                        Internal Transfer
                    </option>

                </select>

            </div>


            <!-- COMPANY -->
            <div class="col-md-6">

                <label class="form-label">
                    Company
                    <span class="text-danger">*</span>
                </label>

                <select asp-for="Company"
                        id="Company"
                        class="form-select"
                        required>

                    <option value="">
                        -- Select Company --
                    </option>

                    @if (ViewBag.Companies != null)
                    {
                        foreach (var company in ViewBag.Companies)
                        {
                            <option value="@company.name">
                                @company.name
                            </option>
                        }
                    }

                </select>

            </div>


            <!-- MODE OF PAYMENT -->
            <div class="col-md-6">

                <label class="form-label">
                    Mode of Payment
                </label>

                <input asp-for="ModeOfPayment"
                       id="ModeOfPayment"
                       list="modeOfPaymentList"
                       class="form-control"
                       placeholder="Select Mode of Payment..." />

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- PAYMENT FROM / TO -->
    <!-- Hidden completely for Internal Transfer -->
    <!-- ========================================================= -->

    <div class="card border rounded-3 p-4 mb-3"
         id="partySection">

        <h6 class="mb-3">
            Payment From / To
        </h6>


        <div class="row g-3">

            <!-- PARTY TYPE - always shown for Receive / Pay -->
            <div class="col-md-6">

                <label class="form-label">
                    Party Type
                </label>

                <select asp-for="PartyType"
                        id="PartyType"
                        class="form-select">

                    <option value="">
                        -- Select Party Type --
                    </option>

                    <option value="Customer">
                        Customer
                    </option>

                    <option value="Supplier">
                        Supplier
                    </option>

                    <option value="Employee">
                        Employee
                    </option>

                    <option value="Shareholder">
                        Shareholder
                    </option>

                </select>

            </div>


            <!-- PARTY: ERP reveals after Party Type -->
            <div class="col-md-6 dependent-party"
                 style="display:none;">

                <label class="form-label">
                    Party
                    <span class="text-danger">*</span>
                </label>

                <input asp-for="Party"
                       id="Party"
                       list="dynamicPartyList"
                       class="form-control"
                       placeholder="Select Party..." />

            </div>


            <!-- PARTY NAME -->
            <div class="col-md-6 dependent-party"
                 style="display:none;">

                <label class="form-label">
                    Party Name
                </label>

                <input asp-for="PartyName"
                       id="PartyName"
                       class="form-control bg-light"
                       readonly />

            </div>


            <!-- COMPANY BANK ACCOUNT -->
            <div class="col-md-6 dependent-party"
                 style="display:none;">

                <label class="form-label">
                    Company Bank Account
                </label>

                <input asp-for="CompanyBankAccount"
                       id="CompanyBankAccount"
                       list="bankAccountList"
                       class="form-control" />

            </div>


            <!-- PARTY BANK ACCOUNT -->
            <div class="col-md-6 dependent-party-selected"
                 style="display:none;">

                <label class="form-label">
                    Party Bank Account
                </label>

                <input asp-for="PartyBankAccount"
                       id="PartyBankAccount"
                       list="bankAccountList"
                       class="form-control" />

            </div>


            <!-- CONTACT -->
            <div class="col-md-6 dependent-contact"
                 style="display:none;">

                <label class="form-label">
                    Contact
                </label>

                <select asp-for="ContactPerson" id="ContactPerson" class="form-select">
                    <option value="">Select contact</option>
                </select>

            </div>


            <!-- CONTACT EMAIL -->
            <div class="col-md-6 dependent-contact"
                 style="display:none;">

                <label class="form-label">
                    Email
                </label>

                <input asp-for="ContactEmail"
                       id="ContactEmail"
                       class="form-control bg-light"
                       readonly />

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- ACCOUNTS -->
    <!-- ========================================================= -->

    <div class="card border rounded-3 p-4 mb-3">

        <h6 class="mb-3">
            Accounts
        </h6>


        <div class="row g-3">

            <!-- PARTY BALANCE -->
            <div class="col-md-6"
                 id="PartyBalanceContainer"
                 style="display:none;">

                <label class="form-label">
                    Party Balance
                </label>

                <input asp-for="PartyBalance"
                       id="PartyBalance"
                       class="form-control bg-light"
                       readonly />

            </div>


            <!-- PAID FROM -->
            <div class="col-md-6"
                 id="PaidFromContainer"
                 style="display:none;">

                <label class="form-label">
                    Account Paid From
                    <span class="text-danger">*</span>
                </label>

                <input asp-for="PaidFrom"
                       id="PaidFrom"
                       list="dynamicAccountList"
                       class="form-control" />

            </div>


            <!-- PAID FROM CURRENCY -->
            <div class="col-md-6"
                 id="PaidFromCurrencyContainer"
                 style="display:none;">

                <label class="form-label">
                    Account Currency (From)
                </label>

                <input asp-for="PaidFromAccountCurrency"
                       id="PaidFromAccountCurrency"
                       class="form-control bg-light"
                       readonly />

            </div>


            <!-- PAID FROM BALANCE -->
            <div class="col-md-6"
                 id="PaidFromBalanceContainer"
                 style="display:none;">

                <label class="form-label">
                    Account Balance (From)
                </label>

                <input asp-for="PaidFromAccountBalance"
                       id="PaidFromAccountBalance"
                       class="form-control bg-light"
                       readonly />

            </div>


            <!-- PAID TO -->
            <div class="col-md-6"
                 id="PaidToContainer"
                 style="display:none;">

                <label class="form-label">
                    Account Paid To
                    <span class="text-danger">*</span>
                </label>

                <input asp-for="PaidTo"
                       id="PaidTo"
                       list="dynamicAccountList"
                       class="form-control" />

            </div>


            <!-- PAID TO CURRENCY -->
            <div class="col-md-6"
                 id="PaidToCurrencyContainer"
                 style="display:none;">

                <label class="form-label">
                    Account Currency (To)
                </label>

                <input asp-for="PaidToAccountCurrency"
                       id="PaidToAccountCurrency"
                       class="form-control bg-light"
                       readonly />

            </div>


            <!-- PAID TO BALANCE -->
            <div class="col-md-6"
                 id="PaidToBalanceContainer"
                 style="display:none;">

                <label class="form-label">
                    Account Balance (To)
                </label>

                <input asp-for="PaidToAccountBalance"
                       id="PaidToAccountBalance"
                       class="form-control bg-light"
                       readonly />

            </div>


        </div>

    </div>


    <!-- ========================================================= -->
    <!-- AMOUNT -->
    <!-- ERP shows after BOTH accounts exist -->
    <!-- ========================================================= -->

    <div class="card border rounded-3 p-4 mb-3"
         id="amountSection"
         style="display:none;">

        <h6 class="mb-3">
            Amount
        </h6>


        <div class="row g-3">

            <div class="col-md-6">

                <label class="form-label">
                    Paid Amount
                    <span class="text-danger">*</span>
                </label>

                <input asp-for="PaidAmount"
                       id="PaidAmount"
                       type="number"
                       step="0.01"
                       class="form-control" />

            </div>


            <div class="col-md-6">

                <label class="form-label">
                    Received Amount
                    <span class="text-danger">*</span>
                </label>

                <input asp-for="ReceivedAmount"
                       id="ReceivedAmount"
                       type="number"
                       step="0.01"
                       class="form-control" />

            </div>


            <div class="col-md-6">

                <label class="form-label">
                    Source Exchange Rate
                </label>

                <input asp-for="SourceExchangeRate"
                       id="SourceExchangeRate"
                       type="number"
                       step="0.000000001"
                       class="form-control" />

            </div>


            <div class="col-md-6">

                <label class="form-label">
                    Target Exchange Rate
                </label>

                <input asp-for="TargetExchangeRate"
                       id="TargetExchangeRate"
                       type="number"
                       step="0.000000001"
                       class="form-control" />

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- TAXES -->
    <!-- Only Customer / Supplier -->
    <!-- ========================================================= -->

    <div class="card border rounded-3 p-4 mb-3" id="paymentReferencesSection">
        <h6>Payment References</h6>
        <div class="d-flex gap-2 mb-2"><button type="button" class="btn btn-outline-secondary btn-sm" id="getOutstandingInvoices">Get Outstanding Invoices</button><button type="button" class="btn btn-outline-secondary btn-sm" id="getOutstandingOrders">Get Outstanding Orders</button></div>
        <div class="table-responsive"><table class="table table-bordered"><thead><tr><th>Type</th><th>Name</th><th>Grand Total</th><th>Outstanding</th><th>Allocated</th><th></th></tr></thead><tbody id="paymentReferencesBody"></tbody></table></div>
        <div><button type="button" class="btn btn-outline-secondary btn-sm" id="addPaymentReference">Add Row</button></div>
        <div class="row g-3 mt-1">
            <div class="col-md-6"><label class="form-label">Total Allocated Amount</label><input asp-for="TotalAllocatedAmount" class="form-control" readonly /></div>
            <div class="col-md-6"><label class="form-label">Unallocated Amount</label><input asp-for="UnallocatedAmount" class="form-control" readonly /></div>
            <div class="col-md-6"><label class="form-label">Difference Amount (Company Currency)</label><input asp-for="DifferenceAmount" class="form-control" readonly /></div>
        </div>
    </div>

    <div class="card border rounded-3 p-4 mb-3"
         id="taxSection"
         style="display:none;">

        <h6 class="mb-3">
            Taxes and Charges
        </h6>


        <!-- CUSTOMER -->
        <div id="salesTaxContainer"
             style="display:none;"
             class="mb-3">

            <label class="form-label">
                Sales Taxes and Charges Template
            </label>

            <input asp-for="SalesTaxesChargesTemplate"
                   list="salesTaxTemplateList"
                   class="form-control" />

        </div>


        <!-- SUPPLIER -->
        <div id="purchaseTaxContainer"
             style="display:none;"
             class="mb-3">

            <label class="form-label">
                Purchase Taxes and Charges Template
            </label>

            <input asp-for="PurchaseTaxesChargesTemplate"
                   list="purchaseTaxTemplateList"
                   class="form-control" />

        </div>


        <div class="d-flex justify-content-between mb-2">

            <label class="form-label mb-0">
                Advance Taxes and Charges
            </label>

            <button type="button"
                    class="btn btn-outline-secondary btn-sm"
                    id="AddTaxButton">

                Add Row

            </button>

        </div>


        <div class="table-responsive">

            <table class="table table-bordered align-middle"
                   id="taxTable">

                <thead>

                    <tr>
                        <th style="width:50px;">
                            No.
                        </th>

                        <th>
                            Type
                        </th>

                        <th>
                            Account Head
                        </th>

                        <th>
                            Tax Rate
                        </th>

                        <th>
                            Amount
                        </th>

                        <th>
                            Total
                        </th>

                        <th style="width:60px;">
                        </th>
                    </tr>

                </thead>


                <tbody id="taxBody">

                    <tr id="noTaxRow">

                        <td colspan="7"
                            class="text-center text-muted">

                            No Data

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

        <div class="row"><div class="col-md-6 ms-auto"><label class="form-label">Total Taxes and Charges</label><input asp-for="TotalTaxesAndCharges" class="form-control" readonly /></div></div>

    </div>


    <!-- ========================================================= -->
    <!-- GST -->
    <!-- ========================================================= -->

    <div class="card border rounded-3 p-4 mb-3"><h6>Deductions or Loss</h6><div class="table-responsive"><table class="table table-bordered"><thead><tr><th>Account</th><th>Cost Center</th><th>Amount</th><th></th></tr></thead><tbody id="paymentDeductionsBody"></tbody></table></div><div><button type="button" class="btn btn-outline-secondary btn-sm" id="addPaymentDeduction">Add Row</button></div></div>
    <div class="card border rounded-3 p-4 mb-3">

        <h6 class="mb-3">
            GST Details
        </h6>


        <div class="row g-3">

            <div class="col-md-6">

                <label class="form-label">
                    Company Address
                </label>

                <input asp-for="CompanyAddress"
                       class="form-control bg-light"
                       readonly />

            </div>


            <div class="col-md-6 customer-gst"
                 style="display:none;">

                <label class="form-label">
                    Customer Address
                </label>

                <input asp-for="CustomerAddress"
                       class="form-control bg-light"
                       readonly />

            </div>


            <div class="col-md-6">

                <label class="form-label">
                    Company GSTIN
                </label>

                <input asp-for="CompanyGstin"
                       class="form-control bg-light"
                       readonly />

            </div>


            <div class="col-md-6 customer-gst"
                 style="display:none;">

                <label class="form-label">
                    Customer GSTIN
                </label>

                <input asp-for="BillingAddressGstin"
                       class="form-control bg-light"
                       readonly />

            </div>


            <div class="col-md-6 customer-gst"
                 style="display:none;">

                <label class="form-label">
                    Place of Supply
                </label>

                <input asp-for="PlaceOfSupply"
                       class="form-control bg-light"
                       readonly />

            </div>


            <div class="col-md-6 customer-gst"
                 style="display:none;">

                <label class="form-label">
                    GST Category
                </label>

                <input asp-for="GstCategory"
                       class="form-control bg-light"
                       readonly />

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- TRANSACTION REFERENCE -->
    <!-- ========================================================= -->

    <div class="card border rounded-3 p-4 mb-3"
         id="referenceSection"
         style="display:none;">

        <h6 class="mb-3">
            Transaction ID
        </h6>


        <div class="row g-3">

            <div class="col-md-6">

                <label class="form-label">
                    Cheque/Reference No
                </label>

                <input asp-for="ReferenceNo"
                       id="ReferenceNo"
                       class="form-control" />

            </div>


            <div class="col-md-6">

                <label class="form-label">
                    Cheque/Reference Date
                </label>

                <input asp-for="ReferenceDate"
                       id="ReferenceDate"
                       type="date"
                       class="form-control" />

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- ACCOUNTING DIMENSIONS -->
    <!-- ========================================================= -->

    <div class="card border rounded-3 p-4">

        <h6 class="mb-3">
            Accounting Dimensions
        </h6>


        <div class="row g-3">

            <div class="col-md-6">

                <label class="form-label">
                    Project
                </label>

                <input asp-for="Project"
                       list="projectList"
                       class="form-control" />

            </div>


            <div class="col-md-6">

                <label class="form-label">
                    Cost Center
                </label>

                <input asp-for="CostCenter"
                       list="costCenterList"
                       class="form-control" />

            </div>

        </div>

    </div>

    <div class="card border rounded-3 p-4 mb-3">
        <h6>More Information</h6>
        <div class="row g-3">
            <div class="col-md-6"><label class="form-label">Status</label><input class="form-control" value="Draft" readonly /></div>
            <div class="col-md-6"><label class="form-label">Letter Head</label><input asp-for="LetterHead" list="paymentLetterHeads" class="form-control" /></div>
            <div class="col-md-6"><label><input asp-for="CustomRemarks" /> Custom Remarks</label><textarea asp-for="Remarks" class="form-control"></textarea></div>
            <div class="col-md-6"><label class="form-label">Print Heading</label><input asp-for="PrintHeading" list="paymentPrintHeadings" class="form-control" /></div>
        </div>
    </div>
</form>


@section Scripts
{
    <script>

        let taxIndex = 0;


        const paymentType =
            document.getElementById("PaymentType");

        const company =
            document.getElementById("Company");

        const partyType =
            document.getElementById("PartyType");

        const party =
            document.getElementById("Party");

        const paidFrom =
            document.getElementById("PaidFrom");

        const paidTo =
            document.getElementById("PaidTo");

        const modeOfPayment =
            document.getElementById("ModeOfPayment");


        // ============================================================
        // ERP DEPENDENCY ENGINE
        // ============================================================

               function refreshVisibility()
        {
            const payment = paymentType.value;
            const pt = partyType.value;
            const partyValue = party.value;

            const showPartySection =
                payment === "Receive" ||
                payment === "Pay";

            document.getElementById("partySection").style.display =
                showPartySection ? "" : "none";

            document
                .querySelectorAll(".dependent-party")
                .forEach(function(el)
                {
                    el.style.display =
                        showPartySection && pt
                            ? ""
                            : "none";
                });

            document
                .querySelectorAll(".dependent-party-selected")
                .forEach(function(el)
                {
                    el.style.display =
                        showPartySection && pt && partyValue
                            ? ""
                            : "none";
                });

            document
                .querySelectorAll(".dependent-contact")
                .forEach(function(el)
                {
                    el.style.display =
                        showPartySection &&
                        partyValue &&
                        pt !== "Employee"
                            ? ""
                            : "none";
                });

            const showPaidFrom =
                payment === "Internal Transfer" ||
                payment === "Pay" ||
                !!partyValue;

            const showPaidTo =
                payment === "Internal Transfer" ||
                payment === "Receive" ||
                !!partyValue;

            document.getElementById("PaidFromContainer").style.display =
                showPaidFrom ? "" : "none";

            document.getElementById("PaidToContainer").style.display =
                showPaidTo ? "" : "none";

            document.getElementById("PaidFromCurrencyContainer").style.display =
                showPaidFrom && !!paidFrom.value ? "" : "none";

            document.getElementById("PaidFromBalanceContainer").style.display =
                showPaidFrom && !!paidFrom.value ? "" : "none";

            document.getElementById("PaidToCurrencyContainer").style.display =
                showPaidTo && !!paidTo.value ? "" : "none";

            const paidToBalanceContainer =
                document.getElementById("PaidToBalanceContainer");

            if (paidToBalanceContainer)
            {
                paidToBalanceContainer.style.display =
                    showPaidTo && !!paidTo.value ? "" : "none";
            }

            document.getElementById("PartyBalanceContainer").style.display =
                partyValue ? "" : "none";

            document.getElementById("amountSection").style.display =
                paidFrom.value && paidTo.value ? "" : "none";

            document.getElementById("referenceSection").style.display =
                paidFrom.value && paidTo.value ? "" : "none";

            const customer = pt === "Customer";
            const supplier = pt === "Supplier";

            document.getElementById("taxSection").style.display =
                customer || supplier ? "" : "none";

            document.getElementById("salesTaxContainer").style.display =
                customer ? "" : "none";

            document.getElementById("purchaseTaxContainer").style.display =
                supplier ? "" : "none";

            document
                .querySelectorAll(".customer-gst")
                .forEach(function(el)
                {
                    el.style.display =
                        customer && partyValue ? "" : "none";
                });
        }        // ============================================================
        // COMPANY → ACCOUNT MASTER
        // ============================================================

        async function loadAccounts()
        {
            const list =
                document.getElementById(
                    "dynamicAccountList"
                );


            list.innerHTML = "";


            if (!company.value)
                return;


            try
            {
                const response =
                    await fetch(
                        "/HR/GetPaymentEntryAccounts?company="
                        + encodeURIComponent(
                            company.value
                        )
                    );


                if (!response.ok) throw new Error("Could not load accounts from ERPNext.");
                const data =
                    await response.json();


                data.forEach(
                    function(item)
                    {
                        const option =
                            document.createElement(
                                "option"
                            );

                        option.value =
                            item.name;

                        list.appendChild(
                            option
                        );
