@{
    ViewBag.Title = "New Salary Component";
    var companies = ViewBag.SalaryComponentCompanies as List<string> ?? new List<string>();
    var accounts = ViewBag.SalaryComponentAccounts as List<string> ?? new List<string>();
}

<style>
    .erp-form-page {
        max-width: 1210px;
        margin: 0 auto;
        padding:26px; background:#eaf0f6; border:1px solid #d4e0eb; border-radius:8px;
    }

    .erp-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
        padding:20px 24px; background:#14253d; border-radius:7px;
    }

    .erp-title {
        font-size: 22px;
        font-weight: 700;
        color:#fff;
    }

    .not-saved {
        color: #d9480f;
        background: #fff1e8;
        border-radius: 999px;
        padding: 3px 9px;
        font-size: 13px;
        margin-left: 8px;
    }

    .save-btn {
        background: #0f766e;
        color: #fff;
        border: 0;
        border-radius: 8px;
        padding: 7px 16px;
        font-weight: 600;
    }

    .erp-card {
        background: #fff;
        border: 1px solid #cbd8e5;
        border-radius: 8px;
        overflow: hidden;
    }

    .tab-row {
        display: flex;
        gap: 28px;
        background:#f4f8fc; border-bottom: 1px solid #dbe3ec;
        padding: 0 20px;
    }

    .tab-btn {
        border: 0;
        background: transparent;
        padding: 13px 0;
        font-size: 14px;
        color: #374151;
        border-bottom: 2px solid transparent;
    }

        .tab-btn.active {
            color: #111827;
            font-weight: 700;
            border-bottom-color: #111827;
        }

    .tab-pane {
        display: none;
        padding: 18px 20px;
    }

        .tab-pane.active {
            display: block;
        }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px 28px;
    }

    .field-label {
        display: block;
        font-size: 14px;
        margin-bottom: 7px;
        color: #374151;
    }

    .required {
        color: #dc2626;
    }

    .erp-input,
    .erp-select,
    .erp-textarea {
        width: 100%;
        border: 1px solid #b8c7d7;
        background: #fbfdff;
        border-radius: 8px;
        padding: 7px 10px;
        font-size: 14px;
    }

    .erp-input,
    .erp-select {
        height: 34px;
    }

    .erp-textarea {
        min-height: 145px;
        resize: vertical;
    }

    .check-list {
        display: flex;
        flex-direction: column;
        gap: 18px;
        padding-top: 6px;
    }

    .check-row {
        display: flex;
        gap: 9px;
        align-items: flex-start;
        font-size: 14px;
    }

    .help-text {
        color: #374151;
        font-size: 14px;
        line-height: 1.6;
        margin-top: -12px;
        margin-left: 25px;
    }

    .section-title {
        font-size: 18px;
        font-weight: 700;
        padding: 16px 20px;
        border-top: 1px solid #e5e7eb;
    }

    .child-table-wrap {
        padding: 0 20px 18px;
    }

    .child-table {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        overflow: hidden;
    }

        .child-table th {
            background: #f3f3f3;
            padding: 9px;
            color: #6b7280;
            font-weight: 500;
            border-bottom: 1px solid #e5e7eb;
        }

        .child-table td {
            padding: 36px;
            text-align: center;
            color: #6b7280;
        }

    .add-row-btn,
    .expand-btn {
        margin-top: 10px;
        background: #f3f4f6;
        border: 0;
        border-radius: 7px;
        padding: 6px 12px;
        font-size: 14px;
    }

    .condition-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 28px;
    }

    .code-box {
        min-height: 288px;
        font-family: Consolas, monospace;
    }

    .search-select { position: relative; width: 100%; }
    .search-select input { width: 100%; }
    .search-select-menu { display: none; position: fixed; z-index: 3000; max-height: 260px; overflow: auto; background: #fff; border: 1px solid #94a3b8; border-radius: 6px; box-shadow: 0 10px 20px rgba(15, 23, 42, .18); }
    .search-select-menu button { display: block; width: 100%; padding: 8px 10px; border: 0; background: #fff; color: #172033; text-align: left; }
    .search-select-menu button:hover { background: #e8f3f3; color: #0f766e; }
    .search-select-menu span { display: block; padding: 9px 10px; color: #64748b; }

    .help-box h4 {
        font-weight: 700;
        margin-bottom: 14px;
    }

    .help-box {
        font-size: 14px;
        line-height: 1.65;
    }

        .help-box code {
            color: #7c3aed;
            background: transparent;
            font-size: 13px;
        }

    @@media (max-width: 900px) {
        .form-grid,
        .condition-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="erp-form-page">
    <form method="post" action="@Url.Action("CreateSalaryComponent", "HR")">
        @Html.AntiForgeryToken()
        @if (TempData["ErpNextError"] != null) { <div class="alert alert-danger">@TempData["ErpNextError"]</div> }
        <div class="erp-header">
            <div>
                <span class="erp-title">New Salary Component</span>
                <span class="not-saved">Not Saved</span>
            </div>

            <button type="submit" class="save-btn">Save</button>
        </div>

        <div class="erp-card">
            <div class="tab-row">
                <button type="button" class="tab-btn active" data-tab="overview">Overview</button>
                <button type="button" class="tab-btn" data-tab="condition">Condition &amp; Formula</button>
                <button type="button" class="tab-btn" data-tab="benefits">Flexible Benefits</button>
            </div>

            <div id="overview" class="tab-pane active">
                <div class="form-grid">
                    <div>
                        <label class="field-label">Name <span class="required">*</span></label>
                        <input type="text" name="Name" class="erp-input" />

                        <label class="field-label mt-3">Abbr <span class="required">*</span></label>
                        <input type="text" name="Abbr" class="erp-input" />

                        <label class="field-label mt-3">Type <span class="required">*</span></label>
                        <select name="Type" class="erp-select">
                            <option value="Earning">Earning</option>
                            <option value="Deduction">Deduction</option>
                        </select>

                        <label class="field-label mt-3">Description</label>
                        <textarea name="Description" class="erp-textarea"></textarea>

                        <div id="componentTypeField">
                            <label class="field-label mt-3">Component Type</label>
                            <select name="ComponentType" class="erp-select"><option value="">Select component type</option><option>Provident Fund</option><option>Additional Provident Fund</option><option>Provident Fund Loan</option><option>Professional Tax</option></select>
                        </div>
                    </div>

                    <div class="check-list">
                        <label class="check-row">
                            <input type="checkbox" name="DependsOnPaymentDays" checked />
                            <span>Depends on Payment Days</span>
                        </label>

                        <label class="check-row">
                            <input type="checkbox" name="IsTaxApplicable" checked />
                            <span>Is Tax Applicable</span>
                        </label>

                        <label class="check-row">
                            <input type="checkbox" name="DeductFullTaxOnSelectedPayrollDate" />
                            <span>Deduct Full Tax on Selected Payroll Date</span>
                        </label>

                        <label class="check-row"><input type="checkbox" name="VariableBasedOnTaxableSalary" /><span>Variable Based On Taxable Salary</span></label>
                        <label class="check-row"><input type="checkbox" name="IsIncomeTaxComponent" /><span>Is Income Tax Component</span></label>
                        <label class="check-row"><input type="checkbox" name="ExemptedFromIncomeTax" /><span>Exempted from Income Tax</span></label>

                        <label class="check-row">
                            <input type="checkbox" name="RoundToNearestInteger" />
                            <span>Round to the Nearest Integer</span>
                        </label>

                        <label class="check-row">
                            <input type="checkbox" name="StatisticalComponent" />
                            <span>Statistical Component</span>
                        </label>
                        <div class="help-text">
                            If enabled, the value specified or calculated in this component will not contribute to the earnings or deductions.
                            However, it's value can be referenced by other components that can be added or deducted.
                        </div>

                        <label class="check-row">
                            <input type="checkbox" name="DoNotIncludeInTotal" />
                            <span>Do Not Include in Total</span>
                        </label>

                        <label class="check-row"><input type="checkbox" name="DoNotIncludeInAccounts" /><span>Do Not Include in Accounting Entries</span></label>

                        <label class="check-row">
                            <input type="checkbox" name="RemoveIfZeroValued" checked />
                            <span>Remove if Zero Valued</span>
                        </label>
                        <div class="help-text">
                            If enabled, the component will not be displayed in the salary slip if the amount is zero
                        </div>

                        <label class="check-row">
                            <input type="checkbox" name="Disabled" />
                            <span>Disabled</span>
                        </label>
                    </div>
                </div>
            </div>

            <div id="condition" class="tab-pane">
                <div class="condition-grid">
                    <div>
                        <label class="field-label">Condition</label>
                        <textarea name="Condition" class="erp-input code-box"></textarea>

                        <button type="button" class="expand-btn">Expand</button>

                        <label class="field-label mt-3">Amount</label>
                        <input type="number" step="0.01" name="Amount" class="erp-input" />

                        <label class="check-row mt-3">
                            <input type="checkbox" name="AmountBasedOnFormula" />
                            <span>Amount based on formula</span>
                        </label>

                        <label class="field-label mt-3">Formula</label>
                        <textarea name="Formula" class="erp-input code-box"></textarea>
                    </div>

                    <div class="help-box">
                        <h4>Help</h4>

                        <div>Notes:</div>
                        <ol>
                            <li>Use field <code>base</code> for using base salary of the Employee</li>
                            <li>Use Salary Component abbreviations in conditions and formulas. <code>BS = Basic Salary</code></li>
                            <li>Use field name for employee details in conditions and formulas. <code>Employment Type = employment_type</code><br /><code>Branch = branch</code></li>
                            <li>Use field name from Salary Slip in conditions and formulas. <code>Payment Days = payment_days</code><br /><code>Leave Without Pay = leave_without_pay</code></li>
                            <li>Direct Amount can also be entered based on Condition. See example 3</li>
                        </ol>

                        <h5 class="fw-bold mt-3">Examples</h5>
                        <ol>
                            <li>
                                Calculating Basic Salary based on <code>base</code><br />
                                <code>Condition: base &lt; 10000</code><br /><br />
                                <code>Formula: base * .2</code>
                            </li>
                            <li class="mt-3">
                                Calculating HRA based on Basic Salary <code>BS</code><br />
                                <code>Condition: BS &gt; 2000</code><br /><br />
                                <code>Formula: BS * .1</code>
                            </li>
                            <li class="mt-3">
                                Calculating TDS based on Employment Type <code>employment_type</code><br />
                                <code>Condition: employment_type=="Intern"</code><br /><br />
                                <code>Amount: 1000</code>
                            </li>
                        </ol>
                    </div>
                </div>
            </div>

            <div id="benefits" class="tab-pane">
                <label class="check-row">
                    <input type="checkbox" name="IsFlexibleBenefit" />
                    <span>Is Flexible Benefit</span>
                </label>
                <div class="form-grid mt-3">
                    <div><label class="field-label">Max Benefit Amount (Yearly)</label><input type="number" step="0.01" name="MaxBenefitAmount" class="erp-input" /></div>
                    <div class="check-list"><label class="check-row"><input type="checkbox" name="PayAgainstBenefitClaim" /><span>Pay Against Benefit Claim</span></label><label class="check-row"><input type="checkbox" name="OnlyTaxImpact" /><span>Only Tax Impact (Cannot Claim But Part of Taxable Income)</span></label><label class="check-row"><input type="checkbox" name="CreateSeparatePaymentEntryAgainstBenefitClaim" /><span>Create Separate Payment Entry Against Benefit Claim</span></label></div>
                </div>
            </div>

            <div id="accountsSection">
                <div class="section-title">Accounts</div>

                <div class="child-table-wrap">
                    <label class="field-label">Accounts</label>

                    <table class="child-table">
                        <thead>
                            <tr>
                                <th style="width:50px;"><input type="checkbox" /></th>
                                <th style="width:70px;">No.</th>
                                <th>Company</th>
                                <th>Account</th>
                                <th style="width:55px;">⚙</th>
                            </tr>
                        </thead>
                        <tbody id="accountsBody">
                            <tr id="accountsEmptyRow">
                                <td colspan="5">No Data</td>
                            </tr>
                        </tbody>
                    </table>

                    <button type="button" class="add-row-btn" onclick="addSalaryComponentAccountRow()">Add Row</button>
                </div>
            </div>
        </div>
    </form>
</div>
<script>
    const salaryComponentCompanies = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(companies));
    const salaryComponentAccounts = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(accounts));
    function optionList(values, placeholder) {
        return '<option value="">' + placeholder + '</option>' + values.map(value => '<option value="' + value.replace(/"/g, '&quot;') + '">' + value + '</option>').join('');
    }
    function showAccountsOnlyOnOverview(activeTab) {
        const accountsSection = document.getElementById('accountsSection');

        if (!accountsSection) {
            return;
        }

        accountsSection.style.display = activeTab === 'overview' ? 'block' : 'none';
    }

    function addSalaryComponentAccountRow() {
        const body = document.getElementById('accountsBody');
        const emptyRow = document.getElementById('accountsEmptyRow');

        if (!body) {
            return;
        }

        if (emptyRow) {
            emptyRow.remove();
        }

        const rowNo = body.querySelectorAll('tr').length + 1;
        const row = document.createElement('tr');

        row.innerHTML = `
            <td style="padding:8px;text-align:center;">
                <input type="checkbox" />
            </td>
            <td style="padding:8px;text-align:center;">
                ${rowNo}
            </td>
            <td style="padding:8px;">
                <select name="AccountCompanies" class="erp-select">${optionList(salaryComponentCompanies, 'Select company')}</select>
            </td>
            <td style="padding:8px;">
                <select name="AccountHeads" class="erp-select">${optionList(salaryComponentAccounts, 'Select account')}</select>
            </td>
            <td style="padding:8px;text-align:center;">
                <button type="button"
                        class="add-row-btn"
                        onclick="this.closest('tr').remove(); refreshAccountRowNumbers();">
                    ×
                </button>
            </td>
        `;

        body.appendChild(row);
        enhanceLargeSelects(row);
    }

    function refreshAccountRowNumbers() {
        const body = document.getElementById('accountsBody');

        if (!body) {
            return;
        }

        const rows = body.querySelectorAll('tr');

        if (!rows.length) {
            body.innerHTML = `
                <tr id="accountsEmptyRow">
                    <td colspan="5">No Data</td>
                </tr>
            `;
            return;
        }

        rows.forEach(function (row, index) {
            const numberCell = row.children[1];

            if (numberCell) {
                numberCell.textContent = index + 1;
            }
        });
    }

    document.querySelectorAll('.tab-btn').forEach(function (button) {
        button.addEventListener('click', function () {
            document.querySelectorAll('.tab-btn').forEach(function (x) {
                x.classList.remove('active');
            });

            document.querySelectorAll('.tab-pane').forEach(function (x) {
                x.classList.remove('active');
            });

            button.classList.add('active');
            document.getElementById(button.dataset.tab).classList.add('active');

            showAccountsOnlyOnOverview(button.dataset.tab);
        });
    });

    const typeSelect = document.querySelector('select[name="Type"]');
    const componentTypeField = document.getElementById('componentTypeField');
    function refreshComponentType() { componentTypeField.style.display = typeSelect.value === 'Deduction' ? 'block' : 'none'; }
    typeSelect.addEventListener('change', refreshComponentType);
    refreshComponentType();

    function enhanceLargeSelects(scope) {
        scope.querySelectorAll('select').forEach(function (select) {
            if (select.dataset.searchSelectReady || select.options.length <= 11) return;
            select.dataset.searchSelectReady = 'true';
            const wrapper = document.createElement('div');
            wrapper.className = 'search-select';
            const input = document.createElement('input');
            input.type = 'text';
            input.className = 'erp-input';
            input.placeholder = select.options[0].text;
            const menu = document.createElement('div');
            menu.className = 'search-select-menu';
            select.parentNode.insertBefore(wrapper, select);
            wrapper.appendChild(input); wrapper.appendChild(menu); wrapper.appendChild(select);
            select.style.display = 'none';
            const values = Array.from(select.options).slice(1).map(option => ({ value: option.value, text: option.text }));
            function showMatches(text) {
                const term = text.toLowerCase();
                const matches = values.filter(value => value.text.toLowerCase().startsWith(term)).slice(0, 10);
                menu.innerHTML = matches.map(value => '<button type="button" data-value="' + value.value.replace(/"/g, '&quot;') + '">' + value.text + '</button>').join('') || '<span>No matching option</span>';
                const box = input.getBoundingClientRect();
                menu.style.left = box.left + 'px'; menu.style.top = (box.bottom + 4) + 'px'; menu.style.width = box.width + 'px'; menu.style.display = 'block';
            }
            input.addEventListener('focus', () => showMatches(input.value));
            input.addEventListener('input', () => showMatches(input.value));
            menu.addEventListener('click', event => { const value = event.target.dataset.value; if (!value) return; select.value = value; input.value = event.target.textContent; menu.style.display = 'none'; select.dispatchEvent(new Event('change')); });
            document.addEventListener('click', event => { if (!wrapper.contains(event.target)) menu.style.display = 'none'; });
        });
    }
    enhanceLargeSelects(document);

    showAccountsOnlyOnOverview('overview');
</script>
