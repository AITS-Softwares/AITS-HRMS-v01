@using Newtonsoft.Json.Linq
@{
    ViewBag.Title = "Cost Center Details";
    var doc = ViewBag.Document as JObject;
    string V(string key) => doc?[key]?.ToString() ?? "";
    bool B(string key) => doc?[key]?.Value<int>() == 1;
    var parents = ViewBag.ParentCostCenters as List<string> ?? new();
    var saveAction = Url.Action("UpdateCostCenter", "HR", new { id = V("name") });
    var deleteAction = Url.Action("DeleteCostCenter", "HR", new { id = V("name") });
}
<style>
.p{max-width:1210px;margin:auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.h{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.h h1{font-size:22px;margin:0}.actions{display:flex;align-items:center;gap:14px}.actions a{color:#fff;text-decoration:none}.btn-action{border:0;background:#0f766e;color:#fff;padding:9px 17px;border-radius:7px;font-weight:650}.delete{background:#b91c1c}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.s{padding:20px}.s h2{font-size:17px;margin:0 0 16px}.g{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.f label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.i,.sel{box-sizing:border-box;width:100%;height:36px;border:1px solid #b8c7d7;border-radius:8px;padding:7px 10px;background:#fbfdff;font-size:14px}.i[readonly]{background:#f2f6f9;color:#526375}.check{display:flex;align-items:center;gap:8px;padding-top:24px;font-size:14px}@@media(max-width:800px){.p{padding:12px}.g{grid-template-columns:1fr}.h,.actions{flex-wrap:wrap}}
</style>
<div class="p">
@if (TempData["ErpNextError"] != null) { <div class="alert alert-danger">@TempData["ErpNextError"]</div> }
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (doc != null) {
<form method="post" action="@saveAction">@Html.AntiForgeryToken()
<header class="h"><h1>@V("name")</h1><div class="actions"><a asp-action="CostCenter">Back to Cost Centers</a><button class="btn-action delete" type="submit" formaction="@deleteAction" formnovalidate onclick="return confirm('Delete this Cost Center from ERPNext?');">Delete</button><button class="btn-action" type="submit">Save</button></div></header>
<main class="card"><section class="s"><h2>Cost Center</h2><div class="g">
<div class="f"><label>Cost Center Name *</label><input class="i" name="CostCenterName" value="@V("cost_center_name")" required /></div>
<div class="f"><label>Cost Center Number</label><input class="i" name="CostCenterNumber" value="@V("cost_center_number")" /></div>
<div class="f"><label>Parent Cost Center</label><select class="sel" name="ParentCostCenter"><option value="">Select parent cost center</option>@foreach(var x in parents){<option value="@x" selected="@(x == V("parent_cost_center"))">@x</option>}</select></div>
<div class="f"><label>Company</label><input class="i" value="@V("company")" readonly /></div>
<label class="check"><input type="checkbox" name="IsGroup" checked="@B("is_group")" /> Is Group</label>
<label class="check"><input type="checkbox" name="Disabled" checked="@B("disabled")" /> Disabled</label>
<div class="f"><label>Lft</label><input class="i" value="@V("lft")" readonly /></div><div class="f"><label>Rgt</label><input class="i" value="@V("rgt")" readonly /></div><div class="f"><label>Old Parent</label><input class="i" value="@V("old_parent")" readonly /></div>
</div></section></main></form>
}
</div>
