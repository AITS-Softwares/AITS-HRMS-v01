@model Erp_Aits.Models.VehicleLog
@{
    ViewBag.Title = "New Vehicle Log";
}
<form method="post" action="/HR/CreateVehicleLog">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0 d-inline-block me-2">New Vehicle Log</h4>
            <span class="badge bg-warning-subtle text-warning">Not Saved</span>
        </div>
        <button type="submit" class="btn btn-dark btn-sm">Save</button>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@err.ErrorMessage</div>
            }
        </div>
    }

    <div class="card p-4 mb-3">
        <label class="form-label">Series *</label>
        <input name="Series" value="@Model.Series" class="form-control mb-3" required />

        <label class="form-label">License Plate *</label>
        <input name="LicensePlate" value="@Model.LicensePlate" class="form-control mb-3" required />

        <label class="form-label">Employee *</label>
        <input name="Employee" value="@Model.Employee" class="form-control" required />
    </div>

    <div class="card p-4 mb-3">
        <h6 class="mb-3">Odometer Reading</h6>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Date *</label>
                <input name="OdometerDate" type="date" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">Current Odometer value *</label>
                <input name="CurrentOdometerValue" type="number" step="0.01" class="form-control" required />
            </div>
        </div>
    </div>

    <div class="card p-4 mb-3">
        <h6 class="mb-3">Refuelling Details</h6>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Fuel Qty</label>
                <input name="FuelQty" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Supplier</label>
                <input name="Supplier" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Fuel Price</label>
                <input name="FuelPrice" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Invoice Ref</label>
                <input name="InvoiceRef" class="form-control" />
            </div>
        </div>
    </div>

    <div class="card p-4">
        <h6 class="mb-3">Service Details</h6>
        <table class="table table-bordered align-middle mb-1" id="serviceTable">
            <thead>
                <tr>
                    <th style="width:30px"></th>
                    <th style="width:50px">No.</th>
                    <th>Service Item *</th>
                    <th>Type *</th>
                    <th>Frequency *</th>
                    <th>Expense *</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addServiceRow()">Add Row</button>
    </div>
</form>

<script>
    var serviceRowCount = 0;

    function addServiceRow() {
        serviceRowCount++;
        var tbody = document.getElementById('serviceTable').querySelector('tbody');
        var row = document.createElement('tr');
        row.innerHTML = `
            <td><input type="checkbox" /></td>
            <td>${serviceRowCount}</td>
            <td><input type="text" name="ServiceItems" class="form-control form-control-sm border-0" /></td>
            <td><input type="text" name="Types" class="form-control form-control-sm border-0" /></td>
            <td><input type="text" name="Frequencies" class="form-control form-control-sm border-0" /></td>
            <td><input type="number" step="0.01" name="Expenses" class="form-control form-control-sm border-0" value="0.00" /></td>
        `;
        tbody.appendChild(row);
    }
</script>
