@{ViewBag.Title="New Currency";var formats=new[]{"#,###.##","#.###,##","# ###.##","# ###,##","#'###.##","#, ###.##","#,##,###.##","#,###.###","#.###","#,###"};}
<style>.p{max-width:1210px;margin:auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.h{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.h h1{font-size:22px;margin:0}.save{border:0;background:#0f766e;color:#fff;padding:9px 17px;border-radius:7px;font-weight:650}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px}.s{padding:20px}.s h2{font-size:17px;margin:0 0 16px}.g{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.f label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.i,.sel{box-sizing:border-box;width:100%;height:36px;border:1px solid #b8c7d7;border-radius:8px;padding:7px 10px;background:#fbfdff;font-size:14px}.check{display:flex;align-items:center;gap:8px;padding-top:24px;font-size:14px}@@media(max-width:800px){.p{padding:12px}.g{grid-template-columns:1fr}}</style>
<div class="p"><form method="post" asp-action="CreateCurrency">@Html.AntiForgeryToken()<header class="h"><h1>New Currency</h1><button class="save" type="submit">Save</button></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}<main class="card"><section class="s"><h2>Currency</h2><div class="g"><div class="f"><label>Currency Name *</label><input name="CurrencyName" class="i" required/></div><label class="check"><input name="Enabled" type="checkbox" checked/> Enabled</label><div class="f"><label>Fraction</label><input name="Fraction" class="i"/></div><div class="f"><label>Fraction Units</label><input name="FractionUnits" type="number" class="i"/></div><div class="f"><label>Smallest Currency Fraction Value</label><input name="SmallestCurrencyFractionValue" type="number" step="0.001" class="i"/></div><div class="f"><label>Symbol</label><input name="Symbol" class="i"/></div><label class="check"><input name="SymbolOnRight" type="checkbox"/> Show Currency Symbol on Right Side</label><div class="f"><label>Number Format</label><select name="NumberFormat" class="sel"><option value="">Select number format</option>@foreach(var x in formats){<option value="@x">@x</option>}</select></div></div></section></main></form></div>
