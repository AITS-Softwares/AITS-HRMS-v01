@model Erp_Aits.Models.InterviewFeedbackModel
@{
    ViewBag.Title = "Interview Feedback " + Model.Id;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Interview Feedback - @Model.Id</h4>
</div>

<h6 class="mb-3">Details</h6>
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <label class="form-label">Interview</label>
        <input class="form-control" value="@Model.InterviewId - @Model.InterviewRound" readonly />
    </div>
    <div class="col-md-6">
        <label class="form-label">Interviewer</label>
        <input class="form-control" value="@Model.Interviewer" readonly />
    </div>
    <div class="col-md-6">
        <label class="form-label">Job Applicant</label>
        <input class="form-control" value="@Model.JobApplicant" readonly />
    </div>
    <div class="col-md-6">
        <label class="form-label">Result</label>
        <input class="form-control" value="@Model.Result" readonly />
    </div>
</div>

<hr />
<h6 class="mb-3">Skill Assessment</h6>
<table class="table table-bordered align-middle mb-4">
    <thead>
        <tr>
            <th>No.</th>
            <th>Skill</th>
            <th>Rating</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Skills != null && Model.Skills.Any())
        {
            int i = 1;
            foreach (var s in Model.Skills)
            {
                <tr>
                    <td>@(i++)</td>
                    <td>@s.Skill</td>
                    <td>
                        @for (int r = 1; r <= 5; r++)
                        {
                            <span style="color:@(r <= s.Rating ? "#f59e0b" : "#d1d5db")">★</span>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="3" class="text-muted text-center py-3">No skills recorded</td></tr>
        }
    </tbody>
</table>

<hr />
<h6 class="mb-2">Feedback</h6>
<textarea class="form-control" rows="8" readonly>@Model.FeedbackText</textarea>
