    <div class="col-12"><hr /><h6 class="text-muted">Profile</h6></div>

    <div class="col-md-12">
        <label class="form-label">Bio</label>
        <textarea class="form-control" rows="3" readonly>@System.Text.RegularExpressions.Regex.Replace(Model.Bio ?? "", "<.*?>", "")</textarea>
    </div>

    <div class="col-12"><h6 class="text-muted mt-3">Educational Qualification</h6></div>

    <div class="col-12">
        <table class="table table-bordered table-sm align-middle" id="educationTable">
            <thead>
                <tr>
                    <th style="width:60px;">No.</th>
                    <th>School/University</th>
                    <th>Qualification</th>
                    <th>Level</th>
                    <th>Year of Passing</th>
                    <th style="width:60px;"></th>
                </tr>
            </thead>
            <tbody id="educationBody">
                @if (Model.EducationRows != null && Model.EducationRows.Any())
                {
                    for (var i = 0; i < Model.EducationRows.Count; i++)
                    {
                        <tr>
                            <td>@(i + 1)</td>
                            <td><input class="form-control" name="EduSchools" value="@Model.EducationRows[i].SchoolUniversity" /></td>
                            <td><input class="form-control" name="EduQualifications" value="@Model.EducationRows[i].Qualification" /></td>
                            <td>
                                <select class="form-control" name="EduLevels">
                                    <option value="">Select Level</option>
                                    <option value="Graduate" selected="@(Model.EducationRows[i].Level == "Graduate" ? "selected" : null)">Graduate</option>
                                    <option value="Post Graduate" selected="@(Model.EducationRows[i].Level == "Post Graduate" ? "selected" : null)">Post Graduate</option>
                                    <option value="Under Graduate" selected="@(Model.EducationRows[i].Level == "Under Graduate" ? "selected" : null)">Under Graduate</option>
                                </select>
                            </td>
                            <td><input class="form-control" name="EduYears" type="number" value="@Model.EducationRows[i].YearOfPassing" /></td>
                            <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeEmployeeRow(this, 'educationBody')">x</button></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <button type="button" class="btn btn-sm btn-outline-dark" onclick="addEducationRow()">Add Row</button>
    </div>

    <div class="col-12"><h6 class="text-muted mt-3">Previous Work Experience</h6></div>

    <div class="col-12">
        <table class="table table-bordered table-sm align-middle" id="externalWorkTable">
            <thead>
                <tr>
                    <th style="width:60px;">No.</th>
                    <th>Company</th>
                    <th>Designation</th>
                    <th>Salary</th>
                    <th>Address</th>
                    <th style="width:60px;"></th>
                </tr>
            </thead>
            <tbody id="externalWorkBody">
                @if (Model.ExternalWorkHistoryRows != null && Model.ExternalWorkHistoryRows.Any())
                {
                    for (var i = 0; i < Model.ExternalWorkHistoryRows.Count; i++)
                    {
                        <tr>
                            <td>@(i + 1)</td>
                            <td><input class="form-control" name="ExpCompanies" value="@Model.ExternalWorkHistoryRows[i].CompanyName" /></td>
                            <td>
                                <select class="form-control" name="ExpDesignations">
                                    <option value="">Select Designation</option>
                                    @if (ViewBag.Designations != null)
                                    {
                                        @foreach (var item in ViewBag.Designations)
                                        {
                                            var value = item["name"]?.ToString();

                                            if (value == Model.InternalWorkHistoryRows[i].Designation)
                                            {
                                                <option value="@value" selected>@value</option>
                                            }
                                            else
                                            {
                                                <option value="@value">@value</option>
                                            }
                                        }
                                    }
                                </select>
                            </td>
                            <td><input class="form-control" name="ExpSalaries" type="number" step="0.01" value="@Model.ExternalWorkHistoryRows[i].Salary" /></td>
                            <td><input class="form-control" name="ExpAddresses" value="@Model.ExternalWorkHistoryRows[i].Address" /></td>
                            <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeEmployeeRow(this, 'externalWorkBody')">x</button></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <button type="button" class="btn btn-sm btn-outline-dark" onclick="addExternalWorkRow()">Add Row</button>
    </div>

    <div class="col-12"><h6 class="text-muted mt-3">History In Company</h6></div>

    <div class="col-12">
        <table class="table table-bordered table-sm align-middle" id="internalWorkTable">
            <thead>
                <tr>
                    <th style="width:60px;">No.</th>
                    <th>Branch</th>
                    <th>Department</th>
                    <th>Designation</th>
                    <th>From Date</th>
                    <th>To Date</th>
                    <th style="width:60px;"></th>
                </tr>
            </thead>
            <tbody id="internalWorkBody">
                @if (Model.InternalWorkHistoryRows != null && Model.InternalWorkHistoryRows.Any())
                {
                    for (var i = 0; i < Model.InternalWorkHistoryRows.Count; i++)
                    {
                        <tr>
                            <td>@(i + 1)</td>
                            <td>
                                <select class="form-control" name="HistBranches">
                                    <option value="">Select Branch</option>
                                    @if (ViewBag.Branches != null)
                                    {
                                        @foreach (var item in ViewBag.Branches)
                                        {
                                            var value = item["name"]?.ToString();

                                            if (value == Model.InternalWorkHistoryRows[i].Branch)
                                            {
                                                <option value="@value" selected>@value</option>
                                            }
                                            else
                                            {
                                                <option value="@value">@value</option>
                                            }
                                        }
                                    }
                                </select>
                            </td>
                            <td>
                                <select class="form-control" name="HistDepartments">
                                    <option value="">Select Department</option>
                                    @if (ViewBag.Departments != null)
                                    {
                                        @foreach (var item in ViewBag.Departments)
                                        {
                                            var value = item["name"]?.ToString();

                                            if (value == Model.InternalWorkHistoryRows[i].Department)
                                            {
                                                <option value="@value" selected>@value</option>
                                            }
                                            else
                                            {
                                                <option value="@value">@value</option>
                                            }
                                        }
                                    }
                                </select>
                            </td>
                            <td>
                                <select class="form-control" name="HistDesignations">
                                    <option value="">Select Designation</option>
                                    @if (ViewBag.Designations != null)
                                    {
                                        @foreach (var item in ViewBag.Designations)
                                        {
                                            var value = item["name"]?.ToString();

                                            if (value == Model.ExternalWorkHistoryRows[i].Designation)
                                            {
                                                <option value="@value" selected>@value</option>
                                            }
                                            else
                                            {
                                                <option value="@value">@value</option>
                                            }
                                        }
                                    }
                                </select>
                            </td>
                            <td><input class="form-control" name="HistFromDates" type="date" value="@(Model.InternalWorkHistoryRows[i].FromDate?.ToString("yyyy-MM-dd"))" /></td>
                            <td><input class="form-control" name="HistToDates" type="date" value="@(Model.InternalWorkHistoryRows[i].ToDate?.ToString("yyyy-MM-dd"))" /></td>
                            <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeEmployeeRow(this, 'internalWorkBody')">x</button></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <button type="button" class="btn btn-sm btn-outline-dark" onclick="addInternalWorkRow()">Add Row</button>
    </div>

    <script>
        function renumberRows(bodyId) {
            document.querySelectorAll('#' + bodyId + ' tr').forEach(function (row, index) {
                row.cells[0].innerText = index + 1;
            });
        }

        function removeEmployeeRow(button, bodyId) {
            button.closest('tr').remove();
            renumberRows(bodyId);
        }

        function addEducationRow() {
            var tbody = document.getElementById('educationBody');
            var tr = document.createElement('tr');

            tr.innerHTML =
                '<td></td>' +
                '<td><input class="form-control" name="EduSchools" /></td>' +
                '<td><input class="form-control" name="EduQualifications" /></td>' +
                '<td><select class="form-control" name="EduLevels"><option value="">Select Level</option><option value="Graduate">Graduate</option><option value="Post Graduate">Post Graduate</option><option value="Under Graduate">Under Graduate</option></select></td>' +
                '<td><input class="form-control" name="EduYears" type="number" /></td>' +
                '<td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeEmployeeRow(this, \'educationBody\')">x</button></td>';

            tbody.appendChild(tr);
            renumberRows('educationBody');
        }

        function addExternalWorkRow() {
            var tbody = document.getElementById('externalWorkBody');
            var designationOptions = document.getElementById('EmployeeDesignationOptions')?.innerHTML || '<option value="">Select Designation</option>';
            var tr = document.createElement('tr');

            tr.innerHTML =
                '<td></td>' +
                '<td><input class="form-control" name="ExpCompanies" /></td>' +
                '<td><select class="form-control" name="ExpDesignations">' + designationOptions + '</select></td>' +
                '<td><input class="form-control" name="ExpSalaries" type="number" step="0.01" /></td>' +
                '<td><input class="form-control" name="ExpAddresses" /></td>' +
                '<td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeEmployeeRow(this, \'externalWorkBody\')">x</button></td>';

            tbody.appendChild(tr);
            renumberRows('externalWorkBody');
        }

        function addInternalWorkRow() {
            var tbody = document.getElementById('internalWorkBody');
            var branchOptions = document.getElementById('EmployeeBranchOptions')?.innerHTML || '<option value="">Select Branch</option>';
            var departmentOptions = document.getElementById('EmployeeDepartmentOptions')?.innerHTML || '<option value="">Select Department</option>';
            var designationOptions = document.getElementById('EmployeeDesignationOptions')?.innerHTML || '<option value="">Select Designation</option>';
            var tr = document.createElement('tr');

            tr.innerHTML =
                '<td></td>' +
                '<td><select class="form-control" name="HistBranches">' + branchOptions + '</select></td>' +
                '<td><select class="form-control" name="HistDepartments">' + departmentOptions + '</select></td>' +
                '<td><select class="form-control" name="HistDesignations">' + designationOptions + '</select></td>' +
                '<td><input class="form-control" name="HistFromDates" type="date" /></td>' +
                '<td><input class="form-control" name="HistToDates" type="date" /></td>' +
                '<td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeEmployeeRow(this, \'internalWorkBody\')">x</button></td>';

            tbody.appendChild(tr);
            renumberRows('internalWorkBody');
        }
    </script>
    <div class="col-12"><hr /><h6 class="text-muted">Employee Exit</h6></div>

    <div class="col-md-4">
        <label class="form-label">Resignation Letter Date</label>
        <input class="form-control" value="@(Model.ResignationLetterDate?.ToString("dd-MM-yyyy"))" readonly />
    </div>

    <div class="col-md-4">
        <label class="form-label">Relieving Date</label>
        <input class="form-control" value="@(Model.RelievingDate?.ToString("dd-MM-yyyy"))" readonly />
    </div>

    <div class="col-md-4">
        <label class="form-label">Exit Interview Held On</label>
        <input class="form-control" value="@(Model.ExitInterviewHeldOn?.ToString("dd-MM-yyyy"))" readonly />
    </div>

    <div class="col-md-4">
        <label class="form-label">Leave Encashed</label>
        <input class="form-control" value="@Model.LeaveEncashed" readonly />
    </div>

    <div class="col-md-4">
        <label class="form-label">Encashment Date</label>
        <input class="form-control" value="@(Model.EncashmentDate?.ToString("dd-MM-yyyy"))" readonly />
    </div>

    <div class="col-md-4">
        <label class="form-label">New Workplace</label>
        <input class="form-control" value="@Model.NewWorkplace" readonly />
    </div>

    <div class="col-md-6">
        <label class="form-label">Reason For Leaving</label>
        <textarea class="form-control" rows="3" readonly>@Model.ReasonForLeaving</textarea>
    </div>

    <div class="col-md-6">
        <label class="form-label">Feedback</label>
        <textarea class="form-control" rows="3" readonly>@Model.Feedback</textarea>
    </div>
</div>


<select id="EmployeeBranchOptions" class="d-none">
    <option value="">Select Branch</option>
    @if (ViewBag.Branches != null)
    {
        foreach (var item in ViewBag.Branches)
        {
            var value = item["name"]?.ToString();
            <option value="@value">@value</option>
        }
    }
</select>

<select id="EmployeeDepartmentOptions" class="d-none">
    <option value="">Select Department</option>
    @if (ViewBag.Departments != null)
    {
        foreach (var item in ViewBag.Departments)
        {
            var value = item["name"]?.ToString();
            <option value="@value">@value</option>
        }
    }
</select>

<select id="EmployeeDesignationOptions" class="d-none">
    <option value="">Select Designation</option>
    @if (ViewBag.Designations != null)
    {
        foreach (var item in ViewBag.Designations)
        {
            var value = item["name"]?.ToString();
            <option value="@value">@value</option>
        }
    }
</select>




</section>
