@model Erp_Aits.Models.ATSCandidate
@{
    ViewBag.Title = "New ATS Candidate";
}

<form asp-action="CreateATSCandidate" method="post">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">New ATS Candidate</h4>
        <button type="submit" class="btn btn-dark btn-sm">Save</button>
    </div>

    <div class="card p-4 mb-3">
        <h6 class="mb-3">Stats</h6>
        <div class="row g-3">
            <div class="col-md-6">
                <span class="badge bg-danger-subtle text-danger">&#9679; @Model.CandidateStatus</span>
            </div>
            <div class="col-md-6">
                <span class="badge bg-danger-subtle text-danger">&#9679; ATS Score: @Model.ATSScore%</span>
            </div>
        </div>
    </div>

    <div class="card p-4 mb-3">
        <h6 class="mb-3">Candidate Profile</h6>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Candidate Name *</label>
                <input asp-for="CandidateName" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">Applied Job *</label>
                <input asp-for="AppliedJob" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">Email</label>
                <input asp-for="Email" type="email" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Candidate Status</label>
                <select asp-for="CandidateStatus" class="form-select">
                    <option>Applied</option>
                    <option>Screening</option>
                    <option>Shortlisted</option>
                    <option>Rejected</option>
                    <option>Interview</option>
                    <option>Offered</option>
                    <option>Hired</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Phone</label>
                <input asp-for="Phone" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Source</label>
                <select asp-for="Source" class="form-select">
                    <option value="">Select</option>
                    <option>LinkedIn</option>
                    <option>Referral</option>
                    <option>Website</option>
                    <option>Consultant</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Resume Attachment</label>
                <div>
                    <input type="hidden" asp-for="ResumeAttachment" id="ResumeAttachmentHidden" />
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="document.getElementById('resumeFileInput').click()">Attach</button>
                    <input type="file" id="resumeFileInput" class="d-none" onchange="document.getElementById('ResumeAttachmentHidden').value=this.files[0]?.name || ''" />
                    <span id="resumeFileName" class="ms-2 small text-muted"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card p-4 mb-3">
        <h6 class="mb-3">Resume Parser</h6>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Resume Parse Status</label>
                <input asp-for="ResumeParseStatus" class="form-control" readonly />
            </div>
        </div>
    </div>

    <div class="card p-4 mb-3">
        <h6 class="mb-3">ATS Scoring</h6>
        <label class="form-label">Skills</label>
        <textarea asp-for="Skills" class="form-control mb-1" rows="4"></textarea>
        <small class="text-muted d-block mb-3">Comma-separated skills are auto-matched against the job opening.</small>

        <label class="form-label">Candidate Skill Matrix</label>
        <table class="table table-bordered" id="skillMatrixTable">
            <thead>
                <tr>
                    <th style="width:60px;">No.</th>
                    <th>Skill *</th>
                    <th>Experience</th>
                    <th>Rating</th>
                    <th style="width:50px;"></th>
                </tr>
            </thead>
            <tbody id="skillMatrixBody"></tbody>
        </table>
        <button type="button" class="btn btn-sm btn-outline-dark" onclick="addSkillRow()">Add Row</button>
    </div>

    <div class="card p-4 mb-3">
        <h6 class="mb-3">Experience and Offer Fit</h6>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Experience</label>
                <input asp-for="Experience" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Current Company</label>
                <input asp-for="CurrentCompany" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Expected Salary</label>
                <input asp-for="ExpectedSalary" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Notice Period</label>
                <input asp-for="NoticePeriod" class="form-control" />
            </div>
        </div>
    </div>

    <div class="card p-4">
        <h6 class="mb-3">Recruiter Review</h6>
        <label class="form-label">Recruiter Notes</label>
        <textarea asp-for="RecruiterNotes" class="form-control mb-3" rows="6"></textarea>

        <label class="form-label">Interview Rating</label>
        <div>
            @for (int i = 1; i <= 5; i++)
            {
                <span style="font-size:1.3rem; cursor:pointer;" onclick="setRating(@i)" id="star@(i)">&#9734;</span>
            }
            <input type="hidden" asp-for="InterviewRating" id="InterviewRatingHidden" value="0" />
        </div>
    </div>
</form>

@section Scripts {
    <script>
        let skillIdx = 0;

        function addSkillRow() {
            const i = skillIdx++;
            const row = `<tr>
                <td>${i + 1}</td>
                <td><input name="SkillMatrix[${i}].Skill" class="form-control form-control-sm" required /></td>
                <td><input name="SkillMatrix[${i}].Experience" class="form-control form-control-sm" /></td>
                <td><input type="number" name="SkillMatrix[${i}].Rating" class="form-control form-control-sm" min="0" max="5" /></td>
                <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove()">&times;</button></td>
            </tr>`;
            document.getElementById('skillMatrixBody').insertAdjacentHTML('beforeend', row);
        }

        function setRating(n) {
            document.getElementById('InterviewRatingHidden').value = n;
            for (let i = 1; i <= 5; i++) {
                document.getElementById('star' + i).innerHTML = i <= n ? '&#9733;' : '&#9734;';
            }
        }
    </script>
}