@using Newtonsoft.Json.Linq
@{ ViewBag.Title="Payroll Period Details"; var doc=ViewBag.Document as JObject; var companies=ViewBag.PayrollPeriodCompanies as List<string>??new List<string>(); string Value(string key)=>doc?[key]?.ToString()??""; }
<style>.payroll-form{max-width:1210px;margin:0 auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.form-head{display:flex;align-items:center;justify-content:space-between;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.form-head h1{font-size:22px;margin:0}.actions{display:flex;align-items:center;gap:14px}.actions a{color:#fff;text-decoration:none;white-space:nowrap}.save,.delete{border:0;color:#fff;padding:9px 17px;border-radius:7px;font-weight:650}.save{background:#0f766e}.delete{background:#b91c1c}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.section{padding:20px;border-bottom:1px solid #dbe3ec}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.field label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.input,.select{box-sizing:border-box;width:100%;height:36px;border:1px solid #b8c7d7;border-radius:8px;padding:7px 10px;background:#fbfdff}.input[readonly]{background:#edf2f7;color:#526375}</style>
<div class="payroll-form"><form method="post" action="@Url.Action("UpdatePayrollPeriod", "HR", new { id = Value("name") })">@Html.AntiForgeryToken()<header class="form-head"><h1>@Value("name")</h1><div class="actions"><a asp-action="PayrollPeriod">Back to Payroll Periods</a><button class="delete" type="submit" formaction="@Url.Action("DeletePayrollPeriod", "HR", new { id = Value("name") })" formmethod="post" onclick="return confirm('Delete this Payroll Period from HRMS and ERPNext?');">Delete</button><button class="save" type="submit">Save</button></div></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}@if(TempData["Success"]!=null){<div class="alert alert-success mt-3">@TempData["Success"]</div>}@if(doc!=null){<main class="card"><section class="section"><div class="grid"><div class="field"><label>Name</label><input class="input" value="@Value("name")" readonly/></div><div class="field"><label>Company *</label><select class="select searchable" name="Company" required>@foreach(var option in companies){<option value="@option" selected="@(option==Value("company"))">@option</option>}</select></div><div class="field"><label>Start Date *</label><input class="input" name="StartDate" type="date" value="@Value("start_date").Split('T')[0]" required/></div><div class="field"><label>End Date *</label><input class="input" name="EndDate" type="date" value="@Value("end_date").Split('T')[0]" required/></div></div></section></main>}</form></div>
