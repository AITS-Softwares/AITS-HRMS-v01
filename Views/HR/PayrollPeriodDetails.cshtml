@using Newtonsoft.Json.Linq
@{ ViewBag.Title="Payroll Period Details"; var doc=ViewBag.Document as JObject; string Value(string key)=>doc?[key]?.ToString()??""; var periods=doc?["periods"] as JArray??new JArray(); }
<style>
.payroll-form{max-width:1210px;margin:0 auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.form-head{display:flex;align-items:center;justify-content:space-between;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.form-head h1{font-size:22px;margin:0}.form-head a{color:#fff;text-decoration:none}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.section{padding:20px;border-bottom:1px solid #dbe3ec}.section h2{font-size:17px;margin:0 0 16px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.field label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.value{min-height:36px;padding:8px 10px;box-sizing:border-box;border:1px solid #b8c7d7;border-radius:8px;background:#fbfdff;color:#172033}.table{width:100%;border-collapse:collapse;border:1px solid #d7e0e9;border-radius:8px;overflow:hidden}.table th,.table td{padding:10px;border-bottom:1px solid #e5e7eb;text-align:left;font-size:13px}.table th{background:#f4f8fc;color:#526375}.empty{text-align:center;color:#64748b;height:54px}@@media(max-width:800px){.grid{grid-template-columns:1fr}.payroll-form{padding:12px}}
</style>
<div class="payroll-form"><header class="form-head"><h1>@(Value("name")==""?"Payroll Period":Value("name"))</h1><a asp-action="PayrollPeriod">Back to Payroll Periods</a></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}@if(doc!=null){<main class="card"><section class="section"><div class="grid"><div class="field"><label>Company</label><div class="value">@Value("company")</div></div><div class="field"><label>Start Date</label><div class="value">@Value("start_date")</div></div><div class="field"><label>End Date</label><div class="value">@Value("end_date")</div></div></div></section><section class="section"><h2>Payroll Periods</h2><table class="table"><thead><tr><th>Payroll Period</th></tr></thead><tbody>@if(periods.Any()){foreach(var row in periods){<tr><td>@row</td></tr>}}else{<tr><td class="empty">No payroll period rows available.</td></tr>}</tbody></table></section></main>}</div>
