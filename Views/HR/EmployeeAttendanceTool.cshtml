        <label class="form-label">Company</label>
        <input type="text" id="filterCompany" class="form-control" value="AITS" />
    </div>
    <div class="col-md-6">
        <label class="form-label">Employment Type</label>
        <input type="text" id="filterEmploymentType" class="form-control" />
