@model List<Erp_Aits.Models.ProjectProfitabilityRow>
@{
    ViewBag.Title = "Project Profitability";
}
<h4 class="mb-3">Project Profitability</h4>

<form method="get" action="/HR/ProjectProfitability" class="card p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-auto">
            <input type="text" name="company" class="form-control form-control-sm" placeholder="Company" value="@ViewBag.Company" />
        </div>
        <div class="col-auto">
            <input type="date" name="fromDate" class="form-control form-control-sm"
                   value="@(((DateTime)ViewBag.FromDate).ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-auto">
            <input type="date" name="toDate" class="form-control form-control-sm"
                   value="@(((DateTime)ViewBag.ToDate).ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-auto">
            <input type="text" name="customer" class="form-control form-control-sm" placeholder="Customer" value="@ViewBag.Customer" />
        </div>
        <div class="col-auto">
            <input type="text" name="employee" class="form-control form-control-sm" placeholder="Employee" value="@ViewBag.Employee" />
        </div>
        <div class="col-auto">
            <input type="text" name="project" class="form-control form-control-sm" placeholder="Project" value="@ViewBag.Project" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-sm btn-dark">Refresh</button>
        </div>
    </div>
</form>

@if (Model.Any())
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Customer</th>
                <th>Project</th>
                <th>Total Hours</th>
                <th>Billing Amount</th>
                <th>Costing Amount</th>
                <th>Profit</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.Customer</td>
                    <td>@r.Project</td>
                    <td>@r.TotalHours.ToString("0.000")</td>
                    <td>@r.BillingAmount.ToString("0.00")</td>
                    <td>@r.CostingAmount.ToString("0.00")</td>
                    <td class="@(r.Profit >= 0 ? "text-success" : "text-danger")">@r.Profit.ToString("0.00")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted text-center py-5">Nothing to show</p>
}
