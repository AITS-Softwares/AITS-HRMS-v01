@model Erp_Aits.Models.AppraisalCycle
@{
    ViewBag.Title = "New Appraisal Cycle";
}

<form asp-action="CreateAppraisalCycle" method="post">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0 d-inline">New Appraisal Cycle</h4>
            <span class="badge bg-danger-subtle text-danger ms-2">Not Saved</span>
        </div>
        <button type="submit" class="btn btn-dark btn-sm">Save</button>
    </div>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#overviewTab">Overview</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#applicableForTab">Applicable For</a></li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="overviewTab">
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label">Cycle Name <span class="text-danger">*</span></label>
                    <input asp-for="CycleName" class="form-control" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Start Date <span class="text-danger">*</span></label>
                    <input asp-for="StartDate" type="date" class="form-control" required value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Company <span class="text-danger">*</span></label>
                    <select asp-for="Company" class="form-select" required>
                        <option value="">Select Company</option>
                        @if (ViewBag.Companies != null)
                        {
                            foreach (var item in ViewBag.Companies)
                            {
                                <option value="@item.name">@item.name</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">End Date <span class="text-danger">*</span></label>
                    <input asp-for="EndDate" type="date" class="form-control" required value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Status</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Not Started">Not Started</option>
                        <option value="In Progress">In Progress</option>
                        <option value="Completed">Completed</option>
                    </select>
                </div>
            </div>

            <hr />
            <h6 class="mb-2">Description</h6>
            <textarea asp-for="Description" class="form-control mb-4" rows="6"></textarea>

            <hr />
            <h6 class="mb-3">Settings</h6>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label">KRA Evaluation Method</label>
                    <select asp-for="KRAEvaluationMethod" class="form-select">
                        <option value="Automated Based on Goal Progress">Automated Based on Goal Progress</option>
                        <option value="Manual Rating">Manual Rating</option>
                    </select>
                </div>
            </div>

            <div class="form-check mb-2">
                <input asp-for="CalculateFinalScoreFormula" class="form-check-input" type="checkbox" />
                <label class="form-check-label" asp-for="CalculateFinalScoreFormula">
                    Calculate Final Score based on Formula
                </label>
            </div>

            <p class="text-muted small">
                By default, the Final Score is calculated as the average of Goal Score, Feedback Score, and Self Appraisal Score.
                Enable this to set a different formula
            </p>

            <div class="row g-3 mb-4">
                <div class="col-md-12">
                    <label class="form-label">Final Score Formula</label>
                    <textarea asp-for="FinalScoreFormula" class="form-control" rows="3"></textarea>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="applicableForTab">
            <h6 class="mb-1">Filters</h6>
            <p class="text-muted small mb-3">Set optional filters to fetch employees in the appraisee list</p>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label">Branch</label>
                    <select asp-for="Branch" class="form-select">
                        <option value="">Select Branch</option>
                        @if (ViewBag.Branches != null)
                        {
                            foreach (var item in ViewBag.Branches)
                            {
                                <option value="@item.name">@item.name</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Designation</label>
                    <select asp-for="Designation" class="form-select">
                        <option value="">Select Designation</option>
                        @if (ViewBag.Designations != null)
                        {
                            foreach (var item in ViewBag.Designations)
                            {
                                <option value="@item.name">@item.name</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Department</label>
                    <select asp-for="Department" class="form-select">
                        <option value="">Select Department</option>
                        @if (ViewBag.Departments != null)
                        {
                            foreach (var item in ViewBag.Departments)
                            {
                                <option value="@item.name">@item.name</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <hr />

            <h6 class="mb-2">Employees</h6>

            <button type="button" class="btn btn-sm btn-outline-secondary mb-2" onclick="addEmpRow()">
                Add Row
            </button>

            <table class="table table-bordered align-middle mb-1" id="empTable">
                <thead>
                    <tr>
                        <th style="width:40px"><input type="checkbox" disabled /></th>
                        <th style="width:50px">No.</th>
                        <th>Employee <span class="text-danger">*</span></th>
                        <th>Employee Name</th>
                        <th>Appraisal Template</th>
                        <th>Department</th>
                        <th>Designation</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</form>

<script>
    const employees = [
        @if (ViewBag.Employees != null)
        {
                foreach (var emp in ViewBag.Employees)
                {
                        <text>{
                            name: "@emp.name",
                            employee_name: "@emp.employee_name",
                            department: "@emp.department",
                            designation: "@emp.designation",
                            branch: "@emp.branch"
                        },</text>
                }
        }
    ];

    const templates = [
        @if (ViewBag.AppraisalTemplates != null)
        {
                foreach (var t in ViewBag.AppraisalTemplates)
                {
                        <text>"@t.name",</text>
                }
        }
    ];

    const departments = [
        @if (ViewBag.Departments != null)
        {
                foreach (var d in ViewBag.Departments)
                {
                        <text>"@d.name",</text>
                }
        }
    ];

    const designations = [
        @if (ViewBag.Designations != null)
        {
                foreach (var d in ViewBag.Designations)
                {
                        <text>"@d.name",</text>
                }
        }
    ];

    function optionList(items, selectedValue) {
        let html = '<option value="">Select</option>';

        items.forEach(function (x) {
            const selected = x === selectedValue ? 'selected' : '';
            html += `<option value="${x}" ${selected}>${x}</option>`;
        });

        return html;
    }

    function employeeOptions() {
        let html = '<option value="">Select Employee</option>';

        employees.forEach(function (emp) {
            const label = emp.employee_name ? `${emp.name} - ${emp.employee_name}` : emp.name;
            html += `<option value="${emp.name}">${label}</option>`;
        });

        return html;
    }

    function fillEmployeeDetails(select) {
        const row = select.closest('tr');
        const emp = employees.find(x => x.name === select.value);

        row.querySelector('.emp-name').value = emp ? (emp.employee_name || '') : '';
        row.querySelector('.emp-dept').value = emp ? (emp.department || '') : '';
        row.querySelector('.emp-desig').value = emp ? (emp.designation || '') : '';

        const branchInput = row.querySelector('.emp-branch');
        if (branchInput) {
            branchInput.value = emp ? (emp.branch || '') : '';
        }
    }

    function addEmpRow() {
        const tbody = document.querySelector('#empTable tbody');
        const rowNum = tbody.rows.length + 1;

        const row = document.createElement('tr');

        row.innerHTML =
            '<td><input type="checkbox" /></td>' +
            '<td>' + rowNum + '</td>' +
            '<td><select name="EmpCodes" class="form-select form-select-sm border-0" onchange="fillEmployeeDetails(this)" required>' + employeeOptions() + '</select></td>' +
            '<td><input type="text" name="EmpNames" class="form-control form-control-sm border-0 emp-name" readonly /></td>' +
            '<td><select name="EmpTemplates" class="form-select form-select-sm border-0">' + optionList(templates, '') + '</select></td>' +
            '<td><select name="EmpDepts" class="form-select form-select-sm border-0 emp-dept">' + optionList(departments, '') + '</select></td>' +
            '<td><select name="EmpDesigs" class="form-select form-select-sm border-0 emp-desig">' + optionList(designations, '') + '</select></td>' +
            '<td style="display:none"><input type="hidden" name="EmpBranches" class="emp-branch" /></td>';

        tbody.appendChild(row);
    }
</script>