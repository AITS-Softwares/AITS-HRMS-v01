@using Erp_Aits.Models
@using Newtonsoft.Json.Linq
@{
    ViewBag.Title = "Employee Tax Exemption Proof Submission Details";
    var document = ViewBag.Document as JObject;
    string Value(string key) => document?[key]?.ToString() ?? "";
    var status = document?["docstatus"]?.Value<int>() ?? -1;
    var isDraft = status == 0;
    var isSubmitted = status == 1;
    var employees = ViewBag.TaxProofEmployees as List<PayrollEmployeeOption> ?? new();
    var periods = ViewBag.TaxProofPeriods as List<string> ?? new();
    var currencies = ViewBag.TaxProofCurrencies as List<string> ?? new();
    var categories = ViewBag.TaxProofCategories as List<string> ?? new();
    var subCategories = ViewBag.TaxProofSubCategories as List<string> ?? new();
    var proofRows = document?["tax_exemption_proofs"] as JArray ?? new JArray();
    if (!proofRows.Any()) { proofRows.Add(new JObject()); }
}
<style>
 .proof-page{max-width:1210px;margin:auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.proof-header{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.proof-header h1{font-size:22px;margin:0}.proof-status{display:inline-block;margin-top:7px;padding:3px 8px;border-radius:999px;background:#e7eef7;color:#23384e;font-size:13px}.proof-actions{display:flex;gap:10px;align-items:center}.proof-button,.proof-back{border:0;border-radius:7px;padding:9px 15px;font-weight:650;text-decoration:none}.proof-save{background:#0f766e;color:#fff}.proof-submit{background:#2563eb;color:#fff}.proof-cancel{background:#b91c1c;color:#fff}.proof-back{color:#fff;border:1px solid #7890a8}.proof-card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.proof-section{padding:20px;border-bottom:1px solid #dbe3ec}.proof-section h2{font-size:17px;margin:0 0 16px;color:#14253d}.proof-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.proof-field label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.proof-input,.proof-select{box-sizing:border-box;width:100%;height:36px;border:1px solid #b8c7d7;border-radius:8px;padding:7px 10px;background:#fbfdff}.proof-input[readonly]{background:#f2f6f9}.proof-table{width:100%;border-collapse:collapse}.proof-table th,.proof-table td{padding:8px;border:1px solid #dbe3ec}.proof-table th{background:#f4f8fc;text-align:left}.proof-table select,.proof-table input{box-sizing:border-box;width:100%;height:34px;border:1px solid #b8c7d7;border-radius:5px;padding:5px}.proof-add{border:0;background:#dce8f1;border-radius:6px;padding:7px 12px;margin-top:10px}fieldset{border:0;padding:0;margin:0}fieldset:disabled{opacity:.72}@@media(max-width:800px){.proof-grid{grid-template-columns:1fr}.proof-header{flex-wrap:wrap}}
</style>
<div class="proof-page">
 @if (TempData["ErpNextError"] != null) { <div class="alert alert-danger mb-3">@TempData["ErpNextError"]</div> }
 @if (TempData["Success"] != null) { <div class="alert alert-success mb-3">@TempData["Success"]</div> }
 @if (document != null) {
 <header class="proof-header"><div><h1>@Value("name")</h1><span class="proof-status">@(isDraft ? "Draft" : isSubmitted ? "Submitted" : "Cancelled")</span></div><div class="proof-actions"><a class="proof-back" asp-action="EmployeeTaxExemptionProofSubmission">Back to Proof Submissions</a>@if (isDraft) { <button id="saveProofButton" form="proofForm" class="proof-button proof-save" type="submit" hidden>Save</button><button id="submitProofButton" form="proofStatusForm" class="proof-button proof-submit" type="submit">Submit</button> } else if (isSubmitted) { <button form="proofStatusForm" class="proof-button proof-cancel" type="submit" onclick="return confirm('Cancel this proof submission in ERPNext?')">Cancel</button> }</div></header>
 <form id="proofForm" method="post" enctype="multipart/form-data" action="@Url.Action("UpdateEmployeeTaxExemptionProofSubmission", "HR", new { id = Value("name") })">@Html.AntiForgeryToken()<main class="proof-card"><fieldset disabled="@(isDraft ? null : "disabled")">
 <section class="proof-section"><h2>Employee</h2><div class="proof-grid"><div class="proof-field"><label>Employee *</label><select id="proofEmployee" name="Employee" class="proof-select" required><option value="">Select employee</option>@foreach (var employee in employees) { <option value="@employee.Id" selected="@(employee.Id == Value("employee"))" data-name="@employee.EmployeeName" data-department="@employee.Department" data-company="@employee.Company">@employee.Id</option> }</select></div><div class="proof-field"><label>Employee Name</label><input id="proofEmployeeName" class="proof-input" readonly value="@Value("employee_name")" /></div><div class="proof-field"><label>Department</label><input id="proofDepartment" class="proof-input" readonly value="@Value("department")" /></div><div class="proof-field"><label>Company</label><input id="proofCompany" class="proof-input" readonly value="@Value("company")" /></div><div class="proof-field"><label>Currency *</label><select name="Currency" class="proof-select" required><option value="">Select currency</option>@foreach (var currency in currencies) { <option value="@currency" selected="@(currency == Value("currency"))">@currency</option> }</select></div><div class="proof-field"><label>Submission Date *</label><input name="SubmissionDate" class="proof-input" type="date" value="@Value("submission_date")" required /></div><div class="proof-field"><label>Payroll Period *</label><select name="PayrollPeriod" class="proof-select" required><option value="">Select payroll period</option>@foreach (var period in periods) { <option value="@period" selected="@(period == Value("payroll_period"))">@period</option> }</select></div><div class="proof-field"><label>Amended From</label><input class="proof-input" readonly value="@Value("amended_from")" /></div></div></section>
 <section class="proof-section"><h2>Exemption Proofs</h2><table class="proof-table"><thead><tr><th>Exemption Sub Category</th><th>Exemption Category</th><th>Maximum Exemption Amount</th><th>Actual Amount</th><th>Type of Proof</th><th>Attach Proof</th></tr></thead><tbody id="proofRows">@foreach (var row in proofRows) { var categoryValue = row["exemption_category"]?.ToString() ?? ""; var subCategoryValue = row["exemption_sub_category"]?.ToString() ?? ""; <tr class="proof-row"><td><select name="ProofSubCategories" class="proof-sub-category"><option value="">Select sub category</option>@foreach (var subCategory in subCategories) { <option value="@subCategory" selected="@(subCategory == subCategoryValue)">@subCategory</option> }</select></td><td><input name="ProofCategories" class="proof-category" readonly value="@categoryValue" /></td><td><input name="ProofMaxAmounts" class="proof-max-amount" readonly value="@row["max_amount"]" /></td><td><input name="ProofAmounts" type="number" min="0" step="0.01" value="@row["amount"]" /></td><td><input name="ProofTypes" required value="@row["type_of_proof"]" /></td><td>@if (!string.IsNullOrWhiteSpace(row["attach_proof"]?.ToString())) { <a href="@row["attach_proof"]" target="_blank">View proof</a> }<input name="ProofAttachments" type="file" /></td></tr>}</tbody></table>@if (isDraft) { <button class="proof-add" id="addProofRow" type="button">Add Row</button> }</section>
 <section class="proof-section"><h2>HRA Exemption and Totals</h2><div class="proof-grid"><div class="proof-field"><label>House Rent Payment Amount</label><input class="proof-input" readonly value="@Value("house_rent_payment_amount")" /></div><div class="proof-field"><label class="proof-check"><input type="checkbox" disabled checked="@(Value("rented_in_metro_city") == "1")" /> Rented in Metro City</label></div><div class="proof-field"><label>Rented From Date</label><input class="proof-input" readonly value="@Value("rented_from_date")" /></div><div class="proof-field"><label>Rented To Date</label><input class="proof-input" readonly value="@Value("rented_to_date")" /></div><div class="proof-field"><label>Monthly House Rent</label><input class="proof-input" readonly value="@Value("monthly_house_rent")" /></div><div class="proof-field"><label>Monthly Eligible Amount</label><input class="proof-input" readonly value="@Value("monthly_hra_exemption")" /></div><div class="proof-field"><label>Total Eligible HRA Exemption</label><input class="proof-input" readonly value="@Value("total_eligible_hra_exemption")" /></div><div class="proof-field"><label>Total Actual Amount</label><input class="proof-input" readonly value="@Value("total_actual_amount")" /></div><div class="proof-field"><label>Total Exemption Amount</label><input class="proof-input" readonly value="@Value("exemption_amount")" /></div><div class="proof-field"><label>Replace Attachment</label><input name="attachments" class="proof-input" type="file" /></div></div></section>
 </fieldset></main></form>
 @if (isDraft) { <form id="proofStatusForm" method="post" action="@Url.Action("SetEmployeeTaxExemptionProofSubmissionStatus", "HR", new { id = Value("name"), status = 1 })">@Html.AntiForgeryToken()</form> }
 @if (isSubmitted) { <form id="proofStatusForm" method="post" action="@Url.Action("SetEmployeeTaxExemptionProofSubmissionStatus", "HR", new { id = Value("name"), status = 2 })">@Html.AntiForgeryToken()</form> }
 }
</div>
@if (isDraft) { <script>(() => { const form=document.getElementById('proofForm'),save=document.getElementById('saveProofButton'),submit=document.getElementById('submitProofButton'),employee=document.getElementById('proofEmployee'),rows=document.getElementById('proofRows'); const dirty=()=>{save.hidden=false;submit.hidden=true};form.addEventListener('input',dirty);form.addEventListener('change',dirty);employee.addEventListener('change',()=>{const option=employee.options[employee.selectedIndex];document.getElementById('proofEmployeeName').value=option.dataset.name||'';document.getElementById('proofDepartment').value=option.dataset.department||'';document.getElementById('proofCompany').value=option.dataset.company||''});async function populateProofRow(row){const sub=row.querySelector('.proof-sub-category').value,category=row.querySelector('.proof-category'),max=row.querySelector('.proof-max-amount');category.value='';max.value='';if(!sub)return;const response=await fetch('@Url.Action("TaxExemptionSubCategoryDetails", "HR")?subCategory='+encodeURIComponent(sub));const data=await response.json();if(!response.ok||!data.success){alert(data.message||'The exemption sub-category could not be loaded.');return}category.value=data.category||'';max.value=data.amount||'0'}rows.addEventListener('change',event=>{if(event.target.classList.contains('proof-sub-category'))populateProofRow(event.target.closest('.proof-row'))});document.getElementById('addProofRow').addEventListener('click',()=>{const row=rows.querySelector('.proof-row').cloneNode(true);row.querySelector('.proof-sub-category').selectedIndex=0;row.querySelector('.proof-category').value='';row.querySelector('.proof-max-amount').value='';row.querySelector('[name="ProofAmounts"]').value='';row.querySelector('[name="ProofTypes"]').value='';row.querySelector('[name="ProofAttachments"]').value='';rows.append(row);dirty()})})()</script> }
