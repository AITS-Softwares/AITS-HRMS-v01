@{ViewBag.Title="Employee Tax Exemption Proof Submission Details";var d=ViewBag.Document as JObject;string V(string k)=>d?[k]?.ToString()??"";var rows=d?["tax_exemption_proofs"] as JArray??new JArray();var employeeFields=new[]{("Employee","employee"),("Employee Name","employee_name"),("Department","department"),("Company","company"),("Currency","currency"),("Amended From","amended_from"),("Submission Date","submission_date"),("Payroll Period","payroll_period")};var hraFields=new[]{("House Rent Payment Amount","house_rent_payment_amount"),("Rented in Metro City","rented_in_metro_city"),("Rented From Date","rented_from_date"),("Rented To Date","rented_to_date"),("Monthly House Rent","monthly_house_rent"),("Monthly Eligible Amount","monthly_hra_exemption"),("Total Eligible HRA Exemption","total_eligible_hra_exemption"),("Total Actual Amount","total_actual_amount"),("Total Exemption Amount","exemption_amount"),("Attachments","attachments")};}
