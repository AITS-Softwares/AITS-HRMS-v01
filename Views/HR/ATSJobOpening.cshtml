@model List<Erp_Aits.Models.ATSJobOpening>
@{
    ViewBag.Title = "ATS Job Opening";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">ATS Job Opening</h4>
    <a href="@Url.Action("CreateATSJobOpening", "HR")" class="btn btn-dark btn-sm">+ Add ATS Job Opening</a>
</div>

<form method="get" asp-action="ATSJobOpening" class="row g-2 mb-3">
    <div class="col-md-3">
        <input type="text" name="id" class="form-control form-control-sm" placeholder="ID" value="@ViewBag.IdFilter" />
    </div>
    <div class="col-md-3">
        <input type="text" name="jobTitle" class="form-control form-control-sm" placeholder="Job Title" value="@ViewBag.JobTitleFilter" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-sm btn-outline-dark">Filter</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Job Title</th>
            <th>Department</th>
            <th>Status</th>
            <th>ID</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var j in Model)
        {
            <tr style="cursor:pointer;" onclick="location.href='@Url.Action("ATSJobOpeningDetails", "HR", new { id = j.Id })'">
                <td>@j.JobTitle</td>
                <td>@j.Department</td>
                <td>
                    @if (j.Status == "Open")
                    {
                        <span class="badge bg-danger-subtle text-danger">&#9679; Open</span>
                    }
                    else if (j.Status == "Hold")
                    {
                        <span class="badge bg-warning-subtle text-warning">&#9679; Hold</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary">&#9679; Closed</span>
                    }
                </td>
                <td>@j.ATSJobOpeningCode</td>
            </tr>
        }
    </tbody>
</table>
@if (!Model.Any())
{
    <p class="text-muted">No ATS job openings found.</p>
}
