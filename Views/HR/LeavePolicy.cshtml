@model List<Erp_Aits.Models.LeavePolicy>
@{
    ViewBag.Title = "Leave Policy";
}
<link rel="stylesheet" href="~/css/leave-workspace.css" asp-append-version="true" />
<span class="leave-ui" aria-hidden="true"></span>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Leave Policy</h4>
    <div>
        <a href="@Url.Action("CreateLeavePolicy", "HR")" class="btn btn-dark btn-sm">+ Add Leave Policy</a>
    </div>
</div>

@if (TempData["ErpNextError"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["ErpNextError"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-3">@TempData["Success"]</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <input type="text" name="id" value="@ViewBag.IdFilter" class="form-control form-control-sm" placeholder="ID / Title" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Filter</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Title</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr style="cursor:pointer" onclick="location.href='@Url.Action("LeavePolicyDetails", "HR", new { id = p.Id })'">
                <td>@p.Title</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No leave policies found.</p>
}
</div>
