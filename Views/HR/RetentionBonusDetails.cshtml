@using Newtonsoft.Json.Linq
@{ViewBag.Title="Retention Bonus Details";var doc=ViewBag.Document as JObject;string V(string k)=>doc?[k]?.ToString()??"";}
<style>.p{max-width:1210px;margin:0 auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.h{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.h h1{font-size:22px;margin:0}.h a{color:#fff;text-decoration:none}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.s{padding:20px;border-bottom:1px solid #dbe3ec}.s h2{font-size:17px;margin:0 0 16px}.g{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.f label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.v{min-height:36px;box-sizing:border-box;border:1px solid #b8c7d7;border-radius:8px;padding:8px 10px;background:#fbfdff;color:#172033}@@media(max-width:800px){.p{padding:12px}.g{grid-template-columns:1fr}}</style>
<div class="p"><header class="h"><h1>@(V("name")==""?"Retention Bonus":V("name"))</h1><a asp-action="RetentionBonus">Back to Retention Bonus</a></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}@if(doc!=null){<main class="card"><section class="s"><h2>Employee</h2><div class="g"><div class="f"><label>Employee</label><div class="v">@V("employee")</div></div><div class="f"><label>Employee Name</label><div class="v">@V("employee_name")</div></div><div class="f"><label>Department</label><div class="v">@V("department")</div></div><div class="f"><label>Company</label><div class="v">@V("company")</div></div><div class="f"><label>Date of Joining</label><div class="v">@V("date_of_joining")</div></div><div class="f"><label>Amended From</label><div class="v">@V("amended_from")</div></div></div></section><section class="s"><h2>Bonus</h2><div class="g"><div class="f"><label>Salary Component</label><div class="v">@V("salary_component")</div></div><div class="f"><label>Bonus Amount</label><div class="v">@V("bonus_amount")</div></div><div class="f"><label>Bonus Payment Date</label><div class="v">@V("bonus_payment_date")</div></div><div class="f"><label>Currency</label><div class="v">@V("currency")</div></div></div></section></main>}</div>
