@model List<Erp_Aits.Models.HolidayList>
@{
    ViewBag.Title = "Holiday List";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0">Holiday List Management</h4>
        <div>
            <!-- Sync from ERPNext Button -->
            @* <a href="@Url.Action("SyncHolidayListsFromErpNext", "HR")" class="btn btn-outline-primary btn-sm me-2">Sync from ERPNext</a> *@
            <a href="@Url.Action("CreateHolidayList", "HR")" class="btn btn-dark btn-sm">+ Add Holiday List</a>
        </div>
    </div>

    @if (TempData["ErpNextError"] != null)
    {
        <div class="alert alert-danger">@TempData["ErpNextError"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <!-- Search / Filter Form -->
    <form method="get" class="row g-2 mb-4">
        <div class="col-md-3">
            <input type="text" name="id" value="@ViewBag.IdFilter" class="form-control form-control-sm" placeholder="Filter by Holiday List Name..." />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-sm btn-outline-secondary">Filter</button>
        </div>
    </form>

    <!-- Holiday Lists Table -->
    <div class="card p-3 shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Holiday List Name</th>
                    <th>From Date</th>
                    <th>To Date</th>
                    <th>Total Holidays</th>
                    <th>Color</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var h in Model)
                    {
                        <tr style="cursor:pointer" onclick="location.href='@Url.Action("HolidayListDetails", "HR", new { id = h.Id })'">
                            <td><strong>@h.HolidayListName</strong></td>
                            <td>@h.FromDate.ToString("dd-MM-yyyy")</td>
                            <td>@h.ToDate.ToString("dd-MM-yyyy")</td>
                            <td><span class="badge bg-secondary">@h.TotalHolidays</span></td>
                            <td>
                                <span style="display:inline-block;width:20px;height:20px;border-radius:3px;background-color:@(string.IsNullOrEmpty(h.Color) ? "#3788d8" : h.Color);border:1px solid #ccc;"></span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-muted text-center py-4">No holiday lists found. Click "Sync from ERPNext" or add a new one.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>