@model List<dynamic>
@{
    ViewBag.Title = "Employee Analytics";
    var parameters = new[] { "Department", "Designation", "Grade", "Gender", "EmploymentType" };
    bool hasParameter = !string.IsNullOrEmpty(ViewBag.Parameter);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Employee Analytics</h4>
    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-sm btn-outline-secondary" title="Reload Report" onclick="reloadReport()">
            &#x21bb;
        </button>
        <button class="btn btn-sm btn-outline-secondary" title="More options">&#8942;</button>
    </div>
</div>

<!-- Filters -->
<form method="get" asp-action="EmployeeAnalytics" class="row g-2 mb-3">
    <div class="col-md-2">
        <input type="text" name="company" class="form-control form-control-sm" placeholder="Company" value="@ViewBag.Company" />
    </div>
    <div class="col-md-2">
        <select name="parameter" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">Parameter</option>
            @foreach (var p in parameters)
            {
                <option value="@p" selected="@(p == (string)ViewBag.Parameter)">@p</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-sm btn-dark">Filter</button>
    </div>
</form>

<!-- Report grid -->
<div class="card p-0">
    @if (!hasParameter)
    {
        <div class="text-center py-5">
            <p class="text-muted mb-0">Please set filters</p>
        </div>
    }
    else if (Model != null && Model.Any())
    {
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>@ViewBag.Parameter</th>
                    <th>Count</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    <tr>
                        <td>@row.Label</td>
                        <td>@row.Count</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="text-center py-5">
            <div class="mb-2" style="font-size:2rem;">&#128196;</div>
            <p class="text-muted mb-0">Nothing to show</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        function reloadReport() {
            window.location.reload();
        }
    </script>
}