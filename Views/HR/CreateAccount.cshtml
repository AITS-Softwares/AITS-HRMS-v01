@using System.Collections.Generic
@{ViewBag.Title="New Account";var companies=ViewBag.AccountCompanies as List<string>??new List<string>();var currencies=ViewBag.AccountCurrencies as List<string>??new List<string>();var parents=ViewBag.AccountParents as List<string>??new List<string>();var accountTypes=new[]{"Accumulated Depreciation","Asset Received But Not Billed","Bank","Cash","Chargeable","Capital Work in Progress","Cost of Goods Sold","Current Asset","Current Liability","Depreciation","Direct Expense","Direct Income","Equity","Expense Account","Expenses Included In Asset Valuation","Expenses Included In Valuation","Fixed Asset","Income Account","Indirect Expense","Indirect Income","Liability","Payable","Receivable","Round Off","Round Off for Opening","Stock","Stock Adjustment","Stock Received But Not Billed","Service Received But Not Billed","Tax","Temporary"};}
<style>.p{max-width:1210px;margin:0 auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.h{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.h h1{font-size:22px;margin:0}.save{border:0;background:#0f766e;color:#fff;padding:9px 17px;border-radius:7px;font-weight:650}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.s{padding:20px;border-bottom:1px solid #dbe3ec}.s:last-child{border:0}.s h2{font-size:17px;margin:0 0 16px}.g{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.f label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.i,.sel{box-sizing:border-box;width:100%;height:36px;border:1px solid #b8c7d7;border-radius:8px;padding:7px 10px;background:#fbfdff;font-size:14px}.i[readonly]{background:#f2f6f9;color:#526375}.check{display:flex;align-items:center;gap:8px;padding-top:24px;font-size:14px}.hidden{display:none}.ss{position:relative}.sm{display:none;position:fixed;z-index:3000;max-height:260px;overflow:auto;background:#fff;border:1px solid #94a3b8;border-radius:6px;box-shadow:0 10px 20px rgba(15,23,42,.18)}.sm button{display:block;width:100%;padding:8px 10px;border:0;background:#fff;text-align:left}.sm button:hover{background:#e8f3f3;color:#0f766e}@@media(max-width:800px){.p{padding:12px}.g{grid-template-columns:1fr}}</style>
<div class="p"><form method="post" asp-action="CreateAccount">@Html.AntiForgeryToken()<header class="h"><h1>New Account</h1><button class="save" type="submit">Save</button></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}<main class="card"><section class="s"><h2>Account</h2><div class="g"><label class="check"><input name="Disabled" type="checkbox"/> Disable</label><div class="f"><label>Account Name *</label><input name="AccountName" class="i" required/></div><div class="f"><label>Account Number</label><input name="AccountNumber" class="i"/></div><label class="check"><input name="IsGroup" id="group" type="checkbox"/> Is Group</label><div class="f"><label>Company *</label><select name="Company" class="sel searchable" required><option value="">Select company</option>@foreach(var x in companies){<option value="@x">@x</option>}</select></div><div class="f"><label>Root Type</label><select name="RootType" class="sel"><option value="">Select root type</option>@foreach(var x in new[]{"Asset","Liability","Income","Expense","Equity"}){<option>@x</option>}</select></div><div class="f"><label>Report Type</label><select name="ReportType" id="report" class="sel"><option value="">Select report type</option><option>Balance Sheet</option><option>Profit and Loss</option></select></div><div class="f" id="currency-wrap"><label>Currency</label><select name="AccountCurrency" class="sel searchable"><option value="">Select currency</option>@foreach(var x in currencies){<option value="@x">@x</option>}</select></div><div class="f"><label>Parent Account *</label><select name="ParentAccount" class="sel searchable" required><option value="">Select parent account</option>@foreach(var x in parents){<option value="@x">@x</option>}</select></div><div class="f"><label>Account Type</label><select name="AccountType" class="sel searchable"><option value="">Select account type</option>@foreach(var x in accountTypes){<option value="@x">@x</option>}</select></div><div class="f"><label>Tax Rate</label><input name="TaxRate" class="i" type="number" step="0.01"/></div><div class="f"><label>Frozen</label><select name="FreezeAccount" class="sel"><option value="">Select</option><option>No</option><option>Yes</option></select></div><div class="f"><label>Balance must be</label><select name="BalanceMustBe" class="sel"><option value="">Select balance</option><option>Debit</option><option>Credit</option></select></div><div class="f"><label>Lft</label><input class="i" readonly/></div><div class="f"><label>Rgt</label><input class="i" readonly/></div><div class="f"><label>Old Parent</label><input class="i" readonly/></div><label class="check hidden" id="gross-wrap"><input name="IncludeInGross" type="checkbox"/> Include in gross</label></div></section></main></form></div>
<script>const group=document.getElementById('group'),report=document.getElementById('report'),currency=document.getElementById('currency-wrap'),gross=document.getElementById('gross-wrap');function state(){currency.classList.toggle('hidden',group.checked);gross.classList.toggle('hidden',group.checked||report.value!=='Profit and Loss')}group.onchange=state;report.onchange=state;state();document.querySelectorAll('select.searchable').forEach(s=>{if(s.options.length<=11)return;const w=document.createElement('div'),i=document.createElement('input'),m=document.createElement('div');w.className='ss';i.className='i';i.placeholder='Type to search';m.className='sm';s.parentNode.insertBefore(w,s);w.append(i,s,m);s.style.display='none';const draw=()=>{const q=i.value.toLowerCase(),a=[...s.options].filter(x=>x.value&&x.text.toLowerCase().startsWith(q)).slice(0,10);m.innerHTML='';a.forEach(x=>{const b=document.createElement('button');b.type='button';b.textContent=x.text;b.onclick=()=>{s.value=x.value;i.value=x.text;m.style.display='none';s.dispatchEvent(new Event('change'))};m.appendChild(b)});const r=i.getBoundingClientRect();m.style.width=r.width+'px';m.style.left=r.left+'px';m.style.top=r.bottom+'px';m.style.display='block'};i.onfocus=draw;i.oninput=draw;document.addEventListener('click',x=>{if(!w.contains(x.target))m.style.display='none'})});</script>
