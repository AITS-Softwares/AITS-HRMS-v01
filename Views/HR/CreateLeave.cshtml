<div class="leave-form-wrapper">
    <form action="/HR/CreateLeave" method="post">
        <div class="form-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0">New Leave Application</h4>
            <div class="d-flex gap-2">
                <a href="@Url.Action("LeaveApplications", "HR")" class="btn btn-outline-light btn-sm" style="border:1.5px solid rgba(255,255,255,0.7); color:#fff; font-weight:600;">Back</a>
                <button type="submit" class="btn btn-dark btn-sm">Save</button>
            </div>
        </div>

        <div class="form-body">
            @if (TempData["ErpNextError"] != null)
            {
                <div class="alert alert-danger m-3">@TempData["ErpNextError"]</div>
            }

            <div class="section">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Leave Type *</label>
                        <select asp-for="LeaveType" id="leaveTypeInput" class="form-control" required>
                            <option value="">Select leave type...</option>
                            @if (ViewBag.LeaveTypes != null)
                            {
                                foreach (var lt in ViewBag.LeaveTypes)
                                {
                                    <option value="@lt">@lt</option>
                                }
                            }
                            <option value="__CREATE_NEW__">+ Create New Leave Type</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Employee *</label>
                        <input asp-for="Employee" id="employeeInput" list="employeeList" class="form-control" placeholder="Select or type employee code..." required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Employee Name</label>
                        <input asp-for="EmployeeName" id="employeeNameInput" class="form-control" placeholder="Employee Name" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Company *</label>
                        <input asp-for="Company" list="companyList" class="form-control" placeholder="Select or type company..." required />
                    </div>
                </div>
            </div>

            <div class="section">
                <h6 class="mb-3">Dates &amp; Reason</h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">From Date *</label>
                        <input asp-for="FromDate" type="date" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Reason</label>
                        <textarea asp-for="Reason" class="form-control" rows="4"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">To Date *</label>
                        <input asp-for="ToDate" type="date" class="form-control" required />
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check">
                            <input asp-for="HalfDay" class="form-check-input" type="checkbox" />
                            <label class="form-check-label">Half Day</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="section">
                <h6 class="mb-3">Approval</h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Leave Approver *</label>
                        <input asp-for="LeaveApprover" list="leaveApproverList" class="form-control" placeholder="Select or type approver email..." required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Posting Date *</label>
                        <input asp-for="PostingDate" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check">
                            <input asp-for="FollowViaEmail" class="form-check-input" type="checkbox" checked />
                            <label class="form-check-label">Follow via Email</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Status *</label>
                        <select asp-for="Status" class="form-select">
                            <option>Open</option>
                            <option>Approved</option>
                            <option>Rejected</option>
                            <option>Cancelled</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="section">
                <h6 class="mb-3">Other Details</h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Salary Slip</label>
                        <input asp-for="SalarySlip" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Letter Head</label>
                        <input asp-for="LetterHead" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Color</label>
                        <input asp-for="Color" type="color" class="form-control form-control-color" />
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Auto-fill Employee Name when employee code is matched from datalist
        document.getElementById('employeeInput').addEventListener('input', function() {
            let val = this.value;
            let options = document.querySelectorAll('#employeeList option');
            let nameField = document.getElementById('employeeNameInput');

            for (let opt of options) {
                if (opt.value === val) {
                    nameField.value = opt.getAttribute('data-name') || opt.innerText;
                    break;
                }
            }
        });

              

        
        // Intercept selecting "+ Create New Leave Type" from dropdown list
        document.getElementById('leaveTypeInput').addEventListener('change', function() {
          if (this.value === "__CREATE_NEW__") {
                this.value = "";
                window.location.href = '@Url.Action("CreateLeaveType", "HR")';
            }
        });
    </script>
}