@using Newtonsoft.Json.Linq
@{ ViewBag.Title="Salary Withholding Details";var doc=ViewBag.Document as JObject;string Value(string key)=>doc?[key]?.ToString()??"";var cycles=doc?["cycles"] as JArray??new JArray(); }
<style>.payroll-form{max-width:1210px;margin:0 auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.head{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.head h1{font-size:22px;margin:0}.head a{color:#fff;text-decoration:none}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.section{padding:20px;border-bottom:1px solid #dbe3ec}.section h2{font-size:17px;margin:0 0 16px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.field label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.value{min-height:36px;box-sizing:border-box;border:1px solid #b8c7d7;border-radius:8px;padding:8px 10px;background:#fbfdff;color:#172033;white-space:pre-wrap}.table{width:100%;border-collapse:collapse;border:1px solid #d7e0e9;border-radius:8px;overflow:hidden}.table th,.table td{padding:10px;border-bottom:1px solid #e5e7eb;text-align:left;font-size:13px}.table th{background:#f4f8fc;color:#526375}.empty{text-align:center;color:#64748b;height:54px}@@media(max-width:800px){.payroll-form{padding:12px}.grid{grid-template-columns:1fr}}</style>
<div class="payroll-form"><header class="head"><h1>@(Value("name")==""?"Salary Withholding":Value("name"))</h1><a asp-action="SalaryWithholding">Back to Salary Withholding</a></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}@if(doc!=null){<main class="card"><section class="section"><div class="grid"><div class="field"><label>Employee</label><div class="value">@Value("employee")</div></div><div class="field"><label>Employee Name</label><div class="value">@Value("employee_name")</div></div><div class="field"><label>Company</label><div class="value">@Value("company")</div></div><div class="field"><label>Posting Date</label><div class="value">@Value("posting_date")</div></div><div class="field"><label>Payroll Frequency</label><div class="value">@Value("payroll_frequency")</div></div><div class="field"><label>Number of Withholding Cycles</label><div class="value">@Value("number_of_withholding_cycles")</div></div><div class="field"><label>Status</label><div class="value">@Value("status")</div></div><div class="field"><label>From Date</label><div class="value">@Value("from_date")</div></div><div class="field"><label>To Date</label><div class="value">@Value("to_date")</div></div></div></section><section class="section"><h2>Exit Details</h2><div class="grid"><div class="field"><label>Date of Joining</label><div class="value">@Value("date_of_joining")</div></div><div class="field"><label>Relieving Date</label><div class="value">@Value("relieving_date")</div></div></div></section><section class="section"><h2>Reason</h2><div class="field"><label>Reason for Withholding Salary</label><div class="value">@Value("reason_for_withholding_salary")</div></div></section><section class="section"><h2>Cycles</h2><table class="table"><thead><tr><th>Cycles</th></tr></thead><tbody>@if(cycles.Any()){foreach(var row in cycles){<tr><td>@row</td></tr>}}else{<tr><td class="empty">No cycles available.</td></tr>}</tbody></table></section><section class="section"><div class="field"><label>Amended From</label><div class="value">@Value("amended_from")</div></div></section></main>}</div>
