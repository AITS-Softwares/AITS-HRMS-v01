@using Newtonsoft.Json.Linq
@{ ViewBag.Title="Salary Withholding Details"; var doc=ViewBag.Document as JObject; string Value(string key)=>doc?[key]?.ToString()??""; var cycles=doc?["cycles"] as JArray??new JArray(); var docStatus=doc?["docstatus"]?.Value<int>()??0; var canEdit=docStatus==0; var canCancel=docStatus==1; }
<style>.withholding-detail{max-width:1210px;margin:0 auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.withholding-detail__head{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.withholding-detail__head h1{font-size:22px;margin:0}.withholding-detail__actions{display:flex;flex-wrap:wrap;gap:10px}.withholding-detail__actions a,.withholding-detail__actions button{border:1px solid #9bb4c8;border-radius:6px;padding:9px 14px;font-weight:650;text-decoration:none}.withholding-detail__actions a{color:#fff}.withholding-detail__actions button{color:#fff}.withholding-detail__edit{background:#0f766e;border:0!important}.withholding-detail__submit{background:#1d6cb0}.withholding-detail__cancel{background:#a44343}.withholding-detail__card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.withholding-detail__section{padding:20px;border-bottom:1px solid #dbe3ec}.withholding-detail__section h2{font-size:17px;margin:0 0 16px}.withholding-detail__grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.withholding-detail__field label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.withholding-detail__value{min-height:38px;box-sizing:border-box;border:1px solid #b8c7d7;border-radius:6px;padding:8px 10px;background:#f4f8fb;color:#172033;white-space:pre-wrap}.withholding-detail__table{width:100%;border-collapse:collapse;border:1px solid #d7e0e9}.withholding-detail__table th,.withholding-detail__table td{padding:10px;border-bottom:1px solid #e5e7eb;text-align:left;font-size:13px}.withholding-detail__table th{background:#f4f8fc;color:#526375}.withholding-detail__empty{text-align:center;color:#64748b;height:54px}.withholding-detail__state{display:inline-block;background:#dcecf7;border-radius:999px;color:#174b64;font-size:.78rem;font-weight:700;margin-top:7px;padding:4px 8px}.withholding-detail__released{color:#087c78;font-weight:700}.withholding-detail__unreleased{color:#667789}@@media(max-width:800px){.withholding-detail{padding:12px}.withholding-detail__head{align-items:flex-start;flex-direction:column}.withholding-detail__grid{grid-template-columns:1fr}.withholding-detail__table{min-width:680px}.withholding-detail__table-wrap{overflow:auto}}</style>
<div class="withholding-detail"><header class="withholding-detail__head"><div><h1>@(Value("name")==""?"Salary Withholding":Value("name"))</h1><span class="withholding-detail__state">@(docStatus == 0 ? "Draft" : docStatus == 1 ? "Submitted" : "Cancelled")</span></div><div class="withholding-detail__actions"><a asp-action="SalaryWithholding">Back</a>@if(canEdit){<a class="withholding-detail__edit" asp-action="CreateSalaryWithholding" asp-route-id="@Value("name")">Edit</a><form method="post" asp-action="SalaryWithholdingStatus">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Value("name")"/><input type="hidden" name="status" value="1"/><button class="withholding-detail__submit" type="submit">Submit</button></form>}@if(canCancel){<form method="post" asp-action="SalaryWithholdingStatus">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Value("name")"/><input type="hidden" name="status" value="2"/><button class="withholding-detail__cancel" type="submit">Cancel</button></form>}</div></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}@if(TempData["Success"]!=null){<div class="alert alert-success mt-3">@TempData["Success"]</div>}@if(doc!=null){<main class="withholding-detail__card"><section class="withholding-detail__section"><div class="withholding-detail__grid"><div class="withholding-detail__field"><label>Employee</label><div class="withholding-detail__value">@Value("employee")</div></div><div class="withholding-detail__field"><label>Employee Name</label><div class="withholding-detail__value">@Value("employee_name")</div></div><div class="withholding-detail__field"><label>Company</label><div class="withholding-detail__value">@Value("company")</div></div><div class="withholding-detail__field"><label>Posting Date</label><div class="withholding-detail__value">@Value("posting_date")</div></div><div class="withholding-detail__field"><label>Payroll Frequency</label><div class="withholding-detail__value">@Value("payroll_frequency")</div></div><div class="withholding-detail__field"><label>Number of Withholding Cycles</label><div class="withholding-detail__value">@Value("number_of_withholding_cycles")</div></div><div class="withholding-detail__field"><label>Status</label><div class="withholding-detail__value">@Value("status")</div></div><div class="withholding-detail__field"><label>From Date</label><div class="withholding-detail__value">@Value("from_date")</div></div><div class="withholding-detail__field"><label>To Date</label><div class="withholding-detail__value">@Value("to_date")</div></div></div></section><section class="withholding-detail__section"><h2>Exit Details</h2><div class="withholding-detail__grid"><div class="withholding-detail__field"><label>Date of Joining</label><div class="withholding-detail__value">@Value("date_of_joining")</div></div><div class="withholding-detail__field"><label>Relieving Date</label><div class="withholding-detail__value">@Value("relieving_date")</div></div></div></section><section class="withholding-detail__section"><h2>Reason</h2><div class="withholding-detail__field"><label>Reason for Withholding Salary</label><div class="withholding-detail__value">@Value("reason_for_withholding_salary")</div></div></section><section class="withholding-detail__section"><h2>Cycles</h2><div class="withholding-detail__table-wrap"><table class="withholding-detail__table"><thead><tr><th>No.</th><th>From Date</th><th>To Date</th><th>Is Salary Released</th><th>Journal Entry</th></tr></thead><tbody>@if(cycles.Any()){foreach(var row in cycles){<tr><td>@row["idx"]</td><td>@row["from_date"]</td><td>@row["to_date"]</td><td><span class="@(row["is_salary_released"]?.Value<int>() == 1 ? "withholding-detail__released" : "withholding-detail__unreleased")">@(row["is_salary_released"]?.Value<int>() == 1 ? "Yes" : "No")</span></td><td>@row["journal_entry"]</td></tr>}}else{<tr><td colspan="5" class="withholding-detail__empty">No cycles available.</td></tr>}</tbody></table></div></section><section class="withholding-detail__section"><div class="withholding-detail__field"><label>Amended From</label><div class="withholding-detail__value">@Value("amended_from")</div></div></section></main>}</div>
