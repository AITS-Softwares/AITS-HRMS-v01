@model List<Erp_Aits.Models.EmployeeFeedbackCriteria>
@{
    ViewBag.Title = "Employee Feedback Criteria";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Employee Feedback Criteria</h4>

    <div class="d-flex gap-2">
        <button type="button" class="btn btn-dark btn-sm" data-bs-toggle="modal" data-bs-target="#newCriteriaModal">
            + Add Employee Feedback Criteria
        </button>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form method="get" asp-action="EmployeeFeedbackCriteria" asp-controller="HR" class="row g-2 mb-3">
    <div class="col-md-3">
        <input type="text"
               name="id"
               class="form-control form-control-sm"
               placeholder="ID / Criteria"
               value="@ViewBag.IdFilter" />
    </div>

    <div class="col-md-2">
        <button type="submit" class="btn btn-sm btn-outline-dark">
            Filter
        </button>
    </div>
</form>

<div class="card p-0">
    @if (Model != null && Model.Any())
    {
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Criteria</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr style="cursor:pointer;" onclick="location.href='@Url.Action("EmployeeFeedbackCriteriaDetails", "HR", new { id = c.Id })'">
                        <td>@c.CriteriaCode</td>
                        <td>@c.Criteria</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="text-center py-5">
            <div class="mb-2" style="font-size:2rem;">&#128203;</div>
            <p class="text-muted mb-1">You haven't created a Employee Feedback Criteria yet</p>

            <div class="d-flex justify-content-center gap-2">
                <a href="#" class="btn btn-dark btn-sm" data-bs-toggle="modal" data-bs-target="#newCriteriaModal">
                    Create your first Employee Feedback Criteria
                </a>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="newCriteriaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="QuickCreateEmployeeFeedbackCriteria" asp-controller="HR" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">New Employee Feedback Criteria</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <label class="form-label">Criteria *</label>
                    <input type="text" name="Criteria" class="form-control" maxlength="140" required />
                </div>

                <div class="modal-footer justify-content-between">
                    <a href="@Url.Action("CreateEmployeeFeedbackCriteria", "HR")" class="btn btn-outline-secondary btn-sm">
                        Edit Full Form
                    </a>

                    <button type="submit" class="btn btn-dark btn-sm">
                        Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
