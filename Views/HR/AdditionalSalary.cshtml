@model List<Erp_Aits.Models.AdditionalSalary>
@{
    ViewBag.Title = "Additional Salary";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Additional Salary</h4>
    <a href="@Url.Action("CreateAdditionalSalary", "HR")" class="btn btn-dark btn-sm">+ Add Additional Salary</a>
</div>

<form method="get" asp-action="AdditionalSalary" class="row g-2 mb-3">
    <div class="col-md-2">
        <input type="text" name="id" class="form-control form-control-sm" placeholder="ID" value="@ViewBag.IdFilter" />
    </div>
    <div class="col-md-2">
        <input type="text" name="employee" class="form-control form-control-sm" placeholder="Employee" value="@ViewBag.EmployeeFilter" />
    </div>
    <div class="col-md-2">
        <input type="text" name="employeeName" class="form-control form-control-sm" placeholder="Employee Name" value="@ViewBag.EmployeeNameFilter" />
    </div>
    <div class="col-md-2">
        <input type="text" name="component" class="form-control form-control-sm" placeholder="Component" value="@ViewBag.ComponentFilter" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-sm btn-outline-dark">Filter</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>Employee</th>
            <th>Employee Name</th>
            <th>Salary Component</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr style="cursor:pointer;" onclick="location.href='@Url.Action("AdditionalSalaryDetails", "HR", new { id = a.Id })'">
                <td>@a.AdditionalSalaryCode</td>
                <td>@a.Employee</td>
                <td>@a.EmployeeName</td>
                <td>@a.SalaryComponent</td>
            </tr>
        }
    </tbody>
</table>
@if (!Model.Any())
{
    <p class="text-muted">No additional salary records found.</p>
}
