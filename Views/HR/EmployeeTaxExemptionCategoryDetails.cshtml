@using Newtonsoft.Json.Linq
@{ViewBag.Title="Employee Tax Exemption Category Details";var d=ViewBag.Document as JObject;string V(string k)=>d?[k]?.ToString()??"";bool B(string k)=>d?[k]?.Value<int>()==1;}
<style>.p{max-width:1210px;margin:auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.h{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.h h1{margin:0;font-size:22px}.back{color:#fff;text-decoration:none;border:1px solid #7890a8;border-radius:7px;padding:8px 13px}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px}.s{padding:20px}.g{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.f label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.v{min-height:36px;box-sizing:border-box;width:100%;border:1px solid #b8c7d7;border-radius:8px;padding:8px 10px;background:#f2f6f9;color:#526375}.check{display:flex;align-items:center;gap:8px;padding-top:25px}</style>
<div class="p"><header class="h"><h1>Employee Tax Exemption Category Details</h1><div style="display:flex;gap:12px;align-items:center"><a class="back" asp-action="EmployeeTaxExemptionCategory">Back to Categories</a>@if(d != null){<button form="categoryForm" type="submit" class="back" style="background:#0f766e;border:0">Save</button>}</div></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}@if(TempData["Success"]!=null){<div class="alert alert-success mt-3">@TempData["Success"]</div>}@if(d != null){<form id="categoryForm" method="post" action="@Url.Action("UpdateEmployeeTaxExemptionCategory", "HR", new { id = V("name") })">@Html.AntiForgeryToken()<main class="card"><section class="s"><div class="g"><div class="f"><label>Category Name</label><input class="v" value="@V("name")" readonly /></div><div class="f"><label for="maxAmount">Max Exemption Amount</label><input id="maxAmount" name="MaxAmount" class="v" type="number" min="0" step="0.01" value="@V("max_amount")" style="background:#fbfdff;color:#172033" /></div><label class="check"><input name="IsActive" type="checkbox" checked="@B("is_active")"/> Is Active</label></div></section></main></form>}</div>
