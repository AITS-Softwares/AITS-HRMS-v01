@{
    ViewBag.Title = "Bulk Salary Structure Assignment";
    var employees = ViewBag.BulkAssignmentEmployees as List<Erp_Aits.Models.PayrollEmployeeOption> ?? new List<Erp_Aits.Models.PayrollEmployeeOption>();
    var structures = ViewBag.BulkAssignmentStructures as List<string> ?? new List<string>();
    var companies = ViewBag.BulkAssignmentCompanies as List<string> ?? new List<string>();
    var accounts = ViewBag.BulkAssignmentAccounts as List<string> ?? new List<string>();
    var branches = ViewBag.BulkAssignmentBranches as List<string> ?? new List<string>();
    var departments = ViewBag.BulkAssignmentDepartments as List<string> ?? new List<string>();
    var designations = ViewBag.BulkAssignmentDesignations as List<string> ?? new List<string>();
    var grades = ViewBag.BulkAssignmentGrades as List<string> ?? new List<string>();
    var employeeTypes = ViewBag.BulkAssignmentEmployeeTypes as List<string> ?? new List<string>();
}

<style>
    .bulk-page {
        max-width: 945px;
        margin: 0 auto;
    }

    .bulk-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

    .bulk-title {
        font-size: 18px;
        font-weight: 700;
    }

    .assign-btn {
        background: #111;
        color: #fff;
        border: 0;
        border-radius: 8px;
        padding: 7px 14px;
        font-weight: 600;
    }

    .bulk-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        overflow: hidden;
    }

    .section {
        padding: 16px;
        border-bottom: 1px solid #e5e7eb;
    }

    .section-title {
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 16px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px 28px;
    }

    .field-label {
        display: block;
        font-size: 12px;
        margin-bottom: 7px;
        color: #374151;
    }

    .required {
        color: #dc2626;
    }

    .erp-input, .erp-select {
        width: 100%;
        height: 30px;
        border: 1px solid #e5e7eb;
        background: #f3f3f3;
        border-radius: 7px;
        padding: 5px 9px;
        font-size: 12px;
    }

    .invalid {
        border-color: #ef4444;
    }

    .filter-row {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 24px;
        gap: 10px;
        align-items: center;
        margin-bottom: 10px;
    }

    .filter-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 12px;
    }

    .link-btn {
        border: 0;
        background: transparent;
        color: #111827;
        font-size: 12px;
        padding: 4px 6px;
    }

    .employee-table {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid #e5e7eb;
    }

        .employee-table th {
            background: #f3f3f3;
            font-size: 12px;
            color: #374151;
            padding: 8px;
            text-align: left;
            border-bottom: 1px solid #e5e7eb;
        }

        .employee-table td {
            padding: 8px;
            border-bottom: 1px solid #e5e7eb;
            font-size: 12px;
        }

        .employee-table input {
            width: 100%;
            height: 28px;
            border: 1px solid #e5e7eb;
            background: #f3f3f3;
            border-radius: 6px;
            padding: 4px 7px;
        }

    .empty-message {
        height: 120px;
        text-align: center;
        color: #475569;
        vertical-align: middle;
    }
</style>

<div class="bulk-page">
    <form method="post" action="@Url.Action("BulkSalaryStructureAssignment", "HR")">
        @Html.AntiForgeryToken()
        @if (TempData["ErpNextError"] != null) { <div class="alert alert-danger">@TempData["ErpNextError"]</div> }
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
        <div class="bulk-header">
            <div class="bulk-title">Bulk Salary Structure Assignment</div>
            <button type="submit" class="assign-btn">Assign Structure</button>
        </div>

        <div class="bulk-card">
            <div class="section">
                <div class="section-title">Set Assignment Details</div>

                <div class="form-grid">
                    <div>
                        <label class="field-label">Salary Structure <span class="required">*</span></label>
                        <select name="SalaryStructure" id="salaryStructure" class="erp-select" required><option value="">Select salary structure</option>@foreach (var x in structures) { <option value="@x">@x</option> }</select>
                    </div>

                    <div>
                        <label class="field-label">Company <span class="required">*</span></label>
                        <select name="Company" id="company" class="erp-select" required><option value="">Select company</option>@foreach (var x in companies) { <option value="@x">@x</option> }</select>
                    </div>

                    <div>
                        <label class="field-label">From Date <span class="required">*</span></label>
                        <input type="date" name="FromDate" id="fromDate" class="erp-input" required />
                    </div>

                    <div>
                        <label class="field-label">Payroll Payable Account</label>
                        <select name="PayrollPayableAccount" class="erp-select"><option value="">Select account</option>@foreach (var x in accounts) { <option value="@x">@x</option> }</select>
                    </div>
                </div>
            </div>

            <div class="section">
                <div class="section-title">Quick Filters <span style="font-size:12px;">^</span></div>

                <div class="form-grid">
                    <div>
                        <label class="field-label">Branch</label>
                        <select name="Branch" id="branch" class="erp-select"><option value="">Select branch</option>@foreach (var x in branches) { <option value="@x">@x</option> }</select>
                    </div>

                    <div>
                        <label class="field-label">Employee Grade</label>
                        <select name="EmployeeGrade" id="employeeGrade" class="erp-select"><option value="">Select grade</option>@foreach (var x in grades) { <option value="@x">@x</option> }</select>
                    </div>

                    <div>
                        <label class="field-label">Department</label>
                        <select name="Department" id="department" class="erp-select"><option value="">Select department</option>@foreach (var x in departments) { <option value="@x">@x</option> }</select>
                    </div>

                    <div>
                        <label class="field-label">Employment Type</label>
                        <select name="EmploymentType" id="employmentType" class="erp-select"><option value="">Select employee type</option>@foreach (var x in employeeTypes) { <option value="@x">@x</option> }</select>
                    </div>

                    <div>
                        <label class="field-label">Designation</label>
                        <select name="Designation" id="designation" class="erp-select"><option value="">Select designation</option>@foreach (var x in designations) { <option value="@x">@x</option> }</select>
                    </div>
                </div>
            </div>

            <div class="section">
                <div class="section-title">Advanced Filters <span style="font-size:12px;">^</span></div>

                <div id="advancedFilters"></div>

                <div class="filter-actions">
                    <button type="button" class="link-btn" onclick="addAdvancedFilter()">+ Add a Filter</button>
                    <button type="button" class="link-btn" onclick="clearAdvancedFilters()">Clear Filters</button>
                </div>
            </div>

            <div class="section">
                <div class="section-title">Select Employees</div>

                <table class="employee-table">
                    <thead>
                        <tr>
                            <th style="width:35px;"><input type="checkbox" id="selectAllEmployees" /></th>
                            <th>Employee</th>
                            <th>Name</th>
                            <th>Grade</th>
                            <th>Base</th>
                            <th>Variable</th>
                        </tr>
                    </thead>
                    <tbody id="employeeRows"></tbody>
                </table>
            </div>
        </div>
    </form>
</div>

<script>
    const employees = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(employees));
    const rows = document.getElementById('employeeRows');
    const esc = value => String(value || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    const value = id => document.getElementById(id).value;
    const same = (left, right) => !right || String(left || '') === right;
    function renderEmployees() {
        const company = value('company'), effectiveFrom = value('fromDate');
        if (!value('salaryStructure') || !company || !effectiveFrom) {
            rows.innerHTML = '<tr><td colspan="6" class="empty-message">Choose Salary Structure, Company, and Effective From to load eligible employees.</td></tr>';
            return;
        }
        const eligible = employees.filter(employee => {
            const joining = employee.DateOfJoining ? new Date(employee.DateOfJoining) : null;
            const relieving = employee.RelievingDate ? new Date(employee.RelievingDate) : null;
            const effective = new Date(effectiveFrom + 'T00:00:00');
            return String(employee.Status || '').toLowerCase() === 'active' && same(employee.Company, company)
                && (!joining || joining <= effective) && (!relieving || relieving >= effective)
                && same(employee.Branch, value('branch')) && same(employee.Grade, value('employeeGrade'))
                && same(employee.Department, value('department')) && same(employee.Designation, value('designation'))
                && same(employee.EmployeeType, value('employmentType'));
        });
        rows.innerHTML = eligible.map(employee => `<tr>
            <td><input class="employee-check" type="checkbox" name="EmployeeIds" value="${esc(employee.Id)}" /></td>
            <td>${esc(employee.Id)}</td><td>${esc(employee.EmployeeName)}</td><td>${esc(employee.Grade || '-')}</td>
            <td><input name="BaseByEmployee[${esc(employee.Id)}]" type="number" step="0.01" /></td><td><input name="VariableByEmployee[${esc(employee.Id)}]" type="number" step="0.01" /></td>
        </tr>`).join('') || '<tr><td colspan="6" class="empty-message">No eligible active employees match the selected details.</td></tr>';
        document.getElementById('selectAllEmployees').checked = false;
    }
    ['salaryStructure','company','fromDate','branch','employeeGrade','department','employmentType','designation'].forEach(id => document.getElementById(id).addEventListener('change', renderEmployees));
    document.getElementById('selectAllEmployees').addEventListener('change', function () { document.querySelectorAll('.employee-check').forEach(box => box.checked = this.checked); });
    renderEmployees();
</script>

<script>
    function addAdvancedFilter() {
        const holder = document.getElementById('advancedFilters');

        if (holder.querySelector('.filter-row')) {
            return;
        }

        const row = document.createElement('div');
        row.className = 'filter-row';
        row.innerHTML = `
            <input type="text" name="FilterField" class="erp-input" value="ID" />
            <select name="FilterCondition" class="erp-select">
                <option selected>Equals</option>
                <option>Not Equals</option>
                <option>Like</option>
                <option>In</option>
            </select>
            <input type="text" name="FilterValue" class="erp-input" />
            <button type="button" class="link-btn" onclick="this.closest('.filter-row').remove()">x</button>
        `;

        holder.appendChild(row);
    }

    function clearAdvancedFilters() {
        document.getElementById('advancedFilters').innerHTML = '';
    }
</script>
