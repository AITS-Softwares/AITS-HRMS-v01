@using Newtonsoft.Json.Linq
@{ViewBag.Title="Accounting Dimension Details";var d=ViewBag.Document as JObject;string V(string k)=>d?[k]?.ToString()??"";bool B(string k)=>d?[k]?.Value<int>()==1;var rows=d?["dimension_defaults"] as JArray??new JArray();}
<style>.p{max-width:1210px;margin:auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.h{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.h h1{margin:0;font-size:22px}.back{color:#fff;text-decoration:none;border:1px solid #7890a8;border-radius:7px;padding:8px 13px}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.s{padding:20px;border-bottom:1px solid #dbe3ec}.g{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.f label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.v{min-height:36px;box-sizing:border-box;width:100%;border:1px solid #b8c7d7;border-radius:8px;padding:8px 10px;background:#f2f6f9;color:#526375}.check{display:flex;gap:8px;align-items:center;padding-top:25px}.table{width:100%;border-collapse:collapse}.table th,.table td{border:1px solid #dbe3ec;padding:9px;text-align:left}.table th{background:#f4f8fc;color:#526375}</style>
<div class="p"><header class="h"><h1>Accounting Dimension Details</h1><a class="back" asp-action="AccountingDimension">Back to Accounting Dimensions</a></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}<main class="card"><section class="s"><div class="g"><div class="f"><label>Reference Document Type</label><div class="v">@V("document_type")</div></div><div class="f"><label>Dimension Name</label><div class="v">@V("label")</div></div><div class="f"><label>Fieldname</label><div class="v">@V("fieldname")</div></div><label class="check"><input type="checkbox" disabled checked="@B("disabled")"/> Disable</label></div></section><section class="s"><h2>Dimension Defaults</h2><table class="table"><thead><tr><th>Company</th><th>Mandatory for Balance Sheet</th><th>Mandatory for Profit and Loss</th></tr></thead><tbody>@if(rows.Any()){foreach(var r in rows){<tr><td>@r["company"]</td><td>@(r["mandatory_for_bs"]?.ToString()=="1"?"Yes":"No")</td><td>@(r["mandatory_for_pl"]?.ToString()=="1"?"Yes":"No")</td></tr>}}else{<tr><td colspan="3">No Dimension Defaults configured.</td></tr>}</tbody></table></section></main></div>
