@using Newtonsoft.Json.Linq
@using System.Collections.Generic
@{ ViewBag.Title = "Accounting Dimension Details"; var d = ViewBag.Document as JObject; string V(string key) => d?[key]?.ToString() ?? ""; bool B(JToken value) => value?.ToString() == "1" || value?.ToString()?.Equals("true", StringComparison.OrdinalIgnoreCase) == true; var rows = d?["dimension_defaults"] as JArray ?? new JArray(); var companies = ViewBag.DimensionCompanies as List<string> ?? new List<string>(); var options = ViewBag.DefaultDimensionOptions as List<string> ?? new List<string>(); }
<style>.p{max-width:1210px;margin:auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.h{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.h h1{margin:0;font-size:22px}.actions{display:flex;gap:12px}.back{color:#fff;text-decoration:none;border:1px solid #7890a8;border-radius:7px;padding:8px 13px}.save{border:0;background:#0f766e;color:#fff;border-radius:7px;padding:8px 15px;font-weight:650}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.s{padding:20px;border-bottom:1px solid #dbe3ec}.g{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.f label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.i{box-sizing:border-box;width:100%;height:36px;border:1px solid #b8c7d7;border-radius:8px;padding:7px 10px;background:#f2f6f9;color:#526375}.check{display:flex;gap:8px;align-items:center;padding-top:25px}.table{width:100%;border-collapse:collapse}.table th,.table td{border:1px solid #dbe3ec;padding:9px;text-align:left}.table th{background:#f4f8fc;color:#526375}.table select{width:100%;height:34px;border:1px solid #b8c7d7;border-radius:6px}.add{margin-top:10px;border:0;background:#dce8f1;border-radius:6px;padding:7px 12px}@@media(max-width:800px){.p{padding:12px}.g{grid-template-columns:1fr}.table{display:block;overflow:auto}}</style>
<div class="p"><form method="post" action="@Url.Action("AccountingDimensionDetails", new { id = V("name") })">@Html.AntiForgeryToken()<header class="h"><h1>Accounting Dimension Details</h1><div class="actions"><a class="back" asp-action="AccountingDimension">Back to Accounting Dimensions</a><button class="save" type="submit">Save</button></div></header>@if(TempData["ErpNextError"] != null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}@if(TempData["Success"] != null){<div class="alert alert-success mt-3">@TempData["Success"]</div>}<main class="card"><section class="s"><div class="g"><div class="f"><label>Reference Document Type</label><input class="i" value="@V("document_type")" readonly/></div><div class="f"><label>Dimension Name</label><input class="i" value="@V("label")" readonly/></div><label class="check"><input name="Disabled" type="checkbox" value="true" checked="@(B(d?["disabled"]) ? "checked" : null)"/> Disable</label></div></section><section class="s"><h2>Dimension Defaults</h2><table class="table"><thead><tr><th>Company</th><th>Default Dimension</th><th>Mandatory for Balance Sheet</th><th>Mandatory for Profit and Loss</th></tr></thead><tbody id="rows">@if(rows.Any()){var index=0;foreach(var row in rows){var defaultDimension=row["default_dimension"]?.ToString()??"";<tr><td><select name="DefaultCompanies"><option value="">Select company</option>@foreach(var company in companies){<option value="@company" selected="@(company==row["company"]?.ToString() ? "selected" : null)">@company</option>}</select></td><td><select name="DefaultDimensions" class="default-dimension"><option value="">Select default dimension</option>@foreach(var option in options){<option value="@option" selected="@(option==defaultDimension ? "selected" : null)">@option</option>}@if(!string.IsNullOrWhiteSpace(defaultDimension) && !options.Contains(defaultDimension)){<option value="@defaultDimension" selected>@defaultDimension</option>}</select></td><td><input name="MandatoryBs[@index]" type="checkbox" value="true" checked="@(B(row["mandatory_for_bs"]) ? "checked" : null)"/></td><td><input name="MandatoryPl[@index]" type="checkbox" value="true" checked="@(B(row["mandatory_for_pl"]) ? "checked" : null)"/></td></tr>index++;}}else{<tr><td><select name="DefaultCompanies"><option value="">Select company</option>@foreach(var company in companies){<option value="@company">@company</option>}</select></td><td><select name="DefaultDimensions" class="default-dimension"><option value="">Select default dimension</option>@foreach(var option in options){<option value="@option">@option</option>}</select></td><td><input name="MandatoryBs[0]" type="checkbox" value="true"/></td><td><input name="MandatoryPl[0]" type="checkbox" value="true"/></td></tr>}</tbody></table><button type="button" class="add" id="add">Add Row</button></section></main></form></div>
<script>(function(){const rows=document.getElementById('rows');function reindex(){[...rows.rows].forEach((row,index)=>{row.querySelector('[name^="MandatoryBs"]').name='MandatoryBs['+index+']';row.querySelector('[name^="MandatoryPl"]').name='MandatoryPl['+index+']';});}document.getElementById('add').addEventListener('click',()=>{const row=rows.rows[0].cloneNode(true);row.querySelector('select[name="DefaultCompanies"]').selectedIndex=0;row.querySelector('.default-dimension').selectedIndex=0;row.querySelectorAll('input').forEach(input=>input.checked=false);rows.appendChild(row);reindex();});})();</script>
