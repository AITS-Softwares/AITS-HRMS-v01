<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Shift Schedule Assignment</h4>
    <div>
        <div class="btn-group me-2">
            <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown">Shift Tools</button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="/HR/ShiftAssignmentTool">Shift Assignment Tool</a></li>
                <li><a class="dropdown-item" href="/HR/ShiftSchedule">Roster</a></li>
            </ul>
        </div>
        <a href="/HR/CreateShiftScheduleAssignment" class="btn btn-dark btn-sm">+ Add Shift Schedule Assignment</a>
    </div>
</div>

<form method="get" action="/HR/ShiftScheduleAssignment" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="id" class="form-control form-control-sm" placeholder="ID" value="@ViewBag.IdFilter" />
    </div>
    <div class="col-auto">
        <input type="text" name="employee" class="form-control form-control-sm" placeholder="Employee" value="@ViewBag.EmployeeFilter" />
    </div>
    <div class="col-auto">
        <input type="text" name="employeeName" class="form-control form-control-sm" placeholder="Employee Name" value="@ViewBag.EmployeeNameFilter" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>Employee</th>
            <th>Shift Schedule</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr style="cursor:pointer" onclick="window.location='/HR/ShiftScheduleAssignmentDetails/@s.Id'">
                <td>@s.Id</td>
                <td>@s.Employee</td>
                <td>@s.ShiftSchedule</td>
                <td>@s.ShiftStatus</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted text-center py-5">No shift schedule assignments found.</p>
} *@














@model List<Erp_Aits.Models.HRShiftScheduleAssignment>
