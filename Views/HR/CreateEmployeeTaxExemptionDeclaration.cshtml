@using Erp_Aits.Models
@{ViewBag.Title="New Employee Tax Exemption Declaration";var employees=ViewBag.TaxEmployees as List<PayrollEmployeeOption>??new List<PayrollEmployeeOption>();var periods=ViewBag.TaxPeriods as List<string>??new List<string>();var currencies=ViewBag.TaxCurrencies as List<string>??new List<string>();var cats=ViewBag.TaxDeclarationCategories as List<string>??new List<string>();var subs=ViewBag.TaxDeclarationSubCategories as List<string>??new List<string>();}
<style>.p{max-width:1210px;margin:auto;padding:26px;background:#eaf0f6;border:1px solid #d4e0eb;border-radius:8px}.h{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:#14253d;border-radius:7px;color:#fff}.h h1{font-size:22px;margin:0}.save{border:0;background:#0f766e;color:#fff;padding:9px 17px;border-radius:7px;font-weight:650}.card{margin-top:18px;background:#fff;border:1px solid #cbd8e5;border-radius:8px;overflow:hidden}.s{padding:20px;border-bottom:1px solid #dbe3ec}.g{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.f label{display:block;font-size:13px;color:#374151;margin-bottom:7px}.i,.sel{box-sizing:border-box;width:100%;height:36px;border:1px solid #b8c7d7;border-radius:8px;padding:7px 10px;background:#fbfdff}.i[readonly]{background:#f2f6f9}.t{width:100%;border-collapse:collapse}.t th,.t td{padding:8px;border:1px solid #dbe3ec}.t select,.t input{width:100%;height:34px;box-sizing:border-box}.add{border:0;background:#dce8f1;border-radius:6px;padding:7px 12px;margin-top:10px}</style>
<div class="p"><form method="post" asp-action="CreateEmployeeTaxExemptionDeclaration">@Html.AntiForgeryToken()<header class="h"><h1>New Employee Tax Exemption Declaration</h1><button class="save">Save</button></header>@if(TempData["ErpNextError"]!=null){<div class="alert alert-danger mt-3">@TempData["ErpNextError"]</div>}<main class="card"><section class="s"><div class="g"><div class="f"><label>Employee *</label><select name="Employee" id="e" class="sel" required><option value="">Select employee</option>@foreach(var x in employees){<option value="@x.Id" data-name="@x.EmployeeName" data-department="@x.Department" data-company="@x.Company">@x.Id</option>}</select></div><div class="f"><label>Employee Name</label><input id="n" class="i" readonly/></div><div class="f"><label>Department</label><input id="d" class="i" readonly/></div><div class="f"><label>Company</label><input id="co" class="i" readonly/></div><div class="f"><label>Payroll Period *</label><select name="PayrollPeriod" class="sel" required><option value="">Select payroll period</option>@foreach(var x in periods){<option value="@x">@x</option>}</select></div><div class="f"><label>Currency *</label><select name="Currency" class="sel" required><option value="">Select currency</option>@foreach(var x in currencies){<option value="@x">@x</option>}</select></div><div class="f"><label>Amended From</label><input class="i" readonly/></div></div></section><section class="s"><h2>Tax Exemption Declaration</h2><table class="t"><thead><tr><th>Tax Exemption Category</th><th>Tax Exemption Sub Category</th><th>Amount</th></tr></thead><tbody id="rows"><tr><td><select name="DeclarationCategories"><option value="">Select category</option>@foreach(var x in cats){<option value="@x">@x</option>}</select></td><td><select name="DeclarationSubCategories"><option value="">Select sub category</option>@foreach(var x in subs){<option value="@x">@x</option>}</select></td><td><input name="DeclarationAmounts" type="number" step="0.01"/></td></tr></tbody></table><button class="add" type="button" id="add">Add Row</button></section><section class="s"><h2>HRA Exemption</h2><div class="g">@foreach(var x in new[]{"Monthly House Rent","Rented in Metro City","HRA as per Salary Structure","Annual HRA Exemption","Monthly HRA Exemption","Total Declared Amount","Total Exemption Amount"}){<div class="f"><label>@x</label><input class="i" readonly/></div>}</div></section></main></form></div><script>e.onchange=()=>{let o=e.options[e.selectedIndex];n.value=o.dataset.name||'';d.value=o.dataset.department||'';co.value=o.dataset.company||''};add.onclick=()=>{let r=rows.children[0].cloneNode(true);r.querySelectorAll('select').forEach(x=>x.selectedIndex=0);r.querySelector('input').value='';rows.append(r)};</script>
