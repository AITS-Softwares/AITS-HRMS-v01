@functions {
    public string GetColor(string name)
    {
        if (string.IsNullOrEmpty(name)) return "#198754";
        var colors = new[] { "#198754", "#4f46e5", "#7c3aed", "#2563eb", "#0891b2", "#d97706", "#dc2626", "#6b7280" };
        var index = Math.Abs(name.GetHashCode()) % colors.Length;
        return colors[index];
    }
}

@section Scripts {
    <script>
        var opportunityId = @(opportunityId ?? 0);
        var users = @Html.Raw(Json.Serialize(ViewBag.UserList));

        $(document).ready(function() {
            if (opportunityId > 0) {
                loadEvents();
                // Set default date for create form
                var now = new Date();
                var formattedDate = now.toISOString().slice(0, 16);
                $('#createEventDate').val(formattedDate);
            }
        });

        // ============================================================
        // LOAD EVENTS
        // ============================================================
        function loadEvents() {
            var eventType = $('#filterEventType').val();
            var status = $('#filterEventStatus').val();
            var search = $('#searchEvent').val();

            $.ajax({
                url: '@Url.Action("GetOpportunityEvents", "OpportunityEvents")',
                type: 'GET',
                data: {
                    opportunityId: opportunityId,
                    eventType: eventType,
                    status: status,
                    search: search
                },
                success: function(data) {
                    var html = '';
                    var total = 0;

                    if (data && data.length > 0) {
                        total = data.length;
                        $('#eventCount').text(total);

                        $.each(data, function(i, event) {
                            var typeClass = event.eventType ? event.eventType.toLowerCase().replace(' ', '-') : 'call';
                            var statusClass = event.status ? event.status.toLowerCase() : 'scheduled';
                            var typeIcon = getEventIcon(event.eventType);

                            html += '<div class="event-card">';
                            html += '<div class="event-info">';
                            html += '<div class="event-title">' + event.summary + '</div>';
                            html += '<div class="event-meta">';
                            html += '<span><span class="event-type-badge ' + typeClass + '"><i class="fas ' + typeIcon + '"></i> ' + (event.eventType || 'N/A') + '</span></span>';
                            html += '<span><i class="fas fa-user"></i> ' + (event.assignedTo || 'Unassigned') + '</span>';
                            html += '<span><i class="fas fa-calendar"></i> ' + event.eventDate + '</span>';
                            html += '<span><span class="event-status-badge ' + statusClass + '">' + (event.status || 'Scheduled') + '</span></span>';
                            if (event.attachmentPath) {
                                html += '<span><a href="' + event.attachmentPath + '" target="_blank" class="text-primary"><i class="fas fa-paperclip"></i> Attachment</a></span>';
                            }
                            html += '</div>';
                            html += '</div>';
                            html += '<div class="event-actions">';
                            html += '<button class="btn btn-warning btn-sm" onclick="openEditEventModal(' + event.id + ')"><i class="fas fa-edit"></i></button>';
                            html += '<button class="btn btn-danger btn-sm" onclick="openDeleteEventModal(' + event.id + ')"><i class="fas fa-trash"></i></button>';
                            html += '</div>';
                            html += '</div>';
                        });

                        $('#eventsList').html(html);
                    } else {
                        $('#eventCount').text(0);
                        $('#eventsList').html('<div class="text-center text-muted py-5"><i class="fas fa-calendar-times fa-3x d-block mb-3"></i><p>No events found for this opportunity.</p></div>');
                    }
                },
                error: function() {
                    $('#eventsList').html('<div class="text-center text-muted py-5"><i class="fas fa-exclamation-triangle fa-3x d-block mb-3"></i><p>Error loading events. Please try again.</p></div>');
                }
            });
        }

        function getEventIcon(type) {
            if (!type) return 'fa-calendar';
            switch(type.toLowerCase()) {
                case 'call': return 'fa-phone';
                case 'email': return 'fa-envelope';
                case 'meeting': return 'fa-handshake';
                case 'demo': return 'fa-laptop';
                case 'follow-up': return 'fa-clock';
                default: return 'fa-calendar';
            }
        }

        function resetFilters() {
            $('#filterEventType').val('');
            $('#filterEventStatus').val('');
            $('#searchEvent').val('');
            loadEvents();
        }

        // ============================================================
        // CREATE EVENT
        // ============================================================
        function openCreateEventModal() {
            if (opportunityId == 0 || opportunityId == null) {
                alert('Please select an opportunity first.');
                return;
            }
            $('#createEventModal').modal('show');
        }

        function submitCreateEvent() {
            var formData = {
                OpportunityId: opportunityId,
                AssignedTo: parseInt($('#createAssignedTo').val()) || null,
                EventDate: $('#createEventDate').val(),
                EventType: $('#createEventType').val(),
                Summary: $('#createSummary').val(),
                Status: $('#createStatus').val()
            };

            if (!formData.Summary) {
                alert('Summary is required.');
                return;
            }

            if (!formData.EventType) {
                alert('Please select an event type.');
                return;
            }

            if (!formData.AssignedTo) {
                alert('Please select a user to assign this event.');
                return;
            }

            $.ajax({
                url: '@Url.Action("Create", "OpportunityEvents")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function(response) {
                    if (response.success) {
                        $('#createEventModal').modal('hide');
                        $('#createSummary').val('');
                        loadEvents();
                        showSuccess('Event created successfully!');
                    } else {
                        alert(response.message || 'Error creating event.');
                    }
                },
                error: function() {
                    alert('Error creating event. Please try again.');
                }
            });
        }

        // ============================================================
        // EDIT EVENT
        // ============================================================
        function openEditEventModal(id) {
            $.ajax({
                url: '@Url.Action("GetEvent", "OpportunityEvents")',
                type: 'GET',
                data: { id: id },
                success: function(response) {
                    if (response.success) {
                        var eventItem = response.eventItem;
                        $('#editEventId').val(eventItem.id);
                        $('#editOpportunityId').val(eventItem.opportunityId);
                        $('#editEventDate').val(eventItem.eventDate);
                        $('#editEventType').val(eventItem.eventType);
                        $('#editSummary').val(eventItem.summary);
                        $('#editAssignedTo').val(eventItem.assignedTo);
                        $('#editStatus').val(eventItem.status);
                        $('#editEventModal').modal('show');
                    } else {
                        alert(response.message || 'Error loading event.');
                    }
                },
                error: function() {
                    alert('Error loading event. Please try again.');
                }
            });
        }

        function submitEditEvent() {
            var formData = {
                Id: parseInt($('#editEventId').val()),
                OpportunityId: parseInt($('#editOpportunityId').val()) || null,
                AssignedTo: parseInt($('#editAssignedTo').val()) || null,
                EventDate: $('#editEventDate').val(),
                EventType: $('#editEventType').val(),
                Summary: $('#editSummary').val(),
                Status: $('#editStatus').val()
            };

            if (!formData.Summary) {
                alert('Summary is required.');
                return;
            }

            if (!formData.EventType) {
                alert('Please select an event type.');
                return;
            }

            if (!formData.AssignedTo) {
                alert('Please select a user to assign this event.');
                return;
            }

            $.ajax({
                url: '@Url.Action("Update", "OpportunityEvents")',
                type: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function(response) {
                    if (response.success) {
                        $('#editEventModal').modal('hide');
                        loadEvents();
                        showSuccess('Event updated successfully!');
                    } else {
                        alert(response.message || 'Error updating event.');
                    }
                },
                error: function() {
                    alert('Error updating event. Please try again.');
                }
            });
        }

        // ============================================================
        // DELETE EVENT
        // ============================================================
        function openDeleteEventModal(id) {
            $('#deleteEventId').val(id);
            $('#deleteEventModal').modal('show');
        }

        function confirmDeleteEvent() {
            var id = $('#deleteEventId').val();

            $.ajax({
                url: '@Url.Action("Delete", "OpportunityEvents")',
                type: 'DELETE',
                data: { id: id },
                success: function(response) {
                    if (response.success) {
                        $('#deleteEventModal').modal('hide');
                        loadEvents();
                        showSuccess('Event deleted successfully!');
                    } else {
                        alert(response.message || 'Error deleting event.');
                    }
                },
                error: function() {
                    alert('Error deleting event. Please try again.');
                }
            });
        }

        // ============================================================
        // SHOW SUCCESS MESSAGE
        // ============================================================
        function showSuccess(message) {
            var alertDiv = $('<div class="alert alert-success alert-dismissible fade show">' +
                '<i class="fas fa-check-circle"></i> ' + message +
                '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                '</div>');
            $('.card-header-custom').after(alertDiv);
            setTimeout(function() {
                alertDiv.fadeOut('slow', function() {
                    $(this).remove();
                });
            }, 5000);
        }

        // Make functions globally accessible
        window.loadEvents = loadEvents;
        window.resetFilters = resetFilters;
        window.openCreateEventModal = openCreateEventModal;
        window.submitCreateEvent = submitCreateEvent;
        window.openEditEventModal = openEditEventModal;
        window.submitEditEvent = submitEditEvent;
        window.openDeleteEventModal = openDeleteEventModal;
        window.confirmDeleteEvent = confirmDeleteEvent;
    </script>
} *@


@using Microsoft.Extensions.Configuration
@using Microsoft.Data.SqlClient
@using System.Collections.Generic
@using System.Data
@inject IConfiguration _configuration

@{
    ViewData["Title"] = "Opportunity Events";
    ViewData["Module"] = "Events";
    ViewData["Icon"] = "calendar-alt";
    var opportunityId = ViewBag.OpportunityId as int?;
    var opportunityName = ViewBag.OpportunityName as string;
    var loginType = Context.Session.GetString("LoginType") ?? "User";
    var userRole = Context.Session.GetString("UserRole") ?? "User";
    var userId = Context.Session.GetString("UserId");
    var isFullAccess = loginType == "Company" || userRole == "Admin";

    // Check specific page access from database
    var canCreateEvent = false;
    var canEditEvent = false;
    var canDeleteEvent = false;

    if (!string.IsNullOrEmpty(userId))
    {
        try
        {
            var connectionString = _configuration.GetConnectionString("DefaultConnection");
            using (var conn = new SqlConnection(connectionString))
            {
                conn.Open();

                // Check Event Create access (PermissionId 40)
                string query = @"
                    SELECT CASE
                        WHEN EXISTS (
                            SELECT 1 FROM UserPermissions
                            WHERE UserId = @UserId
                            AND PermissionId = 40
                            AND CanCreate = 1
                        ) THEN 1
                        WHEN EXISTS (
                            SELECT 1 FROM RolePermissions rp
                            INNER JOIN Users u ON u.Role = rp.RoleName
                            WHERE u.Id = @UserId
                            AND rp.PermissionId = 40
                            AND rp.CanCreate = 1
                        ) THEN 1
                        ELSE 0
                    END AS HasAccess";

                using (var cmd = new SqlCommand(query, conn))
                {
                    cmd.Parameters.AddWithValue("@UserId", int.Parse(userId));
                    var result = cmd.ExecuteScalar();
                    canCreateEvent = result != null && Convert.ToInt32(result) == 1;
                }

                // Check Event Edit access (PermissionId 41)
                query = @"
                    SELECT CASE
                        WHEN EXISTS (
                            SELECT 1 FROM UserPermissions
                            WHERE UserId = @UserId
                            AND PermissionId = 41
                            AND CanEdit = 1
                        ) THEN 1
                        WHEN EXISTS (
                            SELECT 1 FROM RolePermissions rp
                            INNER JOIN Users u ON u.Role = rp.RoleName
                            WHERE u.Id = @UserId
                            AND rp.PermissionId = 41
                            AND rp.CanEdit = 1
                        ) THEN 1
                        ELSE 0
                    END AS HasAccess";

                using (var cmd = new SqlCommand(query, conn))
                {
                    cmd.Parameters.AddWithValue("@UserId", int.Parse(userId));
                    var result = cmd.ExecuteScalar();
                    canEditEvent = result != null && Convert.ToInt32(result) == 1;
                }

                // Check Event Delete access (PermissionId 42)
                query = @"
                    SELECT CASE
                        WHEN EXISTS (
                            SELECT 1 FROM UserPermissions
                            WHERE UserId = @UserId
                            AND PermissionId = 42
                            AND CanDelete = 1
                        ) THEN 1
                        WHEN EXISTS (
                            SELECT 1 FROM RolePermissions rp
                            INNER JOIN Users u ON u.Role = rp.RoleName
                            WHERE u.Id = @UserId
                            AND rp.PermissionId = 42
                            AND rp.CanDelete = 1
                        ) THEN 1
                        ELSE 0
                    END AS HasAccess";

                using (var cmd = new SqlCommand(query, conn))
                {
                    cmd.Parameters.AddWithValue("@UserId", int.Parse(userId));
                    var result = cmd.ExecuteScalar();
                    canDeleteEvent = result != null && Convert.ToInt32(result) == 1;
                }
            }
        }
        catch (Exception ex)
        {
            // Fallback to role-based access
            canCreateEvent = isFullAccess || userRole == "Manager" || userRole == "User";
            canEditEvent = isFullAccess || userRole == "Manager" || userRole == "User";
            canDeleteEvent = isFullAccess;
        }
    }
    else
    {
        canCreateEvent = isFullAccess || userRole == "Manager" || userRole == "User";
        canEditEvent = isFullAccess || userRole == "Manager" || userRole == "User";
        canDeleteEvent = isFullAccess;
    }
}


<div class="content-card">
    <div class="card-header-custom">
        <h5>
            <i class="fas fa-calendar-alt"></i>
            @if (!string.IsNullOrEmpty(opportunityName))
            {
                <span>Events for: @opportunityName</span>
            }
            else
            {
                <span>Opportunity Events</span>
            }
            <span class="badge-count success" id="eventCount">0</span>
        </h5>
        <div class="d-flex gap-2">
            <a asp-controller="Opportunities" asp-action="Index" class="btn btn-secondary btn-sm">
                <i class="fas fa-list"></i> All Opportunities
            </a>
            @if (opportunityId > 0)
            {
                @if (canCreateEvent)
                {
                    <button type="button" class="btn btn-success btn-sm" onclick="openCreateEventModal()">
                        <i class="fas fa-plus"></i> Add Event
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-success btn-sm disabled" title="Add Event (Permission Denied)" disabled>
                        <i class="fas fa-plus"></i> Add Event
                    </button>
                }
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (opportunityId > 0)
    {
        <!-- Quick Links -->
        <div class="quick-links mb-3">
            <div class="btn-group" role="group">
                <a asp-controller="OpportunityTasks" asp-action="Index" asp-route-opportunityId="@opportunityId" class="btn btn-outline-primary btn-sm">
                    <i class="fas fa-tasks"></i> Tasks
                </a>
                <a asp-controller="OpportunityEvents" asp-action="Index" asp-route-opportunityId="@opportunityId" class="btn btn-success btn-sm active">
                    <i class="fas fa-calendar-alt"></i> Events
                </a>
                <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@opportunityId" class="btn btn-outline-info btn-sm">
                    <i class="fas fa-eye"></i> Opportunity Details
                </a>
            </div>
            <span class="text-muted small ms-3">Opportunity ID: #@opportunityId</span>
        </div>

        <!-- Search / Filter -->
        <div class="search-filter-bar">
            <div class="row g-2">
                <div class="col-md-3">
                    <select id="filterEventType" class="form-control" onchange="loadEvents()">
                        <option value="">All Types</option>
                        <option value="Call">Call</option>
                        <option value="Email">Email</option>
                        <option value="Meeting">Meeting</option>
                        <option value="Demo">Demo</option>
                        <option value="Follow-up">Follow-up</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select id="filterEventStatus" class="form-control" onchange="loadEvents()">
                        <option value="">All Status</option>
                        <option value="Scheduled">Scheduled</option>
                        <option value="Completed">Completed</option>
                        <option value="Cancelled">Cancelled</option>
                        <option value="Postponed">Postponed</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <div class="input-group">
                        <input type="text" id="searchEvent" class="form-control" placeholder="Search events..." />
                        <button class="btn btn-success btn-sm" onclick="loadEvents()">
                            <i class="fas fa-search"></i> Search
                        </button>
                        <button class="btn btn-secondary btn-sm" onclick="resetFilters()">
                            <i class="fas fa-undo"></i> Reset
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Event List -->
        <div id="eventsList">
            <div class="text-center text-muted py-5">
                <i class="fas fa-spinner fa-spin fa-2x"></i>
                <p class="mt-2">Loading events...</p>
            </div>
        </div>
    }
    else
    {
        <!-- Show All Opportunities with Events -->
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i>
            <strong>Select an Opportunity:</strong> Please select an opportunity from the list below to view its events.
        </div>

        <div class="row">
            <div class="col-md-8">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Company</th>
                                <th>Opportunity From</th>
                                <th>Stage</th>
                                <th>Events</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.Opportunities != null)
                            {
                                foreach (var opp in ViewBag.Opportunities)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm me-2" style="background: @GetColor(opp.Text);">
                                                    @opp.Text?.Substring(0, 1)
                                                </div>
                                                <div>
                                                    <div class="fw-semibold">@opp.Text</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@opp.OpportunityFrom</td>
                                        <td>
                                            <span class="badge bg-@(opp.Stage?.ToLower()?.Contains("prospecting") == true ? "primary" :
                                                                                                                                                                                                                       opp.Stage?.ToLower()?.Contains("qualification") == true ? "info" :
                                                                                                                                                                                                                       opp.Stage?.ToLower()?.Contains("negotiation") == true ? "warning" :
                                                                                                                                                                                                                       opp.Stage?.ToLower()?.Contains("closed won") == true ? "success" :
                                                                                                                                                                                                                       opp.Stage?.ToLower()?.Contains("closed lost") == true ? "danger" : "secondary")">
                                    @opp.Stage
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-success">@opp.EventCount</span>
                            </td>
                            <td>
                                <a asp-action="Index" asp-route-opportunityId="@opp.Value" class="btn btn-success btn-sm">
                                    <i class="fas fa-calendar-alt"></i> View Events
                                </a>
                            </td>
                        </tr>
                                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col-md-4">
                <div class="content-card">
                    <h6 class="fw-bold mb-3">
                        <i class="fas fa-chart-simple"></i> Quick Stats
                    </h6>
                    <hr />
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted">Total Opportunities:</span>
                        <strong>@(ViewBag.Opportunities != null ? ViewBag.Opportunities.Count : 0)</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted">Total Events:</span>
                        <strong id="totalAllEvents">0</strong>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Create Event Modal -->
<div class="modal fade" id="createEventModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px; border: none; box-shadow: 0 20px 60px rgba(0,0,0,0.15);">
            <div class="modal-header border-0" style="padding: 20px 24px 0;">
                <h5 class="modal-title">
                    <i class="fas fa-plus-circle text-success"></i> Create Event
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding: 20px 24px;">
                <form id="createEventForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="OpportunityId" value="@opportunityId" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label required">Event Date</label>
                                <input type="datetime-local" name="EventDate" id="createEventDate" class="form-control" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label required">Assigned To</label>
                                <select name="AssignedTo" id="createAssignedTo" class="form-control" required>
                                    <option value="">Select User</option>
                                    @if (ViewBag.UserList != null)
                                    {
                                        foreach (var user in ViewBag.UserList)
                                        {
                                            <option value="@user.Id">@user.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label required">Event Type</label>
                                <select name="EventType" id="createEventType" class="form-control" required>
                                    <option value="">Select Type</option>
                                    <option value="Call">Call</option>
                                    <option value="Email">Email</option>
                                    <option value="Meeting">Meeting</option>
                                    <option value="Demo">Demo</option>
                                    <option value="Follow-up">Follow-up</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label">Status</label>
                                <select name="Status" id="createStatus" class="form-control">
                                    <option value="Scheduled">Scheduled</option>
                                    <option value="Completed">Completed</option>
                                    <option value="Cancelled">Cancelled</option>
                                    <option value="Postponed">Postponed</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group mb-3">
                                <label class="form-label required">Summary</label>
                                <textarea name="Summary" id="createSummary" class="form-control" rows="3" placeholder="Enter event summary" required></textarea>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0" style="padding: 0 24px 24px;">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancel
                </button>
                @if (canCreateEvent)
                {
                    <button type="button" class="btn btn-success btn-sm" onclick="submitCreateEvent()">
                        <i class="fas fa-save"></i> Create Event
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-success btn-sm disabled" title="Create Event (Permission Denied)" disabled>
                        <i class="fas fa-save"></i> Create Event
                    </button>
                }
            </div>
        </div>
    </div>
</div>

