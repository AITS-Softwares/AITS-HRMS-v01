@model Erp_Aits.Models.Campaign
@{
    ViewData["Title"] = "Delete Campaign";
    ViewData["Module"] = "CRM";
    ViewData["Icon"] = "trash";
}

<div class="content-card">
    <div class="card-header-custom">
        <h5>
            <i class="fas fa-trash text-danger"></i>
            Delete Campaign
        </h5>
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="alert alert-danger">
        <i class="fas fa-exclamation-triangle"></i>
        <strong>Warning!</strong> Are you sure you want to delete this campaign? This action cannot be undone.
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="detail-section">
                <div class="detail-header">
                    <i class="fas fa-info-circle text-primary"></i>
                    <h6>Campaign Information</h6>
                </div>
                <div class="detail-body">
                    <div class="detail-row">
                        <span class="detail-label">Campaign Name</span>
                        <span class="detail-value"><strong>@Model.CampaignName</strong></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Channel</span>
                        <span class="detail-value">
                            @if (Model.CampaignChannel == "email")
                            {
                                <span class="badge bg-info"><i class="fas fa-envelope"></i> Email</span>
                            }
                            else if (Model.CampaignChannel == "whatsapp")
                            {
                                <span class="badge bg-success"><i class="fab fa-whatsapp"></i> WhatsApp</span>
                            }
                            else if (Model.CampaignChannel == "both")
                            {
                                <span class="badge bg-primary"><i class="fas fa-envelope"></i> <i class="fab fa-whatsapp"></i> Both</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@Model.CampaignChannel</span>
                            }
                        </span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Scheduled Time</span>
                        <span class="detail-value">
                            @{
                                var scheduledTime = Model.ScheduledTime.HasValue
                                ? Model.ScheduledTime.Value.ToString("dd MMM yyyy HH:mm")
                                : "N/A";
                            }
                            @scheduledTime
                        </span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Status</span>
                        <span class="detail-value">
                            <span class="badge bg-@Model.StatusBadge">@Model.Status</span>
                        </span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Sender</span>
                        <span class="detail-value">@Model.Sender</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Created Date</span>
                        <span class="detail-value">
                            @{
                                var createdDate = Model.CreatedDate.HasValue
                                ? Model.CreatedDate.Value.ToString("dd MMM yyyy HH:mm")
                                : "N/A";
                            }
                            @createdDate
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="detail-section">
                <div class="detail-header">
                    <i class="fas fa-users text-info"></i>
                    <h6>Recipient Information</h6>
                </div>
                <div class="detail-body">
                    <div class="detail-row">
                        <span class="detail-label">Recipient Source</span>
                        <span class="detail-value">@Model.RecipientSource</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Recipients</span>
                        <span class="detail-value">@Model.RecipientCount</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Opens</span>
                        <span class="detail-value">@Model.OpenCount</span>
                    </div>
                </div>
            </div>

            <div class="detail-section">
                <div class="detail-header">
                    <i class="fas fa-clock text-info"></i>
                    <h6>System Information</h6>
                </div>
                <div class="detail-body">
                    <div class="detail-row">
                        <span class="detail-label">Created By</span>
                        <span class="detail-value">@(Model.CreatedBy?.ToString() ?? "System")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Is Active</span>
                        <span class="detail-value">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">No</span>
                            }
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="mt-4">
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash"></i> Confirm Delete
            </button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

<style>
    .detail-section {
        background: white;
        border-radius: 12px;
        margin-bottom: 16px;
        border: 1px solid #f0f2f5;
        overflow: hidden;
    }

    .detail-header {
        padding: 12px 16px;
        background: #fafbfc;
        border-bottom: 1px solid #f0f2f5;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .detail-header h6 {
            margin: 0;
            font-weight: 600;
            font-size: 14px;
            color: #1a1a2e;
        }

    .detail-body {
        padding: 12px 16px;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 6px 0;
        border-bottom: 1px solid #f8f9fa;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        font-size: 13px;
        color: #94a3b8;
        font-weight: 500;
    }

    .detail-value {
        font-size: 13px;
        color: #1a1a2e;
        font-weight: 500;
        text-align: right;
    }

    .badge {
        font-size: 12px;
        padding: 4px 10px;
    }

    .alert {
        border-radius: 12px;
    }

    .content-card {
        background: white;
        border-radius: 16px;
        padding: 24px;
        border: 1px solid #f0f2f5;
    }

    .card-header-custom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 16px;
        border-bottom: 2px solid #f4f6f9;
        flex-wrap: wrap;
        gap: 10px;
    }

        .card-header-custom h5 {
            margin: 0;
            font-weight: 600;
            color: #2c3e50;
            font-size: 18px;
        }
</style>