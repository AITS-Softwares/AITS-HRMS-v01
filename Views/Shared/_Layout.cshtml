<body>
    <!-- SIDEBAR -->
    <div class="sidebar">
        <!-- Brand -->
        <div class="sidebar-brand">
            <div class="brand-icon"><i class="fas fa-chart-line"></i></div>
            <div class="brand-text">CRM<span>System</span></div>
        </div>

        <!-- Dynamic Menu -->
        <div class="sidebar-menu-wrapper">
            <ul class="sidebar-menu">
                @{
                    var userId = Context.Session.GetString("UserId");
                    var loginType = Context.Session.GetString("LoginType") ?? "User";
                    var userRole = Context.Session.GetString("UserRole") ?? "User";
                    var userName = Context.Session.GetString("UserName") ?? "User";
                    var companyName = Context.Session.GetString("CompanyName") ?? "";

                    var menuItems = new Dictionary<string, List<dynamic>>();
                    var isFullAccess = loginType == "Company" || userRole == "Admin";
                    var connectionString = _configuration.GetConnectionString("DefaultConnection");

                    if (!string.IsNullOrEmpty(userId) || loginType == "Company")
                    {
                        try
                        {
                            using (var conn = new SqlConnection(connectionString))
                            {
                                conn.Open();
                                string query = "";

                                if (isFullAccess)
                                {
                                    // Company or Admin - show ALL pages from database
                                    query = @"
                                SELECT
                                Id,
                                ControllerName,
                                ActionName,
                                DisplayName,
                                Icon,
                                MenuOrder,
                                ParentMenu
                                FROM Permissions
                                WHERE IsActive = 1
                                AND MenuOrder IS NOT NULL
                                AND ParentMenu != 'Administration'  -- Exclude Administration from dynamic menu
                                ORDER BY MenuOrder";

                                    using (var cmd = new SqlCommand(query, conn))
                                    {
                                        using (var reader = cmd.ExecuteReader())
                                        {
                                            while (reader.Read())
                                            {
                                                var permission = new
                                                {
                                                    Id = Convert.ToInt32(reader["Id"]),
                                                    ControllerName = reader["ControllerName"]?.ToString() ?? "",
                                                    ActionName = reader["ActionName"]?.ToString() ?? "",
                                                    DisplayName = reader["DisplayName"]?.ToString() ?? "",
                                                    Icon = reader["Icon"]?.ToString() ?? "",
                                                    MenuOrder = reader["MenuOrder"] != DBNull.Value ? Convert.ToInt32(reader["MenuOrder"]) : (int?)null,
                                                    ParentMenu = reader["ParentMenu"]?.ToString() ?? ""
                                                };

                                                var parentMenu = permission.ParentMenu ?? "Main";

                                                if (!menuItems.ContainsKey(parentMenu))
                                                {
                                                    menuItems[parentMenu] = new List<dynamic>();
                                                }
                                                menuItems[parentMenu].Add(permission);
                                            }
                                        }
                                    }
                                }
                                else if (!string.IsNullOrEmpty(userId))
                                {
                                    // Regular user - show only assigned pages
                                    query = @"
                                SELECT
                                p.Id,
                                p.ControllerName,
                                p.ActionName,
                                p.DisplayName,
                                p.Icon,
                                p.MenuOrder,
                                p.ParentMenu
                                FROM Permissions p
                                INNER JOIN UserPermissions up ON p.Id = up.PermissionId
                                WHERE up.UserId = @UserId
                                AND up.CanView = 1
                                AND p.IsActive = 1
                                AND p.MenuOrder IS NOT NULL
                                AND p.ParentMenu != 'Administration'  -- Exclude Administration
                                ORDER BY p.MenuOrder";

                                    using (var cmd = new SqlCommand(query, conn))
                                    {
                                        cmd.Parameters.AddWithValue("@UserId", int.Parse(userId));
                                        using (var reader = cmd.ExecuteReader())
                                        {
                                            while (reader.Read())
                                            {
                                                var permission = new
                                                {
                                                    Id = Convert.ToInt32(reader["Id"]),
                                                    ControllerName = reader["ControllerName"]?.ToString() ?? "",
                                                    ActionName = reader["ActionName"]?.ToString() ?? "",
                                                    DisplayName = reader["DisplayName"]?.ToString() ?? "",
                                                    Icon = reader["Icon"]?.ToString() ?? "",
                                                    MenuOrder = reader["MenuOrder"] != DBNull.Value ? Convert.ToInt32(reader["MenuOrder"]) : (int?)null,
                                                    ParentMenu = reader["ParentMenu"]?.ToString() ?? ""
                                                };

                                                var parentMenu = permission.ParentMenu ?? "Main";

                                                if (!menuItems.ContainsKey(parentMenu))
                                                {
                                                    menuItems[parentMenu] = new List<dynamic>();
                                                }
                                                menuItems[parentMenu].Add(permission);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        catch (Exception ex)
                        {
                            // Log error
                        }
                    }

                    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

                    var mainItems = menuItems.Where(kvp => string.IsNullOrEmpty(kvp.Key) || kvp.Key == "Main").SelectMany(kvp => kvp.Value).ToList();
                    var groupedItems = menuItems.Where(kvp => !string.IsNullOrEmpty(kvp.Key) && kvp.Key != "Main").ToList();
                }

                @if (mainItems.Any())
                {
                    <li class="menu-label">Main</li>
                    @foreach (var item in mainItems.OrderBy(m => m.MenuOrder))
                    {
                        var isActive = currentController == item.ControllerName && currentAction == item.ActionName;
                        <li class="@(isActive ? "active" : "")">
                            <a asp-controller="@item.ControllerName" asp-action="@item.ActionName">
                                <i class="fas fa-@(item.Icon ?? "file")"></i>
                                <span>@item.DisplayName</span>
                            </a>
                        </li>
                    }
                }

                @if (groupedItems.Any())
                {
                    @foreach (var group in groupedItems.OrderBy(g => g.Key))
                    {
                        <li class="menu-label">@group.Key</li>
                        @foreach (var item in group.Value.OrderBy(m => m.MenuOrder))
                        {
                            var isActive = currentController == item.ControllerName && currentAction == item.ActionName;
                            <li class="@(isActive ? "active" : "")">
                                <a asp-controller="@item.ControllerName" asp-action="@item.ActionName">
                                    <i class="fas fa-@(item.Icon ?? "file")"></i>
                                    <span>@item.DisplayName</span>
                                </a>
                            </li>
                        }
                    }
                }

                <!-- ============================================
                ADMINISTRATION SECTION - HARDCODED (ONLY ONCE)
                ============================================ -->
                @if (isFullAccess)
                {
                    <li class="menu-label">Administration</li>

                    <!-- Users Menu -->
                    <li class="@(currentController == "Users" ? "active" : "")">
                        <a asp-controller="Users" asp-action="Index">
                            <i class="fas fa-users-gear"></i>
                            <span>Users</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="CommunicationSettings" asp-action="Index">
                            <i class="fas fa-cog"></i> <span>Communication Settings</span>
                        </a>
                    </li>

                    var isHrActive = currentController == "HR";
                    <li class="has-submenu @(isHrActive ? "active open" : "")">
                        <div>
                            <a asp-controller="HR" asp-action="Index" class="flex-grow-1 @(isHrActive && string.IsNullOrEmpty(currentAction) ? "active" : "")" style="flex:1;">
                                <i class="fas fa-users"></i>
                                <span>HR</span>
                            </a>
                            <a href="#hrSubmenu" data-bs-toggle="collapse" role="button"
                               aria-expanded="@(isHrActive ? "true" : "false")" aria-controls="hrSubmenu"
                               class="submenu-toggle">
                                <i class="fas fa-chevron-right submenu-arrow"></i>
                            </a>
                        </div>
                        <ul class="collapse submenu @(isHrActive ? "show" : "")" id="hrSubmenu">
                            <li>
                                <a asp-controller="HR"
                                   asp-action="Recruitment"
                                   class="@(currentAction == "Recruitment" ? "active" : "")">
                                    Recruitment
                                </a>
                            </li>

                            <li>
                                <a asp-controller="HR"
                                   asp-action="EmployeeLifecycle"
                                   class="@(currentAction == "EmployeeLifecycle" ? "active" : "")">
                                    Employee Lifecycle
                                </a>
                            </li>

                            <li>
                                <a asp-controller="HR"
                                   asp-action="Performance"
                                   class="@(currentAction == "Performance" ? "active" : "")">
                                    Performance
                                </a>
                            </li>

                            <li>
                                <a asp-controller="HR"
                                   asp-action="ShiftAndAttendance"
                                   class="@(currentAction == "ShiftAndAttendance" ? "active" : "")">
                                    Shift &amp; Attendance
                                </a>
                            </li>

                            <li>
                                <a asp-controller="HR"
                                   asp-action="ExpenseClaims"
                                   class="@((currentAction == "ExpenseClaims" || currentAction == "ExpenseClaimList") ? "active" : "")">
                                    Expense Claims
                                </a>
                            </li>

                            <li>
                                <a asp-controller="HR"
                                   asp-action="Leaves"
                                   class="@(currentAction == "Leaves" ? "active" : "")">
                                    Leaves
                                </a>
                            </li>

                            <li>
                                <a asp-controller="HR"
                                   asp-action="Payroll"
                                   class="@(currentAction == "Payroll" || currentAction == "SalaryPayout" || currentAction == "TaxBenefits" ? "active" : "")">
                                    Payroll
                                </a>
                            </li>

                            @if (currentAction == "Payroll" || currentAction == "SalaryPayout" || currentAction == "TaxBenefits")
                            {
                                <li class="ms-3">
                                    <a asp-controller="HR"
                                       asp-action="SalaryPayout"
                                       class="@(currentAction == "SalaryPayout" ? "active" : "")">
                                        Salary Payout
                                    </a>
                                </li>

                                <li class="ms-3">
                                    <a asp-controller="HR"
                                       asp-action="TaxBenefits"
                                       class="@(currentAction == "TaxBenefits" ? "active" : "")">
                                        Tax &amp; Benefits
                                    </a>
                                </li>
                            }

                            <li>
                                <a asp-controller="HR"
                                   asp-action="SmartATS"
                                   class="@(currentAction == "SmartATS" ? "active" : "")">
                                    Smart ATS
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- Permissions Menu - Page Access -->
                    <li class="@(currentController == "Permissions" ? "active" : "")">
                        <a asp-controller="Permissions" asp-action="Index">
                            <i class="fas fa-lock"></i>
                            <span>Page Access</span>
                        </a>
                    </li>
                }
                <!-- Logout always visible -->
                <li class="menu-label">Settings</li>
                <li>
                    <a asp-controller="Account" asp-action="Logout">
                        <i class="fas fa-right-from-bracket"></i>
                        <span>Logout</span>
                    </a>
                </li>
            </ul>
        </div>

        <!-- Footer - User Profile -->
        <div class="sidebar-footer">
            @{
                var displayName = loginType == "Company" ? companyName : userName;
                var displayRole = loginType == "Company" ? "Company Admin" : userRole;
                var initial = string.IsNullOrEmpty(displayName) ? "U" : displayName.Substring(0, 1).ToUpper();
                var roleClass = loginType == "Company" ? "company" : (userRole == "Admin" ? "admin" : "user");
            }
            <div class="avatar">@initial</div>
            <div class="user-details">
                <div class="user-name">@displayName</div>
                <div class="user-role">
                    <span class="login-type-badge @roleClass">@displayRole</span>
                </div>
            </div>
            <a asp-controller="Account" asp-action="Logout" class="logout-btn" title="Logout">
                <i class="fas fa-sign-out-alt"></i>
            </a>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="main-content">
        <!-- Top Navbar -->
        <div class="top-navbar">
            <div class="page-title">
                <i class="fas fa-@(ViewData["Icon"]?.ToString() ?? "house")"></i>
                <div class="title-text">
                    @ViewData["Title"]
                    <small>@ViewData["Module"]</small>
                </div>
            </div>
            <div class="user-info">
                <button class="notification-btn" title="Notifications">
                    <i class="fas fa-bell"></i>
                    <span class="badge-dot"></span>
                </button>
                <div class="user-profile">
                    <div class="avatar">@initial</div>
                    <div class="user-details">
                        <div class="name">@displayName</div>
                        <div class="role">@displayRole</div>
                    </div>
                    <i class="fas fa-chevron-down chevron"></i>
                </div>
            </div>
        </div>

        <!-- Page Content -->
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Modal Containers -->
    <div id="createTaskModalContainer"></div>
    <div id="createEventModalContainer"></div>

    <style>
        .portal-dropdown-menu {
            position: fixed !important;
            z-index: 2147483000 !important;
            max-height: 250px !important;
            overflow-y: auto !important;
            overflow-x: hidden !important;
            background: #ffffff !important;
            border: 1px solid #93a4b8 !important;
            border-radius: 5px !important;
            box-shadow: 0 8px 18px rgba(15, 35, 56, .20) !important;
        }
    </style>
    <script>
        (function () {
            const selector = '.smart-select__menu, .search-menu, .search-select-menu, .sm';
            function position(menu) {
                const input = menu._sourceInput;
                if (!input || !document.contains(input)) return;
                const rect = input.getBoundingClientRect();
                menu.style.left = rect.left + 'px';
                menu.style.top = (rect.bottom + 4) + 'px';
                menu.style.width = rect.width + 'px';
            }
            function portal(menu) {
                if (menu.dataset.portalDropdown === 'true') return;
                const sourceInput = menu.parentElement && menu.parentElement.querySelector('input');
                if (!sourceInput) return;
                menu.dataset.portalDropdown = 'true';
                menu.classList.add('portal-dropdown-menu');
                menu._sourceInput = sourceInput;
                document.body.appendChild(menu);
                position(menu);
            }
            function scan(root) {
                if (root instanceof Element && root.matches(selector)) portal(root);
                root.querySelectorAll?.(selector).forEach(portal);
            }
            scan(document);
            new MutationObserver(records => records.forEach(record => record.addedNodes.forEach(node => {
                if (node instanceof Element) scan(node);
            }))).observe(document.body, { childList: true, subtree: true });
            const reposition = () => document.querySelectorAll('[data-portal-dropdown="true"]').forEach(position);
            window.addEventListener('scroll', reposition, true);
            window.addEventListener('resize', reposition);
        })();
    </script>
</body>
</html>
