@section Scripts {
    <script>
        $(document).ready(function() {
            // Load stats
            $.ajax({
                url: '@Url.Action("GetStats", "Leads")',
                type: 'GET',
                success: function(data) {
                    if (data) {
                        $('#totalLeads').text(data.totalLeads || 0);
                        $('#newLeads').text(data.newLeads || 0);
                        $('#qualifiedLeads').text(data.qualifiedLeads || 0);
                        $('#convertedLeads').text(data.convertedLeads || 0);
                    }
                },
                error: function(xhr, status, error) {
                    console.log("Error loading stats:", error);
                    $('#totalLeads').text('0');
                    $('#newLeads').text('0');
                    $('#qualifiedLeads').text('0');
                    $('#convertedLeads').text('0');
                }
            });

            // Auto-hide alerts
            setTimeout(function() {
                $('.alert').fadeOut('slow');
            }, 5000);
        });
    </script>
}