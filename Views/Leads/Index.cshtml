@* @model Erp_Aits.Models.LeadViewModel
@{
    ViewData["Title"] = "Leads";
    ViewData["Module"] = "CRM";
    ViewData["Icon"] = "users";
    var leads = ViewBag.Leads as List<Erp_Aits.Models.Lead>;
    var search = ViewBag.SearchModel as Erp_Aits.Models.LeadSearchModel;
}


<div class="content-card">
    <div class="card-header-custom">
        <h5><i class="fas fa-list"></i> Lead List</h5>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus"></i> Add Lead
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search / Filter -->
    <form asp-action="Index" method="get" class="row g-3 mb-4">
        <div class="col-md-3">
            <input type="text" name="SearchTerm" class="form-control" placeholder="Search leads..." value="@search?.SearchTerm" />
        </div>
        <div class="col-md-2">
            <select name="Status" class="form-control">
                <option value="">All Status</option>
                @if (Model.StatusList != null)
                {
                    @foreach (var status in Model.StatusList)
                    {
                        <option value="@status" selected="@(search?.Status == status)">@status</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="Source" class="form-control">
                <option value="">All Sources</option>
                @if (Model.SourceList != null)
                {
                    @foreach (var source in Model.SourceList)
                    {
                        <option value="@source" selected="@(search?.Source == source)">@source</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="LeadType" class="form-control">
                <option value="">All Types</option>
                @if (Model.LeadTypeList != null)
                {
                    @foreach (var type in Model.LeadTypeList)
                    {
                        <option value="@type" selected="@(search?.LeadType == type)">@type</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Search</button>
            <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-undo"></i> Reset</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Organization</th>
                    <th>Email</th>
                    <th>Mobile</th>
                    <th>Source</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th style="min-width: 250px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (leads != null && leads.Any())
                {
                    @foreach (var item in leads)
                    {
                        <tr>
                            <td>@item.FullName</td>
                            <td>@item.OrganizationName</td>
                            <td>@item.Email</td>
                            <td>@item.MobileNo</td>
                            <td>@item.Source</td>
                            <td>
                                <span class="badge bg-@(item.Status == "New" ? "primary" :
                                                                                                                                   item.Status == "Open" ? "info" :
                                                                                                                                   item.Status == "Interested" ? "warning" :
                                                                                                                                   item.Status == "Qualified" ? "success" :
                                                                                                                                   item.Status == "Converted" ? "success" :
                                                                                                                                   item.Status == "Lost" ? "danger" : "secondary")">
                            @item.Status
                        </span>
                    </td>
                    <td>@item.CreatedDate.ToString("dd MMM yyyy")</td>
                    <td>
                        <div class="btn-group btn-group-sm" role="group">
                            <!-- View Button -->
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info" title="View">
                                <i class="fas fa-eye"></i>
                            </a>

                                    <!-- Edit Button -->
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>

                                    <!-- Copy to Opportunity Button -->
                                    <a asp-controller="Leads" asp-action="CopyToOpportunity" asp-route-id="@item.Id"
                                       class="btn btn-success" title="Copy to Opportunity">
                                        <i class="fas fa-copy"></i>
                                    </a>

                                    <!-- Create Customer Button -->
                                    <a asp-controller="Customers" asp-action="Create" asp-route-leadId="@item.Id"
                                       class="btn btn-customer" title="Create Customer from Lead">
                                        <i class="fas fa-user-plus"></i>
                                    </a>

                                    <!-- Delete Button -->
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>
                            </td>
