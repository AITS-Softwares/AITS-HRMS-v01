<!-- ============================================
MODAL CONTAINERS
============================================ -->
<div id="createTaskModalContainer"></div>
<div id="createEventModalContainer"></div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Load tasks and events on page load
            var leadId = @Model.Id;
            loadTasks(leadId);
            loadEvents(leadId);
        });

        // ============================================
        // TASK FUNCTIONS
        // ============================================
        function openCreateTaskModal(leadId) {
            $.ajax({
                url: '@Url.Action("CreateTaskModal", "Tasks")',
                type: 'GET',
                data: { leadId: leadId },
                success: function(data) {
                    $('#createTaskModalContainer').html(data);
                    $('#createTaskModal').modal('show');
                },
                error: function() {
                    alert('Error loading task form.');
                }
            });
        }

        function loadTasks(leadId) {
            $.ajax({
                url: '@Url.Action("GetTasks", "Tasks")',
                type: 'GET',
                data: { leadId: leadId },
                success: function(data) {
                    var html = '';
                    if (data && data.length > 0) {
                        html += '<div class="table-responsive">';
                        html += '<table class="table table-hover">';
                        html += '<thead><tr><th>Assigned To</th><th>Date</th><th>Summary</th><th>Status</th><th>Priority</th></tr></thead>';
                        html += '<tbody>';
                        $.each(data, function(i, task) {
                            var statusColor = task.status == 'Completed' ? 'success' :
                                             task.status == 'In Progress' ? 'warning' :
                                             task.status == 'Cancelled' ? 'danger' : 'secondary';
                            var priorityColor = task.priority == 'Urgent' ? 'danger' :
                                               task.priority == 'High' ? 'warning' :
                                               task.priority == 'Low' ? 'secondary' : 'info';
                            html += '<tr>';
                            html += '<td>' + task.assignedTo + '</td>';
                            html += '<td>' + task.taskDate + '</td>';
                            html += '<td>' + task.summary + '</td>';
                            html += '<td><span class="badge bg-' + statusColor + '">' + task.status + '</span></td>';
                            html += '<td><span class="badge bg-' + priorityColor + '">' + (task.priority || 'N/A') + '</span></td>';
                            html += '</tr>';
                        });
                        html += '</tbody></table></div>';
                    } else {
                        html = '<div class="text-center text-muted py-3"><i class="fas fa-inbox fa-2x d-block mb-2"></i>No tasks found.</div>';
                    }
                    $('#tasksList').html(html);
                },
                error: function() {
                    $('#tasksList').html('<div class="text-center text-muted py-3">Error loading tasks.</div>');
                }
            });
        }

        // ============================================
        // EVENT FUNCTIONS
        // ============================================
        function openCreateEventModal(leadId) {
            $.ajax({
                url: '@Url.Action("CreateEventModal", "Events")',
                type: 'GET',
                data: { leadId: leadId },
                success: function(data) {
                    $('#createEventModalContainer').html(data);
                    $('#createEventModal').modal('show');
                },
                error: function() {
                    alert('Error loading event form.');
                }
            });
        }

        function loadEvents(leadId) {
            $.ajax({
                url: '@Url.Action("GetEvents", "Events")',
                type: 'GET',
                data: { leadId: leadId },
                success: function(data) {
                    var html = '';
                    if (data && data.length > 0) {
                        html += '<div class="table-responsive">';
                        html += '<table class="table table-hover">';
                        html += '<thead><tr><th>Type</th><th>Assigned To</th><th>Date</th><th>Summary</th><th>Status</th></tr></thead>';
                        html += '<tbody>';
                        $.each(data, function(i, event) {
                            var typeIcon = event.eventType == 'Call' ? 'fa-phone' :
                                          event.eventType == 'Email' ? 'fa-envelope' :
                                          event.eventType == 'Meeting' ? 'fa-handshake' :
                                          event.eventType == 'Demo' ? 'fa-laptop' : 'fa-calendar';
                            var statusColor = event.status == 'Completed' ? 'success' :
                                             event.status == 'Cancelled' ? 'danger' :
                                             event.status == 'Postponed' ? 'warning' : 'secondary';
                            html += '<tr>';
                            html += '<td><i class="fas ' + typeIcon + ' me-1"></i> ' + event.eventType + '</td>';
                            html += '<td>' + event.assignedTo + '</td>';
                            html += '<td>' + event.eventDate + '</td>';
                            html += '<td>' + event.summary + '</td>';
                            html += '<td><span class="badge bg-' + statusColor + '">' + event.status + '</span></td>';
                            html += '</tr>';
                        });
                        html += '</tbody></table></div>';
                    } else {
                        html = '<div class="text-center text-muted py-3"><i class="fas fa-calendar-times fa-2x d-block mb-2"></i>No events found.</div>';
                    }
                    $('#eventsList').html(html);
                },
                error: function() {
                    $('#eventsList').html('<div class="text-center text-muted py-3">Error loading events.</div>');
                }
            });
        }
    </script>
}